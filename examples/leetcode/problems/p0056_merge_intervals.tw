use @std.testing.assert as assert
use @std.testing as runner

// https://leetcode.com/problems/merge-intervals/
// Merge all overlapping intervals. Each interval is a tuple (Int, Int) of
// (start, end), so endpoints read as `._0`/`._1` instead of positional vector
// indices. Tuples get structural `==`/`Stringify` for free, so the whole
// answer compares directly in `assert.equal`.
fn merge(intervals: Vector<(Int, Int)>) Vector<(Int, Int)> {
  if intervals.len() == 0 {
    return []
  }

  sorted := intervals.sort_by(fn(a, b) { Int.compare(a._0, b._0) })
  result: Vector<(Int, Int)> = [sorted[0]]

  for i in range_from(1, sorted.len()) {
    cur := sorted[i]
    last := result[result.len() - 1]

    if cur._0 <= last._1 {
      result[result.len() - 1] = (last._0, last._1.max(cur._1))
    } else {
      result = .append(cur)
    }
  }

  result
}

pub fn suite() {
  runner
    .suite("0056 merge-intervals")
    .test(
      "overlapping middle pair",
      fn() {
        input: Vector<(Int, Int)> = [(1, 3), (2, 6), (8, 10), (15, 18)]
        expected: Vector<(Int, Int)> = [(1, 6), (8, 10), (15, 18)]
        assert.equal(merge(input), expected)
      },
    )
    .test(
      "touching endpoints merge",
      fn() {
        input: Vector<(Int, Int)> = [(1, 4), (4, 5)]
        assert.equal(merge(input), [(1, 5)])
      },
    )
    .test(
      "unsorted input",
      fn() {
        input: Vector<(Int, Int)> = [(8, 10), (1, 3), (2, 6)]
        expected: Vector<(Int, Int)> = [(1, 6), (8, 10)]
        assert.equal(merge(input), expected)
      },
    )
}
