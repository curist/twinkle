// Unlocked tier: Sieve over @std.buffer (manually-managed linear memory) — the
// Twinkle escape hatch analogous to a native mutable byte array. One byte per
// flag (1 = prime candidate, 0 = struck). Compare against the persistent
// `sieve` (Vector<Bool>) to see the cost of persistence.
use @std.buffer

pub warmup := 10
pub iters := 40
pub size := 5000
pub expected := 669

pub fn run(size: Int) Int {
  buf := buffer.new(size + 1)
  defer {
    buf.free()
  }
  i := 0
  for i <= size {
    buf.set_byte(i, 1)
    i = i + 1
  }
  count := 0
  i = 2
  for i <= size {
    if buf.get_u8(i).to_int() == 1 {
      count = count + 1
      k := i + i
      for k <= size {
        buf.set_byte(k, 0)
        k = k + i
      }
    }
    i = i + 1
  }
  count
}
