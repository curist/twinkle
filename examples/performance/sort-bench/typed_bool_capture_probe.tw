// Typed-capture routing probe (C2): a `sort_by` comparator that CAPTURES a
// Vector<Bool> mask must have its reads routed to the typed bool getter, not the
// boxed one. Typed-vector routing is per-function, so the captured producers
// must live inside a function — a top-level mask never routes.
//
// Verify (comparator lambda must call get_bool, never boxed rt_arr__get):
//   target/twk wat examples/performance/sort-bench/typed_bool_capture_probe.tw \
//     --func lambda --calls | grep -E 'get_bool|rt_arr__get'
fn run() {
  mask := collect i in range(1000) {
    i % 2 == 0
  }
  idx := collect i in range(1000) {
    i
  }
  sorted := idx.sort_by(fn(a, b) {
    ma := if mask[a] {
      1
    } else {
      0
    }
    mb := if mask[b] {
      1
    } else {
      0
    }
    Int.compare(ma, mb)
  })
  println("first=${sorted[0]} last=${sorted[999]}")
}

run()
