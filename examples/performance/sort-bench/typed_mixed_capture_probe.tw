keys := collect i in range(1000) { (i * 7) % 1000 }
mask := collect i in range(1000) { i % 2 == 0 }
idx := collect i in range(1000) { i }
sorted := idx.sort_by(fn(a, b) {
  if mask[a] != mask[b] {
    if mask[a] { .Lt } else { .Gt }
  } else {
    Int.compare(keys[a], keys[b])
  }
})
println("first=${sorted[0]}")
