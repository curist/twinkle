use .harness
use .harness.{Benchmark}

type Person = .{ id: Int, score: Int }

type State = .{ people: Vector<Person>, count: Int }

fn swap(people: Vector<Person>, i: Int, j: Int) Vector<Person> {
  a := people[i]
  b := people[j]
  people.set_at(i, b).set_at(j, a)
}

fn permute(state: State, n: Int) State {
  next := State.{ people: state.people, count: state.count + 1 }
  if n == 0 {
    next
  } else {
    next = .permute(n - 1)
    i := n - 1
    for i >= 0 {
      // Full record reconstruction (ARecord), which the boxed recursive-aggregate
      // route recognizes. The idiomatic `next.people = swap(...)` field-rebind
      // sugar (ARecordUpdate) stays persistent today — tracked as a follow-up in
      // docs/plans/2026-09-29-boxed-mutvec-field-rebind-sugar.md.
      next = State.{ people: swap(next.people, n - 1, i), count: next.count }
      next = .permute(n - 1)
      next = State.{ people: swap(next.people, n - 1, i), count: next.count }
      i = .dec()
    }
    next
  }
}

pub warmup := 10
pub iters := 20
pub size := 300
pub expected := 8696

pub fn run(size: Int) Int {
  checksum := 0
  rep := 0
  for rep < size {
    people: Vector<Person> = collect i in range(6) {
      Person.{ id: i, score: i + 1 }
    }
    result := permute(State.{ people, count: 0 }, 6)
    checksum = result.count
    for person in result.people {
      checksum = checksum + person.id + person.score
    }
    rep = .inc()
  }
  checksum
}

harness.run_all([Benchmark.{ name: "boxed_record_permute", warmup, iters, size, expected, run }])
