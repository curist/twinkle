    size: towers.size,
    expected: towers.expected,
    run: towers.run,
  },
  Benchmark.{
    name: "list",
    warmup: list.warmup,
    iters: list.iters,
    size: list.size,
    expected: list.expected,
    run: list.run,
  },
  Benchmark.{
    name: "bounce",
    warmup: bounce.warmup,
    iters: bounce.iters,
    size: bounce.size,
    expected: bounce.expected,
    run: bounce.run,
  },
  Benchmark.{
    name: "storage",
    warmup: storage.warmup,
    iters: storage.iters,
