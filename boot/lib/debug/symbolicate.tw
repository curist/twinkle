//! Symbolication: map parsed trap frames to Twinkle source locations.
//!
//! Given a decoded `twinkle.debug` section and the Wasm frames parsed from a
//! trap's stack string, resolve each frame's module-absolute PC to a source
//! `Span` and a human `file:line:col` location — both read straight off the
//! section's embedded line/col, no source text required. A best-effort
//! `FileRegistry` built from files readable on disk is available separately for
//! rendering a source snippet; symbolication itself never touches disk.
//!
//! V8 PCs and the section's `body_start` values share the module-absolute
//! coordinate space, so no offset translation is needed — the frame's
//! `code_offset` is looked up directly. Frames with no enclosing entry
//! (prelude, imports, anything below the first function body) resolve to `None`
//! and are carried through unchanged rather than dropped.

use @std.fs

use lib.source.registry
use lib.source.registry.{FileRegistry}
use lib.source.span.{Span}

use .section.{DebugSection}
use .stack.{Frame}

/// A frame's resolved source position: file name plus 1-based line/column.
pub type FrameLoc = .{ file: String, line: Int, column: Int }

/// A parsed frame paired with its resolved span and location, if any.
pub type ResolvedFrame = .{ frame: Frame, span: Span?, location: FrameLoc? }

fn resolve(sec: DebugSection, frame: Frame) ResolvedFrame {
  entry := sec.lookup(frame.code_offset)
  location: FrameLoc? = case entry {
    .Some(e) => case sec.file_path(e.span.file_id) {
      .Some(path) => .Some(.{ file: path, line: e.start_line, column: e.start_col }),
      .None => .None,
    },
    .None => .None,
  }
  span: Span? = case entry {
    .Some(e) => .Some(e.span),
    .None => .None,
  }
  .{ frame, span, location }
}

/// Resolve every frame in stack order using only the section's embedded
/// line/col — no disk access.
pub fn symbolicate(sec: DebugSection, frames: Vector<Frame>) Vector<ResolvedFrame> {
  resolved: Vector<ResolvedFrame> = []

  for fr in frames {
    resolved = .append(resolve(sec, fr))
  }

  resolved
}

/// Build a best-effort `FileRegistry` over the section's files that are
/// actually readable on disk, for the renderer's source-snippet block. Files
/// that fail to read (moved, deleted, sandboxed) are silently skipped — the
/// renderer falls back to location-only output for those.
pub fn build_disk_registry(sec: DebugSection) FileRegistry {
  reg := registry.empty()

  for f in sec.files {
    case fs.read_text(f.path) {
      .Ok(src) => reg = .add_file_with_id(f.file_id, f.path, src),
      .Err(_) => {},
    }
  }

  reg
}
