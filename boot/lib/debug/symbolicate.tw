//! Symbolication: map parsed trap frames to Twinkle source locations.
//!
//! Given a decoded `twinkle.debug` section and the Wasm frames parsed from a
//! trap's stack string, resolve each frame's module-absolute PC to a source
//! `Span` and a human `file:line:col` location — both read straight off the
//! section's embedded line/col, no source text required. A best-effort
//! `FileRegistry` built from files readable on disk is available separately for
//! rendering a source snippet; symbolication itself never touches disk.
//!
//! V8 PCs and the section's `body_start` values share the module-absolute
//! coordinate space, so no offset translation is needed — the frame's
//! `code_offset` is looked up directly. Frames with no enclosing entry
//! (prelude, imports, anything below the first function body) resolve to `None`
//! and are carried through unchanged rather than dropped.

use @std.fs
use @std.path

use lib.source.registry
use lib.source.registry.{FileRegistry}
use lib.source.span.{Span}

use .section.{DebugSection}
use .stack.{Frame}

/// A frame's resolved source position: file name plus 1-based line/column.
pub type FrameLoc = .{ file: String, line: Int, column: Int }

/// A parsed frame paired with its resolved span and location, if any.
pub type ResolvedFrame = .{ frame: Frame, span: Span?, location: FrameLoc? }

fn resolve(sec: DebugSection, frame: Frame) ResolvedFrame {
  entry := sec.lookup(frame.code_offset)
  location: FrameLoc? = case entry {
    .Some(e) => case sec.file_path(e.span.file_id) {
      .Some(path) => .Some(.{ file: path, line: e.start_line, column: e.start_col }),
      .None => .None,
    },
    .None => .None,
  }
  span: Span? = case entry {
    .Some(e) => .Some(e.span),
    .None => .None,
  }
  .{ frame, span, location }
}

/// Resolve every frame in stack order using only the section's embedded
/// line/col — no disk access.
pub fn symbolicate(sec: DebugSection, frames: Vector<Frame>) Vector<ResolvedFrame> {
  resolved: Vector<ResolvedFrame> = []

  for fr in frames {
    resolved = .append(resolve(sec, fr))
  }

  resolved
}

/// Safely join a project-relative debug path under `source_root`, refusing
/// anything that would read outside the root.
///
/// Returns `.None` when `source_root` is empty, `rel` is `@`-logical (an
/// stdlib/prelude path with no on-disk counterpart under the root), or the
/// normalized join escapes `source_root` (e.g. `rel` is absolute or starts
/// with `../`). Otherwise returns the normalized absolute path to read.
pub fn safe_join(source_root: String, rel: String) String? {
  // `path.join` concatenates its two segments (Node's `path.join` semantics)
  // rather than letting an absolute second segment override the first (as
  // e.g. Python's `os.path.join` does), so an absolute `rel` must be refused
  // up front — otherwise `join("/p", "/abs/x")` produces `"/p/abs/x"`, which
  // still normalizes under `source_root` and would slip past the prefix
  // check below.
  if source_root == "" or rel.starts_with("@") or path.is_absolute(rel) {
    return .None
  }

  joined := path.normalize(path.join(source_root, rel))
  root := path.normalize(source_root)
  prefix := if root.ends_with("/") {
    root
  } else {
    "${root}/"
  }

  if joined == root or joined.starts_with(prefix) {
    .Some(joined)
  } else {
    .None
  }
}

/// Build a best-effort `FileRegistry` over the section's files that are
/// actually readable on disk under `source_root`, for the renderer's
/// source-snippet block. Files whose path can't be safely joined under the
/// root (empty root, `@`-logical path, escaping join) or that fail to read
/// (moved, deleted, sandboxed) are silently skipped — the renderer falls back
/// to location-only output for those. The registry stores each file under its
/// original (relative/logical) `f.path` for display; only the disk read uses
/// the joined absolute path.
pub fn build_disk_registry(sec: DebugSection, source_root: String) FileRegistry {
  reg := registry.empty()

  for f in sec.files {
    case safe_join(source_root, f.path) {
      .Some(abs) => case fs.read_text(abs) {
        .Ok(src) => reg = .add_file_with_id(f.file_id, f.path, src),
        .Err(_) => {},
      },
      .None => {},
    }
  }

  reg
}
