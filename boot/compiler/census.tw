//! Candidate-op census over optimized ANF.
//!
//! Counts COW-candidate update sites and how many are lowered in-place. Candidate
//! detection RIDES the optimizer semantics through `compiler.codegen.mutable_catalog`:
//! a call is a candidate iff its `CallSemantics.effect` is `.Update`, and an
//! in-place call is one whose id is a registered `in_place_equivalent`. Record
//! updates are counted via `ARecordUpdate` (the `in_place` bit). The catalog only
//! names reporting families; it never decides ownership legality, and any update
//! candidate it does not name falls into `other`, so the census stays honest as
//! boot grows. Contains NO ownership analysis. Shared by `twk ir --census` and
//! the census gate suite.

use compiler.anf.{AnfExpr, AnfModule, AnfOp}
use compiler.builtins.{BuiltinRegistry}
use compiler.codegen.mutable_catalog
use compiler.opt.semantics.{make_prelude_optimizer_semantics}

pub type CensusSite = .{
  func_id: Int,
  func: String,
  family: String,
  in_place: Bool,
  local: Int,
  actual_fid: Int,
}

pub type FamilyCount = .{ name: String, candidates: Int, in_place: Int }

pub type CensusTally = .{
  record_update: FamilyCount,
  dict_set: FamilyCount,
  dict_remove: FamilyCount,
  vector_set: FamilyCount,
  vector_append: FamilyCount,
  vector_builder: FamilyCount,
  other: FamilyCount,
}

/// Every candidate site in the module, in deterministic traversal order.
pub fn census_sites(m: AnfModule, b: BuiltinRegistry) Vector<CensusSite> {
  sem := make_prelude_optimizer_semantics(b)
  cat := mutable_catalog.build(b, sem)
  sites: Vector<CensusSite> = []
  for f in m.functions {
    sites = walk_expr(f.body, f.func_id.id, f.name, sites, cat)
  }
  sites
}

fn walk_expr(
  expr: AnfExpr,
  func_id: Int,
  func: String,
  sites: Vector<CensusSite>,
  cat: mutable_catalog.MutableCatalog,
) Vector<CensusSite> {
  case expr {
    .Let(local, op, _, body) => {
      after := walk_op(op, local.id, func_id, func, sites, cat)
      walk_expr(body, func_id, func, after, cat)
    },
    _ => sites,
  }
}

fn walk_op(
  op: AnfOp,
  local_id: Int,
  func_id: Int,
  func: String,
  sites: Vector<CensusSite>,
  cat: mutable_catalog.MutableCatalog,
) Vector<CensusSite> {
  case op {
    .ARecordUpdate(_, _, _, in_place, _) => sites.append(CensusSite.{
      func_id,
      func,
      family: "record_update",
      in_place,
      local: local_id,
      actual_fid: 0 - 1,
    }),
    .ACall(callee, _) => case callee {
      .AGlobalFunc(fid) => case cat.classify_call(fid) {
        .Some(fi) => sites.append(CensusSite.{
          func_id,
          func,
          family: fi.family,
          in_place: fi.in_place,
          local: local_id,
          actual_fid: fid.id,
        }),
        .None => sites,
      },
      _ => sites,
    },
    .AIf(_, then_e, else_e) => {
      after_then := walk_expr(then_e, func_id, func, sites, cat)
      walk_expr(else_e, func_id, func, after_then, cat)
    },
    .AMatch(_, arms) => {
      acc := sites
      for arm in arms {
        acc = walk_expr(arm.body, func_id, func, acc, cat)
      }
      acc
    },
    .ALoop(body) => walk_expr(body, func_id, func, sites, cat),
    .ADefer(body) => walk_expr(body, func_id, func, sites, cat),
    _ => sites,
  }
}

fn empty_family(name: String) FamilyCount {
  .{ name, candidates: 0, in_place: 0 }
}

fn empty_tally() CensusTally {
  .{
    record_update: empty_family("record_update"),
    dict_set: empty_family("dict_set"),
    dict_remove: empty_family("dict_remove"),
    vector_set: empty_family("vector_set"),
    vector_append: empty_family("vector_append"),
    vector_builder: empty_family("vector_builder"),
    other: empty_family("other"),
  }
}

fn inc(fc: FamilyCount, in_place: Bool) FamilyCount {
  fc.candidates = fc.candidates + 1
  fc.in_place = fc.in_place
  + if in_place {
    1
  } else {
    0
  }
  fc
}

/// Reduce sites into per-family totals.
pub fn tally_from_sites(sites: Vector<CensusSite>) CensusTally {
  t := empty_tally()
  for s in sites {
    t = case s.family {
      "record_update" => {
        t.record_update = .inc(s.in_place)
        t
      },
      "dict_set" => {
        t.dict_set = .inc(s.in_place)
        t
      },
      "dict_remove" => {
        t.dict_remove = .inc(s.in_place)
        t
      },
      "vector_set" => {
        t.vector_set = .inc(s.in_place)
        t
      },
      "vector_append" => {
        t.vector_append = .inc(s.in_place)
        t
      },
      "vector_builder" => {
        t.vector_builder = .inc(s.in_place)
        t
      },
      _ => {
        t.other = .inc(s.in_place)
        t
      },
    }
  }
  t
}

fn render_row(fc: FamilyCount) String {
  "${fc.name}\t${fc.candidates}\t${fc.in_place}\n"
}

/// Tab-separated population table.
pub fn render_census(t: CensusTally) String {
  rows := [
    t.record_update,
    t.dict_set,
    t.dict_remove,
    t.vector_set,
    t.vector_append,
    t.vector_builder,
    t.other,
  ]
  out := "family\tcandidates\tin_place\n"
  for fc in rows {
    out = .concat(fc.render_row())
  }
  out
}
