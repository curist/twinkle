//! Structural findings for `twk lint`, including report-only diagnostics and
//! machine-applicable rewrites.
//!
//! A pure AST visitor over a parsed Module, producing LintFindings. Run only in
//! review mode (see docs/plans/archive/linter.md).
//!
//! `source` is the module's source text; structural lints that suggest a literal
//! spelling (constant-fn) slice it by span rather than re-rendering AST values.

use compiler.ast.{
  Block, CondArm, Expr, ForStmt, FunctionDecl, LetStmt, Module, RecordEntry, Stmt, TypeExpr,
}
use compiler.resolver.{ResolvedEnv}
use lib.source.report.{FixEdit}
use lib.source.span.{Span}

/// A lint finding. `edits` carries machine-applicable rewrites for auto-fixable
/// rules (empty for report-only lints).
pub type LintFinding = .{ span: Span, message: String, rule: String, edits: Vector<FixEdit> }

/// A report-only finding: no machine-applicable edits.
fn report_finding(span: Span, message: String, rule: String) LintFinding {
  .{ span, message, rule, edits: [] }
}

// Threaded through the block/statement/expression walk. `types` maps in-scope
// local names to their declared nominal type name (params + annotated lets),
// accumulated in statement order; `source` is the module text, used to slice
// changed-field values when synthesizing an inline-record-copy auto-fix.
type LintCtx = .{
  types: Dict<String, String>,
  // Names bound in the current lexical scope (params + preceding lets). Used to
  // skip redundant-print-stringify rewrites when a sink name like `println` is
  // shadowed by a local value or parameter rather than the prelude wrapper.
  values: Dict<String, Bool>,
  source: String,
  env: ResolvedEnv,
}

fn empty_lint_ctx(env: ResolvedEnv, source: String) LintCtx {
  .{ types: Dict.new(), values: Dict.new(), source, env }
}

fn param_values(decl: FunctionDecl) Dict<String, Bool> {
  values: Dict<String, Bool> = Dict.new()

  for p in decl.params {
    values[p.name] = true
  }

  values
}

/// Lint a whole module. `env` is used by type-dependent structural lints (L3);
/// `source` renders span-sliced suggestions (constant-fn).
pub fn lint_module(module: Module, env: ResolvedEnv, source: String) Vector<LintFinding> {
  out: Vector<LintFinding> = []

  cur := empty_lint_ctx(env, source)

  for item in module.items {
    case item {
      .Function(decl) => {
        out = .concat(lint_record_copy(decl, env, source))
        out = .concat(lint_constant_fn(decl, module, source))
        out = .concat(
          lint_block(
            decl.body,
            .{ types: param_types(decl), values: param_values(decl), source, env },
          ),
        )
        out = .concat(lint_redundant_prefix_decl(decl, source))
      },
      .Stmt(stmt) => {
        out = .concat(lint_stmt(stmt, cur))

        top_ctx := PrefixCtx.{ source, returns_typed: false }
        out = .concat(top_ctx.walk_stmt(stmt))

        // Top-level lets shadow later sink calls too.
        case stmt {
          .Let(ls) => cur.values[ls.name] = true,
          _ => {},
        }
      },
      _ => {},
    }
  }

  out
}

// ── constant-fn: nullary function returning only a constant ───────────
/// A scalar literal, or a direct unary-minus over an integer/float literal
/// (`-1`, `-1.0`). Collection/variant literals are out of v1 scope.
fn is_constant_literal(e: Expr) Bool {
  case e.kind {
    .StringLit(_) => true,
    .IntLit(_) => true,
    .FloatLit(_) => true,
    .BoolLit(_) => true,
    .Unary(op, inner) => case op {
      .Neg => is_numeric_literal(inner),
      _ => false,
    },
    _ => false,
  }
}

fn is_numeric_literal(e: Expr) Bool {
  case e.kind {
    .IntLit(_) => true,
    .FloatLit(_) => true,
    _ => false,
  }
}

// References to a name across a module: the spans of every nullary call `name()`
// (safe to repoint to a bare `name`), and whether `name` ever appears in any
// OTHER position (a bare identifier, a punned record field, or a call with
// arguments) — which makes converting the function to a constant unsafe.
//
// Over-counting `has_bare` only makes the constant-fn auto-fix refuse more often
// (sound); MISSING an occurrence would wrongly convert, so the traversal below is
// exhaustive over every expression position, including record-field punning.
type NameRefs = .{ call_spans: Vector<Span>, has_bare: Bool }

fn empty_name_refs() NameRefs {
  .{ call_spans: [], has_bare: false }
}

fn merge_name_refs(a: NameRefs, b: NameRefs) NameRefs {
  .{ call_spans: a.call_spans.concat(b.call_spans), has_bare: a.has_bare or b.has_bare }
}

fn refs_in_opt_expr(e: Expr?, name: String) NameRefs {
  case e {
    .Some(x) => refs_in_expr(x, name),
    .None => empty_name_refs(),
  }
}

fn refs_in_block(b: Block, name: String) NameRefs {
  out := empty_name_refs()

  for s in b.stmts {
    out = .merge_name_refs(refs_in_stmt(s, name))
  }

  out.merge_name_refs(refs_in_opt_expr(b.tail, name))
}

fn refs_in_stmt(s: Stmt, name: String) NameRefs {
  case s {
    .Let(x) => refs_in_expr(x.value, name),
    .For(x) => {
      out := refs_in_opt_expr(x.iter, name)
      out = .merge_name_refs(refs_in_opt_expr(x.condition, name))
      out.merge_name_refs(refs_in_block(x.body, name))
    },
    .Return(x) => refs_in_opt_expr(x.value, name),
    .Break(x) => refs_in_opt_expr(x.value, name),
    .Continue(_) => empty_name_refs(),
    .Defer(x) => refs_in_expr(x.expr, name),
    .Expr(x) => refs_in_expr(x.expr, name),
    .ErrorStmt(_) => empty_name_refs(),
  }
}

fn refs_in_entries(entries: Vector<RecordEntry>, name: String) NameRefs {
  out := empty_name_refs()

  for e in entries {
    case e.value {
      .Some(v) => out = .merge_name_refs(refs_in_expr(v, name)),
      // Punned field `.{ name }` is a bare variable reference to `name`.
      .None => if e.name == name {
        out = .merge_name_refs(.{ call_spans: [], has_bare: true })
      },
    }
  }

  out
}

fn refs_in_expr(expr: Expr, name: String) NameRefs {
  case expr.kind {
    .Ident(n) => if n == name {
      .{ call_spans: [], has_bare: true }
    } else {
      empty_name_refs()
    },
    .IntLit(_) => empty_name_refs(),
    .FloatLit(_) => empty_name_refs(),
    .StringLit(_) => empty_name_refs(),
    .BoolLit(_) => empty_name_refs(),
    .ErrorExpr => empty_name_refs(),
    .Unary(_, e) => refs_in_expr(e, name),
    .Binary(_, l, r) => refs_in_expr(l, name).merge_name_refs(refs_in_expr(r, name)),
    .Call(callee, args) => {
      is_target_call := case callee.kind {
        .Ident(n) => n == name and args.len() == 0,
        _ => false,
      }

      // A clean `name()` call site: record its span, do NOT descend into the
      // callee (that Ident is the call, not a bare use). Any other shape —
      // `name(x)`, `name` as a value — reaches the callee Ident below and marks
      // has_bare, refusing the fix.
      out: NameRefs = if is_target_call {
        .{ call_spans: [expr.span], has_bare: false }
      } else {
        refs_in_expr(callee, name)
      }

      for a in args {
        out = .merge_name_refs(refs_in_expr(a, name))
      }

      out
    },
    .Field(base, _) => refs_in_expr(base, name),
    .Index(base, idx) => refs_in_expr(base, name).merge_name_refs(refs_in_expr(idx, name)),
    .BlockExpr(b) => refs_in_block(b, name),
    .If(c, then_b, else_e) => {
      out := refs_in_expr(c, name)
      out = .merge_name_refs(refs_in_block(then_b, name))
      out.merge_name_refs(refs_in_opt_expr(else_e, name))
    },
    .Case(scrut, arms) => {
      out := refs_in_expr(scrut, name)

      for arm in arms {
        out = .merge_name_refs(refs_in_expr(arm.expr, name))
      }

      out
    },
    .Cond(arms) => {
      out := empty_name_refs()

      for arm in arms {
        out = .merge_name_refs(refs_in_opt_expr(arm.condition, name))
        out = .merge_name_refs(refs_in_expr(arm.body, name))
      }

      out
    },
    .Array(elems) => {
      out := empty_name_refs()

      for e in elems {
        out = .merge_name_refs(refs_in_expr(e, name))
      }

      out
    },
    .Record(entries) => refs_in_entries(entries, name),
    .NamedRecord(_, entries) => refs_in_entries(entries, name),
    .Variant(_, args) => {
      out := empty_name_refs()

      for a in args {
        out = .merge_name_refs(refs_in_expr(a, name))
      }

      out
    },
    .Closure(_, _, body) => refs_in_block(body, name),
    .Collect(c) => {
      out := refs_in_opt_expr(c.iter, name)
      out = .merge_name_refs(refs_in_opt_expr(c.condition, name))
      out.merge_name_refs(refs_in_block(c.body, name))
    },
    .StringInterp(parts) => {
      out := empty_name_refs()

      for p in parts {
        case p {
          .Interpolation(e) => out = .merge_name_refs(refs_in_expr(e, name)),
          .Literal(_) => {},
        }
      }

      out
    },
  }
}

fn collect_name_refs(module: Module, name: String) NameRefs {
  out := empty_name_refs()

  for item in module.items {
    case item {
      .Function(decl) => out = .merge_name_refs(refs_in_block(decl.body, name)),
      .Stmt(stmt) => out = .merge_name_refs(refs_in_stmt(stmt, name)),
      _ => {},
    }
  }

  out
}

// A safe, module-local constant-fn auto-fix (edits) when the flagged function is
// private (no cross-module callers the single-module linter cannot see), never
// used as a value, and its definition textually precedes every call site (a
// top-level `:=` constant is not forward-referenceable, unlike a hoisted `fn`).
// Empty when any guard fails — the finding then stays report-only.
fn constant_fn_edits(decl: FunctionDecl, module: Module, def_replacement: String) Vector<FixEdit> {
  if decl.is_pub {
    return []
  }

  refs := collect_name_refs(module, decl.name)

  if refs.has_bare {
    return []
  }

  for span in refs.call_spans {
    if span.start < decl.span.end {
      return []
    }
  }
  edits: Vector<FixEdit> = [
    FixEdit.{ start: decl.span.start, end: decl.span.end, replacement: def_replacement },
  ]

  for span in refs.call_spans {
    edits = .append(FixEdit.{ start: span.start, end: span.end, replacement: decl.name })
  }

  edits
}

/// Flag a zero-argument function whose whole body is a single scalar constant —
/// a module constant wearing a function costume. Auto-fixable (def -> module
/// constant + call sites drop `()`) only for a private function whose every use
/// is a call after the definition; otherwise report-only, since a public
/// function may have callers this single-module pass cannot see.
fn lint_constant_fn(decl: FunctionDecl, module: Module, source: String) Vector<LintFinding> {
  if decl.params.len() > 0 or decl.type_params.len() > 0 {
    return []
  }

  // A body with side-effect statements before the literal tail is real work.
  if decl.body.stmts.len() > 0 {
    return []
  }
  lit := case decl.body.tail {
    .Some(e) => if is_constant_literal(e) {
      e
    } else {
      return []
    },
    .None => return [],
  }
  literal_text := source.slice(lit.span.start, lit.span.end)
  vis := if decl.is_pub {
    "pub "
  } else {
    ""
  }

  // Preserve an explicit return annotation (`name: T = lit`); otherwise the
  // inferred constant form (`name := lit`).
  suggestion := case decl.return_type {
    .Some(rt) => "${vis}${decl.name}: ${source.slice(rt.span.start, rt.span.end)} = ${literal_text}",
    .None => "${vis}${decl.name} := ${literal_text}",
  }
  [
    .{
      span: decl.name_span,
      message: "`${decl.name}` returns only a constant; declare a module constant instead: `${suggestion}` (call sites drop `()`)",
      rule: "constant-fn",
      edits: constant_fn_edits(decl, module, suggestion),
    },
  ]
}

// ── L4: unreachable-code ─────────────────────────────────────────────
fn stmt_span(stmt: Stmt) Span {
  case stmt {
    .Let(s) => s.span,
    .For(s) => s.span,
    .Return(s) => s.span,
    .Break(s) => s.span,
    .Continue(s) => s.span,
    .Defer(s) => s.span,
    .Expr(s) => s.span,
    .ErrorStmt(sp) => sp,
  }
}

/// Does this statement unconditionally leave the enclosing block?
fn is_diverging(stmt: Stmt) Bool {
  case stmt {
    .Return(_) => true,
    .Break(_) => true,
    .Continue(_) => true,
    .Expr(s) => is_error_call(s.expr),
    _ => false,
  }
}

/// `error(...)` traps — a call whose callee is the bare `error` builtin.
fn is_error_call(expr: Expr) Bool {
  case expr.kind {
    .Call(callee, _) => case callee.kind {
      .Ident(name) => name == "error",
      _ => false,
    },
    _ => false,
  }
}

// `types` maps in-scope local names to their declared nominal type name (from
// enclosing params and annotated `let`s), used by inline-record-copy to confirm
// the copy source is the same type as the literal it reconstructs. It accumulates
// this block's annotated bindings in statement order as we descend.
fn lint_block(block: Block, ctx: LintCtx) Vector<LintFinding> {
  out: Vector<LintFinding> = lint_direct_rebinding(block)
  out = .concat(lint_numbered_rebinding(block, ctx.source))
  cur := ctx
  diverged := false
  reported := false

  for stmt, i in block.stmts {
    if diverged {
      // Flag the first statement after a diverging one; the rest of the block
      // is equally unreachable, so one finding per block is enough.
      if !reported {
        out = .append(report_finding(stmt_span(stmt), "unreachable code", "unreachable-code"))
        reported = true
      }
    } else {
      case stmt {
        .Let(ls) => case inline_copy_finding_for_let(block, i, ls, cur) {
          .Some(f) => out = .append(f),
          .None => {},
        },
        _ => {},
      }
      out = .concat(lint_stmt(stmt, cur))

      // Bind the let AFTER linting its own initializer, so a `println := ...`
      // initializer is not treated as shadowing itself, but later statements do
      // see the binding (both for shadow tracking and record-copy typing).
      case stmt {
        .Let(ls) => {
          cur.values[ls.name] = true

          case ls.ty {
            .Some(t) => case type_name(t) {
              .Some(n) => cur.types[ls.name] = n,
              .None => {},
            },
            .None => {},
          }
        },
        _ => {},
      }

      if is_diverging(stmt) {
        diverged = true
      }
    }
  }

  case block.tail {
    .Some(e) => if diverged {
      if !reported {
        out = .append(report_finding(e.span, "unreachable code", "unreachable-code"))
        reported = true
      }
    } else {
      out = .concat(lint_expr(e, cur))
    },
    .None => {},
  }

  out
}

// ── prefer-inc-dec ──────────────────────────────────────────────────
/// Return the preferred step method when `value` is exactly `<target> +/- 1`.
fn step_method_for_name(value: Expr, target: String) String? {
  case value.kind {
    .Binary(op, left, right) => if is_ident_named(left, target) {
      case right.kind {
        .IntLit(1) => case op {
          .Add => .Some("inc"),
          .Sub => .Some("dec"),
          _ => .None,
        },
        _ => .None,
      }
    } else {
      .None
    },
    _ => .None,
  }
}

fn step_method_for_path(value: Expr, target: Expr) String? {
  if !is_field_path(target) {
    return .None
  }

  case value.kind {
    .Binary(op, left, right) => if same_path(left, target) {
      case right.kind {
        .IntLit(1) => case op {
          .Add => .Some("inc"),
          .Sub => .Some("dec"),
          _ => .None,
        },
        _ => .None,
      }
    } else {
      .None
    },
    _ => .None,
  }
}

fn step_finding(value: Expr, method: String) LintFinding {
  .{
    span: value.span,
    message: "a self-rebinding by one can use `.${method}()`",
    rule: "prefer-inc-dec",
    edits: [.{ start: value.span.start, end: value.span.end, replacement: ".${method}()" }],
  }
}

fn lint_stmt(stmt: Stmt, ctx: LintCtx) Vector<LintFinding> {
  case stmt {
    .Let(s) => {
      out := lint_expr(s.value, ctx)

      if s.is_rebind {
        case step_method_for_name(s.value, s.name) {
          .Some(method) => out = .append(step_finding(s.value, method)),
          .None => {},
        }
      }

      out
    },
    .For(s) => {
      out: Vector<LintFinding> = []

      case s.iter {
        .Some(e) => out = .concat(lint_expr(e, ctx)),
        .None => {},
      }

      case s.condition {
        .Some(e) => out = .concat(lint_expr(e, ctx)),
        .None => {},
      }
      out = .concat(lint_block(s.body, ctx))
      out
    },
    .Return(s) => case s.value {
      .Some(e) => lint_expr(e, ctx),
      .None => [],
    },
    .Break(s) => case s.value {
      .Some(e) => lint_expr(e, ctx),
      .None => [],
    },
    .Continue(_) => [],
    .Defer(s) => lint_expr(s.expr, ctx),
    .Expr(s) => {
      out := lint_expr(s.expr, ctx)

      case s.expr.kind {
        .Binary(.Assign, target, value) => case step_method_for_path(value, target) {
          .Some(method) => out = .append(step_finding(value, method)),
          .None => {},
        },
        _ => {},
      }

      out
    },
    .ErrorStmt(_) => [],
  }
}

// ── redundant-print-stringify ────────────────────────────────────────
fn is_print_stringify_sink_name(name: String) Bool {
  name == "print" or name == "println" or name == "eprint" or name == "eprintln" or name == "error"
}

// True when `name` at a call site is one of the public print/error sinks bound to
// the generic prelude wrappers (prelude/io.tw), and not shadowed by a local value
// or parameter. Only bare-ident callees reach this — `logger.println(...)` is a
// Field callee and is never considered.
fn is_public_prelude_io_sink(ctx: LintCtx, name: String) Bool {
  if !is_print_stringify_sink_name(name) {
    return false
  }

  if ctx.values.has(name) {
    return false
  }

  case ctx.env.lookup_function_origin(name) {
    .Some(origin) => origin.func_name == name and origin.module_path.ends_with("/prelude/io.tw"),
    .None => false,
  }
}

type RedundantStringifyArg = .{ start: Int, end: Int, replacement: String, kind: String }

// If `arg` is a whole-argument redundant stringification — a single-interpolation
// string `"${e}"` or a zero-arg `base.to_string()` — return the edit replacing the
// argument span with the underlying value expression text. Otherwise .None.
fn redundant_stringify_arg(arg: Expr, source: String) RedundantStringifyArg? {
  case arg.kind {
    .StringInterp(parts) => {
      // Redundant iff the only meaningful segment is a single interpolation. The
      // parser may pad a lone `${e}` with empty-string literal segments, so ignore
      // empty literals; any non-empty literal (surrounding text) or a second
      // interpolation makes it a real formatted message — leave it alone.
      interp: Expr? = .None
      extra := false

      for p in parts {
        case p {
          .Literal(s) => if s.len() != 0 {
            extra = true
          },
          .Interpolation(e) => case interp {
            .None => interp = .Some(e),
            .Some(_) => extra = true,
          },
        }
      }

      if extra {
        return .None
      }

      case interp {
        .Some(inner) => .Some(
          .{
            start: arg.span.start,
            end: arg.span.end,
            replacement: source.slice(inner.span.start, inner.span.end),
            kind: "interpolation",
          },
        ),
        .None => .None,
      }
    },
    .Call(callee, call_args) => {
      if call_args.len() != 0 {
        return .None
      }

      case callee.kind {
        .Field(base, method_name) => if method_name == "to_string" {
          .Some(
            .{
              start: arg.span.start,
              end: arg.span.end,
              replacement: source.slice(base.span.start, base.span.end),
              kind: "to_string",
            },
          )
        } else {
          .None
        },
        _ => .None,
      }
    },
    _ => .None,
  }
}

fn redundant_print_stringify_finding(call: Expr, sink: String, arg: RedundantStringifyArg) LintFinding {
  .{
    span: call.span,
    message: "`${sink}` accepts any `Stringify` value; pass the value directly instead of redundant ${arg.kind}",
    rule: "redundant-print-stringify",
    edits: [FixEdit.{ start: arg.start, end: arg.end, replacement: arg.replacement }],
  }
}

// ── prefer-multiline-string ──────────────────────────────────────────
// A constant string built by chaining `.concat` over string literals reads
// worse than a `\\` multi-line string literal (raw, one source line per logical
// line, no `\n`/`\"` escaping). Fold such a chain to its value; fire when it has
// >=2 concat links and the value spans lines.
type ConcatChain = .{ value: String, links: Int }

// `.Some(value, links)` when `e` is a string literal or a chain of
// `<literal-chain>.concat(<literal>)`; `.None` for any non-constant piece (a
// computed receiver/argument), so runtime string building never matches.
fn constant_concat_chain(e: Expr) ConcatChain? {
  case e.kind {
    .StringLit(s) => .Some(.{ value: s, links: 0 }),
    .Call(callee, args) => if args.len() == 1 {
      case callee.kind {
        .Field(base, name) => if name == "concat" {
          case constant_concat_chain(base) {
            .Some(bc) => case args[0].kind {
              .StringLit(s) => .Some(.{ value: bc.value.concat(s), links: bc.links + 1 }),
              _ => .None,
            },
            .None => .None,
          }
        } else {
          .None
        },
        _ => .None,
      }
    } else {
      .None
    },
    _ => .None,
  }
}

// 0-based column of byte `offset` in `source` (chars since the last newline).
// Used to indent the emitted `\\` continuation lines under the first one.
fn column_at(source: String, offset: Int) Int {
  n := 0
  i := offset
  done := false

  for !done {
    if i <= 0 {
      done = true
    } else if source.slice(i - 1, i) == "\n" {
      done = true
    } else {
      n = .inc()
      i = .dec()
    }
  }

  n
}

fn spaces(n: Int) String {
  out := ""
  k := 0

  for k < n {
    out = .concat(" ")
    k = .inc()
  }

  out
}

// Whether `value` can be represented by a `\\` multi-line literal without
// changing it. `\\` lines still interpolate `${...}` (backslash is literal, so
// there is no way to escape it), so a value containing `${` would be
// re-interpreted — exclude it. A tab or CR would also have to be a literal
// control byte in source, so exclude those too. (`\\` detected via `$`+`{` so
// this source itself carries no interpolation.)
fn multiline_safe(value: String) Bool {
  !value.contains("\t") and !value.contains("\r") and !value.contains("$".concat("{"))
}

// Build the `\\` multi-line literal for `value`: one `\\`-prefixed line per `\n`
// segment (a trailing `\n` becomes a trailing empty `\\` line), continuation
// lines indented to `col`. `\\` lines join with `\n` and are raw, so this
// reproduces `value` exactly.
fn multiline_literal(value: String, col: Int) String {
  indent := spaces(col)
  out := ""

  for line, idx in value.split("\n") {
    prefix := if idx == 0 {
      ""
    } else {
      "\n".concat(indent)
    }
    out = .concat(prefix).concat("\\\\").concat(line)
  }

  out
}

// Only called for `multiline_safe` values (the rule does not fire otherwise), so
// the `\\` rewrite always reproduces the value exactly.
fn multiline_string_finding(expr: Expr, value: String, source: String) LintFinding {
  .{
    span: expr.span,
    message: "chained string-literal `.concat` builds a multi-line string; use a `\\\\` multi-line string literal instead",
    rule: "prefer-multiline-string",
    edits: [
      FixEdit.{
        start: expr.span.start,
        end: expr.span.end,
        replacement: multiline_literal(value, column_at(source, expr.span.start)),
      },
    ],
  }
}

// ── prefer-case-dispatch ─────────────────────────────────────────────
type CaseDispatchArm = .{ pattern: Expr?, body: Expr }

type CaseDispatchCandidate = .{ scrutinee: Expr, arms: Vector<CaseDispatchArm> }

type EqualityDispatchParts = .{ scrutinee: Expr, pattern: Expr }

fn same_source_expr(a: Expr, b: Expr, source: String) Bool {
  source.slice(a.span.start, a.span.end) == source.slice(b.span.start, b.span.end)
}

fn stable_case_scrutinee_expr(e: Expr) Bool {
  case e.kind {
    .Ident(_) => true,
    .Field(base, _) => stable_case_scrutinee_expr(base),
    _ => false,
  }
}

fn case_pattern_expr(e: Expr) Bool {
  case e.kind {
    .IntLit(_) => true,
    .StringLit(_) => true,
    .BoolLit(_) => true,
    .Variant(_, args) => {
      for a in args {
        if !case_pattern_expr(a) {
          return false
        }
      }
      true
    },
    _ => false,
  }
}

fn equality_dispatch_parts(condition: Expr) EqualityDispatchParts? {
  case condition.kind {
    .Binary(.Eq, left, right) => cond {
      stable_case_scrutinee_expr(left) and case_pattern_expr(right) => .Some(
        .{ scrutinee: left, pattern: right },
      ),
      stable_case_scrutinee_expr(right) and case_pattern_expr(left) => .Some(
        .{ scrutinee: right, pattern: left },
      ),
      _ => .None,
    },
    _ => .None,
  }
}

fn case_dispatch_candidate(arms: Vector<CondArm>, source: String) CaseDispatchCandidate? {
  converted: Vector<CaseDispatchArm> = []
  scrutinee: Expr? = .None
  has_default := false

  for arm in arms {
    case arm.condition {
      .Some(c) => {
        parts := try equality_dispatch_parts(c)

        case scrutinee {
          .Some(s) => if !same_source_expr(s, parts.scrutinee, source) {
            return .None
          },
          .None => scrutinee = .Some(parts.scrutinee),
        }

        converted = .append(.{ pattern: .Some(parts.pattern), body: arm.body })
      },
      .None => {
        has_default = true
        converted = .append(.{ pattern: .None, body: arm.body })
      },
    }
  }

  if !has_default {
    return .None
  }

  s := try scrutinee
  .Some(.{ scrutinee: s, arms: converted })
}

fn leading_line_indent(source: String, start: Int) String {
  line_start := start

  for line_start > 0 and source.slice(line_start - 1, line_start) != "\n" {
    line_start = .dec()
  }

  i := line_start

  for i < source.len() {
    ch := source.slice(i, i + 1)

    if ch != " " and ch != "\t" {
      return source.slice(line_start, i)
    }

    i = .inc()
  }

  source.slice(line_start, i)
}

fn render_case_dispatch(c: CaseDispatchCandidate, indent: String, source: String) String {
  arm_indent := "${indent}  "
  lines: Vector<String> = ["case ${source.slice(c.scrutinee.span.start, c.scrutinee.span.end)} {"]

  for arm in c.arms {
    lhs := case arm.pattern {
      .Some(p) => source.slice(p.span.start, p.span.end),
      .None => "_",
    }
    body := source.slice(arm.body.span.start, arm.body.span.end)
    lines = .append("${arm_indent}${lhs} => ${body},")
  }

  lines = .append("${indent}}")
  lines.join("\n")
}

fn prefer_case_dispatch_finding(expr: Expr, arms: Vector<CondArm>, source: String) LintFinding? {
  indent := leading_line_indent(source, expr.span.start)
  candidate := try case_dispatch_candidate(arms, source)
  replacement := candidate.render_case_dispatch(indent, source)
  .Some(
    .{
      span: expr.span,
      message: "`cond` is doing equality dispatch over one value; use `case` instead",
      rule: "prefer-case-dispatch",
      edits: [FixEdit.{ start: expr.span.start, end: expr.span.end, replacement }],
    },
  )
}

// ── prefer-cond ──────────────────────────────────────────────────────
type CondChainArm = .{ condition: Expr, body: Expr }

type CondChain = .{ arms: Vector<CondChainArm>, else_body: Expr }

// A block's sole value expression, but only when it is *just* that expression —
// no leading statements, no tail-less trailing statement (`break`/`return`/`…`).
// This is the gate that keeps prefer-cond to value dispatch: an imperative
// branch (side-effecting statements, or an early `break`/`return`) has no such
// tail and leaves the chain unconverted.
fn block_value_expr(b: Block) Expr? {
  if b.stmts.len() == 0 {
    b.tail
  } else {
    .None
  }
}

// Walk an `if`/`else if`/… chain from its head expression, collecting the
// ordered (condition, body) arms and the terminal `else` body. Returns `.None`
// unless the chain ends in a plain `else { … }` (a `.BlockExpr` else branch)
// and *every* branch is a single value expression — `cond` needs a total set of
// arms, and only a value-dispatch chain reads better as `cond`.
fn extract_if_chain(expr: Expr) CondChain? {
  arms: Vector<CondChainArm> = []
  cur := expr

  for true {
    case cur.kind {
      .If(cond_e, then_b, else_e) => {
        body := try block_value_expr(then_b)
        arms = .append(.{ condition: cond_e, body })

        case else_e {
          .None => return .None,
          .Some(e) => case e.kind {
            .If(_, _, _) => cur = e,
            .BlockExpr(b) => {
              else_body := try block_value_expr(b)
              return .Some(.{ arms, else_body })
            },
            _ => return .None,
          },
        }
      },
      _ => return .None,
    }
  }

  .None
}

fn render_cond(chain: CondChain, indent: String, source: String) String {
  arm_indent := "${indent}  "
  lines: Vector<String> = ["cond {"]

  for arm in chain.arms {
    cond_src := source.slice(arm.condition.span.start, arm.condition.span.end)
    body := source.slice(arm.body.span.start, arm.body.span.end)
    lines = .append("${arm_indent}${cond_src} => ${body},")
  }

  else_body := source.slice(chain.else_body.span.start, chain.else_body.span.end)
  lines = .append("${arm_indent}_ => ${else_body},")
  lines = .append("${indent}}")
  lines.join("\n")
}

fn prefer_cond_finding(expr: Expr, source: String) LintFinding? {
  chain := try extract_if_chain(expr)

  // Require at least two conditions before the `else` (one `else if`), so the
  // rewrite only fires on genuinely multi-way chains — a 3+ arm `cond`.
  if chain.arms.len() < 2 {
    return .None
  }

  indent := leading_line_indent(source, expr.span.start)
  replacement := chain.render_cond(indent, source)
  .Some(
    .{
      span: expr.span,
      message: "an `if`/`else if` chain ending in `else` reads better as `cond`",
      rule: "prefer-cond",
      edits: [FixEdit.{ start: expr.span.start, end: expr.span.end, replacement }],
    },
  )
}

// Lint an `if` chain: detect the prefer-cond rewrite once at the head, then lint
// every condition, then-block, and the terminal else by walking the chain
// directly instead of recursing through `lint_expr` on each `else if` — so a
// nested `else if` is never re-detected as its own (shorter) chain.
fn lint_if_expr(expr: Expr, ctx: LintCtx) Vector<LintFinding> {
  out: Vector<LintFinding> = []

  case prefer_cond_finding(expr, ctx.source) {
    .Some(f) => out = .append(f),
    .None => {},
  }

  cur := expr

  for true {
    case cur.kind {
      .If(c, then_b, else_e) => {
        out = .concat(lint_expr(c, ctx))
        out = .concat(lint_block(then_b, ctx))

        case else_e {
          .None => return out,
          .Some(e) => case e.kind {
            .If(_, _, _) => cur = e,
            _ => {
              out = .concat(lint_expr(e, ctx))
              return out
            },
          },
        }
      },
      _ => return out,
    }
  }

  out
}

fn lint_expr(expr: Expr, ctx: LintCtx) Vector<LintFinding> {
  case expr.kind {
    .BlockExpr(b) => lint_block(b, ctx),
    .If(_, _, _) => lint_if_expr(expr, ctx),
    .Case(scrut, arms) => {
      out := lint_expr(scrut, ctx)

      for arm in arms {
        out = .concat(lint_expr(arm.expr, ctx))
      }
      out
    },
    .Cond(arms) => {
      out: Vector<LintFinding> = []

      case prefer_case_dispatch_finding(expr, arms, ctx.source) {
        .Some(f) => out = .append(f),
        .None => {},
      }

      for arm in arms {
        case arm.condition {
          .Some(c) => out = .concat(lint_expr(c, ctx)),
          .None => {},
        }
        out = .concat(lint_expr(arm.body, ctx))
      }
      out
    },
    .Closure(_, _, body) => lint_block(body, ctx),
    .Collect(c) => {
      out: Vector<LintFinding> = []

      case c.iter {
        .Some(e) => out = .concat(lint_expr(e, ctx)),
        .None => {},
      }

      case c.condition {
        .Some(e) => out = .concat(lint_expr(e, ctx)),
        .None => {},
      }
      out = .concat(lint_block(c.body, ctx))
      out
    },
    .Call(callee, args) => case constant_concat_chain(expr) {
      // A constant string-literal `.concat` chain: fire iff it is a >=2-link,
      // multi-line, `\\`-safe value; otherwise leave it ENTIRELY alone. Never
      // descend into the chain to convert a sub-portion — that would emit a
      // mangled `(\\...).concat(...)` hybrid (e.g. when the whole value is
      // rejected for an interpolation but a prefix sub-chain is safe). Either
      // way its children are all literals, so nothing else to lint inside.
      .Some(c) => if c.links >= 2 and c.value.contains("\n") and multiline_safe(c.value) {
        [multiline_string_finding(expr, c.value, ctx.source)]
      } else {
        []
      },
      .None => {
        out: Vector<LintFinding> = []

        case callee.kind {
          .Ident(name) => if args.len() == 1 and ctx.is_public_prelude_io_sink(name) {
            case redundant_stringify_arg(args[0], ctx.source) {
              .Some(arg) => out = .append(redundant_print_stringify_finding(expr, name, arg)),
              .None => {},
            }
          },
          _ => {},
        }

        out = .concat(lint_expr(callee, ctx))

        for a in args {
          out = .concat(lint_expr(a, ctx))
        }
        out
      },
    },
    .Binary(_, l, r) => lint_expr(l, ctx).concat(lint_expr(r, ctx)),
    .Unary(_, e) => lint_expr(e, ctx),
    .Field(base, _) => lint_expr(base, ctx),
    .Index(base, idx) => lint_expr(base, ctx).concat(lint_expr(idx, ctx)),
    .Array(elems) => {
      out: Vector<LintFinding> = []

      for e in elems {
        out = .concat(lint_expr(e, ctx))
      }
      out
    },
    .Record(entries) => lint_record_entries(entries, ctx),
    .NamedRecord(_, entries) => lint_record_entries(entries, ctx),
    .Variant(_, args) => {
      out: Vector<LintFinding> = []

      for a in args {
        out = .concat(lint_expr(a, ctx))
      }
      out
    },
    .StringInterp(parts) => {
      out: Vector<LintFinding> = []

      for p in parts {
        case p {
          .Interpolation(e) => out = .concat(lint_expr(e, ctx)),
          .Literal(_) => {},
        }
      }
      out
    },
    _ => [],
  }
}

fn lint_record_entries(entries: Vector<RecordEntry>, ctx: LintCtx) Vector<LintFinding> {
  out: Vector<LintFinding> = []

  for en in entries {
    case en.value {
      .Some(e) => out = .concat(lint_expr(e, ctx)),
      .None => {},
    }
  }

  out
}

// ── L5: direct-rebinding ─────────────────────────────────────────────
/// Root identifier of a field/index path expression, else `.None`.
fn path_root(e: Expr) String? {
  case e.kind {
    .Ident(n) => .Some(n),
    .Field(base, _) => path_root(base),
    .Index(base, _) => path_root(base),
    _ => .None,
  }
}

/// True for an identifier plus field-only postfixes (no indexes, no calls).
fn is_field_path(e: Expr) Bool {
  case e.kind {
    .Ident(_) => true,
    .Field(base, _) => is_field_path(base),
    _ => false,
  }
}

/// Structural equality of field/index path expressions (no source text).
fn same_path(a: Expr, b: Expr) Bool {
  case a.kind {
    .Ident(na) => case b.kind {
      .Ident(nb) => na == nb,
      _ => false,
    },
    .Field(ba, fa) => case b.kind {
      .Field(bb, fb) => fa == fb and same_path(ba, bb),
      _ => false,
    },
    .Index(ba, ia) => case b.kind {
      .Index(bb, ib) => same_path(ba, bb) and same_path(ia, ib),
      _ => false,
    },
    _ => false,
  }
}

fn is_ident_named(e: Expr, name: String) Bool {
  case e.kind {
    .Ident(n) => n == name,
    _ => false,
  }
}

/// Render a path expression for the finding message.
fn path_string(e: Expr) String {
  case e.kind {
    .Ident(n) => n,
    .Field(base, f) => "${path_string(base)}.${f}",
    .Index(base, _) => "${path_string(base)}[..]",
    _ => "?",
  }
}

fn rebinding_finding(span: Span, tmp: String, src: Expr) LintFinding {
  rendered := path_string(src)
  report_finding(
    span,
    "`${tmp}` is only an alias for `${rendered}`; rebind `${rendered}` directly",
    "direct-rebinding",
  )
}

fn is_bare_ident(e: Expr) Bool {
  case e.kind {
    .Ident(_) => true,
    _ => false,
  }
}

fn opt_str_eq(a: String?, name: String) Bool {
  case a {
    .Some(v) => v == name,
    .None => false,
  }
}

/// Does identifier `name` appear anywhere as a read inside `e`? Statement-level
/// assignment targets are handled by the caller, not here. Unhandled compound
/// forms (blocks, if/case/cond, closures, comprehensions) conservatively count
/// as a use so candidates that embed them fail closed.
fn expr_uses_name(e: Expr, name: String) Bool {
  case e.kind {
    .Ident(n) => n == name,
    .IntLit(_) => false,
    .FloatLit(_) => false,
    .StringLit(_) => false,
    .BoolLit(_) => false,
    .ErrorExpr => false,
    .Unary(_, inner) => expr_uses_name(inner, name),
    .Binary(_, l, r) => expr_uses_name(l, name) or expr_uses_name(r, name),
    .Call(callee, args) => expr_uses_name(callee, name) or exprs_use_name(args, name),
    .Field(base, _) => expr_uses_name(base, name),
    .Index(base, idx) => expr_uses_name(base, name) or expr_uses_name(idx, name),
    .Array(elems) => exprs_use_name(elems, name),
    .Variant(_, args) => exprs_use_name(args, name),
    .Record(entries) => record_entries_use_name(entries, name),
    .NamedRecord(_, entries) => record_entries_use_name(entries, name),
    .StringInterp(parts) => {
      for p in parts {
        case p {
          .Interpolation(ie) => if expr_uses_name(ie, name) {
            return true
          },
          .Literal(_) => {},
        }
      }
      false
    },
    _ => true,
  }
}

fn exprs_use_name(es: Vector<Expr>, name: String) Bool {
  for e in es {
    if expr_uses_name(e, name) {
      return true
    }
  }
  false
}

fn record_entries_use_name(entries: Vector<RecordEntry>, name: String) Bool {
  for en in entries {
    case en.value {
      .Some(e) => if expr_uses_name(e, name) {
        return true
      },
      .None => if en.name == name {
        // Shorthand `{ name }` puns the local — a read.
        return true
      },
    }
  }
  false
}

/// True when `e` is a chain rooted at `tmp` as a method-call receiver / path
/// (`tmp`, `tmp.f`, `tmp[k]`, `tmp.m(args)`), with `tmp` never appearing in an
/// argument or index. This is the shape predicate #5 can rewrite by renaming
/// the root to the source.
fn expr_rooted_at(e: Expr, tmp: String) Bool {
  case e.kind {
    .Ident(n) => n == tmp,
    .Field(base, _) => expr_rooted_at(base, tmp),
    .Index(base, idx) => expr_rooted_at(base, tmp) and !expr_uses_name(idx, tmp),
    .Call(callee, args) => expr_rooted_at(callee, tmp) and !exprs_use_name(args, tmp),
    _ => false,
  }
}

/// Does any index sub-expression in path `e` use `name`?
fn path_indices_use(e: Expr, name: String) Bool {
  case e.kind {
    .Field(base, _) => path_indices_use(base, name),
    .Index(base, idx) => path_indices_use(base, name) or expr_uses_name(idx, name),
    _ => false,
  }
}

type StmtRole = { Update, CopyBack, Other }

/// Classify a statement relative to a `tmp := src` candidate (root `src_root`).
/// An update must be rooted at `tmp` and must not read the source independently.
fn classify_rebinding_stmt(stmt: Stmt, tmp: String, src: Expr, src_root: String) StmtRole {
  case stmt {
    .Expr(es) => case es.expr.kind {
      .Binary(.Assign, lhs, rhs) => if is_ident_named(rhs, tmp) and same_path(lhs, src) {
        // copy-back `<path> = tmp`
        .CopyBack
      } else if opt_str_eq(path_root(lhs), tmp) and !same_path(lhs, src) {
        // path-update on the temporary: `tmp.x = v`, `tmp[k] = v`
        clean := !expr_uses_name(rhs, tmp)
          and !expr_uses_name(rhs, src_root) and !path_indices_use(lhs, tmp)
          and !path_indices_use(lhs, src_root)

        if clean {
          .Update
        } else {
          .Other
        }
      } else {
        .Other
      },
      _ => .Other,
    },
    .Let(ls) => if ls.is_rebind and ls.name == tmp {
      // self-rebind accumulator: `cur = cur.method(...)`
      clean := expr_rooted_at(ls.value, tmp) and !expr_uses_name(ls.value, src_root)

      if clean {
        .Update
      } else {
        .Other
      }
    } else if ls.is_rebind
      and is_bare_ident(src) and ls.name == src_root and is_ident_named(ls.value, tmp) {
      // whole-value copy-back: `state = updated`
      .CopyBack
    } else {
      .Other
    },
    .For(fs) => if for_is_update_region(fs, tmp, src, src_root) {
      .Update
    } else {
      .Other
    },
    _ => .Other,
  }
}

/// A loop counts as an update region when its header never touches `tmp`/source,
/// it does not shadow them, and every body statement is itself a clean update.
fn for_is_update_region(fs: ForStmt, tmp: String, src: Expr, src_root: String) Bool {
  iter_clean := case fs.iter {
    .Some(e) => !expr_uses_name(e, tmp) and !expr_uses_name(e, src_root),
    .None => true,
  }
  cond_clean := case fs.condition {
    .Some(e) => !expr_uses_name(e, tmp) and !expr_uses_name(e, src_root),
    .None => true,
  }
  shadows := opt_str_eq(fs.pattern, tmp)
    or opt_str_eq(fs.pattern, src_root)
    or opt_str_eq(fs.index, tmp)
    or opt_str_eq(fs.index, src_root)

  if !iter_clean or !cond_clean or shadows {
    return false
  }

  // A loop body with a tail expression is unusual; bail rather than reason about it.
  case fs.body.tail {
    .Some(_) => return false,
    .None => {},
  }

  updates := 0

  for s in fs.body.stmts {
    case classify_rebinding_stmt(s, tmp, src, src_root) {
      .Update => updates = updates + 1,
      _ => return false,
    }
  }

  updates > 0
}

/// Scan statements after a `tmp := src` binding for an update region completed
/// either by a copy-back to the source or by returning `tmp` as the block tail.
/// Fails closed on any other use.
fn scan_rebinding_candidate(block: Block, start: Int, span: Span, tmp: String, src: Expr) LintFinding? {
  src_root := case path_root(src) {
    .Some(r) => r,
    .None => return .None,
  }
  stmts := block.stmts
  has_update := false
  j := start + 1

  for j < stmts.len() {
    case classify_rebinding_stmt(stmts[j], tmp, src, src_root) {
      .Update => has_update = true,
      .CopyBack => if has_update {
        return .Some(rebinding_finding(span, tmp, src))
      } else {
        return .None
      },
      .Other => return .None,
    }
    j = .inc()
  }

  // Tail-expression completion (whole-value alias only): the block returns the
  // temporary itself. Path sources return an inner value, not the rebound root,
  // so the suggestion would not apply — restrict to bare-identifier sources.
  case block.tail {
    .Some(t) => if has_update and is_bare_ident(src) and is_ident_named(t, tmp) {
      .Some(rebinding_finding(span, tmp, src))
    } else {
      .None
    },
    .None => .None,
  }
}

fn lint_direct_rebinding(block: Block) Vector<LintFinding> {
  out: Vector<LintFinding> = []
  stmts := block.stmts
  i := 0

  for i < stmts.len() {
    case stmts[i] {
      .Let(ls) => if !ls.is_rebind and is_field_path(ls.value) {
        case scan_rebinding_candidate(block, i, ls.span, ls.name, ls.value) {
          .Some(f) => out = .append(f),
          .None => {},
        }
      },
      _ => {},
    }
    i = .inc()
  }

  out
}

// ── numbered-rebinding ───────────────────────────────────────────────
/// Identifier reads that can be renamed exactly, or a conservative refusal
/// when an expression role cannot be enumerated without risking a partial
/// rename.
type IdentSpans = { Complete(Vector<Span>), Uncertain }

fn merge_ident_spans(a: IdentSpans, b: IdentSpans) IdentSpans {
  case a {
    .Uncertain => .Uncertain,
    .Complete(left) => case b {
      .Uncertain => .Uncertain,
      .Complete(right) => .Complete(left.concat(right)),
    },
  }
}

fn exprs_ident_spans(exprs: Vector<Expr>, name: String) IdentSpans {
  out: IdentSpans = .Complete([])

  for e in exprs {
    out = .merge_ident_spans(expr_ident_spans(e, name))

    case out {
      .Uncertain => return .Uncertain,
      .Complete(_) => {},
    }
  }

  out
}

fn record_ident_spans(entries: Vector<RecordEntry>, name: String) IdentSpans {
  out: IdentSpans = .Complete([])

  for en in entries {
    next: IdentSpans = case en.value {
      .Some(value) => expr_ident_spans(value, name),
      // A matching shorthand is a read but has no identifier-expression span;
      // rewriting it would also change the field name.
      .None => if en.name == name {
        .Uncertain
      } else {
        .Complete([])
      },
    }
    out = .merge_ident_spans(next)

    case out {
      .Uncertain => return .Uncertain,
      .Complete(_) => {},
    }
  }

  out
}

/// Collect every source span for reads of `name` in expression roles understood
/// by this v1 rule. Assignments and compound forms with nested scopes fail
/// closed so a later fixer can never rename only part of a binding's uses.
fn expr_ident_spans(e: Expr, name: String) IdentSpans {
  case e.kind {
    .Ident(n) => if n == name {
      .Complete([e.span])
    } else {
      .Complete([])
    },
    .IntLit(_) => .Complete([]),
    .FloatLit(_) => .Complete([]),
    .StringLit(_) => .Complete([]),
    .BoolLit(_) => .Complete([]),
    .ErrorExpr => .Complete([]),
    .Unary(_, inner) => expr_ident_spans(inner, name),
    .Binary(op, left, right) => case op {
      .Assign => .Uncertain,
      _ => expr_ident_spans(left, name).merge_ident_spans(expr_ident_spans(right, name)),
    },
    .Call(callee, args) => expr_ident_spans(callee, name).merge_ident_spans(
      exprs_ident_spans(args, name),
    ),
    .Field(base, _) => expr_ident_spans(base, name),
    .Index(base, index) => expr_ident_spans(base, name).merge_ident_spans(
      expr_ident_spans(index, name),
    ),
    .Array(elems) => exprs_ident_spans(elems, name),
    .Variant(_, args) => exprs_ident_spans(args, name),
    .Record(entries) => record_ident_spans(entries, name),
    .NamedRecord(_, entries) => record_ident_spans(entries, name),
    .StringInterp(parts) => {
      out: IdentSpans = .Complete([])

      for part in parts {
        case part {
          .Interpolation(inner) => out = .merge_ident_spans(expr_ident_spans(inner, name)),
          .Literal(_) => {},
        }

        case out {
          .Uncertain => return .Uncertain,
          .Complete(_) => {},
        }
      }

      out
    },
    // These forms carry nested blocks or scopes. The collector deliberately
    // does not cross them in v1.
    _ => .Uncertain,
  }
}

fn stmt_ident_spans(stmt: Stmt, name: String) IdentSpans {
  case stmt {
    // A later declaration or rebind owns the same spelling in a new role.
    .Let(ls) => if ls.name == name {
      .Uncertain
    } else {
      expr_ident_spans(ls.value, name)
    },
    // Nested blocks and deferred evaluation stay outside the straight-line
    // collector. Only a mention matters; unrelated forms contribute no spans.
    .For(_) => if stmt_mentions_name(stmt, name) {
      .Uncertain
    } else {
      .Complete([])
    },
    .Defer(ds) => if expr_uses_name(ds.expr, name) {
      .Uncertain
    } else {
      .Complete([])
    },
    .Return(rs) => case rs.value {
      .Some(value) => expr_ident_spans(value, name),
      .None => .Complete([]),
    },
    .Break(bs) => case bs.value {
      .Some(value) => expr_ident_spans(value, name),
      .None => .Complete([]),
    },
    .Continue(_) => .Complete([]),
    .Expr(es) => expr_ident_spans(es.expr, name),
    .ErrorStmt(_) => .Complete([]),
  }
}

fn forward_ident_spans(block: Block, start: Int, name: String) IdentSpans {
  out: IdentSpans = .Complete([])
  i := start + 1

  for i < block.stmts.len() {
    out = .merge_ident_spans(stmt_ident_spans(block.stmts[i], name))

    case out {
      .Uncertain => return .Uncertain,
      .Complete(_) => {},
    }
    i = .inc()
  }

  case block.tail {
    .Some(tail) => out.merge_ident_spans(expr_ident_spans(tail, name)),
    .None => out,
  }
}

fn has_complete_ident(spans: IdentSpans) Bool {
  case spans {
    .Complete(found) => found.len() > 0,
    .Uncertain => false,
  }
}

fn has_no_complete_ident(spans: IdentSpans) Bool {
  case spans {
    .Complete(found) => found.len() == 0,
    .Uncertain => false,
  }
}

fn append_unique_name(names: Vector<String>, name: String) Vector<String> {
  for existing in names {
    if existing == name {
      return names
    }
  }

  names.append(name)
}

/// Lexical bases admitted by the numbered/suffixed sibling heuristic. A name
/// can yield more than one base; semantic gates must reduce this to one.
fn sibling_base_candidates(tmp: String) Vector<String> {
  out: Vector<String> = []

  digit_start := tmp.len()
  for digit_start > 0 and tmp[digit_start - 1].is_digit() {
    digit_start = .dec()
  }
  if digit_start > 0 and digit_start < tmp.len() {
    out = append_unique_name(out, tmp.slice(0, digit_start))
  }

  i := 1
  for i + 1 < tmp.len() {
    if tmp[i] == 0x5F {
      out = append_unique_name(out, tmp.slice(0, i))
    }
    i = .inc()
  }

  for prefix in ["new_", "next_", "cur_"] {
    if tmp.starts_with(prefix) and tmp.len() > prefix.len() {
      out = append_unique_name(out, tmp.slice(prefix.len(), tmp.len()))
    }
  }

  out
}

/// True only for the three v1 ceremony spellings: trailing digits, a non-empty
/// underscore suffix, or one of the closed leading markers.
fn is_numbered_sibling(tmp: String, base: String) Bool {
  if base == "" or tmp == base {
    return false
  }

  if tmp.starts_with(base) {
    rest := tmp.slice(base.len(), tmp.len())
    if rest.starts_with("_") and rest.len() > 1 {
      return true
    }

    if rest.len() > 0 {
      all_digits := true
      for b in rest {
        if !b.is_digit() {
          all_digits = false
        }
      }
      if all_digits {
        return true
      }
    }
  }

  tmp == "new_${base}" or tmp == "next_${base}" or tmp == "cur_${base}"
}

/// Gate 3: the nearest preceding statement that binds `name` must be a fresh,
/// private declaration in this exact block. Parameters, outer locals, and a
/// preceding rebind do not qualify.
fn has_same_block_declaration(block: Block, before: Int, name: String) Bool {
  i := before

  for i >= 0 {
    case block.stmts[i] {
      .Let(ls) => if ls.name == name {
        return !ls.is_rebind and !ls.is_pub
      },
      _ => {},
    }
    i = .dec()
  }

  false
}

fn numbered_rebinding_finding(span: Span, tmp: String, base: String) LintFinding {
  report_finding(
    span,
    "`${tmp}` only advances `${base}`; rebind `${base}` and keep threading that name",
    "numbered-rebinding",
  )
}

fn shape_one_numbered_finding(block: Block, i: Int, ls: LetStmt) LintFinding? {
  if ls.is_rebind or ls.is_pub {
    return .None
  }

  surviving: Vector<String> = []
  for base in sibling_base_candidates(ls.name) {
    if is_numbered_sibling(ls.name, base)
      and has_same_block_declaration(block, i - 1, base)
      and expr_ident_spans(ls.value, base).has_complete_ident() {
      surviving = append_unique_name(surviving, base)
    }
  }

  if surviving.len() != 1 {
    return .None
  }

  base := surviving[0]
  if source_used_after(block, i, base) {
    return .None
  }

  if !forward_ident_spans(block, i, ls.name).has_complete_ident() {
    return .None
  }

  .Some(numbered_rebinding_finding(ls.span, ls.name, base))
}

fn shape_two_loop_is_valid(fs: ForStmt, tmp: String, base: String) Bool {
  iter_clean := case fs.iter {
    .Some(e) => !expr_uses_name(e, tmp) and !expr_uses_name(e, base),
    .None => true,
  }
  condition_clean := case fs.condition {
    .Some(e) => !expr_uses_name(e, tmp) and !expr_uses_name(e, base),
    .None => true,
  }
  shadows := opt_str_eq(fs.pattern, tmp)
    or opt_str_eq(fs.pattern, base)
    or opt_str_eq(fs.index, tmp)
    or opt_str_eq(fs.index, base)

  if !iter_clean or !condition_clean or shadows {
    return false
  }

  case fs.body.tail {
    .Some(_) => return false,
    .None => {},
  }

  updates := 0
  for stmt in fs.body.stmts {
    case stmt {
      .Let(ls) => if ls.is_rebind
        and ls.name == tmp and expr_ident_spans(ls.value, tmp).has_complete_ident()
        and expr_ident_spans(ls.value, base).has_no_complete_ident() {
        updates = .inc()
      } else {
        return false
      },
      _ => return false,
    }
  }

  updates > 0
}

fn shape_two_numbered_finding(block: Block, i: Int, ls: LetStmt) LintFinding? {
  if ls.is_rebind or ls.is_pub or ls.name != "cur" {
    return .None
  }
  case ls.ty {
    .Some(_) => return .None,
    .None => {},
  }

  base := case ls.value.kind {
    .Ident(name) => name,
    _ => return .None,
  }
  if !has_same_block_declaration(block, i - 1, base) or source_used_after(block, i, base) {
    return .None
  }

  // The loop must be the only statement after the seed, followed by the exact
  // `cur` tail of the enclosing block.
  if i + 2 != block.stmts.len() {
    return .None
  }
  case block.tail {
    .Some(tail) => if !is_ident_named(tail, "cur") {
      return .None
    },
    .None => return .None,
  }

  case block.stmts[i + 1] {
    .For(fs) => if shape_two_loop_is_valid(fs, "cur", base) {
      .Some(numbered_rebinding_finding(ls.span, "cur", base))
    } else {
      .None
    },
    _ => .None,
  }
}

fn lint_numbered_rebinding(block: Block, source: String) Vector<LintFinding> {
  out: Vector<LintFinding> = []

  for stmt, i in block.stmts {
    case stmt {
      .Let(ls) => {
        case shape_one_numbered_finding(block, i, ls) {
          .Some(finding) => out = .append(finding),
          .None => {},
        }
        case shape_two_numbered_finding(block, i, ls) {
          .Some(finding) => out = .append(finding),
          .None => {},
        }
      },
      _ => {},
    }
  }

  out
}

// ── inline-record-copy ───────────────────────────────────────────────
/// If `entry` is `field: S.field` (a verbatim same-name copy of source `S`),
/// return `S`; else `.None`. Shorthand puns, cross-field reads (`f: s.g`), and
/// computed values are not verbatim copies.
fn entry_copy_source(entry: RecordEntry) String? {
  case entry.value {
    .Some(e) => case e.kind {
      .Field(base, fname) => case base.kind {
        .Ident(bn) => if fname == entry.name {
          .Some(bn)
        } else {
          .None
        },
        _ => .None,
      },
      _ => .None,
    },
    .None => .None,
  }
}

/// Declared nominal types of a function's parameters, seeding the type map that
/// inline-record-copy uses to confirm a copy source's type.
fn param_types(decl: FunctionDecl) Dict<String, String> {
  out: Dict<String, String> = Dict.new()

  for p in decl.params {
    case p.ty {
      .Some(t) => case type_name(t) {
        .Some(n) => out[p.name] = n,
        .None => {},
      },
      .None => {},
    }
  }

  out
}

type CopyDominance = .{ src: String, majority: Bool }

/// The source identifier copied by a strict majority of `entries` (each a
/// verbatim `field: src.field`), and whether such a majority exists.
fn dominant_copy_source(entries: Vector<RecordEntry>) CopyDominance {
  total := entries.len()
  counts: Dict<String, Int> = Dict.new()

  for en in entries {
    case entry_copy_source(en) {
      .Some(s) => counts[s] = counts[s].unwrap_or(0) + 1,
      .None => {},
    }
  }

  best_src := ""
  best := 0

  for s, c in counts {
    if c > best {
      best = c
      best_src = s
    }
  }

  .{ src: best_src, majority: total >= 2 and best * 2 > total }
}

/// Does `name` appear anywhere in `block`'s statements or tail after index `i`?
/// Used as a conservative liveness check: it leans on `expr_uses_name` (which
/// fails closed on compound expressions), so an unclear use reads as live and
/// suppresses the finding.
fn source_used_after(block: Block, i: Int, name: String) Bool {
  j := i + 1

  for j < block.stmts.len() {
    if stmt_mentions_name(block.stmts[j], name) {
      return true
    }

    j = .inc()
  }

  case block.tail {
    .Some(e) => expr_uses_name(e, name),
    .None => false,
  }
}

fn stmt_mentions_name(stmt: Stmt, name: String) Bool {
  case stmt {
    // A rebinding of `name` counts as a mention (conservative).
    .Let(s) => s.name == name or expr_uses_name(s.value, name),
    .For(s) => {
      iter_u := case s.iter {
        .Some(e) => expr_uses_name(e, name),
        .None => false,
      }
      cond_u := case s.condition {
        .Some(e) => expr_uses_name(e, name),
        .None => false,
      }
      iter_u
        or cond_u
        or opt_str_eq(s.pattern, name)
        or opt_str_eq(s.index, name)
        or block_mentions_name(s.body, name)
    },
    .Return(s) => case s.value {
      .Some(e) => expr_uses_name(e, name),
      .None => false,
    },
    .Break(s) => case s.value {
      .Some(e) => expr_uses_name(e, name),
      .None => false,
    },
    .Continue(_) => false,
    .Defer(s) => expr_uses_name(s.expr, name),
    .Expr(s) => expr_uses_name(s.expr, name),
    .ErrorStmt(_) => false,
  }
}

fn block_mentions_name(block: Block, name: String) Bool {
  for stmt in block.stmts {
    if stmt_mentions_name(stmt, name) {
      return true
    }
  }

  case block.tail {
    .Some(e) => expr_uses_name(e, name),
    .None => false,
  }
}

/// Inline-record-copy check for the `let` at statement index `i`: fires only on a
/// *named* literal `T.{ ... }` that copies a strict majority of its fields from
/// one source of the same declared nominal type, and only when rebinding that
/// source is sound — a self-rebind (`st = St.{…st…}`), or a source whose old
/// value is dead after the binding. Anonymous `.{ ... }` literals are excluded
/// (no explicit type to match the source against).
/// The indentation of the statement at byte offset `start`: the run from the
/// line start up to `start`, but only when that run is all whitespace (the
/// statement begins its line). `.None` means the statement shares its line with
/// other code (e.g. a single-line block), where synthesizing indented rebind
/// lines would be malformed — the caller then declines the auto-fix.
fn line_indent(source: String, start: Int) String? {
  i := start

  for i > 0 and source.slice(i - 1, i) != "\n" {
    i = .dec()
  }

  run := source.slice(i, start)

  if run.trim() == "" {
    .Some(run)
  } else {
    .None
  }
}

// The entries not copied verbatim from `src` — the fields a rebind must set.
fn changed_entries(entries: Vector<RecordEntry>, src: String) Vector<RecordEntry> {
  out: Vector<RecordEntry> = []

  for en in entries {
    is_copy := case entry_copy_source(en) {
      .Some(s) => s == src,
      .None => false,
    }

    if !is_copy {
      out = .append(en)
    }
  }

  out
}

// The rebinds are applied as sequential statements that mutate `src` in place, so
// a changed field whose value reads `src` could observe an already-rebound
// sibling rather than the original the literal saw. Safe when there is a single
// changed field (its own rebind reads the still-original `src`), or when no
// changed value reads `src` at all. `expr_uses_name` fails closed on compound
// expressions, so an unclear value reads as a dependency and declines the fix.
fn changed_rebinds_order_safe(changed: Vector<RecordEntry>, src: String) Bool {
  if changed.len() <= 1 {
    return true
  }

  for en in changed {
    case en.value {
      .Some(e) => if expr_uses_name(e, src) {
        return false
      },
      .None => {},
    }
  }

  true
}

// Machine-applicable rewrite for an inline-record-copy finding. v1 auto-fixes
// only the self-rebind shape (`st = St.{…st…}`): replace the reconstruction with
// one `src.field = value` rebind per changed field (a value not copied verbatim
// from `src`). Fresh bindings stay report-only.
fn inline_copy_edits(
  ls: LetStmt,
  src: String,
  entries: Vector<RecordEntry>,
  self_rebind: Bool,
  source: String,
) Vector<FixEdit> {
  if !self_rebind {
    return []
  }

  // Only rewrite a statement that begins its own line — otherwise the
  // multi-line rebind we'd synthesize can't be indented correctly.
  indent := case line_indent(source, ls.span.start) {
    .Some(w) => w,
    .None => return [],
  }
  changed := changed_entries(entries, src)

  // A pure self-copy (nothing changed) is a no-op; the multi-field sequential
  // rebind is only safe when a changed value can't observe a rebound sibling.
  if changed.len() == 0 or !changed_rebinds_order_safe(changed, src) {
    return []
  }

  lines := collect en in changed {
    value_text := case en.value {
      // Shorthand `{ f }` rebinds `src.f` from the same-named local.
      .None => en.name,
      .Some(e) => source.slice(e.span.start, e.span.end),
    }
    "${src}.${en.name} = ${value_text}"
  }
  [.{ start: ls.span.start, end: ls.span.end, replacement: lines.join("\n${indent}") }]
}

fn inline_copy_finding_for_let(block: Block, i: Int, ls: LetStmt, ctx: LintCtx) LintFinding? {
  case ls.value.kind {
    .NamedRecord(tname, entries) => {
      dom := dominant_copy_source(entries)

      type_ok := case ctx.types[dom.src] {
        .Some(tn) => tn == tname,
        .None => false,
      }
      self_rebind := ls.is_rebind and ls.name == dom.src
      sound := self_rebind or !source_used_after(block, i, dom.src)

      if dom.majority and type_ok and sound {
        .Some(
          .{
            span: ls.span,
            message: "`${ls.name}` rebuilds `${dom.src}` by copying its fields; rebind `${dom.src}` directly (`${dom.src}.field = v`) instead of constructing a copy",
            rule: "inline-record-copy",
            edits: inline_copy_edits(ls, dom.src, entries, self_rebind, ctx.source),
          },
        )
      } else {
        .None
      }
    },
    _ => .None,
  }
}

// ── redundant-record-prefix ──────────────────────────────────────────
/// A `NamedRecord` literal `T.{ … }` sitting where an expected record type is
/// already known can drop its `T` prefix for the contextual `.{ … }` form. A
/// `NamedRecord` node witnesses that its name is a record type (you cannot spell
/// `Enum.{ … }` / `Int.{ … }`), so no env lookup is needed — the walk threads
/// only whether the current position is expected-typed.
/// Per-function invariants for the walk. `returns_typed` is whether the enclosing
/// function declares a return type (making its tail/return positions
/// expected-typed).
type PrefixCtx = .{ source: String, returns_typed: Bool }

/// Strip edit for `NamedRecord(name, …)` at `expr`: delete the `name` prefix,
/// leaving `.{ … }`. Qualified paths (`pt.Point.{ … }`) are refused up front
/// by the `name.contains(".")` guard, since `dotted_name_expr` folds the
/// whole qualifier into `name`. Beyond that, declines (empty) unless the
/// literal is spelled exactly `name.{` at the expr's start — the byte-slice
/// equality check guards against trivia between `name` and `.{` and against
/// a span that does not start at `name`. Type names are ASCII, so
/// `name.len()` matches the byte span; the equality check declines on any
/// mismatch, so a wrong size can never produce a bad edit.
fn prefix_strip_edits(source: String, expr: Expr, name: String) Vector<FixEdit> {
  start := expr.span.start
  stop := start + name.len()

  // A qualified path (`mod.Config`) is folded into `name` verbatim by
  // `dotted_name_expr`, so the slice-equality check below would otherwise
  // match its own spelling and strip the whole qualifier. Decline explicitly:
  // PascalCase type names never contain `.`, so this only ever fires on a
  // dotted path.
  if name.contains(".") {
    return []
  }
  if source.slice(start, stop) != name {
    return []
  }
  if source.slice(stop, stop + 2) != ".{" {
    return []
  }

  [.{ start, end: stop, replacement: "" }]
}

fn prefix_finding(ctx: PrefixCtx, expr: Expr, name: String) Vector<LintFinding> {
  edits := prefix_strip_edits(ctx.source, expr, name)

  if edits.len() == 0 {
    return []
  }

  [
    .{
      span: expr.span,
      message: "`${name}.{ }` is in a position with a known expected type; drop the `${name}` prefix and use `.{ }`",
      rule: "redundant-record-prefix",
      edits,
    },
  ]
}

fn walk_expr(ctx: PrefixCtx, expr: Expr, expected: Bool) Vector<LintFinding> {
  case expr.kind {
    .NamedRecord(name, entries) => {
      out: Vector<LintFinding> = if expected {
        ctx.prefix_finding(expr, name)
      } else {
        []
      }

      // A record field always carries a declared type.
      for en in entries {
        case en.value {
          .Some(v) => out = .concat(ctx.walk_expr(v, true)),
          .None => {},
        }
      }

      out
    },
    .Record(entries) => {
      out: Vector<LintFinding> = []

      for en in entries {
        case en.value {
          .Some(v) => out = .concat(ctx.walk_expr(v, true)),
          .None => {},
        }
      }

      out
    },
    .Call(callee, args) => {
      out := ctx.walk_expr(callee, false)

      // Call arguments are NOT anchored in v1: when the callee is generic, a
      // parameter's declared type can be a type variable resolved by inference
      // (often from a later argument), so a bare `.{ … }` there has no known
      // expected type and would not typecheck. Left as a documented follow-up.
      for a in args {
        out = .concat(ctx.walk_expr(a, false))
      }

      out
    },
    .If(c, then_blk, else_e) => {
      out := ctx.walk_expr(c, false)
      out = .concat(ctx.walk_block(then_blk, expected))

      case else_e {
        .Some(e) => out = .concat(ctx.walk_expr(e, expected)),
        .None => {},
      }

      out
    },
    .Case(scrut, arms) => {
      out := ctx.walk_expr(scrut, false)

      for arm in arms {
        out = .concat(ctx.walk_expr(arm.expr, expected))
      }

      out
    },
    .Cond(arms) => {
      out: Vector<LintFinding> = []

      for arm in arms {
        case arm.condition {
          .Some(c) => out = .concat(ctx.walk_expr(c, false)),
          .None => {},
        }
        out = .concat(ctx.walk_expr(arm.body, expected))
      }

      out
    },
    .BlockExpr(block) => ctx.walk_block(block, expected),
    .Binary(_, l, r) => ctx.walk_expr(l, false).concat(ctx.walk_expr(r, false)),
    .Unary(_, inner) => ctx.walk_expr(inner, false),
    .Field(base, _) => ctx.walk_expr(base, false),
    .Index(a, b) => ctx.walk_expr(a, false).concat(ctx.walk_expr(b, false)),
    .Array(elems) => {
      out: Vector<LintFinding> = []

      for el in elems {
        out = .concat(ctx.walk_expr(el, false))
      }

      out
    },
    .Variant(_, args) => {
      out: Vector<LintFinding> = []

      for a in args {
        out = .concat(ctx.walk_expr(a, false))
      }

      out
    },
    .Closure(_, ret_ty, body) => {
      returns_typed := case ret_ty {
        .Some(_) => true,
        .None => false,
      }
      closure_ctx := PrefixCtx.{ source: ctx.source, returns_typed }
      closure_ctx.walk_block(body, returns_typed)
    },
    .StringInterp(parts) => {
      out: Vector<LintFinding> = []

      for p in parts {
        case p {
          .Interpolation(e) => out = .concat(ctx.walk_expr(e, false)),
          .Literal(_) => {},
        }
      }

      out
    },
    .Collect(ce) => {
      out: Vector<LintFinding> = []

      case ce.iter {
        .Some(e) => out = .concat(ctx.walk_expr(e, false)),
        .None => {},
      }
      case ce.condition {
        .Some(e) => out = .concat(ctx.walk_expr(e, false)),
        .None => {},
      }
      out = .concat(ctx.walk_block(ce.body, false))

      out
    },
    _ => [],
  }
}

fn walk_block(ctx: PrefixCtx, block: Block, tail_expected: Bool) Vector<LintFinding> {
  out: Vector<LintFinding> = []

  for stmt in block.stmts {
    out = .concat(ctx.walk_stmt(stmt))
  }

  case block.tail {
    .Some(e) => out = .concat(ctx.walk_expr(e, tail_expected)),
    .None => {},
  }

  out
}

fn walk_stmt(ctx: PrefixCtx, stmt: Stmt) Vector<LintFinding> {
  case stmt {
    .Let(ls) => {
      annotated := case ls.ty {
        .Some(_) => true,
        .None => false,
      }
      ctx.walk_expr(ls.value, annotated)
    },
    .Return(rs) => case rs.value {
      .Some(e) => ctx.walk_expr(e, ctx.returns_typed),
      .None => [],
    },
    .Expr(es) => ctx.walk_expr(es.expr, false),
    .For(fs) => {
      out: Vector<LintFinding> = []

      case fs.iter {
        .Some(e) => out = .concat(ctx.walk_expr(e, false)),
        .None => {},
      }
      case fs.condition {
        .Some(e) => out = .concat(ctx.walk_expr(e, false)),
        .None => {},
      }
      out = .concat(ctx.walk_block(fs.body, false))

      out
    },
    .Break(bs) => case bs.value {
      .Some(e) => ctx.walk_expr(e, false),
      .None => [],
    },
    .Continue(_) => [],
    .Defer(ds) => ctx.walk_expr(ds.expr, false),
    .ErrorStmt(_) => [],
  }
}

/// Entry point per function: the body's tail/return positions are expected-typed
/// exactly when the function declares a return type.
fn lint_redundant_prefix_decl(decl: FunctionDecl, source: String) Vector<LintFinding> {
  returns_typed := case decl.return_type {
    .Some(_) => true,
    .None => false,
  }
  ctx := PrefixCtx.{ source, returns_typed }
  ctx.walk_block(decl.body, returns_typed)
}

// ── L3: record-copy-helper ───────────────────────────────────────────
/// The trailing nominal name of a type expression (`State`, `foo.State`,
/// `State<T>` → "State"), or `.None` for structural/function types.
fn type_name(te: TypeExpr) String? {
  case te.kind {
    .Path(tp) => last_segment(tp.segments),
    .Applied(tp, _) => last_segment(tp.segments),
    _ => .None,
  }
}

fn last_segment(segments: Vector<String>) String? {
  if segments.len() > 0 {
    .Some(segments[segments.len() - 1])
  } else {
    .None
  }
}

type EntryKind = { CopyFromP, UpdatedCopy, Trivial, NonTrivial }

/// The leftmost operand/receiver an expression is built from: peel the
/// "update" layers (method call, binary/unary op, index) down to the value
/// being transformed, so `m.inner.set(k, v)` and `p.count + 1` both bottom out
/// at the field they derive from.
fn spine_base(e: Expr) Expr {
  case e.kind {
    // A method call `recv.method(args)` transforms `recv`; a plain call
    // `f(args)` is anchored by its callee.
    .Call(callee, _) => case callee.kind {
      .Field(recv, _) => spine_base(recv),
      _ => spine_base(callee),
    },
    .Binary(_, l, _) => spine_base(l),
    .Unary(_, inner) => spine_base(inner),
    .Index(base, _) => spine_base(base),
    _ => e,
  }
}

/// Classify a record entry relative to the candidate copy-source param `pname`.
fn classify_entry(pname: String, entry: RecordEntry) EntryKind {
  case entry.value {
    // Shorthand `f,` puns a same-named param/local — a trivial copy.
    .None => .Trivial,
    .Some(e) => case e.kind {
      // Bare param/local reference.
      .Ident(_) => .Trivial,
      .Field(base, fname) => case base.kind {
        .Ident(bn) => if bn == pname and fname == entry.name {
          // `f: p.f` — a verbatim copy of `p`'s same-named field.
          .CopyFromP
        } else {
          // Any other field access on a param/local is still trivial.
          .Trivial
        },
        _ => .NonTrivial,
      },
      // A call/op/index whose transformed value is `p`'s same-named field
      // (`f: p.f.set(k, v)`, `f: p.f + 1`) is a copy-with-update, not real work.
      _ => case spine_base(e).kind {
        .Field(rb, rf) => case rb.kind {
          .Ident(rbn) => if rbn == pname and rf == entry.name {
            .UpdatedCopy
          } else {
            .NonTrivial
          },
          _ => .NonTrivial,
        },
        _ => .NonTrivial,
      },
    },
  }
}

/// True when `entries` reconstruct `pname` as *the source with a tweak* — the
/// case where a direct rebinding is clearer than re-listing the record.
///
/// The rewrite pays off by eliminating verbatim re-listing of preserved fields,
/// so we flag when the record either copies at least one field of `pname`
/// verbatim, or is a single-field wrapper whose one field is updated from its
/// own prior value. A multi-field record that recomputes *every* field from
/// scratch (no verbatim copy) is a construction / field-wise combine — the
/// literal is the clearer, safer form (adding a field forces handling it), so it
/// is left alone.
fn is_copy_rebuild(pname: String, entries: Vector<RecordEntry>) Bool {
  copies := 0
  updates := 0

  for entry in entries {
    case classify_entry(pname, entry) {
      .CopyFromP => copies = copies + 1,
      .UpdatedCopy => updates = updates + 1,
      .Trivial => {},
      .NonTrivial => return false,
    }
  }

  if copies >= 1 {
    return true
  }

  // No verbatim copy: only a single-field wrapper's lone update is worth
  // rebinding; recomputing every field of a multi-field record is construction.
  updates >= 1 and entries.len() == 1
}

// True when `e` is exactly `pname.fname`.
fn is_field_of(pname: String, fname: String, e: Expr) Bool {
  case e.kind {
    .Field(base, f) => f == fname
      and case base.kind {
        .Ident(bn) => bn == pname,
        _ => false,
      },
    _ => false,
  }
}

// Source text for the rebinding RHS. A method call on the same field
// (`p.f.set(k, v)`) becomes the `.set(k, v)` rebinding shorthand; anything else
// (`p.f + 1`) keeps its original text.
fn updated_rhs_text(pname: String, fname: String, rhs: Expr, source: String) String {
  case rhs.kind {
    .Call(callee, _) => case callee.kind {
      .Field(recv, _) => if is_field_of(pname, fname, recv) {
        source.slice(recv.span.end, rhs.span.end)
      } else {
        source.slice(rhs.span.start, rhs.span.end)
      },
      _ => source.slice(rhs.span.start, rhs.span.end),
    },
    _ => source.slice(rhs.span.start, rhs.span.end),
  }
}

// True when every argument is free of any reference to `base`.
fn args_base_free(base: String, args: Vector<Expr>) Bool {
  for a in args {
    if refs_in_expr(a, base).has_bare {
      return false
    }
  }

  true
}

// True when `e`'s only reference to `base` is the `base.field` at its update
// spine — every sibling operand (call arguments, a binary right operand, an
// index subscript) is base-free. Such an update reads only the *original*
// `base.field`, so rebinding several of them in sequence observes no field a
// prior line already rebound, matching the simultaneous record construction.
// `label_ctx_enter_named`'s `named_levels: ctx.named_levels.set(k, ctx.depth)`
// fails here: the `ctx.depth` argument is a second reference to a field the
// `depth` update rebinds.
fn spine_siblings_safe(base: String, e: Expr) Bool {
  case e.kind {
    .Call(callee, args) => case callee.kind {
      .Field(recv, _) => spine_siblings_safe(base, recv) and args_base_free(base, args),
      _ => spine_siblings_safe(base, callee) and args_base_free(base, args),
    },
    .Binary(_, l, r) => spine_siblings_safe(base, l) and !refs_in_expr(r, base).has_bare,
    .Unary(_, inner) => spine_siblings_safe(base, inner),
    .Index(recv, idx) => spine_siblings_safe(base, recv) and !refs_in_expr(idx, base).has_bare,
    // Spine end: `base.field` (a field access on the bare base) or a bare ident.
    .Field(recv, _) => case recv.kind {
      .Ident(_) => true,
      _ => spine_siblings_safe(base, recv),
    },
    .Ident(_) => true,
    _ => false,
  }
}

// R1 autofix: every entry is a verbatim copy of `pname` or a field updated from
// its own prior value (at least one update), and the result record is the
// function's tail expression. Rewrites to a sequence of direct rebindings
// (`p.f = …; p.g = …; p`). Each update must reference `pname` only at its own
// `pname.field` spine (see `spine_siblings_safe`) so the rebinds are
// order-independent. Any `Trivial` entry (a shorthand pun or a field pulled from
// another value), a pure verbatim copy (no update), or an order-hazardous update
// ⇒ report-only.
fn updated_copy_edits(pname: String, entries: Vector<RecordEntry>, result: Expr, source: String) Vector<
  FixEdit,
> {
  updated: Vector<RecordEntry> = []

  for entry in entries {
    case classify_entry(pname, entry) {
      .UpdatedCopy => updated = .append(entry),
      .CopyFromP => {},
      _ => return [],
    }
  }

  if updated.len() == 0 {
    return []
  }

  indent := case line_indent(source, result.span.start) {
    .Some(w) => w,
    .None => return [],
  }

  lines: Vector<String> = []

  for ue in updated {
    rhs := case ue.value {
      .Some(e) => e,
      .None => return [],
    }

    if !spine_siblings_safe(pname, rhs) {
      return []
    }

    rhs_text := updated_rhs_text(pname, ue.name, rhs, source)

    // A multi-line RHS (e.g. a value with a newline-continued operator) would
    // rebind onto several lines and read as separate statements; leave it
    // report-only so every rebind stays a clean single line.
    if rhs_text.contains("\n") {
      return []
    }

    lines = .append("${pname}.${ue.name} = ${rhs_text}")
  }

  replacement := lines.join("\n${indent}").concat("\n${indent}${pname}")
  [.{ start: result.span.start, end: result.span.end, replacement }]
}

fn copy_finding(decl: FunctionDecl, rec_type: String, edits: Vector<FixEdit>) Vector<LintFinding> {
  [
    .{
      span: decl.name_span,
      message: "`${decl.name}` rebuilds `${rec_type}` by copying fields; rebind directly (`p.field = v`) instead",
      rule: "record-copy-helper",
      edits,
    },
  ]
}

type RecordResult = .{ rec_type: String, entries: Vector<RecordEntry> }

fn lint_record_copy(decl: FunctionDecl, env: ResolvedEnv, source: String) Vector<LintFinding> {
  // The result expression is the body's trailing expression.
  result := case decl.body.tail {
    .Some(e) => e,
    .None => return [],
  }

  // It must be a record literal; determine the nominal type it builds.
  pair: RecordResult? = case result.kind {
    .NamedRecord(name, entries) => .Some(.{ rec_type: name, entries }),
    .Record(entries) => case decl.return_type {
      .Some(rt) => case type_name(rt) {
        .Some(name) => .Some(.{ rec_type: name, entries }),
        .None => .None,
      },
      .None => .None,
    },
    _ => .None,
  }
  found := case pair {
    .Some(p) => p,
    .None => return [],
  }

  // Flag if some parameter of the same nominal type is copied field-by-field.
  for param in decl.params {
    same_type := case param.ty {
      .Some(t) => case type_name(t) {
        .Some(n) => n == found.rec_type,
        .None => false,
      },
      .None => false,
    }

    if same_type and is_copy_rebuild(param.name, found.entries) {
      edits := updated_copy_edits(param.name, found.entries, result, source)
      return copy_finding(decl, found.rec_type, edits)
    }
  }

  []
}
