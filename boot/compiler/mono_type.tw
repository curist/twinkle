//! Core monomorphic type representation for the Twinkle compiler.
//!
//! Extracted from resolver.tw so that both lib/source/diagnostics.tw and
//! compiler/resolver.tw can import MonoType without circular dependency.

pub type TypeId = .{ id: Int }

pub type MonoType = {
  Int,
  Float,
  Bool,
  Byte,
  String,
  Void,
  Anyref_,
  ExternRef(TypeId),
  Var(String),
  Named(TypeId, Vector<MonoType>),
  Vector(MonoType),
  Dict(MonoType, MonoType),
  Function(Vector<MonoType>, MonoType),
  Optional(MonoType),
  Result(MonoType, MonoType),
  MetaVar(Int),
  Never,
  ErrorType,
}

// Build a method table key for contract resolution keyed by receiver type.
// Returns e.g. "Int::to_string", "t42::eq", "Vector::to_string".
pub fn method_table_key(receiver_ty: MonoType, method_name: String) String? {
  receiver_key: String? = case receiver_ty {
    .Int => .Some("Int"),
    .Float => .Some("Float"),
    .Bool => .Some("Bool"),
    .Byte => .Some("Byte"),
    .String => .Some("String"),
    .Vector(_) => .Some("Vector"),
    .Dict(_, _) => .Some("Dict"),
    .Optional(_) => .Some("Option"),
    .Result(_, _) => .Some("Result"),
    .Named(tid, _) => .Some("t${tid.id}"),
    .ExternRef(tid) => .Some("t${tid.id}"),
    _ => .None,
  }

  case receiver_key {
    .Some(k) => .Some("${k}::${method_name}"),
    .None => .None,
  }
}

// Debug-only type stringifier — Named types render as raw ids (e.g. "Named(3)").
// Prefer ty_to_string_env (in resolver) for user-facing diagnostics.
pub fn ty_to_string(ty: MonoType) String {
  case ty {
    .Int => "Int",
    .Float => "Float",
    .Bool => "Bool",
    .Byte => "Byte",
    .String => "String",
    .Void => "Void",
    .Anyref_ => "Anyref",
    .ExternRef(tid) => "ExternRef(${tid.id})",
    .Never => "Never",
    .Var(n) => n,
    .MetaVar(id) => "?${id}",
    .Vector(inner) => "Vector<${inner.ty_to_string()}>",
    .Dict(k, v) => "Dict<${k.ty_to_string()}, ${v.ty_to_string()}>",
    .Optional(inner) => "${inner.ty_to_string()}?",
    .Result(ok, err) => "Result<${ok.ty_to_string()}, ${err.ty_to_string()}>",
    .Named(tid, args) => if args.len() == 0 {
      "Named(${tid.id})"
    } else {
      joined := collect a in args {
        a.ty_to_string()
      }
      "Named(${tid.id})<${joined.join(", ")}>"
    },
    .Function(params, ret) => {
      joined := collect p in params {
        p.ty_to_string()
      }
      "fn(${joined.join(", ")}) ${ret.ty_to_string()}"
    },
    .ErrorType => "<error>",
  }
}

pub fn mono_eq(a: MonoType, b: MonoType) Bool {
  case a {
    .Int => case b {
      .Int => true,
      _ => false,
    },
    .Float => case b {
      .Float => true,
      _ => false,
    },
    .Bool => case b {
      .Bool => true,
      _ => false,
    },
    .Byte => case b {
      .Byte => true,
      _ => false,
    },
    .String => case b {
      .String => true,
      _ => false,
    },
    .Void => case b {
      .Void => true,
      _ => false,
    },
    .Anyref_ => case b {
      .Anyref_ => true,
      _ => false,
    },
    .Var(name_a) => case b {
      .Var(name_b) => name_a == name_b,
      _ => false,
    },
    .Named(tid_a, args_a) => case b {
      .Named(tid_b, args_b) => tid_a.id == tid_b.id and mono_vec_eq(args_a, args_b),
      _ => false,
    },
    .Vector(inner_a) => case b {
      .Vector(inner_b) => inner_a.mono_eq(inner_b),
      _ => false,
    },
    .Dict(ka, va) => case b {
      .Dict(kb, vb) => ka.mono_eq(kb) and va.mono_eq(vb),
      _ => false,
    },
    .Function(pa, ra) => case b {
      .Function(pb, rb) => mono_vec_eq(pa, pb) and ra.mono_eq(rb),
      _ => false,
    },
    .Optional(inner_a) => case b {
      .Optional(inner_b) => inner_a.mono_eq(inner_b),
      _ => false,
    },
    .ExternRef(tid_a) => case b {
      .ExternRef(tid_b) => tid_a.id == tid_b.id,
      _ => false,
    },
    .Result(ok_a, err_a) => case b {
      .Result(ok_b, err_b) => ok_a.mono_eq(ok_b) and err_a.mono_eq(err_b),
      _ => false,
    },
    .MetaVar(id_a) => case b {
      .MetaVar(id_b) => id_a == id_b,
      _ => false,
    },
    .Never => case b {
      .Never => true,
      _ => false,
    },
    .ErrorType => case b {
      .ErrorType => true,
      _ => false,
    },
  }
}

fn mono_vec_eq(a: Vector<MonoType>, b: Vector<MonoType>) Bool {
  if a.len() != b.len() {
    return false
  }

  for item, i in a {
    if !item.mono_eq(b[i]) {
      return false
    }
  }

  true
}

pub fn contains_meta(ty: MonoType) Bool {
  case ty {
    .MetaVar(_) => true,
    .Vector(inner) => inner.contains_meta(),
    .Dict(k, v) => k.contains_meta() or v.contains_meta(),
    .Function(params, ret) => {
      for p in params {
        if p.contains_meta() {
          return true
        }
      }

      ret.contains_meta()
    },
    .Optional(inner) => inner.contains_meta(),
    .Result(ok, err) => ok.contains_meta() or err.contains_meta(),
    .Named(_, args) => {
      for a in args {
        if a.contains_meta() {
          return true
        }
      }

      false
    },
    _ => false,
  }
}
