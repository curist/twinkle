//! Phase 2 ownership analysis over the structural CFG view.
//!
//! Populates each block's entry/exit BlockFacts with a sound
//! Unique/Shared/Unknown ownership fact, plus edge-arg-aware liveness and
//! binding-validity. Consumes the CFG view (raw ops, params, real edge args);
//! ANF stays authoritative and codegen does not read this.

use compiler.anf.{AnfOp, Atom}
use compiler.builtins.{BuiltinRegistry}
use compiler.cfg.{CfgBlock, CfgEdge, CfgFunction, CfgView, Terminator}
use compiler.core_ir.{FuncId, LocalId}
use compiler.field_facts as ff
use compiler.opt.semantics.{CallSemantics, OptimizerSemantics, call_info, container_kind}

pub type Ownership = { Unique, Shared, Unknown }

// Conservative fallback for longer-period fixpoint cycles; two-step oscillations
// usually lock earlier through targeted previous-value detection.
fixpoint_widen_cap := 8

// Tag encoding shared with cfg.BlockFacts.ownership (stored as Int there).
pub fn own_tag(o: Ownership) Int {
  case o {
    .Unique => 0,
    .Shared => 1,
    .Unknown => 2,
  }
}

pub fn own_of_tag(t: Int) Ownership {
  cond {
    t == 0 => .Unique,
    t == 1 => .Shared,
    _ => .Unknown,
  }
}

// ── Interprocedural summaries ────────────────────────────────────────
pub type EscapeEffect = { Borrowed, Retained }

pub type ParamCapability = { NoCap, Consumed }

pub type ParamSummary = .{ escape: EscapeEffect, capability: ParamCapability }

pub type ReturnEffect = { OwnedFresh, MayAliasParams(Vector<Int>), Shared }

pub type Summary = .{ params: Vector<ParamSummary>, ret: ReturnEffect }

pub type SummaryTable = .{ by_func: Dict<Int, Summary> }

pub fn empty_summary_table() SummaryTable {
  SummaryTable.{ by_func: Dict.new() }
}

pub fn summary_get(t: SummaryTable, func_id: Int) Summary? {
  t.by_func.get(func_id)
}

// ── Uses / defs extraction ──────────────────────────────────────────
fn atom_local_id(a: Atom) Int? {
  case a {
    .ALocal(l) => .Some(l.id),
    _ => .None,
  }
}

fn push_uid(acc: Vector<Int>, a: Atom) Vector<Int> {
  case atom_local_id(a) {
    .Some(id) => acc.append(id),
    .None => acc,
  }
}

// Locals READ by an op (its ref/scalar operands).
fn op_uses(op: AnfOp) Vector<Int> {
  case op {
    .ACall(callee, args) => {
      acc := push_uid([], callee)
      for a in args {
        acc = push_uid(acc, a)
      }
      acc
    },
    .ABinOp(_, l, r, _) => push_uid(push_uid([], l), r),
    .AUnOp(_, a, _) => push_uid([], a),
    .AMakeClosure(_, caps) => collect c in caps {
      c.id
    },
    .ARecord(_, fields) => {
      acc: Vector<Int> = []
      for fa in fields {
        acc = push_uid(acc, fa.value)
      }
      acc
    },
    .ARecordGet(a, _, _) => push_uid([], a),
    .ARecordUpdate(base, _, v, _, _) => push_uid(push_uid([], base), v),
    .AVariant(_, _, args) => {
      acc: Vector<Int> = []
      for a in args {
        acc = push_uid(acc, a)
      }
      acc
    },
    .AArrayLit(elems) => {
      acc: Vector<Int> = []
      for a in elems {
        acc = push_uid(acc, a)
      }
      acc
    },
    .AIndex(base, idx, _, _) => push_uid(push_uid([], base), idx),
    .AInit(a) => push_uid([], a),
    .AAssign(_, a) => push_uid([], a),
    .AGlobalSet(_, a) => push_uid([], a),
    .AWrapAnyref(a, _) => push_uid([], a),
    .AUnwrapAnyref(a, _) => push_uid([], a),
    .AIf(_, _, _) => error("ownership: AIf reached op_uses; structural op is block-lowered"),
    .AMatch(_, _) => error("ownership: AMatch reached op_uses; structural op is block-lowered"),
    .ALoop(_) => error("ownership: ALoop reached op_uses; structural op is block-lowered"),
    .ADefer(_) => error("ownership: ADefer reached op_uses; expected defer-free ANF"),
  }
}

// Locals READ by a terminator (scrutinee/cond/return/break atoms), excluding
// edge args (those are handled by the edge translation).
fn term_uses(term: Terminator) Vector<Int> {
  case term {
    .CondBranch(test, _, _, _, _) => push_uid([], test),
    .Match(scrut, _) => push_uid([], scrut),
    .Return(.Some(a)) => push_uid([], a),
    .Return(.None) => [],
    .ValueBreak(a) => push_uid([], a),
    _ => [],
  }
}

// ── Quartet shell-writeback recognizer (G5: block-local peephole) ────
fn op_mentions_local(op: AnfOp, id: Int) Bool {
  for u in op_uses(op) {
    if u == id {
      return true
    }
  }
  false
}

fn atom_is_local(a: Atom, id: Int) Bool {
  case atom_local_id(a) {
    .Some(x) => x == id,
    .None => false,
  }
}

fn atom_is_one_of(a: Atom, ids: Vector<Int>) Bool {
  case atom_local_id(a) {
    .Some(x) => live_contains_int(ids, x),
    .None => false,
  }
}

fn op_mentions_one_of(op: AnfOp, ids: Vector<Int>) Bool {
  for id in ids {
    if op_mentions_local(op, id) {
      return true
    }
  }
  false
}

fn op_moves_one_of(op: AnfOp, ids: Vector<Int>, live_after: Vector<Int>, sem: OptimizerSemantics) Bool {
  case op {
    .ACall(callee, args) => case callee_func_id(callee) {
      .Some(fid) => case call_info(sem, fid) {
        .Some(cs) => case cs.effect {
          .Update => case cs.cow_base_arg {
            .Some(k) => case atom_local_id(args[k]) {
              .Some(base_id) => live_contains_int(ids, base_id)
                and !live_contains_int(live_after, base_id),
              .None => false,
            },
            .None => false,
          },
          _ => false,
        },
        .None => false,
      },
      .None => false,
    },
    _ => false,
  }
}

fn is_record_get_of(op: AnfOp, bid: Int, fid: Int) Bool {
  case op {
    .ARecordGet(base, f, _) => atom_is_local(base, bid) and f.id == fid,
    _ => false,
  }
}

fn is_rebind_of_update(op: AnfOp, bid: Int, update_result: Int) Bool {
  case op {
    .AAssign(local, a) => local.id == bid and atom_is_local(a, update_result),
    _ => false,
  }
}

// bid must be dead after the block: not read by the terminator and not fed on
// any outgoing edge. Reuses term_uses (covers CondBranch/Match/Return/ValueBreak).
fn exit_mentions_local(blk: CfgBlock, id: Int) Bool {
  case blk.terminator {
    .Some(term) => {
      for u in term_uses(term) {
        if u == id {
          return true
        }
      }
    },
    .None => {},
  }
  for e in blk.succs {
    for a in e.args {
      if atom_is_local(a, id) {
        return true
      }
    }
  }
  false
}

// True iff, strictly after the projection at index `i` in this block:
//  - there is EXACTLY ONE ARecordUpdate(base=bid, field=fid, v=_) (the write-back),
//    and its replacement `v` is the projected field or a value derived from it;
//  - the replacement `v` is not `bid` itself and is last-use at the write-back;
//  - before a source-level `bid = update_result` rebind, `bid` is mentioned by
//    NO other instruction;
//  - `bid.fid` is not read again before that rebind;
//  - projected/derived locals only flow through known COW updates that actually
//    consume their base according to the block liveness scan;
//  - if there is no rebind, `bid` does NOT escape the block (not in terminator
//    or any outgoing edge arg).
fn quartet_ok(
  blk: CfgBlock,
  scan: BlockScan,
  i: Int,
  projected: Int,
  bid: Int,
  fid: Int,
  sem: OptimizerSemantics,
) Bool {
  insts := blk.instructions
  matched := false
  update_result := -1
  rebound := false
  derived := [projected]
  for j in range_from(i + 1, insts.len()) {
    op := insts[j].op
    is_match := case op {
      .ARecordUpdate(base2, f2, _v, _, _) => atom_is_local(base2, bid) and f2.id == fid,
      _ => false,
    }
    if is_match {
      if matched {
        return false
      }
      matched = true
      update_result = insts[j].anf_local.id

      case op {
        .ARecordUpdate(_, _, v, _, _) => {
          // reject self-insert: v == bid would not truly consume the field backing
          if atom_is_local(v, bid) {
            return false
          }
          case atom_local_id(v) {
            .Some(vid) => if !live_contains_int(derived, vid)
              or live_contains_int(scan.live_after[j], vid) {
              return false
            },
            .None => return false,
          }
        },
        _ => {},
      }
    } else if matched and is_rebind_of_update(op, bid, update_result) {
      // After `bid = update_result`, the id denotes the updated record, not the
      // projected shell — nothing further can invalidate the proof.
      rebound = true
      break
    } else {
      // a second read of bid.fid, or ANY other mention of bid, fails the proof
      if is_record_get_of(op, bid, fid) {
        return false
      }
      if op_mentions_local(op, bid) {
        return false
      }
      if op_mentions_one_of(op, derived) {
        if !op_moves_one_of(op, derived, scan.live_after[j], sem) {
          return false
        }
        derived = insert_sorted(derived, insts[j].anf_local.id)
      }
    }
  }
  matched and (rebound or !exit_mentions_local(blk, bid))
}

// Pre-scan a block's instruction list, returning the set of ARecordGet
// result-locals whose projection is licensed to MOVE by the quartet proof,
// even though the base record is not whole-record-dead at the get.
fn recognize_quartet_moves(blk: CfgBlock, scan: BlockScan, sem: OptimizerSemantics) Dict<Int, Bool> {
  moves: Dict<Int, Bool> = Dict.new()
  insts := blk.instructions
  for inst, i in insts {
    case inst.op {
      .ARecordGet(base, f, _) => case atom_local_id(base) {
        .Some(bid) => {
          rget := inst.anf_local.id
          if quartet_ok(blk, scan, i, rget, bid, f.id, sem) {
            moves[rget] = true
          }
        },
        .None => {},
      },
      _ => {},
    }
  }
  moves
}

fn quartet_has(q: Dict<Int, Bool>, id: Int) Bool {
  case q.get(id) {
    .Some(v) => v,
    .None => false,
  }
}

// Locals a straight-line op DEFINES. AAssign defines both its let-result and
// its rebind target; every other op defines only its let-result. This matters:
// a def must be killed before its own block's uses so a def-before-use does NOT
// leak the local into live_in (the bug the naive gather-all formula had).
fn op_defs(inst_result: Int, op: AnfOp) Vector<Int> {
  case op {
    .AAssign(target, _) => insert_sorted(insert_sorted([], inst_result), target.id),
    _ => insert_sorted([], inst_result),
  }
}

// ── Sorted-Int set helpers (deterministic; Int twins of cfg's LocalId ones) ──
fn live_contains_int(v: Vector<Int>, id: Int) Bool {
  for x in v {
    if x == id {
      return true
    }
  }
  false
}

fn insert_sorted(v: Vector<Int>, id: Int) Vector<Int> {
  out: Vector<Int> = []
  inserted := false
  for x in v {
    if x == id {
      return v
    }
    if !inserted and id < x {
      out = .append(id)
      inserted = true
    }
    out = .append(x)
  }
  if !inserted {
    out = .append(id)
  }
  out
}

fn union_sorted(a: Vector<Int>, b: Vector<Int>) Vector<Int> {
  out := a
  for x in b {
    out = insert_sorted(out, x)
  }
  out
}

fn diff_sorted(a: Vector<Int>, remove: Vector<Int>) Vector<Int> {
  out: Vector<Int> = []
  for x in a {
    if !live_contains_int(remove, x) {
      out = .append(x)
    }
  }
  out
}

fn same_live(a: Vector<Int>, b: Vector<Int>) Bool {
  if a.len() != b.len() {
    return false
  }
  for x, i in a {
    if x != b[i] {
      return false
    }
  }
  true
}

// ── Backward liveness ───────────────────────────────────────────────
type BlockLive = .{ live_in: Vector<Int>, live_out: Vector<Int> }

fn live_get(live: Dict<Int, BlockLive>, id: Int) BlockLive {
  case live.get(id) {
    .Some(v) => v,
    .None => error("ownership: no liveness for block ${id}"),
  }
}

fn block_by_id(blocks: Vector<CfgBlock>, id: Int) CfgBlock {
  for b in blocks {
    if b.id.id == id {
      return b
    }
  }
  error("ownership: unknown block ${id}")
}

// live_out contribution of edge (pred -> succ):
//   (succ.live_in - succ.params) ∪ { locals(edge.args[i]) | succ.params[i] ∈ succ.live_in }
fn edge_live_contribution(succ: CfgBlock, succ_live_in: Vector<Int>, edge_args: Vector<Atom>) Vector<
  Int,
> {
  param_ids := collect p in succ.params {
    p.id
  }

  // values live past the join, named directly (not a param)
  acc: Vector<Int> = []
  for id in succ_live_in {
    if !live_contains_int(param_ids, id) {
      acc = insert_sorted(acc, id)
    }
  }

  // params translated to the atom this edge feeds
  for p, i in succ.params {
    if live_contains_int(succ_live_in, p.id) {
      case atom_local_id(edge_args[i]) {
        .Some(src) => acc = insert_sorted(acc, src),
        .None => {},
      }
    }
  }
  acc
}

// Backward per-instruction scan of one block. Returns live_in AND, for each
// instruction index i, the set of locals live *immediately after* i
// (`live_after[i]`). live_after is what Task 5 uses for last-use: a use of L at
// i is a last-use iff L ∉ live_after[i] — which correctly handles a later
// AAssign that redefines L (loop consume-then-reassign) and a block-live-out L.
type BlockScan = .{ live_in: Vector<Int>, live_after: Vector<Vector<Int>> }

fn scan_block_backward(blk: CfgBlock, live_out: Vector<Int>) BlockScan {
  // Seed with live_out plus the terminator's direct uses (scrutinee/cond/
  // return/break). Terminator EDGE args are handled by the edge translation in
  // edge_live_contribution, not here.
  cur := live_out
  case blk.terminator {
    .Some(t) => {
      for u in term_uses(t) {
        cur = insert_sorted(cur, u)
      }
    },
    .None => {},
  }
  n := blk.instructions.len()
  after_rev: Vector<Vector<Int>> = []
  i := n - 1
  for i >= 0 {
    after_rev = .append(cur) // live AFTER instruction i
    inst := blk.instructions[i]
    cur = diff_sorted(cur, op_defs(inst.anf_local.id, inst.op)) // kill defs first
    for u in op_uses(inst.op) {
      // then add uses
      cur = insert_sorted(cur, u)
    }
    i = i - 1
  }

  // after_rev is high->low; reverse so live_after[i] indexes by instruction i.
  live_after: Vector<Vector<Int>> = []
  j := after_rev.len() - 1
  for j >= 0 {
    live_after = .append(after_rev[j])
    j = j - 1
  }

  // Kill this block's incoming pattern-bound locals at entry: a destructured
  // payload is a borrow from the scrutinee, not a value flowing in from a
  // predecessor, so it must never appear live-in (retires the Phase 2 G3
  // over-approximation). The forward pass seeds absent locals Unknown, so no
  // forward-seed change is needed.
  cur = diff_sorted(cur, blk.bound)
  BlockScan.{ live_in: cur, live_after }
}

// Per-block analysis inputs that depend ONLY on block structure + the fixed
// liveness scan (never on the dataflow state). Computing these once — rather than
// per fixpoint visit — keeps the O(n^2) quartet recognizer off the iteration path.
type BlockPrep = .{ scan: BlockScan, moves: Dict<Int, Bool> }

fn block_prep(blk: CfgBlock, sem: OptimizerSemantics) BlockPrep {
  scan := scan_block_backward(blk, blk.exit.live) // exit.live filled by the liveness stage
  BlockPrep.{ scan, moves: recognize_quartet_moves(blk, scan, sem) }
}

// Precompute every block's prep once, keyed by block id, for the fixpoint loop.
fn prep_blocks(blocks: Vector<CfgBlock>, sem: OptimizerSemantics) Dict<Int, BlockPrep> {
  preps: Dict<Int, BlockPrep> = Dict.new()
  for blk in blocks {
    preps[blk.id.id] = block_prep(blk, sem)
  }
  preps
}

fn prep_get(preps: Dict<Int, BlockPrep>, blk: CfgBlock, sem: OptimizerSemantics) BlockPrep {
  case preps.get(blk.id.id) {
    .Some(p) => p,
    .None => block_prep(blk, sem),
  }
}

fn compute_liveness(blocks: Vector<CfgBlock>) Dict<Int, BlockLive> {
  live: Dict<Int, BlockLive> = Dict.new()
  for b in blocks {
    live[b.id.id] = BlockLive.{ live_in: [], live_out: [] }
  }
  changed := true
  for changed {
    changed = false

    // iterate in reverse block-id order (blocks are appended in ~RPO)
    idx := blocks.len() - 1
    for idx >= 0 {
      blk := blocks[idx]

      // live_out = ∪ over succ edges of edge_live_contribution
      lo: Vector<Int> = []
      for e in blk.succs {
        succ := block_by_id(blocks, e.target.id)
        succ_in := live_get(live, succ.id.id).live_in
        lo = union_sorted(lo, edge_live_contribution(succ, succ_in, e.args))
      }
      li := scan_block_backward(blk, lo).live_in
      prev := live_get(live, blk.id.id)
      if !same_live(prev.live_in, li) or !same_live(prev.live_out, lo) {
        changed = true
        live[blk.id.id] = BlockLive.{ live_in: li, live_out: lo }
      }
      idx = idx - 1
    }
  }
  live
}

// ── Forward ownership transfer ──────────────────────────────────────
pub fn join_own(a: Ownership, b: Ownership) Ownership {
  case a {
    .Unknown => .Unknown,
    .Shared => case b {
      .Unknown => .Unknown,
      _ => .Shared,
    },
    .Unique => b,
  }
}

// ownership of an atom against a working map: locals resolve; non-locals Unknown.
fn fact_of(own: Dict<Int, Int>, a: Atom) Ownership {
  case atom_local_id(a) {
    .Some(id) => case own.get(id) {
      .Some(tag) => own_of_tag(tag),
      .None => .Unknown,
    },
    .None => .Unknown,
  }
}

fn set_own(own: Dict<Int, Int>, id: Int, o: Ownership) Dict<Int, Int> {
  own[id] = o.own_tag()
  own
}

// FuncId of a direct callee atom; .None for indirect (closure) callees.
fn callee_func_id(a: Atom) FuncId? {
  case a {
    .AGlobalFunc(fid) => .Some(fid),
    _ => .None,
  }
}

// The locals used at instruction i whose value is dead immediately after i.
fn last_use_at(op: AnfOp, live_after_i: Vector<Int>) Vector<Int> {
  out: Vector<Int> = []
  for id in op_uses(op) {
    if !live_contains_int(live_after_i, id) {
      out = insert_sorted(out, id)
    }
  }
  out
}

fn is_last_use(last: Vector<Int>, id: Int) Bool {
  live_contains_int(last, id)
}

type ForwardState = .{
  own: Dict<Int, Int>,
  valid: Dict<Int, Bool>,
  prov: Dict<Int, Vector<Int>>,
  field_own: Dict<Int, ff.FieldMap>,
  path_prov: Dict<Int, Dict<Int, Vector<Int>>>,
}

fn field_own_get(st: ForwardState, id: Int) ff.FieldMap {
  case st.field_own.get(id) {
    .Some(m) => m,
    .None => ff.empty(),
  }
}

fn set_field_own(st: ForwardState, id: Int, m: ff.FieldMap) ForwardState {
  st.field_own[id] = m
  st
}

fn clear_field_own(st: ForwardState, id: Int) ForwardState {
  st.field_own[id] = ff.empty()
  st
}

fn path_prov_get(st: ForwardState, id: Int) Dict<Int, Vector<Int>> {
  case st.path_prov.get(id) {
    .Some(m) => m,
    .None => Dict.new(),
  }
}

fn set_path_prov(st: ForwardState, id: Int, m: Dict<Int, Vector<Int>>) ForwardState {
  st.path_prov[id] = m
  st
}

fn clear_path_prov(st: ForwardState, id: Int) ForwardState {
  st.path_prov[id] = Dict.new()
  st
}

fn set_own_st(st: ForwardState, id: Int, o: Ownership) ForwardState {
  st.own = set_own(st.own, id, o)

  // Downward-closed invariant: a non-Unique shell can carry no field facts.
  st = if o.own_tag() != 0 {
    st.clear_field_own(id).clear_path_prov(id)
  } else {
    st
  }
  st
}

// Provenance (param-origin) of an atom against a working prov map.
fn prov_of(prov: Dict<Int, Vector<Int>>, a: Atom) Vector<Int> {
  case atom_local_id(a) {
    .Some(id) => case prov.get(id) {
      .Some(v) => v,
      .None => [],
    },
    .None => [],
  }
}

fn atom_field_own(st: ForwardState, a: Atom) ff.FieldMap {
  case atom_local_id(a) {
    .Some(id) => st.field_own_get(id),
    .None => ff.empty(),
  }
}

fn set_prov_st(st: ForwardState, id: Int, origins: Vector<Int>) ForwardState {
  st.prov[id] = origins
  st
}

fn set_result(st: ForwardState, id: Int, o: Ownership) ForwardState {
  st.set_own_st(id, o)
}

fn set_valid(st: ForwardState, id: Int, v: Bool) ForwardState {
  st.valid[id] = v
  st
}

// Publish a local Shared and, transitively, every param origin it carries. A
// value derived from a param (wrapped into an aggregate, aliased, etc.) that
// escapes forces its origin params to Shared too — the aggregate/escape hole.
fn publish_local(st: ForwardState, id: Int) ForwardState {
  pp := st.path_prov_get(id) // capture before the choke point clears it
  st = .set_own_st(id, .Shared)
  case st.prov.get(id) {
    .Some(origins) => {
      for o in origins {
        st = .set_own_st(o, .Shared)
      }
    },
    .None => {},
  }
  for k, os in pp {
    for o in os {
      st = .set_own_st(o, .Shared)
    }
  }
  st
}

fn publish_atom(st: ForwardState, a: Atom) ForwardState {
  case atom_local_id(a) {
    .Some(id) => st.publish_local(id),
    .None => st,
  }
}

// AInit / wrap / unwrap move-vs-alias hinge.
fn init_hinge(st: ForwardState, result: Int, a: Atom, last: Vector<Int>) ForwardState {
  case atom_local_id(a) {
    .Some(src) => if is_last_use(last, src) {
      // move: result takes source ownership; source binding invalid
      o := fact_of(st.own, a)
      fields := st.field_own_get(src)
      pp := st.path_prov_get(src)
      st = .set_own_st(result, o)
      st = if o.own_tag() == 0 {
        // move: copy source's field_own AND path_prov in lockstep
        st.set_field_own(result, fields).set_path_prov(result, pp)
      } else {
        st
      }
      st.set_valid(src, false)
    } else {
      // alias: both Shared
      st = .publish_local(src)
      st.set_own_st(result, .Shared)
    },
    .None => st.set_own_st(result, .Unknown),
  }
}

// Field-store hinge: same two outcomes as AInit but the stored value goes into a
// fresh shell (no tracked field ownership in Phase 2), so on move we only
// invalidate the source; on alias we demote it.
fn field_store(st: ForwardState, a: Atom, last: Vector<Int>) ForwardState {
  case atom_local_id(a) {
    .Some(src) => if is_last_use(last, src) {
      st.set_valid(src, false)
    } else {
      st.publish_local(src)
    },
    .None => st,
  }
}

// Consuming-op hinge on a named base (ARecordUpdate: base is the shell).
fn consume_base(st: ForwardState, result: Int, base: Atom, last: Vector<Int>) ForwardState {
  case atom_local_id(base) {
    .Some(bid) => {
      base_own := fact_of(st.own, base)
      case base_own {
        .Unique => if is_last_use(last, bid) {
          st = .set_own_st(result, .Unique)
          st.set_valid(bid, false)
        } else {
          st.set_own_st(result, .Unknown)
        },
        _ => st.set_own_st(result, .Unknown),
      }
    },
    .None => st.set_own_st(result, .Unknown),
  }
}

fn consume_call_base(
  st: ForwardState,
  result: Int,
  cs: CallSemantics,
  args: Vector<Atom>,
  last: Vector<Int>,
) ForwardState {
  case cs.cow_base_arg {
    .Some(k) => if k < args.len() {
      st.consume_base(result, args[k], last)
    } else {
      st.set_own_st(result, .Unknown)
    },
    .None => st.set_own_st(result, .Unknown),
  }
}

// Set result prov from the cow_base_arg (if any) so provenance follows COW
// aliasing: a COW builtin's result structurally shares the base arg's backing,
// so it must carry that base's param origins (mirrors AIndex/ARecordUpdate).
fn carry_base_prov(st: ForwardState, result: Int, cs: CallSemantics, args: Vector<Atom>) ForwardState {
  case cs.cow_base_arg {
    .Some(k) => if k < args.len() {
      st.set_prov_st(result, prov_of(st.prov, args[k]))
    } else {
      st
    },
    .None => st,
  }
}

// The explicitly-retained payload operands for a builtin result. New prelude
// metadata distinguishes stored payloads from read-only selector operands
// (`vector$set_unsafe` index, `Dict.remove` key). `.None` is the legacy fallback
// for semantics reconstructed from old CowConfig metadata: retain every non-base
// arg, matching the previous conservative behavior.
fn retained_arg_indices(cs: CallSemantics, args: Vector<Atom>) Vector<Int> {
  case cs.retained_args {
    .Some(v) => v,
    .None => {
      out: Vector<Int> = []
      for _a, i in args {
        keep := case cs.cow_base_arg {
          .Some(k) => i != k,
          .None => true,
        }
        if keep {
          out = .append(i)
        }
      }
      out
    },
  }
}

// Absorb retained payload args into `result` like aggregate fields: field_store
// each retained operand and union its prov into result's prov. Keeps result's
// existing prov (e.g. base prov already set) so a COW result carries both its
// base's and its stored values' origins, but not lookup/index operands.
fn absorb_retained_call_args(
  st: ForwardState,
  result: Int,
  args: Vector<Atom>,
  retained: Vector<Int>,
  last: Vector<Int>,
) ForwardState {
  origins := case st.prov.get(result) {
    .Some(v) => v,
    .None => [],
  }
  for i in retained {
    if i < args.len() {
      origins = union_sorted(origins, prov_of(st.prov, args[i]))
      st = .field_store(args[i], last)
    }
  }
  st.set_prov_st(result, origins)
}

fn transfer_call(
  st: ForwardState,
  result: Int,
  callee: Atom,
  args: Vector<Atom>,
  last: Vector<Int>,
  table: SummaryTable,
  sem: OptimizerSemantics,
) ForwardState {
  // Two-level lookup: builtins resolve via CallSemantics; a direct user callee
  // WITHOUT builtin semantics consults its interprocedural summary; everything
  // else (unknown/extern/indirect/closure) falls to the conservative publish
  // bucket.
  case callee_func_id(callee) {
    .Some(fid) => case call_info(sem, fid) {
      .Some(cs) => st.transfer_builtin_call(result, fid, cs, args, last, sem),
      .None => case table.summary_get(fid.id) {
        .Some(s) => st.transfer_summarized_call(result, s, args),
        .None => st.publish_call(result, args),
      },
    },
    .None => st.publish_call(result, args), // indirect/closure callee
  }
}

// Conservative bucket: publish every ref arg, result Unknown.
fn publish_call(st: ForwardState, result: Int, args: Vector<Atom>) ForwardState {
  for a in args {
    st = .publish_atom(a)
  }
  st.set_own_st(result, .Unknown)
}

fn container_seg(sem: OptimizerSemantics, fid: FuncId) ff.PathSeg? {
  case container_kind(sem, fid) {
    .VectorLike => .Some(.Elem),
    .DictLike => .Some(.Val),
    .NotCollection => .None,
  }
}

fn retained_atoms(ri: Vector<Int>, args: Vector<Atom>) Vector<Atom> {
  out: Vector<Atom> = []
  for i in ri {
    if i < args.len() {
      out = .append(args[i])
    }
  }
  out
}

// The stored VALUE is the last retained operand (append [1] -> arg1;
// vector$set_unsafe [2] -> arg2; Dict.set [1,2] -> arg2).
fn stored_element_atom(ri: Vector<Int>, args: Vector<Atom>) Atom? {
  if ri.len() == 0 {
    return .None
  }
  k := ri[ri.len() - 1]
  if k < args.len() {
    .Some(args[k])
  } else {
    .None
  }
}

fn transfer_builtin_call(
  st: ForwardState,
  result: Int,
  fid: FuncId,
  cs: CallSemantics,
  args: Vector<Atom>,
  last: Vector<Int>,
  sem: OptimizerSemantics,
) ForwardState {
  ri := retained_arg_indices(cs, args)
  case cs.effect {
    .Allocate => st.set_own_st(result, .Unique).absorb_retained_call_args(result, args, ri, last),
    .Update => {
      // Capture base facts BEFORE consume (consume leaves base.field_own intact).
      base_fields := case cs.cow_base_arg {
        .Some(k) => if k < args.len() {
          st.atom_field_own(args[k])
        } else {
          ff.empty()
        },
        .None => ff.empty(),
      }
      st = .consume_call_base(result, cs, args, last).carry_base_prov(result, cs, args).absorb_retained_call_args(
        result,
        args,
        ri,
        last,
      )

      // Nested facts survive only when the result shell is Unique.
      st = if own_is_unique(st.own, result) {
        rf := case container_seg(sem, fid) {
          .Some(seg) => {
            // A known collection op: untouched elements are structurally preserved,
            // so carry all of base's field facts (which for a Vector/Dict base is
            // [seg]* only), then keep or drop the touched seg by single-retention.
            keep := case stored_element_atom(ri, args) {
              .Some(x) => st.single_retention(x, last, retained_atoms(ri, args)),
              .None => false,
            }
            if keep {
              base_fields
            } else {
              base_fields.remove_prefix(seg)
            }
          },
          // Unknown Update op: do NOT know it preserves inner structure -> drop.
          .None => ff.empty(),
        }
        st.set_field_own(result, rf)
      } else {
        st
      }
      st
    },
    // borrow: result not owned, but carries the cow_base_arg's provenance.
    .ReadOnly => st.set_own_st(result, .Unknown).carry_base_prov(result, cs, args),
    .Pure => st.set_own_st(result, .Unknown),
    .Control => st.set_own_st(result, .Unknown),
  }
}

// Consume a callee summary at a direct user call. Acts ONLY on escape + return:
// Retained args publish (demote to Shared), Borrowed args are untouched;
// OwnedFresh result is Unique, MayAliasParams publishes every origin and shares
// the result, Shared result is Unknown. Capability (Consumed) is recorded-only
// and never read here — it must never invalidate a caller binding (Phase 6).
fn transfer_summarized_call(st: ForwardState, result: Int, s: Summary, args: Vector<Atom>) ForwardState {
  for ps, i in s.params {
    if i < args.len() {
      case ps.escape {
        .Retained => st = .publish_atom(args[i]),
        .Borrowed => {},
      }
    }
  }
  case s.ret {
    .OwnedFresh => st.set_own_st(result, .Unique),
    .Shared => st.set_own_st(result, .Unknown),
    .MayAliasParams(idxs) => {
      origins: Vector<Int> = []
      for k in idxs {
        if k < args.len() {
          st = .publish_atom(args[k])
          origins = union_sorted(origins, prov_of(st.prov, args[k]))
        }
      }
      st = .set_own_st(result, .Shared)
      st.set_prov_st(result, origins)
    },
  }
}

fn own_is_unique(own: Dict<Int, Int>, id: Int) Bool {
  case fact_of_local(own, id) {
    .Unique => true,
    _ => false,
  }
}

// Count the number of times local `id` appears among the atoms in `operands`.
fn store_count(operands: Vector<Atom>, id: Int) Int {
  n := 0
  for a in operands {
    case atom_local_id(a) {
      .Some(oid) => if oid == id {
        n = n + 1
      },
      .None => {},
    }
  }
  n
}

// A value operand is single-retention at this op iff it is a local that is
// []:Unique, at last-use, and appears exactly once among `operands`.
fn single_retention(st: ForwardState, v: Atom, last: Vector<Int>, operands: Vector<Atom>) Bool {
  case atom_local_id(v) {
    .Some(id) => fact_of(st.own, v).own_tag() == 0
      and is_last_use(last, id) and store_count(operands, id) == 1,
    .None => false,
  }
}

// Copy `src`'s provenance under `prefix` into `pp`, mirroring ff.graft's
// representable-inner rules so pp and field_own stay in lockstep. The [prefix]
// entry is always the value's shell prov (empty vector = proven fresh).
fn graft_path_prov(pp: Dict<Int, Vector<Int>>, prefix: ff.PathSeg, st: ForwardState, a: Atom) Dict<
  Int,
  Vector<Int>,
> {
  pp[ff.path_key(ff.AccessPath.{ segs: [prefix] })] = prov_of(st.prov, a) // [] = fresh
  case atom_local_id(a) {
    .Some(sid) => {
      for k, v in st.path_prov_get(sid) {
        inner := ff.path_of_key(k)
        if inner.segs.len() == 1 {
          keep := case prefix {
            .Field(_) => case inner.segs[0] {
              .Elem => true,
              .Val => true,
              _ => false, // [Field, Field] and [Field, Payload] are not representable
            },
            .Payload(_, _) => case inner.segs[0] {
              .Field(_) => true,
              _ => false, // [Payload, Elem] and [Payload, Payload] are not representable
            },
            _ => false,
          }
          if keep {
            pp[ff.path_key(ff.AccessPath.{ segs: [prefix, inner.segs[0]] })] = v
          }
        }
      }
    },
    .None => {},
  }
  pp
}

// Projection inverse for path_prov, mirroring ff.project: the [seg] entry
// becomes `shell`; each strict descendant [seg, X] becomes inner[X].
type PathProvProjection = .{ shell: Vector<Int>?, inner: Dict<Int, Vector<Int>> }

fn project_path_prov(pp: Dict<Int, Vector<Int>>, seg: ff.PathSeg) PathProvProjection {
  shell: Vector<Int>? = .None
  inner: Dict<Int, Vector<Int>> = Dict.new()
  for k, v in pp {
    p := ff.path_of_key(k)
    if p.segs.len() >= 1 and p.segs[0].seg_eq(seg) {
      if p.segs.len() == 1 {
        shell = .Some(v)
      } else {
        inner[ff.path_key(ff.AccessPath.{ segs: [p.segs[1]] })] = v
      }
    }
  }
  PathProvProjection.{ shell, inner }
}

// Drop the entire [seg]* subtree from a path_prov map, mirroring ff.remove_prefix.
fn remove_prefix_pp(pp: Dict<Int, Vector<Int>>, seg: ff.PathSeg) Dict<Int, Vector<Int>> {
  out: Dict<Int, Vector<Int>> = Dict.new()
  for k, v in pp {
    p := ff.path_of_key(k)
    drop := p.segs.len() >= 1 and p.segs[0].seg_eq(seg)
    if !drop {
      out[k] = v
    }
  }
  out
}

// Apply one instruction. `last` is last_use_at(op, live_after[i]).
// `quartet` is the pre-scanned set of ARecordGet result-locals licensed to move
// by the block-local quartet proof (empty for callers outside a block body).
fn transfer_op(
  st: ForwardState,
  result: Int,
  op: AnfOp,
  last: Vector<Int>,
  quartet: Dict<Int, Bool>,
  table: SummaryTable,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
) ForwardState {
  case op {
    .ACall(callee, args) => st.transfer_call(result, callee, args, last, table, sem),
    .ARecord(_, fields) => {
      operands: Vector<Atom> = collect fa in fields {
        fa.value
      }
      for fa in fields {
        st = .field_store(fa.value, last)
      }
      st = .set_result(result, .Unique) // sets shell Unique; choke point leaves field_own[result] intact (empty)
      st = .set_prov_st(result, []) // SHELL prov: fresh shell aliases no param

      // Route each field's origins into path_prov under [.f] so whole-value
      // publication still leaks the field (publish_local cascades path_prov). The
      // single-retention fields ALSO graft their inner facts into field_own, in
      // lockstep with graft_path_prov's [.f, inner] entries.
      rf := ff.empty()
      pp: Dict<Int, Vector<Int>> = Dict.new()
      for fa in fields {
        seg := ff.PathSeg.Field(fa.field.id)
        if st.single_retention(fa.value, last, operands) {
          rf = .graft(seg, st.atom_field_own(fa.value))
          pp = graft_path_prov(pp, seg, st, fa.value)
        } else {
          // shell-only origin of a non-owned field: recorded for publication only
          // (no field_own[.f] entry; extra path_prov key is a sound over-publish).
          pp[ff.path_key(ff.AccessPath.{ segs: [seg] })] = prov_of(st.prov, fa.value)
        }
      }
      st = if rf.is_empty() {
        st
      } else {
        st.set_field_own(result, rf)
      }
      st.set_path_prov(result, pp)
    },
    .AVariant(_, vid, args) => {
      for a in args {
        st = .field_store(a, last)
      }
      st = .set_result(result, .Unique)
      st = .set_prov_st(result, []) // SHELL prov: fresh shell aliases no param

      // Route each payload's origins into path_prov under [Payload(tag,i)] so
      // whole-value publication still leaks the payload (publish_local cascades
      // path_prov). Single-retention payloads ALSO graft their inner facts into
      // field_own, in lockstep with graft_path_prov's [Payload(tag,i), inner] entries.
      rf := ff.empty()
      pp: Dict<Int, Vector<Int>> = Dict.new()
      for a, i in args {
        seg := ff.PathSeg.Payload(vid.id, i)
        if st.single_retention(a, last, args) {
          rf = .graft(seg, st.atom_field_own(a))
          pp = graft_path_prov(pp, seg, st, a)
        } else {
          // shell-only origin of a non-owned payload: recorded for publication only
          // (no field_own[Payload] entry; extra path_prov key is a sound over-publish).
          pp[ff.path_key(ff.AccessPath.{ segs: [seg] })] = prov_of(st.prov, a)
        }
      }
      st = if rf.is_empty() {
        st
      } else {
        st.set_field_own(result, rf)
      }
      st.set_path_prov(result, pp)
    },
    .AArrayLit(elems) => {
      for a in elems {
        st = .field_store(a, last)
      }
      st = .set_result(result, .Unique)
      st = .set_prov_st(result, []) // SHELL prov: fresh shell aliases no param

      // Route the elements' origins into path_prov[Elem] so whole-value
      // publication still leaks them (publish_local cascades path_prov). Empty
      // origins => proven fresh.
      elem_origins: Vector<Int> = []
      for e in elems {
        elem_origins = union_sorted(elem_origins, prov_of(st.prov, e))
      }
      epp: Dict<Int, Vector<Int>> = Dict.new()
      epp[ff.path_key(ff.elem_path())] = elem_origins
      st = .set_path_prov(result, epp)

      // [Elem]:Unique when EVERY element is single-retention. An EMPTY literal is
      // [Elem]:Unique vacuously (no shared inner) — this bootstraps build-from-empty
      // vectors so the Task 4 consuming rule has an all-owned base to preserve.
      all_owned := true
      for a in elems {
        if !st.single_retention(a, last, elems) {
          all_owned = false
        }
      }
      st = if all_owned {
        st.set_field_own(result, ff.empty().set_path(ff.elem_path(), 0))
      } else {
        st
      }
      st
    },
    .ARecordGet(base, f, _) => {
      pr := st.atom_field_own(base).project(.Field(f.id))
      case atom_local_id(base) {
        .Some(bid) => if is_last_use(last, bid) or quartet_has(quartet, result) {
          // whole-record last-use MOVE, or quartet-licensed move (Task 6)
          case pr.shell {
            .Some(t) => {
              proj_pp := project_path_prov(st.path_prov_get(bid), ff.PathSeg.Field(f.id))
              st = .set_own_st(result, own_of_tag(t))
              st = .set_field_own(result, pr.fields)
              st = .set_path_prov(result, proj_pp.inner)

              // Result shell prov from the PROJECTED FIELD's provenance (not
              // base's shell prov); opaque base falls back to base's origins.
              st = .set_prov_st(
                result,
                case proj_pp.shell {
                  .Some(o) => o,
                  .None => prov_of(st.prov, base),
                },
              )

              // R takes base.[.f]*; remove that subtree from base (both maps).
              st = .set_field_own(bid, st.field_own_get(bid).remove_prefix(.Field(f.id)))
              st.set_path_prov(bid, remove_prefix_pp(st.path_prov_get(bid), ff.PathSeg.Field(f.id)))
            },
            // field not deeply owned -> plain borrow, no claim
            .None => {
              st = .set_result(result, .Unknown)
              st.set_prov_st(result, prov_of(st.prov, base))
            },
          }
        } else {
          // BORROW: aliasing both sides -> R Shared (choke point clears R's facts),
          // and clear base's [.f]* subtree too (both maps).
          st = .set_own_st(result, .Shared)
          st = .set_field_own(bid, st.field_own_get(bid).remove_prefix(.Field(f.id)))
          st = .set_path_prov(bid, remove_prefix_pp(st.path_prov_get(bid), ff.PathSeg.Field(f.id)))
          st.set_prov_st(result, prov_of(st.prov, base))
        },
        // non-local base (global/literal): plain borrow
        .None => {
          st = .set_result(result, .Unknown)
          st.set_prov_st(result, prov_of(st.prov, base))
        },
      }
    },
    .AIndex(base, _, _, _) => {
      // borrow
      st = .set_result(result, .Unknown)
      st.set_prov_st(result, prov_of(st.prov, base))
    },
    .ARecordUpdate(base, f, v, _, _) => {
      origins := prov_of(st.prov, base) // shell-only: drop the old union with v
      base_fields := st.atom_field_own(base)
      base_pp := case atom_local_id(base) {
        // capture BEFORE consume_base clears base's path_prov on invalidate
        .Some(bid) => st.path_prov_get(bid),
        .None => Dict.new(),
      }
      st = .consume_base(result, base, last) // sets result shell Unique (if base Unique+last-use) else Unknown
      st = .field_store(v, last)
      st = .set_prov_st(result, origins)

      // Only build field facts when the result shell is Unique (else choke point cleared it).
      st = if own_is_unique(st.own, result) {
        // remove the whole [.f]* subtree first, then graft the (single-retention)
        // replacement, in lockstep across field_own and path_prov.
        rf := base_fields.remove_prefix(.Field(f.id))
        pp := remove_prefix_pp(base_pp, ff.PathSeg.Field(f.id))
        if st.single_retention(v, last, [base, v]) {
          rf = .graft(.Field(f.id), st.atom_field_own(v))
          pp = graft_path_prov(pp, ff.PathSeg.Field(f.id), st, v)
        }
        st.set_field_own(result, rf).set_path_prov(result, pp)
      } else {
        st
      }
      st
    },
    .AInit(a) => {
      st = .init_hinge(result, a, last)
      st.set_prov_st(result, prov_of(st.prov, a))
    },
    .AAssign(local, a) => {
      // rebind: result local's fact = fact(a); binding becomes valid again
      o := fact_of(st.own, a)
      st = .set_own_st(local.id, o)
      st = .set_prov_st(local.id, prov_of(st.prov, a))
      st = if o.own_tag() == 0 {
        st = .set_field_own(local.id, st.atom_field_own(a))

        // copy path_prov in lockstep with field_own
        case atom_local_id(a) {
          .Some(aid) => st.set_path_prov(local.id, st.path_prov_get(aid)),
          .None => st,
        }
      } else {
        st
      }
      st.set_valid(local.id, true)
    },
    .AMakeClosure(_, caps) => {
      st = .set_result(result, .Unknown) // closure ref itself: not an optimization target
      for c in caps {
        st = .publish_local(c.id)
      }
      st
    },
    .AGlobalSet(_, a) => {
      st = .publish_atom(a)
      st.set_result(result, .Unknown)
    },
    .AWrapAnyref(a, _) => {
      // representationally transparent
      st = .init_hinge(result, a, last)
      st.set_prov_st(result, prov_of(st.prov, a))
    },
    .AUnwrapAnyref(a, _) => {
      st = .init_hinge(result, a, last)
      st.set_prov_st(result, prov_of(st.prov, a))
    },
    .ABinOp(_, _, _, _) => st.set_result(result, .Unknown), // scalar, neutral
    .AUnOp(_, _, _) => st.set_result(result, .Unknown),
    .AIf(_, _, _) => error("ownership: AIf reached transfer; structural op is block-lowered"),
    .AMatch(_, _) => error("ownership: AMatch reached transfer; structural op is block-lowered"),
    .ALoop(_) => error("ownership: ALoop reached transfer; structural op is block-lowered"),
    .ADefer(_) => error("ownership: ADefer reached transfer; expected defer-free ANF"),
  }
}

fn atom_brief(a: Atom) String {
  case atom_local_id(a) {
    .Some(id) => "L${id}",
    .None => "atom",
  }
}

fn shell_verdict(st: ForwardState, base: Atom, last: Vector<Int>) String {
  case atom_local_id(base) {
    .Some(bid) => case fact_of(st.own, base) {
      .Unique => if is_last_use(last, bid) {
        "reuse(unique)"
      } else {
        "persistent(base still live)"
      },
      _ => "persistent(aliased shell)",
    },
    .None => "persistent(aliased shell)",
  }
}

fn update_field_verdict(
  pre: ForwardState,
  base: Atom,
  f: Int,
  shell: String,
  field_backing_moved: Bool,
) String {
  if field_backing_moved {
    return "in-place([.f${f}] unique)"
  }

  if shell.contains("base still live") {
    return "persistent(borrow-projection: base still live)"
  }

  if !pre.atom_field_own(base).is_unique(ff.field_path(f)) {
    return "persistent(insufficient deep ownership)"
  }

  "persistent(outer owned but inner shared)"
}

fn record_update_verdict(
  pre: ForwardState,
  result: Int,
  base: Atom,
  f: Int,
  last: Vector<Int>,
  field_backing_moved: Bool,
) String {
  shell := pre.shell_verdict(base, last)
  field := pre.update_field_verdict(base, f, shell, field_backing_moved)
  "L${result} = record_update ${atom_brief(base)}.f${f} shell=${shell} field=${field}"
}

fn mark_field_backing(moved: Dict<Int, Vector<Int>>, bid: Int, fid: Int) Dict<Int, Vector<Int>> {
  fields := case moved.get(bid) {
    .Some(v) => v,
    .None => [],
  }
  moved[bid] = insert_sorted(fields, fid)
  moved
}

fn has_moved_field_backing(moved: Dict<Int, Vector<Int>>, bid: Int, fid: Int) Bool {
  case moved.get(bid) {
    .Some(fields) => live_contains_int(fields, fid),
    .None => false,
  }
}

fn clear_moved_backing(moved: Dict<Int, Vector<Int>>, bid: Int) Dict<Int, Vector<Int>> {
  case moved.get(bid) {
    .Some(_) => moved.remove(bid),
    .None => moved,
  }
}

fn consume_moved_field_backing(moved: Dict<Int, Vector<Int>>, bid: Int, fid: Int) Dict<
  Int,
  Vector<Int>,
> {
  case moved.get(bid) {
    .Some(fields) => {
      kept: Vector<Int> = []
      for f in fields {
        if f != fid {
          kept = insert_sorted(kept, f)
        }
      }
      if kept.len() == 0 {
        moved.remove(bid)
      } else {
        moved[bid] = kept
        moved
      }
    },
    .None => moved,
  }
}

fn block_verdicts(
  blk: CfgBlock,
  entry: ForwardState,
  prep: BlockPrep,
  table: SummaryTable,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
) Dict<Int, String> {
  scan := prep.scan
  moves := prep.moves
  verdicts: Dict<Int, String> = Dict.new()
  moved_backing: Dict<Int, Vector<Int>> = Dict.new()
  st := entry
  for inst, i in blk.instructions {
    last := last_use_at(inst.op, scan.live_after[i])
    pre := st
    case inst.op {
      .ARecordGet(base, f, _) => case atom_local_id(base) {
        .Some(bid) => if is_last_use(last, bid) or quartet_has(moves, inst.anf_local.id) {
          case pre.atom_field_own(base).project(.Field(f.id)).shell {
            .Some(_) => moved_backing = mark_field_backing(moved_backing, bid, f.id),
            .None => {},
          }
        },
        .None => {},
      },
      _ => {},
    }
    st = .transfer_op(inst.anf_local.id, inst.op, last, moves, table, b, sem)
    case inst.op {
      .ARecordUpdate(base, f, _, _, _) => {
        field_backing_moved := case atom_local_id(base) {
          .Some(bid) => has_moved_field_backing(moved_backing, bid, f.id),
          .None => false,
        }
        verdicts[inst.anf_local.id] = pre.record_update_verdict(
          inst.anf_local.id,
          base,
          f.id,
          last,
          field_backing_moved,
        )
        moved_backing = case atom_local_id(base) {
          .Some(bid) => consume_moved_field_backing(moved_backing, bid, f.id),
          .None => moved_backing,
        }
      },
      .AAssign(local, _) => moved_backing = clear_moved_backing(moved_backing, local.id),
      _ => {},
    }
  }
  verdicts
}

// Drive the transfer over a block's straight-line instructions from its entry
// state (no terminator publication yet).
fn forward_block_body(
  blk: CfgBlock,
  entry: ForwardState,
  prep: BlockPrep,
  table: SummaryTable,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
) ForwardState {
  st := entry
  for inst, i in blk.instructions {
    last := last_use_at(inst.op, prep.scan.live_after[i])
    st = .transfer_op(inst.anf_local.id, inst.op, last, prep.moves, table, b, sem)
  }
  st
}

// Drive the transfer over a block, then apply terminator publication for the
// value leaving on this block's exit edge.
fn forward_block(
  blk: CfgBlock,
  entry: ForwardState,
  prep: BlockPrep,
  table: SummaryTable,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
) ForwardState {
  st := forward_block_body(blk, entry, prep, table, b, sem)
  case blk.terminator {
    .Some(.Return(.Some(a))) => {
      st = .publish_atom(a)
    },
    .Some(.ValueBreak(a)) => {
      st = .publish_atom(a)
    },
    _ => {},
  }
  st
}

// ── Positional predecessor join + fixpoint ──────────────────────────
fn param_index(blk: CfgBlock, lid: Int) Int? {
  for p, i in blk.params {
    if p.id == lid {
      return .Some(i)
    }
  }
  .None
}

fn fact_of_local(own: Dict<Int, Int>, id: Int) Ownership {
  case own.get(id) {
    .Some(tag) => own_of_tag(tag),
    .None => .Unknown,
  }
}

fn is_processed(processed: Dict<Int, Bool>, id: Int) Bool {
  case processed.get(id) {
    .Some(v) => v,
    .None => false,
  }
}

fn own_map_get(exits: Dict<Int, Dict<Int, Int>>, id: Int) Dict<Int, Int> {
  case exits.get(id) {
    .Some(m) => m,
    .None => Dict.new(),
  }
}

// entry.ownership for every local live-in at blk:
//  - a block param: positional join of fact(pred_exit, pred_edge.args[i]);
//  - a live-through non-param local: same-id join of pred_exit.ownership[lid].
// Only processed predecessors contribute (unprocessed back-edges are skipped so an
// uninitialized back-edge does not poison a loop header: Unique ⊔ Unknown = Unknown).
fn join_entry_ownership(blk: CfgBlock, exits: Dict<Int, Dict<Int, Int>>, processed: Dict<Int, Bool>) Dict<
  Int,
  Int,
> {
  entry: Dict<Int, Int> = Dict.new()
  for lid in blk.entry.live {
    pidx := param_index(blk, lid)
    acc: Ownership? = .None
    for pe in blk.preds {
      // pe.target holds the predecessor block id (see cfg.add_pred comment).
      if is_processed(processed, pe.target.id) {
        pred_exit := own_map_get(exits, pe.target.id)
        contributed := case pidx {
          .Some(i) => if i < pe.args.len() {
            fact_of(pred_exit, pe.args[i])
          } else {
            .Unknown
          },
          .None => fact_of_local(pred_exit, lid),
        }
        acc = case acc {
          .None => .Some(contributed),
          .Some(prev) => .Some(prev.join_own(contributed)),
        }
      }
    }
    case acc {
      .Some(o) => entry[lid] = o.own_tag(),
      .None => {},
    }
  }
  entry
}

fn same_own_map(a: Dict<Int, Int>, b: Dict<Int, Int>) Bool {
  if a.keys().len() != b.keys().len() {
    return false
  }
  for k in a.keys() {
    case a.get(k) {
      .Some(av) => case b.get(k) {
        .Some(bv) => if av != bv {
          return false
        },
        .None => return false,
      },
      .None => {},
    }
  }
  true
}

fn int_keys_union(a: Vector<Int>, b: Vector<Int>) Vector<Int> {
  out := a
  for k in b {
    out = insert_sorted(out, k)
  }
  out
}

fn locked_get(locks: Dict<Int, Vector<Int>>, block_id: Int) Vector<Int> {
  case locks.get(block_id) {
    .Some(v) => v,
    .None => [],
  }
}

// Keep exact exit replacement as long as a block/local fact is converging. If a
// fact flips back to the value it had before the current stored value, lock only
// that local to the conservative merge on later visits. A per-block changed-visit
// cap forces any still-changing locals to lock too, so longer cycles also fall
// back to sound widening without blanket-widening every loop-carried fact.
type MergeOwnOut = .{ map: Dict<Int, Int>, locked: Vector<Int> }

fn merge_own_exit_targeted(
  old: Dict<Int, Int>,
  next: Dict<Int, Int>,
  prev: Dict<Int, Int>,
  locked: Vector<Int>,
  has_prev: Bool,
  force_lock_changed: Bool,
) MergeOwnOut {
  out := next
  next_locked := locked
  keys := int_keys_union(old.keys(), next.keys())
  for k in keys {
    old_fact := fact_of_local(old, k)
    next_fact := fact_of_local(next, k)
    prev_fact := fact_of_local(prev, k)
    changed := old_fact.own_tag() != next_fact.own_tag()
    oscillates := has_prev and changed and next_fact.own_tag() == prev_fact.own_tag()
    if live_contains_int(next_locked, k) or oscillates or force_lock_changed and changed {
      next_locked = insert_sorted(next_locked, k)
      out[k] = old_fact.join_own(next_fact).own_tag()
    }
  }
  MergeOwnOut.{ map: out, locked: next_locked }
}

// After the fixpoint every reachable block is processed, so materialize/join
// with an all-true processed map.
fn all_processed(blocks: Vector<CfgBlock>) Dict<Int, Bool> {
  done: Dict<Int, Bool> = Dict.new()
  for blk in blocks {
    done[blk.id.id] = true
  }
  done
}

// ── Binding-validity meet ───────────────────────────────────────────
fn valid_of_local(pv: Dict<Int, Bool>, id: Int) Bool {
  case pv.get(id) {
    .Some(v) => v,
    .None => true, // absent => valid
  }
}

fn valid_map_get(m: Dict<Int, Dict<Int, Bool>>, id: Int) Dict<Int, Bool> {
  case m.get(id) {
    .Some(v) => v,
    .None => Dict.new(),
  }
}

// binding_valid meet over every live-in local (mirroring the ownership join):
// block params meet through the positional edge arg's source-local validity;
// live-through non-param locals meet the same id's validity. Absent => valid.
fn join_entry_valid(
  blk: CfgBlock,
  exit_valid: Dict<Int, Dict<Int, Bool>>,
  processed: Dict<Int, Bool>,
) Dict<Int, Bool> {
  entry: Dict<Int, Bool> = Dict.new()
  for lid in blk.entry.live {
    pidx := param_index(blk, lid)
    ok := true
    for pe in blk.preds {
      if is_processed(processed, pe.target.id) {
        pv := valid_map_get(exit_valid, pe.target.id)
        contributed := case pidx {
          .Some(i) => if i < pe.args.len() {
            case atom_local_id(pe.args[i]) {
              .Some(src) => valid_of_local(pv, src),
              .None => true, // non-local feed is always valid
            }
          } else {
            true
          },
          .None => valid_of_local(pv, lid),
        }
        if !contributed {
          ok = false
        }
      }
    }
    entry[lid] = ok
  }
  entry
}

fn same_valid_map(a: Dict<Int, Bool>, b: Dict<Int, Bool>) Bool {
  if a.keys().len() != b.keys().len() {
    return false
  }
  for k in a.keys() {
    case a.get(k) {
      .Some(av) => case b.get(k) {
        .Some(bv) => if av != bv {
          return false
        },
        .None => return false,
      },
      .None => {},
    }
  }
  true
}

type MergeValidOut = .{ map: Dict<Int, Bool>, locked: Vector<Int> }

fn merge_valid_exit_targeted(
  old: Dict<Int, Bool>,
  next: Dict<Int, Bool>,
  prev: Dict<Int, Bool>,
  locked: Vector<Int>,
  has_prev: Bool,
  force_lock_changed: Bool,
) MergeValidOut {
  out := next
  next_locked := locked
  keys := int_keys_union(old.keys(), next.keys())
  for k in keys {
    old_valid := valid_of_local(old, k)
    next_valid := valid_of_local(next, k)
    prev_valid := valid_of_local(prev, k)
    changed := old_valid != next_valid
    oscillates := has_prev and changed and next_valid == prev_valid
    if live_contains_int(next_locked, k) or oscillates or force_lock_changed and changed {
      next_locked = insert_sorted(next_locked, k)
      out[k] = old_valid and next_valid
    }
  }
  MergeValidOut.{ map: out, locked: next_locked }
}

// ── Provenance join (param-origin sets) ─────────────────────────────
fn prov_map_get(m: Dict<Int, Dict<Int, Vector<Int>>>, id: Int) Dict<Int, Vector<Int>> {
  case m.get(id) {
    .Some(v) => v,
    .None => Dict.new(),
  }
}

fn same_prov_map(a: Dict<Int, Vector<Int>>, b: Dict<Int, Vector<Int>>) Bool {
  if a.keys().len() != b.keys().len() {
    return false
  }
  for k in a.keys() {
    case a.get(k) {
      .Some(av) => case b.get(k) {
        .Some(bv) => if !same_live(av, bv) {
          return false
        },
        .None => return false,
      },
      .None => {},
    }
  }
  true
}

fn prov_local(m: Dict<Int, Vector<Int>>, id: Int) Vector<Int> {
  case m.get(id) {
    .Some(v) => v,
    .None => [],
  }
}

type MergeProvOut = .{ map: Dict<Int, Vector<Int>>, locked: Vector<Int> }

fn merge_prov_exit_targeted(
  old: Dict<Int, Vector<Int>>,
  next: Dict<Int, Vector<Int>>,
  prev: Dict<Int, Vector<Int>>,
  locked: Vector<Int>,
  has_prev: Bool,
  force_lock_changed: Bool,
) MergeProvOut {
  out := next
  next_locked := locked
  keys := int_keys_union(old.keys(), next.keys())
  for k in keys {
    old_prov := prov_local(old, k)
    next_prov := prov_local(next, k)
    prev_prov := prov_local(prev, k)
    changed := !same_live(old_prov, next_prov)
    oscillates := has_prev and changed and same_live(next_prov, prev_prov)
    if live_contains_int(next_locked, k) or oscillates or force_lock_changed and changed {
      next_locked = insert_sorted(next_locked, k)
      out[k] = union_sorted(old_prov, next_prov)
    }
  }
  MergeProvOut.{ map: out, locked: next_locked }
}

// entry.prov for every live-in local (mirroring the ownership join): a block
// param unions the origins its positional edge arg carries; a live-through
// non-param local unions the same id's origins. Absent => empty.
fn join_entry_prov(
  blk: CfgBlock,
  exit_prov: Dict<Int, Dict<Int, Vector<Int>>>,
  processed: Dict<Int, Bool>,
) Dict<Int, Vector<Int>> {
  entry: Dict<Int, Vector<Int>> = Dict.new()
  for lid in blk.entry.live {
    pidx := param_index(blk, lid)
    acc: Vector<Int> = []
    for pe in blk.preds {
      if is_processed(processed, pe.target.id) {
        pv := prov_map_get(exit_prov, pe.target.id)
        src := case pidx {
          .Some(i) => if i < pe.args.len() {
            prov_of(pv, pe.args[i])
          } else {
            []
          },
          .None => case pv.get(lid) {
            .Some(v) => v,
            .None => [],
          },
        }
        acc = union_sorted(acc, src)
      }
    }
    if acc.len() > 0 {
      entry[lid] = acc
    }
  }
  entry
}

// Seed block 0's entry: each param's provenance is its own id (a param origin).
fn seed_param_prov(entry: Dict<Int, Vector<Int>>, params: Vector<LocalId>) Dict<Int, Vector<Int>> {
  for p in params {
    entry[p.id] = [p.id]
  }
  entry
}

// ── Field-ownership join + change-detection ─────────────────────────
fn field_own_map_get(m: Dict<Int, Dict<Int, ff.FieldMap>>, id: Int) Dict<Int, ff.FieldMap> {
  case m.get(id) {
    .Some(v) => v,
    .None => Dict.new(),
  }
}

fn field_of(fo: Dict<Int, ff.FieldMap>, id: Int) ff.FieldMap {
  case fo.get(id) {
    .Some(m) => m,
    .None => ff.empty(),
  }
}

fn field_of_atom(fo: Dict<Int, ff.FieldMap>, a: Atom) ff.FieldMap {
  case atom_local_id(a) {
    .Some(id) => field_of(fo, id),
    .None => ff.empty(),
  }
}

// entry.field_own per live-in local at blk: block param -> meet over positional
// edge args; live-through local -> meet over same-id. Only processed preds
// contribute. A path survives only if Unique on EVERY contributing pred. Cleared
// when the joined shell (entry_own) is non-Unique.
fn join_entry_field_own(
  blk: CfgBlock,
  exit_field: Dict<Int, Dict<Int, ff.FieldMap>>,
  entry_own: Dict<Int, Int>,
  processed: Dict<Int, Bool>,
) Dict<Int, ff.FieldMap> {
  entry: Dict<Int, ff.FieldMap> = Dict.new()
  for lid in blk.entry.live {
    pidx := param_index(blk, lid)
    acc: ff.FieldMap? = .None
    for pe in blk.preds {
      if is_processed(processed, pe.target.id) {
        fo := field_own_map_get(exit_field, pe.target.id)
        src := case pidx {
          .Some(i) => if i < pe.args.len() {
            field_of_atom(fo, pe.args[i])
          } else {
            ff.empty()
          },
          .None => field_of(fo, lid),
        }
        acc = case acc {
          .Some(cur) => .Some(cur.merge(src)),
          .None => .Some(src),
        }
      }
    }
    case acc {
      .Some(m) => {
        // downward-closed: only keep when the joined shell is Unique.
        shell_unique := case entry_own.get(lid) {
          .Some(t) => t == 0,
          .None => false,
        }
        if shell_unique and !m.is_empty() {
          entry[lid] = m
        }
      },
      .None => {},
    }
  }
  entry
}

fn path_prov_map_get(m: Dict<Int, Dict<Int, Dict<Int, Vector<Int>>>>, id: Int) Dict<
  Int,
  Dict<Int, Vector<Int>>,
> {
  case m.get(id) {
    .Some(v) => v,
    .None => Dict.new(),
  }
}

fn pp_of(pp: Dict<Int, Dict<Int, Vector<Int>>>, id: Int) Dict<Int, Vector<Int>> {
  case pp.get(id) {
    .Some(m) => m,
    .None => Dict.new(),
  }
}

fn pp_of_atom(pp: Dict<Int, Dict<Int, Vector<Int>>>, a: Atom) Dict<Int, Vector<Int>> {
  case atom_local_id(a) {
    .Some(id) => pp_of(pp, id),
    .None => Dict.new(),
  }
}

// entry.path_prov per live-in local at blk, mirroring join_entry_field_own: block
// param -> meet over positional edge args; live-through local -> meet over same-id.
// Only processed preds contribute. A (local, PathKey) survives only if present on
// EVERY contributing pred; on origin conflict across preds, keep the UNION of the
// origin vectors (a divergent origin makes the path multi-origin, which a later
// classifier drops — sound).
fn join_entry_path_prov(
  blk: CfgBlock,
  exit_pp: Dict<Int, Dict<Int, Dict<Int, Vector<Int>>>>,
  processed: Dict<Int, Bool>,
) Dict<Int, Dict<Int, Vector<Int>>> {
  entry: Dict<Int, Dict<Int, Vector<Int>>> = Dict.new()
  for lid in blk.entry.live {
    pidx := param_index(blk, lid)
    acc: Dict<Int, Vector<Int>>? = .None
    for pe in blk.preds {
      if is_processed(processed, pe.target.id) {
        pp := path_prov_map_get(exit_pp, pe.target.id)
        src := case pidx {
          .Some(i) => if i < pe.args.len() {
            pp_of_atom(pp, pe.args[i])
          } else {
            Dict.new()
          },
          .None => pp_of(pp, lid),
        }
        acc = case acc {
          .Some(cur) => .Some(meet_path_prov(cur, src)),
          .None => .Some(src),
        }
      }
    }
    case acc {
      .Some(m) => if m.keys().len() > 0 {
        entry[lid] = m
      },
      .None => {},
    }
  }
  entry
}

// Meet two per-local path_prov maps: a PathKey survives only if present in BOTH;
// origins are unioned.
fn meet_path_prov(a: Dict<Int, Vector<Int>>, b: Dict<Int, Vector<Int>>) Dict<Int, Vector<Int>> {
  out: Dict<Int, Vector<Int>> = Dict.new()
  for k, av in a {
    case b.get(k) {
      .Some(bv) => out[k] = union_sorted(av, bv),
      .None => {},
    }
  }
  out
}

// Block field_own maps are equal iff same locals and each local's FieldMap has
// the same path-key set (FieldMap.same).
fn same_field_own_map(a: Dict<Int, ff.FieldMap>, b: Dict<Int, ff.FieldMap>) Bool {
  if a.keys().len() != b.keys().len() {
    return false
  }
  for k in a.keys() {
    case a.get(k) {
      .Some(av) => case b.get(k) {
        .Some(bv) => if !av.same(bv) {
          return false
        },
        .None => return false,
      },
      .None => {},
    }
  }
  true
}

// Conservative widening for field_own: keep only locals present in both old and
// next, and meet each local's FieldMap (keys intersection).
fn merge_field_own_exit(old: Dict<Int, ff.FieldMap>, next: Dict<Int, ff.FieldMap>) Dict<
  Int,
  ff.FieldMap,
> {
  result: Dict<Int, ff.FieldMap> = Dict.new()
  for k in old.keys() {
    case old.get(k) {
      .Some(old_fm) => case next.get(k) {
        .Some(next_fm) => {
          merged := old_fm.merge(next_fm)
          if !merged.is_empty() {
            result[k] = merged
          }
        },
        .None => {},
      },
      .None => {},
    }
  }
  result
}

// Block path_prov maps are equal iff same locals and each local's per-PathKey map
// has the same key set and equal origin vectors.
fn same_path_prov_map(a: Dict<Int, Dict<Int, Vector<Int>>>, b: Dict<Int, Dict<Int, Vector<Int>>>) Bool {
  if a.keys().len() != b.keys().len() {
    return false
  }
  for k in a.keys() {
    case a.get(k) {
      .Some(av) => case b.get(k) {
        .Some(bv) => if !same_pp_local(av, bv) {
          return false
        },
        .None => return false,
      },
      .None => {},
    }
  }
  true
}

fn same_pp_local(a: Dict<Int, Vector<Int>>, b: Dict<Int, Vector<Int>>) Bool {
  if a.keys().len() != b.keys().len() {
    return false
  }
  for k in a.keys() {
    case a.get(k) {
      .Some(av) => case b.get(k) {
        .Some(bv) => if !same_live(av, bv) {
          return false
        },
        .None => return false,
      },
      .None => {},
    }
  }
  true
}

// Conservative widening for path_prov, mirroring merge_field_own_exit: keep only
// locals present in both old and next, and meet each local's per-PathKey map
// (key-intersection + origin union).
fn merge_path_prov_exit(
  old: Dict<Int, Dict<Int, Vector<Int>>>,
  next: Dict<Int, Dict<Int, Vector<Int>>>,
) Dict<Int, Dict<Int, Vector<Int>>> {
  result: Dict<Int, Dict<Int, Vector<Int>>> = Dict.new()
  for k in old.keys() {
    case old.get(k) {
      .Some(old_pp) => case next.get(k) {
        .Some(next_pp) => {
          merged := meet_path_prov(old_pp, next_pp)
          if merged.keys().len() > 0 {
            result[k] = merged
          }
        },
        .None => {},
      },
      .None => {},
    }
  }
  result
}

// Combined ownership+validity+provenance fixpoint co-iterated to a joint fixed
// point (they share ForwardState and forward_block). The single live driver
// (guardrail G1).
type FixResult = .{
  exits: Dict<Int, Dict<Int, Int>>,
  exit_valid: Dict<Int, Dict<Int, Bool>>,
  exit_prov: Dict<Int, Dict<Int, Vector<Int>>>,
  exit_field_own: Dict<Int, Dict<Int, ff.FieldMap>>,
  exit_path_prov: Dict<Int, Dict<Int, Dict<Int, Vector<Int>>>>,
}

fn prev_seen_get(seen: Dict<Int, Bool>, id: Int) Bool {
  case seen.get(id) {
    .Some(v) => v,
    .None => false,
  }
}

fn change_count_get(counts: Dict<Int, Int>, id: Int) Int {
  case counts.get(id) {
    .Some(v) => v,
    .None => 0,
  }
}

fn run_fixpoint(
  blocks: Vector<CfgBlock>,
  params: Vector<LocalId>,
  table: SummaryTable,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
) FixResult {
  exits: Dict<Int, Dict<Int, Int>> = Dict.new()
  exit_valid: Dict<Int, Dict<Int, Bool>> = Dict.new()
  exit_prov: Dict<Int, Dict<Int, Vector<Int>>> = Dict.new()
  exit_field_own: Dict<Int, Dict<Int, ff.FieldMap>> = Dict.new()
  exit_path_prov: Dict<Int, Dict<Int, Dict<Int, Vector<Int>>>> = Dict.new()
  prev_exits: Dict<Int, Dict<Int, Int>> = Dict.new()
  prev_exit_valid: Dict<Int, Dict<Int, Bool>> = Dict.new()
  prev_exit_prov: Dict<Int, Dict<Int, Vector<Int>>> = Dict.new()
  locked_own: Dict<Int, Vector<Int>> = Dict.new()
  locked_valid: Dict<Int, Vector<Int>> = Dict.new()
  locked_prov: Dict<Int, Vector<Int>> = Dict.new()
  prev_seen: Dict<Int, Bool> = Dict.new()
  changed_visits: Dict<Int, Int> = Dict.new()
  processed: Dict<Int, Bool> = Dict.new()
  for blk in blocks {
    exits[blk.id.id] = Dict.new()
    exit_valid[blk.id.id] = Dict.new()
    exit_prov[blk.id.id] = Dict.new()
    exit_field_own[blk.id.id] = Dict.new()
    exit_path_prov[blk.id.id] = Dict.new()
    prev_exits[blk.id.id] = Dict.new()
    prev_exit_valid[blk.id.id] = Dict.new()
    prev_exit_prov[blk.id.id] = Dict.new()
    locked_own[blk.id.id] = []
    locked_valid[blk.id.id] = []
    locked_prov[blk.id.id] = []
    prev_seen[blk.id.id] = false
    changed_visits[blk.id.id] = 0
    processed[blk.id.id] = false
  }

  // Quartet moves + liveness scan are dataflow-invariant: compute once, not per
  // fixpoint visit (keeps the O(n^2) quartet recognizer off the iteration path).
  preps := prep_blocks(blocks, sem)
  changed := true
  for changed {
    changed = false
    for blk in blocks {
      entry_own := join_entry_ownership(blk, exits, processed)
      entry_valid := join_entry_valid(blk, exit_valid, processed)
      entry_prov := join_entry_prov(blk, exit_prov, processed)
      if blk.id.id == 0 {
        entry_prov = seed_param_prov(entry_prov, params)
      }
      entry_field := join_entry_field_own(blk, exit_field_own, entry_own, processed)
      entry_pp := join_entry_path_prov(blk, exit_path_prov, processed)
      st := ForwardState.{
        own: entry_own,
        valid: entry_valid,
        prov: entry_prov,
        field_own: entry_field,
        path_prov: entry_pp,
      }
      st = forward_block(blk, st, prep_get(preps, blk, sem), table, b, sem)
      already := is_processed(processed, blk.id.id)
      old_own := own_map_get(exits, blk.id.id)
      old_valid := valid_map_get(exit_valid, blk.id.id)
      old_prov := prov_map_get(exit_prov, blk.id.id)
      old_field := field_own_map_get(exit_field_own, blk.id.id)
      old_pp := path_prov_map_get(exit_path_prov, blk.id.id)
      next_own := st.own
      next_valid := st.valid
      next_prov := st.prov
      next_field := st.field_own
      next_pp := st.path_prov
      if already {
        has_prev := prev_seen_get(prev_seen, blk.id.id)
        force_lock_changed := change_count_get(changed_visits, blk.id.id) >= fixpoint_widen_cap
        own_merge := merge_own_exit_targeted(
          old_own,
          st.own,
          own_map_get(prev_exits, blk.id.id),
          locked_get(locked_own, blk.id.id),
          has_prev,
          force_lock_changed,
        )
        valid_merge := merge_valid_exit_targeted(
          old_valid,
          st.valid,
          valid_map_get(prev_exit_valid, blk.id.id),
          locked_get(locked_valid, blk.id.id),
          has_prev,
          force_lock_changed,
        )
        prov_merge := merge_prov_exit_targeted(
          old_prov,
          st.prov,
          prov_map_get(prev_exit_prov, blk.id.id),
          locked_get(locked_prov, blk.id.id),
          has_prev,
          force_lock_changed,
        )
        next_own = own_merge.map
        next_valid = valid_merge.map
        next_prov = prov_merge.map
        locked_own[blk.id.id] = own_merge.locked
        locked_valid[blk.id.id] = valid_merge.locked
        locked_prov[blk.id.id] = prov_merge.locked

        // field_own widening: conservative meet (key-intersection + per-path meet)
        next_field = merge_field_own_exit(old_field, st.field_own)

        // path_prov widening in lockstep: same conservative meet shape.
        next_pp = merge_path_prov_exit(old_pp, st.path_prov)
      }
      if !already
        or !same_own_map(old_own, next_own)
        or !same_valid_map(old_valid, next_valid)
        or !same_prov_map(old_prov, next_prov)
        or !same_field_own_map(old_field, next_field)
        or !same_path_prov_map(old_pp, next_pp) {
        changed = true
        if already {
          prev_exits[blk.id.id] = old_own
          prev_exit_valid[blk.id.id] = old_valid
          prev_exit_prov[blk.id.id] = old_prov
          prev_seen[blk.id.id] = true
          changed_visits[blk.id.id] = change_count_get(changed_visits, blk.id.id) + 1
        }
        exits[blk.id.id] = next_own
        exit_valid[blk.id.id] = next_valid
        exit_prov[blk.id.id] = next_prov
        exit_field_own[blk.id.id] = next_field
        exit_path_prov[blk.id.id] = next_pp
      }
      processed[blk.id.id] = true
    }
  }
  FixResult.{ exits, exit_valid, exit_prov, exit_field_own, exit_path_prov }
}

// ── Driver ──────────────────────────────────────────────────────────
pub fn analyze(view: CfgView, b: BuiltinRegistry, sem: OptimizerSemantics) CfgView {
  analyze_with_summaries(view, b, sem, empty_summary_table())
}

pub fn analyze_with_summaries(
  view: CfgView,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
  table: SummaryTable,
) CfgView {
  functions := collect f in view.functions {
    analyze_function(f, table, b, sem)
  }
  CfgView.{ functions }
}

// ── Pre-analysis dead-merge param pruning (G5) ──────────────────────
// A minimal PURE view transform run BEFORE any ownership/summary analysis: it
// drops join/loop carried block-params that are dead across the boundary (their
// param local is not in the block's live_in), realigning the positionally-
// aligned edge args (preds + predecessor succs) and terminator payloads. Only
// join/loop blocks carry params; entry/straight-line blocks have empty params
// and are untouched. Removing a *dead* param cannot change any other local's
// liveness, so the pruned view is self-consistent and the full analysis then
// runs fresh on it (no stale facts). Returns a NEW view; never mutate an
// analyzed CFG.
pub fn prune_dead_merge(view: CfgView) CfgView {
  functions := collect f in view.functions {
    prune_function(f)
  }
  CfgView.{ functions }
}

fn prune_function(f: CfgFunction) CfgFunction {
  live := compute_liveness(f.blocks)

  // block-id -> ascending positions to drop from that block's params.
  drop_by_block: Dict<Int, Vector<Int>> = Dict.new()
  for blk in f.blocks {
    li := live_get(live, blk.id.id).live_in
    positions: Vector<Int> = []
    for p, i in blk.params {
      if !live_contains_int(li, p.id) {
        positions = .append(i)
      }
    }
    if positions.len() > 0 {
      drop_by_block[blk.id.id] = positions
    }
  }

  blocks := collect blk in f.blocks {
    prune_block(blk, drop_by_block)
  }
  f.blocks = blocks
  f
}

fn drop_positions_for(drop_by_block: Dict<Int, Vector<Int>>, block_id: Int) Vector<Int> {
  case drop_by_block.get(block_id) {
    .Some(v) => v,
    .None => [],
  }
}

fn prune_block(blk: CfgBlock, drop_by_block: Dict<Int, Vector<Int>>) CfgBlock {
  own := drop_positions_for(drop_by_block, blk.id.id)
  blk.params = drop_positions_local(blk.params, own)

  // preds: every edge into this block feeds this block's params, so drop this
  // block's own positions from each pred edge's args.
  blk.preds = collect e in blk.preds {
    CfgEdge.{ target: e.target, args: drop_positions_atom(e.args, own) }
  }

  // succs: each forward edge feeds ITS target's params, so drop the target's
  // positions from that edge's args.
  blk.succs = collect e in blk.succs {
    CfgEdge.{
      target: e.target,
      args: drop_positions_atom(e.args, drop_positions_for(drop_by_block, e.target.id)),
    }
  }

  case blk.terminator {
    .Some(term) => blk.terminator = .Some(prune_terminator(term, drop_by_block)),
    .None => {},
  }
  blk
}

// Rebuild a block's params dropping the flagged (ascending) positions.
fn drop_positions_local(params: Vector<LocalId>, positions: Vector<Int>) Vector<LocalId> {
  if positions.len() == 0 {
    return params
  }
  out: Vector<LocalId> = []
  for p, i in params {
    if !live_contains_int(positions, i) {
      out = .append(p)
    }
  }
  out
}

// Rebuild an edge's args dropping the same (ascending) positions.
fn drop_positions_atom(args: Vector<Atom>, positions: Vector<Int>) Vector<Atom> {
  if positions.len() == 0 {
    return args
  }
  out: Vector<Atom> = []
  for a, i in args {
    if !live_contains_int(positions, i) {
      out = .append(a)
    }
  }
  out
}

// Drop aligned atoms from terminator payloads that feed a pruned block's params.
// Each edge-carrying terminator variant names the target block(s) whose params
// its payload aligns to; keep targets/identity unchanged.
fn prune_terminator(term: Terminator, drop_by_block: Dict<Int, Vector<Int>>) Terminator {
  case term {
    .Branch(target, args) => .Branch(
      target,
      drop_positions_atom(args, drop_positions_for(drop_by_block, target.id)),
    ),
    .CondBranch(test, then_t, then_args, else_t, else_args) => .CondBranch(
      test,
      then_t,
      drop_positions_atom(then_args, drop_positions_for(drop_by_block, then_t.id)),
      else_t,
      drop_positions_atom(else_args, drop_positions_for(drop_by_block, else_t.id)),
    ),
    .Match(scrut, edges) => {
      pruned := collect e in edges {
        CfgEdge.{
          target: e.target,
          args: drop_positions_atom(e.args, drop_positions_for(drop_by_block, e.target.id)),
        }
      }
      .Match(scrut, pruned)
    },
    .LoopBackEdge(target, args) => .LoopBackEdge(
      target,
      drop_positions_atom(args, drop_positions_for(drop_by_block, target.id)),
    ),
    _ => term,
  }
}

// Phase 3 threads a read-only `table` of callee summaries through the analysis
// without restructuring the algorithm; the summary is consulted in transfer_call
// (Task 4). The combined ownership/validity/provenance fixpoint still runs here.
fn analyze_function(
  f: CfgFunction,
  table: SummaryTable,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
) CfgFunction {
  live := compute_liveness(f.blocks)
  blocks := collect blk in f.blocks {
    bl := live_get(live, blk.id.id)
    blk.entry.live = bl.live_in
    blk.exit.live = bl.live_out
    blk
  }
  blocks = ownership_stage(blocks, f.params, table, b, sem)
  f.blocks = blocks
  f
}

// Combined ownership+validity+provenance fixpoint + materialize the facts maps.
fn ownership_stage(
  blocks: Vector<CfgBlock>,
  params: Vector<LocalId>,
  table: SummaryTable,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
) Vector<CfgBlock> {
  fx := run_fixpoint(blocks, params, table, b, sem)
  done := all_processed(blocks)
  collect blk in blocks {
    entry_own := join_entry_ownership(blk, fx.exits, done)
    entry_valid := join_entry_valid(blk, fx.exit_valid, done)
    entry_prov := join_entry_prov(blk, fx.exit_prov, done)
    if blk.id.id == 0 {
      entry_prov = seed_param_prov(entry_prov, params)
    }
    entry_field := join_entry_field_own(blk, fx.exit_field_own, entry_own, done)
    entry_pp := join_entry_path_prov(blk, fx.exit_path_prov, done)
    st := ForwardState.{
      own: entry_own,
      valid: entry_valid,
      prov: entry_prov,
      field_own: entry_field,
      path_prov: entry_pp,
    }
    prep := block_prep(blk, sem)
    verdicts := block_verdicts(blk, st, prep, table, b, sem)
    st = forward_block(blk, st, prep, table, b, sem)
    blk.entry.ownership = entry_own
    blk.exit.ownership = st.own
    blk.entry.binding_valid = entry_valid
    blk.exit.binding_valid = st.valid
    blk.entry.field_own = entry_field
    blk.exit.field_own = st.field_own
    blk.exit.verdicts = verdicts
    blk
  }
}

// ── Interprocedural summary derivation ──────────────────────────────
fn own_is_shared(own: Dict<Int, Int>, id: Int) Bool {
  case own.get(id) {
    .Some(tag) => tag == own_tag(.Shared),
    .None => false,
  }
}

fn return_atom(blk: CfgBlock) Atom? {
  case blk.terminator {
    .Some(.Return(.Some(a))) => .Some(a),
    _ => .None,
  }
}

fn param_pos(params: Vector<LocalId>, local_id: Int) Int {
  for p, i in params {
    if p.id == local_id {
      return i
    }
  }
  -1
}

fn prov_to_indices(params: Vector<LocalId>, origins: Vector<Int>) Vector<Int> {
  out: Vector<Int> = []
  for o in origins {
    idx := param_pos(params, o)
    if idx >= 0 {
      out = insert_sorted(out, idx)
    }
  }
  out
}

fn join_return(a: ReturnEffect, b: ReturnEffect) ReturnEffect {
  case a {
    .Shared => .Shared,
    .OwnedFresh => b,
    .MayAliasParams(sa) => case b {
      .Shared => .Shared,
      .OwnedFresh => .MayAliasParams(sa),
      .MayAliasParams(sb) => .MayAliasParams(union_sorted(sa, sb)),
    },
  }
}

// Classify each parameter's escape/capability by scanning EVERY block's
// post-publish exit (fx.exits / fx.exit_valid): a param that ends Shared on any
// block exit escapes (Retained) — even on a dead branch or via a returned
// aggregate, since publication is transitive over provenance. A param whose
// binding is ever invalidated is Consumed. The return effect is classified from
// each return block's BODY-ONLY state (before the terminator publish, so the
// returned value isn't spuriously Shared), joined across all return blocks:
// MayAliasParams(indices) when the return atom carries param provenance,
// OwnedFresh for a genuinely fresh Unique, else Shared.
pub fn summarize_function(
  f: CfgFunction,
  table: SummaryTable,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
) Summary {
  live := compute_liveness(f.blocks)
  blocks := collect blk in f.blocks {
    bl := live_get(live, blk.id.id)
    blk.entry.live = bl.live_in
    blk.exit.live = bl.live_out
    blk
  }
  fx := run_fixpoint(blocks, f.params, table, b, sem)

  params: Vector<ParamSummary> = collect p in f.params {
    esc: EscapeEffect = .Borrowed
    cap: ParamCapability = .NoCap
    for blk in blocks {
      if own_is_shared(own_map_get(fx.exits, blk.id.id), p.id) {
        esc = .Retained
      }
      case valid_map_get(fx.exit_valid, blk.id.id).get(p.id) {
        .Some(v) => if !v {
          cap = .Consumed
        },
        .None => {},
      }
    }
    ParamSummary.{ escape: esc, capability: cap }
  }

  done := all_processed(blocks)
  ret: ReturnEffect = .OwnedFresh
  seen := false
  for blk in blocks {
    case return_atom(blk) {
      .Some(a) => {
        entry_own := join_entry_ownership(blk, fx.exits, done)
        entry_valid := join_entry_valid(blk, fx.exit_valid, done)
        entry_prov := join_entry_prov(blk, fx.exit_prov, done)
        if blk.id.id == 0 {
          entry_prov = seed_param_prov(entry_prov, f.params)
        }
        entry_field := join_entry_field_own(blk, fx.exit_field_own, entry_own, done)
        entry_pp := join_entry_path_prov(blk, fx.exit_path_prov, done)
        st := ForwardState.{
          own: entry_own,
          valid: entry_valid,
          prov: entry_prov,
          field_own: entry_field,
          path_prov: entry_pp,
        }
        body := forward_block_body(blk, st, block_prep(blk, sem), table, b, sem)

        // Aliasing origins now split across the return atom's SHELL prov and its
        // per-path path_prov (a fresh wrapper aliases params only through fields).
        ret_origins := prov_of(body.prov, a)
        case atom_local_id(a) {
          .Some(aid) => {
            for k, os in body.path_prov_get(aid) {
              ret_origins = union_sorted(ret_origins, os)
            }
          },
          .None => {},
        }
        idxs := prov_to_indices(f.params, ret_origins)
        r: ReturnEffect = if idxs.len() > 0 {
          .MayAliasParams(idxs)
        } else {
          case fact_of(body.own, a) {
            .Unique => .OwnedFresh,
            _ => .Shared,
          }
        }
        ret = if seen {
          ret.join_return(r)
        } else {
          r
        }
        seen = true
      },
      .None => {},
    }
  }

  Summary.{ params, ret }
}
