//! Shared optimizer-facing semantics for builtin calls and structured ANF ops.
//!
//! Stage 1 scope:
//! - centralize builtin optimizer metadata in one module
//! - expose effect classification for passes
//! - preserve current dead-let purity behavior (calls remain non-eliminable)

use compiler.anf.{AnfExpr, AnfOp}
use compiler.builder_family.{
  BuilderConfig, empty_builder_config, string_builder_config, vector_builder_config,
}
use compiler.builtins.{BuiltinRegistry}
use compiler.core_ir.{FieldId, FuncId, LocalId}
use compiler.mono_type.{TypeId}

pub type CowOpEntry = .{ base_arg: Int, in_place_id: FuncId? }

pub type CowConfig = .{
  cow_ops: Dict<Int, CowOpEntry>,
  fresh_producer_ids: Dict<Int, Bool>,
  read_only_ids: Dict<Int, Bool>,
  builder: BuilderConfig,
  string_builder: BuilderConfig,
}

pub type EffectKind = { Pure, ReadOnly, Update, Allocate, Control }

pub type CallSemantics = .{
  effect: EffectKind,
  fresh_result: Bool,
  cow_base_arg: Int?,
  in_place_equivalent: FuncId?,
  // Argument positions whose values are structurally retained by the call result
  // in addition to the COW base. `.None` means legacy/unknown metadata: retain
  // every non-base arg, matching the old conservative behavior.
  retained_args: Vector<Int>?,
}

pub type ReusableUpdateKind = { Call, RecordUpdate }

pub type ReusableUpdateSite = .{
  kind: ReusableUpdateKind,
  base_local: LocalId,
  in_place_equivalent: FuncId?,
}

pub type ContainerKind = { NotCollection, VectorLike, DictLike }

pub type OptimizerSemantics = .{
  call_semantics: Dict<Int, CallSemantics>,
  builder: BuilderConfig,
  string_builder: BuilderConfig,
  container_kinds: Dict<Int, Int>,
  // record TypeId.id -> (field index -> is-reference-typed). Empty means "unknown",
  // treated as primitive: the ownership dirty-path analysis then only claims a
  // record field as a field-granular in-place requirement when the field is a
  // reference-typed (separate GC heap) backing. Populated from the resolver's type
  // table via `with_ref_fields` on the codegen/inspection paths; left empty on
  // analysis-only paths where field-granular variant keys are not published.
  ref_fields: Dict<Int, Dict<Int, Bool>>,
}

// Attach a reference-typed-field table (see `build_ref_field_table`) to `sem`.
pub fn with_ref_fields(sem: OptimizerSemantics, ref_fields: Dict<Int, Dict<Int, Bool>>) OptimizerSemantics {
  sem.ref_fields = ref_fields
  sem
}

// Whether field `fld` of record type `tid` is KNOWN to be a scalar primitive
// stored inline in the struct. Only an explicit `false` (not-reference) entry
// answers true; an absent record or field answers false ("unknown"). This makes
// the ownership dirty-path gate conservative: a field path is dropped only when
// the type table proves the field primitive, so an unpopulated `ref_fields`
// (analysis-only paths) keeps every field path exactly as before.
pub fn sem_field_is_primitive(sem: OptimizerSemantics, tid: TypeId, fld: FieldId) Bool {
  case sem.ref_fields.get(tid.id) {
    .Some(m) => case m.get(fld.id) {
      .Some(is_ref) => !is_ref,
      .None => false,
    },
    .None => false,
  }
}

fn control_call() CallSemantics {
  .{
    effect: .Control,
    fresh_result: false,
    cow_base_arg: .None,
    in_place_equivalent: .None,
    retained_args: .Some([]),
  }
}

fn legacy_unknown_call() CallSemantics {
  .{
    effect: .Control,
    fresh_result: false,
    cow_base_arg: .None,
    in_place_equivalent: .None,
    retained_args: .None,
  }
}

pub fn empty_optimizer_semantics() OptimizerSemantics {
  .{
    call_semantics: Dict.new(),
    builder: empty_builder_config(),
    string_builder: empty_builder_config(),
    container_kinds: Dict.new(),
    ref_fields: Dict.new(),
  }
}

pub fn make_prelude_optimizer_semantics(b: BuiltinRegistry) OptimizerSemantics {
  calls: Dict<Int, CallSemantics> = Dict.new()
  container_kinds: Dict<Int, Int> = Dict.new()
  builder := vector_builder_config(b)
  string_builder := string_builder_config(b)
  calls[b.method_id("Vector", "len").id] = CallSemantics.{
    effect: .ReadOnly,
    fresh_result: false,
    cow_base_arg: .None,
    in_place_equivalent: .None,
    retained_args: .Some([]),
  }
  calls[b.id("vector$set_unsafe").id] = CallSemantics.{
    effect: .Update,
    fresh_result: false,
    cow_base_arg: .Some(0),
    in_place_equivalent: .Some(b.id("vector$set_in_place")),
    retained_args: .Some([2]), // base, index, value: only value is stored
  }

  // Typed i64 mirror (sub-project A): the router swaps set_unsafe -> set_i64 for
  // promoted Vector<Int> writes, so its persistent op needs the same Update
  // semantics + in-place pairing to the typed in-place op.
  calls[b.id("vector$set_i64").id] = CallSemantics.{
    effect: .Update,
    fresh_result: false,
    cow_base_arg: .Some(0),
    in_place_equivalent: .Some(b.id("vector$set_in_place_i64")),
    retained_args: .Some([2]), // base, index, value: only value is stored
  }
  calls[b.method_id("Dict", "set").id] = CallSemantics.{
    effect: .Update,
    fresh_result: false,
    cow_base_arg: .Some(0),
    in_place_equivalent: .Some(b.id("dict$set_in_place")),
    retained_args: .Some([1, 2]), // base, key, value: key+value live in the HAMT
  }
  calls[b.method_id("Dict", "remove").id] = CallSemantics.{
    effect: .Update,
    fresh_result: false,
    cow_base_arg: .Some(0),
    in_place_equivalent: .Some(b.id("dict$remove_in_place")),
    retained_args: .Some([]), // removal key is a lookup operand, not stored
  }
  calls[b.method_id("Dict", "get").id] = CallSemantics.{
    effect: .ReadOnly,
    fresh_result: false,
    cow_base_arg: .None,
    in_place_equivalent: .None,
    retained_args: .Some([]), // lookup borrows dict/key but stores neither
  }
  calls[b.method_id("Dict", "keys").id] = CallSemantics.{
    effect: .ReadOnly,
    fresh_result: true,
    cow_base_arg: .None, // fresh keys vector carries no dict provenance
    in_place_equivalent: .None,
    retained_args: .Some([]), // borrows the dict, stores nothing
  }
  calls[builder.push_id.id] = CallSemantics.{
    effect: .Update,
    fresh_result: false,
    cow_base_arg: .Some(0),
    in_place_equivalent: .None,
    retained_args: .Some([1]),
  }
  calls[b.method_id("Vector", "make").id] = CallSemantics.{
    effect: .Allocate,
    fresh_result: true,
    cow_base_arg: .None,
    in_place_equivalent: .None,
    retained_args: .Some([1]), // size, fill: the fill value is stored in every slot
  }
  calls[b.method_id("Dict", "new").id] = CallSemantics.{
    effect: .Allocate,
    fresh_result: true,
    cow_base_arg: .None,
    in_place_equivalent: .None,
    retained_args: .Some([]),
  }
  calls[builder.builder_new_id.id] = CallSemantics.{
    effect: .Allocate,
    fresh_result: true,
    cow_base_arg: .None,
    in_place_equivalent: .None,
    retained_args: .Some([]),
  }
  calls[builder.builder_from_id.id] = CallSemantics.{
    effect: .Allocate,
    fresh_result: true,
    cow_base_arg: .None,
    in_place_equivalent: .None,
    retained_args: .Some([0]),
  }
  calls[builder.builder_push_id.id] = CallSemantics.{
    effect: .Update,
    fresh_result: false,
    cow_base_arg: .Some(0),
    in_place_equivalent: .None,
    retained_args: .Some([1]),
  }
  calls[builder.builder_freeze_id.id] = CallSemantics.{
    effect: .Allocate,
    fresh_result: true,
    cow_base_arg: .None,
    in_place_equivalent: .None,
    retained_args: .Some([0]),
  }

  // String builder family. `String.concat` is registered exactly like
  // `Vector.append` (the vector push op): a consume-reassign combinator whose
  // base argument (arg 0) is the reusable accumulator. This keeps the base
  // untainted through the loop body so the loop-region detector can fire.
  //
  // It deliberately does NOT use `cow_base_arg: .None`: that would make taint
  // analysis taint the accumulator (a non-COW allocating call taints all its
  // args), which strips its ownership and blocks the rewrite. There is no true
  // in-place string mutation, so `in_place_equivalent` is `.None` — no
  // straight-line in-place rewrite is ever emitted; recognition stays local to
  // builder-region rewrites.
  calls[string_builder.push_id.id] = CallSemantics.{
    effect: .Update,
    fresh_result: false,
    cow_base_arg: .Some(0),
    in_place_equivalent: .None,
    retained_args: .Some([1]),
  }
  calls[string_builder.builder_from_id.id] = CallSemantics.{
    effect: .Allocate,
    fresh_result: true,
    cow_base_arg: .None,
    in_place_equivalent: .None,
    retained_args: .Some([0]),
  }
  calls[string_builder.builder_push_id.id] = CallSemantics.{
    effect: .Update,
    fresh_result: false,
    cow_base_arg: .Some(0),
    in_place_equivalent: .None,
    retained_args: .Some([1]),
  }
  calls[string_builder.builder_freeze_id.id] = CallSemantics.{
    effect: .Allocate,
    fresh_result: true,
    cow_base_arg: .None,
    in_place_equivalent: .None,
    retained_args: .Some([0]),
  }
  container_kinds[b.id("vector$set_unsafe").id] = 1
  container_kinds[builder.push_id.id] = 1
  container_kinds[b.method_id("Dict", "set").id] = 2
  .{ call_semantics: calls, builder, string_builder, container_kinds, ref_fields: Dict.new() }
}

pub fn container_kind(sem: OptimizerSemantics, fid: FuncId) ContainerKind {
  case sem.container_kinds.get(fid.id) {
    .Some(1) => .VectorLike,
    .Some(2) => .DictLike,
    _ => .NotCollection,
  }
}

pub fn call_info(semantics: OptimizerSemantics, func_id: FuncId) CallSemantics? {
  semantics.call_semantics[func_id.id]
}

pub fn cow_config_from_semantics(semantics: OptimizerSemantics) CowConfig {
  cow_ops: Dict<Int, CowOpEntry> = Dict.new()
  fresh_producer_ids: Dict<Int, Bool> = Dict.new()
  read_only_ids: Dict<Int, Bool> = Dict.new()

  for func_id in semantics.call_semantics.keys() {
    info := semantics.call_semantics[func_id].unwrap_or(control_call())

    case info.cow_base_arg {
      .Some(base_arg) => cow_ops[func_id] = CowOpEntry.{
        base_arg,
        in_place_id: info.in_place_equivalent,
      },
      .None => {},
    }

    if info.fresh_result {
      fresh_producer_ids[func_id] = true
    }

    case info.effect {
      .ReadOnly => read_only_ids[func_id] = true,
      _ => {},
    }
  }

  .{
    cow_ops,
    fresh_producer_ids,
    read_only_ids,
    builder: semantics.builder,
    string_builder: semantics.string_builder,
  }
}

pub fn optimizer_semantics_from_cow_config(config: CowConfig) OptimizerSemantics {
  calls: Dict<Int, CallSemantics> = Dict.new()

  for func_id in config.cow_ops.keys() {
    info := config.cow_ops[func_id].unwrap_or(CowOpEntry.{ base_arg: 0, in_place_id: .None })
    calls[func_id] = CallSemantics.{
      effect: .Update,
      fresh_result: false,
      cow_base_arg: .Some(info.base_arg),
      in_place_equivalent: info.in_place_id,
      retained_args: .None,
    }
  }

  for func_id in config.fresh_producer_ids.keys() {
    current := calls[func_id].unwrap_or(legacy_unknown_call())
    calls[func_id] = CallSemantics.{
      effect: if current.effect == .Control {
        .Allocate
      } else {
        current.effect
      },
      fresh_result: true,
      cow_base_arg: current.cow_base_arg,
      in_place_equivalent: current.in_place_equivalent,
      retained_args: current.retained_args,
    }
  }

  for func_id in config.read_only_ids.keys() {
    current := calls[func_id].unwrap_or(legacy_unknown_call())
    calls[func_id] = CallSemantics.{
      effect: .ReadOnly,
      fresh_result: current.fresh_result,
      cow_base_arg: current.cow_base_arg,
      in_place_equivalent: current.in_place_equivalent,
      retained_args: current.retained_args,
    }
  }

  .{
    call_semantics: calls,
    builder: config.builder,
    string_builder: config.string_builder,
    container_kinds: Dict.new(),
    ref_fields: Dict.new(),
  }
}

pub fn op_effect(op: AnfOp, semantics: OptimizerSemantics) EffectKind {
  case op {
    .ABinOp(binop, _, _, kind) => case kind {
      .Int => case binop {
        .Div => .Control,
        .Mod => .Control,
        _ => .Pure,
      },
      _ => .Pure,
    },
    .AInit(_) => .Pure,
    .AUnOp(_, _, _) => .Pure,
    .ARecord(_, _) => .Allocate,
    .ARecordGet(_, _, _) => .Pure,
    .ARecordUpdate(_, _, _, _, _) => .Allocate,
    .AVariant(_, _, _) => .Allocate,
    .AArrayLit(_) => .Allocate,
    .AMakeClosure(_, _) => .Allocate,
    .AIf(_, then_e, else_e) => if expr_is_pure_with_semantics(then_e, semantics)
      and expr_is_pure_with_semantics(else_e, semantics) {
      .Pure
    } else {
      .Control
    },
    .AMatch(_, arms) => {
      for arm in arms {
        if !expr_is_pure_with_semantics(arm.body, semantics) {
          return .Control
        }
      }

      .Pure
    },
    .ACall(.AGlobalFunc(func_id), _) => case semantics.call_info(func_id) {
      .Some(info) => info.effect,
      .None => .Control,
    },
    .ACall(_, _) => .Control,
    .AAssign(_, _) => .Control,
    .AGlobalSet(_, _) => .Control,
    .ALoop(_) => .Control,
    .AIndex(_, _, _, _) => .Control,
    .ADefer(_) => .Control,
    .AWrapAnyref(_, _) => .Control,
    .AUnwrapAnyref(_, _) => .Control,
  }
}

pub fn op_has_fresh_result(op: AnfOp, semantics: OptimizerSemantics) Bool {
  case op {
    .AArrayLit(_) => true,
    .ARecord(_, _) => true,
    .ARecordUpdate(_, _, _, _, _) => true,
    .AVariant(_, _, _) => true,
    .ACall(.AGlobalFunc(func_id), _) => case semantics.call_info(func_id) {
      .Some(info) => info.fresh_result,
      .None => false,
    },
    _ => false,
  }
}

pub fn reusable_update_site(op: AnfOp, semantics: OptimizerSemantics) ReusableUpdateSite? {
  case op {
    .ARecordUpdate(.ALocal(base), _, _, _, _) => .Some(
      ReusableUpdateSite.{ kind: .RecordUpdate, base_local: base, in_place_equivalent: .None },
    ),
    .ACall(.AGlobalFunc(func_id), args) => case semantics.call_info(func_id) {
      .Some(info) => case info.cow_base_arg {
        .Some(base_arg) => {
          if base_arg >= args.len() {
            return .None
          }

          case args[base_arg] {
            .ALocal(base) => .Some(
              ReusableUpdateSite.{
                kind: .Call,
                base_local: base,
                in_place_equivalent: info.in_place_equivalent,
              },
            ),
            _ => .None,
          }
        },
        .None => .None,
      },
      .None => .None,
    },
    _ => .None,
  }
}

pub fn is_pure_with_semantics(op: AnfOp, semantics: OptimizerSemantics) Bool {
  case op {
    // Stage 1 parity: even read-only/allocating calls remain non-eliminable.
    .ACall(_, _) => false,
    .AIf(_, then_e, else_e) => expr_is_pure_with_semantics(then_e, semantics)
      and expr_is_pure_with_semantics(else_e, semantics),
    .AMatch(_, arms) => {
      for arm in arms {
        if !expr_is_pure_with_semantics(arm.body, semantics) {
          return false
        }
      }

      true
    },
    _ => case op_effect(op, semantics) {
      .Pure => true,
      .Allocate => true,
      _ => false,
    },
  }
}

fn expr_is_pure_with_semantics(expr: AnfExpr, semantics: OptimizerSemantics) Bool {
  case expr {
    .Let(_, op, body) => is_pure_with_semantics(op, semantics)
      and expr_is_pure_with_semantics(body, semantics),
    .Atom(_) => true,
    .Return(_) => false,
    .Break(_) => false,
    .Continue => false,
  }
}
