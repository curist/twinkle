//! Human-facing rationale for each `twk lint` rule, keyed by its kebab `rule`
//! id. `brief` is the one-line header summary; `detailed` is the full rationale
//! shown under `--explain`, authored as a Zig-style multi-line literal.

pub type RuleInfo = .{ brief: String, detailed: String }

pub fn describe(rule: String) RuleInfo? {
  case rule {
    "direct-rebinding" => .Some(
      .{
        brief: "the temporary only aliases a value; rebind the field/index path directly",
        detailed:
          \\A temporary that only aliases a value, gets rebinding-updates applied,
          \\then is copied back or returned is just ceremony. Twinkle assignment is
          \\rebinding, so the field/index path can be updated in place:
          \\
          \\    // Avoid
          \\    d := reg.by_name
          \\    d[internal] = entry
          \\    reg.by_name = d
          \\
          \\    // Prefer
          \\    reg.by_name[internal] = entry
        ,
      },
    ),
    "record-copy-helper" => .Some(
      .{
        brief: "rebuilds a record by copying fields; rebind the changed field directly",
        detailed:
          \\A function that returns a record literal reconstructing a parameter of
          \\the same type — copying its fields verbatim, or updating a field from
          \\its own prior value — is a `with_*` helper. Rebind the field you mean
          \\instead:
          \\
          \\    // Avoid
          \\    fn with_docs(s: State, docs: Store) State {
          \\      .{ initialized: s.initialized, docs, cache: s.cache }
          \\    }
          \\    fn set(m: BlockMap, k: Int, v: Int) BlockMap {
          \\      BlockMap.{ inner: m.inner.set(k, v) }
          \\    }
          \\
          \\    // Prefer
          \\    s.docs = new_store
          \\    // and, for the copy-with-update:
          \\    m.inner = .set(k, v)
          \\    m
        ,
      },
    ),
    "inline-record-copy" => .Some(
      .{
        brief: "an inline binding rebuilds a value by copying most of its fields; rebind the source",
        detailed:
          \\A local binding whose record literal copies a majority of its fields
          \\verbatim from one source is just that source with a few fields changed.
          \\Reconstructing it by hand is a hazard: every future field of the type
          \\must be threaded through, and a forgotten one is a silent bug. Records
          \\are immutable and assignment is rebinding, so rebind the source instead:
          \\
          \\    // Avoid
          \\    loop_ctx := Ctx.{ a: ctx.a, b: ctx.b, depth: ctx.depth + 1 }
          \\
          \\    // Prefer
          \\    ctx.depth = ctx.depth + 1
          \\
          \\Self-rebinds (`st = St.{…st…}`) are auto-fixable with
          \\`twk lint --fix-inline-record-copy`.
        ,
      },
    ),
    "redundant-record-prefix" => .Some(
      .{
        brief: "a named record literal in a known-type position can drop its type prefix",
        detailed:
          \\A `TypeName.{ … }` literal sitting where the expected record type is
          \\already known — an annotated binding, a declared return position, a
          \\record field, or a call argument — can drop its prefix for the
          \\contextual anonymous form:
          \\
          \\    // Avoid
          \\    cfg: Config = Config.{ a: 1, b: 2 }
          \\    fn make() Config { Config.{ a: 1, b: 2 } }
          \\
          \\    // Prefer
          \\    cfg: Config = .{ a: 1, b: 2 }
          \\    fn make() Config { .{ a: 1, b: 2 } }
        ,
      },
    ),
    "constant-fn" => .Some(
      .{
        brief: "a nullary function returning only a constant should be a module constant",
        detailed:
          \\A zero-argument function whose whole body is a single constant literal is
          \\a module constant wearing a function costume. Declare it as a constant
          \\(`name := lit`) and drop the `()` at call sites.
          \\
          \\Auto-fixable with `twk lint --fix-constant-fn` ONLY when it is safe from
          \\a single-module view: the function is private (a `pub` one may have
          \\callers in other modules this pass cannot see), is never used as a value
          \\(only called), and its definition textually precedes every call site (a
          \\top-level `:=` constant is not forward-referenceable, unlike a hoisted
          \\`fn`). Otherwise the finding is report-only.
        ,
      },
    ),
    "unreachable-code" => .Some(
      .{
        brief: "code after a diverging statement never runs",
        detailed:
          \\A statement following `return`, `break`, `continue`, or `error(...)` in
          \\the same block can never execute. Usually a logic error: either the
          \\early exit is wrong, or the trailing code should move before it.
        ,
      },
    ),
    "unused-must-use" => .Some(
      .{
        brief: "a Result or Option is silently discarded",
        detailed:
          \\A statement-position `Result<_, _>` or `T?` that is neither `try`-ed,
          \\matched, nor bound drops a possible error or `None`. Handle it with
          \\`try`, `case`, `.ok_or(...)`, or bind it explicitly.
        ,
      },
    ),
    "unused-imports" => .Some(
      .{
        brief: "an imported name is never used",
        detailed:
          \\This `use` brings in a name nothing references. Remove it. Auto-fixable
          \\with `twk lint --fix-unused-imports`.
        ,
      },
    ),
    "inherent-calls" => .Some(
      .{
        brief: "a free-function call can use inherent-method syntax",
        detailed:
          \\When `M.f(x, ...)` resolves to the inherent method of `x`'s type, the
          \\receiver form reads better: `x.f(...)`. Auto-fixable with
          \\`twk lint --fix-inherent-calls`.
          \\
          \\    // Avoid            // Prefer
          \\    Vector.map(xs, f)   xs.map(f)
        ,
      },
    ),
    "redundant-print-stringify" => .Some(
      .{
        brief: "print/error sinks accept Stringify values directly; skip explicit stringification",
        detailed:
          \\The print/error sink family is generic over `T: Stringify`, so wrapping
          \\a value in a one-hole interpolation or calling `.to_string()` before
          \\printing is redundant ceremony. Prefer `println(foo)` over interpolating
          \\only `foo`, and `eprintln(err)` over `eprintln(err.to_string())`.
          \\
          \\The rule only auto-fixes whole-argument stringification; formatted
          \\messages (interpolations with surrounding text) are left untouched.
        ,
      },
    ),
    "prefer-multiline-string" => .Some(
      .{
        brief: "a multi-line string built by chaining `.concat` string literals should use a `\\\\` literal",
        detailed:
          \\Building a multi-line constant by chaining `.concat` over string
          \\literals (each ending in `\n`) reads worse than a `\\` multi-line
          \\string literal: the `\\` form is raw (no `\n`/`\"` escaping) with one
          \\source line per logical line. The rule fires only on a fully-constant
          \\chain of >=2 links whose value spans lines, so runtime string building
          \\(a computed receiver or argument) never matches. It also skips values a
          \\`\\` line cannot carry unchanged — a dollar-brace interpolation (a `\\`
          \\line still interpolates), a tab, or a CR. Auto-fixable with
          \\`twk lint --fix-prefer-multiline-string`.
          \\
          \\    // Avoid
          \\    "type P = .{ x: Int }\n".concat("fn f() Int { 1 }\n")
          \\    // Prefer
          \\    \\type P = .{ x: Int }
          \\    \\fn f() Int { 1 }
        ,
      },
    ),
    "prefer-case-dispatch" => .Some(
      .{
        brief: "use `case` for equality dispatch over one value",
        detailed:
          \\A `cond` is best for ordered predicate checks such as ranges,
          \\thresholds, and mixed boolean conditions. When every arm compares the
          \\same value to a literal or variant, `case` says the same thing with
          \\less ceremony and lets the reader see the dispatch key once:
          \\
          \\    // Avoid
          \\    cond {
          \\      method_name == "len" => len_doc,
          \\      method_name == "at" => at_doc,
          \\      _ => .None,
          \\    }
          \\
          \\    // Prefer
          \\    case method_name {
          \\      "len" => len_doc,
          \\      "at" => at_doc,
          \\      _ => .None,
          \\    }
          \\
          \\The auto-fix only applies when the `cond` has an explicit default
          \\arm. A no-default `cond` in statement position falls through as
          \\`Void` when no predicate matches, while a no-default `case` traps
          \\on an unmatched value, so no-default conds are intentionally left
          \\alone to preserve source meaning.
        ,
      },
    ),
    "prefer-cond" => .Some(
      .{
        brief: "use `cond` for a multi-way `if`/`else if`/`else` chain",
        detailed:
          \\A chain of `if`/`else if` branches ending in `else` is a multi-way
          \\conditional written the long way. `cond` lists the branches as flat
          \\arms sharing one `=>` column, so the reader sees the alternatives at a
          \\glance instead of unwinding nested `else if` blocks:
          \\
          \\    // Avoid
          \\    if c >= '0' and c <= '9' {
          \\      .Some(c - '0')
          \\    } else if c >= 'a' and c <= 'f' {
          \\      .Some(c - 'a' + 10)
          \\    } else {
          \\      .None
          \\    }
          \\
          \\    // Prefer
          \\    cond {
          \\      c >= '0' and c <= '9' => .Some(c - '0'),
          \\      c >= 'a' and c <= 'f' => .Some(c - 'a' + 10),
          \\      _ => .None,
          \\    }
          \\
          \\The rewrite only fires on a value-dispatch chain: it must end in a
          \\plain `else` (so the `cond` is total, with a `_` arm), have at least
          \\one `else if` (a 3+ arm `cond`), and every branch must be a single
          \\value expression. A two-way `if`/`else`, an `if` without a final
          \\`else`, and imperative chains — branches with multiple statements or
          \\an early `break`/`return` — are left alone, since those read fine as
          \\`if`/`else if` and would not be pure `cond` arms.
        ,
      },
    ),
    _ => .None,
  }
}
