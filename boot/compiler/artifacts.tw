//! Shared pipeline artifact types.
//!
//! Extracted from pipeline.tw to break circular imports between
//! pipeline.tw and module_compiler.tw.

use compiler.anf.{AnfModule}
use compiler.builtins.{BuiltinRegistry}
use compiler.core_ir.{CoreModule}
use compiler.query.analyze.{AnalysisDiag}
use compiler.resolver.{ResolvedEnv}

/// Diagnostics payload bundled with the env needed to resolve type names.
pub type DiagnosticsError = .{ diagnostics: Vector<AnalysisDiag>, env: ResolvedEnv }

/// Structured compile error returned from the compiler library.
/// CLI commands format these for display; tooling can inspect them directly.
pub type CompileError = { Diagnostics(DiagnosticsError), Internal(String) }

// A source file referenced by the compiled program, carried with its full text
// through the codegen pipeline (unlike `lib.debug.section.FileEntry`, which is
// source-less). Codegen precomputes line/col from this and drops the source
// text before it reaches the emitted `twinkle.debug` section.
pub type DebugFile = .{ file_id: Int, path: String, source: String }

pub type PipelineArtifacts = .{
  env: ResolvedEnv,
  builtins: BuiltinRegistry,
  core: CoreModule,
  mono: CoreModule,
  anf: AnfModule,
  opt: AnfModule,
  warnings: Vector<AnalysisDiag>,
  // Absolute project root, so downstream consumers (e.g. the renderer) can
  // resolve `debug_files` paths without re-deriving it.
  project_root: String,
  // File table (file_id -> path + source) threaded to codegen for the
  // twinkle.debug section.
  debug_files: Vector<DebugFile>,
}
