use @std.buffer.{Buffer}

use compiler.artifacts.{CompileError, PipelineArtifacts}
use compiler.base_env.{builtin_env}
use compiler.builtins.{make_builtin_registry}
use compiler.codegen.codegen.{codegen, codegen_wasm, codegen_wasm_buffer}
use compiler.imports
use compiler.module_compiler
use compiler.query.analyze
use compiler.query.cache as query_cache
use compiler.query.diag_render
use compiler.resolver.{ResolvedEnv}
use lib.module.loader
use lib.source.diagnostics as diag
use lib.source.identity
use lib.source.overlay
use lib.source.registry
use lib.source.render
use lib.source.report

/// Compile a source string through the full pipeline.
///
/// Uses the same analyze_module path as compile_entry, with an overlay-backed
/// virtual source so the real pipeline is exercised even in tests.
pub fn compile_source(src: String) Result<PipelineArtifacts, String> {
  compile_source_impl(src, false)
}

/// Like `compile_source`, but treats the virtual entry module as a `--lib`
/// build: its eligible `pub` surface is selected into `anf.lib_exports` and any
/// ineligible members are reported through `warnings`.
pub fn compile_source_lib(src: String) Result<PipelineArtifacts, String> {
  compile_source_impl(src, true)
}

fn compile_source_impl(src: String, lib_build: Bool) Result<PipelineArtifacts, String> {
  virtual_path := "/__virtual__/input.tw"
  virtual_id := identity.from_path(virtual_path)

  // Put the source in an overlay so analyze_module finds it without disk access.
  ov := overlay
    .empty()
    .put(overlay.OverlayDocument.{ identity: virtual_id, text: src, version: .None })
  builtins := make_builtin_registry()
  base_env := builtin_env()
  project_root := loader.find_project_root(".")

  // Phase 1: Frontend analysis (parse → resolve → typecheck)
  a_state := analyze.new_state(base_env, query_cache.empty(), ov, project_root)
  a_result := analyze.analyze_module(virtual_id, base_env, a_state)

  if !a_result.ok {
    return .Err(format_analysis_diags_inline(a_result.env, src, a_result.diagnostics))
  }

  canonical := imports.canonical_module_path(virtual_path, a_result.state.canonical_roots)
  graph := module_compiler.compile_analyzed_graph(
    canonical,
    a_result.env,
    a_result.state,
    builtins,
    lib_build,
    a_result.diagnostics,
    .{ enabled: false, modules_start: 0.0 },
  )

  case graph {
    .Ok(result) => .Ok(result.artifacts),
    .Err(err) => case err {
      .LowerDiagnostics(diags) => .Err(format_lower_diags_inline(a_result.env, src, diags)),
      .Internal(msg) => if msg.starts_with("internal:") {
        .Err(msg)
      } else {
        .Err("internal: ${msg}")
      },
    },
  }
}

/// Format analysis diagnostics using the in-memory source (for virtual paths).
fn format_analysis_diags_inline(env: ResolvedEnv, src: String, diags: Vector<analyze.AnalysisDiag>) String {
  if diags.len() == 0 {
    return "compilation failed"
  }

  parts: Vector<String> = []

  for d in diags {
    parts = .append(format_analysis_diag_inline(env, src, d))
  }

  parts.join("\n")
}

fn format_analysis_diag_inline(env: ResolvedEnv, src: String, d: analyze.AnalysisDiag) String {
  reg := registry.empty()
  config := report.default_config()
  ctx := diag_render.RenderCtx.{
    registry: reg,
    env: .Some(env),
    module: .None,
    config,
    type_names: .Some(d.type_names),
  }
  rep := diag_render.to_report(d.kind, ctx)
  fid := case report.primary_file_id(rep) {
    .Some(id) => id,
    .None => 0,
  }
  registry.add_file_with_id(reg, fid, "<input>", src)
  render.render(rep, reg, config)
}

fn format_lower_diags_inline(env: ResolvedEnv, src: String, diags: Vector<analyze.AnalysisDiag>) String {
  kinds: Vector<diag.DiagKind> = []

  for d in diags {
    kinds = .append(d.kind)
  }

  format_diags_inline(env, src, kinds)
}

fn format_diags_inline(env: ResolvedEnv, src: String, diags: Vector<diag.DiagKind>) String {
  if diags.len() == 0 {
    return "compilation failed"
  }

  reg := registry.empty()
  config := report.default_config()
  parts: Vector<String> = []

  for d in diags {
    ctx := diag_render.RenderCtx.{
      registry: reg,
      env: .Some(env),
      module: .None,
      config,
      type_names: .None,
    }
    rep := diag_render.to_report(d, ctx)
    fid := case report.primary_file_id(rep) {
      .Some(id) => id,
      .None => 0,
    }
    registry.add_file_with_id(reg, fid, "<input>", src)
    parts = .append(render.render(rep, reg, config))
  }

  parts.join("\n\n")
}

pub fn compile_entry_path(path: String) Result<PipelineArtifacts, CompileError> {
  module_compiler.compile_entry(path)
}

pub fn compile_entry_path_lib(path: String) Result<PipelineArtifacts, CompileError> {
  module_compiler.compile_entry_lib(path)
}

pub fn compile_path(path: String) Result<PipelineArtifacts, CompileError> {
  compile_entry_path(path)
}

pub fn emit_wat(artifacts: PipelineArtifacts) String {
  codegen(artifacts.opt, artifacts.env, artifacts.builtins)
}

pub fn emit_wasm(artifacts: PipelineArtifacts) Vector<Byte> {
  codegen_wasm(
    artifacts.opt,
    artifacts.env,
    artifacts.builtins,
    artifacts.debug_files,
    artifacts.strip_debug,
  )
}

pub fn emit_wasm_buffer(artifacts: PipelineArtifacts) Buffer {
  codegen_wasm_buffer(
    artifacts.opt,
    artifacts.env,
    artifacts.builtins,
    artifacts.debug_files,
    artifacts.strip_debug,
  )
}
