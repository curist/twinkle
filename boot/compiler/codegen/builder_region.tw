//! ANF-to-ANF builder-region rewrite.
//!
//! Turns a certified accumulator-fold loop (produced by the pure-ANF detector in
//! `builder_region_detect.tw`) into transient-builder calls: the persistent
//! `acc = acc.concat(chunk)` / `acc = acc.append(x)` fold becomes
//!   builder := builder_from(acc)   // string: from(""); vector: builder_new()
//!   loop { ... builder_push(builder, chunk) ... }
//!   acc := freeze(builder)
//! This module is a pure transform over `AnfModule`, run at the top of
//! `link_program` (producing ANF' consumed by closure conversion and the call-swap
//! producer). Every step is sound-by-abandonment: if the recorded seed/loop shape
//! cannot be matched cleanly, or the rewritten push count does not equal the
//! recorded fold count, the region is left persistent.

use compiler.anf.{AnfExpr, AnfFunctionDef, AnfMatchArm, AnfModule, AnfOp}
use compiler.builder_family.{BuilderConfig, string_builder_config, vector_builder_config}
use compiler.builder_region_detect.{fold_chunk}
use compiler.builtins.{BuiltinRegistry}
use compiler.codegen.builder_region_produce
use compiler.codegen.builder_region_produce.{BuilderRegionDecision, BuilderRegionDecisionTable}
use compiler.core_ir.{FuncId, LocalId}
use compiler.mono_type.{MonoType}

// ── Region representation (ported from the deleted opt/builder_region.tw) ──
type BuilderInit = { New, FromBase(LocalId) }

type BuilderRegion = .{
  bind_local: LocalId,
  base_local: LocalId,
  builder_local: LocalId,
  freeze_local: LocalId,
  assign_local: LocalId,
  init: BuilderInit,
  loop_body: AnfExpr,
  cont: AnfExpr,
}

fn builder_init_call(init: BuilderInit, builder: BuilderConfig) AnfOp {
  case init {
    .New => .ACall(.AGlobalFunc(builder.builder_new_id), []),
    .FromBase(base) => .ACall(.AGlobalFunc(builder.builder_from_id), [.ALocal(base)]),
  }
}

fn lower_builder_region(region: BuilderRegion, builder: BuilderConfig) AnfExpr {
  AnfExpr.Let(
    region.builder_local,
    region.init.builder_init_call(builder),
    AnfExpr.Let(
      region.bind_local,
      .ALoop(region.loop_body),
      AnfExpr.Let(
        region.freeze_local,
        .ACall(.AGlobalFunc(builder.builder_freeze_id), [.ALocal(region.builder_local)]),
        AnfExpr.Let(
          region.assign_local,
          .AAssign(region.base_local, .ALocal(region.freeze_local)),
          region.cont,
        ),
      ),
    ),
  )
}

// ── Loop-body rewrite (ported from the deleted opt/loop_builder.tw) ──
// The fold-recognition (`fold_chunk`) is imported from `builder_region_detect`,
// so the rewrite transforms exactly the shape the detector certified — one source
// of truth, no drift when the fold shape evolves (Plans 3/5).
fn rewrite_loop_expr(
  expr: AnfExpr,
  base: LocalId,
  builder: LocalId,
  push_id: FuncId,
  builder_push_id: FuncId,
) AnfExpr {
  case expr {
    .Let(local, op, body) => {
      case fold_chunk(op, body, base, push_id, local) {
        .Some(elem) => {
          new_op := AnfOp.ACall(.AGlobalFunc(builder_push_id), [.ALocal(builder), elem])

          case body {
            .Let(assign_local, _, rest) => {
              new_assign := AnfOp.AInit(.ALitVoid)
              return AnfExpr.Let(
                local,
                new_op,
                AnfExpr.Let(
                  assign_local,
                  new_assign,
                  rewrite_loop_expr(rest, base, builder, push_id, builder_push_id),
                ),
              )
            },
            _ => {},
          }
        },
        .None => {},
      }

      new_op := rewrite_loop_op_subexpr(op, base, builder, push_id, builder_push_id)
      AnfExpr.Let(local, new_op, rewrite_loop_expr(body, base, builder, push_id, builder_push_id))
    },
    _ => expr,
  }
}

fn rewrite_loop_op_subexpr(
  op: AnfOp,
  base: LocalId,
  builder: LocalId,
  push_id: FuncId,
  builder_push_id: FuncId,
) AnfOp {
  case op {
    .AIf(cond_e, then_e, else_e) => AnfOp.AIf(
      cond_e,
      rewrite_loop_expr(then_e, base, builder, push_id, builder_push_id),
      rewrite_loop_expr(else_e, base, builder, push_id, builder_push_id),
    ),
    .AMatch(scrutinee, arms) => {
      new_arms: Vector<AnfMatchArm> = collect arm in arms {
        AnfMatchArm.{
          pattern: arm.pattern,
          body: rewrite_loop_expr(arm.body, base, builder, push_id, builder_push_id),
        }
      }
      AnfOp.AMatch(scrutinee, new_arms)
    },
    .ALoop(body) => AnfOp.ALoop(rewrite_loop_expr(body, base, builder, push_id, builder_push_id)),
    .ADefer(body) => AnfOp.ADefer(rewrite_loop_expr(body, base, builder, push_id, builder_push_id)),
    _ => op,
  }
}

// ── Call-site counter (coverage guard) ──
fn count_global_call_sites(expr: AnfExpr, target: FuncId) Int {
  case expr {
    .Let(_, op, body) => count_op_call_sites(op, target) + count_global_call_sites(body, target),
    _ => 0,
  }
}

fn count_op_call_sites(op: AnfOp, target: FuncId) Int {
  case op {
    .ACall(callee, _) => case callee {
      .AGlobalFunc(f) => if f.id == target.id {
        1
      } else {
        0
      },
      _ => 0,
    },
    .AIf(_, t, e) => count_global_call_sites(t, target) + count_global_call_sites(e, target),
    .AMatch(_, arms) => {
      n := 0
      for arm in arms {
        n = n + count_global_call_sites(arm.body, target)
      }
      n
    },
    .ALoop(b) => count_global_call_sites(b, target),
    .ADefer(b) => count_global_call_sites(b, target),
    _ => 0,
  }
}

// ── Driver ──
fn config_for(family: String, b: BuiltinRegistry) BuilderConfig {
  if family == "string" {
    string_builder_config(b)
  } else {
    vector_builder_config(b)
  }
}

// Splice within the seed's continuation: skip unrelated Lets on the spine until
// the recorded loop_site Let is reached, then replace it with the lowered builder
// region. Mirrors `find_region`'s skip-unrelated traversal. `.None` abandons.
fn splice_loop(
  expr: AnfExpr,
  base: LocalId,
  loop_site: LocalId,
  init: BuilderInit,
  builder: BuilderConfig,
  push_id: FuncId,
  builder_local: LocalId,
  freeze_local: LocalId,
  assign_local: LocalId,
  fold_count: Int,
) AnfExpr? {
  case expr {
    .Let(local, op, body) => if local.id == loop_site.id {
      case op {
        .ALoop(loop_body) => {
          rewritten := rewrite_loop_expr(
            loop_body,
            base,
            builder_local,
            push_id,
            builder.builder_push_id,
          )

          // Coverage guard: rewritten push count must match the recorded folds.
          if count_global_call_sites(rewritten, builder.builder_push_id) != fold_count {
            return .None
          }
          region := BuilderRegion.{
            bind_local: local,
            base_local: base,
            builder_local,
            freeze_local,
            assign_local,
            init,
            loop_body: rewritten,
            cont: body,
          }
          .Some(region.lower_builder_region(builder))
        },
        _ => .None,
      }
    } else {
      case splice_loop(
        body,
        base,
        loop_site,
        init,
        builder,
        push_id,
        builder_local,
        freeze_local,
        assign_local,
        fold_count,
      ) {
        .Some(nb) => .Some(AnfExpr.Let(local, op, nb)),
        .None => .None,
      }
    },
    _ => .None,
  }
}

// Walk the function-body spine for the seed Let (binds `base`), leaving it in
// place and splicing the loop within its continuation. `.None` abandons.
fn splice_seed(
  expr: AnfExpr,
  base: LocalId,
  loop_site: LocalId,
  init: BuilderInit,
  builder: BuilderConfig,
  push_id: FuncId,
  builder_local: LocalId,
  freeze_local: LocalId,
  assign_local: LocalId,
  fold_count: Int,
) AnfExpr? {
  case expr {
    .Let(local, op, body) => if local.id == base.id {
      case splice_loop(
        body,
        base,
        loop_site,
        init,
        builder,
        push_id,
        builder_local,
        freeze_local,
        assign_local,
        fold_count,
      ) {
        .Some(nb) => .Some(AnfExpr.Let(local, op, nb)),
        .None => .None,
      }
    } else {
      case splice_seed(
        body,
        base,
        loop_site,
        init,
        builder,
        push_id,
        builder_local,
        freeze_local,
        assign_local,
        fold_count,
      ) {
        .Some(nb) => .Some(AnfExpr.Let(local, op, nb)),
        .None => .None,
      }
    },
    _ => .None,
  }
}

// Rewrite a single region from its decision record. The record carries
// PRE-ALLOCATED fresh locals (builder/freeze/assign) and the naming boundaries;
// this re-validates the recorded shape STRUCTURALLY via `splice_seed` (the
// recorded seed/loop must still match the ANF) plus the coverage guard
// (rewritten push count == recorded fold count). Any mismatch — including a
// missing accumulator mono — leaves `f` unchanged (persistent fallback).
fn rewrite_one_decision(f: AnfFunctionDef, d: BuilderRegionDecision, b: BuiltinRegistry) AnfFunctionDef {
  case f.op_result_mono.get(d.accumulator.id) {
    .Some(base_mono) => {
      // `builder.push_id` is provably identical to the detector's stored
      // `push_id`: both come from `string_builder_config(b)`/
      // `vector_builder_config(b).push_id` for the same family + registry, so
      // the decision record need not carry it.
      builder := config_for(d.family, b)
      init: BuilderInit = if d.family == "string" {
        .FromBase(d.accumulator)
      } else {
        .New
      }
      case splice_seed(
        f.body,
        d.accumulator,
        d.loop_site,
        init,
        builder,
        builder.push_id,
        d.builder_local,
        d.freeze_local,
        d.assign_local,
        d.fold_sites.len(),
      ) {
        .Some(new_body) => {
          om := f.op_result_mono
          om[d.builder_local.id] = base_mono
          om[d.freeze_local.id] = base_mono
          om[d.assign_local.id] = MonoType.Void
          AnfFunctionDef.{
            func_id: f.func_id,
            name: f.name,
            is_init: f.is_init,
            params: f.params,
            op_result_mono: om,
            body: new_body,
            return_ty: f.return_ty,
          }
        },
        .None => f,
      }
    },
    .None => f,
  }
}

// Look up the decisions recorded for `func_id`; the empty default means a
// function with no certified region is returned untouched.
pub fn decisions_for_func(table: BuilderRegionDecisionTable, func_id: FuncId) Vector<
  BuilderRegionDecision,
> {
  case table.by_func.get(func_id.id) {
    .Some(ds) => ds,
    .None => [],
  }
}

// Apply every recorded region for `f` in turn. The decisions carry distinct
// pre-allocated locals (allocated once from the ORIGINAL `f`), so no counter is
// bumped here and independent regions cannot collide.
pub fn rewrite_func_with_decisions(
  f: AnfFunctionDef,
  decisions: Vector<BuilderRegionDecision>,
  b: BuiltinRegistry,
) AnfFunctionDef {
  cur := f
  for d in decisions {
    cur = rewrite_one_decision(cur, d, b)
  }
  cur
}

pub fn rewrite_module(m: AnfModule, b: BuiltinRegistry) AnfModule {
  table := builder_region_produce.produce_builder_region_decisions(m, b)
  result := m
  result.functions = collect f in m.functions {
    rewrite_func_with_decisions(f, decisions_for_func(table, f.func_id), b)
  }
  result
}
