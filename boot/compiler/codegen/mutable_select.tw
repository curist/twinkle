//! Central mutable-codegen decision selector for Codegen Phase 7C/7D.
//!
//! This module owns the decision/fallback contract. It does not prove ownership
//! and never changes emitted code in Phase 7C/7D. Phase 8A introduces
//! `MutableEmitPolicy`, letting a caller opt specific call-site families
//! (starting with VectorSet) into actually emitting their mutable target
//! instead of always falling back to persistent.

use compiler.core_ir.{FuncId, LocalId}
use compiler.variant_id as own_variant

pub type OperationFamily = {
  VectorSet,
  DictSet,
  DictRemove,
  RecordShellUpdate,
  VectorBuilderRegion,
  StringBuilderRegion,
  FunctionVariant,
  RecordBackedFieldCollection,
}

pub type Site = .{ func: FuncId, local: LocalId }

pub type MutableDecision = .{
  site: Site,
  family: OperationFamily,
  source_local: LocalId,
  result_local: LocalId,
  arg_count: Int,
  base_arg_index: Int?,
  persistent_func: FuncId?,
  mutable_func: FuncId?,
  variant_key: own_variant.VariantId?,
  field_path_key: String,
  proof_debug_id: String,
}

pub type MutableDecisionTable = .{ by_site: Dict<Int, Vector<MutableDecision>> }

pub type SelectionReason = {
  Absent,
  MutableAvailableNotEmitted,
  WrongFamily,
  WrongPersistentTarget,
  MissingMutableTarget,
  SourceLocalMismatch,
  ResultLocalMismatch,
  ArgumentShapeMismatch,
  BaseArgMismatch,
  FieldPathMismatch,
  Ambiguous,
  UnsupportedFamily,
  MutableSelected,
  PolicyDisabled,
}

pub type CallSelection = .{ emit_func: FuncId, would_func: FuncId, reason: SelectionReason }

pub type RecordReuseSelection = .{
  emit_can_reuse: Bool,
  would_reuse: Bool,
  reason: SelectionReason,
}

pub fn selection_reason_tag(r: SelectionReason) Int {
  case r {
    .Absent => 0,
    .MutableAvailableNotEmitted => 1,
    .WrongFamily => 2,
    .WrongPersistentTarget => 3,
    .MissingMutableTarget => 4,
    .SourceLocalMismatch => 5,
    .ResultLocalMismatch => 6,
    .ArgumentShapeMismatch => 7,
    .BaseArgMismatch => 8,
    .FieldPathMismatch => 9,
    .Ambiguous => 10,
    .UnsupportedFamily => 11,
    .MutableSelected => 12,
    .PolicyDisabled => 13,
  }
}

pub fn record_reason_tag(r: SelectionReason) Int {
  r.selection_reason_tag()
}

pub fn site_key(site: Site) Int {
  own_variant.site_key(site.func.id, site.local.id)
}

pub fn empty_decision_table() MutableDecisionTable {
  MutableDecisionTable.{ by_site: Dict.new() }
}

pub fn with_decision(self: MutableDecisionTable, d: MutableDecision) MutableDecisionTable {
  key := d.site.site_key()
  existing := case self.by_site.get(key) {
    .Some(v) => v,
    .None => [],
  }
  self.by_site[key] = existing.append(d)
  self
}

// Families this Phase 7D selector recognizes for call-site (VectorSet/DictSet/
// DictRemove) selection. Any other family is UnsupportedFamily.
pub fn is_supported_call_family(family: OperationFamily) Bool {
  case family {
    .VectorSet => true,
    .DictSet => true,
    .DictRemove => true,
    _ => false,
  }
}

fn decisions_at(table: MutableDecisionTable, site: Site) Vector<MutableDecision> {
  case table.by_site.get(site.site_key()) {
    .Some(v) => v,
    .None => [],
  }
}

// Which call-site operation families Phase 8A is willing to actually emit as
// their mutable/in-place target, rather than the persistent one. Each family
// is gated independently so families can be enabled incrementally as their
// in-place proof obligations are established.
pub type MutableEmitPolicy = .{
  emit_vector_set: Bool,
  emit_dict_set: Bool,
  emit_dict_remove: Bool,
  // The record-shell mutable phase (8F): read by
  // select_record_update_with_policy to gate `struct.set` shell reuse.
  emit_record_shell_update: Bool,
}

// The Phase 7C/7D default: never emit a mutable target, regardless of what
// the decision table proved. Prepared modules default to this policy.
pub fn persistent_only_policy() MutableEmitPolicy {
  MutableEmitPolicy.{
    emit_vector_set: false,
    emit_dict_set: false,
    emit_dict_remove: false,
    emit_record_shell_update: false,
  }
}

// Phase 8A: enable mutable emission for vector element sets only; other
// families stay persistent until their own phases land.
pub fn phase8a_policy() MutableEmitPolicy {
  MutableEmitPolicy.{
    emit_vector_set: true,
    emit_dict_set: false,
    emit_dict_remove: false,
    emit_record_shell_update: false,
  }
}

// Phase 8F: enable mutable emission for record shell updates only; other
// families stay persistent. Used by the record selector's mechanism tests so
// they are independent of the cumulative build policy.
pub fn phase8f_policy() MutableEmitPolicy {
  MutableEmitPolicy.{
    emit_vector_set: false,
    emit_dict_set: false,
    emit_dict_remove: false,
    emit_record_shell_update: true,
  }
}

// The families the compiler actually emits mutably on the real build path.
// This is the single cumulative policy; it grows as each family's phase lands.
// Per-phase selector tests use the fixed fixtures (persistent_only_policy /
// phase8a_policy), not this cumulative one, so enabling a family here does not
// perturb those mechanism tests.
pub fn enabled_emit_policy() MutableEmitPolicy {
  MutableEmitPolicy.{
    emit_vector_set: true,
    emit_dict_set: true,
    emit_dict_remove: true,
    emit_record_shell_update: true,
  }
}

// pub: also consulted by wasm_plan_scan so a mutable target that emission
// might swap in (but that never literally appears as an ACall site in the
// prepared body) still gets its runtime import declared during planning.
pub fn policy_allows_call(policy: MutableEmitPolicy, family: OperationFamily) Bool {
  case family {
    .VectorSet => policy.emit_vector_set,
    .DictSet => policy.emit_dict_set,
    .DictRemove => policy.emit_dict_remove,
    _ => false,
  }
}

// Phase 7C/7D entry point: always selects under the persistent-only policy,
// so a live mutable target is reported (would_func) but never emitted
// (emit_func stays persistent). Callers that need policy-gated emission
// should use select_call_with_policy directly.
pub fn select_call(
  table: MutableDecisionTable,
  site: Site,
  expected_family: OperationFamily,
  persistent_fallback: FuncId,
  expected_base_arg_index: Int?,
  source_local: LocalId,
  result_local: LocalId,
  arg_count: Int,
) CallSelection {
  table.select_call_with_policy(
    site,
    expected_family,
    persistent_fallback,
    expected_base_arg_index,
    source_local,
    result_local,
    arg_count,
    persistent_only_policy(),
  )
}

pub fn select_call_with_policy(
  table: MutableDecisionTable,
  site: Site,
  expected_family: OperationFamily,
  persistent_fallback: FuncId,
  expected_base_arg_index: Int?,
  source_local: LocalId,
  result_local: LocalId,
  arg_count: Int,
  policy: MutableEmitPolicy,
) CallSelection {
  fallback := CallSelection.{
    emit_func: persistent_fallback,
    would_func: persistent_fallback,
    reason: .Absent,
  }
  ds := table.decisions_at(site)

  if ds.len() == 0 {
    return fallback
  }

  if ds.len() > 1 {
    return CallSelection.{
      emit_func: persistent_fallback,
      would_func: persistent_fallback,
      reason: .Ambiguous,
    }
  }

  if !expected_family.is_supported_call_family() {
    return CallSelection.{
      emit_func: persistent_fallback,
      would_func: persistent_fallback,
      reason: .UnsupportedFamily,
    }
  }

  d := ds[0]

  reject := fn(reason: SelectionReason) CallSelection { CallSelection.{
    emit_func: persistent_fallback,
    would_func: persistent_fallback,
    reason,
  } }

  if d.family != expected_family {
    return reject(.WrongFamily)
  }

  if d.source_local.id != source_local.id {
    return reject(.SourceLocalMismatch)
  }

  if d.result_local.id != result_local.id {
    return reject(.ResultLocalMismatch)
  }

  if d.arg_count != arg_count {
    return reject(.ArgumentShapeMismatch)
  }

  base_arg_matches := case d.base_arg_index {
    .Some(a) => case expected_base_arg_index {
      .Some(b) => a == b,
      .None => false,
    },
    .None => case expected_base_arg_index {
      .None => true,
      .Some(_) => false,
    },
  }

  if !base_arg_matches {
    return reject(.BaseArgMismatch)
  }

  persistent_matches := case d.persistent_func {
    .Some(pf) => pf.id == persistent_fallback.id,
    .None => false,
  }

  if !persistent_matches {
    return reject(.WrongPersistentTarget)
  }

  case d.mutable_func {
    .Some(mf) => if policy.policy_allows_call(expected_family) {
      CallSelection.{ emit_func: mf, would_func: mf, reason: .MutableSelected }
    } else {
      CallSelection.{ emit_func: persistent_fallback, would_func: mf, reason: .PolicyDisabled }
    },
    .None => reject(.MissingMutableTarget),
  }
}

// Phase 7C/7D entry point: selects under the persistent-only policy, so a valid
// record decision reports the would-be shell reuse (`would_reuse`) without
// emitting it (`emit_can_reuse` stays at the original). Callers that need
// policy-gated emission use select_record_update_with_policy directly.
pub fn select_record_update(
  table: MutableDecisionTable,
  site: Site,
  source_local: LocalId,
  result_local: LocalId,
  field_path_key: String,
  original_can_reuse: Bool,
) RecordReuseSelection {
  table.select_record_update_with_policy(
    site,
    source_local,
    result_local,
    field_path_key,
    original_can_reuse,
    persistent_only_policy(),
  )
}

pub fn select_record_update_with_policy(
  table: MutableDecisionTable,
  site: Site,
  source_local: LocalId,
  result_local: LocalId,
  field_path_key: String,
  original_can_reuse: Bool,
  policy: MutableEmitPolicy,
) RecordReuseSelection {
  fallback := RecordReuseSelection.{
    emit_can_reuse: original_can_reuse,
    would_reuse: false,
    reason: .Absent,
  }
  ds := table.decisions_at(site)

  if ds.len() == 0 {
    return fallback
  }

  if ds.len() > 1 {
    return RecordReuseSelection.{
      emit_can_reuse: original_can_reuse,
      would_reuse: false,
      reason: .Ambiguous,
    }
  }

  d := ds[0]

  reject := fn(reason: SelectionReason) RecordReuseSelection { RecordReuseSelection.{
    emit_can_reuse: original_can_reuse,
    would_reuse: false,
    reason,
  } }

  if d.family != OperationFamily.RecordShellUpdate {
    return reject(.WrongFamily)
  }

  if d.source_local.id != source_local.id {
    return reject(.SourceLocalMismatch)
  }

  if d.result_local.id != result_local.id {
    return reject(.ResultLocalMismatch)
  }

  if d.field_path_key != field_path_key {
    return reject(.FieldPathMismatch)
  }

  // Valid, well-formed record shell-update decision. Emit the in-place shell
  // reuse only when the policy enables the record family; otherwise report it as
  // available-but-not-emitted and keep the persistent copy.
  if policy.emit_record_shell_update {
    RecordReuseSelection.{ emit_can_reuse: true, would_reuse: true, reason: .MutableSelected }
  } else {
    RecordReuseSelection.{
      emit_can_reuse: original_can_reuse,
      would_reuse: true,
      reason: .MutableAvailableNotEmitted,
    }
  }
}
