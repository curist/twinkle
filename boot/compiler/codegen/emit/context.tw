//! Shared context types and lookup helpers for Wasm emission.

use compiler.backend.prepared_ir.{PreparedFunc, ReprKind, SlotId}
use compiler.builtins.{BuiltinRegistry}
use compiler.codegen.mutable_select
use compiler.codegen.wasm_ir.{ValType}
use compiler.codegen.wasm_layout.{val_type_of_mono}
use compiler.codegen.wasm_plan_types.{WasmTypeRegistry}
use compiler.core_ir.{ExternImport, FuncId, LocalId}
use compiler.mono_type.{MonoType}
use compiler.resolver.{ResolvedEnv}

pub type LocalEntry = .{
  index: Int,
  val_type: ValType,
  mono: MonoType,
  repr: ReprKind,
  source_local: LocalId,
}

pub type LabelPair = .{ break_label: String, continue_label: String }

// The expected shape of a value at an emit destination: its physical Wasm type
// (`.None` for a no-result position — Void/Never — where no coercion is emitted)
// and its mono, kept only as a hint for emit_coerce_stack instruction selection.
pub type Expected = .{ vt: ValType?, mono: MonoType }

// Build the mono-derived Expected. Never/Void carry no vt because
// val_type_of_mono(.Never) hard-errors; those positions are gated upstream by
// the existing .Void/.Never match arms in emit_expr/emit_atom_for_expected.
pub fn expected(mono: MonoType, env: ResolvedEnv) Expected {
  case mono {
    .Void => .{ vt: .None, mono },
    .Never => .{ vt: .None, mono },
    _ => .{ vt: .Some(val_type_of_mono(mono, env)), mono },
  }
}

// Typed tag for intrinsic dispatch — avoids string matching in emit_intrinsic_call.
pub type IntrinsicTag = {
  StringToString,
  VectorAppend,
  VectorGet,
  VectorSet,
  VectorMake,
  DictGet,
  DictGetUnsafe,
  StringGet,
  StringSlice,
  StringCharCodeAt,
  StringFromCharCode,
  StringFromByte,
  StringFromCodePoint,
  StringUtf8Bytes,
  StringFromUtf8,
  StringFromMem,
  ByteToInt,
  ByteFromInt,
  ByteToString,
  FloatBits,
  FloatSqrt,
  FloatAbs,
  FloatFloor,
  FloatCeil,
  FloatTrunc,
  FloatFromBits,
  FloatMin,
  FloatMax,
  FloatRound,
  TaskSpawn,
  TaskAwait,
  TaskYield,
  ChannelNew,
  ChannelBounded,
  ChannelSend,
  ChannelRecv,
  ChannelClose,
  CellNew,
  CellGet,
  CellSet,
  CellUpdate,
  RangeFrom,
  Range,
  RangeStep,
  IteratorNext,
  IteratorUnfold,
  IntFromString,
  FloatFromString,
}

pub type EmitCtx = .{
  registry: WasmTypeRegistry,
  builtins: BuiltinRegistry,
  env: ResolvedEnv,
  local_map: Dict<Int, LocalEntry>,
  next_local: Int,
  wasm_locals: Vector<ValType>,
  label_stack: Vector<LabelPair>,
  current_func_id: FuncId?,
  // The PreparedFunc currently being emitted, cached so per-atom type queries
  // (atom_mono/atom_repr/atom_val_type) don't re-fetch it from the whole-program
  // `prepared_funcs` HAMT on every call. Set once per function in emit_func and
  // threaded unchanged; `current_func_id` stays the authoritative identity.
  current_pf: PreparedFunc?,
  func_sym_map: Dict<Int, String>,
  prepared_funcs: Dict<Int, PreparedFunc>,
  extern_imports: Dict<Int, ExternImport>,
  is_init_func: Bool,
  loop_depth: Int,
  scratch_anyref_local: Int,
  intrinsic_table: Dict<Int, IntrinsicTag>,
  mutable_decisions: mutable_select.MutableDecisionTable,
}

pub fn current_prepared_func(ctx: EmitCtx) PreparedFunc? {
  ctx.current_pf
}

pub fn lookup_slot(ctx: EmitCtx, sid: SlotId) LocalEntry {
  case ctx.local_map[sid.id] {
    .Some(entry) => entry,
    .None => error("lookup_slot: unknown SlotId S${sid.id}"),
  }
}

pub fn lookup_func_sym(map: Dict<Int, String>, fid: FuncId) String {
  case map[fid.id] {
    .Some(sym) => sym,
    .None => error("lookup_func_sym: unknown FuncId ${fid.id}"),
  }
}
