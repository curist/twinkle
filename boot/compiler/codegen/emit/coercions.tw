//! Stack value coercion helpers for Wasm emission.

use compiler.codegen.emit.anyref.{emit_box_to_anyref, emit_unbox_from_anyref}
use compiler.codegen.emit.context.{EmitCtx}
use compiler.codegen.wasm_ir.{AbiContract, Instr, ValType}
use compiler.codegen.wasm_type_util.{heap_type_eq, val_type_eq}
use compiler.core_ir.{FuncId}
use compiler.elem_family.{ElemFamily, elem_family_of}
use compiler.mono_type.{MonoType}

pub fn emit_coerce_stack(
  from: ValType,
  to: ValType,
  mono: MonoType,
  ctx: EmitCtx,
  buf: Vector<Instr>,
) Vector<Instr> {
  if val_type_eq(from, to) {
    return buf
  }

  case from {
    .Ref(_, .Named(from_name)) => case to {
      .Ref(_, .Named(to_name)) => {
        // Typed <-> boxed Vector<T> representation boundary for every activated
        // primitive-element family. The typed PVec wrapper must be rebuilt as the
        // universal PVec (or vice versa); a raw ref.cast would trap because the
        // leaf array types differ.
        case elem_family_of(mono) {
          .Some(fam) => {
            if to_name == "rt_types__PVec" and from_name == fam.pvec_type {
              return buf.append(.Call(fam.box_call))
            }
            if from_name == "rt_types__PVec" and to_name == fam.pvec_type {
              return buf.append(.Call(fam.unbox_call))
            }
          },
          .None => {},
        }
      },
      _ => {},
    },
    _ => {},
  }

  case to {
    .Anyref => {
      // A typed PVec family value must be boxed to PVec before erasing to
      // anyref: a bare upcast of the distinct typed struct would trap on the
      // later cast back to PVec. Box first, then use the normal vector erase.
      pre := case from {
        .Ref(_, .Named(fname)) => case elem_family_of(mono) {
          .Some(fam) => if fname == fam.pvec_type {
            buf.append(.Call(fam.box_call))
          } else {
            buf
          },
          .None => buf,
        },
        _ => buf,
      }
      return emit_box_to_anyref(mono, ctx.backend, pre)
    },
    _ => {},
  }

  case from {
    .Anyref => {
      // Mirror of the typed-family egress above. When the destination is a
      // physically typed family PVec, unbox anyref to the boxed universal PVec
      // first, then rebuild the typed wrapper via fam.unbox_call — a bare
      // emit_unbox_from_anyref leaves a boxed rt_types__PVec where a
      // PVecI64/PVecBool is required, which would trap on the later use. The
      // guard (to_name == fam.pvec_type) leaves every non-typed destination on
      // the generic path unchanged.
      typed_dest: ElemFamily? = case to {
        .Ref(_, .Named(to_name)) => case elem_family_of(mono) {
          .Some(fam) => if to_name == fam.pvec_type {
            .Some(fam)
          } else {
            .None
          },
          .None => .None,
        },
        _ => .None,
      }

      case typed_dest {
        .Some(fam) => return emit_unbox_from_anyref(mono, ctx.backend, buf).append(
          .Call(fam.unbox_call),
        ),
        .None => return emit_unbox_from_anyref(mono, ctx.backend, buf),
      }
    },
    _ => {},
  }

  case from {
    .I32 => case to {
      .I64 => return buf.append(.I64ExtendI32S),
      _ => {},
    },
    .I64 => case to {
      .I32 => return buf.append(.I32WrapI64),
      _ => {},
    },
    .Ref(false, from_heap) => case to {
      .Ref(true, to_heap) => if heap_type_eq(from_heap, to_heap) {
        return buf
      },
      _ => {},
    },
    .Ref(true, from_heap) => case to {
      .Ref(false, to_heap) => if heap_type_eq(from_heap, to_heap) {
        return buf.append(.RefAsNonNull)
      },
      _ => {},
    },
    _ => {},
  }

  case from {
    .Ref(_, _) => case to {
      .Ref(nullable, heap) => return buf.append(.RefCast(nullable, heap)),
      _ => {},
    },
    _ => {},
  }

  buf
}

// Coerce a runtime call's ABI result to the destination slot's physical type
// (dest_vt), not the mono-derived type. When the destination slot is typed
// (e.g. PVecI64) and the runtime call already returns that physical type (a
// typed-vec result like gather_i64), this is a no-op — replacing the former
// name-based is_typed_vec_result box-skip.
pub fn adapt_runtime_result(fid: FuncId, dest_vt: ValType, result_mono: MonoType, ctx: EmitCtx) Vector<
  Instr,
> {
  abi_opt: AbiContract? = case ctx.builtins.by_id[fid.id] {
    .Some(entry) => .Some(entry.abi),
    .None => .None,
  }

  case abi_opt {
    .Some(abi) => if abi.result_types.len() == 1 {
      emit_coerce_stack(abi.result_types[0], dest_vt, result_mono, ctx, [])
    } else {
      []
    },
    .None => [],
  }
}
