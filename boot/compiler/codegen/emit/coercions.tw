//! Stack value coercion helpers for Wasm emission.

use compiler.codegen.emit.anyref.{emit_box_to_anyref, emit_unbox_from_anyref}
use compiler.codegen.emit.context.{EmitCtx}
use compiler.codegen.wasm_ir.{AbiContract, Instr, ValType}
use compiler.codegen.wasm_layout.{val_type_of_mono}
use compiler.codegen.wasm_type_util.{heap_type_eq, val_type_eq}
use compiler.core_ir.{FuncId}
use compiler.elem_family.{ElemFamily, family_by_pvec_name}
use compiler.mono_type.{MonoType}

pub fn emit_coerce_stack(
  from: ValType,
  to: ValType,
  mono: MonoType,
  ctx: EmitCtx,
  buf: Vector<Instr>,
) Vector<Instr> {
  if val_type_eq(from, to) {
    return buf
  }

  case from {
    .Ref(_, .Named(from_name)) => case to {
      .Ref(_, .Named(to_name)) => {
        // Typed <-> boxed Vector<Int> representation boundary. box_i64 boxes a
        // typed PVecI64 to the universal PVec; unbox_i64 rebuilds a typed
        // PVecI64 from a boxed PVec (e.g. a universal-helper result). A raw cast
        // either way would trap: the leaf array types differ.
        if to_name == "rt_types__PVec" and is_vector_int(mono) {
          case family_by_pvec_name(from_name) {
            .Some(fam) => return buf.append(.Call(fam.box_call)),
            .None => {},
          }
        }
        if from_name == "rt_types__PVec" and is_vector_int(mono) {
          case family_by_pvec_name(to_name) {
            .Some(fam) => return buf.append(.Call(fam.unbox_call)),
            .None => {},
          }
        }
      },
      _ => {},
    },
    _ => {},
  }

  case to {
    .Anyref => {
      // A typed PVecI64 must be boxed to PVec before erasing to anyref: a bare
      // upcast of the distinct PVecI64 struct would trap on the later cast back
      // to PVec. box_i64 first, then the normal (identity) vector erase.
      pre := case from {
        .Ref(_, .Named(fname)) => if is_vector_int(mono) {
          case family_by_pvec_name(fname) {
            .Some(fam) => buf.append(.Call(fam.box_call)),
            .None => buf,
          }
        } else {
          buf
        },
        _ => buf,
      }
      return emit_box_to_anyref(mono, ctx.env, pre)
    },
    _ => {},
  }

  case from {
    .Anyref => return emit_unbox_from_anyref(mono, ctx.env, buf),
    _ => {},
  }

  case from {
    .I32 => case to {
      .I64 => return buf.append(.I64ExtendI32S),
      _ => {},
    },
    .I64 => case to {
      .I32 => return buf.append(.I32WrapI64),
      _ => {},
    },
    .Ref(false, from_heap) => case to {
      .Ref(true, to_heap) => if heap_type_eq(from_heap, to_heap) {
        return buf
      },
      _ => {},
    },
    .Ref(true, from_heap) => case to {
      .Ref(false, to_heap) => if heap_type_eq(from_heap, to_heap) {
        return buf.append(.RefAsNonNull)
      },
      _ => {},
    },
    _ => {},
  }

  case from {
    .Ref(_, _) => case to {
      .Ref(nullable, heap) => return buf.append(.RefCast(nullable, heap)),
      _ => {},
    },
    _ => {},
  }

  buf
}

fn is_vector_int(mono: MonoType) Bool {
  case mono {
    .Vector(.Int) => true,
    _ => false,
  }
}

// Coerce a runtime call's ABI result to the destination slot's physical type
// (dest_vt), not the mono-derived type. When the destination slot is typed
// (e.g. PVecI64) and the runtime call already returns that physical type (a
// typed-vec result like gather_i64), this is a no-op — replacing the former
// name-based is_typed_vec_result box-skip.
pub fn adapt_runtime_result(fid: FuncId, dest_vt: ValType, result_mono: MonoType, ctx: EmitCtx) Vector<
  Instr,
> {
  abi_opt: AbiContract? = case ctx.builtins.by_id[fid.id] {
    .Some(entry) => .Some(entry.abi),
    .None => .None,
  }

  case abi_opt {
    .Some(abi) => if abi.result_types.len() == 1 {
      emit_coerce_stack(abi.result_types[0], dest_vt, result_mono, ctx, [])
    } else {
      []
    },
    .None => [],
  }
}
