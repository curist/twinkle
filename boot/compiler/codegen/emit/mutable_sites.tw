//! Emit-side extraction helpers for the Phase 7C/7D mutable-decision seam.
//!
//! Translates prepared slots/args/fields into `compiler.codegen.mutable_select`
//! inputs (`Site`, `OperationFamily`, base source locals, field path keys) so
//! emission can ask the selector "what would the decision table pick here"
//! without emit.tw re-deriving that shape itself.
//!
//! `select_call_for_emit` and `select_record_update_for_emit` take the decision
//! table as an explicit parameter; emit.tw passes `ctx.mutable_decisions` (see
//! `.ACall`/`.ARecordUpdate` lowering). In Phase 7C/7D the selector always
//! returns the persistent target, so consulting these helpers makes no emitted-
//! code change.

use compiler.backend.prepared_ir.{PreparedAtom}
use compiler.codegen.emit.context.{EmitCtx, LocalEntry, lookup_slot}
use compiler.codegen.mutable_catalog
use compiler.codegen.mutable_select
use compiler.core_ir.{FieldId, FuncId, LocalId}
use compiler.mono_type.{TypeId}
use compiler.opt.semantics.{make_prelude_optimizer_semantics}

pub fn site_for_result(ctx: EmitCtx, result_entry: LocalEntry) mutable_select.Site? {
  case ctx.current_func_id {
    .Some(fid) => .Some(mutable_select.Site.{ func: fid, local: result_entry.source_local }),
    .None => .None,
  }
}

fn catalog_for_ctx(ctx: EmitCtx) mutable_catalog.MutableCatalog {
  sem := make_prelude_optimizer_semantics(ctx.builtins)
  mutable_catalog.build(ctx.builtins, sem)
}

fn call_entry_for_persistent(fid: FuncId, ctx: EmitCtx) mutable_catalog.UpdateEntry? {
  catalog_for_ctx(ctx).entry_for_persistent(fid)
}

pub fn call_family_for_persistent(fid: FuncId, ctx: EmitCtx) mutable_select.OperationFamily? {
  case call_entry_for_persistent(fid, ctx) {
    .Some(entry) => entry.decision_family,
    .None => .None,
  }
}

pub fn base_source_local_for_args(
  args: Vector<PreparedAtom>,
  family: mutable_select.OperationFamily,
  ctx: EmitCtx,
) LocalId? {
  base_idx := case mutable_catalog.base_arg_index_for_decision_family(family) {
    .Some(i) => i,
    .None => return .None,
  }
  base_source_local_at(args, base_idx, ctx)
}

fn base_source_local_at(args: Vector<PreparedAtom>, base_idx: Int, ctx: EmitCtx) LocalId? {
  if base_idx < 0 or base_idx >= args.len() {
    return .None
  }
  case args[base_idx] {
    .ASlot(sid) => .Some(lookup_slot(ctx, sid).source_local),
    _ => .None,
  }
}

pub fn record_base_source_local(base: PreparedAtom, ctx: EmitCtx) LocalId? {
  case base {
    .ASlot(sid) => .Some(lookup_slot(ctx, sid).source_local),
    _ => .None,
  }
}

pub fn field_path_key(tid: TypeId, fid: FieldId) String {
  "${tid.id}:f${fid.id}"
}

// Combine site/family/base-local derivation with the selector to ask "what
// would the decision table pick for this prepared call site". Returns `.None`
// when any prepared-site requirement is unavailable (no current function, the
// persistent callee isn't a recognized decision family, or the base argument
// isn't a slot) — emit.tw's later caller falls back to emitting the persistent
// call directly in that case.
pub fn select_call_for_emit(
  table: mutable_select.MutableDecisionTable,
  persistent_fid: FuncId,
  args: Vector<PreparedAtom>,
  result_entry: LocalEntry,
  ctx: EmitCtx,
) mutable_select.CallSelection? {
  site := case site_for_result(ctx, result_entry) {
    .Some(s) => s,
    .None => return .None,
  }
  entry := case call_entry_for_persistent(persistent_fid, ctx) {
    .Some(e) => e,
    .None => return .None,
  }
  family := case entry.decision_family {
    .Some(f) => f,
    .None => return .None,
  }
  base_idx := case entry.base_arg_index {
    .Some(i) => i,
    .None => return .None,
  }
  base_local := case base_source_local_at(args, base_idx, ctx) {
    .Some(l) => l,
    .None => return .None,
  }

  .Some(
    mutable_select.select_call_with_policy(
      table,
      site,
      family,
      persistent_fid,
      entry.base_arg_index,
      base_local,
      result_entry.source_local,
      args.len(),
      ctx.mutable_emit_policy,
    ),
  )
}

pub fn select_record_update_for_emit(
  table: mutable_select.MutableDecisionTable,
  base: PreparedAtom,
  fid: FieldId,
  tid: TypeId,
  original_can_reuse: Bool,
  result_entry: LocalEntry,
  ctx: EmitCtx,
) mutable_select.RecordReuseSelection? {
  site := case site_for_result(ctx, result_entry) {
    .Some(s) => s,
    .None => return .None,
  }
  base_source := case record_base_source_local(base, ctx) {
    .Some(l) => l,
    .None => return .None,
  }
  .Some(
    mutable_select.select_record_update(
      table,
      site,
      base_source,
      result_entry.source_local,
      field_path_key(tid, fid),
      original_can_reuse,
    ),
  )
}
