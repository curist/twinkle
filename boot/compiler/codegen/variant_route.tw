//! Owned-seed table + variant routing records for Phase 8G ownership
//! specialization. LEAF-ish: imports only variant identity so codegen passes
//! and the decision producer can share these types without a cycle.
//!
//! `OwnedSeedTable` maps a clone `func_id` to both the param-locals to seed
//! `Unique` at entry AND the source `VariantId` (so the decision producer can
//! stamp `variant_key` for audit). `VariantRoute` is the handoff-contract
//! routing record: which generic function a clone specializes, the exact key,
//! the call sites routed to it, and the fallback reason when a site stayed
//! generic.

use compiler.field_facts as ff
use compiler.variant_id as vid

pub type CloneSpec = .{
  seed_locals: Dict<Int, Bool>,
  field_seed_paths: Dict<Int, ff.FieldMap>,
  variant: vid.VariantId,
}

pub type OwnedSeedTable = .{ by_func: Dict<Int, CloneSpec> }

pub fn empty_seed_table() OwnedSeedTable {
  OwnedSeedTable.{ by_func: Dict.new() }
}

pub fn set_clone(self: OwnedSeedTable, func_id: Int, spec: CloneSpec) OwnedSeedTable {
  self.by_func[func_id] = spec
  self
}

pub type FallbackReason = { AbsentProof, StaleKey, OverCap, Unsupported, Ambiguous, ZeroWin }

pub type VariantRoute = .{
  generic_func: Int,
  variant: vid.VariantId,
  clone_func: Int,
  clone_name: String,
  route_sites: Vector<Int>,
  recursive_routes: Vector<Int>,
  fallback_reason: FallbackReason?,
  proof_debug_id: String,
}
