//! Phase 8A mutable-decision producer.
//!
//! Produces backend decisions from already-computed ownership verdicts. This module
//! does not prove ownership; it joins ANF update sites with analysis verdict flags
//! and the mutable operation catalog.

use @std.date
use @std.proc

use compiler.anf.{AnfExpr, AnfModule, AnfOp, Atom}
use compiler.builtins.{BuiltinRegistry}
use compiler.cfg
use compiler.codegen.mutable_catalog
use compiler.codegen.mutable_select
use compiler.codegen.ownership_verdicts
use compiler.codegen.variant_route
use compiler.core_ir.{FieldId, FuncId, LocalId}
use compiler.mono_type.{TypeId}
use compiler.opt.semantics.{OptimizerSemantics, make_prelude_optimizer_semantics}
use compiler.ownership.{SummaryTable, empty_summary_table}

fn timings_enabled() Bool {
  case proc.env("TWINKLE_TIMINGS") {
    .Some(_) => true,
    .None => false,
  }
}

fn mutable_phase(label: String) {
  if timings_enabled() {
    eprintln("[time:mutable:phase] ${label}")
  }
}

pub type DecisionRenderRow = .{
  func: String,
  local: Int,
  family: String,
  persistent: String,
  mutable: String,
  state: String,
  reason: String,
  proof: String,
}

pub type ProducedDecisions = .{
  table: mutable_select.MutableDecisionTable,
  rows: Vector<DecisionRenderRow>,
  artifact_computed: Bool,
}

// A raw update-call site found in the ANF, before it is joined with an
// ownership verdict. `loop_depth` is how many enclosing `.ALoop` bodies the
// site sits inside; it selects loop-carried proof rendering (Phase 8B), not
// suppression. `family`/`base_arg_index`/`decision_family` ride along from the
// catalog entry rather than being assumed by the producer, so a future family
// can't silently drift from what the catalog (and `select_call_for_emit`,
// which also reads `entry.base_arg_index`) actually says.
pub type Candidate = .{
  func_id: FuncId,
  func: String,
  result: LocalId,
  base: LocalId,
  arg_count: Int,
  family: String,
  base_arg_index: Int,
  decision_family: mutable_select.OperationFamily,
  persistent_func: FuncId,
  mutable_func: FuncId,
  loop_depth: Int,
}

pub type CandidateSet = .{ candidates: Vector<Candidate> }

// A raw record-shell update site (`p.x = v` sugar → `ARecordUpdate`), before it
// is joined with an ownership verdict. Unlike a call candidate there is no
// runtime helper pair: the persistent form is a `struct.new` copy and the
// mutable form is a `struct.set` shell reuse, both emitted directly by
// `emit_record_update`. `field_path_key` mirrors
// `emit.mutable_sites.field_path_key` so the produced decision keys the same
// type-qualified field the prepared-site selector re-derives.
pub type RecordCandidate = .{
  func_id: FuncId,
  func: String,
  result: LocalId,
  base: LocalId,
  tid: TypeId,
  fid: FieldId,
  field_path_key: String,
  loop_depth: Int,
}

pub type RecordCandidateSet = .{ candidates: Vector<RecordCandidate> }

// Keep in sync with `emit.mutable_sites.field_path_key`; the selector rejects a
// decision whose field path does not match the prepared site.
fn record_field_path_key(tid: TypeId, fid: FieldId) String {
  "${tid.id}:f${fid.id}"
}

type UpdateCallTarget = .{
  base: LocalId,
  mutable_func: FuncId,
  family: String,
  base_arg_index: Int,
  decision_family: mutable_select.OperationFamily,
}

fn atom_local(a: Atom) LocalId? {
  case a {
    .ALocal(l) => .Some(l),
    _ => .None,
  }
}

// A catalog entry names an update-call candidate only when it carries a
// supported call-swap decision family (VectorSet/DictSet/DictRemove), a live
// mutable target, a base-argument position, and the actual argument at that
// position is a plain local (not a literal, global, or other atom shape the
// ownership analysis cannot key on). The decision family rides along so the
// produced decision is tagged correctly; the emit policy — not this producer —
// decides which families actually emit their mutable target.
fn update_call_target(entry: mutable_catalog.UpdateEntry, args: Vector<Atom>) UpdateCallTarget? {
  fam := case entry.decision_family {
    .Some(f) => f,
    .None => return .None,
  }
  if !mutable_select.is_supported_call_family(fam) {
    return .None
  }
  mutable_fid := case entry.mutable_func {
    .Some(m) => m,
    .None => return .None,
  }
  idx := case entry.base_arg_index {
    .Some(i) => i,
    .None => return .None,
  }
  if idx < 0 or idx >= args.len() {
    return .None
  }
  base := case atom_local(args[idx]) {
    .Some(l) => l,
    .None => return .None,
  }
  .Some(
    UpdateCallTarget.{
      base,
      mutable_func: mutable_fid,
      family: entry.family,
      base_arg_index: idx,
      decision_family: fam,
    },
  )
}

// Deliberately re-walks the same `Let`/`AIf`/`AMatch`/`ALoop`/`ADefer`
// skeleton as `compiler.census`'s `walk_expr`/`walk_op`, differing only by
// the loop-depth counter and the VectorSet filter: `CensusSite` doesn't carry
// loop-depth, so census can't be reused directly here. If a new control-flow
// `AnfOp`/`AnfExpr` variant is added, update BOTH walks.
fn walk_expr(
  expr: AnfExpr,
  func_id: FuncId,
  func: String,
  loop_depth: Int,
  candidates: Vector<Candidate>,
  cat: mutable_catalog.MutableCatalog,
) Vector<Candidate> {
  case expr {
    .Let(local, op, body) => {
      after := walk_op(op, local, func_id, func, loop_depth, candidates, cat)
      walk_expr(body, func_id, func, loop_depth, after, cat)
    },
    _ => candidates,
  }
}

fn walk_op(
  op: AnfOp,
  result: LocalId,
  func_id: FuncId,
  func: String,
  loop_depth: Int,
  candidates: Vector<Candidate>,
  cat: mutable_catalog.MutableCatalog,
) Vector<Candidate> {
  case op {
    .ACall(callee, args) => case callee {
      .AGlobalFunc(fid) => case cat.entry_for_persistent(fid) {
        .Some(entry) => case update_call_target(entry, args) {
          .Some(t) => candidates.append(Candidate.{
            func_id,
            func,
            result,
            base: t.base,
            arg_count: args.len(),
            family: t.family,
            base_arg_index: t.base_arg_index,
            decision_family: t.decision_family,
            persistent_func: fid,
            mutable_func: t.mutable_func,
            loop_depth,
          }),
          .None => candidates,
        },
        .None => candidates,
      },
      _ => candidates,
    },
    .AIf(_, then_e, else_e) => {
      after_then := walk_expr(then_e, func_id, func, loop_depth, candidates, cat)
      walk_expr(else_e, func_id, func, loop_depth, after_then, cat)
    },
    .AMatch(_, arms) => {
      acc := candidates
      for arm in arms {
        acc = walk_expr(arm.body, func_id, func, loop_depth, acc, cat)
      }
      acc
    },
    .ALoop(body) => walk_expr(body, func_id, func, loop_depth + 1, candidates, cat),
    .ADefer(body) => walk_expr(body, func_id, func, loop_depth, candidates, cat),
    _ => candidates,
  }
}

fn collect_candidates(opt: AnfModule, cat: mutable_catalog.MutableCatalog) Vector<Candidate> {
  candidates: Vector<Candidate> = []
  for f in opt.functions {
    candidates = walk_expr(f.body, f.func_id, f.name, 0, candidates, cat)
  }
  candidates
}

// Parallel to `walk_expr`/`walk_op` but for record-shell update sites. Deliberately
// re-walks the same `Let`/`AIf`/`AMatch`/`ALoop`/`ADefer` skeleton; if a new
// control-flow `AnfOp`/`AnfExpr` variant is added, update this walk too.
fn record_walk_expr(
  expr: AnfExpr,
  func_id: FuncId,
  func: String,
  loop_depth: Int,
  candidates: Vector<RecordCandidate>,
) Vector<RecordCandidate> {
  case expr {
    .Let(local, op, body) => {
      after := record_walk_op(op, local, func_id, func, loop_depth, candidates)
      record_walk_expr(body, func_id, func, loop_depth, after)
    },
    _ => candidates,
  }
}

fn record_walk_op(
  op: AnfOp,
  result: LocalId,
  func_id: FuncId,
  func: String,
  loop_depth: Int,
  candidates: Vector<RecordCandidate>,
) Vector<RecordCandidate> {
  case op {
    // The base must be a plain local so ownership analysis can key on it; a
    // literal or other atom shape is not a shell the analysis tracks.
    .ARecordUpdate(base, fid, _value, _in_place, tid) => case atom_local(base) {
      .Some(bl) => candidates.append(RecordCandidate.{
        func_id,
        func,
        result,
        base: bl,
        tid,
        fid,
        field_path_key: record_field_path_key(tid, fid),
        loop_depth,
      }),
      .None => candidates,
    },
    .AIf(_, then_e, else_e) => {
      after_then := record_walk_expr(then_e, func_id, func, loop_depth, candidates)
      record_walk_expr(else_e, func_id, func, loop_depth, after_then)
    },
    .AMatch(_, arms) => {
      acc := candidates
      for arm in arms {
        acc = record_walk_expr(arm.body, func_id, func, loop_depth, acc)
      }
      acc
    },
    .ALoop(body) => record_walk_expr(body, func_id, func, loop_depth + 1, candidates),
    .ADefer(body) => record_walk_expr(body, func_id, func, loop_depth, candidates),
    _ => candidates,
  }
}

/// Collect record-shell update sites for joining with ownership verdicts. No
/// catalog is needed: record updates have no runtime helper, only the
/// persistent `struct.new` copy vs the mutable `struct.set` shell reuse.
pub fn record_update_candidates(opt: AnfModule) RecordCandidateSet {
  candidates: Vector<RecordCandidate> = []
  for f in opt.functions {
    candidates = record_walk_expr(f.body, f.func_id, f.name, 0, candidates)
  }
  RecordCandidateSet.{ candidates }
}

fn record_candidate_func_roots(set: RecordCandidateSet) Dict<Int, Bool> {
  roots: Dict<Int, Bool> = Dict.new()
  for c in set.candidates {
    roots[c.func_id.id] = true
  }
  roots
}

fn record_candidate_keys(set: RecordCandidateSet) Dict<String, Bool> {
  keys: Dict<String, Bool> = Dict.new()
  for c in set.candidates {
    keys["${c.func_id.id}#${c.result.id}"] = true
  }
  keys
}

fn record_stale_artifact_rows(candidates: Vector<RecordCandidate>) Vector<DecisionRenderRow> {
  rows: Vector<DecisionRenderRow> = []
  for c in candidates {
    rows = .append(
      DecisionRenderRow.{
        func: c.func,
        local: c.result.id,
        family: "record_shell",
        persistent: "struct.new",
        mutable: "struct.set",
        state: "ignored",
        reason: "persistent fallback: stale ownership artifact",
        proof: "-",
      },
    )
  }
  rows
}

// Join record-shell update candidates with already-validated ownership verdicts.
// A candidate becomes a decision when its base shell is certified reusable
// (`reusable_shell`), which the ownership analysis sets only when the base is
// unique and at its last use. Loop-carried sites carry a distinct proof id.
fn produce_record_decisions_from_validated_verdicts(
  candidates: Vector<RecordCandidate>,
  verdicts: Dict<String, ownership_verdicts.SiteVerdict>,
  artifact_computed: Bool,
) ProducedDecisions {
  table := mutable_select.empty_decision_table()
  rows: Vector<DecisionRenderRow> = []

  for c in candidates {
    key := "${c.func_id.id}#${c.result.id}"
    verdict := case verdicts.get(key) {
      .Some(v) => v,
      .None => ownership_verdicts.SiteVerdict.{
        text: "-",
        reusable_shell: false,
        field_backing_reusable: false,
      },
    }

    row: DecisionRenderRow = if verdict.reusable_shell {
      loop_carried := c.loop_depth > 0
      proof_id := if loop_carried {
        "phase8f-loop:${c.func}:carry L${c.base.id}:site L${c.result.id}:depth ${c.loop_depth}"
      } else {
        "phase8f:${c.func}:L${c.result.id}"
      }
      table = .with_decision(
        mutable_select.MutableDecision.{
          site: mutable_select.Site.{ func: c.func_id, local: c.result },
          family: mutable_select.OperationFamily.RecordShellUpdate,
          source_local: c.base,
          result_local: c.result,
          arg_count: 0,
          base_arg_index: .None,
          persistent_func: .None,
          mutable_func: .None,
          variant_key: .None,
          field_path_key: c.field_path_key,
          proof_debug_id: proof_id,
        },
      )
      reason := if loop_carried {
        "decision produced (loop-carried, carry L${c.base.id})"
      } else {
        "decision produced"
      }
      DecisionRenderRow.{
        func: c.func,
        local: c.result.id,
        family: "record_shell",
        persistent: "struct.new",
        mutable: "struct.set",
        state: "candidate",
        reason,
        proof: verdict.text,
      }
    } else {
      DecisionRenderRow.{
        func: c.func,
        local: c.result.id,
        family: "record_shell",
        persistent: "struct.new",
        mutable: "struct.set",
        state: "ignored",
        reason: "persistent fallback: ownership verdict did not certify reusable base",
        proof: verdict.text,
      }
    }
    rows = .append(row)
  }

  ProducedDecisions.{ table, rows, artifact_computed }
}

/// Produce record-shell update decisions from pre-computed ownership artifacts.
/// Validates the artifacts' optimized-ANF fingerprint against `opt`, so stale
/// artifacts fall back persistently rather than mixing verdicts from another module.
pub fn produce_record_update_decisions_with_artifacts(
  opt: AnfModule,
  artifacts: ownership_verdicts.OwnershipArtifacts,
) ProducedDecisions {
  record_update_candidates(opt).produce_record_from_set(
    artifacts,
    ownership_verdicts.artifact_key_for_anf(opt),
  )
}

// Join a pre-built record-shell candidate set with the artifacts, using a caller-
// supplied `expected` key (see `produce_field_backed_from_set`).
fn produce_record_from_set(
  set: RecordCandidateSet,
  artifacts: ownership_verdicts.OwnershipArtifacts,
  expected: ownership_verdicts.ArtifactKey,
) ProducedDecisions {
  if set.candidates.len() == 0 {
    return ProducedDecisions.{
      table: mutable_select.empty_decision_table(),
      rows: [],
      artifact_computed: false,
    }
  }

  if !expected.same_artifact_key(artifacts.key) {
    return ProducedDecisions.{
      table: mutable_select.empty_decision_table(),
      rows: record_stale_artifact_rows(set.candidates),
      artifact_computed: false,
    }
  }

  vt := artifacts.verdicts_for_keys(set.record_candidate_keys())
  produce_record_decisions_from_validated_verdicts(set.candidates, vt.by_key, true)
}

fn merge_roots(a: Dict<Int, Bool>, b: Dict<Int, Bool>) Dict<Int, Bool> {
  out := a
  for k in b.keys() {
    out[k] = true
  }
  out
}

fn merge_produced(a: ProducedDecisions, b: ProducedDecisions) ProducedDecisions {
  table := a.table
  for _key, ds in b.table.by_site {
    for d in ds {
      table = .with_decision(d)
    }
  }
  rows := a.rows
  for r in b.rows {
    rows = .append(r)
  }
  ProducedDecisions.{ table, rows, artifact_computed: a.artifact_computed or b.artifact_computed }
}

/// The real build-path producer: combines update-call decisions (vector/dict set
/// and remove) and record-shell update decisions over a single ownership-artifact
/// computation scoped to the union of both candidate root sets. Call and record
/// decisions live at disjoint sites, so the merged table never collides.
pub fn produce_mutable_decisions(opt: AnfModule, b: BuiltinRegistry) ProducedDecisions {
  produce_mutable_decisions_seeded(opt, b, variant_route.empty_seed_table())
}

// Seeded producer for Phase 8G: computes ownership artifacts with the clone
// funcs in `owned_seeds` seeded owned at entry, so a clone body's update sites
// certify reusable where the generic body does not. Decisions whose site sits in
// a seeded (clone) func are stamped with the source `VariantId` for audit — the
// emit path never reads `variant_key`. Passing an empty table reproduces the
// unseeded production exactly.
pub fn produce_mutable_decisions_seeded(
  opt: AnfModule,
  b: BuiltinRegistry,
  owned_seeds: variant_route.OwnedSeedTable,
) ProducedDecisions {
  produce_mutable_decisions_seeded_with_sem(
    opt,
    b,
    owned_seeds,
    make_prelude_optimizer_semantics(b),
    empty_summary_table(),
    cfg.CfgView.{ functions: [] },
    Dict.new(),
  )
}

// Env-aware seeded producer: codegen-path callers pass semantics whose `ref_fields`
// table is populated, so ownership artifacts classify record fields identically to
// the analysis/test path.
pub fn produce_mutable_decisions_seeded_with_sem(
  opt: AnfModule,
  b: BuiltinRegistry,
  owned_seeds: variant_route.OwnedSeedTable,
  sem: OptimizerSemantics,
  carried: SummaryTable,
  prior_view: cfg.CfgView,
  changed_funcs: Dict<Int, Bool>,
) ProducedDecisions {
  mutable_phase("begin candidate_scan")
  all_cands := collect_all_candidates_for(opt, b)
  mutable_phase(
    "end candidate_scan calls=${all_cands.calls.len()} records=${all_cands.records.len()} fields=${all_cands.fields.candidates.len()}",
  )
  call_set := CandidateSet.{ candidates: all_cands.calls }
  record_set := RecordCandidateSet.{ candidates: all_cands.records }
  fb_set := all_cands.fields
  if call_set.candidates.len() == 0
    and record_set.candidates.len() == 0 and fb_set.candidates.len() == 0 {
    return ProducedDecisions.{
      table: mutable_select.empty_decision_table(),
      rows: [],
      artifact_computed: false,
    }
  }

  roots := merge_roots(call_set.candidate_func_roots(), record_set.record_candidate_func_roots())
  for fid, _flag in fb_set.field_backed_candidate_func_roots() {
    roots[fid] = true
  }
  for fid, _spec in owned_seeds.by_func {
    roots[fid] = true
  }
  mutable_phase(
    "begin ownership_artifacts roots=${roots.keys().len()} seeds=${owned_seeds.by_func.keys().len()}",
  )
  artifacts := ownership_verdicts.compute_candidate_artifacts_seeded(
    opt,
    b,
    sem,
    roots,
    owned_seeds,
    carried,
    prior_view,
    changed_funcs,
  )
  mutable_phase("end ownership_artifacts")

  // Compute the ANF fingerprint once and reuse the candidate sets already built
  // above, so the three producers neither re-walk the module nor re-hash the ANF.
  expected := ownership_verdicts.artifact_key_for_anf(opt)

  // Field-backed decisions first, then ordinary call decisions excluding the
  // sites those already claimed, then record-shell decisions.
  mutable_phase("begin decision_join")
  fb_produced := fb_set.produce_field_backed_from_set(b, artifacts, expected)
  exclude := fb_produced.field_backed_accepted_site_keys()
  call_produced := call_set.produce_update_call_from_set(b, artifacts, expected, exclude)
  record_produced := record_set.produce_record_from_set(artifacts, expected)
  mutable_phase("end decision_join")
  merged := fb_produced.merge_produced(call_produced).merge_produced(record_produced)
  ProducedDecisions.{
    table: stamp_variant_keys(merged.table, owned_seeds),
    rows: merged.rows,
    artifact_computed: merged.artifact_computed,
  }
}

// Stamp `variant_key` on every decision whose site func is a seeded clone, so the
// census/audit trail names the owning variant. Rebuilds the table (decisions are
// immutable records); emission ignores `variant_key`.
fn stamp_variant_keys(
  table: mutable_select.MutableDecisionTable,
  owned_seeds: variant_route.OwnedSeedTable,
) mutable_select.MutableDecisionTable {
  if owned_seeds.by_func.keys().len() == 0 {
    return table
  }
  out := mutable_select.empty_decision_table()
  for _key, ds in table.by_site {
    for d in ds {
      stamped := case owned_seeds.by_func.get(d.site.func.id) {
        .Some(spec) => {
          d.variant_key = .Some(spec.variant)
          d
        },
        .None => d,
      }
      out = .with_decision(stamped)
    }
  }
  out
}

fn name_of(b: BuiltinRegistry, fid: FuncId) String {
  case b.entry(fid) {
    .Some(e) => e.name,
    .None => "fid#${fid.id}",
  }
}

/// Collect update-call sites (vector/dict set and remove) for joining with
/// ownership verdicts, producing a candidate set. The join into a
/// decision table (fed to the backend in a later phase) plus a render-ready
/// candidate row per site explaining why each candidate did or did not
/// produce a decision. A candidate becomes a decision when its base is
/// certified reusable by ownership analysis; this holds for straight-line
/// owned sites and for loop-carried owned sites, whose uniqueness is proven
/// across every entry and back-edge predecessor before `reusable_shell` is set.
pub fn update_call_candidates(opt: AnfModule, b: BuiltinRegistry) CandidateSet {
  sem := make_prelude_optimizer_semantics(b)
  cat := mutable_catalog.build(b, sem)
  CandidateSet.{ candidates: collect_candidates(opt, cat) }
}

fn candidate_func_roots(set: CandidateSet) Dict<Int, Bool> {
  roots: Dict<Int, Bool> = Dict.new()
  for c in set.candidates {
    roots[c.func_id.id] = true
  }
  roots
}

// ── Phase 8H: field-backed collection update quartets ────────────────
// A record field whose reference-typed backing is projected out, updated by a
// COW collection helper, and written back into the same record field, all within
// one straight-line `Let` chain:
//   Lproj = ARecordGet(Lrecord, F, T)
//   Lupd  = ACall(persistent vector/dict update, base = Lproj)
//   Lrec  = ARecordUpdate(Lrecord, F, Lupd, T)
// `family`/`base_arg_index`/`decision_family`/`persistent_func`/`mutable_func`
// ride along from the catalog entry exactly as for an ordinary update-call
// candidate; the extra fields name the record shell, projection, and write-back
// so a decision can be keyed to the collection update site.
pub type FieldBackedCandidate = .{
  func_id: FuncId,
  func: String,
  record_base: LocalId,
  projected_collection: LocalId,
  update_result: LocalId,
  record_update_result: LocalId,
  tid: TypeId,
  fid: FieldId,
  field_path_key: String,
  arg_count: Int,
  family: String,
  base_arg_index: Int,
  decision_family: mutable_select.OperationFamily,
  persistent_func: FuncId,
  mutable_func: FuncId,
  loop_depth: Int,
}

pub type FieldBackedCandidateSet = .{ candidates: Vector<FieldBackedCandidate> }

type ProjectionInfo = .{
  record_base: LocalId,
  tid: TypeId,
  fid: FieldId,
  projected: LocalId,
  loop_depth: Int,
}

type PendingUpdate = .{
  proj: ProjectionInfo,
  target: UpdateCallTarget,
  persistent_func: FuncId,
  arg_count: Int,
}

// Block-local projection/pending maps plus the globally-accumulating candidate
// list. Nested control-flow bodies get fresh projection/pending maps (a quartet
// must be visible in one straight-line chain), but candidates accumulate across
// the whole function.
type FbState = .{
  proj: Dict<Int, ProjectionInfo>,
  pending: Dict<Int, PendingUpdate>,
  cands: Vector<FieldBackedCandidate>,
}

fn fb_fresh(st: FbState) FbState {
  FbState.{ proj: Dict.new(), pending: Dict.new(), cands: st.cands }
}

fn fb_walk_op(
  op: AnfOp,
  result: LocalId,
  func_id: FuncId,
  func: String,
  loop_depth: Int,
  st: FbState,
  cat: mutable_catalog.MutableCatalog,
) FbState {
  case op {
    .ARecordGet(base, fid, tid) => case atom_local(base) {
      .Some(rb) => {
        st.proj[result.id] = ProjectionInfo.{
          record_base: rb,
          tid,
          fid,
          projected: result,
          loop_depth,
        }
        st
      },
      .None => st,
    },
    .ACall(callee, args) => case callee {
      .AGlobalFunc(fid) => case cat.entry_for_persistent(fid) {
        .Some(entry) => case update_call_target(entry, args) {
          .Some(t) => case st.proj.get(t.base.id) {
            .Some(proj) => {
              st.pending[result.id] = PendingUpdate.{
                proj,
                target: t,
                persistent_func: fid,
                arg_count: args.len(),
              }
              st
            },
            .None => st,
          },
          .None => st,
        },
        .None => st,
      },
      _ => st,
    },
    .ARecordUpdate(base, fid, value, _in_place, tid) => case atom_local(base) {
      .Some(rb) => case atom_local(value) {
        .Some(upd) => case st.pending.get(upd.id) {
          .Some(pu) => if pu.proj.record_base.id == rb.id
            and pu.proj.fid.id == fid.id and pu.proj.tid.id == tid.id {
            st.cands = .append(
              FieldBackedCandidate.{
                func_id,
                func,
                record_base: rb,
                projected_collection: pu.proj.projected,
                update_result: upd,
                record_update_result: result,
                tid,
                fid,
                field_path_key: record_field_path_key(tid, fid),
                arg_count: pu.arg_count,
                family: pu.target.family,
                base_arg_index: pu.target.base_arg_index,
                decision_family: pu.target.decision_family,
                persistent_func: pu.persistent_func,
                mutable_func: pu.target.mutable_func,
                loop_depth: pu.proj.loop_depth,
              },
            )
            st
          } else {
            st
          },
          .None => st,
        },
        .None => st,
      },
      .None => st,
    },
    .AIf(_, then_e, else_e) => {
      // Nested branches get fresh projection/pending maps (a quartet must be
      // straight-line-visible); candidates accumulate back onto `st`.
      st.cands = fb_walk_expr(then_e, func_id, func, loop_depth, st.fb_fresh(), cat).cands
      st.cands = fb_walk_expr(else_e, func_id, func, loop_depth, st.fb_fresh(), cat).cands
      st
    },
    .AMatch(_, arms) => {
      for arm in arms {
        st.cands = fb_walk_expr(arm.body, func_id, func, loop_depth, st.fb_fresh(), cat).cands
      }
      st
    },
    .ALoop(body) => {
      st.cands = fb_walk_expr(body, func_id, func, loop_depth + 1, st.fb_fresh(), cat).cands
      st
    },
    .ADefer(body) => {
      st.cands = fb_walk_expr(body, func_id, func, loop_depth, st.fb_fresh(), cat).cands
      st
    },
    _ => st,
  }
}

fn fb_walk_expr(
  expr: AnfExpr,
  func_id: FuncId,
  func: String,
  loop_depth: Int,
  st: FbState,
  cat: mutable_catalog.MutableCatalog,
) FbState {
  case expr {
    .Let(local, op, body) => {
      after := fb_walk_op(op, local, func_id, func, loop_depth, st, cat)
      fb_walk_expr(body, func_id, func, loop_depth, after, cat)
    },
    _ => st,
  }
}

pub fn field_backed_collection_candidates(opt: AnfModule, b: BuiltinRegistry) FieldBackedCandidateSet {
  sem := make_prelude_optimizer_semantics(b)
  cat := mutable_catalog.build(b, sem)
  cands: Vector<FieldBackedCandidate> = []
  for f in opt.functions {
    st := fb_walk_expr(
      f.body,
      f.func_id,
      f.name,
      0,
      FbState.{ proj: Dict.new(), pending: Dict.new(), cands },
      cat,
    )
    cands = st.cands
  }
  FieldBackedCandidateSet.{ candidates: cands }
}

fn field_backed_candidate_keys(set: FieldBackedCandidateSet) Dict<String, Bool> {
  keys: Dict<String, Bool> = Dict.new()
  for c in set.candidates {
    keys["${c.func_id.id}#${c.record_update_result.id}"] = true
  }
  keys
}

fn field_backed_candidate_func_roots(set: FieldBackedCandidateSet) Dict<Int, Bool> {
  roots: Dict<Int, Bool> = Dict.new()
  for c in set.candidates {
    roots[c.func_id.id] = true
  }
  roots
}

fn field_backed_stale_rows(candidates: Vector<FieldBackedCandidate>) Vector<DecisionRenderRow> {
  rows: Vector<DecisionRenderRow> = []
  for c in candidates {
    rows = .append(
      DecisionRenderRow.{
        func: c.func,
        local: c.update_result.id,
        family: "record_backed_${c.family}",
        persistent: "-",
        mutable: "-",
        state: "ignored",
        reason: "persistent fallback: stale ownership artifact",
        proof: "-",
      },
    )
  }
  rows
}

// ── Single-pass combined candidate collection ───────────────────────
// `update_call_candidates`, `record_update_candidates`, and
// `field_backed_collection_candidates` each walk the whole module with the same
// `Let`/`AIf`/`AMatch`/`ALoop`/`ADefer` skeleton. Consumers that need all three
// (the seeded decision producer and the specializer's `updatable_funcs`) would
// otherwise traverse the module three times and rebuild the catalog twice. This
// collector produces every kind in one pass, yielding vectors byte-identical to
// the three dedicated walks (same op order, same catalog). The single-kind
// entry points remain for callers that want just one kind. Keep the per-op logic
// here in sync with `walk_op`, `record_walk_op`, and `fb_walk_op`.
pub type AllCandidates = .{
  calls: Vector<Candidate>,
  records: Vector<RecordCandidate>,
  fields: FieldBackedCandidateSet,
}

// Whole-function candidate accumulators plus the field-backed detector's
// block-local projection/pending maps (reset on nested control flow, exactly as
// `fb_walk_*`, since a quartet must be visible in one straight-line `Let` chain).
type ScanState = .{
  calls: Vector<Candidate>,
  records: Vector<RecordCandidate>,
  fields: Vector<FieldBackedCandidate>,
  proj: Dict<Int, ProjectionInfo>,
  pending: Dict<Int, PendingUpdate>,
}

// Reset the block-local projection/pending maps for a nested scope while carrying
// the whole-function accumulators forward.
fn scan_reset(st: ScanState) ScanState {
  st.proj = Dict.new()
  st.pending = Dict.new()
  st
}

// Restore the outer block-local maps after a nested scope, keeping accumulators.
fn scan_restore(inner: ScanState, outer: ScanState) ScanState {
  inner.proj = outer.proj
  inner.pending = outer.pending
  inner
}

fn scan_op(
  op: AnfOp,
  result: LocalId,
  func_id: FuncId,
  func: String,
  loop_depth: Int,
  st: ScanState,
  cat: mutable_catalog.MutableCatalog,
) ScanState {
  case op {
    // Field-backed detector: record the projected field backing.
    .ARecordGet(base, fid, tid) => case atom_local(base) {
      .Some(rb) => {
        st.proj[result.id] = ProjectionInfo.{
          record_base: rb,
          tid,
          fid,
          projected: result,
          loop_depth,
        }
        st
      },
      .None => st,
    },
    .ACall(callee, args) => case callee {
      .AGlobalFunc(fid) => case cat.entry_for_persistent(fid) {
        .Some(entry) => case update_call_target(entry, args) {
          .Some(t) => {
            // Ordinary update-call candidate.
            st.calls = .append(
              Candidate.{
                func_id,
                func,
                result,
                base: t.base,
                arg_count: args.len(),
                family: t.family,
                base_arg_index: t.base_arg_index,
                decision_family: t.decision_family,
                persistent_func: fid,
                mutable_func: t.mutable_func,
                loop_depth,
              },
            )

            // Field-backed detector: pending update on a projected local.
            case st.proj.get(t.base.id) {
              .Some(proj) => st.pending[result.id] = PendingUpdate.{
                proj,
                target: t,
                persistent_func: fid,
                arg_count: args.len(),
              },
              .None => {},
            }
            st
          },
          .None => st,
        },
        .None => st,
      },
      _ => st,
    },
    .ARecordUpdate(base, fid, value, _in_place, tid) => {
      // Record-shell candidate.
      case atom_local(base) {
        .Some(bl) => st.records = .append(
          RecordCandidate.{
            func_id,
            func,
            result,
            base: bl,
            tid,
            fid,
            field_path_key: record_field_path_key(tid, fid),
            loop_depth,
          },
        ),
        .None => {},
      }

      // Field-backed candidate: write-back closes a projected/updated quartet.
      case atom_local(base) {
        .Some(rb) => case atom_local(value) {
          .Some(upd) => case st.pending.get(upd.id) {
            .Some(pu) => if pu.proj.record_base.id == rb.id
              and pu.proj.fid.id == fid.id and pu.proj.tid.id == tid.id {
              st.fields = .append(
                FieldBackedCandidate.{
                  func_id,
                  func,
                  record_base: rb,
                  projected_collection: pu.proj.projected,
                  update_result: upd,
                  record_update_result: result,
                  tid,
                  fid,
                  field_path_key: record_field_path_key(tid, fid),
                  arg_count: pu.arg_count,
                  family: pu.target.family,
                  base_arg_index: pu.target.base_arg_index,
                  decision_family: pu.target.decision_family,
                  persistent_func: pu.persistent_func,
                  mutable_func: pu.target.mutable_func,
                  loop_depth: pu.proj.loop_depth,
                },
              )
            },
            .None => {},
          },
          .None => {},
        },
        .None => {},
      }
      st
    },
    .AIf(_, then_e, else_e) => {
      after_then := scan_expr(then_e, func_id, func, loop_depth, st.scan_reset(), cat)
      after_else := scan_expr(else_e, func_id, func, loop_depth, after_then.scan_reset(), cat)
      after_else.scan_restore(st)
    },
    .AMatch(_, arms) => {
      acc := st
      for arm in arms {
        acc = scan_expr(arm.body, func_id, func, loop_depth, acc.scan_reset(), cat)
      }
      acc.scan_restore(st)
    },
    .ALoop(body) => scan_expr(body, func_id, func, loop_depth + 1, st.scan_reset(), cat).scan_restore(
      st,
    ),
    .ADefer(body) => scan_expr(body, func_id, func, loop_depth, st.scan_reset(), cat).scan_restore(
      st,
    ),
    _ => st,
  }
}

fn scan_expr(
  expr: AnfExpr,
  func_id: FuncId,
  func: String,
  loop_depth: Int,
  st: ScanState,
  cat: mutable_catalog.MutableCatalog,
) ScanState {
  case expr {
    .Let(local, op, body) => {
      after := scan_op(op, local, func_id, func, loop_depth, st, cat)
      scan_expr(body, func_id, func, loop_depth, after, cat)
    },
    _ => st,
  }
}

fn collect_all_candidates(opt: AnfModule, cat: mutable_catalog.MutableCatalog) AllCandidates {
  st := ScanState.{ calls: [], records: [], fields: [], proj: Dict.new(), pending: Dict.new() }
  for f in opt.functions {
    st = scan_expr(f.body, f.func_id, f.name, 0, st.scan_reset(), cat)
  }
  AllCandidates.{
    calls: st.calls,
    records: st.records,
    fields: FieldBackedCandidateSet.{ candidates: st.fields },
  }
}

pub fn collect_all_candidates_for(opt: AnfModule, b: BuiltinRegistry) AllCandidates {
  sem := make_prelude_optimizer_semantics(b)
  collect_all_candidates(opt, mutable_catalog.build(b, sem))
}

// Join field-backed quartets with the record-update site's structured
// `field_backing_reusable` verdict. When true, emit an ordinary call-swap
// `MutableDecision` at the collection update site (family stays the real
// vector/dict call family, so the existing call selector emits its in-place
// helper); otherwise render a persistent-fallback row with the concrete reason.
fn produce_field_backed_from_verdicts(
  candidates: Vector<FieldBackedCandidate>,
  b: BuiltinRegistry,
  verdicts: Dict<String, ownership_verdicts.SiteVerdict>,
  artifact_computed: Bool,
) ProducedDecisions {
  table := mutable_select.empty_decision_table()
  rows: Vector<DecisionRenderRow> = []
  for c in candidates {
    key := "${c.func_id.id}#${c.record_update_result.id}"
    verdict := case verdicts.get(key) {
      .Some(v) => v,
      .None => ownership_verdicts.SiteVerdict.{
        text: "-",
        reusable_shell: false,
        field_backing_reusable: false,
      },
    }
    persistent_name := name_of(b, c.persistent_func)
    mutable_name := name_of(b, c.mutable_func)
    row: DecisionRenderRow = if verdict.field_backing_reusable {
      proof_id := "phase8h:${c.func}:record L${c.record_base.id}.f${c.fid.id}:get L${c.projected_collection.id}:update L${c.update_result.id}:write L${c.record_update_result.id}"
      table = .with_decision(
        mutable_select.MutableDecision.{
          site: mutable_select.Site.{ func: c.func_id, local: c.update_result },
          family: c.decision_family,
          source_local: c.projected_collection,
          result_local: c.update_result,
          arg_count: c.arg_count,
          base_arg_index: .Some(c.base_arg_index),
          persistent_func: .Some(c.persistent_func),
          mutable_func: .Some(c.mutable_func),
          variant_key: .None,
          field_path_key: c.field_path_key,
          proof_debug_id: proof_id,
        },
      )
      DecisionRenderRow.{
        func: c.func,
        local: c.update_result.id,
        family: "record_backed_${c.family}",
        persistent: persistent_name,
        mutable: mutable_name,
        state: "candidate",
        reason: "field-backed decision produced",
        proof: proof_id,
      }
    } else {
      DecisionRenderRow.{
        func: c.func,
        local: c.update_result.id,
        family: "record_backed_${c.family}",
        persistent: persistent_name,
        mutable: mutable_name,
        state: "ignored",
        reason: "persistent fallback: no structured field proof",
        proof: verdict.text,
      }
    }
    rows = .append(row)
  }
  ProducedDecisions.{ table, rows, artifact_computed }
}

pub fn produce_field_backed_collection_decisions_with_artifacts(
  opt: AnfModule,
  b: BuiltinRegistry,
  artifacts: ownership_verdicts.OwnershipArtifacts,
) ProducedDecisions {
  field_backed_collection_candidates(opt, b).produce_field_backed_from_set(
    b,
    artifacts,
    ownership_verdicts.artifact_key_for_anf(opt),
  )
}

// Join a pre-built field-backed candidate set with the artifacts, using a caller-
// supplied `expected` key so the orchestrator can compute candidates and the ANF
// fingerprint once and share them across all three producers.
fn produce_field_backed_from_set(
  set: FieldBackedCandidateSet,
  b: BuiltinRegistry,
  artifacts: ownership_verdicts.OwnershipArtifacts,
  expected: ownership_verdicts.ArtifactKey,
) ProducedDecisions {
  if set.candidates.len() == 0 {
    return ProducedDecisions.{
      table: mutable_select.empty_decision_table(),
      rows: [],
      artifact_computed: false,
    }
  }
  if !expected.same_artifact_key(artifacts.key) {
    return ProducedDecisions.{
      table: mutable_select.empty_decision_table(),
      rows: field_backed_stale_rows(set.candidates),
      artifact_computed: false,
    }
  }
  vt := artifacts.verdicts_for_keys(set.field_backed_candidate_keys())
  produce_field_backed_from_verdicts(set.candidates, b, vt.by_key, true)
}

// The `site_key`s already claimed by accepted field-backed decisions, so the
// ordinary call producer can skip the same collection-update call and avoid a
// duplicate decision at that site (which the selector would treat as Ambiguous).
fn field_backed_accepted_site_keys(fb: ProducedDecisions) Dict<Int, Bool> {
  keys: Dict<Int, Bool> = Dict.new()
  for k, _ds in fb.table.by_site {
    keys[k] = true
  }
  keys
}

/// Default Phase 8A production: scopes ownership analysis to the mutable
/// candidate functions and their dependency closure, so a whole-program
/// ownership pass is not paid on every build. Verdicts (and therefore
/// decisions) match the full path — see the scoped/full equivalence tests.
pub fn produce_update_call_decisions(opt: AnfModule, b: BuiltinRegistry) ProducedDecisions {
  timed := timings_enabled()
  t0 := date.now()
  set := update_call_candidates(opt, b)
  t_candidates := date.now()
  if set.candidates.len() == 0 {
    if timed {
      eprintln(
        "[time:mutable] candidate_scan=${t_candidates - t0}ms artifact=0ms decision_join=0ms candidates=0 roots=0",
      )
    }
    return ProducedDecisions.{
      table: mutable_select.empty_decision_table(),
      rows: [],
      artifact_computed: false,
    }
  }

  sem := make_prelude_optimizer_semantics(b)
  roots := set.candidate_func_roots()
  artifacts := ownership_verdicts.compute_candidate_artifacts(opt, b, sem, roots)
  t_artifacts := date.now()
  produced := produce_update_call_decisions_with_artifacts(opt, b, artifacts)
  t_done := date.now()
  if timed {
    eprintln(
      "[time:mutable] candidate_scan=${t_candidates - t0}ms artifact=${t_artifacts - t_candidates}ms decision_join=${t_done
        - t_artifacts}ms candidates=${set.candidates.len()} roots=${roots.keys().len()}",
    )
  }
  produced
}

/// Diagnostic variant that computes full whole-program ownership artifacts
/// instead of scoped ones. Kept for scoped/full equivalence testing.
pub fn produce_update_call_decisions_full(opt: AnfModule, b: BuiltinRegistry) ProducedDecisions {
  set := update_call_candidates(opt, b)
  if set.candidates.len() == 0 {
    return ProducedDecisions.{
      table: mutable_select.empty_decision_table(),
      rows: [],
      artifact_computed: false,
    }
  }

  sem := make_prelude_optimizer_semantics(b)
  artifacts := ownership_verdicts.compute_artifacts(opt, b, sem)
  produce_update_call_decisions_with_artifacts(opt, b, artifacts)
}

// Join key: local ids repeat across functions, so the function id rides along.
pub fn candidate_keys(set: CandidateSet) Dict<String, Bool> {
  keys: Dict<String, Bool> = Dict.new()
  for c in set.candidates {
    keys["${c.func_id.id}#${c.result.id}"] = true
  }
  keys
}

// Every candidate falls back persistently when the supplied artifacts were
// computed over a different (stale) optimized ANF than the one being emitted.
fn stale_artifact_rows(candidates: Vector<Candidate>) Vector<DecisionRenderRow> {
  rows: Vector<DecisionRenderRow> = []
  for c in candidates {
    rows = .append(
      DecisionRenderRow.{
        func: c.func,
        local: c.result.id,
        family: c.family,
        persistent: "fid#${c.persistent_func.id}",
        mutable: "fid#${c.mutable_func.id}",
        state: "ignored",
        reason: "persistent fallback: stale ownership artifact",
        proof: "-",
      },
    )
  }
  rows
}

/// Produce update-call decisions from pre-computed ownership artifacts.
/// The only artifact-fed producer API: it validates the artifacts' optimized-ANF
/// fingerprint against `opt` before using any verdict, so stale artifacts fall
/// back persistently rather than silently mixing verdicts from another module.
pub fn produce_update_call_decisions_with_artifacts(
  opt: AnfModule,
  b: BuiltinRegistry,
  artifacts: ownership_verdicts.OwnershipArtifacts,
) ProducedDecisions {
  produce_update_call_decisions_with_artifacts_excluding(opt, b, artifacts, Dict.new())
}

// Like `produce_update_call_decisions_with_artifacts`, but skips any call whose
// `site_key` is already claimed by an accepted field-backed decision (Phase 8H),
// so the same collection-update call never produces two decisions at one site.
pub fn produce_update_call_decisions_with_artifacts_excluding(
  opt: AnfModule,
  b: BuiltinRegistry,
  artifacts: ownership_verdicts.OwnershipArtifacts,
  exclude_sites: Dict<Int, Bool>,
) ProducedDecisions {
  update_call_candidates(opt, b).produce_update_call_from_set(
    b,
    artifacts,
    ownership_verdicts.artifact_key_for_anf(opt),
    exclude_sites,
  )
}

// Join a pre-built update-call candidate set with the artifacts, using a caller-
// supplied `expected` key (see `produce_field_backed_from_set`).
fn produce_update_call_from_set(
  set: CandidateSet,
  b: BuiltinRegistry,
  artifacts: ownership_verdicts.OwnershipArtifacts,
  expected: ownership_verdicts.ArtifactKey,
  exclude_sites: Dict<Int, Bool>,
) ProducedDecisions {
  if set.candidates.len() == 0 {
    return ProducedDecisions.{
      table: mutable_select.empty_decision_table(),
      rows: [],
      artifact_computed: false,
    }
  }

  if !expected.same_artifact_key(artifacts.key) {
    return ProducedDecisions.{
      table: mutable_select.empty_decision_table(),
      rows: stale_artifact_rows(set.candidates),
      artifact_computed: false,
    }
  }

  vt := artifacts.verdicts_for_keys(set.candidate_keys())
  produce_update_call_decisions_from_validated_verdicts(
    set.candidates,
    b,
    vt.by_key,
    true,
    exclude_sites,
  )
}

// Join update-call candidates with already-validated ownership verdicts. A
// candidate becomes a decision when its base is certified reusable, regardless
// of loop depth: loop-carried sites are proven owned across all predecessors by
// the ownership fixpoint, so the mutable helper is sound there too. Loop-carried
// decisions get a distinct `phase8b-loop` proof id naming the carried base local.
fn produce_update_call_decisions_from_validated_verdicts(
  candidates: Vector<Candidate>,
  b: BuiltinRegistry,
  verdicts: Dict<String, ownership_verdicts.SiteVerdict>,
  artifact_computed: Bool,
  exclude_sites: Dict<Int, Bool>,
) ProducedDecisions {
  table := mutable_select.empty_decision_table()
  rows: Vector<DecisionRenderRow> = []

  for c in candidates {
    sk := mutable_select.site_key(mutable_select.Site.{ func: c.func_id, local: c.result })
    if case exclude_sites.get(sk) {
      .Some(v) => v,
      .None => false,
    } {
      // An accepted field-backed decision already owns this collection-update
      // site; do not produce a duplicate whole-local decision here.
      continue
    }
    key := "${c.func_id.id}#${c.result.id}"
    verdict := case verdicts.get(key) {
      .Some(v) => v,
      .None => ownership_verdicts.SiteVerdict.{
        text: "-",
        reusable_shell: false,
        field_backing_reusable: false,
      },
    }
    persistent_name := name_of(b, c.persistent_func)
    mutable_name := name_of(b, c.mutable_func)

    row: DecisionRenderRow = if verdict.reusable_shell {
      loop_carried := c.loop_depth > 0
      proof_id := if loop_carried {
        "phase8b-loop:${c.func}:carry L${c.base.id}:site L${c.result.id}:depth ${c.loop_depth}"
      } else {
        "phase8a:${c.func}:L${c.result.id}"
      }
      table = .with_decision(
        mutable_select.MutableDecision.{
          site: mutable_select.Site.{ func: c.func_id, local: c.result },
          family: c.decision_family,
          source_local: c.base,
          result_local: c.result,
          arg_count: c.arg_count,
          base_arg_index: .Some(c.base_arg_index),
          persistent_func: .Some(c.persistent_func),
          mutable_func: .Some(c.mutable_func),
          variant_key: .None,
          field_path_key: "",
          proof_debug_id: proof_id,
        },
      )
      reason := if loop_carried {
        "decision produced (loop-carried, carry L${c.base.id})"
      } else {
        "decision produced"
      }
      DecisionRenderRow.{
        func: c.func,
        local: c.result.id,
        family: c.family,
        persistent: persistent_name,
        mutable: mutable_name,
        state: "candidate",
        reason,
        proof: verdict.text,
      }
    } else {
      DecisionRenderRow.{
        func: c.func,
        local: c.result.id,
        family: c.family,
        persistent: persistent_name,
        mutable: mutable_name,
        state: "ignored",
        reason: "persistent fallback: ownership verdict did not certify reusable base",
        proof: verdict.text,
      }
    }
    rows = .append(row)
  }

  ProducedDecisions.{ table, rows, artifact_computed }
}

/// Tab-separated producer-candidate table: which raw update-call candidates
/// became decisions, and why the rest did not. Not the backend audit table.
pub fn render_candidate_rows(rows: Vector<DecisionRenderRow>) String {
  out := "func\tlocal\tfamily\tpersistent\tmutable\tproducer_state\treason\tproof\n"
  for r in rows {
    out = .concat(
      "${r.func}\tL${r.local}\t${r.family}\t${r.persistent}\t${r.mutable}\t${r.state}\t${r.reason}\t${r.proof}\n",
    )
  }
  out
}
