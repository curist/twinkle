//! Phase 8A mutable-decision producer.
//!
//! Produces backend decisions from already-computed ownership verdicts. This module
//! does not prove ownership; it joins ANF update sites with analysis verdict flags
//! and the mutable operation catalog.

use @std.date
use @std.proc

use compiler.anf.{AnfExpr, AnfModule, AnfOp, Atom}
use compiler.builtins.{BuiltinRegistry}
use compiler.codegen.mutable_catalog
use compiler.codegen.mutable_select
use compiler.codegen.ownership_verdicts
use compiler.core_ir.{FuncId, LocalId}
use compiler.opt.semantics.{make_prelude_optimizer_semantics}

fn timings_enabled() Bool {
  case proc.env("TWINKLE_TIMINGS") {
    .Some(_) => true,
    .None => false,
  }
}

pub type DecisionRenderRow = .{
  func: String,
  local: Int,
  family: String,
  persistent: String,
  mutable: String,
  state: String,
  reason: String,
  proof: String,
}

pub type ProducedDecisions = .{
  table: mutable_select.MutableDecisionTable,
  rows: Vector<DecisionRenderRow>,
  artifact_computed: Bool,
}

// A raw vector-set update site found in the ANF, before it is joined with an
// ownership verdict. `loop_depth` is how many enclosing `.ALoop` bodies the
// site sits inside; Phase 8A only ever produces decisions for depth 0 (Phase
// 8B is expected to take on loop-contained sites). `family`/`base_arg_index`
// ride along from the catalog entry rather than being assumed by the
// producer, so a future non-VectorSet family can't silently drift from what
// the catalog (and `select_call_for_emit`, which also reads
// `entry.base_arg_index`) actually says.
pub type Candidate = .{
  func_id: FuncId,
  func: String,
  result: LocalId,
  base: LocalId,
  arg_count: Int,
  family: String,
  base_arg_index: Int,
  persistent_func: FuncId,
  mutable_func: FuncId,
  loop_depth: Int,
}

pub type CandidateSet = .{ candidates: Vector<Candidate> }

type VectorSetTarget = .{ base: LocalId, mutable_func: FuncId, family: String, base_arg_index: Int }

fn atom_local(a: Atom) LocalId? {
  case a {
    .ALocal(l) => .Some(l),
    _ => .None,
  }
}

// A catalog entry names a Phase 8A vector-set candidate only when it carries
// the `.VectorSet` decision family, a live mutable target, a base-argument
// position, and the actual call argument at that position is a plain local
// (not a literal, global, or other atom shape the ownership analysis cannot
// key on).
fn vector_set_target(entry: mutable_catalog.UpdateEntry, args: Vector<Atom>) VectorSetTarget? {
  is_vector_set := case entry.decision_family {
    .Some(.VectorSet) => true,
    _ => false,
  }
  if !is_vector_set {
    return .None
  }
  mutable_fid := case entry.mutable_func {
    .Some(m) => m,
    .None => return .None,
  }
  idx := case entry.base_arg_index {
    .Some(i) => i,
    .None => return .None,
  }
  if idx < 0 or idx >= args.len() {
    return .None
  }
  base := case atom_local(args[idx]) {
    .Some(l) => l,
    .None => return .None,
  }
  .Some(
    VectorSetTarget.{ base, mutable_func: mutable_fid, family: entry.family, base_arg_index: idx },
  )
}

// Deliberately re-walks the same `Let`/`AIf`/`AMatch`/`ALoop`/`ADefer`
// skeleton as `compiler.census`'s `walk_expr`/`walk_op`, differing only by
// the loop-depth counter and the VectorSet filter: `CensusSite` doesn't carry
// loop-depth, so census can't be reused directly here. If a new control-flow
// `AnfOp`/`AnfExpr` variant is added, update BOTH walks.
fn walk_expr(
  expr: AnfExpr,
  func_id: FuncId,
  func: String,
  loop_depth: Int,
  candidates: Vector<Candidate>,
  cat: mutable_catalog.MutableCatalog,
) Vector<Candidate> {
  case expr {
    .Let(local, op, body) => {
      after := walk_op(op, local, func_id, func, loop_depth, candidates, cat)
      walk_expr(body, func_id, func, loop_depth, after, cat)
    },
    _ => candidates,
  }
}

fn walk_op(
  op: AnfOp,
  result: LocalId,
  func_id: FuncId,
  func: String,
  loop_depth: Int,
  candidates: Vector<Candidate>,
  cat: mutable_catalog.MutableCatalog,
) Vector<Candidate> {
  case op {
    .ACall(callee, args) => case callee {
      .AGlobalFunc(fid) => case cat.entry_for_persistent(fid) {
        .Some(entry) => case vector_set_target(entry, args) {
          .Some(t) => candidates.append(Candidate.{
            func_id,
            func,
            result,
            base: t.base,
            arg_count: args.len(),
            family: t.family,
            base_arg_index: t.base_arg_index,
            persistent_func: fid,
            mutable_func: t.mutable_func,
            loop_depth,
          }),
          .None => candidates,
        },
        .None => candidates,
      },
      _ => candidates,
    },
    .AIf(_, then_e, else_e) => {
      after_then := walk_expr(then_e, func_id, func, loop_depth, candidates, cat)
      walk_expr(else_e, func_id, func, loop_depth, after_then, cat)
    },
    .AMatch(_, arms) => {
      acc := candidates
      for arm in arms {
        acc = walk_expr(arm.body, func_id, func, loop_depth, acc, cat)
      }
      acc
    },
    .ALoop(body) => walk_expr(body, func_id, func, loop_depth + 1, candidates, cat),
    .ADefer(body) => walk_expr(body, func_id, func, loop_depth, candidates, cat),
    _ => candidates,
  }
}

fn collect_candidates(opt: AnfModule, cat: mutable_catalog.MutableCatalog) Vector<Candidate> {
  candidates: Vector<Candidate> = []
  for f in opt.functions {
    candidates = walk_expr(f.body, f.func_id, f.name, 0, candidates, cat)
  }
  candidates
}

fn name_of(b: BuiltinRegistry, fid: FuncId) String {
  case b.entry(fid) {
    .Some(e) => e.name,
    .None => "fid#${fid.id}",
  }
}

/// Join Phase 8A vector-set update sites with ownership verdicts, producing a
/// decision table (fed to the backend in a later phase) plus a render-ready
/// candidate row per site explaining why each candidate did or did not
/// produce a decision. A candidate only becomes a decision when its base is
/// certified reusable AND it is not nested inside a loop (loop-contained
/// candidates are deferred to Phase 8B).
pub fn phase8a_vector_set_candidates(opt: AnfModule, b: BuiltinRegistry) CandidateSet {
  sem := make_prelude_optimizer_semantics(b)
  cat := mutable_catalog.build(b, sem)
  CandidateSet.{ candidates: collect_candidates(opt, cat) }
}

fn candidate_func_roots(set: CandidateSet) Dict<Int, Bool> {
  roots: Dict<Int, Bool> = Dict.new()
  for c in set.candidates {
    roots[c.func_id.id] = true
  }
  roots
}

/// Default Phase 8A production: scopes ownership analysis to the mutable
/// candidate functions and their dependency closure, so a whole-program
/// ownership pass is not paid on every build. Verdicts (and therefore
/// decisions) match the full path — see the scoped/full equivalence tests.
pub fn produce_phase8a_vector_set_decisions(opt: AnfModule, b: BuiltinRegistry) ProducedDecisions {
  timed := timings_enabled()
  t0 := date.now()
  set := phase8a_vector_set_candidates(opt, b)
  t_candidates := date.now()
  if set.candidates.len() == 0 {
    if timed {
      eprintln(
        "[time:mutable] candidate_scan=${t_candidates - t0}ms artifact=0ms decision_join=0ms candidates=0 roots=0",
      )
    }
    return ProducedDecisions.{
      table: mutable_select.empty_decision_table(),
      rows: [],
      artifact_computed: false,
    }
  }

  sem := make_prelude_optimizer_semantics(b)
  roots := set.candidate_func_roots()
  artifacts := ownership_verdicts.compute_candidate_artifacts(opt, b, sem, roots)
  t_artifacts := date.now()
  produced := produce_phase8a_vector_set_decisions_with_artifacts(opt, b, artifacts)
  t_done := date.now()
  if timed {
    eprintln(
      "[time:mutable] candidate_scan=${t_candidates - t0}ms artifact=${t_artifacts - t_candidates}ms decision_join=${t_done
        - t_artifacts}ms candidates=${set.candidates.len()} roots=${roots.keys().len()}",
    )
  }
  produced
}

/// Diagnostic variant that computes full whole-program ownership artifacts
/// instead of scoped ones. Kept for scoped/full equivalence testing.
pub fn produce_phase8a_vector_set_decisions_full(opt: AnfModule, b: BuiltinRegistry) ProducedDecisions {
  set := phase8a_vector_set_candidates(opt, b)
  if set.candidates.len() == 0 {
    return ProducedDecisions.{
      table: mutable_select.empty_decision_table(),
      rows: [],
      artifact_computed: false,
    }
  }

  sem := make_prelude_optimizer_semantics(b)
  artifacts := ownership_verdicts.compute_artifacts(opt, b, sem)
  produce_phase8a_vector_set_decisions_with_artifacts(opt, b, artifacts)
}

// Join key: local ids repeat across functions, so the function id rides along.
pub fn candidate_keys(set: CandidateSet) Dict<String, Bool> {
  keys: Dict<String, Bool> = Dict.new()
  for c in set.candidates {
    keys["${c.func_id.id}#${c.result.id}"] = true
  }
  keys
}

// Every candidate falls back persistently when the supplied artifacts were
// computed over a different (stale) optimized ANF than the one being emitted.
fn stale_artifact_rows(candidates: Vector<Candidate>) Vector<DecisionRenderRow> {
  rows: Vector<DecisionRenderRow> = []
  for c in candidates {
    rows = .append(
      DecisionRenderRow.{
        func: c.func,
        local: c.result.id,
        family: c.family,
        persistent: "fid#${c.persistent_func.id}",
        mutable: "fid#${c.mutable_func.id}",
        state: "ignored",
        reason: "persistent fallback: stale ownership artifact",
        proof: "-",
      },
    )
  }
  rows
}

/// Produce Phase 8A vector-set decisions from pre-computed ownership artifacts.
/// The only artifact-fed producer API: it validates the artifacts' optimized-ANF
/// fingerprint against `opt` before using any verdict, so stale artifacts fall
/// back persistently rather than silently mixing verdicts from another module.
pub fn produce_phase8a_vector_set_decisions_with_artifacts(
  opt: AnfModule,
  b: BuiltinRegistry,
  artifacts: ownership_verdicts.OwnershipArtifacts,
) ProducedDecisions {
  set := phase8a_vector_set_candidates(opt, b)
  if set.candidates.len() == 0 {
    return ProducedDecisions.{
      table: mutable_select.empty_decision_table(),
      rows: [],
      artifact_computed: false,
    }
  }

  expected := ownership_verdicts.artifact_key_for_anf(opt)
  if !expected.same_artifact_key(artifacts.key) {
    return ProducedDecisions.{
      table: mutable_select.empty_decision_table(),
      rows: stale_artifact_rows(set.candidates),
      artifact_computed: false,
    }
  }

  vt := artifacts.verdicts_for_keys(set.candidate_keys())
  produce_phase8a_vector_set_decisions_from_validated_verdicts(set.candidates, b, vt.by_key, true)
}

// Join Phase 8A vector-set candidates with already-validated ownership verdicts.
// A candidate becomes a decision only when its base is certified reusable AND it
// is not nested inside a loop (loop-contained candidates defer to Phase 8B).
fn produce_phase8a_vector_set_decisions_from_validated_verdicts(
  candidates: Vector<Candidate>,
  b: BuiltinRegistry,
  verdicts: Dict<String, ownership_verdicts.SiteVerdict>,
  artifact_computed: Bool,
) ProducedDecisions {
  table := mutable_select.empty_decision_table()
  rows: Vector<DecisionRenderRow> = []

  for c in candidates {
    key := "${c.func_id.id}#${c.result.id}"
    verdict := case verdicts.get(key) {
      .Some(v) => v,
      .None => ownership_verdicts.SiteVerdict.{ text: "-", reusable_shell: false },
    }
    persistent_name := name_of(b, c.persistent_func)
    mutable_name := name_of(b, c.mutable_func)

    row: DecisionRenderRow = if verdict.reusable_shell and c.loop_depth == 0 {
      table = .with_decision(
        mutable_select.MutableDecision.{
          site: mutable_select.Site.{ func: c.func_id, local: c.result },
          family: mutable_select.OperationFamily.VectorSet,
          source_local: c.base,
          result_local: c.result,
          arg_count: c.arg_count,
          base_arg_index: .Some(c.base_arg_index),
          persistent_func: .Some(c.persistent_func),
          mutable_func: .Some(c.mutable_func),
          variant_key: .None,
          field_path_key: "",
          proof_debug_id: "phase8a:${c.func}:L${c.result.id}",
        },
      )
      DecisionRenderRow.{
        func: c.func,
        local: c.result.id,
        family: c.family,
        persistent: persistent_name,
        mutable: mutable_name,
        state: "candidate",
        reason: "decision produced",
        proof: verdict.text,
      }
    } else if verdict.reusable_shell and c.loop_depth > 0 {
      DecisionRenderRow.{
        func: c.func,
        local: c.result.id,
        family: c.family,
        persistent: persistent_name,
        mutable: mutable_name,
        state: "deferred",
        reason: "loop-contained candidate deferred to Phase 8B",
        proof: verdict.text,
      }
    } else {
      DecisionRenderRow.{
        func: c.func,
        local: c.result.id,
        family: c.family,
        persistent: persistent_name,
        mutable: mutable_name,
        state: "ignored",
        reason: "persistent fallback: ownership verdict did not certify reusable base",
        proof: verdict.text,
      }
    }
    rows = .append(row)
  }

  ProducedDecisions.{ table, rows, artifact_computed }
}

/// Tab-separated producer-candidate table: which raw vector-set candidates
/// became decisions, and why the rest did not. Not the backend audit table.
pub fn render_candidate_rows(rows: Vector<DecisionRenderRow>) String {
  out := "func\tlocal\tfamily\tpersistent\tmutable\tproducer_state\treason\tproof\n"
  for r in rows {
    out = .concat(
      "${r.func}\tL${r.local}\t${r.family}\t${r.persistent}\t${r.mutable}\t${r.state}\t${r.reason}\t${r.proof}\n",
    )
  }
  out
}
