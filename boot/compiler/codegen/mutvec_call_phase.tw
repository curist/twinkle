//! S4 (interprocedural MutVec) — HP-2 phase entrypoint.
//!
//! Wires `mutvec_call_region`'s discovery and `mutvec_call_verify`'s verifier into a single
//! per-module pass: for every function in the post-`variant_specialize`
//! module, discover its call-thread regions, then verify each discovered
//! region and keep the ones the verifier accepts. Discovery MUST run before
//! verification for a given region — `verify_region`'s condition-2 alias
//! check is only sound when called on a region that already passed
//! discovery (a hand-built or otherwise non-discovered region is not a valid
//! input), so `run_mutvec_call` never calls `verify_region` outside that order.
//!
//! `abi_upgrades` records which clone (or `$mv` sibling) may type its receiver
//! param + return as a flat `MutVec<fam>` instead of the persistent PVec ABI —
//! derived per routed clone from its accepted-vs-total site partition (see
//! `build_mutvec_call_plan`).
//!
//! Task 7 makes the phase ACTIVE: `run_mutvec_call` now RETURNS a rewritten `module`
//! (`apply_mutvec_call_rewrite`). Typing a clone MutVec without rewriting its body ops is
//! unsound — `emit_coerce_stack` has no MutVec↔PVec bridge, so a MutVec slot fed
//! from persistent-PVec ops falls to a raw `ref.cast` between unrelated GC types
//! (validation failure / trap; see `mutvec_repr.tw`'s header). So the two edits
//! land together: (a) each upgraded clone body's receiver `set_unsafe`/`get`/
//! `len`/index ops retarget to the family's `mutvec_*` op; (b) each accepted
//! caller region whose thread calls all route to an upgraded clone flattens its
//! `collect`/`make` producer to a mutvec builder — no freeze for a Scratch exit,
//! exactly one boundary `mutvec_freeze` for an EscapeReturn — with the threaded
//! clone call + its `assign handle = <result>` rebind kept as-is so the handle
//! stays flat across the boundary. The matching slot/`phys_return` typing is
//! consumed by `mutvec_repr.apply_mutvec_call_abi_upgrades`.
//!
//! Task 6 (HP-5) adds route partitioning: when only SOME of a shared clone's
//! routed owned sites are S4-accepted, `build_mutvec_call_plan` carves a deterministic
//! `${clone_name}$mv` MutVec sibling for the accepted subset, reroutes only
//! those sites to it (`retarget_caller_calls`), and leaves the original PVec
//! clone intact for the rejected owned sites — never mutating the shared clone's
//! ABI in place (an owned-but-not-S4 caller of the same clone would otherwise hit
//! the `ref.cast` trap). All-accepted stays the in-place direct upgrade. Empty
//! `upgrades` (boot's own source has no qualifying shape) returns `spec.anf`
//! byte-identical, so self-host stays at its fixed point.

use compiler.anf.{AnfExpr, AnfFunctionDef, AnfMatchArm, AnfModule, AnfOp}
use compiler.backend.repr_policy.{ElemRepr, elem_repr_of_mono_key}
use compiler.builder_region_detect.{atom_is_local}
use compiler.builtins
use compiler.builtins.{BuiltinRegistry}
use compiler.codegen.mutvec_call_region
use compiler.codegen.mutvec_call_region.{MutVecCallExit, MutVecCallRegion}
use compiler.codegen.mutvec_call_verify.{
  clone_site_targets, func_def_of, sole_receiver_index, verify_region,
}
use compiler.codegen.mutvec_region.{MutVecRegion, collect_defs, rewrite_regions_in_func}
use compiler.codegen.variant_specialize
use compiler.codegen.variant_specialize.{SpecializeResult}
use compiler.core_ir.{FuncId, LocalId}
use compiler.elem_family.{elem_family_of, elem_family_suffix}
use compiler.variant_id as vid

pub type MutVecCallDecision = .{
  accepted: Vector<MutVecCallRegion>,
  module: AnfModule,
  spec: SpecializeResult,
  abi_upgrades: Vector<MutVecCallAbiUpgrade>,
}

// HP-4: an owned clone whose every routed site is an accepted S4 region —
// safe to type its receiver param + return as a flat `MutVec<fam>` instead of
// the persistent PVec ABI. `param_slots` holds the clone's own receiver LOCAL
// id(s) (today always exactly one entry — the sole receiver param a routed
// thread call resolves to, per `mutvec_call_verify.sole_receiver_index`); `fam` is the
// element family shared by every accepted caller of this clone (condition 5
// in `mutvec_call_verify` already proves caller/callee repr agreement per site, so one
// `fam` covers the whole clone).
pub type MutVecCallAbiUpgrade = .{
  clone_func: Int,
  param_slots: Vector<Int>,
  return_mutvec: Bool,
  fam: ElemRepr,
}

// One accepted thread call's clone attribution: which clone it routes to,
// which of the clone's own params is the receiver, and the element family.
// Recorded per accepted region so `build_mutvec_call_plan` can check each clone's
// accepted sites against the full `spec.routes` picture before committing to a
// direct upgrade vs a `$mv` sibling — a single accepted region is never
// sufficient on its own, since the same clone may have OTHER routed sites (other
// callers, or other regions in this same function) that were rejected.
type ThreadObservation = .{ clone_func: Int, recv_local: Int, fam: ElemRepr }

// Discover + verify every call-thread region across `spec.anf`'s functions,
// derive the HP-4 ABI-upgrade table from the accepted ones, and REWRITE the
// module: upgraded clone bodies + all-sites-upgraded caller regions move to
// flat `mutvec_*` ops (`apply_mutvec_call_rewrite`). `abi_upgrades` is the paired
// decision output the backend consumes via `mutvec_repr.apply_mutvec_call_abi_upgrades`
// to type the clone param/return + routed caller call-result slots MutVec.
pub fn run_mutvec_call(spec: SpecializeResult, b: BuiltinRegistry) MutVecCallDecision {
  accepted: Vector<MutVecCallRegion> = []
  accepted_sites: Dict<Int, Bool> = Dict.new()
  obs: Vector<ThreadObservation> = []

  // Accepted regions keyed by their caller function id, so the rewrite (below)
  // can re-locate every region back on the function it was discovered in
  // without re-running discovery. Program order preserved (append per func).
  accepted_by_func: Dict<Int, Vector<MutVecCallRegion>> = Dict.new()

  // Spec-invariant discovery inputs, built once and threaded through the scan.
  // `route_callers` gates the scan to the functions that actually call a routed
  // clone (the only ones that can host a thread region); `route_targets`/`len_id`
  // are the per-function-invariant tables `detect_call_thread_regions` otherwise
  // rebuilds ~4100 times.
  route_callers := mutvec_call_region.route_caller_funcs(spec)
  route_targets := mutvec_call_region.route_site_targets(spec)
  len_id := builtins.id(b, "vector$len").id

  for func in spec.anf.functions {
    if !route_callers.has(func.func_id.id) {
      continue
    }
    regions := mutvec_call_region.detect_call_thread_regions_with(func, route_targets, len_id, b)
    if regions.len() > 0 {
      defs := collect_defs(func.body, Dict.new())
      site_to_clone := clone_site_targets(spec)
      for r in regions {
        case verify_region(r, func, spec, b) {
          .Accept => {
            accepted = .append(r)
            for cr in r.thread_calls {
              accepted_sites[vid.site_key(func.func_id.id, cr)] = true
            }
            obs = .concat(region_observations(r, func, defs, site_to_clone, spec))
            accepted_by_func[func.func_id.id] = case accepted_by_func.get(func.func_id.id) {
              .Some(v) => v.append(r),
              .None => [r],
            }
          },
          .Reject(_) => {},
        }
      }
    }
  }

  // HP-5 (Task 6): partition each clone's routed sites into the accepted subset
  // and the rest. All-accepted → the original clone adopts the MutVec ABI
  // (Task 7's direct-upgrade path). A strict, non-empty accepted subset → a
  // fresh `${clone_name}$mv` sibling carries the MutVec ABI for the accepted
  // sites, the original clone stays persistent for the rest, and only the
  // accepted callers' calls reroute to the sibling. No accepted site → no
  // upgrade (persistent fallback). `plan` bundles the sibling defs, the
  // per-site retarget map, and the sibling-aware site→clone table.
  plan := build_mutvec_call_plan(spec, accepted_sites, obs)

  // Region-membership coupling (Task 7 gate), now evaluated against the
  // sibling-aware `aug_site_to_clone` so an accepted region that reroutes to a
  // sibling is checked for the sibling id, not the persistent original. In
  // slice-1 every accepted region threads exactly one clone (or its sibling),
  // so the gate never drops; it remains a defensive shrink-to-fixpoint against a
  // future multi-clone region (see `surviving_clones`).
  region_clone_sets := build_region_clone_sets(accepted_by_func, plan.aug_site_to_clone)
  keep := surviving_clones(
    collect u in plan.upgrades {
      u.clone_func
    },
    region_clone_sets,
  )
  final := finalize_plan(spec, plan, keep)

  .{
    accepted,
    module: apply_mutvec_call_rewrite(spec, final, accepted_by_func, b),
    spec,
    abi_upgrades: final.upgrades,
  }
}

// The partition plan produced by `build_mutvec_call_plan`: which clones/siblings adopt
// the MutVec ABI (`upgrades`), the sibling function defs to append to the module
// (`siblings`), the per-site call retarget map keyed by
// `vid.site_key(caller_func, call_result_local)` → sibling func id (`retarget`),
// and the sibling-aware site→clone table the region-flatten gate reads
// (`aug_site_to_clone` = `clone_site_targets(spec)` with every retargeted site
// remapped to its sibling).
type MutVecCallPlan = .{
  upgrades: Vector<MutVecCallAbiUpgrade>,
  siblings: Vector<AnfFunctionDef>,
  retarget: Dict<Int, Int>,
  aug_site_to_clone: Dict<Int, Int>,
}

fn max_func_id(m: AnfModule) Int {
  n := 0
  for f in m.functions {
    if f.func_id.id > n {
      n = f.func_id.id
    }
  }
  n
}

// Existing clone count per generic callee (each non-overflow route is one 8G
// clone), so a sibling only forms while the callee's variant family is still
// under the 8G `variant_cap` — the same demand-driven cap discipline, extended
// to the S4 sibling. Over the cap → no sibling → persistent fallback for that
// clone's accepted subset (a missed optimization, never an unsafe upgrade).
fn clones_per_generic(spec: SpecializeResult) Dict<Int, Int> {
  out: Dict<Int, Int> = Dict.new()
  for r in spec.routes {
    if r.clone_func >= 0 {
      out[r.generic_func] = case out.get(r.generic_func) {
        .Some(n) => n + 1,
        .None => 1,
      }
    }
  }
  out
}

// Build the HP-5 partition plan. For each routed clone with at least one
// accepted site: all-accepted → direct upgrade on the original clone; a strict
// subset → a MutVec sibling for the accepted sites (subject to the variant cap),
// original left persistent. `obs` supplies the receiver-local + element family
// (proven per accepted region in `verify_region`), reused for the sibling since
// it copies the original clone's params verbatim.
fn build_mutvec_call_plan(
  spec: SpecializeResult,
  accepted_sites: Dict<Int, Bool>,
  obs: Vector<ThreadObservation>,
) MutVecCallPlan {
  base := clone_site_targets(spec)
  aug := base
  next_id := max_func_id(spec.anf) + 1
  gen_count := clones_per_generic(spec)
  extra: Dict<Int, Int> = Dict.new()
  upgrades: Vector<MutVecCallAbiUpgrade> = []
  siblings: Vector<AnfFunctionDef> = []
  retarget: Dict<Int, Int> = Dict.new()
  for r in spec.routes {
    if r.route_sites.len() < 1 {
      continue
    }
    accepted_subset := r.route_sites.filter(fn(sk) { accepted_sites.has(sk) })
    if accepted_subset.len() == 0 {
      continue // no accepted site — persistent, no upgrade
    }
    o := case find_observation(obs, r.clone_func) {
      .Some(x) => x,
      .None => continue,
    }
    if accepted_subset.len() == r.route_sites.len() {
      // Every routed site accepted → upgrade the original clone in place.
      upgrades = .append(
        MutVecCallAbiUpgrade.{
          clone_func: r.clone_func,
          param_slots: [o.recv_local],
          return_mutvec: true,
          fam: o.fam,
        },
      )
    } else {
      // Strict subset → carve a MutVec sibling, keep the original persistent.
      existing := case gen_count.get(r.generic_func) {
        .Some(n) => n,
        .None => 0,
      }
      added := case extra.get(r.generic_func) {
        .Some(n) => n,
        .None => 0,
      }
      if existing + added >= variant_specialize.variant_cap {
        continue // cap reached — persistent fallback (never a partial unsafe upgrade)
      }
      orig := case func_def_of(spec, r.clone_func) {
        .Some(f) => f,
        .None => continue,
      }
      sib_id := next_id
      next_id = .inc()
      extra[r.generic_func] = added + 1
      siblings = .append(
        AnfFunctionDef.{
          func_id: .{ id: sib_id },
          name: "${r.clone_name}$mv",
          is_init: false,
          params: orig.params,
          op_result_mono: orig.op_result_mono,
          body: orig.body,
          return_ty: orig.return_ty,
        },
      )
      upgrades = .append(
        MutVecCallAbiUpgrade.{
          clone_func: sib_id,
          param_slots: [o.recv_local],
          return_mutvec: true,
          fam: o.fam,
        },
      )
      for sk in accepted_subset {
        retarget[sk] = sib_id
        aug[sk] = sib_id
      }
    }
  }
  .{ upgrades, siblings, retarget, aug_site_to_clone: aug }
}

// Restrict a plan to the clones/siblings that survived the region-membership
// gate. A dropped clone loses its upgrade, its sibling (if any), and its
// retargets, so the accepted subset reverts to the persistent original — the
// `aug_site_to_clone` is rebuilt from the base table plus only the surviving
// retargets. Sound because it only ever removes upgrades (reject-by-default).
fn finalize_plan(spec: SpecializeResult, plan: MutVecCallPlan, keep: Dict<Int, Bool>) MutVecCallPlan {
  upgrades := plan.upgrades.filter(fn(u) { keep.has(u.clone_func) })
  siblings := plan.siblings.filter(fn(s) { keep.has(s.func_id.id) })
  retarget: Dict<Int, Int> = Dict.new()
  aug := clone_site_targets(spec)
  for sk, sid in plan.retarget {
    if keep.has(sid) {
      retarget[sk] = sid
      aug[sk] = sid
    }
  }
  .{ upgrades, siblings, retarget, aug_site_to_clone: aug }
}

// The clone ids each accepted region threads, one inner vector per region
// (order irrelevant — the consumer is a set fixpoint). Fed the sibling-aware
// `aug_site_to_clone`, so a partition-accepted thread call contributes its
// SIBLING id (the id that is actually a candidate), keeping this gate consistent
// with `region_all_upgraded` (which reads the same table). A thread call whose
// site key resolves to no clone is skipped here while `region_all_upgraded`
// treats it as disqualifying; that skip/reject asymmetry stays sound because (a)
// `verify_region` (mutvec_call_verify.tw) rejects any accepted region carrying a
// `.None`-resolving thread call, so an accepted region never has one, and (b)
// `aug` only ever REMAPS existing keys to siblings — it removes none — so it
// introduces no new `.None`.
fn build_region_clone_sets(
  accepted_by_func: Dict<Int, Vector<MutVecCallRegion>>,
  site_to_clone: Dict<Int, Int>,
) Vector<Vector<Int>> {
  out: Vector<Vector<Int>> = []
  for func_id, regions in accepted_by_func {
    for r in regions {
      clones: Vector<Int> = []
      for cr in r.thread_calls {
        case site_to_clone.get(vid.site_key(func_id, cr)) {
          .Some(c) => clones = .append(c),
          .None => {},
        }
      }
      out = .append(clones)
    }
  }
  out
}

// The subset of `candidates` (clone ids) that survive the region-membership
// coupling: drop every clone that shares an accepted region with any clone not
// (yet) surviving, iterated to a fixpoint. Sound because it only ever SHRINKS
// the surviving set, and at the fixpoint every region touching a surviving
// clone touches exclusively surviving clones — so that region is fully
// upgradeable (its `region_all_upgraded` holds) and its producer is rewritten
// to MutVec, matching the clone's MutVec ABI. `pub` for direct unit coverage of
// this core predicate independent of a full discovery/verify walk.
//
// With Task 6's per-site siblings this DROP path is provably unreachable in
// slice-1: any clone threaded by an ACCEPTED region necessarily has that thread
// site accepted, so it always earns an upgrade (direct or via a `$mv` sibling)
// and the region reroutes to upgradeable targets — every member of every region
// set is a candidate, so nothing is ever dropped. The gate is kept as a
// defensive invariant (multi-hop / future slices) with its own unit coverage.
pub fn surviving_clones(candidates: Vector<Int>, region_clone_sets: Vector<Vector<Int>>) Dict<
  Int,
  Bool,
> {
  u: Dict<Int, Bool> = Dict.new()
  for c in candidates {
    u[c] = true
  }
  changed := true
  for changed {
    changed = false
    for clones in region_clone_sets {
      any_out := false
      for c in clones {
        if !u.has(c) {
          any_out = true
        }
      }
      if any_out {
        for c in clones {
          if u.has(c) {
            u = .remove(c)
            changed = true
          }
        }
      }
    }
  }
  u
}

// ── S4 rewrite: caller producer chain + clone body → flat MutVec ──────────
// Turns the DECISION (`upgrades` + accepted regions) into actual ANF. Two
// coordinated edits that MUST land together (typing a clone's param/return
// MutVec without rewriting its body ops is unsound — no MutVec↔PVec coercion
// bridge exists; see `mutvec_repr.tw`'s header):
//   1. Every upgraded clone body: `set_unsafe`/`get`/`len`/`AIndex` on the
//      receiver → the family's `mutvec_*` op (the receiver becomes a flat
//      handle; its `assign recv = <write result>` reclaim + tail `return recv`
//      are untouched — `mutvec_repr` types the param + `phys_return` MutVec).
//   2. Every accepted caller region WHOSE thread calls all route to an upgraded
//      clone: the `collect`/`make` producer flattens to a mutvec builder (no
//      freeze for a Scratch exit; exactly one boundary `mutvec_freeze` for an
//      EscapeReturn), `flags[i]` → mutvec_get, the threaded clone call + its
//      `flags = <result>` rebind pass through unchanged (the handle stays flat
//      across the boundary — the whole point, and the zero-in-loop-freeze
//      invariant the parity gate guards).
// A region whose clone was NOT upgraded (a mixed owned/generic caller — the
// HP-5 partition case, Task 6) is left persistent: rewriting the caller to
// expect a MutVec-returning clone while the clone stays PVec would trap.
// `upgrades` empty (boot's own source — no qualifying S4 shape) → `spec.anf`
// returned unchanged, byte-identical, so self-host stays at the fixed point.
fn apply_mutvec_call_rewrite(
  spec: SpecializeResult,
  plan: MutVecCallPlan,
  accepted_by_func: Dict<Int, Vector<MutVecCallRegion>>,
  b: BuiltinRegistry,
) AnfModule {
  if plan.upgrades.len() == 0 {
    return spec.anf
  }
  upgraded: Dict<Int, Bool> = Dict.new()
  for u in plan.upgrades {
    upgraded[u.clone_func] = true
  }
  m := spec.anf

  // Append every MutVec sibling so downstream passes (closure conversion,
  // backend prepare) see it as a real module function; its body is rewritten to
  // flat ops in the same `collect` below (it is in `upgraded`).
  for s in plan.siblings {
    m.functions = .append(s)
  }
  m.functions = collect f in m.functions {
    // 1. Reroute only the accepted (partition) call sites in this caller from
    //    the persistent original clone to its MutVec sibling. Keyed per site, so
    //    a non-accepted owned site to the same clone is untouched. A no-op for
    //    functions with no retargeted site (empty `retarget` → early return).
    f0 := retarget_caller_calls(f, plan.retarget)

    // 2. Upgraded clone/sibling body → flat `mutvec_*` receiver ops.
    f1 := if upgraded.has(f0.func_id.id) {
      rewrite_clone_for(f0, plan.upgrades, b)
    } else {
      f0
    }

    // 3. Accepted caller region whose thread calls all route (via the
    //    sibling-aware `aug_site_to_clone`) to an upgraded clone → flatten its
    //    producer chain.
    case accepted_by_func.get(f1.func_id.id) {
      .Some(regs) => rewrite_caller_regions(f1, regs, plan.aug_site_to_clone, upgraded, b),
      .None => f1,
    }
  }
  m
}

// Reroute the accepted (partition) call sites of `f` from the persistent
// original clone to its MutVec sibling. `retarget` is keyed by
// `vid.site_key(caller_func, call_result_local)`, so the walk changes exactly
// the calls whose result local matches an accepted site — a non-accepted owned
// site to the same original clone (the reject half of the partition) keeps its
// persistent target. Empty `retarget` (the all-accepted or no-partition case) →
// `f` unchanged, preserving byte-identity for boot and the sieve direct path.
fn retarget_caller_calls(f: AnfFunctionDef, retarget: Dict<Int, Int>) AnfFunctionDef {
  if retarget.keys().len() == 0 {
    return f
  }
  f.body = retarget_expr(f.body, f.func_id.id, retarget)
  f
}

fn retarget_expr(e: AnfExpr, func_id: Int, retarget: Dict<Int, Int>) AnfExpr {
  case e {
    .Let(local, op, sp, body) => .Let(
      local,
      retarget_op(local, func_id, op, retarget),
      sp,
      retarget_expr(body, func_id, retarget),
    ),
    _ => e,
  }
}

fn retarget_op(local: LocalId, func_id: Int, op: AnfOp, retarget: Dict<Int, Int>) AnfOp {
  case op {
    .ACall(.AGlobalFunc(_), args) => case retarget.get(vid.site_key(func_id, local.id)) {
      .Some(sib) => .ACall(.AGlobalFunc(FuncId.{ id: sib }), args),
      .None => op,
    },
    .AIf(cnd, t, e) => .AIf(
      cnd,
      retarget_expr(t, func_id, retarget),
      retarget_expr(e, func_id, retarget),
    ),
    .AMatch(scrut, arms) => .AMatch(
      scrut,
      collect arm in arms {
        AnfMatchArm.{ pattern: arm.pattern, body: retarget_expr(arm.body, func_id, retarget) }
      },
    ),
    .ALoop(body) => .ALoop(retarget_expr(body, func_id, retarget)),
    .ADefer(body) => .ADefer(retarget_expr(body, func_id, retarget)),
    _ => op,
  }
}

// Rewrite each accepted caller region in `f` whose thread calls all route to an
// upgraded clone. Builds the `MutVecRegion` the S2 lowering consumes (same
// builder-chain flattening, index-read swap, and escape-gated boundary freeze)
// from the MutVecCallRegion's producer + exit kind, then reuses
// `mutvec_region.rewrite_regions_in_func` verbatim.
fn rewrite_caller_regions(
  f: AnfFunctionDef,
  regs: Vector<MutVecCallRegion>,
  site_to_clone: Dict<Int, Int>,
  upgraded: Dict<Int, Bool>,
  b: BuiltinRegistry,
) AnfFunctionDef {
  mregions: Vector<MutVecRegion> = []
  for r in regs {
    if region_all_upgraded(r, f.func_id.id, site_to_clone, upgraded) {
      suffix := case handle_family_suffix(f, r.handle) {
        .Some(s) => s,
        .None => continue, // no registered family — leave persistent
      }
      mregions = .append(
        MutVecRegion.{
          func_id: f.func_id,
          func: f.name,
          proof_id: "s4:${f.func_id.id.to_string()}:${r.handle.id.to_string()}",
          handle: r.handle,
          producer: r.producer,
          op_sites: [],
          escapes: exit_escapes(r.exit_kind),
          family: suffix,
        },
      )
    }
  }
  if mregions.len() == 0 {
    f
  } else {
    rewrite_regions_in_func(f, mregions, b)
  }
}

fn exit_escapes(k: MutVecCallExit) Bool {
  case k {
    .Scratch => false,
    .EscapeReturn => true,
  }
}

// True iff every thread call in `region` routes to a clone in `upgraded`.
fn region_all_upgraded(
  region: MutVecCallRegion,
  func_id: Int,
  site_to_clone: Dict<Int, Int>,
  upgraded: Dict<Int, Bool>,
) Bool {
  for cr in region.thread_calls {
    case site_to_clone.get(vid.site_key(func_id, cr)) {
      .Some(clone) => if !upgraded.has(clone) {
        return false
      },
      .None => return false,
    }
  }
  true
}

// The mutvec family suffix (`"_bool"`) of a caller handle, from its recorded
// vector mono. `.None` when the handle has no registered element family.
fn handle_family_suffix(f: AnfFunctionDef, handle: LocalId) String? {
  case f.op_result_mono.get(handle.id) {
    .Some(mono) => elem_family_suffix(mono),
    .None => .None,
  }
}

// Rewrite every upgraded-clone receiver in `clone` to flat mutvec ops. The
// receiver locals come from `upgrades` (this clone's `param_slots`); the family
// suffix is read off each receiver param's own mono, so no i64 hard-coding.
fn rewrite_clone_for(
  clone: AnfFunctionDef,
  upgrades: Vector<MutVecCallAbiUpgrade>,
  b: BuiltinRegistry,
) AnfFunctionDef {
  cur := clone
  for u in upgrades {
    if u.clone_func == clone.func_id.id {
      for recv_local in u.param_slots {
        recv := LocalId.{ id: recv_local }
        case recv_param_suffix(cur, recv) {
          .Some(suffix) => cur = rewrite_clone_body(cur, recv, suffix, b),
          .None => {},
        }
      }
    }
  }
  cur
}

fn recv_param_suffix(clone: AnfFunctionDef, recv: LocalId) String? {
  for p in clone.params {
    if p.local.id == recv.id {
      return elem_family_suffix(p.ty)
    }
  }
  .None
}

// Op ids the clone-body rewrite keys on: the generic boxed ops it swaps FROM
// and the family's flat mutvec ops it swaps TO.
type CloneRwIds = .{ set_unsafe: Int, get: Int, len: Int, mset: FuncId, mget: FuncId, mlen: FuncId }

fn rewrite_clone_body(clone: AnfFunctionDef, recv: LocalId, suffix: String, b: BuiltinRegistry) AnfFunctionDef {
  ids: CloneRwIds = .{
    set_unsafe: builtins.id(b, "vector$set_unsafe").id,
    get: builtins.id(b, "vector$get").id,
    len: builtins.id(b, "vector$len").id,
    mset: builtins.id(b, "vector$__mutvec_set${suffix}"),
    mget: builtins.id(b, "vector$__mutvec_get${suffix}"),
    mlen: builtins.id(b, "vector$__mutvec_len${suffix}"),
  }
  clone.body = rewrite_clone_expr(clone.body, recv, ids)
  clone
}

fn rewrite_clone_expr(e: AnfExpr, recv: LocalId, ids: CloneRwIds) AnfExpr {
  case e {
    .Let(local, op, sp, body) => .Let(
      local,
      rewrite_clone_op(op, recv, ids),
      sp,
      rewrite_clone_expr(body, recv, ids),
    ),
    _ => e,
  }
}

fn rewrite_clone_op(op: AnfOp, recv: LocalId, ids: CloneRwIds) AnfOp {
  case op {
    .ACall(.AGlobalFunc(f), args) => cond {
      f.id == ids.set_unsafe and args.len() == 3 and atom_is_local(args[0], recv) => .ACall(
        .AGlobalFunc(ids.mset),
        args,
      ),
      f.id == ids.get and args.len() == 2 and atom_is_local(args[0], recv) => .ACall(
        .AGlobalFunc(ids.mget),
        args,
      ),
      f.id == ids.len and args.len() == 1 and atom_is_local(args[0], recv) => .ACall(
        .AGlobalFunc(ids.mlen),
        args,
      ),
      _ => op,
    },
    .AIndex(base, idx, .Array, _) => if atom_is_local(base, recv) and !atom_is_local(idx, recv) {
      .ACall(.AGlobalFunc(ids.mget), [base, idx])
    } else {
      op
    },
    .AIf(cnd, t, e) => .AIf(cnd, rewrite_clone_expr(t, recv, ids), rewrite_clone_expr(e, recv, ids)),
    .AMatch(scrut, arms) => .AMatch(
      scrut,
      collect arm in arms {
        AnfMatchArm.{ pattern: arm.pattern, body: rewrite_clone_expr(arm.body, recv, ids) }
      },
    ),
    .ALoop(body) => .ALoop(rewrite_clone_expr(body, recv, ids)),
    .ADefer(body) => .ADefer(rewrite_clone_expr(body, recv, ids)),
    _ => op,
  }
}

// The element family of `handle_id` in `func`, projected to the `ElemRepr`
// tag `mutvec_repr`'s slot typing already uses. `.None` when the family
// can't be resolved (no mono recorded, or not a registered element family) —
// treated by the caller as "cannot prove a repr", the same reject-by-default
// posture `mutvec_call_verify.repr_agrees` takes for its own condition-5 check.
fn handle_elem_repr(func: AnfFunctionDef, handle_id: Int) ElemRepr? {
  case func.op_result_mono.get(handle_id) {
    .Some(ty) => case elem_family_of(ty) {
      .Some(fam) => elem_repr_of_mono_key(fam.mono_key),
      .None => .None,
    },
    .None => .None,
  }
}

// Every thread call in an ACCEPTED region, resolved to its clone + receiver
// param + element family. Mirrors the exact same site-key/clone/receiver-index
// lookups `mutvec_call_verify.verify_region` already performed to accept this region
// (reusing its own `clone_site_targets`/`func_def_of`/`sole_receiver_index`),
// so this recomputation can never disagree with what was actually verified.
fn region_observations(
  region: MutVecCallRegion,
  func: AnfFunctionDef,
  defs: Dict<Int, AnfOp>,
  site_to_clone: Dict<Int, Int>,
  spec: SpecializeResult,
) Vector<ThreadObservation> {
  fam := case handle_elem_repr(func, region.handle.id) {
    .Some(f) => f,
    .None => return [],
  }
  out: Vector<ThreadObservation> = []
  for cr in region.thread_calls {
    case defs.get(cr) {
      .Some(call_op) => case site_to_clone.get(vid.site_key(func.func_id.id, cr)) {
        .Some(clone_id) => case sole_receiver_index(call_op, region.handle) {
          .Some(idx) => case func_def_of(spec, clone_id) {
            .Some(clone) => if idx < clone.params.len() {
              out = .append(
                ThreadObservation.{
                  clone_func: clone_id,
                  recv_local: clone.params[idx].local.id,
                  fam,
                },
              )
            },
            .None => {},
          },
          .None => {},
        },
        .None => {},
      },
      .None => {},
    }
  }
  out
}

// `pub` so the guard's core predicate — "every site, not a majority" — has
// direct unit coverage independent of a full SpecializeResult/discovery
// walk (see mutvec_call_suite.tw).
pub fn all_sites_accepted(route_sites: Vector<Int>, accepted_sites: Dict<Int, Bool>) Bool {
  for sk in route_sites {
    if !accepted_sites.has(sk) {
      return false
    }
  }
  true
}

fn find_observation(obs: Vector<ThreadObservation>, clone_func: Int) ThreadObservation? {
  for o in obs {
    if o.clone_func == clone_func {
      return .Some(o)
    }
  }
  .None
}
