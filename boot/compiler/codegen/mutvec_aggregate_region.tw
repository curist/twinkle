//! Analysis-only candidates for a vector threaded through a recursive record.
//! These pre-clone summary/seed observations are NOT a mutation certificate.
//! Clone-local ownership recomputation must precede any future ABI rewrite.

use compiler.anf.{AnfExpr, AnfFunctionDef, AnfModule, AnfOp, Atom}
use compiler.builder_region_detect.{op_references_deep}
use compiler.builtins.{BuiltinRegistry}
use compiler.codegen.variant_route
use compiler.codegen.variant_specialize
use compiler.core_ir.{FieldId, FuncId, LocalId}
use compiler.elem_family
use compiler.mono_type.{MonoType, TypeId}
use compiler.variant_id as vid

pub type AggregateMutVecExit = { DeadField, PublishRecord, PublishField }

pub type AggregateScalarField = .{ field: FieldId, mono: MonoType }

pub type AggregateMutVecRegion = .{
  caller_func: FuncId,
  generic_func: FuncId,
  clone_func: FuncId,
  carrier_param: Int,
  carrier_type: TypeId,
  vector_field: FieldId,
  family: String,
  vector_mono: MonoType,
  scalar_fields: Vector<AggregateScalarField>,
  entry_call: LocalId,
  recursive_calls: Vector<LocalId>,
  exit: AggregateMutVecExit,
  proof_id: String,
}

// Per-detection lookup tables, built ONCE (one module pass) and threaded through
// so no candidate re-scans the module. Without this, the clone lookup (per route)
// and `find_entry` (per candidate) each walk every function — turning detection
// into O(routes × functions × body), catastrophic once detection runs on every
// compile (`mutvec_call_phase.run_aggregate`) rather than only in `--census`.
type DetectCtx = .{ funcs: Dict<Int, AnfFunctionDef>, entries: Dict<Int, EntrySite> }

fn build_detect_ctx(anf: AnfModule) DetectCtx {
  funcs: Dict<Int, AnfFunctionDef> = Dict.new()
  entries: Dict<Int, EntrySite> = Dict.new()
  for f in anf.functions {
    funcs[f.func_id.id] = f

    // Direct O(body) walk — NOT `collect_ops`, whose repeated `.concat` down the
    // let-chain is O(body²) per function (→ O(functions × body²) here, the hot
    // per-compile cost that made the bundle hang under stage1-under-deno).
    entries = index_call_sites(f.func_id, f, f.body, entries)
  }
  .{ funcs, entries }
}

fn index_call_sites(
  func_id: FuncId,
  caller: AnfFunctionDef,
  e: AnfExpr,
  entries: Dict<Int, EntrySite>,
) Dict<Int, EntrySite> {
  case e {
    .Let(l, op, _, body) => {
      after := if is_call(op) {
        sk := vid.site_key(func_id.id, l.id)

        // First writer wins, matching the old first-match `find_entry` scan.
        case entries.get(sk) {
          .Some(_) => entries,
          .None => {
            entries[sk] = EntrySite.{ func: func_id, caller, local: .{ id: l.id } }
            entries
          },
        }
      } else {
        entries
      }
      index_call_sites(func_id, caller, body, index_call_sites_in_op(func_id, caller, op, after))
    },
    _ => entries,
  }
}

fn index_call_sites_in_op(
  func_id: FuncId,
  caller: AnfFunctionDef,
  op: AnfOp,
  entries: Dict<Int, EntrySite>,
) Dict<Int, EntrySite> {
  case op {
    .AIf(_, t, e) => index_call_sites(
      func_id,
      caller,
      e,
      index_call_sites(func_id, caller, t, entries),
    ),
    .AMatch(_, arms) => {
      cur := entries
      for arm in arms {
        cur = index_call_sites(func_id, caller, arm.body, cur)
      }
      cur
    },
    .ALoop(b) => index_call_sites(func_id, caller, b, entries),
    .ADefer(b) => index_call_sites(func_id, caller, b, entries),
    _ => entries,
  }
}

// One candidate region per routed owned reconstruction clone whose carrier has a
// single collection field. Sound-by-rejection: a region only NAMES a shape (which
// param carries the record, which field is the private vector, how it recurses,
// how the entry caller observes the result); it licenses no mutation on its own.
pub fn detect_aggregate_regions(
  spec: variant_specialize.SpecializeResult,
  _builtins: BuiltinRegistry,
) Vector<AggregateMutVecRegion> {
  ctx := build_detect_ctx(spec.anf)
  out: Vector<AggregateMutVecRegion> = []
  for r in spec.routes {
    case r.fallback_reason {
      .Some(_) => continue,
      .None => {},
    }
    if r.clone_func < 0 {
      continue
    }
    clone := case ctx.funcs.get(r.clone_func) {
      .Some(f) => f,
      .None => continue,
    }
    case ctx.build_region(spec, clone, r) {
      .Some(region) => out = .append(region),
      .None => {},
    }
  }
  out
}

fn build_region(
  ctx: DetectCtx,
  spec: variant_specialize.SpecializeResult,
  clone: AnfFunctionDef,
  r: variant_route.VariantRoute,
) AggregateMutVecRegion? {
  owned := owned_params(r.variant)
  for k in 0..clone.params.len() {
    if !int_has(owned, k) {
      continue
    }
    tid := case clone.params[k].ty {
      .Named(t, _) => t,
      _ => continue,
    }
    field_monos := collect_field_monos(clone, tid)
    vec := single_vector_field(field_monos)
    case vec {
      .Some(vf) => return .Some(ctx.assemble_region(spec, clone, r, k, tid, vf, field_monos)),
      .None => {},
    }
  }
  .None
}

type VecField = .{ field: Int, family: String, mono: MonoType }

// Exactly one collection field may claim the private handle. Zero or several
// leaves the carrier persistent (the plan's single-vector constraint).
fn single_vector_field(field_monos: Dict<Int, MonoType>) VecField? {
  found: VecField? = .None
  for field, mono in field_monos {
    case elem_family.elem_family_suffix(mono) {
      .Some(_) => case elem_family.elem_family_of(mono) {
        .Some(fam) => case found {
          .Some(_) => return .None,
          .None => found = .Some(VecField.{ field, family: fam.mono_key, mono }),
        },
        .None => {},
      },
      .None => {},
    }
  }
  found
}

fn assemble_region(
  ctx: DetectCtx,
  spec: variant_specialize.SpecializeResult,
  clone: AnfFunctionDef,
  r: variant_route.VariantRoute,
  carrier_param: Int,
  tid: TypeId,
  vec: VecField,
  field_monos: Dict<Int, MonoType>,
) AggregateMutVecRegion {
  scalars: Vector<AggregateScalarField> = []
  for field in sorted_int_keys(field_monos) {
    if field == vec.field {
      continue
    }
    case field_monos.get(field) {
      .Some(mono) => scalars = .append(AggregateScalarField.{ field: .{ id: field }, mono }),
      .None => {},
    }
  }

  rec_set := int_set(r.recursive_routes)
  recursive_calls: Vector<LocalId> = []
  for e in collect_ops(clone.body) {
    if is_call(e.op) and int_has(rec_set, vid.site_key(r.clone_func, e.local)) {
      recursive_calls = .append(LocalId.{ id: e.local })
    }
  }

  entry := find_entry(ctx.entries, r.route_sites)
  case entry {
    .Some(en) => .{
      caller_func: en.func,
      generic_func: .{ id: r.generic_func },
      clone_func: .{ id: r.clone_func },
      carrier_param,
      carrier_type: tid,
      vector_field: .{ id: vec.field },
      family: vec.family,
      vector_mono: vec.mono,
      scalar_fields: scalars,
      entry_call: en.local,
      recursive_calls,
      exit: classify_exit(en.caller, en.local, vec.field),
      proof_id: r.proof_debug_id,
    },
    // A non-entry SCC member is reached only through a peer clone; its result is
    // threaded onward, never published here, so it is dead at this level.
    .None => .{
      caller_func: .{ id: 0 - 1 },
      generic_func: .{ id: r.generic_func },
      clone_func: .{ id: r.clone_func },
      carrier_param,
      carrier_type: tid,
      vector_field: .{ id: vec.field },
      family: vec.family,
      vector_mono: vec.mono,
      scalar_fields: scalars,
      entry_call: .{ id: 0 - 1 },
      recursive_calls,
      exit: .DeadField,
      proof_id: r.proof_debug_id,
    },
  }
}

type EntrySite = .{ func: FuncId, caller: AnfFunctionDef, local: LocalId }

// The routed caller sites live in `site_key(caller_func, call_result_local)`
// space; `entries` is the precomputed site_key → EntrySite map (one module pass),
// so this is a lookup per route site rather than a full-module scan per candidate.
fn find_entry(entries: Dict<Int, EntrySite>, route_sites: Vector<Int>) EntrySite? {
  for sk in route_sites {
    case entries.get(sk) {
      .Some(en) => return .Some(en),
      .None => {},
    }
  }
  .None
}

// How the entry caller observes the returned carrier:
//   - the whole record reaches a result position      -> PublishRecord
//   - only its vector projection reaches a result      -> PublishField
//   - neither (scalar reads only, record dies)         -> DeadField
fn classify_exit(caller: AnfFunctionDef, entry_local: LocalId, vector_field: Int) AggregateMutVecExit {
  carrier := int_set([entry_local.id])
  projections: Vector<Int> = []
  record_observed := false
  for e in collect_ops(caller.body) {
    case e.op {
      .AInit(a) => case atom_local(a) {
        .Some(id) => if int_has(carrier, id) {
          carrier[e.local] = true
          record_observed = true
        },
        .None => {},
      },
      .ARecordGet(base, field, _) => case atom_local(base) {
        .Some(id) => if int_has(carrier, id) and field.id == vector_field {
          projections = .append(e.local)
        },
        .None => {},
      },
      _ => {
        for id, _present in carrier {
          if op_references_deep(e.op, .{ id }) {
            record_observed = true
          }
        }
      },
    }
  }
  record_returned := false
  field_returned := false
  for a in result_atoms(caller.body) {
    case atom_local(a) {
      .Some(id) => {
        if int_has(carrier, id) {
          record_returned = true
        }
        if int_contains(projections, id) {
          field_returned = true
        }
      },
      .None => {},
    }
  }
  cond {
    record_returned or record_observed => .PublishRecord,
    field_returned or projections.len() > 0 => .PublishField,
    _ => .DeadField,
  }
}

// ── ANF traversal helpers ───────────────────────────────────────────
type OpEntry = .{ local: Int, op: AnfOp }

fn collect_ops(e: AnfExpr) Vector<OpEntry> {
  case e {
    .Let(l, op, _, body) => {
      out: Vector<OpEntry> = [OpEntry.{ local: l.id, op }]
      out = .concat(ops_in_op(op))
      out.concat(collect_ops(body))
    },
    _ => [],
  }
}

fn ops_in_op(op: AnfOp) Vector<OpEntry> {
  case op {
    .AIf(_, t, e) => collect_ops(t).concat(collect_ops(e)),
    .AMatch(_, arms) => {
      out: Vector<OpEntry> = []
      for arm in arms {
        out = .concat(collect_ops(arm.body))
      }
      out
    },
    .ALoop(body) => collect_ops(body),
    .ADefer(body) => collect_ops(body),
    _ => [],
  }
}

// Atoms in a result position: the tail atom, and every explicit Return/Break,
// recursing into nested control so a branch-local return is not missed.
fn result_atoms(e: AnfExpr) Vector<Atom> {
  case e {
    .Let(_, op, _, body) => result_atoms_in_op(op).concat(result_atoms(body)),
    .Atom(a) => [a],
    .Return(ma) => case ma {
      .Some(a) => [a],
      .None => [],
    },
    .Break(ma) => case ma {
      .Some(a) => [a],
      .None => [],
    },
    .Continue => [],
  }
}

fn result_atoms_in_op(op: AnfOp) Vector<Atom> {
  case op {
    .AIf(_, t, e) => result_atoms(t).concat(result_atoms(e)),
    .AMatch(_, arms) => {
      out: Vector<Atom> = []
      for arm in arms {
        out = .concat(result_atoms(arm.body))
      }
      out
    },
    .ALoop(body) => result_atoms(body),
    .ADefer(body) => result_atoms(body),
    _ => [],
  }
}

fn collect_field_monos(f: AnfFunctionDef, tid: TypeId) Dict<Int, MonoType> {
  out: Dict<Int, MonoType> = Dict.new()
  for e in collect_ops(f.body) {
    case e.op {
      .ARecordGet(_, field, t) => if t.id == tid.id {
        case f.op_result_mono.get(e.local) {
          .Some(m) => out[field.id] = m,
          .None => {},
        }
      },
      .ARecordUpdate(_, field, value, _, t) => if t.id == tid.id {
        case atom_mono(f, value) {
          .Some(m) => out[field.id] = m,
          .None => {},
        }
      },
      .ARecord(t, fields) => if t.id == tid.id {
        for fa in fields {
          case atom_mono(f, fa.value) {
            .Some(m) => out[fa.field.id] = m,
            .None => {},
          }
        }
      },
      _ => {},
    }
  }
  out
}

fn atom_mono(f: AnfFunctionDef, a: Atom) MonoType? {
  case a {
    .ALocal(l) => case f.op_result_mono.get(l.id) {
      .Some(m) => .Some(m),
      .None => param_mono(f, l.id),
    },
    .ALitInt(_) => .Some(.Int),
    .ALitFloat(_) => .Some(.Float),
    .ALitBool(_) => .Some(.Bool),
    _ => .None,
  }
}

fn param_mono(f: AnfFunctionDef, id: Int) MonoType? {
  for p in f.params {
    if p.local.id == id {
      return .Some(p.ty)
    }
  }
  .None
}

fn is_call(op: AnfOp) Bool {
  case op {
    .ACall(_, _) => true,
    _ => false,
  }
}

fn atom_local(a: Atom) Int? {
  case a {
    .ALocal(l) => .Some(l.id),
    _ => .None,
  }
}

fn owned_params(v: vid.VariantId) Dict<Int, Bool> {
  out: Dict<Int, Bool> = Dict.new()
  for req in v.unique {
    out[req.param] = true
  }
  out
}

// ── small int-set / int-key helpers ─────────────────────────────────
fn int_set(xs: Vector<Int>) Dict<Int, Bool> {
  out: Dict<Int, Bool> = Dict.new()
  for x in xs {
    out[x] = true
  }
  out
}

fn int_has(m: Dict<Int, Bool>, k: Int) Bool {
  case m.get(k) {
    .Some(v) => v,
    .None => false,
  }
}

fn int_contains(xs: Vector<Int>, k: Int) Bool {
  for x in xs {
    if x == k {
      return true
    }
  }
  false
}

fn sorted_int_keys(m: Dict<Int, MonoType>) Vector<Int> {
  keys: Vector<Int> = []
  for k, _v in m {
    keys = .append(k)
  }
  keys.sort_by(fn(a, b) { a.compare(b) })
}
