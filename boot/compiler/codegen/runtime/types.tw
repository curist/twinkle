//! rt.types — shared Wasm GC type definitions for the Twinkle runtime.
//!
//! Mirrors stage0 src/runtime/types.rs.
//! This module defines no functions — only type definitions that all
//! other runtime modules reference.

use compiler.codegen.wasm_ir.{WasmModule}

pub fn module() WasmModule {
  .{
    namespace: "rt.types",
    types: [
      .Array("Array", .{ name: .None, mutable: true, ty: .Anyref }),
      .Array("String", .{ name: .None, mutable: true, ty: .I8 }),
      .Struct(
        "StrBuilder",
        [
          .{ name: .Some("len"), mutable: true, ty: .I32 },
          .{ name: .Some("buf"), mutable: true, ty: .Ref(false, .Named("String")) },
        ],
        .None,
        true,
      ),
      .Array("VecChildren", .{ name: .None, mutable: true, ty: .Ref(true, .Eq) }),
      .Array("I32Array", .{ name: .None, mutable: true, ty: .I32 }),
      .Array("ArrayI64", .{ name: .None, mutable: true, ty: .I64 }),
      .Array("ArrayBool", .{ name: .None, mutable: true, ty: .I32 }),
      .Array("ArrayF64", .{ name: .None, mutable: true, ty: .F64 }),
      // Packed 1-byte leaf array backing PVecByte/MutVecByte — reads via
      // array.get_u (unsigned) since i8 storage sign-extends otherwise.
      .Array("ArrayByte", .{ name: .None, mutable: true, ty: .I8 }),
      .Struct(
        "VecInternal",
        [
          .{ name: .Some("children"), mutable: false, ty: .Ref(false, .Named("VecChildren")) },
          .{ name: .Some("sizes"), mutable: false, ty: .Ref(true, .Named("I32Array")) },
        ],
        .None,
        true,
      ),
      .Struct(
        "PVec",
        [
          .{ name: .Some("len"), mutable: false, ty: .I32 },
          .{ name: .Some("shift"), mutable: false, ty: .I32 },
          .{ name: .Some("root"), mutable: false, ty: .Ref(true, .Named("VecInternal")) },
          .{ name: .Some("tail"), mutable: false, ty: .Ref(false, .Named("Array")) },
        ],
        .None,
        true,
      ),
      .Struct(
        "PVecI64",
        [
          .{ name: .Some("len"), mutable: false, ty: .I32 },
          .{ name: .Some("shift"), mutable: false, ty: .I32 },
          .{ name: .Some("root"), mutable: false, ty: .Ref(true, .Named("VecInternal")) },
          .{ name: .Some("tail"), mutable: false, ty: .Ref(false, .Named("ArrayI64")) },
        ],
        .None,
        true,
      ),
      .Struct(
        "PVecBool",
        [
          .{ name: .Some("len"), mutable: false, ty: .I32 },
          .{ name: .Some("shift"), mutable: false, ty: .I32 },
          .{ name: .Some("root"), mutable: false, ty: .Ref(true, .Named("VecInternal")) },
          .{ name: .Some("tail"), mutable: false, ty: .Ref(false, .Named("ArrayBool")) },
        ],
        .None,
        true,
      ),
      .Struct(
        "PVecF64",
        [
          .{ name: .Some("len"), mutable: false, ty: .I32 },
          .{ name: .Some("shift"), mutable: false, ty: .I32 },
          .{ name: .Some("root"), mutable: false, ty: .Ref(true, .Named("VecInternal")) },
          .{ name: .Some("tail"), mutable: false, ty: .Ref(false, .Named("ArrayF64")) },
        ],
        .None,
        true,
      ),
      .Struct(
        "PVecByte",
        [
          .{ name: .Some("len"), mutable: false, ty: .I32 },
          .{ name: .Some("shift"), mutable: false, ty: .I32 },
          .{ name: .Some("root"), mutable: false, ty: .Ref(true, .Named("VecInternal")) },
          .{ name: .Some("tail"), mutable: false, ty: .Ref(false, .Named("ArrayByte")) },
        ],
        .None,
        true,
      ),
      // MutVecI64 — flat, unboxed, growable mutable Int vector (storage slice 1).
      // Backed by the existing ArrayI64 GC array plus a logical length; capacity
      // is `array.len(data)`. The mutvec_region pass lowers proven-owned Int
      // vector regions into this and freezes back to PVecI64 at the boundary.
      .Struct(
        "MutVecI64",
        [
          .{ name: .Some("data"), mutable: true, ty: .Ref(false, .Named("ArrayI64")) },
          .{ name: .Some("len"), mutable: true, ty: .I32 },
        ],
        .None,
        true,
      ),
      // MutVecBool — bool sibling of MutVecI64 (mutvec later-slices Phase 3).
      // Backed by ArrayBool (array i32); the mutvec_region pass lowers proven-owned
      // Vector<Bool> regions into this and freezes back to PVecBool at the boundary.
      .Struct(
        "MutVecBool",
        [
          .{ name: .Some("data"), mutable: true, ty: .Ref(false, .Named("ArrayBool")) },
          .{ name: .Some("len"), mutable: true, ty: .I32 },
        ],
        .None,
        true,
      ),
      // MutVecF64 — float sibling of MutVecI64 (mutvec later-slices Phase 4).
      // Backed by ArrayF64; the mutvec_region pass lowers proven-owned Vector<Float>
      // regions into this and freezes back to PVecF64 at the boundary.
      .Struct(
        "MutVecF64",
        [
          .{ name: .Some("data"), mutable: true, ty: .Ref(false, .Named("ArrayF64")) },
          .{ name: .Some("len"), mutable: true, ty: .I32 },
        ],
        .None,
        true,
      ),
      // MutVecByte — byte sibling of MutVecI64 (mutvec later-slices Phase 4).
      // Backed by ArrayByte (packed array i8); the mutvec_region pass lowers
      // proven-owned Vector<Byte> regions into this and freezes to PVecByte.
      .Struct(
        "MutVecByte",
        [
          .{ name: .Some("data"), mutable: true, ty: .Ref(false, .Named("ArrayByte")) },
          .{ name: .Some("len"), mutable: true, ty: .I32 },
        ],
        .None,
        true,
      ),
      // Spike-only S5 layout candidate: unboxed mutable Int arena entry.
      // Removed with the MutDict arena benchmark after the representation gate.
      .Struct(
        "MutDictArenaEntryI64",
        [
          .{ name: .Some("hash"), mutable: false, ty: .I64 },
          .{ name: .Some("key"), mutable: false, ty: .I64 },
          .{ name: .Some("val"), mutable: true, ty: .I64 },
          .{ name: .Some("live"), mutable: true, ty: .I32 },
        ],
        .None,
        true,
      ),
      .Struct(
        "HamtEntry",
        [
          .{ name: .Some("hash"), mutable: false, ty: .I64 },
          .{ name: .Some("key"), mutable: false, ty: .Anyref },
          .{ name: .Some("val"), mutable: false, ty: .Anyref },
          .{ name: .Some("order_index"), mutable: false, ty: .I32 },
        ],
        .None,
        true,
      ),
      .Struct(
        "HamtNode",
        [
          .{ name: .Some("bitmap"), mutable: true, ty: .I32 },
          .{ name: .Some("entries"), mutable: true, ty: .Ref(false, .Named("Array")) },
        ],
        .None,
        true,
      ),
      .Struct(
        "HamtCollision",
        [
          .{ name: .Some("tag"), mutable: false, ty: .I32 },
          .{ name: .Some("hash"), mutable: false, ty: .I64 },
          .{ name: .Some("entries"), mutable: false, ty: .Ref(false, .Named("Array")) },
        ],
        .None,
        true,
      ),
      .Struct(
        "PDict",
        [
          .{ name: .Some("size"), mutable: true, ty: .I32 },
          .{ name: .Some("root"), mutable: true, ty: .Ref(true, .Named("HamtNode")) },
          .{ name: .Some("order"), mutable: true, ty: .Ref(false, .Named("PVec")) },
          .{ name: .Some("tombstones"), mutable: true, ty: .I32 },
        ],
        .None,
        true,
      ),
      .Array("ClosureEnv", .{ name: .None, mutable: false, ty: .Anyref }),
      .FuncType("ClosureFunc", [.Anyref, .Anyref], [.Anyref]),
      .Struct(
        "Closure",
        [
          .{ name: .Some("func_ref"), mutable: false, ty: .Ref(true, .Named("ClosureFunc")) },
          .{ name: .Some("env"), mutable: false, ty: .Ref(true, .Named("ClosureEnv")) },
        ],
        .None,
        false,
      ),
      .Struct(
        "Variant",
        [
          .{ name: .Some("type_id"), mutable: false, ty: .I32 },
          .{ name: .Some("variant_id"), mutable: false, ty: .I32 },
          .{ name: .Some("payload"), mutable: false, ty: .Ref(true, .Named("Array")) },
        ],
        .None,
        true,
      ),
      .Struct("BoxedInt", [.{ name: .Some("v"), mutable: false, ty: .I64 }], .None, true),
      .Struct("BoxedFloat", [.{ name: .Some("v"), mutable: false, ty: .F64 }], .None, true),
      .Struct(
        "IterState",
        [
          .{ name: .Some("seed"), mutable: false, ty: .Anyref },
          .{ name: .Some("step"), mutable: false, ty: .Anyref },
        ],
        .None,
        false,
      ),
      // Task<T> and Channel<T> are Wasm-owned handles carrying only integer ids.
      // The scheduler lives in the JS host (JSPI binding); it keys records by
      // these ids and never constructs or inspects these structs.
      .Struct("Task", [.{ name: .Some("id"), mutable: false, ty: .I32 }], .None, true),
      .Struct("Channel", [.{ name: .Some("id"), mutable: false, ty: .I32 }], .None, true),
    ],
    imports: [],
    funcs: [],
    globals: [],
    tables: [],
    elems: [],
    exports: [],
    memory_exports: [],
    memories: [],
    data: [],
    start: .None,
  }
}
