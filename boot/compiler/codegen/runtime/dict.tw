          .LocalGet(0),
          .LocalGet(1),
          .I32Const(1),
          .I32Add,
          .LocalGet(4),
          .ArrayCopy(t_ARRAY, t_ARRAY),
        ],
        [],
      ),
      .LocalGet(3),
      .RefAsNonNull,
    ],
