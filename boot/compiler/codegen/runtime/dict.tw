              .LocalGet(10),
              .ArrayGet("rt_types__I32Array"),
              .LocalSet(19),
              .LocalGet(7),
              .RefAsNonNull,
              .LocalGet(10),
              .LocalGet(12),
              .ArraySet("rt_types__I32Array"),
              .LocalGet(12),
              .LocalGet(19),
              .I32Add,
              .LocalSet(12),
              .LocalGet(19),
              .I32Const(0),
              .I32GtS,
              .If(
                .None,
