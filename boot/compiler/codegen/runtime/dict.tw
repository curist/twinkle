//! rt.dict — persistent HAMT dictionary with insertion-order tracking.
//!
//! Mirrors stage0 src/runtime/dict.rs.
//! Key comparison uses rt.core.eq (structural equality).
//! Key types: Int (BoxedInt or I31/Byte), String.

use compiler.codegen.wasm_ir.{ExportDef, FuncDef, GlobalDef, Instr, ValType, WasmModule}

// ── ValType helpers ──────────────────────────────────────────────────────────
pdict_NULL := ValType.Ref(true, .Named("rt_types__PDict"))
pdict_REF := ValType.Ref(false, .Named("rt_types__PDict"))
hamt_NODE_NULL := ValType.Ref(true, .Named("rt_types__HamtNode"))
hamt_NODE_REF := ValType.Ref(false, .Named("rt_types__HamtNode"))
hamt_ENTRY_NULL := ValType.Ref(true, .Named("rt_types__HamtEntry"))
hamt_ENTRY_REF := ValType.Ref(false, .Named("rt_types__HamtEntry"))
hamt_COLLISION_NULL := ValType.Ref(true, .Named("rt_types__HamtCollision"))
hamt_COLLISION_REF := ValType.Ref(false, .Named("rt_types__HamtCollision"))
arr_NULL := ValType.Ref(true, .Named("rt_types__Array"))
arr_REF := ValType.Ref(false, .Named("rt_types__Array"))
i32arr_NULL := ValType.Ref(true, .Named("rt_types__I32Array"))
pvec_REF := ValType.Ref(false, .Named("rt_types__PVec"))
pvec_NULL := ValType.Ref(true, .Named("rt_types__PVec"))
variant_REF := ValType.Ref(false, .Named("rt_types__Variant"))
string_NULL := ValType.Ref(true, .Named("rt_types__String"))
boxed_INT_NULL := ValType.Ref(true, .Named("rt_types__BoxedInt"))
vec_INTERNAL_NULL := ValType.Ref(true, .Named("rt_types__VecInternal"))
t_PDICT := "rt_types__PDict"
t_HAMT_NODE := "rt_types__HamtNode"
t_HAMT_ENTRY := "rt_types__HamtEntry"
t_HAMT_COLLISION := "rt_types__HamtCollision"
t_ARRAY := "rt_types__Array"
t_PVEC := "rt_types__PVec"
t_VARIANT := "rt_types__Variant"
t_STRING := "rt_types__String"
t_BOXED_INT := "rt_types__BoxedInt"
t_VEC_INTERNAL := "rt_types__VecInternal"

// Field indices
he_HASH := 0
he_KEY := 1
he_VAL := 2
he_ORDER_INDEX := 3
hn_BITMAP := 0
hn_ENTRIES := 1
hc_HASH := 1
hc_ENTRIES := 2
pd_SIZE := 0
pd_ROOT := 1
pd_ORDER := 2
pd_TOMBSTONES := 3

pub fn module() WasmModule {
  funcs := [
    popcount_fn(),
    arr_insert_at_fn(),
    arr_replace_at_fn(),
    arr_remove_at_fn(),
    hash_i64_fn(),
    hash_string_fn(),
    hash_key_fn(),
    collision_get_fn(),
    collision_set_fn(),
    node_get_fn(),
    node_set_fn(),
    owned_replace_slot_fn(),
    owned_insert_slot_fn(),
    node_set_owned_fn(),
    node_build_incremental_fn("node_build_sequential", "node_set"),
    node_build_incremental_fn("node_build_editable", "node_set_owned"),
    node_build_bottom_up_fn(),
    build_order_bulk_fn(),
    freeze_dense_fn(),
    node_remove_fn(),
    compact_fn(),
    bench_builder_rotation_fn(),
    bench_builders_fn(),
    bench_timings_fn(),
    make_fn(),
    len_fn(),
    keys_fn(),
    has_fn(),
    get_fn(),
    get_option_fn(),
    set_fn(),
    remove_fn(),
    set_in_place_fn(),
    remove_in_place_fn(),
  ]
  exports := collect f in funcs {
    ExportDef.{ wasm_name: f.name, func_sym: f.name }
  }
  .{
    namespace: "rt.dict",
    types: [],
    imports: [
      .{ module: "twinkle_runtime", name: "now", as_sym: "host_now", params: [], results: [.F64] },
      .{
        module: "rt.core",
        name: "eq",
        as_sym: "core_eq",
        params: [.Anyref, .Anyref],
        results: [.I32],
      },
      .{
        module: "rt.arr",
        name: "push",
        as_sym: "arr_push",
        params: [pvec_REF, .Anyref],
        results: [pvec_REF],
      },
      .{ module: "rt.arr", name: "len", as_sym: "arr_len", params: [pvec_NULL], results: [.I32] },
      .{
        module: "rt.arr",
        name: "set",
        as_sym: "arr_set",
        params: [pvec_NULL, .I32, .Anyref],
        results: [pvec_REF],
      },
      .{
        module: "rt.arr",
        name: "set_in_place",
        as_sym: "arr_set_in_place",
        params: [pvec_NULL, .I32, .Anyref],
        results: [pvec_REF],
      },
      .{
        module: "rt.arr",
        name: "get",
        as_sym: "arr_get",
        params: [pvec_NULL, .I32],
        results: [.Anyref],
      },
      .{
        module: "rt.arr",
        name: "to_array",
        as_sym: "arr_to_array",
        params: [pvec_NULL],
        results: [arr_REF],
      },
      .{
        module: "rt.arr",
        name: "from_array",
        as_sym: "arr_from_array",
        params: [arr_REF],
        results: [pvec_REF],
      },
      .{
        module: "rt.arr",
        name: "make_empty",
        as_sym: "arr_make_empty",
        params: [],
        results: [pvec_REF],
      },
    ],
    funcs,
    globals: [
      GlobalDef.{ name: "was_replace", mutable: true, ty: .I32, init: [.I32Const(0)] },
      GlobalDef.{ name: "dict_order_index", mutable: true, ty: .I32, init: [.I32Const(0)] },
      GlobalDef.{ name: "dict_removed_index", mutable: true, ty: .I32, init: [.I32Const(0)] },
      GlobalDef.{ name: "builder_bench_rotation", mutable: true, ty: .I32, init: [.I32Const(0)] },
      GlobalDef.{
        name: "builder_bench_timings",
        mutable: true,
        ty: pvec_NULL,
        init: [.RefNull(.Named(t_PVEC))],
      },
    ],
    tables: [],
    elems: [],
    exports,
    memory_exports: [],
    memories: [],
    data: [],
    start: .None,
  }
}

// ── popcount(v: i32) -> i32 ──────────────────────────────────────────────────
fn popcount_fn() FuncDef {
  .{
    name: "popcount",
    params: [.I32],
    results: [.I32],
    locals: [],
    body: [.LocalGet(0), .I32Popcnt],
  }
}

// ── arr_insert_at(arr, idx, val) -> Array ────────────────────────────────────
fn arr_insert_at_fn() FuncDef {
  // p0=arr, p1=idx, p2=val; L3=n, L4=new_arr, L5=tail_len
  .{
    name: "arr_insert_at",
    params: [arr_REF, .I32, .Anyref],
    results: [arr_REF],
    locals: [.I32, arr_NULL, .I32],
    body: [
      .LocalGet(0),
      .ArrayLen,
      .LocalSet(3),
      .RefNull(.Any),
      .LocalGet(3),
      .I32Const(1),
      .I32Add,
      .ArrayNew(t_ARRAY),
      .LocalSet(4),
      .LocalGet(1),
      .I32Const(0),
      .I32GtS,
      .If(
        .None,
        [
          .LocalGet(4),
          .RefAsNonNull,
          .I32Const(0),
          .LocalGet(0),
          .I32Const(0),
          .LocalGet(1),
          .ArrayCopy(t_ARRAY, t_ARRAY),
        ],
        [],
      ),
      .LocalGet(4),
      .RefAsNonNull,
      .LocalGet(1),
      .LocalGet(2),
      .ArraySet(t_ARRAY),
      .LocalGet(3),
      .LocalGet(1),
      .I32Sub,
      .LocalSet(5),
      .LocalGet(5),
      .I32Const(0),
      .I32GtS,
      .If(
        .None,
        [
          .LocalGet(4),
          .RefAsNonNull,
          .LocalGet(1),
          .I32Const(1),
          .I32Add,
          .LocalGet(0),
          .LocalGet(1),
          .LocalGet(5),
          .ArrayCopy(t_ARRAY, t_ARRAY),
        ],
        [],
      ),
      .LocalGet(4),
      .RefAsNonNull,
    ],
  }
}

