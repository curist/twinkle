// ── keys(dict: PDict?) -> PVec ───────────────────────────────────────────────
fn keys_fn() FuncDef {
  // p0=dict; L1=flat, L2=n, L3=dst, L4=i, L5=j, L6=elem
  .{
    name: "keys",
    params: [pdict_NULL],
    results: [pvec_REF],
    locals: [arr_NULL, .I32, arr_NULL, .I32, .I32, .Anyref],
    // Always materialize a FRESH order array. The no-tombstone fast path used to
    // return `pd_ORDER` by reference, but that aliases the dict's internal backing:
    // a later in-place dict mutation (dict$remove_in_place tombstones the order
    // vector) would corrupt a live keys() result. Copying keeps keys() independent
    // of the dict so ownership analysis can soundly treat it as a fresh value.
    body: [
      .LocalGet(0),
      .RefAsNonNull,
      .StructGet(t_PDICT, pd_ORDER),
      .RefAsNonNull,
      .Call("arr_to_array"),
      .LocalSet(1),
      .LocalGet(1),
      .RefAsNonNull,
      .ArrayLen,
