    name: "node_build_bottom_up",
    params: [arr_REF, .I32, .I32, .I32],
    results: [hamt_NODE_REF],
    locals: [
      .I32,
      .I64,
      i32arr_NULL,
      i32arr_NULL,
      arr_NULL,
      .I32,
      .I32,
      .I32,
      .I32,
      .Anyref,
      .I64,
      .I32,
      arr_NULL,
      .I32,
      .I32,
      .I32,
      .I32,
      arr_NULL,
    ],
    body: [
      // n = hi - lo
      .LocalGet(2),
      .LocalGet(1),
      .I32Sub,
      .LocalSet(4),
      // shift = depth * 5 (as i64 shift amount)
      .LocalGet(3),
      .I32Const(5),
      .I32Mul,
      .I64ExtendI32U,
      .LocalSet(5),
      // counts = I32Array(32), zero-filled
      .I32Const(32),
      .ArrayNewDefault("rt_types__I32Array"),
      .LocalSet(6),
      // pass 1: tally fragment counts
      .I32Const(0),
      .LocalSet(9),
      .Block(
        "p1exit",
        .None,
        [
          .Loop(
            "p1",
            .None,
            [
              .LocalGet(9),
              .LocalGet(4),
              .I32GeS,
              .BrIf("p1exit"),
              .LocalGet(0),
              .LocalGet(1),
              .LocalGet(9),
              .I32Add,
              .ArrayGet(t_ARRAY),
              .RefCast(false, .Named(t_HAMT_ENTRY)),
              .StructGet(t_HAMT_ENTRY, he_HASH),
              .LocalGet(5),
              .I64ShrU,
              .I32WrapI64,
              .I32Const(31),
              .I32And,
              .LocalSet(10),
              .LocalGet(6),
              .RefAsNonNull,
              .LocalGet(10),
              .LocalGet(6),
              .RefAsNonNull,
              .LocalGet(10),
              .ArrayGet("rt_types__I32Array"),
              .I32Const(1),
              .I32Add,
              .ArraySet("rt_types__I32Array"),
              .LocalGet(9),
              .I32Const(1),
              .I32Add,
              .LocalSet(9),
              .Br("p1"),
            ],
          ),
        ],
      ),
      // bitmap + nslots, and cur[f] = prefix offset of bucket f
      .I32Const(0),
      .LocalSet(11),
      .I32Const(0),
      .LocalSet(15),
      .I32Const(0),
      .LocalSet(12),
      .I32Const(32),
      .ArrayNewDefault("rt_types__I32Array"),
      .LocalSet(7),
      .I32Const(0),
      .LocalSet(10),
      .Block(
        "b2exit",
        .None,
        [
          .Loop(
            "b2",
            .None,
            [
              .LocalGet(10),
              .I32Const(32),
              .I32GeS,
              .BrIf("b2exit"),
              .LocalGet(6),
