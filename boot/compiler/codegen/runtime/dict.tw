// ── freeze_dense(dense: ref Array, len: i32) -> ref PDict ─────────────────────
// The shared publication adapter (design §2): build the persistent root in one
// bottom-up pass and the order vector in bulk, then assemble an ordinary PDict.
// dense[0..len) must be the hole-free, core_eq-unique live stream in insertion
// order; the builder performs no rehash and no node_get.
fn freeze_dense_fn() FuncDef {
  // p0=dense, p1=len; L2=root
  .{
    name: "freeze_dense",
    params: [arr_REF, .I32],
    results: [pdict_REF],
    locals: [hamt_NODE_NULL],
    body: [
      .RefNull(.Named(t_HAMT_NODE)),
      .LocalSet(2),
      .LocalGet(1),
      .I32Const(0),
      .I32GtS,
      .If(
        .None,
        [
          .LocalGet(0),
          .I32Const(0),
          .LocalGet(1),
          .I32Const(0),
          .Call("node_build_bottom_up"),
          .LocalSet(2),
        ],
        [],
      ),
      .LocalGet(1),
      .LocalGet(2),
      .LocalGet(0),
      .LocalGet(1),
      .Call("build_order_bulk"),
      .RefAsNonNull,
      .I32Const(0),
      .StructNew(t_PDICT),
    ],
  }
}

// ── compact(dict: PDict?) -> PDict ───────────────────────────────────────────
// Rebuild order (dropping null tombstones) and refresh every entry's stored
// order_index. Run only when dead >= live, so amortized O(log n) per remove.
// Fully persistent: builds fresh structures.
//
// Spike: first materializes the live entries into a dense HamtEntry array (the
// future MutDict freeze stream — cached_hash + key + value + order_index), then
// builds the persistent root in one bottom-up pass and the order PVec in bulk,
// instead of sequential node_set_owned + per-entry arr_push. The dense
// materialization is deliberately a separable seam so the three builders can
// later consume identical input. The per-entry node_get below is the old-HAMT
// value lookup that a real MutDict stream would not pay — measure it as seam
// overhead, not builder cost.
fn compact_fn() FuncDef {
  // p0=dict; L1=flat order, L2=n, L3=dense entries, L4=(unused, was keys),
  // L5=j (live count), L6=i, L7=key, L8=hash, L9=val, L10=(unused, was root),
  // L11=(unused, was order), L12=(unused, was keys_trim), L13=old_root (still
  // used for node_get value recovery)
  .{
    name: "compact",
    params: [pdict_NULL],
    results: [pdict_REF],
    locals: [
      arr_NULL,
      .I32,
      arr_NULL,
      arr_NULL,
      .I32,
      .I32,
      .Anyref,
      .I64,
      .Anyref,
      hamt_NODE_NULL,
      pvec_NULL,
      arr_NULL,
      hamt_NODE_NULL,
    ],
    body: [
      // old_root cached for value lookups
      .LocalGet(0),
      .RefAsNonNull,
      .StructGet(t_PDICT, pd_ROOT),
      .LocalSet(13),
      // flat = order keys (with tombstone holes); n = its length
      .LocalGet(0),
      .RefAsNonNull,
      .StructGet(t_PDICT, pd_ORDER),
      .RefAsNonNull,
      .Call("arr_to_array"),
      .LocalSet(1),
      .LocalGet(1),
      .RefAsNonNull,
      .ArrayLen,
      .LocalSet(2),
      // dense[n] (oversized; filled up to live count j)
      .RefNull(.Any),
      .LocalGet(2),
      .ArrayNew(t_ARRAY),
      .LocalSet(3),
      .I32Const(0),
      .LocalSet(5),
      .I32Const(0),
      .LocalSet(6),
      .Block(
        "exit",
        .None,
        [
          .Loop(
            "loop",
            .None,
            [
              .LocalGet(6),
              .LocalGet(2),
              .I32GeS,
              .BrIf("exit"),
              .LocalGet(1),
              .RefAsNonNull,
              .LocalGet(6),
              .ArrayGet(t_ARRAY),
              .LocalSet(7),
              .LocalGet(7),
              .RefIsNull,
              .I32Eqz,
              .If(
                .None,
                [
                  .LocalGet(7),
                  .Call("hash_key"),
                  .LocalSet(8),
                  .LocalGet(13),
                  .LocalGet(8),
                  .I32Const(0),
                  .LocalGet(7),
                  .Call("node_get"),
                  .LocalSet(9),
                  // dense[j] = HamtEntry{ hash, key, val, order_index: j }
                  .LocalGet(3),
                  .RefAsNonNull,
                  .LocalGet(5),
                  .LocalGet(8),
                  .LocalGet(7),
                  .LocalGet(9),
                  .LocalGet(5),
                  .StructNew(t_HAMT_ENTRY),
                  .ArraySet(t_ARRAY),
                  .LocalGet(5),
                  .I32Const(1),
                  .I32Add,
                  .LocalSet(5),
                ],
                [],
              ),
              .LocalGet(6),
              .I32Const(1),
              .I32Add,
              .LocalSet(6),
              .Br("loop"),
            ],
          ),
        ],
      ),
      // dense[0..j) is the hole-free live stream; publish via the shared adapter.
      .LocalGet(3),
      .RefAsNonNull,
      .LocalGet(5),
      .Call("freeze_dense"),
    ],
  }
}

