  // p0=arr, p1=idx, p2=val; L3=n, L4=new_arr
  .{
    name: "arr_replace_at",
    params: [arr_REF, .I32, .Anyref],
    results: [arr_REF],
    locals: [.I32, arr_NULL],
    body: [
      .LocalGet(0),
      .ArrayLen,
      .LocalSet(3),
      .RefNull(.Any),
      .LocalGet(3),
      .ArrayNew(t_ARRAY),
      .LocalSet(4),
      .LocalGet(4),
      .RefAsNonNull,
      .I32Const(0),
      .LocalGet(0),
      .I32Const(0),
      .LocalGet(3),
      .ArrayCopy(t_ARRAY, t_ARRAY),
      .LocalGet(4),
      .RefAsNonNull,
      .LocalGet(1),
      .LocalGet(2),
      .ArraySet(t_ARRAY),
      .LocalGet(4),
      .RefAsNonNull,
    ],
  }
}

