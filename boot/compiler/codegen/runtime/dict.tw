// ── bench_builders(dict) -> PVec<PDict> ─────────────────────────────────────
// Spike-only A/B harness. Dense preparation happens exactly once, including
// the compact seam's node_get value recovery. All builders then consume that
// same HamtEntry array. Timings are milliseconds from twinkle_runtime.now.
fn bench_builders_fn() FuncDef {
  // p0=dict; L1=flat, L2=capacity, L3=dense, L4=keys, L5=i, L6=j,
  // L7=key, L8=hash, L9=val, L10=sequential, L11=editable, L12=bottom_up,
  // L13=order, L14=keys_trim, L15=metrics, L16=results, L17=t0,
  // L18..L22=prep/sequential/editable/bottom_up/order ms, L23=metrics_pvec,
  // L24=old_root
  .{
    name: "bench_builders",
    params: [pdict_NULL],
    results: [pvec_REF],
    locals: [
      arr_NULL,
      .I32,
      arr_NULL,
      arr_NULL,
      .I32,
      .I32,
      .Anyref,
      .I64,
      .Anyref,
      hamt_NODE_NULL,
      hamt_NODE_NULL,
      hamt_NODE_NULL,
      pvec_NULL,
      arr_NULL,
      arr_NULL,
      arr_NULL,
      .F64,
      .F64,
      .F64,
      .F64,
      .F64,
      .F64,
      pvec_NULL,
      hamt_NODE_NULL,
    ],
    body: [
      // Dense preparation: cached hash + key + node_get value + order index.
      .Call("host_now"),
      .LocalSet(17),
      .LocalGet(0),
      .RefAsNonNull,
      .StructGet(t_PDICT, pd_ROOT),
      .LocalSet(24),
      .LocalGet(0),
      .RefAsNonNull,
      .StructGet(t_PDICT, pd_ORDER),
      .Call("arr_to_array"),
      .LocalSet(1),
      .LocalGet(1),
      .RefAsNonNull,
      .ArrayLen,
      .LocalSet(2),
      .RefNull(.Any),
      .LocalGet(2),
      .ArrayNew(t_ARRAY),
      .LocalSet(3),
      .RefNull(.Any),
      .LocalGet(2),
      .ArrayNew(t_ARRAY),
      .LocalSet(4),
      .I32Const(0),
      .LocalSet(5),
      .I32Const(0),
      .LocalSet(6),
      .Block(
        "prep_exit",
        .None,
        [
          .Loop(
            "prep_loop",
            .None,
            [
              .LocalGet(5),
              .LocalGet(2),
              .I32GeS,
              .BrIf("prep_exit"),
              .LocalGet(1),
              .RefAsNonNull,
              .LocalGet(5),
              .ArrayGet(t_ARRAY),
              .LocalSet(7),
              .LocalGet(7),
              .RefIsNull,
              .If(
                .None,
                [],
                [
                  .LocalGet(7),
                  .Call("hash_key"),
                  .LocalSet(8),
                  .LocalGet(24),
                  .LocalGet(8),
                  .I32Const(0),
                  .LocalGet(7),
                  .Call("node_get"),
                  .LocalSet(9),
                  .LocalGet(3),
                  .RefAsNonNull,
                  .LocalGet(6),
                  .LocalGet(8),
                  .LocalGet(7),
                  .LocalGet(9),
                  .LocalGet(6),
                  .StructNew(t_HAMT_ENTRY),
                  .ArraySet(t_ARRAY),
                  .LocalGet(4),
                  .RefAsNonNull,
                  .LocalGet(6),
                  .LocalGet(7),
                  .ArraySet(t_ARRAY),
                  .LocalGet(6),
                  .I32Const(1),
                  .I32Add,
                  .LocalSet(6),
                ],
              ),
              .LocalGet(5),
              .I32Const(1),
              .I32Add,
              .LocalSet(5),
              .Br("prep_loop"),
            ],
          ),
        ],
      ),
      .Call("host_now"),
      .LocalGet(17),
      .F64Sub,
      .LocalSet(18),
      // Rotate builder position across samples; timing locals remain bound to
      // their semantic builder rather than execution position.
      .GlobalGet("builder_bench_rotation"),
      .I32Eqz,
      .If(
        .None,
        [
          // Persistent sequential builder.
          .Call("host_now"),
          .LocalSet(17),
          .LocalGet(3),
          .RefAsNonNull,
          .LocalGet(6),
          .Call("node_build_sequential"),
          .LocalSet(10),
          .Call("host_now"),
          .LocalGet(17),
          .F64Sub,
          .LocalSet(19),
          // Owned/editable incremental builder.
          .Call("host_now"),
          .LocalSet(17),
          .LocalGet(3),
          .RefAsNonNull,
          .LocalGet(6),
          .Call("node_build_editable"),
          .LocalSet(11),
          .Call("host_now"),
          .LocalGet(17),
          .F64Sub,
          .LocalSet(20),
          // Direct bottom-up builder.
          .Call("host_now"),
          .LocalSet(17),
          .RefNull(.Named(t_HAMT_NODE)),
          .LocalSet(12),
          .LocalGet(6),
          .I32Const(0),
          .I32GtS,
          .If(
            .None,
            [
              .LocalGet(3),
              .RefAsNonNull,
              .I32Const(0),
              .LocalGet(6),
              .I32Const(0),
              .Call("node_build_bottom_up"),
              .LocalSet(12),
            ],
            [],
          ),
          .Call("host_now"),
          .LocalGet(17),
          .F64Sub,
          .LocalSet(21),
        ],
        [
          .GlobalGet("builder_bench_rotation"),
          .I32Const(1),
          .I32Eq,
          .If(
            .None,
            [
              // Owned/editable incremental builder.
              .Call("host_now"),
              .LocalSet(17),
              .LocalGet(3),
              .RefAsNonNull,
              .LocalGet(6),
              .Call("node_build_editable"),
              .LocalSet(11),
              .Call("host_now"),
              .LocalGet(17),
              .F64Sub,
              .LocalSet(20),
              // Direct bottom-up builder.
              .Call("host_now"),
              .LocalSet(17),
              .RefNull(.Named(t_HAMT_NODE)),
              .LocalSet(12),
              .LocalGet(6),
              .I32Const(0),
              .I32GtS,
              .If(
                .None,
                [
                  .LocalGet(3),
                  .RefAsNonNull,
                  .I32Const(0),
                  .LocalGet(6),
                  .I32Const(0),
                  .Call("node_build_bottom_up"),
                  .LocalSet(12),
                ],
                [],
              ),
              .Call("host_now"),
              .LocalGet(17),
              .F64Sub,
              .LocalSet(21),
              // Persistent sequential builder.
              .Call("host_now"),
              .LocalSet(17),
              .LocalGet(3),
              .RefAsNonNull,
              .LocalGet(6),
              .Call("node_build_sequential"),
              .LocalSet(10),
              .Call("host_now"),
              .LocalGet(17),
              .F64Sub,
              .LocalSet(19),
            ],
            [
              // Direct bottom-up builder.
              .Call("host_now"),
              .LocalSet(17),
              .RefNull(.Named(t_HAMT_NODE)),
              .LocalSet(12),
              .LocalGet(6),
              .I32Const(0),
              .I32GtS,
              .If(
                .None,
                [
                  .LocalGet(3),
                  .RefAsNonNull,
                  .I32Const(0),
                  .LocalGet(6),
                  .I32Const(0),
                  .Call("node_build_bottom_up"),
                  .LocalSet(12),
                ],
                [],
              ),
              .Call("host_now"),
              .LocalGet(17),
              .F64Sub,
              .LocalSet(21),
              // Persistent sequential builder.
              .Call("host_now"),
              .LocalSet(17),
              .LocalGet(3),
              .RefAsNonNull,
              .LocalGet(6),
              .Call("node_build_sequential"),
              .LocalSet(10),
              .Call("host_now"),
              .LocalGet(17),
              .F64Sub,
              .LocalSet(19),
              // Owned/editable incremental builder.
              .Call("host_now"),
              .LocalSet(17),
              .LocalGet(3),
              .RefAsNonNull,
              .LocalGet(6),
              .Call("node_build_editable"),
              .LocalSet(11),
              .Call("host_now"),
              .LocalGet(17),
              .F64Sub,
              .LocalSet(20),
            ],
          ),
        ],
      ),
      // Build insertion order once in bulk; all immutable results share it.
      .Call("host_now"),
      .LocalSet(17),
      .RefNull(.Any),
      .LocalGet(6),
      .ArrayNew(t_ARRAY),
      .LocalSet(14),
      .LocalGet(14),
      .RefAsNonNull,
      .I32Const(0),
      .LocalGet(4),
      .RefAsNonNull,
      .I32Const(0),
      .LocalGet(6),
      .ArrayCopy(t_ARRAY, t_ARRAY),
      .LocalGet(14),
      .RefAsNonNull,
      .Call("arr_from_array"),
      .LocalSet(13),
      .Call("host_now"),
      .LocalGet(17),
      .F64Sub,
      .LocalSet(22),
      // Cache boxed metrics for bench_timings().
      .LocalGet(18),
      .StructNew("rt_types__BoxedFloat"),
      .LocalGet(19),
      .StructNew("rt_types__BoxedFloat"),
      .LocalGet(20),
      .StructNew("rt_types__BoxedFloat"),
      .LocalGet(21),
      .StructNew("rt_types__BoxedFloat"),
      .LocalGet(22),
      .StructNew("rt_types__BoxedFloat"),
      .ArrayNewFixed(t_ARRAY, 5),
      .LocalSet(15),
      .LocalGet(15),
      .RefAsNonNull,
      .Call("arr_from_array"),
      .LocalSet(23),
      .LocalGet(23),
      .GlobalSet("builder_bench_timings"),
      // Return sequential/editable/bottom-up PDicts in fixed order.
      .LocalGet(6),
      .LocalGet(10),
      .LocalGet(13),
      .RefAsNonNull,
      .I32Const(0),
      .StructNew(t_PDICT),
      .LocalGet(6),
      .LocalGet(11),
      .LocalGet(13),
      .RefAsNonNull,
      .I32Const(0),
      .StructNew(t_PDICT),
      .LocalGet(6),
      .LocalGet(12),
