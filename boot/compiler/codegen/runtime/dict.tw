// node_set_owned has node_set semantics, but mutates a freshly-owned HAMT root.
// It still traverses by hash; the spike isolates allocation/path-copy savings
// before considering a more complex radix-partitioned bottom-up builder.
fn node_set_owned_fn() FuncDef {
  // p0=node, p1=hash, p2=depth, p3=key, p4=val
  // L5=new_entry, L6=shift, L7=fragment, L8=bit, L9=bitmap, L10=idx,
  // L11=slot, L12=entries, L13=old_entry, L14=child, L15=collision,
  // L16=new_collision
  .{
    name: "node_set_owned",
