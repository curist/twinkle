//! Shared ownership-verdict extraction for codegen dry-runs and mutable decision production.

use @std.date
use @std.proc

use compiler.anf.{AnfExpr, AnfMatchArm, AnfModule, AnfOp, Atom, FieldAtom, IndexKind, OpKind}
use compiler.builtins.{BuiltinRegistry}
use compiler.cfg
use compiler.codegen.variant_route
use compiler.core_ir.{BinOp, CorePattern, LocalId, UnOp}
use compiler.mono_type
use compiler.opt.semantics.{OptimizerSemantics}
use compiler.ownership
use compiler.summary
use lib.query.keys as qkeys

fn timings_enabled() Bool {
  case proc.env("TWINKLE_TIMINGS") {
    .Some(_) => true,
    .None => false,
  }
}

// Reuse Phase 8G's summary to seed the mutable producer's scoped summary. On by
// default; set TWINKLE_SUMMARY_REUSE=0 to force the from-scratch path.
fn summary_reuse_enabled() Bool {
  case proc.env("TWINKLE_SUMMARY_REUSE") {
    .Some(v) => v != "0",
    .None => true,
  }
}

fn artifact_phase(label: String) {
  if timings_enabled() {
    eprintln("[time:mutable:artifact:phase] ${label}")
  }
}

pub type SiteVerdict = .{ text: String, reusable_shell: Bool, field_backing_reusable: Bool }

// ── Optimized-ANF fingerprinting ────────────────────────────────────
//
// An `ArtifactKey` deterministically hashes the optimized semantic ANF a set of
// ownership artifacts was computed over. Artifact-fed producer/dry-run APIs
// validate this key before using verdicts, so artifacts computed for a
// different (stale) module can never feed a mutable decision. The hash covers
// every `Atom`/`AnfExpr`/`AnfOp`/`CorePattern` variant explicitly (no
// wildcard), so a new IR variant forces an exhaustiveness error here until it
// is folded in.
pub type ArtifactKey = .{ anf_hash: Int }

pub fn same_artifact_key(a: ArtifactKey, b: ArtifactKey) Bool {
  a.anf_hash == b.anf_hash
}

// `lib.query.keys` exposes `mix_word(h, word)`; fold a running hash from 0.
fn mix_all(parts: Vector<Int>) Int {
  h := 0
  for p in parts {
    h = qkeys.mix_word(h, p)
  }
  h
}

fn bool_tag(v: Bool) Int {
  if v {
    1
  } else {
    0
  }
}

fn bin_tag(op: BinOp) Int {
  case op {
    .Add => 1,
    .Sub => 2,
    .Mul => 3,
    .Div => 4,
    .Mod => 5,
    .Eq => 6,
    .Ne => 7,
    .Lt => 8,
    .Le => 9,
    .Gt => 10,
    .Ge => 11,
    .And => 12,
    .Or => 13,
    .BitAnd => 14,
    .BitOr => 15,
    .BitXor => 16,
    .Shl => 17,
    .Shr => 18,
  }
}

fn un_tag(op: UnOp) Int {
  case op {
    .Neg => 1,
    .Not => 2,
  }
}

fn op_kind_tag(k: OpKind) Int {
  case k {
    .Int => 1,
    .Float => 2,
    .Bool => 3,
    .Str => 4,
  }
}

fn index_kind_tag(k: IndexKind) Int {
  case k {
    .Array => 1,
    .Dict => 2,
    .Str => 3,
  }
}

fn hash_atom(a: Atom) Int {
  case a {
    .ALocal(l) => mix_all([qkeys.hash_text("ALocal"), l.id]),
    .AGlobalLocal(g) => mix_all([qkeys.hash_text("AGlobalLocal"), g.id]),
    .AGlobalFunc(f) => mix_all([qkeys.hash_text("AGlobalFunc"), f.id]),
    .ALitInt(n) => mix_all([qkeys.hash_text("ALitInt"), n]),
    .ALitFloat(f) => mix_all([qkeys.hash_text("ALitFloat"), qkeys.hash_text("${f}")]),
    .ALitBool(v) => mix_all([qkeys.hash_text("ALitBool"), bool_tag(v)]),
    .ALitStr(s) => mix_all([qkeys.hash_text("ALitStr"), qkeys.hash_text(s)]),
    .ALitVoid => qkeys.hash_text("ALitVoid"),
  }
}

fn hash_atom_opt(a: Atom?) Int {
  case a {
    .Some(x) => mix_all([qkeys.hash_text("some"), hash_atom(x)]),
    .None => qkeys.hash_text("none"),
  }
}

fn hash_atoms(atoms: Vector<Atom>) Int {
  parts: Vector<Int> = [qkeys.hash_text("atoms"), atoms.len()]
  for a in atoms {
    parts = .append(hash_atom(a))
  }
  mix_all(parts)
}

fn hash_locals(locals: Vector<LocalId>) Int {
  parts: Vector<Int> = [qkeys.hash_text("locals"), locals.len()]
  for l in locals {
    parts = .append(l.id)
  }
  mix_all(parts)
}

fn hash_fields(fields: Vector<FieldAtom>) Int {
  parts: Vector<Int> = [qkeys.hash_text("fields"), fields.len()]
  for fa in fields {
    parts = .append(mix_all([fa.field.id, hash_atom(fa.value)]))
  }
  mix_all(parts)
}

fn hash_pattern(p: CorePattern) Int {
  case p {
    .Wildcard => qkeys.hash_text("PWildcard"),
    .Var(l) => mix_all([qkeys.hash_text("PVar"), l.id]),
    .LitInt(n) => mix_all([qkeys.hash_text("PLitInt"), n]),
    .LitBool(v) => mix_all([qkeys.hash_text("PLitBool"), bool_tag(v)]),
    .LitStr(s) => mix_all([qkeys.hash_text("PLitStr"), qkeys.hash_text(s)]),
    .Variant(tid, vid, args) => {
      parts: Vector<Int> = [qkeys.hash_text("PVariant"), tid.id, vid.id, args.len()]
      for a in args {
        parts = .append(hash_pattern(a))
      }
      mix_all(parts)
    },
  }
}

fn hash_arms(arms: Vector<AnfMatchArm>) Int {
  parts: Vector<Int> = [qkeys.hash_text("arms"), arms.len()]
  for arm, i in arms {
    parts = .append(mix_all([i, hash_pattern(arm.pattern), hash_expr(arm.body)]))
  }
  mix_all(parts)
}

fn hash_op(op: AnfOp) Int {
  case op {
    .ACall(callee, args) => mix_all([qkeys.hash_text("ACall"), hash_atom(callee), hash_atoms(args)]),
    .AIf(pred, then_e, else_e) => mix_all([
      qkeys.hash_text("AIf"),
      hash_atom(pred),
      hash_expr(then_e),
      hash_expr(else_e),
    ]),
    .AMatch(scrut, arms) => mix_all([qkeys.hash_text("AMatch"), hash_atom(scrut), hash_arms(arms)]),
    .ALoop(body) => mix_all([qkeys.hash_text("ALoop"), hash_expr(body)]),
    .ABinOp(bop, l, r, kind) => mix_all([
      qkeys.hash_text("ABinOp"),
      bin_tag(bop),
      hash_atom(l),
      hash_atom(r),
      op_kind_tag(kind),
    ]),
    .AUnOp(uop, a, kind) => mix_all([
      qkeys.hash_text("AUnOp"),
      un_tag(uop),
      hash_atom(a),
      op_kind_tag(kind),
    ]),
    .AMakeClosure(fid, locals) => mix_all([
      qkeys.hash_text("AMakeClosure"),
      fid.id,
      hash_locals(locals),
    ]),
    .ARecord(tid, fields) => mix_all([qkeys.hash_text("ARecord"), tid.id, hash_fields(fields)]),
    .ARecordGet(a, field, tid) => mix_all([
      qkeys.hash_text("ARecordGet"),
      hash_atom(a),
      field.id,
      tid.id,
    ]),
    .ARecordUpdate(a, field, val, in_place, tid) => mix_all([
      qkeys.hash_text("ARecordUpdate"),
      hash_atom(a),
      field.id,
      hash_atom(val),
      bool_tag(in_place),
      tid.id,
    ]),
    .AVariant(tid, vid, args) => mix_all([
      qkeys.hash_text("AVariant"),
      tid.id,
      vid.id,
      hash_atoms(args),
    ]),
    .AArrayLit(args) => mix_all([qkeys.hash_text("AArrayLit"), hash_atoms(args)]),
    .AIndex(base, idx, ikind, ty) => mix_all([
      qkeys.hash_text("AIndex"),
      hash_atom(base),
      hash_atom(idx),
      index_kind_tag(ikind),
      qkeys.hash_text(mono_type.ty_to_string(ty)),
    ]),
    .AInit(a) => mix_all([qkeys.hash_text("AInit"), hash_atom(a)]),
    .AAssign(local, a) => mix_all([qkeys.hash_text("AAssign"), local.id, hash_atom(a)]),
    .AGlobalSet(g, a) => mix_all([qkeys.hash_text("AGlobalSet"), g.id, hash_atom(a)]),
    .ADefer(body) => mix_all([qkeys.hash_text("ADefer"), hash_expr(body)]),
    .AWrapAnyref(a, ty) => mix_all([
      qkeys.hash_text("AWrapAnyref"),
      hash_atom(a),
      qkeys.hash_text(mono_type.ty_to_string(ty)),
    ]),
    .AUnwrapAnyref(a, ty) => mix_all([
      qkeys.hash_text("AUnwrapAnyref"),
      hash_atom(a),
      qkeys.hash_text(mono_type.ty_to_string(ty)),
    ]),
  }
}

fn hash_expr(e: AnfExpr) Int {
  case e {
    .Let(local, op, body) => mix_all([
      qkeys.hash_text("Let"),
      local.id,
      hash_op(op),
      hash_expr(body),
    ]),
    .Atom(a) => mix_all([qkeys.hash_text("EAtom"), hash_atom(a)]),
    .Return(a) => mix_all([qkeys.hash_text("Return"), hash_atom_opt(a)]),
    .Break(a) => mix_all([qkeys.hash_text("Break"), hash_atom_opt(a)]),
    .Continue => qkeys.hash_text("Continue"),
  }
}

pub fn artifact_key_for_anf(opt: AnfModule) ArtifactKey {
  parts: Vector<Int> = [qkeys.hash_text("phase8a-artifact-v1"), opt.functions.len()]
  case opt.init_func_id {
    .Some(fid) => parts = .append(mix_all([qkeys.hash_text("init"), fid.id])),
    .None => parts = .append(qkeys.hash_text("no-init")),
  }
  for f in opt.functions {
    parts = .append(
      mix_all([
        qkeys.hash_text("func"),
        f.func_id.id,
        qkeys.hash_text(f.name),
        f.params.len(),
        hash_expr(f.body),
      ]),
    )
  }
  ArtifactKey.{ anf_hash: mix_all(parts) }
}

// ── Shared ownership artifacts ──────────────────────────────────────
pub type OwnershipArtifacts = .{
  key: ArtifactKey,
  view: cfg.CfgView,
  table: ownership.SummaryTable,
  analyzed: cfg.CfgView,
}

pub type VerdictTable = .{ key: ArtifactKey, by_key: Dict<String, SiteVerdict> }

fn int_has(d: Dict<Int, Bool>, k: Int) Bool {
  case d.get(k) {
    .Some(v) => v,
    .None => false,
  }
}

fn str_has(d: Dict<String, Bool>, k: String) Bool {
  case d.get(k) {
    .Some(v) => v,
    .None => false,
  }
}

fn seed_key(func_id: Int, param: Int) String {
  "${func_id}#${param}"
}

fn target_params(s: ownership.Summary) Vector<Int> {
  out: Vector<Int> = []
  for ps, i in s.params {
    case ps.base_role {
      .Consumed => if !ps.in_place_paths.is_empty() {
        out = .append(i)
      },
      _ => {},
    }
  }
  out
}

// The full set of param indices of `f` to seed Unique: consumed-path targets UNION the
// proven copy-carrier source indices. The same mixed-caller guard then applies to every
// index, so a borrow-effect source with a non-uniform caller is rejected exactly like a
// consumed-path target.
fn seed_param_indices(
  f: cfg.CfgFunction,
  s: ownership.Summary,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
  table: ownership.SummaryTable,
) Vector<Int> {
  idxs: Dict<Int, Bool> = Dict.new()
  for p in target_params(s) {
    idxs[p] = true
  }
  for p in ownership.structural_seed_params_for_borrow_effects(f, b, sem, table) {
    idxs[p] = true
  }
  collect p in idxs.keys() {
    p
  }
}

fn mark_closure_expr(e: AnfExpr, out: Dict<Int, Bool>) Dict<Int, Bool> {
  case e {
    .Let(_, op, body) => mark_closure_expr(body, mark_closure_op(op, out)),
    _ => out,
  }
}

fn mark_closure_op(op: AnfOp, out: Dict<Int, Bool>) Dict<Int, Bool> {
  case op {
    .AMakeClosure(fid, _) => {
      out[fid.id] = true
      out
    },
    .AIf(_, t, e) => mark_closure_expr(e, mark_closure_expr(t, out)),
    .AMatch(_, arms) => {
      cur := out
      for arm in arms {
        cur = mark_closure_expr(arm.body, cur)
      }
      cur
    },
    .ALoop(body) => mark_closure_expr(body, out),
    .ADefer(body) => mark_closure_expr(body, out),
    _ => out,
  }
}

fn unsafe_entry_funcs(opt: AnfModule) Dict<Int, Bool> {
  out: Dict<Int, Bool> = Dict.new()
  for ex in opt.lib_exports {
    case ex.target {
      .Function(fid) => out[fid.id] = true,
      _ => {},
    }
  }
  for f in opt.functions {
    out = mark_closure_expr(f.body, out)
  }
  out
}

fn op_calls_target(op: AnfOp, targets: Dict<Int, Bool>) Bool {
  case op {
    .ACall(callee, _) => case callee {
      .AGlobalFunc(fid) => int_has(targets, fid.id),
      _ => false,
    },
    _ => false,
  }
}

fn function_calls_target(f: cfg.CfgFunction, targets: Dict<Int, Bool>) Bool {
  for blk in f.blocks {
    for inst in blk.instructions {
      if op_calls_target(inst.op, targets) {
        return true
      }
    }
  }
  false
}

fn entry_seed_targets(
  view: cfg.CfgView,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
  table: ownership.SummaryTable,
  requested: Dict<Int, Bool>,
) Dict<Int, Bool> {
  targets: Dict<Int, Bool> = Dict.new()
  for f in view.functions {
    if int_has(requested, f.func_id) {
      case table.summary_get(f.func_id) {
        .Some(s) => if seed_param_indices(f, s, b, sem, table).len() > 0 {
          targets[f.func_id] = true
        },
        .None => {},
      }
    }
  }
  targets
}

fn all_func_targets(view: cfg.CfgView) Dict<Int, Bool> {
  out: Dict<Int, Bool> = Dict.new()
  for f in view.functions {
    out[f.func_id] = true
  }
  out
}

// Whole-function owned-entry seeding for the current non-cloning codegen path.
// A callee parameter may be seeded Unique only when every known direct call to
// that callee passes a proven Unique + last-use argument for that consumed param,
// and the callee is not exported or turned into a closure. Mixed caller shapes
// must wait for true FunctionVariant cloning/dispatch; they keep the generic body.
fn uniform_entry_seeds(
  opt: AnfModule,
  view: cfg.CfgView,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
  table: ownership.SummaryTable,
  requested: Dict<Int, Bool>,
) Dict<Int, Dict<Int, Bool>> {
  targets := entry_seed_targets(view, b, sem, table, requested)
  unsafe := unsafe_entry_funcs(opt)
  by_id: Dict<Int, cfg.CfgFunction> = Dict.new()
  for f in view.functions {
    by_id[f.func_id] = f
  }
  seen: Dict<String, Bool> = Dict.new()
  failed: Dict<String, Bool> = Dict.new()

  for f in view.functions {
    if function_calls_target(f, targets) {
      sites := ownership.call_uniques(f, table, b, sem, Dict.new(), Dict.new())
      for site in sites {
        if int_has(targets, site.callee) {
          s := case table.summary_get(site.callee) {
            .Some(x) => x,
            .None => ownership.Summary.{ params: [], ret: .Shared, ret_paths: [] },
          }
          case by_id.get(site.callee) {
            .Some(callee_f) => {
              for p in seed_param_indices(callee_f, s, b, sem, table) {
                key := seed_key(site.callee, p)
                seen[key] = true
                if p >= site.arg_unique.len() or !site.arg_unique[p] {
                  failed[key] = true
                }
              }
            },
            .None => {},
          }
        }
      }
    }
  }

  out: Dict<Int, Dict<Int, Bool>> = Dict.new()
  for f in view.functions {
    if int_has(targets, f.func_id) and !int_has(unsafe, f.func_id) {
      s := case table.summary_get(f.func_id) {
        .Some(x) => x,
        .None => ownership.Summary.{ params: [], ret: .Shared, ret_paths: [] },
      }
      seed: Dict<Int, Bool> = Dict.new()
      for p in seed_param_indices(f, s, b, sem, table) {
        key := seed_key(f.func_id, p)
        if str_has(seen, key) and !str_has(failed, key) and p < f.params.len() {
          seed[f.params[p].id] = true
        }
      }
      if seed.keys().len() > 0 {
        out[f.func_id] = seed
      }
    }
  }
  out
}

// Run the same structural-view -> prune -> summary -> ownership analysis
// sequence `twk ir --cfg` uses, carrying the optimized-ANF fingerprint so
// downstream consumers can reject a mismatched module.
pub fn compute_artifacts(opt: AnfModule, b: BuiltinRegistry, sem: OptimizerSemantics) OwnershipArtifacts {
  timed := timings_enabled()
  artifact_phase("begin full_cfg")
  t0 := date.now()
  view := cfg.build_view(opt, b)
  view = ownership.prune_dead_merge(view)
  t_view := date.now()
  artifact_phase("begin full_summary")
  table := summary.compute(view, b, sem)
  shell_seeds := uniform_entry_seeds(opt, view, b, sem, table, all_func_targets(view))
  entry_seeds: Dict<Int, ownership.EntrySeedFacts> = Dict.new()
  for fid, shell in shell_seeds {
    entry_seeds[fid] = ownership.EntrySeedFacts.{ unique_locals: shell, field_own: Dict.new() }
  }
  t_summary := date.now()
  artifact_phase("begin full_ownership")
  analyzed := ownership.analyze_with_summaries_and_entry_seeds(view, b, sem, table, entry_seeds)
  t_own := date.now()
  if timed {
    eprintln(
      "[time:mutable:artifacts] cfg=${t_view - t0}ms summary=${t_summary - t_view}ms ownership=${t_own
        - t_summary}ms scope_roots=-1",
    )
  }
  OwnershipArtifacts.{ key: artifact_key_for_anf(opt), view, table, analyzed }
}

// Like `compute_artifacts`, but scopes summary and ownership work to the mutable
// candidate functions and their dependency closure. Out-of-closure functions
// keep conservative summaries and cleared facts; verdicts for candidate sites
// are identical to the full analysis, so the resulting decisions match.
pub fn compute_candidate_artifacts(
  opt: AnfModule,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
  candidate_funcs: Dict<Int, Bool>,
) OwnershipArtifacts {
  compute_candidate_artifacts_seeded(
    opt,
    b,
    sem,
    candidate_funcs,
    variant_route.empty_seed_table(),
    ownership.empty_summary_table(),
  )
}

// Like `compute_candidate_artifacts`, but layers per-clone owned entry seeds over
// the uniform ones: each `owned_seeds` func has its named param locals certified
// `Unique` at block 0 (the routing gate proved every caller passes a unique
// last-use value). Seeded clone funcs are also folded into the analysis scope so
// their bodies are summarized and analyzed. Passing an empty table reproduces the
// unseeded behavior exactly.
pub fn compute_candidate_artifacts_seeded(
  opt: AnfModule,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
  candidate_funcs: Dict<Int, Bool>,
  owned_seeds: variant_route.OwnedSeedTable,
  carried: ownership.SummaryTable,
) OwnershipArtifacts {
  timed := timings_enabled()
  artifact_phase("begin scoped_cfg")
  t0 := date.now()
  view := cfg.build_view(opt, b)
  view = ownership.prune_dead_merge(view)
  t_view := date.now()
  artifact_phase("begin scoped_summary")

  scope := candidate_funcs
  for fid, _spec in owned_seeds.by_func {
    scope[fid] = true
  }

  // Reuse Phase 8G's whole-program summary as the seed when available (carried
  // non-empty and not disabled), recomputing only the clone-affected closure.
  // Falls back to the from-scratch scoped summary otherwise.
  use_reuse := carried.by_func.keys().len() > 0 and summary_reuse_enabled()
  summarized := if use_reuse {
    summary.compute_for_roots_reusing(view, b, sem, scope, carried)
  } else {
    summary.compute_for_roots_cached(view, b, sem, scope)
  }
  table := summarized.table
  shell_seeds := uniform_entry_seeds(opt, view, b, sem, table, scope)
  entry_seeds: Dict<Int, ownership.EntrySeedFacts> = Dict.new()
  for fid, shell in shell_seeds {
    entry_seeds[fid] = ownership.EntrySeedFacts.{ unique_locals: shell, field_own: Dict.new() }
  }

  // Layer each clone's owned seeds: whole-value Unique locals from `seed_locals`,
  // plus reference-typed field ownership from `field_seed_paths` (Phase 8H).
  for fid, spec in owned_seeds.by_func {
    merged_unique := case entry_seeds.get(fid) {
      .Some(fx) => fx.unique_locals,
      .None => Dict.new(),
    }
    for loc, _flag in spec.seed_locals {
      merged_unique[loc] = true
    }
    entry_seeds[fid] = ownership.EntrySeedFacts.{
      unique_locals: merged_unique,
      field_own: spec.field_seed_paths,
    }
  }
  t_summary := date.now()
  artifact_phase("begin scoped_ownership")
  analyzed := ownership.analyze_selected_with_summaries_and_entry_seeds(
    view,
    b,
    sem,
    table,
    scope,
    entry_seeds,
    summarized.fix_cache,
  )
  t_own := date.now()
  if timed {
    eprintln(
      "[time:mutable:artifacts] cfg=${t_view - t0}ms summary=${t_summary - t_view}ms ownership=${t_own
        - t_summary}ms scope_roots=${scope.keys().len()}",
    )
  }
  OwnershipArtifacts.{ key: artifact_key_for_anf(opt), view, table, analyzed }
}

// Flatten every analyzed block's exit verdicts into a table keyed by
// "<func_id>#<anf_local_id>" (local ids repeat across functions, so the
// function id must ride along).
pub fn verdicts_from_artifacts(artifacts: OwnershipArtifacts) VerdictTable {
  out: Dict<String, SiteVerdict> = Dict.new()
  for f in artifacts.analyzed.functions {
    for blk in f.blocks {
      for local_id, text in blk.exit.verdicts {
        reusable := case blk.exit.verdict_reusable_shell.get(local_id) {
          .Some(flag) => flag,
          .None => false,
        }
        field_reusable := case blk.exit.verdict_field_backing_reusable.get(local_id) {
          .Some(flag) => flag,
          .None => false,
        }
        out["${f.func_id}#${local_id}"] = SiteVerdict.{
          text,
          reusable_shell: reusable,
          field_backing_reusable: field_reusable,
        }
      }
    }
  }
  VerdictTable.{ key: artifacts.key, by_key: out }
}

// Project the full verdict table down to just the requested join keys.
pub fn verdicts_for_keys(artifacts: OwnershipArtifacts, keys: Dict<String, Bool>) VerdictTable {
  all := artifacts.verdicts_from_artifacts()
  out: Dict<String, SiteVerdict> = Dict.new()
  for k in keys.keys() {
    case all.by_key.get(k) {
      .Some(v) => out[k] = v,
      .None => {},
    }
  }
  VerdictTable.{ key: artifacts.key, by_key: out }
}

// Compatibility wrapper preserving the pre-artifact call shape.
pub fn update_verdicts(opt: AnfModule, b: BuiltinRegistry, sem: OptimizerSemantics) Dict<
  String,
  SiteVerdict,
> {
  compute_artifacts(opt, b, sem).verdicts_from_artifacts().by_key
}
