//! Phase 7E update-site dry-run: joins census candidate sites with ownership
//! verdicts and the persistent->mutable catalog pairing. Inspection only — no
//! codegen decision rides this module. A site "would use" its mutable target
//! only when BOTH the base/shell is owned/reusable per the typed ownership
//! verdict flag AND a mutable target actually exists for that call family (some
//! `.Update` families, e.g. `Vector.append`, have no in-place target at all).

use compiler.anf.{AnfModule}
use compiler.builtins.{BuiltinRegistry}
use compiler.census
use compiler.cfg
use compiler.codegen.mutable_catalog
use compiler.opt.semantics.{OptimizerSemantics, make_prelude_optimizer_semantics}
use compiler.ownership
use compiler.summary

pub type DryRunSite = .{
  func: String,
  family: String,
  persistent: String,
  mutable: String,
  verdict: String,
  reusable_shell: Bool,
  would_use: Bool,
  local: Int,
}

type SiteVerdict = .{ text: String, reusable_shell: Bool }

/// Join census candidates with ownership verdicts and the mutable-target
/// catalog, in census traversal order.
pub fn dry_run_sites(opt: AnfModule, b: BuiltinRegistry) Vector<DryRunSite> {
  sem := make_prelude_optimizer_semantics(b)
  cat := mutable_catalog.build(b, sem)
  sites := census.census_sites(opt, b)
  verdicts := collect_verdicts(opt, b, sem)

  out: Vector<DryRunSite> = []
  for s in sites {
    v := case verdicts.get("${s.func_id}#${s.local}") {
      .Some(verdict) => verdict,
      .None => SiteVerdict.{ text: "-", reusable_shell: false },
    }
    t := cat.targets_for_actual(b, s.actual_fid)
    out = .append(
      DryRunSite.{
        func: s.func,
        family: s.family,
        persistent: t.persistent,
        mutable: t.mutable,
        verdict: v.text,
        reusable_shell: v.reusable_shell,
        would_use: v.reusable_shell and t.has_mutable,
        local: s.local,
      },
    )
  }
  out
}

// Run the same structural-view -> prune -> summary -> ownership analysis
// sequence `twk ir --cfg` uses, then flatten every block's exit verdicts into a
// map keyed by "<func_id>#<anf_local_id>" (census's join key: local ids repeat
// across functions, so the function id must ride along).
fn collect_verdicts(opt: AnfModule, b: BuiltinRegistry, sem: OptimizerSemantics) Dict<
  String,
  SiteVerdict,
> {
  view := cfg.build_view(opt, b)
  view = ownership.prune_dead_merge(view)
  table := summary.compute(view, b, sem)
  analyzed := ownership.analyze_with_summaries(view, b, sem, table)

  out: Dict<String, SiteVerdict> = Dict.new()
  for f in analyzed.functions {
    for blk in f.blocks {
      for local_id, text in blk.exit.verdicts {
        reusable := case blk.exit.verdict_reusable_shell.get(local_id) {
          .Some(flag) => flag,
          .None => false,
        }
        out["${f.func_id}#${local_id}"] = SiteVerdict.{ text, reusable_shell: reusable }
      }
    }
  }
  out
}

/// Tab-separated per-site listing.
pub fn render_dry_run(sites: Vector<DryRunSite>) String {
  out := "func\tfamily\tpersistent\tmutable\twould_use\tverdict\n"
  for s in sites {
    out = .concat(
      "${s.func}\t${s.family}\t${s.persistent}\t${s.mutable}\t${s.would_use}\t${s.verdict}\n",
    )
  }
  out
}
