//! Phase 7E update-site dry-run: joins census candidate sites with ownership
//! verdicts and the persistent->mutable catalog pairing. Inspection only — no
//! codegen decision rides this module. A site "would use" its mutable target
//! only when BOTH the base/shell is owned/reusable per the typed ownership
//! verdict flag AND a mutable target actually exists for that call family (some
//! `.Update` families, e.g. `Vector.append`, have no in-place target at all).

use compiler.anf.{AnfModule}
use compiler.builtins.{BuiltinRegistry}
use compiler.census
use compiler.codegen.mutable_catalog
use compiler.codegen.ownership_verdicts
use compiler.opt.semantics.{make_prelude_optimizer_semantics}

pub type DryRunSite = .{
  func: String,
  family: String,
  persistent: String,
  mutable: String,
  verdict: String,
  reusable_shell: Bool,
  would_use: Bool,
  local: Int,
}

fn absent_verdicts_for(opt: AnfModule) ownership_verdicts.VerdictTable {
  ownership_verdicts.VerdictTable.{
    key: ownership_verdicts.artifact_key_for_anf(opt),
    by_key: Dict.new(),
  }
}

/// Join census candidates with ownership verdicts and the mutable-target
/// catalog, in census traversal order. Validates the supplied artifacts'
/// optimized-ANF fingerprint against `opt`; on mismatch, every site falls back
/// to an absent verdict rather than reading stale analysis.
pub fn dry_run_sites_with_artifacts(
  opt: AnfModule,
  b: BuiltinRegistry,
  artifacts: ownership_verdicts.OwnershipArtifacts,
) Vector<DryRunSite> {
  expected := ownership_verdicts.artifact_key_for_anf(opt)
  verdicts := if expected.same_artifact_key(artifacts.key) {
    artifacts.verdicts_from_artifacts()
  } else {
    absent_verdicts_for(opt)
  }
  dry_run_sites_with_verdict_table(opt, b, verdicts)
}

fn dry_run_sites_with_verdict_table(
  opt: AnfModule,
  b: BuiltinRegistry,
  verdicts: ownership_verdicts.VerdictTable,
) Vector<DryRunSite> {
  sem := make_prelude_optimizer_semantics(b)
  cat := mutable_catalog.build(b, sem)
  sites := census.census_sites(opt, b)

  out: Vector<DryRunSite> = []
  for s in sites {
    v := case verdicts.by_key.get("${s.func_id}#${s.local}") {
      .Some(verdict) => verdict,
      .None => ownership_verdicts.SiteVerdict.{
        text: "-",
        reusable_shell: false,
        field_backing_reusable: false,
      },
    }
    t := cat.targets_for_actual(b, s.actual_fid)
    out = .append(
      DryRunSite.{
        func: s.func,
        family: s.family,
        persistent: t.persistent,
        mutable: t.mutable,
        verdict: v.text,
        reusable_shell: v.reusable_shell,
        would_use: v.reusable_shell and t.has_mutable,
        local: s.local,
      },
    )
  }
  out
}

/// Join census candidates with ownership verdicts and the mutable-target
/// catalog, in census traversal order.
pub fn dry_run_sites(opt: AnfModule, b: BuiltinRegistry) Vector<DryRunSite> {
  sem := make_prelude_optimizer_semantics(b)
  dry_run_sites_with_artifacts(opt, b, ownership_verdicts.compute_artifacts(opt, b, sem))
}

/// Tab-separated per-site listing.
pub fn render_dry_run(sites: Vector<DryRunSite>) String {
  out := "func\tfamily\tpersistent\tmutable\twould_use\tverdict\n"
  for s in sites {
    out = .concat(
      "${s.func}\t${s.family}\t${s.persistent}\t${s.mutable}\t${s.would_use}\t${s.verdict}\n",
    )
  }
  out
}
