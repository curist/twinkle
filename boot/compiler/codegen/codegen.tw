//! Codegen integration pipeline.
//!
//! Wires closure_captures → prepare_backend → verify → plan_wasm_types →
//! emit_module → link → emit_wat.
//!
//! ARCHITECTURE NOTE: prepare_backend() is the explicit boundary between
//! optimized semantic ANF and the backend. All backend passes must flow
//! through that boundary. See boot/compiler/backend/prepare.tw for the
//! migration contract and per-phase plan. Phase 8A ownership decisions are
//! produced from optimized semantic ANF before closure conversion, because
//! summary/ownership analysis is defined for that stage. The resulting
//! decision table is threaded into prepare_backend_with_mutable_config; the
//! prepared-site selector remains the freshness gate, so closure-converted
//! shape drift falls back persistently instead of being re-proved in codegen.

use @std.buffer.{Buffer}
use @std.date
use @std.proc

use compiler.anf.{AnfModule}
use compiler.backend.closure_convert.{ClosureConversion, convert_closures}
use compiler.backend.context.{BackendContext}
use compiler.backend.prepare.{PreparedModule, backend_context, prepare_backend_with_mutable_config}
use compiler.backend.verify.{VerifyLevel, verify_prepared_module_with_level}
use compiler.builtins.{BuiltinRegistry}
use compiler.codegen.builder_region
use compiler.codegen.emit.{emit_module}
use compiler.codegen.intrinsics as cg_intrinsics
use compiler.codegen.linker.{LinkedModule, link}
use compiler.codegen.linker_dce.{eliminate_dead_wasm}
use compiler.codegen.mutable_produce
use compiler.codegen.mutable_select
use compiler.codegen.mutvec_region
use compiler.codegen.runtime.arr as rt_arr
use compiler.codegen.runtime.buf as rt_buf
use compiler.codegen.runtime.core as rt_core
use compiler.codegen.runtime.dict as rt_dict
use compiler.codegen.runtime.str as rt_str
use compiler.codegen.runtime.types as rt_types
use compiler.codegen.variant_route
use compiler.codegen.variant_specialize
use compiler.codegen.wasm.{emit_linked_wasm, emit_linked_wasm_buffer}
use compiler.codegen.wasm_ir.{ExportMeta, ExternMeta, MemoryExportDef, WasmModule}
use compiler.codegen.wasm_layout.{EqTypeLayouts, collect_eq_type_layouts}
use compiler.codegen.wasm_plan.{plan_wasm_types}
use compiler.codegen.wasm_plan_types.{WasmTypeRegistry}
use compiler.codegen.wat.{emit_wat}
use compiler.core_ir.{LibType}
use compiler.mono_type.{MonoType}
use compiler.opt.semantics.{OptimizerSemantics, make_prelude_optimizer_semantics}
use compiler.resolver.{ResolvedEnv, build_ref_field_table}

fn timings_enabled() Bool {
  case proc.env("TWINKLE_TIMINGS") {
    .Some(_) => true,
    .None => false,
  }
}

fn log_time(label: String, ms: Float) {
  eprintln("[time] ${label}: ${ms.to_string()}ms")
}

fn log_phase(label: String) {
  if timings_enabled() {
    eprintln("[time:phase] ${label}")
  }
}

fn mutable_produce_enabled() Bool {
  case proc.env("TWINKLE_MUTABLE_PRODUCE") {
    .Some("0") => false,
    _ => true,
  }
}

// Phase 8G ownership specialization is on by default; TWINKLE_VARIANT_SPECIALIZE=0
// is the kill-switch (both compilers fall back to the generic persistent path).
fn variant_specialize_enabled() Bool {
  case proc.env("TWINKLE_VARIANT_SPECIALIZE") {
    .Some("0") => false,
    _ => true,
  }
}

fn verify_level_from_env() VerifyLevel {
  case proc.env("TWINKLE_VERIFY_LEVEL") {
    .Some("basic") => .Basic,
    _ => .Full,
  }
}

pub fn runtime_modules(eq_layouts: EqTypeLayouts) Vector<WasmModule> {
  [
    rt_types.module(),
    rt_str.module(),
    rt_arr.module(),
    rt_dict.module(),
    rt_buf.module(),
    rt_core.module(eq_layouts),
    cg_intrinsics.module(),
  ]
}

// Shared result for the semantic-ANF-to-prepared-backend codegen preparation
// sequence. `prepared` is the backend boundary consumed by verification,
// planning, and emission; the earlier fields are exposed for inspection tools
// that render the authoritative ownership/mutable audit.
pub type PreparedCodegen = .{
  optimizer_semantics: OptimizerSemantics,
  builder_anf: AnfModule,
  specialization: variant_specialize.SpecializeResult,
  closure_conversion: ClosureConversion,
  produced_decisions: mutable_produce.ProducedDecisions,
  prepared: PreparedModule,
}

pub fn prepare_codegen(anf: AnfModule, env: ResolvedEnv, builtins: BuiltinRegistry) PreparedCodegen {
  timed := timings_enabled()

  // Env-aware semantics: the reference-typed record-field table lets ownership
  // specialization and mutable-decision production classify primitive vs
  // reference-typed fields exactly as the analysis/test path does. Built once and
  // threaded through both codegen stages below.
  sem_env := make_prelude_optimizer_semantics(builtins).with_ref_fields(build_ref_field_table(env))

  // Builder-region rewrite -> ANF'. Runs before closure conversion and the
  // call-swap producer so both consume the rewritten ANF (the call-swap stale-artifact
  // guard keys off the ANF fingerprint, which must be ANF').
  // MutVec region lowering runs immediately before builder_region and fully
  // rewrites every region it claims, so builder_region sees no surviving
  // builder-visible shape at those sites (no exclusion parameter needed).
  // Unclaimed code is byte-identical, so boot's own self-host (which claims no
  // regions) stays at the fixed point.
  anf_mutvec := mutvec_region.rewrite_module(anf, builtins)

  log_phase("begin builder_region_rewrite")
  tbr := date.now()
  anf_prime := builder_region.rewrite_module(anf_mutvec, builtins)
  tbr2 := date.now()

  if timed {
    log_time("builder_region_rewrite", tbr2 - tbr)
  }

  // Ownership-specialized function variants (Phase 8G) -> ANF''. Physically
  // clones callees under a proven owned precondition and routes satisfying caller
  // sites to the clone, so the seeded decision producer emits in-place at the
  // clone's own sites. Disabled via TWINKLE_VARIANT_SPECIALIZE=0.
  log_phase("begin variant_specialize")
  spec := if variant_specialize_enabled() {
    variant_specialize.specialize_module_with_sem(anf_prime, builtins, sem_env)
  } else {
    variant_specialize.SpecializeResult.{
      anf: anf_prime,
      seeds: variant_route.empty_seed_table(),
      routes: [],
      summary: variant_specialize.no_reuse_summary(),
      pruned_view: variant_specialize.no_reuse_view(),
      changed_funcs: Dict.new(),
      fix_cache: variant_specialize.no_reuse_fix_cache(),
    }
  }
  anf_spec := spec.anf
  tvs := date.now()

  if timed {
    log_time("variant_specialize", tvs - tbr2)
  }

  // Final closure conversion.
  log_phase("begin closure_convert")
  t0 := date.now()
  closure_conversion := convert_closures(anf_spec, env)
  t1 := date.now()

  if timed {
    log_time("closure_convert", t1 - t0)
  }

  // Produce mutable decisions over the optimized semantic ANF: update-call
  // families (vector/dict set and remove) plus record-shell updates. Ownership
  // summaries are pre-closure facts; backend emission consumes them only after
  // the prepared-site selector validates that the closure-converted site still
  // matches the recorded shape.
  log_phase("begin produce_mutable_decisions")
  produced_decisions := if mutable_produce_enabled() {
    mutable_produce.produce_mutable_decisions_seeded_with_sem(
      anf_spec,
      builtins,
      spec.seeds,
      sem_env,
      spec.summary,
      spec.pruned_view,
      spec.changed_funcs,
      spec.fix_cache,
    )
  } else {
    mutable_produce.ProducedDecisions.{
      table: mutable_select.empty_decision_table(),
      rows: [],
      artifact_computed: false,
    }
  }
  t1p := date.now()

  if timed {
    log_time("produce_mutable_decisions", t1p - t1)
  }

  // Prepare backend IR, wired with those decisions.
  log_phase("begin prepare_backend")
  prepared := prepare_backend_with_mutable_config(
    closure_conversion.anf,
    env,
    builtins,
    closure_conversion.captures,
    produced_decisions.table,
    mutable_select.enabled_emit_policy(),
  )
  t2 := date.now()

  if timed {
    log_time("prepare_backend", t2 - t1p)
  }

  .{
    optimizer_semantics: sem_env,
    builder_anf: anf_prime,
    specialization: spec,
    closure_conversion,
    produced_decisions,
    prepared,
  }
}

pub fn link_program(anf: AnfModule, env: ResolvedEnv, builtins: BuiltinRegistry) LinkedModule {
  prepared_codegen := prepare_codegen(anf, env, builtins)
  prepared := prepared_codegen.prepared
  backend_ctx := backend_context(env, prepared)
  registry := verify_and_plan(prepared, backend_ctx, builtins)
  user_module := emit_user_module(prepared, registry, builtins, backend_ctx)
  linked := link_with_runtime(user_module, registry)
  finalize_linked_module(linked, anf)
}

fn verify_and_plan(prepared: PreparedModule, backend_ctx: BackendContext, builtins: BuiltinRegistry) WasmTypeRegistry {
  timed := timings_enabled()
  t2 := date.now()

  // Verify prepared backend IR.
  log_phase("begin verify")
  case verify_prepared_module_with_level(prepared, backend_ctx, builtins, verify_level_from_env()) {
    .Ok(_) => {},
    .Err(msg) => error(msg),
  }

  t3 := date.now()

  if timed {
    log_time("verify", t3 - t2)
  }

  // Plan Wasm types from prepared backend IR.
  log_phase("begin plan_wasm_types")
  registry := plan_wasm_types(prepared, backend_ctx, builtins)
  t4 := date.now()

  if timed {
    log_time("plan_wasm_types", t4 - t3)
  }

  registry
}

fn emit_user_module(
  prepared: PreparedModule,
  registry: WasmTypeRegistry,
  builtins: BuiltinRegistry,
  backend_ctx: BackendContext,
) WasmModule {
  timed := timings_enabled()
  t4 := date.now()

  log_phase("begin emit_module")
  user_module := emit_module(prepared, registry, builtins, backend_ctx)
  t5 := date.now()

  if timed {
    log_time("emit_module", t5 - t4)
  }

  user_module
}

fn link_with_runtime(user_module: WasmModule, registry: WasmTypeRegistry) LinkedModule {
  timed := timings_enabled()
  t5 := date.now()

  log_phase("begin link")
  eq_layouts := collect_eq_type_layouts(registry.layout_cache)
  modules := runtime_modules(eq_layouts).append(user_module)
  linked := case link(modules, .None) {
    .Ok(l) => l,
    .Err(errors) => {
      msg := "Link errors:"

      for e in errors {
        case e {
          .MissingExport(mod, name) => {
            msg = "${msg}\n  missing export: ${mod}.${name}"
          },
        }
      }

      error(msg)
    },
  }
  t6 := date.now()

  if timed {
    log_time("link", t6 - t5)
  }

  linked
}

fn finalize_linked_module(linked: LinkedModule, anf: AnfModule) LinkedModule {
  timed := timings_enabled()
  t6 := date.now()
  result := linked

  // Attach extern FFI metadata for the twinkle.externs custom section,
  // derived from the source extern_imports (MonoTypes), before Wasm DCE filters
  // it down to the live imports.
  result.extern_meta = collect_extern_meta(anf)
  result.export_meta = collect_export_meta(anf)

  // Wasm-level dead code elimination.
  log_phase("begin wasm_dce")
  result = eliminate_dead_wasm(result)

  // Conditional linear-memory emission: rt.buf's memory + globals survive Wasm
  // DCE (which only prunes funcs), so drop them when no buffer op is live.
  // Names are linker-qualified: rt.buf funcs/globals -> "rt_buf__*"; the memory
  // keeps its unqualified name "heap" (linker concatenates memories without
  // renaming).
  buf_live := result.funcs.any(fn(f) { f.name.starts_with("rt_buf__") })

  if !buf_live {
    result.memories = .filter(fn(m) { m.name != "heap" })
    result.globals = .filter(fn(g) { !g.name.starts_with("rt_buf__") })
    result.memory_exports = .filter(fn(me) { me.wasm_name != "memory" })
  } else if result.memory_exports.len() == 0 {
    result.memory_exports = [MemoryExportDef.{ wasm_name: "memory", memory_idx: 0 }]
  }

  t7 := date.now()

  if timed {
    log_time("wasm_dce", t7 - t6)
  }

  result
}

/// Marshal kind for an extern arg/return MonoType, for the twinkle.externs
/// custom section. Extern signatures are restricted to extern-safe types, so
/// this is total over what can actually appear; the fallback keeps non-numeric
/// refs raw rather than mis-decoding them as strings.
fn mono_type_kind(ty: MonoType) String {
  case ty {
    .String => "str",
    .Int => "i64",
    .Float => "f64",
    .Bool => "i32",
    .Byte => "i32",
    .ExternRef(_) => "ref",
    .Optional(inner) => mono_type_kind(inner),
    .Vector(.Byte) => "bytes",
    .Vector(.String) => "strvec",
    .Result(.Vector(.Byte), .String) => "readfile",
    _ => "ref",
  }
}

/// Build the FFI metadata for every declared extern import, from the source
/// MonoTypes. Wasm DCE later trims this to the imports that survive.
fn collect_extern_meta(anf: AnfModule) Vector<ExternMeta> {
  result: Vector<ExternMeta> = []

  for fid, ext in anf.extern_imports {
    args := collect ty in ext.param_tys {
      mono_type_kind(ty)
    }
    ret := case ext.return_ty {
      .Some(.Void) => "void",
      .Some(.Never) => "void",
      .Some(ty) => mono_type_kind(ty),
      .None => "void",
    }
    result = .append(.{ module: ext.wasm_module, name: ext.wasm_name, args, ret })
  }

  result
}

// A `twinkle.exports` marshal descriptor, as a raw JSON *value* string. Leaves
// are bare quoted strings (matching the `twinkle.externs` vocabulary); compound
// types nest as JSON objects — `fn` here, with room for later increments.
pub fn export_type_json(t: LibType) String {
  case t {
    .Int => "\"int\"",
    .Float => "\"float\"",
    .Bool => "\"bool\"",
    .Void => "\"void\"",
    .Str => "\"str\"",
    .Fn(ps, r) => {
      arg_parts := collect p in ps {
        export_type_json(p)
      }
      "{\"kind\":\"fn\",\"args\":[${arg_parts.join(",")}],\"ret\":${export_type_json(r)}}"
    },
    .Vec(e) => "{\"kind\":\"vec\",\"elem\":${export_type_json(e)}}",
    .Dct(k, v) => "{\"kind\":\"dict\",\"key\":${export_type_json(k)},\"val\":${export_type_json(v)}}",
    .Rec(name, _, fields) => {
      // Record and field names are identifiers, so no JSON escaping is needed.
      // The wasm struct sym is codegen-internal and stays out of the descriptor.
      parts := collect f in fields {
        "[\"${f.name}\",${export_type_json(f.ty)}]"
      }
      "{\"kind\":\"rec\",\"name\":\"${name}\",\"fields\":[${parts.join(",")}]}"
    },
  }
}

fn collect_export_meta(anf: AnfModule) Vector<ExportMeta> {
  collect exp in anf.lib_exports {
    kind := case exp.target {
      .Function(_) => "fn",
      .Value(_) => "value",
    }
    ExportMeta.{
      name: exp.name,
      wasm_name: exp.wasm_name,
      kind,
      args: collect p in exp.params {
        export_type_json(p)
      },
      ret: export_type_json(exp.ret),
    }
  }
}

pub fn codegen(anf: AnfModule, env: ResolvedEnv, builtins: BuiltinRegistry) String {
  emit_wat(link_program(anf, env, builtins))
}

pub fn codegen_wasm(anf: AnfModule, env: ResolvedEnv, builtins: BuiltinRegistry) Vector<Byte> {
  linked := link_program(anf, env, builtins)
  timed := timings_enabled()
  t0 := date.now()
  bytes := emit_linked_wasm(linked)
  t1 := date.now()

  if timed {
    log_time("emit_wasm_binary", t1 - t0)
  }

  bytes
}

pub fn codegen_wasm_buffer(anf: AnfModule, env: ResolvedEnv, builtins: BuiltinRegistry) Buffer {
  linked := link_program(anf, env, builtins)
  timed := timings_enabled()
  t0 := date.now()
  bytes := emit_linked_wasm_buffer(linked)
  t1 := date.now()

  if timed {
    log_time("emit_wasm_binary", t1 - t0)
  }

  bytes
}
