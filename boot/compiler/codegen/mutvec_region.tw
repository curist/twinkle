//! MutVec region detector (storage slice 1) — analysis only, no emit yet.
//!
//! Recognizes an owned local `Vector<Int>` that carries at least one indexed
//! update and is published at a single return boundary — the genuinely-new shape
//! the builder-region pass never claims (it only handles append-only folds). The
//! scan is sound-by-rejection: it keys on an indexed update (`vector$set_unsafe`)
//! whose base is a locally-born owned handle, then requires EVERY use of that
//! handle to be a supported in-region op (set / append / index-read / len) and
//! EXACTLY ONE terminal to return it. Any other use — passing the handle to a
//! call, storing it in an aggregate, capturing it, a second exit, a `break value`
//! — rejects the region (persistent fallback). Reuses builder_region_detect's
//! reference-scan helpers so the two typed-vector-region passes converge cheaply.

use compiler.anf.{AnfExpr, AnfFunctionDef, AnfMatchArm, AnfModule, AnfOp, Atom}
use compiler.builder_region_detect.{atom_is_local, op_references_deep}
use compiler.builtins
use compiler.builtins.{BuiltinRegistry}
use compiler.core_ir.{FuncId, LocalId}
use compiler.mono_type.{MonoType}
use compiler.opt.analysis.{next_local_id}

pub type MutVecProducer = { CollectSeed, MakeSeed, ArrayLitSeed }

pub type MutVecOpKind = { Set, Push, Get, Len }

pub type MutVecOpSite = .{ site: LocalId, kind: MutVecOpKind }

// A detected, claimable MutVec region. Slice 1 records the handle (the owned
// Vector<Int> SSA local), its producer class, and every in-region op site.
// `escapes` distinguishes the two lowered shapes: when true the handle leaves
// at a single return and is materialized by a boundary freeze; when false the
// handle is a pure local scratch buffer (read-only reductions only) that is
// never published, so no freeze is emitted at all.
pub type MutVecRegion = .{
  func_id: FuncId,
  func: String,
  proof_id: String,
  handle: LocalId,
  producer: MutVecProducer,
  op_sites: Vector<MutVecOpSite>,
  escapes: Bool,
}

// Resolved builtin FuncIds the detector keys on. Both freeze families count as a
// collect producer: a `collect` over Vector<Int> lowers to the boxed builder
// unless typed-vector routing promoted it to the i64 builder, so accept either
// (the Int-mono gate is what actually restricts slice 1 to Int).
type OpIds = .{
  set_unsafe: FuncId,
  append: FuncId,
  len: FuncId,
  make: FuncId,
  builder_new: FuncId,
  builder_push: FuncId,
  freeze_box: FuncId,
  freeze_i64: FuncId,
}

fn resolve_ids(b: BuiltinRegistry) OpIds {
  .{
    set_unsafe: builtins.id(b, "vector$set_unsafe"),
    append: builtins.id(b, "vector$append"),
    len: builtins.id(b, "vector$len"),
    make: builtins.id(b, "vector$make"),
    builder_new: builtins.id(b, "vector$builder_new"),
    builder_push: builtins.id(b, "vector$builder_push"),
    freeze_box: builtins.id(b, "vector$builder_freeze"),
    freeze_i64: builtins.id(b, "vector$builder_freeze_i64"),
  }
}

// ── Definition map (local id -> its defining op), for producer classification ──
fn collect_defs(e: AnfExpr, defs: Dict<Int, AnfOp>) Dict<Int, AnfOp> {
  case e {
    .Let(local, op, body) => {
      defs[local.id] = op
      collect_defs(body, collect_defs_in_op(op, defs))
    },
    _ => defs,
  }
}

fn collect_defs_in_op(op: AnfOp, defs: Dict<Int, AnfOp>) Dict<Int, AnfOp> {
  case op {
    .AIf(_, t, e) => collect_defs(e, collect_defs(t, defs)),
    .AMatch(_, arms) => {
      cur := defs
      for arm in arms {
        cur = collect_defs(arm.body, cur)
      }
      cur
    },
    .ALoop(b) => collect_defs(b, defs),
    .ADefer(b) => collect_defs(b, defs),
    _ => defs,
  }
}

// Classify a producer op directly: a builder freeze (collect), a Vector.make, or
// an array literal.
fn producer_of_op(op: AnfOp, ids: OpIds) MutVecProducer? {
  case op {
    .AArrayLit(_) => .Some(.ArrayLitSeed),
    .ACall(.AGlobalFunc(f), _) => if f.id == ids.make.id {
      .Some(.MakeSeed)
    } else if f.id == ids.freeze_box.id or f.id == ids.freeze_i64.id {
      .Some(.CollectSeed)
    } else {
      .None
    },
    _ => .None,
  }
}

// A handle is owned-born iff its defining op is a supported producer — either
// directly, or through one `AInit` copy (both `collect` and `Vector.make` bind a
// temp that an `AInit` re-binds to the source-level handle local).
fn classify_producer(h: LocalId, defs: Dict<Int, AnfOp>, ids: OpIds) MutVecProducer? {
  case defs.get(h.id) {
    .Some(op) => case op {
      .AInit(.ALocal(src)) => case defs.get(src.id) {
        .Some(srcop) => producer_of_op(srcop, ids),
        .None => .None,
      },
      _ => producer_of_op(op, ids),
    },
    .None => .None, // parameter or undefined — not a locally-born owned value
  }
}

// ── Handle-use scan (sound-by-rejection) ──
type UseScan = .{ supported: Bool, set_count: Int, exit_count: Int, op_sites: Vector<MutVecOpSite> }

fn empty_scan() UseScan {
  .{ supported: true, set_count: 0, exit_count: 0, op_sites: [] }
}

fn reject(s: UseScan) UseScan {
  .{ supported: false, set_count: s.set_count, exit_count: s.exit_count, op_sites: s.op_sites }
}

fn record_op(s: UseScan, site: LocalId, kind: MutVecOpKind) UseScan {
  .{
    supported: s.supported,
    set_count: case kind {
      .Set => s.set_count + 1,
      _ => s.set_count,
    },
    exit_count: s.exit_count,
    op_sites: s.op_sites.append(MutVecOpSite.{ site, kind }),
  }
}

fn bump_exit(s: UseScan) UseScan {
  .{
    supported: s.supported,
    set_count: s.set_count,
    exit_count: s.exit_count + 1,
    op_sites: s.op_sites,
  }
}

fn scan_uses(e: AnfExpr, h: LocalId, ids: OpIds, s: UseScan) UseScan {
  scan_uses_at(e, h, ids, s, true)
}

fn scan_uses_at(e: AnfExpr, h: LocalId, ids: OpIds, s: UseScan, terminal_exit_ok: Bool) UseScan {
  case e {
    .Let(local, op, body) => {
      s2 := scan_use_op(op, local, h, ids, s)
      scan_uses_at(body, h, ids, s2, terminal_exit_ok)
    },
    .Atom(a) => if atom_is_local(a, h) {
      if terminal_exit_ok {
        s.bump_exit()
      } else {
        s.reject()
      }
    } else {
      s
    },
    .Return(.Some(a)) => if atom_is_local(a, h) {
      if terminal_exit_ok {
        s.bump_exit()
      } else {
        s.reject()
      }
    } else {
      s
    },
    .Return(.None) => s,
    // A `break value` carrying the handle is a second, non-freezable publication
    // path — reject the whole region.
    .Break(.Some(a)) => if atom_is_local(a, h) {
      s.reject()
    } else {
      s
    },
    .Break(.None) => s,
    .Continue => s,
  }
}

fn scan_use_op(op: AnfOp, local: LocalId, h: LocalId, ids: OpIds, s: UseScan) UseScan {
  case op {
    // Control flow: never a direct use of the handle; recurse into sub-exprs.
    .AIf(cnd, t, e) => {
      s0 := if atom_is_local(cnd, h) {
        s.reject()
      } else {
        s
      }
      scan_uses_at(e, h, ids, scan_uses_at(t, h, ids, s0, false), false)
    },
    .AMatch(scrut, arms) => {
      s0 := if atom_is_local(scrut, h) {
        s.reject()
      } else {
        s
      }
      cur := s0
      for arm in arms {
        cur = scan_uses_at(arm.body, h, ids, cur, false)
      }
      cur
    },
    .ALoop(body) => scan_uses_at(body, h, ids, s, false),
    .ADefer(body) => scan_uses_at(body, h, ids, s, false),
    // Leaf ops: only classify when this op references the handle at all.
    _ => if op_references_deep(op, h) {
      classify_leaf_use(op, local, h, ids, s)
    } else {
      s
    },
  }
}

fn classify_leaf_use(op: AnfOp, local: LocalId, h: LocalId, ids: OpIds, s: UseScan) UseScan {
  case op {
    .ACall(.AGlobalFunc(f), args) => if f.id == ids.set_unsafe.id
      and args.len() == 3 and atom_is_local(args[0], h) and !atom_is_local(args[1], h)
      and !atom_is_local(args[2], h) {
      s.record_op(local, .Set)
    } else if f.id == ids.append.id
      and args.len() == 2 and atom_is_local(args[0], h) and !atom_is_local(args[1], h) {
      s.record_op(local, .Push)
    } else if f.id == ids.len.id and args.len() == 1 and atom_is_local(args[0], h) {
      s.record_op(local, .Len)
    } else {
      // Handle passed to some other call, or as a non-base argument — escape.
      s.reject()
    },
    // Any other callee form (closure/local callee) carrying the handle — escape.
    .ACall(_, _) => s.reject(),
    .AIndex(base, idx, _, _) => if atom_is_local(base, h) and !atom_is_local(idx, h) {
      s.record_op(local, .Get)
    } else {
      s.reject()
    },
    // SSA rebind of the handle itself (`assign H = <op result>`): supported. The
    // handle flowing INTO a different local via assign is an alias escape.
    .AAssign(target, _) => if target.id == h.id {
      s
    } else {
      s.reject()
    },
    // `L = init H` copies the handle into another local — an alias that may escape.
    .AInit(_) => s.reject(),
    // Stored into a record/variant/array, captured by a closure, wrapped — escape.
    _ => s.reject(),
  }
}

// ── Eligibility ──
fn handle_is_vector_int(f: AnfFunctionDef, h: LocalId) Bool {
  case f.op_result_mono.get(h.id) {
    .Some(mono) => case mono {
      .Vector(inner) => case inner {
        .Int => true,
        _ => false,
      },
      _ => false,
    },
    .None => false,
  }
}

fn eligible(f: AnfFunctionDef, h: LocalId, defs: Dict<Int, AnfOp>, ids: OpIds) MutVecRegion? {
  if !handle_is_vector_int(f, h) {
    return .None
  }
  producer := case classify_producer(h, defs, ids) {
    .Some(p) => p,
    .None => return .None,
  }
  scan := scan_uses(f.body, h, ids, empty_scan())
  if !scan.supported {
    return .None
  }

  // The genuinely-new shape requires >=1 indexed update. Two claimable exit
  // shapes: exactly one terminal carries the handle (escapes -> boundary freeze),
  // or none does (a pure local scratch buffer -> no freeze). Two or more
  // handle-carrying terminals is still rejected (multiple materialization points).
  if scan.set_count < 1 {
    return .None
  }
  if scan.exit_count > 1 {
    return .None
  }
  .Some(
    MutVecRegion.{
      func_id: f.func_id,
      func: f.name,
      proof_id: "mv:${f.func_id.id}:${h.id}",
      handle: h,
      producer,
      op_sites: scan.op_sites,
      escapes: scan.exit_count == 1,
    },
  )
}

// ── Candidate handles: every distinct base local of a vector$set_unsafe call ──
// Dedup is against the threaded `out` accumulator, not a side Dict: a Twinkle
// Dict is persistent, so a `seen[id]=true` mutation would not survive across the
// Let-chain (only `out` is returned), and a handle written twice would be
// collected — and then rewritten — twice. Membership scans `out`, which is tiny.
fn base_seen(out: Vector<LocalId>, id: Int) Bool {
  for b in out {
    if b.id == id {
      return true
    }
  }
  false
}

fn collect_set_bases(e: AnfExpr, ids: OpIds, out: Vector<LocalId>) Vector<LocalId> {
  case e {
    .Let(_, op, body) => collect_set_bases(body, ids, collect_set_bases_in_op(op, ids, out)),
    _ => out,
  }
}

fn collect_set_bases_in_op(op: AnfOp, ids: OpIds, out: Vector<LocalId>) Vector<LocalId> {
  case op {
    .ACall(.AGlobalFunc(f), args) => if f.id == ids.set_unsafe.id and args.len() == 3 {
      case args[0] {
        .ALocal(base) => if base_seen(out, base.id) {
          out
        } else {
          out.append(base)
        },
        _ => out,
      }
    } else {
      out
    },
    .AIf(_, t, e) => collect_set_bases(e, ids, collect_set_bases(t, ids, out)),
    .AMatch(_, arms) => {
      cur := out
      for arm in arms {
        cur = collect_set_bases(arm.body, ids, cur)
      }
      cur
    },
    .ALoop(b) => collect_set_bases(b, ids, out),
    .ADefer(b) => collect_set_bases(b, ids, out),
    _ => out,
  }
}

fn detect_in_func(f: AnfFunctionDef, ids: OpIds) Vector<MutVecRegion> {
  defs := collect_defs(f.body, Dict.new())
  bases := collect_set_bases(f.body, ids, [])
  regions: Vector<MutVecRegion> = []
  for h in bases {
    case eligible(f, h, defs, ids) {
      .Some(r) => regions = .append(r),
      .None => {},
    }
  }
  regions
}

// Detect every claimable MutVec region in the module. Analysis only — produces
// decision records; no ANF is rewritten here.
pub fn detect_regions(m: AnfModule, b: BuiltinRegistry) Vector<MutVecRegion> {
  ids := resolve_ids(b)
  out: Vector<MutVecRegion> = []
  for f in m.functions {
    for r in detect_in_func(f, ids) {
      out = .append(r)
    }
  }
  out
}

// ── Rewrite (S2): lower a claimed region to mutvec_* ops ──────────────────────
// The mutvec runtime op FuncIds the rewrite emits.
type MutVecIds = .{
  new_i64: FuncId,
  make_i64: FuncId,
  push_i64: FuncId,
  set_i64: FuncId,
  get_i64: FuncId,
  len_i64: FuncId,
  freeze_i64: FuncId,
}

fn resolve_mutvec_ids(b: BuiltinRegistry) MutVecIds {
  .{
    new_i64: builtins.id(b, "vector$__mutvec_new_i64"),
    make_i64: builtins.id(b, "vector$__mutvec_make_i64"),
    push_i64: builtins.id(b, "vector$__mutvec_push_i64"),
    set_i64: builtins.id(b, "vector$__mutvec_set_i64"),
    get_i64: builtins.id(b, "vector$__mutvec_get_i64"),
    len_i64: builtins.id(b, "vector$__mutvec_len_i64"),
    freeze_i64: builtins.id(b, "vector$__mutvec_freeze_i64"),
  }
}

// The producer source local: the handle is `H = init src`, and `src`'s own op is
// the producer (a `Vector.make` call for MakeSeed, a builder freeze for
// CollectSeed). Slice-1-increment-1 lowers MakeSeed only.
fn producer_source(h: LocalId, defs: Dict<Int, AnfOp>) LocalId? {
  case defs.get(h.id) {
    .Some(op) => case op {
      .AInit(.ALocal(src)) => .Some(src),
      _ => .None,
    },
    .None => .None,
  }
}

// Region info threaded through the rewrite walk (ctx-first so the walk reads as
// inherent-method steps). Exactly one producer field is populated per region:
// `make_src` for MakeSeed; `builder_new_local` + `builder_aliases` + `freeze_temp`
// for CollectSeed (the builder chain feeding the handle).
type RwCtx = .{
  h: LocalId,
  ids: OpIds,
  mids: MutVecIds,
  make_src: Int, // Vector.make producer result local, else -1
  builder_new_local: Int, // collect builder_new result local, else -1
  builder_aliases: Dict<Int, Bool>, // collect builder-alias locals (freeze-arg init chain)
  freeze_temp: Int, // collect builder_freeze result local (-> init passthrough), else -1
}

fn atom_in_set(a: Atom, ids: Dict<Int, Bool>) Bool {
  case a {
    .ALocal(l) => ids.has(l.id),
    _ => false,
  }
}

// Swap a single op that references the handle (or the producer/builder chain) to
// its mutvec twin. Non-matching ops pass through; control-flow ops recurse so
// in-region reads/sets nested in branches or the collect loop are covered.
fn rewrite_op(ctx: RwCtx, op: AnfOp, local: LocalId) AnfOp {
  case op {
    .ACall(.AGlobalFunc(f), args) => if local.id == ctx.make_src
      and f.id == ctx.ids.make.id and args.len() == 2 {
      // producer: Vector.make -> mutvec_make_i64 (same args; fill coerces i64)
      .ACall(.AGlobalFunc(ctx.mids.make_i64), args)
    } else if local.id == ctx.builder_new_local
      and f.id == ctx.ids.builder_new.id and args.len() == 0 {
      // producer: collect builder_new() -> mutvec_new_i64(0) (0 rounds to MIN_CAP)
      .ACall(.AGlobalFunc(ctx.mids.new_i64), [.ALitInt(0)])
    } else if local.id == ctx.freeze_temp and f.id == ctx.ids.freeze_box.id and args.len() == 1 {
      // producer: collect builder_freeze(b) is elided — the handle IS the mutvec;
      // slide materialization to the boundary. Passthrough the builder alias.
      .AInit(args[0])
    } else if f.id == ctx.ids.builder_push.id
      and args.len() == 2 and atom_in_set(args[0], ctx.builder_aliases) {
      // collect loop: builder_push(b, x) -> mutvec_push_i64(b, x)
      .ACall(.AGlobalFunc(ctx.mids.push_i64), args)
    } else if f.id == ctx.ids.set_unsafe.id and args.len() == 3 and atom_is_local(args[0], ctx.h) {
      .ACall(.AGlobalFunc(ctx.mids.set_i64), args)
    } else if f.id == ctx.ids.append.id and args.len() == 2 and atom_is_local(args[0], ctx.h) {
      .ACall(.AGlobalFunc(ctx.mids.push_i64), args)
    } else if f.id == ctx.ids.len.id and args.len() == 1 and atom_is_local(args[0], ctx.h) {
      .ACall(.AGlobalFunc(ctx.mids.len_i64), args)
    } else {
      op
    },
    .AIndex(base, idx, _, _) => if atom_is_local(base, ctx.h) and !atom_is_local(idx, ctx.h) {
      .ACall(.AGlobalFunc(ctx.mids.get_i64), [base, idx])
    } else {
      op
    },
    // Nested control flow is never the tail exit (detector rejects a handle
    // terminal there), so recurse with freeze disabled (-1).
    .AIf(cnd, t, e) => .AIf(cnd, ctx.rewrite_expr(t, -1), ctx.rewrite_expr(e, -1)),
    .AMatch(scrut, arms) => .AMatch(
      scrut,
      collect arm in arms {
        AnfMatchArm.{ pattern: arm.pattern, body: ctx.rewrite_expr(arm.body, -1) }
      },
    ),
    .ALoop(body) => .ALoop(ctx.rewrite_expr(body, -1)),
    .ADefer(body) => .ADefer(ctx.rewrite_expr(body, -1)),
    _ => op,
  }
}

// The boundary freeze is inserted only at the single tail exit carrying the
// handle (the detector proved exactly one such terminal, at the top-level tail).
// `freeze_local < 0` means "not at the top-level tail" (inside a branch/loop),
// where the detector guarantees no handle-carrying terminal appears.
fn freeze_at_exit(ctx: RwCtx, a: Atom, ret: Bool, freeze_local: Int) AnfExpr {
  if freeze_local < 0 or !atom_is_local(a, ctx.h) {
    if ret {
      .Return(.Some(a))
    } else {
      .Atom(a)
    }
  } else {
    fresh := LocalId.{ id: freeze_local }
    frozen: Atom = .ALocal(fresh)
    .Let(
      fresh,
      .ACall(.AGlobalFunc(ctx.mids.freeze_i64), [.ALocal(ctx.h)]),
      if ret {
        .Return(.Some(frozen))
      } else {
        .Atom(frozen)
      },
    )
  }
}

fn rewrite_expr(ctx: RwCtx, e: AnfExpr, freeze_local: Int) AnfExpr {
  case e {
    .Let(local, op, body) => .Let(
      local,
      ctx.rewrite_op(op, local),
      ctx.rewrite_expr(body, freeze_local),
    ),
    .Atom(a) => ctx.freeze_at_exit(a, false, freeze_local),
    .Return(.Some(a)) => ctx.freeze_at_exit(a, true, freeze_local),
    _ => e,
  }
}

// ── Post-rewrite retyping of mutvec_push result locals ──
// mutvec_push_i64 returns the handle (MutVecI64); the boxed builder_push it
// replaces returned Void, so the collect loop's discarded push-result binding
// (and its init copies) carry a Void mono and get no slot. Retype them to
// Vector<Int> so a slot is allocated and mutvec_repr marks it MutVec(I64).
fn collect_push_results(e: AnfExpr, mids: MutVecIds, acc: Dict<Int, Bool>) Dict<Int, Bool> {
  case e {
    .Let(local, op, body) => collect_push_results(
      body,
      mids,
      collect_push_results_op(local, op, mids, acc),
    ),
    _ => acc,
  }
}

fn collect_push_results_op(local: LocalId, op: AnfOp, mids: MutVecIds, acc: Dict<Int, Bool>) Dict<
  Int,
  Bool,
> {
  case op {
    .ACall(.AGlobalFunc(f), _) => if f.id == mids.push_i64.id {
      acc[local.id] = true
      acc
    } else {
      acc
    },
    .AInit(.ALocal(s)) => if acc.has(s.id) {
      acc[local.id] = true
      acc
    } else {
      acc
    },
    .AIf(_, t, e) => collect_push_results(e, mids, collect_push_results(t, mids, acc)),
    .AMatch(_, arms) => {
      for arm in arms {
        acc = collect_push_results(arm.body, mids, acc)
      }
      acc
    },
    .ALoop(b) => collect_push_results(b, mids, acc),
    .ADefer(b) => collect_push_results(b, mids, acc),
    _ => acc,
  }
}

// Trace the builder-alias init chain back from the freeze argument to its
// builder_new, gathering every alias local. `.None` if the shape is unexpected.
type BuilderTrace = .{ aliases: Dict<Int, Bool>, new_local: Int }

fn trace_builder(cur: Int, defs: Dict<Int, AnfOp>, ids: OpIds, aliases: Dict<Int, Bool>) BuilderTrace? {
  aliases[cur] = true
  case defs.get(cur) {
    .Some(op) => case op {
      .AInit(.ALocal(prev)) => trace_builder(prev.id, defs, ids, aliases),
      .ACall(.AGlobalFunc(g), a) => if g.id == ids.builder_new.id and a.len() == 0 {
        .Some(.{ aliases, new_local: cur })
      } else {
        .None
      },
      _ => .None,
    },
    .None => .None,
  }
}

// Build the rewrite context for a claimable region, or `.None` if its concrete
// ANF shape has drifted from what the detector expects (persistent fallback).
fn build_ctx(r: MutVecRegion, defs: Dict<Int, AnfOp>, ids: OpIds, mids: MutVecIds) RwCtx? {
  empty: RwCtx = .{
    h: r.handle,
    ids,
    mids,
    make_src: -1,
    builder_new_local: -1,
    builder_aliases: Dict.new(),
    freeze_temp: -1,
  }
  case r.producer {
    .MakeSeed => {
      src := case producer_source(r.handle, defs) {
        .Some(s) => s,
        .None => return .None,
      }
      case defs.get(src.id) {
        .Some(.ACall(.AGlobalFunc(g), a)) => if g.id != ids.make.id or a.len() != 2 {
          return .None
        },
        _ => return .None,
      }
      empty.make_src = src.id
      .Some(empty)
    },
    .CollectSeed => {
      freeze_temp := case producer_source(r.handle, defs) {
        .Some(s) => s,
        .None => return .None,
      }

      // freeze_temp's op must be the boxed builder_freeze(builder_arg).
      builder_arg := case defs.get(freeze_temp.id) {
        .Some(.ACall(.AGlobalFunc(g), a)) => if g.id == ids.freeze_box.id and a.len() == 1 {
          case a[0] {
            .ALocal(b) => b,
            _ => return .None,
          }
        } else {
          return .None
        },
        _ => return .None,
      }
      trace := case trace_builder(builder_arg.id, defs, ids, Dict.new()) {
        .Some(t) => t,
        .None => return .None,
      }
      empty.builder_new_local = trace.new_local
      empty.builder_aliases = trace.aliases
      empty.freeze_temp = freeze_temp.id
      .Some(empty)
    },
    .ArrayLitSeed => .None, // not lowered yet
  }
}

// Lower a single region. `freeze_local` is a pre-allocated fresh local for the
// boundary freeze result (a PVecI64).
fn rewrite_region(
  f: AnfFunctionDef,
  r: MutVecRegion,
  ids: OpIds,
  mids: MutVecIds,
  freeze_local: Int,
) AnfFunctionDef {
  defs := collect_defs(f.body, Dict.new())
  ctx := case r.build_ctx(defs, ids, mids) {
    .Some(c) => c,
    .None => return f, // shape drifted — persistent fallback
  }

  // Non-escaping regions never carry the handle to a terminal, so no boundary
  // freeze is inserted (freeze_local disabled with -1) and no PVecI64 result slot
  // is reserved — the handle stays a MutVecI64 that is read and then dropped.
  exit_local := if r.escapes {
    freeze_local
  } else {
    -1
  }
  new_body := ctx.rewrite_expr(f.body, exit_local)
  results := collect_push_results(new_body, mids, Dict.new())
  for rid in results.keys() {
    f.op_result_mono[rid] = MonoType.Vector(.Int)
  }
  if r.escapes {
    f.op_result_mono[freeze_local] = MonoType.Vector(.Int)
  }
  f.body = new_body
  f
}

fn rewrite_func(f: AnfFunctionDef, regions: Vector<MutVecRegion>, ids: OpIds, mids: MutVecIds) AnfFunctionDef {
  base := next_local_id(f)
  i := 0
  for r in regions {
    case r.producer {
      .MakeSeed => f = rewrite_region(f, r, ids, mids, base + i),
      .CollectSeed => f = rewrite_region(f, r, ids, mids, base + i),
      .ArrayLitSeed => {},
    }
    i = i + 1
  }
  f
}

fn regions_for(all: Vector<MutVecRegion>, func_id: FuncId) Vector<MutVecRegion> {
  out: Vector<MutVecRegion> = []
  for r in all {
    if r.func_id.id == func_id.id {
      out = .append(r)
    }
  }
  out
}

// Rewrite every claimed MutVec region in the module to its flat mutable form.
// Pure ANF->ANF transform, run immediately before builder_region.rewrite_module
// under the TWINKLE_MUTVEC flag. Unclaimed code is byte-identical.
pub fn rewrite_module(m: AnfModule, b: BuiltinRegistry) AnfModule {
  ids := resolve_ids(b)
  mids := resolve_mutvec_ids(b)
  regions := detect_regions(m, b)
  result := m
  result.functions = collect f in m.functions {
    rewrite_func(f, regions_for(regions, f.func_id), ids, mids)
  }
  result
}
