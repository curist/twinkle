//! Physical-representation policy shared by repr_assign and wasm_layout.
//!
//! Pure functions of MonoType only — deliberately no dependency on wasm_layout
//! (layout_of), so both repr_assign and wasm_layout can import this without a
//! cycle. Named/aggregate repr still lives in repr_assign (it needs layout_of);
//! only the primitive vector element-family classification lives here.

use compiler.codegen.wasm_ir.{ValType}
use compiler.elem_family.{elem_family_of}
use compiler.mono_type.{MonoType}

/// The primitive storage class of a typed vector's elements. Byte is distinct
/// from I32 even though a byte is read into an i32: Bool and Byte both surface as
/// i32 values but freeze into different mutable handles (MutVecBool vs MutVecByte),
/// so mutvec_wasm_type must tell them apart via this tag.
pub type ElemRepr = { I64, F64, I32, Byte }

/// candidate_typed_vec_family returns the *candidate* typed element family for a
/// Vector<T> whose T is a currently-supported primitive, else .None. Whether a
/// given storage site actually uses a typed repr is decided elsewhere (e.g.
/// route_typed_vec / typed-storage layout) — not by this function.
/// Eligibility is defined by the elem_family registry: any element type with a
/// registered family is a candidate.
pub fn candidate_typed_vec_family(mono: MonoType) ElemRepr? {
  case elem_family_of(mono) {
    // Byte's physical element wasm is i32 (read via array.get_u), identical to
    // Bool's, so elem_wasm can't distinguish them — key the tag off the family
    // directly so the byte family gets its own MutVecByte handle type.
    .Some(fam) => .Some(
      if fam.mono_key == "vec_byte" {
        .Byte
      } else {
        elem_repr_of(fam.elem_wasm)
      },
    ),
    .None => .None,
  }
}

/// Map a family's physical element ValType onto the ElemRepr repr-kind tag. The
/// tag is only a classification (physical layout is driven by fam.pvec_type via
/// val_type_of_mono), but keeping it accurate avoids labelling an i32 family as
/// I64.
fn elem_repr_of(vt: ValType) ElemRepr {
  case vt {
    .I64 => .I64,
    .F64 => .F64,
    _ => .I32,
  }
}
