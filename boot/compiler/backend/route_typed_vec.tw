//! Typed Vector<Int> routing (typed-vector representation, S2.0).
//!
//! Conservative, intra-function rewrite: when a typed vector produced by a
//! `collect`/builder is used ONLY by indexed reads (`xs[i]`) and `xs.len()`, it
//! never crosses a representation boundary, so we can store it physically as the
//! element family's typed PVec (raw unboxed leaves, no pointer-chase per read).
//! We swap the builder/len builtin calls to their typed per-family variants and
//! retype the result slot; the index reads are routed in emit by the base wasm type.
//! Return-position escape is allowed: emission inserts the typed-PVec -> PVec
//! boxing adapter at the function boundary. Other boundary uses remain
//! disallowed.
//!
//! Runs after assign_repr_for_module (so wasm_type overrides stick and push
//! elements are already boxed — the typed builder_push takes the boxed element).

use compiler.backend.prepared_ir.{
  PreparedAtom, PreparedExpr, PreparedFunc, PreparedOp, PreparedPattern, ReprKind, SlotId, SlotInfo,
}
use compiler.builtins.{BuiltinRegistry}
use compiler.codegen.wasm_ir.{ValType}
use compiler.core_ir.{FuncId}
use compiler.elem_family.{ElemFamily, all_families, elem_family_of}

fn with_repr_wasm(info: SlotInfo, repr: ReprKind, wasm_type: ValType) SlotInfo {
  info.repr = repr
  info.wasm_type = wasm_type
  info
}

// A typed-vector producer source. `builder` candidates are `v = builder_freeze(b)`
// and thread the builder handle `b` through eligible_b. `make` candidates are
// `v = Vector.make(n, fill)`; they physically produce the family PVec directly (no
// builder lineage), so `b` is unused and `make` is true. Every producer-source
// query (compute_eligible_v, analyze_typed_fields/payloads, free_var_typed_local,
// slot_typed_after_route) reads `v`; only the eligible_b lineage walk checks `make`.
type Cand = .{ v: Int, b: Int, make: Bool }

pub type RouteIds = .{
  builder_new: Int,
  builder_push: Int,
  builder_freeze: Int,
  make: Int,
  len: Int,
  gather: Int,
}

pub fn route_ids(builtins: BuiltinRegistry) RouteIds {
  .{
    builder_new: builtins.id("vector$builder_new").id,
    builder_push: builtins.id("vector$builder_push").id,
    builder_freeze: builtins.id("vector$builder_freeze").id,
    make: builtins.id("vector$make").id,
    len: builtins.id("vector$len").id,
    gather: builtins.id("vector$gather").id,
  }
}

type FamilyIds = .{
  fam: ElemFamily,
  builder_new: Int,
  builder_push: Int,
  builder_freeze: Int,
  len: Int,
  get: Int,
  gather: Int,
}

fn families_ids(builtins: BuiltinRegistry) Vector<FamilyIds> {
  collect f in all_families() {
    .{
      fam: f,
      builder_new: builtins.id("vector$builder_new${f.suffix}").id,
      builder_push: builtins.id("vector$builder_push${f.suffix}").id,
      builder_freeze: builtins.id("vector$builder_freeze${f.suffix}").id,
      len: builtins.id("vector$len${f.suffix}").id,
      get: builtins.id("vector$get${f.suffix}").id,
      gather: builtins.id("vector$gather${f.suffix}").id,
    }
  }
}

pub fn route_typed_vectors(
  funcs: Vector<PreparedFunc>,
  builtins: BuiltinRegistry,
  typed_fields: Dict<String, Bool>,
  typed_payloads: Dict<String, Bool>,
  capture_abi: Dict<String, Dict<Int, String>>,
  typeable_return: Dict<String, String>,
) Vector<PreparedFunc> {
  ids := route_ids(builtins)

  collect pf in funcs {
    route_func(pf, ids, builtins, typed_fields, typed_payloads, capture_abi, typeable_return)
  }
}

// Slot ids bound directly from a call to a function whose return family matches
// the active family `fam` (its physical result is that family's PVec). These are
// typed sources iff also consumed typed-only.
fn collect_typed_return_call_results(
  body: PreparedExpr,
  typeable_return: Dict<String, String>,
  fam: ElemFamily,
  acc: Vector<Int>,
) Vector<Int> {
  case body {
    .Let(s, op, rest) => {
      acc2 := case op {
        .ACall(.AGlobalFunc(fid), _) => case typeable_return["${fid.id}"] {
          .Some(ret_key) => if ret_key == fam.mono_key {
            acc.append(s.id)
          } else {
            acc
          },
          .None => acc,
        },
        .AIf(_, then_e, else_e) => {
          a := collect_typed_return_call_results(then_e, typeable_return, fam, acc)
          collect_typed_return_call_results(else_e, typeable_return, fam, a)
        },
        .AMatch(_, arms) => {
          cur := acc

          for arm in arms {
            cur = collect_typed_return_call_results(arm.body, typeable_return, fam, cur)
          }

          cur
        },
        .ALoop(inner) => collect_typed_return_call_results(inner, typeable_return, fam, acc),
        .ADefer(inner) => collect_typed_return_call_results(inner, typeable_return, fam, acc),
        _ => acc,
      }

      collect_typed_return_call_results(rest, typeable_return, fam, acc2)
    },
    _ => acc,
  }
}

// Free-var slot ids in `body` whose closure capture lands in a typeable PVecI64
// capture slot (per capture_abi keyed by the target lambda's func id). Capturing
// such a slot is not an escape (M1b): the trampoline downcasts it to PVecI64.
fn collect_relaxed_captures(
  body: PreparedExpr,
  capture_abi: Dict<String, Dict<Int, String>>,
  fam: ElemFamily,
  acc: Dict<Int, Bool>,
) Dict<Int, Bool> {
  case body {
    .Let(_, op, rest) => {
      acc2 := relaxed_captures_op(op, capture_abi, fam, acc)
      collect_relaxed_captures(rest, capture_abi, fam, acc2)
    },
    _ => acc,
  }
}

fn relaxed_captures_op(
  op: PreparedOp,
  capture_abi: Dict<String, Dict<Int, String>>,
  fam: ElemFamily,
  acc: Dict<Int, Bool>,
) Dict<Int, Bool> {
  case op {
    .AMakeClosure(fid, free_vars) => {
      case capture_abi["${fid.id}"] {
        .Some(indices) => {
          for i, fam_key in indices {
            if fam_key == fam.mono_key and i >= 0 and i < free_vars.len() {
              acc[free_vars[i].id] = true
            }
          }
        },
        .None => {},
      }

      acc
    },
    .AIf(_, then_e, else_e) => {
      acc2 := collect_relaxed_captures(then_e, capture_abi, fam, acc)
      collect_relaxed_captures(else_e, capture_abi, fam, acc2)
    },
    .AMatch(_, arms) => {
      cur := acc

      for arm in arms {
        cur = collect_relaxed_captures(arm.body, capture_abi, fam, cur)
      }

      cur
    },
    .ALoop(inner) => collect_relaxed_captures(inner, capture_abi, fam, acc),
    .ADefer(inner) => collect_relaxed_captures(inner, capture_abi, fam, acc),
    _ => acc,
  }
}

// The slot ids of this function's own capture params that are typeable in the
// active family `fam` per capture_abi — these get retyped so the trampoline
// downcast + typed index reads apply inside the closure body.
fn typeable_capture_slots(
  pf: PreparedFunc,
  capture_abi: Dict<String, Dict<Int, String>>,
  fam: ElemFamily,
) Vector<Int> {
  out: Vector<Int> = []

  case capture_abi["${pf.func_id.id}"] {
    .Some(indices) => {
      for i, fam_key in indices {
        if fam_key == fam.mono_key and i >= 0 and i < pf.captures.len() {
          out = .append(pf.captures[i].id)
        }
      }
    },
    .None => {},
  }

  out
}

// Every key present in `set`. An empty key list vacuously satisfies this.
fn all_in(keys: Vector<String>, set: Dict<String, Bool>) Bool {
  for k in keys {
    if !set.has(k) {
      return false
    }
  }

  true
}

// The physical-typedness decision for one function: which slots become PVecI64
// (eligible_v) and which hold the erased anyref builder handle (eligible_b),
// plus whether the function exposes a physical PVecI64 return ABI. This is the
// GROUND TRUTH eligibility computation, extracted pure from route_func so the
// same decision can be materialized into the whole-program plan and queried by
// the analyses (replacing the drifting slot_typed_after_route oracle). It reads
// only its inputs and the func body — no mutation of pf.
type EligibleSets = .{
  eligible_v: Dict<Int, Bool>,
  eligible_b: Dict<Int, Bool>,
  has_phys_return: Bool,
}

fn compute_eligible_v(
  pf: PreparedFunc,
  fi: FamilyIds,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  typed_fields: Dict<String, Bool>,
  typed_payloads: Dict<String, Bool>,
  capture_abi: Dict<String, Dict<Int, String>>,
  typeable_return: Dict<String, String>,
) EligibleSets {
  empty: EligibleSets = .{ eligible_v: Dict.new(), eligible_b: Dict.new(), has_phys_return: false }

  if prepared_depth_exceeds(pf.body, 512) {
    return empty
  }

  // 1. Collect (v, b) candidates: v = builder_freeze(b) where v is in fi.fam.
  cands := collect_candidates(pf.body, pf.slots, ids, fi.fam, [])

  field_read_sids := collect_typed_field_reads(pf.body, typed_fields, pf.slots, fi.fam, [])
  payload_read_sids := collect_typed_payload_reads(pf.body, typed_payloads, pf.slots, fi.fam, [])

  // Slots bound from a call whose return family is fi.fam (its physical result is
  // that family's PVec), e.g. `keys := column.as_ints(col)`. A typed source when
  // consumed typed-only.
  call_result_sids := collect_typed_return_call_results(pf.body, typeable_return, fi.fam, [])

  // M1b: this function's own capture params typeable in fi.fam (retyped below),
  // and the free-var slots whose capture into another closure typeable in fi.fam
  // is not an escape (relaxed). A capture-only closure (e.g. a sort comparator
  // reading a captured key column) has no candidates/field/payload reads, so
  // include the capture set in the "anything to do" check.
  cap_slots := typeable_capture_slots(pf, capture_abi, fi.fam)
  relaxed := collect_relaxed_captures(pf.body, capture_abi, fi.fam, Dict.new())

  // A function whose return family is fi.fam gets a physical typed return ABI (the
  // typed-return bridge); its returned slot is retyped below like any other typed
  // source, so the return coercion becomes a no-op instead of a box.
  has_phys_return := case typeable_return["${pf.func_id.id}"] {
    .Some(ret_key) => ret_key == fi.fam.mono_key,
    .None => false,
  }

  if cands.len() == 0
    and field_read_sids.len() == 0 and payload_read_sids.len() == 0 and call_result_sids.len() == 0
    and cap_slots.len() == 0 and !has_phys_return {
    return empty
  }

  // 2. Keep only candidates whose v never escapes except by direct return
  //    (used solely by index/len/return) and any record-field stores it makes go
  //    into fields the whole-program analysis already decided are typed. The
  //    builder is threaded through plain copies (builder_new -> temp, then
  //    temp -> builder_local), so follow the copy chain backward from the freeze
  //    argument to mark every builder slot (incl. the builder_new result).
  copy_map := build_copy_map(pf.body, Dict.new())
  eligible_v: Dict<Int, Bool> = Dict.new()
  eligible_b: Dict<Int, Bool> = Dict.new()

  for c in cands {
    aliases := aliases_for(c.v, copy_map)

    if v_group_typeable(
      pf.body,
      aliases,
      relaxed,
      ids,
      builtins,
      pf.slots,
      typed_fields,
      typed_payloads,
    ) {
      for sid in aliases.keys() {
        eligible_v[sid] = true
      }

      // Builder candidates thread an erased builder handle through eligible_b;
      // make candidates produce the typed PVec directly, so there is no builder
      // lineage to mark.
      if !c.make {
        cur := c.b
        steps := 0

        for steps < 64 {
          eligible_b[cur] = true

          case copy_map[cur] {
            .Some(src) => {
              cur = src
              steps = steps + 1
            },
            .None => {
              steps = 64
            },
          }
        }
      }
    }
  }

  // 2b. Reads from a typed field are typed sources: each ARecordGet whose key is
  //     in typed_fields makes its RESULT slot a PVecI64 vector. No builder
  //     lineage (the field is already physically typed), so these only join
  //     eligible_v — index/len over the result route to _i64 like any other
  //     eligible_v slot.
  //
  //     Group-aware (B5): a plain copy of the read result (`zs := b.xs`) lands in
  //     its own slot that stays boxed unless retyped too, producing an un-coerced
  //     PVecI64 -> PVec store at the copy. Mark the whole forward alias group.
  //     Unlike payload reads (2c), this is NOT gated on v_group_escapes: a typed
  //     field's struct.get result is physically PVecI64, so the result slot must
  //     stay typed regardless. That is sound because analyze_typed_fields only
  //     types a field when no consumer — including copy-chain consumers — escapes
  //     (bad_consumer_src `zs := b.xs; zs.append(0)` demotes the field to boxed),
  //     so a typed field read never has an escaping copy in its group.
  for sid in field_read_sids {
    for a in aliases_for(sid, copy_map).keys() {
      eligible_v[a] = true
    }
  }

  // 2c. A payload bound from a physically-typed (PVecI64) variant field is a
  //     typed source too — but only if it doesn't escape. Unlike a typed record
  //     field (whose escaping consumers demote the field in analyze_typed_fields),
  //     an escaping payload binding is coerced back to boxed PVec once at
  //     extraction, so here we keep it boxed (skip retyping) rather than forcing
  //     it typed. Guard with the same consumer-escape check the field consumer
  //     scan uses.
  for sid in payload_read_sids {
    aliases := aliases_for(sid, copy_map)

    // Group-aware: a typed source copied into another local (`x := payload`)
    // must retype the copy too, else the copy store is an un-coerced
    // PVecI64 -> PVec mismatch. Only retype when the whole alias group is
    // consumed typed-only (mirrors the builder-candidate handling above).
    if !v_group_escapes(
      pf.body,
      aliases,
      relaxed,
      ids,
      builtins,
      typed_fields,
      pf.slots,
      fi.fam,
      true,
    ) {
      for a in aliases.keys() {
        eligible_v[a] = true
      }
    }
  }

  // 2c''. Typed-return call results (typed-return bridge): a slot bound from a
  //       call to a typed-return function is physically PVecI64 when consumed
  //       typed-only, so it retypes like a payload read. Group-aware for the
  //       same reason: `keys := as_ints(col)` copies the call result into `keys`.
  for sid in call_result_sids {
    aliases := aliases_for(sid, copy_map)

    if !v_group_escapes(
      pf.body,
      aliases,
      relaxed,
      ids,
      builtins,
      typed_fields,
      pf.slots,
      fi.fam,
      true,
    ) {
      for a in aliases.keys() {
        eligible_v[a] = true
      }
    }
  }

  // 2c'. Typeable capture params (M1b): the closure body reads them via typed
  //      index/len only, so retype to PVecI64. The trampoline downcasts the
  //      anyref env slot to PVecI64 (no rebuild), and the enclosing free var is
  //      typed because its capture was relaxed (not an escape) in that function.
  for sid in cap_slots {
    eligible_v[sid] = true
  }

  // 2d. Typed-gather results. `gather(v, idx)` produces a NEW typed vector when
  //     its receiver v is already typed (eligible_v). Marking the result slot
  //     eligible_v retypes it to PVecI64, so the call routes to gather_i64 and
  //     stores/reads typed. A gather result can itself feed another gather, so
  //     iterate to a fixpoint (bounded by slot count). Reaching an erased
  //     boundary from here is coerced (boxed) by emit, preserving the invariant.
  //
  //     Group-aware: `gather_i64`'s result is physically PVecI64, so a plain copy
  //     of it (`ga := amounts.gather(sorted)` binds the call result into a temp
  //     then copies it into the named local) must retype too, else the copy is an
  //     un-coerced PVecI64 -> PVec store. Like the field-read case (2b) this is
  //     unconditional — the produced value is already PVecI64, and any real
  //     (non-copy) boundary in the group is a declared emit coercion site.
  gather_changed := true
  gather_steps := 0

  for gather_changed and gather_steps < 512 {
    gather_changed = false
    new_results := collect_gather_results(pf.body, eligible_v, ids.gather, [])

    for sid in new_results {
      for a in aliases_for(sid, copy_map).keys() {
        if !eligible_v.has(a) {
          eligible_v[a] = true
          gather_changed = true
        }
      }
    }

    gather_steps = gather_steps + 1
  }

  .{ eligible_v, eligible_b, has_phys_return }
}

// Route one function through every element family in turn. Each pass threads the
// active family's typed builtin ids and PVec type; families are independent
// (their eligible slots are disjoint by MonoType), so folding pass-by-pass over
// the running `pf` is order-independent. With only the i64 family today this runs
// exactly once, identical to the pre-family single-shot pass.
fn route_func(
  pf: PreparedFunc,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  typed_fields: Dict<String, Bool>,
  typed_payloads: Dict<String, Bool>,
  capture_abi: Dict<String, Dict<Int, String>>,
  typeable_return: Dict<String, String>,
) PreparedFunc {
  cur := pf

  for fi in families_ids(builtins) {
    cur = route_func_family(
      cur,
      fi,
      ids,
      builtins,
      typed_fields,
      typed_payloads,
      capture_abi,
      typeable_return,
    )
  }

  cur
}

fn route_func_family(
  pf: PreparedFunc,
  fi: FamilyIds,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  typed_fields: Dict<String, Bool>,
  typed_payloads: Dict<String, Bool>,
  capture_abi: Dict<String, Dict<Int, String>>,
  typeable_return: Dict<String, String>,
) PreparedFunc {
  sets := compute_eligible_v(
    pf,
    fi,
    ids,
    builtins,
    typed_fields,
    typed_payloads,
    capture_abi,
    typeable_return,
  )
  eligible_v := sets.eligible_v
  eligible_b := sets.eligible_b
  has_phys_return := sets.has_phys_return

  if eligible_v.keys().len() == 0 {
    return pf
  }

  // 3. Swap builder/len calls to the family's typed variants and retype the slots.
  //    - Result slots (eligible_v) become the family PVec (typed reads).
  //    - Builder-lineage slots (eligible_b) hold the erased anyref builder
  //      handle: builder_new returns Array (like the boxed builder), and the
  //      builder-arg shim casts anyref -> Array at each push/freeze, so the slot
  //      must be OpaqueAnyref/anyref (matching how the boxed builder is erased).
  new_body := rewrite(pf.body, eligible_v, eligible_b, ids, fi)
  new_slots: Dict<Int, SlotInfo> = pf.slots

  for sid_int, info in pf.slots {
    retyped: SlotInfo? = cond {
      eligible_v.has(info.slot.id) => .Some(
        with_repr_wasm(info, info.repr, .Ref(true, .Named(fi.fam.pvec_type))),
      ),
      eligible_b.has(info.slot.id) => .Some(with_repr_wasm(info, .OpaqueAnyref, .Anyref)),
      _ => .None,
    }

    case retyped {
      .Some(ni) => new_slots[sid_int] = ni,
      .None => {},
    }
  }

  pf.slots = new_slots
  pf.body = new_body

  // Typed-return bridge: expose a physical typed result ABI. The returned slot is
  // now the family PVec (retyped above), so emit's return coercion is a no-op.
  if has_phys_return {
    pf.phys_return = .Some(.Ref(true, .Named(fi.fam.pvec_type)))
  }

  pf
}

// Whole-program slot_repr projection: for every function in `funcs`, run the
// GROUND-TRUTH compute_eligible_v under the given ABI facts and record each
// eligible_v slot as `"${func_id}:${slot_id}"`. This is the materialized plan the
// capture-support fixpoint queries — compute_eligible_v runs once per func per
// round here, not once per support query, and both the query and route_func see
// the SAME eligibility (same function, same capture_abi) by construction.
//
// Callers pass only the funcs whose eligibility they need to query (the
// closure-constructing functions), so this stays proportional to the closure
// surface, not the whole module.
pub fn materialize_slot_repr(
  funcs: Vector<PreparedFunc>,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  typed_fields: Dict<String, Bool>,
  typed_payloads: Dict<String, Bool>,
  capture_abi: Dict<String, Dict<Int, String>>,
  typeable_return: Dict<String, String>,
) Dict<String, Bool> {
  out: Dict<String, Bool> = Dict.new()

  for pf in funcs {
    for fi in families_ids(builtins) {
      sets := compute_eligible_v(
        pf,
        fi,
        ids,
        builtins,
        typed_fields,
        typed_payloads,
        capture_abi,
        typeable_return,
      )

      for sid in sets.eligible_v.keys() {
        out["${pf.func_id.id}:${sid}"] = true
      }
    }
  }

  out
}

// ── Candidate collection ────────────────────────────────────────────
// Recursion depth is bounded by `limit` (returns as soon as depth exceeds it),
// so this stays stack-safe while iterating the Let spine without a worklist.
fn prepared_depth_exceeds(expr: PreparedExpr, limit: Int) Bool {
  prepared_depth_exceeds_at(expr, 1, limit)
}

fn prepared_depth_exceeds_at(expr: PreparedExpr, depth: Int, limit: Int) Bool {
  cur := expr
  d := depth
  done := false

  for !done {
    if d > limit {
      return true
    }

    case cur {
      .Let(_, op, body) => {
        if op_children_depth_exceeds(op, d + 1, limit) {
          return true
        }

        cur = body
        d = d + 1
      },
      _ => done = true,
    }
  }

  false
}

fn op_children_depth_exceeds(op: PreparedOp, depth: Int, limit: Int) Bool {
  case op {
    .AIf(_, then_e, else_e) => prepared_depth_exceeds_at(then_e, depth, limit)
      or prepared_depth_exceeds_at(else_e, depth, limit),
    .AMatch(_, arms) => {
      for arm in arms {
        if prepared_depth_exceeds_at(arm.body, depth, limit) {
          return true
        }
      }

      false
    },
    .ALoop(inner) => prepared_depth_exceeds_at(inner, depth, limit),
    .ADefer(inner) => prepared_depth_exceeds_at(inner, depth, limit),
    _ => false,
  }
}

// A slot holds a vector of the given element family iff its MonoType maps to the
// same family. Replaces the Int-hardcoded is_int_vector/mono_key_of pair.
fn slot_in_family(info: SlotInfo, fam: ElemFamily) Bool {
  case elem_family_of(info.mono) {
    .Some(f) => f.mono_key == fam.mono_key,
    .None => false,
  }
}

fn slot_in_family_id(sid: Int, slots: Dict<Int, SlotInfo>, fam: ElemFamily) Bool {
  case slots[sid] {
    .Some(info) => slot_in_family(info, fam),
    .None => false,
  }
}

// The element family of a slot-group `aliases`, derived from any member slot's
// MonoType. A typed-vector group is homogeneous (all aliases share the same
// vector element type), so any registered member determines the family. Returns
// .None when no member maps to a registered family (not a typed-vector group).
fn group_family(aliases: Dict<Int, Bool>, slots: Dict<Int, SlotInfo>) ElemFamily? {
  for sid in aliases.keys() {
    case slots[sid] {
      .Some(info) => case elem_family_of(info.mono) {
        .Some(f) => return .Some(f),
        .None => {},
      },
      .None => {},
    }
  }

  .None
}

fn slot_is(atom: PreparedAtom, sid: Int) Bool {
  case atom {
    .ASlot(s) => s.id == sid,
    _ => false,
  }
}

fn collect_candidates(
  expr: PreparedExpr,
  slots: Dict<Int, SlotInfo>,
  ids: RouteIds,
  fam: ElemFamily,
  acc: Vector<Cand>,
) Vector<Cand> {
  cur := expr
  cur_acc := acc
  done := false

  for !done {
    case cur {
      .Let(slot, op, body) => {
        cur_acc = collect_candidate_from_op(slot, op, slots, ids, fam, cur_acc)
        cur_acc = collect_candidates_op_branches(op, slots, ids, fam, cur_acc)
        cur = body
      },
      _ => done = true,
    }
  }

  cur_acc
}

fn collect_candidates_op_branches(
  op: PreparedOp,
  slots: Dict<Int, SlotInfo>,
  ids: RouteIds,
  fam: ElemFamily,
  acc: Vector<Cand>,
) Vector<Cand> {
  cur := acc

  case op {
    .AIf(_, then_e, else_e) => {
      cur = collect_candidates(then_e, slots, ids, fam, cur)
      cur = collect_candidates(else_e, slots, ids, fam, cur)
    },
    .AMatch(_, arms) => {
      for arm in arms {
        cur = collect_candidates(arm.body, slots, ids, fam, cur)
      }
    },
    .ALoop(inner) => cur = collect_candidates(inner, slots, ids, fam, cur),
    .ADefer(inner) => cur = collect_candidates(inner, slots, ids, fam, cur),
    _ => {},
  }

  cur
}

fn collect_candidate_from_op(
  slot: SlotId,
  op: PreparedOp,
  slots: Dict<Int, SlotInfo>,
  ids: RouteIds,
  fam: ElemFamily,
  acc: Vector<Cand>,
) Vector<Cand> {
  case op {
    .ACall(.AGlobalFunc(fid), args) => cond {
      fid.id == ids.builder_freeze and args.len() == 1 => case args[0] {
        .ASlot(b) => case slots[slot.id] {
          .Some(info) => if slot_in_family(info, fam) {
            acc.append(.{ v: slot.id, b: b.id, make: false })
          } else {
            acc
          },
          .None => acc,
        },
        _ => acc,
      },
      // `Vector.make(n, fill)` directly produces the family PVec into `slot` when
      // that slot maps to the active family. No builder handle to thread.
      fid.id == ids.make and args.len() == 2 => case slots[slot.id] {
        .Some(info) => if slot_in_family(info, fam) {
          acc.append(.{ v: slot.id, b: -1, make: true })
        } else {
          acc
        },
        .None => acc,
      },
      _ => acc,
    },
    _ => acc,
  }
}

// Collect the result sids of `gather(v, idx)` calls whose receiver v (args[0])
// is already a typed slot in `eligible_v`. Each such result is a new PVecI64.
// The op-branch walker recurses into control flow so nested gathers are found;
// route_func iterates this to a fixpoint so a gather feeding another gather
// propagates typedness.
fn collect_gather_results(
  expr: PreparedExpr,
  eligible_v: Dict<Int, Bool>,
  gather_id: Int,
  acc: Vector<Int>,
) Vector<Int> {
  cur := expr
  cur_acc := acc
  done := false

  for !done {
    case cur {
      .Let(slot, op, body) => {
        cur_acc = collect_gather_result_from_op(slot, op, eligible_v, gather_id, cur_acc)
        cur_acc = collect_gather_results_op_branches(op, eligible_v, gather_id, cur_acc)
        cur = body
      },
      _ => done = true,
    }
  }

  cur_acc
}

fn collect_gather_result_from_op(
  slot: SlotId,
  op: PreparedOp,
  eligible_v: Dict<Int, Bool>,
  gather_id: Int,
  acc: Vector<Int>,
) Vector<Int> {
  case op {
    .ACall(.AGlobalFunc(fid), args) => if fid.id == gather_id
      and args.len() == 2 and slot_in(args[0], eligible_v) {
      acc.append(slot.id)
    } else {
      acc
    },
    _ => acc,
  }
}

fn collect_gather_results_op_branches(
  op: PreparedOp,
  eligible_v: Dict<Int, Bool>,
  gather_id: Int,
  acc: Vector<Int>,
) Vector<Int> {
  cur := acc

  case op {
    .AIf(_, then_e, else_e) => {
      cur = collect_gather_results(then_e, eligible_v, gather_id, cur)
      cur = collect_gather_results(else_e, eligible_v, gather_id, cur)
    },
    .AMatch(_, arms) => {
      for arm in arms {
        cur = collect_gather_results(arm.body, eligible_v, gather_id, cur)
      }
    },
    .ALoop(inner) => cur = collect_gather_results(inner, eligible_v, gather_id, cur),
    .ADefer(inner) => cur = collect_gather_results(inner, eligible_v, gather_id, cur),
    _ => {},
  }

  cur
}

// Collect the result sids of `ARecordGet(_, fid, tid)` reads whose field key
// "${tid}:${fid}" is in `typed_fields` — these read from a physically-typed
// field, so the loaded Vector<Int> is already PVecI64 and the result slot is a
// typed source.
fn collect_typed_field_reads(
  expr: PreparedExpr,
  typed_fields: Dict<String, Bool>,
  slots: Dict<Int, SlotInfo>,
  fam: ElemFamily,
  acc: Vector<Int>,
) Vector<Int> {
  cur := expr
  cur_acc := acc
  done := false

  for !done {
    case cur {
      .Let(slot, op, body) => {
        cur_acc = collect_typed_field_read_from_op(slot, op, typed_fields, slots, fam, cur_acc)
        cur_acc = collect_typed_field_reads_op_branches(op, typed_fields, slots, fam, cur_acc)
        cur = body
      },
      _ => done = true,
    }
  }

  cur_acc
}

fn collect_typed_field_reads_op_branches(
  op: PreparedOp,
  typed_fields: Dict<String, Bool>,
  slots: Dict<Int, SlotInfo>,
  fam: ElemFamily,
  acc: Vector<Int>,
) Vector<Int> {
  cur := acc

  case op {
    .AIf(_, then_e, else_e) => {
      cur = collect_typed_field_reads(then_e, typed_fields, slots, fam, cur)
      cur = collect_typed_field_reads(else_e, typed_fields, slots, fam, cur)
    },
    .AMatch(_, arms) => {
      for arm in arms {
        cur = collect_typed_field_reads(arm.body, typed_fields, slots, fam, cur)
      }
    },
    .ALoop(inner) => cur = collect_typed_field_reads(inner, typed_fields, slots, fam, cur),
    .ADefer(inner) => cur = collect_typed_field_reads(inner, typed_fields, slots, fam, cur),
    _ => {},
  }

  cur
}

fn collect_typed_field_read_from_op(
  slot: SlotId,
  op: PreparedOp,
  typed_fields: Dict<String, Bool>,
  slots: Dict<Int, SlotInfo>,
  fam: ElemFamily,
  acc: Vector<Int>,
) Vector<Int> {
  case op {
    .ARecordGet(_, fid, tid) => {
      key := "${tid.id}:${fid.id}"

      // typed_fields is an untagged site set; only retype the read whose own
      // result slot belongs to the active element family.
      if typed_fields.has(key) and slot_in_family_id(slot.id, slots, fam) {
        acc.append(slot.id)
      } else {
        acc
      }
    },
    _ => acc,
  }
}

// Variant-payload analogue of collect_typed_field_reads. Walk the body for
// `AMatch` arms whose `Variant(tid, vid, subpats)` pattern binds a payload from
// a physically-typed site: the payload key "${tid}:${vid}:${idx}" is in
// `typed_payloads` and the bound slot is a `Vector<Int>`. Record each such bound
// slot id — reading it directly loads a PVecI64, so the slot is a typed source.
fn collect_typed_payload_reads(
  expr: PreparedExpr,
  typed_payloads: Dict<String, Bool>,
  slots: Dict<Int, SlotInfo>,
  fam: ElemFamily,
  acc: Vector<Int>,
) Vector<Int> {
  cur := expr
  cur_acc := acc
  done := false

  for !done {
    case cur {
      .Let(_, op, body) => {
        cur_acc = collect_typed_payload_reads_op(op, typed_payloads, slots, fam, cur_acc)
        cur = body
      },
      _ => done = true,
    }
  }

  cur_acc
}

fn collect_typed_payload_reads_op(
  op: PreparedOp,
  typed_payloads: Dict<String, Bool>,
  slots: Dict<Int, SlotInfo>,
  fam: ElemFamily,
  acc: Vector<Int>,
) Vector<Int> {
  cur := acc

  case op {
    .AMatch(_, arms) => {
      for arm in arms {
        cur = collect_payload_bindings(arm.pattern, typed_payloads, slots, fam, cur)
        cur = collect_typed_payload_reads(arm.body, typed_payloads, slots, fam, cur)
      }
    },
    .AIf(_, then_e, else_e) => {
      cur = collect_typed_payload_reads(then_e, typed_payloads, slots, fam, cur)
      cur = collect_typed_payload_reads(else_e, typed_payloads, slots, fam, cur)
    },
    .ALoop(inner) => cur = collect_typed_payload_reads(inner, typed_payloads, slots, fam, cur),
    .ADefer(inner) => cur = collect_typed_payload_reads(inner, typed_payloads, slots, fam, cur),
    _ => {},
  }

  cur
}

// Record the bound slot of every `Var` subpattern at a payload index whose site
// key "${tid}:${vid}:${idx}" is typed and whose bound slot is a `Vector<Int>`.
// Nested `Variant` subpatterns are recursed into so payloads destructured at any
// depth are covered.
fn collect_payload_bindings(
  pattern: PreparedPattern,
  typed_payloads: Dict<String, Bool>,
  slots: Dict<Int, SlotInfo>,
  fam: ElemFamily,
  acc: Vector<Int>,
) Vector<Int> {
  case pattern {
    .Variant(tid, vid, subpats) => {
      cur := acc

      for sub, idx in subpats {
        key := "${tid.id}:${vid.id}:${idx}"

        case sub {
          .Var(s) => if typed_payloads.has(key) and slot_in_family_id(s.id, slots, fam) {
            cur = .append(s.id)
          },
          .Variant(_, _, _) => cur = collect_payload_bindings(sub, typed_payloads, slots, fam, cur),
          _ => {},
        }
      }

      cur
    },
    _ => acc,
  }
}

// Map each slot defined by a plain copy `Let(dst, AInit(ASlot(src)), _)` to its
// source, so the builder lineage (builder_new result -> ... -> freeze arg) can
// be traced across the copies introduced by lowering/slot assignment.
pub fn build_copy_map(expr: PreparedExpr, acc: Dict<Int, Int>) Dict<Int, Int> {
  case expr {
    .Let(slot, op, body) => {
      acc2 := case op {
        // A self-copy (`Lx = init Lx`, emitted as a redundant rebind) must not
        // overwrite a real `Lx -> src` mapping: doing so turns the chain into a
        // self-loop, hiding forward aliases from aliases_for() and letting an
        // escaping consumer (e.g. a variant payload store) slip past the escape
        // check — which would route a producer with no boxing boundary.
        .AInit(.ASlot(src)) => if src.id == slot.id {
          acc
        } else {
          acc[slot.id] = src.id
          acc
        },
        _ => acc,
      }
      acc3 := copy_map_op(op, acc2)
      build_copy_map(body, acc3)
    },
    _ => acc,
  }
}

fn copy_map_op(op: PreparedOp, acc: Dict<Int, Int>) Dict<Int, Int> {
  case op {
    .AIf(_, then_e, else_e) => {
      acc2 := build_copy_map(then_e, acc)
      build_copy_map(else_e, acc2)
    },
    .AMatch(_, arms) => {
      cur := acc

      for arm in arms {
        cur = build_copy_map(arm.body, cur)
      }

      cur
    },
    .ALoop(inner) => build_copy_map(inner, acc),
    .ADefer(inner) => build_copy_map(inner, acc),
    _ => acc,
  }
}

pub fn aliases_for(root: Int, copy_map: Dict<Int, Int>) Dict<Int, Bool> {
  out: Dict<Int, Bool> = Dict.new()
  out[root] = true

  for dst in copy_map.keys() {
    cur := dst
    steps := 0

    for steps < 64 {
      if cur == root {
        out[dst] = true
        steps = 64
      } else {
        case copy_map[cur] {
          .Some(src) => {
            cur = src
            steps = steps + 1
          },
          .None => {
            steps = 64
          },
        }
      }
    }
  }

  out
}

// ── Escape analysis ─────────────────────────────────────────────────
// True if slot `v` is used anywhere other than an `xs[i]` Array read base,
// the argument of `len(v)`, or direct function return. Return is a real
// representation boundary, but it is handled by the emitter's PVecI64 -> PVec
// adapter; all other boundaries remain conservative opt-outs.
// `relaxed` is the set of free-var slot ids whose capture into a closure is NOT
// an escape, because the captured slot lands in a typeable PVecI64 capture slot
// (M1b): the trampoline downcasts it to PVecI64, so the value stays typed. Every
// other AMakeClosure capture is still an escape.
fn v_group_escapes(
  expr: PreparedExpr,
  vs: Dict<Int, Bool>,
  relaxed: Dict<Int, Bool>,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  typed_fields: Dict<String, Bool>,
  slots: Dict<Int, SlotInfo>,
  fam: ElemFamily,
  in_tail: Bool,
) Bool {
  case expr {
    .Let(_, op, body) => op_group_escapes(op, vs, relaxed, ids, builtins, typed_fields, slots, fam)
      or v_group_escapes(body, vs, relaxed, ids, builtins, typed_fields, slots, fam, in_tail),
    // Mirror classify_expr: a trailing `.Atom` in tail position is a function
    // return (typed-return bridge), not an escape; a non-tail arm value stays
    // conservative.
    .Atom(a) => if in_tail {
      false
    } else {
      slot_in(a, vs)
    },
    .Return(.Some(_)) => false,
    .Break(.Some(a)) => slot_in(a, vs),
    _ => false,
  }
}

fn op_group_escapes(
  op: PreparedOp,
  vs: Dict<Int, Bool>,
  relaxed: Dict<Int, Bool>,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  typed_fields: Dict<String, Bool>,
  slots: Dict<Int, SlotInfo>,
  fam: ElemFamily,
) Bool {
  case op {
    .ACall(callee, args) => case callee {
      // len(v) is the allowed builtin call use.
      .AGlobalFunc(fid) => if fid.id == ids.len and args.len() == 1 and slot_in(args[0], vs) {
        false
      } else if fid.id == ids.gather and args.len() == 2 and slot_in(args[0], vs) {
        // gather(v, idx): reading v is a typed-safe use (like len). The RESULT is
        // a new typed vector handled by result-eligibility below; v itself does
        // not escape through the call.
        false
      } else {
        if user_direct_call_accepts_boxed_arg(fid, args, vs, builtins) {
          false
        } else {
          atoms_contain_any(args, vs) or slot_in(callee, vs)
        }
      },
      _ => atoms_contain_any(args, vs) or slot_in(callee, vs),
    },
    // xs[i] Array read: base may be in the vector alias set, index may not.
    .AIndex(base, index, kind, _) => case kind {
      .Array => slot_in(index, vs),
      _ => slot_in(base, vs) or slot_in(index, vs),
    },
    .AIf(cnd, then_e, else_e) => slot_in(cnd, vs)
      or v_group_escapes(then_e, vs, relaxed, ids, builtins, typed_fields, slots, fam, false)
      or v_group_escapes(else_e, vs, relaxed, ids, builtins, typed_fields, slots, fam, false),
    .AMatch(scrut, arms) => {
      if slot_in(scrut, vs) {
        return true
      }

      for arm in arms {
        if v_group_escapes(arm.body, vs, relaxed, ids, builtins, typed_fields, slots, fam, false) {
          return true
        }
      }

      false
    },
    .ALoop(inner) => v_group_escapes(
      inner,
      vs,
      relaxed,
      ids,
      builtins,
      typed_fields,
      slots,
      fam,
      false,
    ),
    .ADefer(inner) => v_group_escapes(
      inner,
      vs,
      relaxed,
      ids,
      builtins,
      typed_fields,
      slots,
      fam,
      false,
    ),
    .ABinOp(_, l, r, _) => slot_in(l, vs) or slot_in(r, vs),
    .AUnOp(_, a, _) => slot_in(a, vs),
    .AMakeClosure(_, free_vars) => {
      for fv in free_vars {
        if vs.has(fv.id) and !relaxed.has(fv.id) {
          return true
        }
      }

      false
    },
    .ARecord(tid, fields) => {
      for f in fields {
        if slot_in(f.value, vs) {
          key := "${tid.id}:${f.field.id}"
          if !atom_in_family(f.value, slots, fam) or !typed_fields.has(key) {
            return true
          }
        }
      }

      false
    },
    .ARecordGet(t, _, _) => slot_in(t, vs),
    .ARecordUpdate(b, fid, val, _, tid) => {
      if slot_in(b, vs) {
        return true
      }

      if slot_in(val, vs) {
        key := "${tid.id}:${fid.id}"
        return !atom_in_family(val, slots, fam) or !typed_fields.has(key)
      }

      false
    },
    .AVariant(_, _, args) => atoms_contain_any(args, vs),
    .AArrayLit(items) => atoms_contain_any(items, vs),
    .AInit(a) => false,
    // Reassigning a v-group slot from a value not in the group stores that
    // (boxed) value into a slot the group would retype to PVecI64 — e.g. a loop
    // `acc = acc.take(...)` where take returns the boxed family. Disqualify.
    .AAssign(dst, a) => slot_in(a, vs) or vs.has(dst.id),
    .AGlobalSet(_, a) => slot_in(a, vs),
    .AWrapAnyref(a, _) => slot_in(a, vs),
    .AUnwrapAnyref(a, _) => slot_in(a, vs),
  }
}

fn slot_in(atom: PreparedAtom, vs: Dict<Int, Bool>) Bool {
  case atom {
    .ASlot(s) => vs.has(s.id),
    _ => false,
  }
}

fn atoms_contain_any(atoms: Vector<PreparedAtom>, vs: Dict<Int, Bool>) Bool {
  for a in atoms {
    if slot_in(a, vs) {
      return true
    }
  }

  false
}

fn user_direct_call_accepts_boxed_arg(
  fid: FuncId,
  args: Vector<PreparedAtom>,
  vs: Dict<Int, Bool>,
  builtins: BuiltinRegistry,
) Bool {
  if !atoms_contain_any(args, vs) {
    return false
  }

  case builtins.entry(fid) {
    .Some(_) => false,
    .None => true,
  }
}

// ── V-group classifier ───────────────────────────────────────────────
// Result of classifying how a typed-vector v-group is used.
// - escapes: true if used by anything other than index/len/return/break,
//   record-field stores, and variant-payload stores of the Vector<Int> itself.
// - field_keys: the "${tid}:${fid}" keys this group is stored into via
//   ARecord / ARecordUpdate (Vector<Int> fields only). May contain duplicates
//   (e.g. the same field assigned in both arms of a match); callers that need
//   a set must de-duplicate.
// - payload_keys: the "${tid}:${vid}:${idx}" variant-payload sites this group is
//   stored into via AVariant (Vector<Int> payload slots only). Same duplicate
//   caveat as field_keys.
type VGroupUse = .{ escapes: Bool, field_keys: Vector<String>, payload_keys: Vector<String> }

fn merge_use(a: VGroupUse, b: VGroupUse) VGroupUse {
  .{
    escapes: a.escapes or b.escapes,
    field_keys: a.field_keys.concat(b.field_keys),
    payload_keys: a.payload_keys.concat(b.payload_keys),
  }
}

fn use_esc(escapes: Bool) VGroupUse {
  .{ escapes, field_keys: [], payload_keys: [] }
}

// Under the current callers, vs only ever contains slots of the active family, so
// the other-family branches that depend on this are defensive.
fn atom_in_family(atom: PreparedAtom, slots: Dict<Int, SlotInfo>, fam: ElemFamily) Bool {
  case atom {
    .ASlot(s) => slot_in_family_id(s.id, slots, fam),
    _ => false,
  }
}

fn classify_v_group(
  expr: PreparedExpr,
  vs: Dict<Int, Bool>,
  relaxed: Dict<Int, Bool>,
  len_id: Int,
  builtins: BuiltinRegistry,
  slots: Dict<Int, SlotInfo>,
  fam: ElemFamily,
) VGroupUse {
  // The whole function body starts in tail position: its trailing `.Atom` is a
  // function return (a typed-return boundary, not an escape).
  classify_expr(expr, vs, relaxed, len_id, builtins, slots, fam, true)
}

// Shared eligibility predicate: a typed-vector slot group `aliases` is typeable
// (safe to store physically as PVecI64) iff it never escapes except by
// index/len/return/break and any record-field / variant-payload stores it makes
// go into fields/payloads the whole-program analysis already decided are typed.
// Used for both local producer candidates (route_func) and function params
// (typed_param_abi's cross-call analysis).
pub fn v_group_typeable(
  body: PreparedExpr,
  aliases: Dict<Int, Bool>,
  relaxed: Dict<Int, Bool>,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  slots: Dict<Int, SlotInfo>,
  typed_fields: Dict<String, Bool>,
  typed_payloads: Dict<String, Bool>,
) Bool {
  // Derive the family from the group's own slots. A group whose members map to no
  // registered family is not a typed-vector group, so it is not typeable.
  fam := case group_family(aliases, slots) {
    .Some(f) => f,
    .None => return false,
  }
  vuse := classify_v_group(body, aliases, relaxed, ids.len, builtins, slots, fam)
  all_field_keys_typed := vuse.field_keys.len() == 0 or all_in(vuse.field_keys, typed_fields)

  // A producer that flows into a variant payload is only routable if every such
  // site is in the typed-payload set; otherwise construction expects a boxed
  // PVec and the producer must stay boxed. (Builtin-sum payload sites never enter
  // typed_payloads, so a producer feeding e.g. `.Some(v)` stays boxed.)
  all_payload_keys_typed := vuse.payload_keys.len() == 0
    or all_in(vuse.payload_keys, typed_payloads)

  !vuse.escapes and all_field_keys_typed and all_payload_keys_typed
}

// M1b support check: is `fv_slot` in `pf` a typed LOCAL producer — i.e. a
// builder_freeze candidate (its value physically becomes PVecI64) whose only
// escape is the capture (its own aliases are relaxed)? A capture may only be
// typed if the free var it stores is genuinely PVecI64 in the enclosing function;
// a boxed source (a function return, a param, a combinator result) is NOT, so the
// captured slot must stay boxed or the trampoline downcast would trap.
pub fn free_var_typed_local(
  pf: PreparedFunc,
  fv_slot: Int,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  typed_fields: Dict<String, Bool>,
  typed_payloads: Dict<String, Bool>,
) Bool {
  // The captured free var determines the family: its own MonoType must map to a
  // registered typed-vector family, or the capture stays boxed.
  fam := case pf.slots[fv_slot] {
    .Some(info) => case elem_family_of(info.mono) {
      .Some(f) => f,
      .None => return false,
    },
    .None => return false,
  }

  copy_map := build_copy_map(pf.body, Dict.new())
  cands := collect_candidates(pf.body, pf.slots, ids, fam, [])

  for c in cands {
    aliases := aliases_for(c.v, copy_map)

    if aliases.has(fv_slot) {
      // Relax this producer's own captures so they don't count as escapes when
      // deciding whether it is otherwise typed-only.
      return v_group_typeable(
        pf.body,
        aliases,
        aliases,
        ids,
        builtins,
        pf.slots,
        typed_fields,
        typed_payloads,
      )
    }
  }

  false
}

// Will `slot` physically be a PVecI64 after route_func runs? This is now largely
// a projection of the GROUND-TRUTH eligibility: it delegates to compute_eligible_v
// (the same function route_func uses) and asks whether `slot` lands in eligible_v.
// Previously this re-derived a single-slot approximation of that decision, which
// drifted from route_func on multi-use alias groups, gather results, and copy
// chains (the C2/B5 mismatch class). Delegating removes the drift for every
// category compute_eligible_v covers: builder candidates, typed field/payload
// reads, typed-return call results, and typed gather results.
//
// Deliberate differences from route_func's own call, both sound:
//   - Empty `capture_abi`: this query cannot see the capture ABI (it is computed
//     from these very queries), so relaxed captures / cap_slots are excluded.
//     route_func uses the real capture_abi, so route_func.eligible_v is a SUPERSET
//     of the delegated result — a query-true slot is always routed typed, keeping
//     the capture-support and return checks conservative.
//   - `typeable_return`: threaded from the caller. Pass an empty map to exclude
//     the typed-return call-result category (return_is_typed does this to break
//     the return-chain circularity).
//
// The one category compute_eligible_v(empty capture_abi) cannot answer is a
// builder candidate whose ONLY escape is the capture under support-analysis: that
// needs the free var's own capture relaxed (free_var_typed_local passes
// `relaxed = aliases`), the provisional-capture bootstrapping the design folds
// into the fixpoint in a later step. Until then it stays an explicit OR so the
// M1b support check does not regress. Adding it keeps this a superset of the old
// oracle, so no previously-typed slot is dropped.
pub fn slot_typed_after_route(
  pf: PreparedFunc,
  slot: Int,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  typed_fields: Dict<String, Bool>,
  typed_payloads: Dict<String, Bool>,
  typeable_return: Dict<String, String>,
) Bool {
  hit := false

  for fi in families_ids(builtins) {
    sets := compute_eligible_v(
      pf,
      fi,
      ids,
      builtins,
      typed_fields,
      typed_payloads,
      Dict.new(),
      typeable_return,
    )

    if sets.eligible_v.has(slot) {
      hit = true
    }
  }

  hit or free_var_typed_local(pf, slot, ids, builtins, typed_fields, typed_payloads)
}

fn classify_expr(
  expr: PreparedExpr,
  vs: Dict<Int, Bool>,
  relaxed: Dict<Int, Bool>,
  len_id: Int,
  builtins: BuiltinRegistry,
  slots: Dict<Int, SlotInfo>,
  fam: ElemFamily,
  in_tail: Bool,
) VGroupUse {
  case expr {
    .Let(_, op, body) => {
      // An op binds a slot, so its sub-expressions (arm/loop/defer bodies) are
      // never a function return — classify_op passes them in_tail=false. The Let
      // body inherits this expression's tail position.
      op_use := classify_op(op, vs, relaxed, len_id, builtins, slots, fam)
      body_use := classify_expr(body, vs, relaxed, len_id, builtins, slots, fam, in_tail)
      op_use.merge_use(body_use)
    },
    // A trailing `.Atom` in tail position is a function return (handled by the
    // typed-return bridge), not an escape — matching `.Return`. In non-tail
    // position (an if/match arm value binding the enclosing slot) it still flows
    // out of the group, so stay conservative.
    .Atom(a) => use_esc(if in_tail {
      false
    } else {
      slot_in(a, vs)
    }),
    .Return(.Some(_)) => use_esc(false),
    .Break(.Some(a)) => use_esc(slot_in(a, vs)),
    _ => use_esc(false),
  }
}

// Mirrors op_group_escapes arm-for-arm; ONLY the ARecord, ARecordUpdate, and
// AVariant arms intentionally differ (they record field-/payload-store keys
// instead of escaping). Keep the two in sync if op_group_escapes changes.
// One deliberate exception: op_group_escapes whitelists `gather(v, idx)` as a
// typed-safe read of v (Stage 1 typed-gather routing), but this producer-side
// classifier does NOT — a builder producer that feeds `gather` stays boxed
// (conservative). The gather RESULT eligibility is handled separately in
// route_func's gather-result fixpoint.
fn classify_op(
  op: PreparedOp,
  vs: Dict<Int, Bool>,
  relaxed: Dict<Int, Bool>,
  len_id: Int,
  builtins: BuiltinRegistry,
  slots: Dict<Int, SlotInfo>,
  fam: ElemFamily,
) VGroupUse {
  case op {
    .ACall(callee, args) => case callee {
      // len(v) is the allowed builtin call use.
      .AGlobalFunc(fid) => if fid.id == len_id and args.len() == 1 and slot_in(args[0], vs) {
        use_esc(false)
      } else {
        if user_direct_call_accepts_boxed_arg(fid, args, vs, builtins) {
          use_esc(false)
        } else {
          use_esc(atoms_contain_any(args, vs) or slot_in(callee, vs))
        }
      },
      _ => use_esc(atoms_contain_any(args, vs) or slot_in(callee, vs)),
    },
    // xs[i] Array read: base may be in the vector alias set, index may not.
    .AIndex(base, index, kind, _) => case kind {
      .Array => use_esc(slot_in(index, vs)),
      _ => use_esc(slot_in(base, vs) or slot_in(index, vs)),
    },
    .AIf(cnd, then_e, else_e) => {
      cnd_esc := use_esc(slot_in(cnd, vs))
      then_use := classify_expr(then_e, vs, relaxed, len_id, builtins, slots, fam, false)
      else_use := classify_expr(else_e, vs, relaxed, len_id, builtins, slots, fam, false)
      cnd_esc.merge_use(then_use.merge_use(else_use))
    },
    .AMatch(scrut, arms) => {
      acc := use_esc(slot_in(scrut, vs))

      for arm in arms {
        arm_use := classify_expr(arm.body, vs, relaxed, len_id, builtins, slots, fam, false)
        acc = .merge_use(arm_use)
      }

      acc
    },
    .ALoop(inner) => classify_expr(inner, vs, relaxed, len_id, builtins, slots, fam, false),
    .ADefer(inner) => classify_expr(inner, vs, relaxed, len_id, builtins, slots, fam, false),
    .ABinOp(_, l, r, _) => use_esc(slot_in(l, vs) or slot_in(r, vs)),
    .AUnOp(_, a, _) => use_esc(slot_in(a, vs)),
    .AMakeClosure(_, free_vars) => {
      esc := false

      for fv in free_vars {
        if vs.has(fv.id) and !relaxed.has(fv.id) {
          esc = true
        }
      }

      use_esc(esc)
    },
    .ARecord(tid, fields) => {
      // A Vector<Int> field value is a typed store (record the key); a v-group value
      // in a non-Vector<Int> field is a genuine escape.
      acc := use_esc(false)

      for f in fields {
        if slot_in(f.value, vs) {
          if atom_in_family(f.value, slots, fam) {
            key := "${tid.id}:${f.field.id}"
            acc = .merge_use(.{ escapes: false, field_keys: [key], payload_keys: [] })
          } else {
            acc = .merge_use(use_esc(true))
          }
        }
      }

      acc
    },
    .ARecordGet(t, _, _) => use_esc(slot_in(t, vs)),
    .ARecordUpdate(b, fid, val, _, tid) => {
      // If val is a typed-vector value being stored into the field — record it.
      // If base is a typed-vector (shouldn't happen) — genuine escape.
      val_use: VGroupUse = if slot_in(val, vs) {
        if atom_in_family(val, slots, fam) {
          key := "${tid.id}:${fid.id}"
          .{ escapes: false, field_keys: [key], payload_keys: [] }
        } else {
          use_esc(true)
        }
      } else {
        use_esc(false)
      }

      base_esc := use_esc(slot_in(b, vs))
      base_esc.merge_use(val_use)
    },
    // A Vector<Int> payload value is a typed variant-payload store (record the
    // "${tid}:${vid}:${idx}" key); a v-group value in a non-Vector<Int> payload
    // slot is a genuine escape. Mirrors the ARecord arm.
    .AVariant(tid, vid, args) => {
      acc := use_esc(false)

      for a, i in args {
        if slot_in(a, vs) {
          if atom_in_family(a, slots, fam) {
            key := "${tid.id}:${vid.id}:${i}"
            acc = .merge_use(.{ escapes: false, field_keys: [], payload_keys: [key] })
          } else {
            acc = .merge_use(use_esc(true))
          }
        }
      }

      acc
    },
    .AArrayLit(items) => use_esc(atoms_contain_any(items, vs)),
    .AInit(_) => use_esc(false),
    // Reassigning a v-group slot from a value not in the group stores that
    // (boxed) value into a slot the group would retype to PVecI64 — e.g. a loop
    // `acc = acc.take(...)` where take returns the boxed family. Disqualify.
    .AAssign(dst, a) => use_esc(slot_in(a, vs) or vs.has(dst.id)),
    .AGlobalSet(_, a) => use_esc(slot_in(a, vs)),
    .AWrapAnyref(a, _) => use_esc(slot_in(a, vs)),
    .AUnwrapAnyref(a, _) => use_esc(slot_in(a, vs)),
  }
}

// ── Whole-program typed-field analysis (Approach B) ──────────────────
// Decide per (TypeId, FieldId) whether a Vector<Int> record field can be stored
// physically as PVecI64. Conservative single-direction: a field is typed iff it
// has >=1 typed-routable producer AND every producer and consumer is
// typed-friendly. Any boxed producer (a field fed by a parameter or a combinator
// result), escaping consumer, or producer that feeds multiple fields demotes it.
// No coercions are ever inserted, so a field with a boxed and a typed producer
// must stay boxed.
//
// Structure: two passes over `funcs`.
//   Pass 1 (scan_func_producers_consumers): for each function, classify typed
//     v-groups -> has_ok_producer / multi-field+escape bad_producer / consumers;
//     also record the OK candidate alias slot sets per key into `ok_aliases` so
//     pass 2 can recognise an already-accounted producer.
//   Pass 2 (scan_func_field_stores): walk every Vector<Int> field-store site; a
//     store whose value isn't an OK candidate alias for that key is a boxed
//     producer -> bad_producer.
// The split is needed because pass 2 of one function may reference OK aliases
// established by pass 1, and (for correctness under cross-function fields) all
// pass-1 OK aliases must be known before any pass-2 verdict — hence the global
// two-pass loop in analyze_typed_fields rather than a single per-func pass.
type FieldStat = .{ has_ok_producer: Bool, bad_producer: Bool, bad_consumer: Bool }

// Per-function record of which slot ids (alias sets) were accepted as OK
// producers for a given field key. Keyed by "${tid}:${fid}" -> set of slot ids.
type OkAliases = .{ map: Dict<String, Dict<Int, Bool>> }

fn empty_stat() FieldStat {
  .{ has_ok_producer: false, bad_producer: false, bad_consumer: false }
}

fn stat_of(stats: Dict<String, FieldStat>, key: String) FieldStat {
  case stats[key] {
    .Some(s) => s,
    .None => empty_stat(),
  }
}

// Fields insert NO representation coercion (unlike variant payloads), so a field
// is typed only from clean builder_freeze producers — a boxed value stored into a
// typed field slot is invalid wasm. Typeable-param producers are therefore NOT
// admitted here (they may arrive boxed pre-variant); only the payload analysis is
// broadened by the cross-call fixpoint.
pub fn analyze_typed_fields(
  funcs: Vector<PreparedFunc>,
  builtins: BuiltinRegistry,
  typeable_return: Dict<String, String>,
) Dict<String, Bool> {
  ids := route_ids(builtins)

  // Seed with fields that have direct clean producers before the final all-store
  // demotion pass. This lets a field with `no_nulls()` remain a candidate while a
  // later round proves a derived producer like `c.nulls.gather(idx)` is also
  // physically typed when `c.nulls` is typed.
  seed_round := scan_typed_field_round(funcs, ids, builtins, typeable_return, Dict.new(), false)
  tf := fields_from_stats(seed_round.stats)
  cap := funcs.len() + 4
  round := 0
  done := false

  for !done {
    res := scan_typed_field_round(funcs, ids, builtins, typeable_return, tf, true)
    next := fields_from_stats(res.stats)

    if bool_key_maps_equal(next, tf) or round >= cap {
      tf = next
      done = true
    } else {
      tf = next
      round = round + 1
    }
  }

  tf
}

type FieldRoundResult = .{ stats: Dict<String, FieldStat> }

fn scan_typed_field_round(
  funcs: Vector<PreparedFunc>,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  typeable_return: Dict<String, String>,
  typed_fields: Dict<String, Bool>,
  include_store_demotions: Bool,
) FieldRoundResult {
  stats: Dict<String, FieldStat> = Dict.new()

  // ok_aliases[func_index] -> OkAliases for that function (slot ids are
  // function-local, so the alias sets are scoped per function in pass 2).
  ok_per_func: Vector<OkAliases> = []

  // Pass 1: producers (typed v-groups) + consumers.
  for pf in funcs {
    res := scan_func_producers_consumers(pf, ids, builtins, typeable_return, typed_fields, stats)
    stats = res.stats
    ok_per_func = .append(res.ok)
  }

  if include_store_demotions {
    // Pass 2: every Vector<Int> field-store site; a store not traceable to an OK
    // producer alias is a boxed producer.
    for pf, i in funcs {
      ok := ok_per_func[i]
      stats = scan_func_field_stores(pf, ids, ok, stats)
    }
  }

  .{ stats }
}

fn fields_from_stats(stats: Dict<String, FieldStat>) Dict<String, Bool> {
  out: Dict<String, Bool> = Dict.new()

  for key, s in stats {
    if s.has_ok_producer and !s.bad_producer and !s.bad_consumer {
      out[key] = true
    }
  }

  out
}

// Two typed-site sets (key -> true) are equal iff they have the same key set.
// Shared by the field-typing inner fixpoint here and the joint repr fixpoint in
// typed_param_abi.
pub fn bool_key_maps_equal(a: Dict<String, Bool>, b: Dict<String, Bool>) Bool {
  if a.keys().len() != b.keys().len() {
    return false
  }

  for k in a.keys() {
    if !b.has(k) {
      return false
    }
  }

  true
}

// ── Whole-program typed variant-payload analysis ─────────────────────
// The variant-payload analogue of analyze_typed_fields. Decide per
// (TypeId, VariantId, payloadIdx) whether a Vector<Int> variant payload can be
// stored physically as PVecI64.
//
// Unlike record fields, variant construction AND extraction both insert
// box/unbox coercions (emit_variant_literal / emit_pattern_bindings) and the
// erased anyref bridge boxes/unboxes payloads generically (bridge_funcs). So a
// boxed producer, or a consumer that lets the extracted payload escape to
// anyref/a closure, is a one-time boxed egress — ALLOWED, not a demotion. That
// is the key relaxation vs. the field analysis, which demotes on any boxed
// producer / escaping consumer because fields insert no coercions. A payload
// site is typed iff it has >=1 clean typed producer and no producer that also
// escapes elsewhere or feeds multiple sites; consumers never demote (every
// extraction path is representation-safe for user sums).
//
// SCOPING — user sums only. Builtin sums (Option, Result, Iterator, ...) route
// their Vector<Int> payloads through specialized erased helpers
// (emit_option_from_variant_helper, emit_iterator_next_helper, ...) that do NOT
// box/unbox PVecI64, so typing them would be unsound. `first_user_tid` is the
// TypeId threshold below which every type is a builtin or reserved-stdlib seed.
// `typeable_params` maps func_id.id (as String) -> a map of typeable param index
// -> family mono_key (from the cross-call param-ABI fixpoint). A typeable param
// stored into a payload is a *clean typed producer* too, so payloads whose only
// producer is such a param (e.g. `int_col(values)` feeding `.IntCol(values)`) can
// be typed. This whole-program payload analysis is single-family (i64) today, so
// only params recorded in the i64 family participate. Pass an empty dict for the
// builder-only (pre-fixpoint) behaviour.
pub fn analyze_typed_payloads(
  funcs: Vector<PreparedFunc>,
  builtins: BuiltinRegistry,
  first_user_tid: Int,
  typeable_params: Dict<String, Dict<Int, String>>,
) Dict<String, Bool> {
  ids := route_ids(builtins)
  stats: Dict<String, FieldStat> = Dict.new()

  for pf in funcs {
    stats = scan_func_payload_producers(pf, ids, builtins, first_user_tid, typeable_params, stats)
  }

  out: Dict<String, Bool> = Dict.new()

  for key, s in stats {
    if s.has_ok_producer and !s.bad_producer and !s.bad_consumer {
      out[key] = true
    }
  }

  out
}

// The producer-source slot ids for a function: every builder_freeze result
// (`cands`) plus every typeable-param slot. Both are classified identically —
// a source cleanly feeding exactly one payload/field is a clean typed producer.
fn producer_source_slots(
  pf: PreparedFunc,
  cands: Vector<Cand>,
  typeable_params: Dict<String, Dict<Int, String>>,
  fam: ElemFamily,
) Vector<Int> {
  out: Vector<Int> = collect c in cands {
    c.v
  }

  case typeable_params["${pf.func_id.id}"] {
    .Some(indices) => {
      for i, fam_key in indices {
        if fam_key == fam.mono_key and i >= 0 and i < pf.params.len() {
          out = .append(pf.params[i].id)
        }
      }
    },
    .None => {},
  }

  out
}

fn collect_typed_field_derived_producers(
  body: PreparedExpr,
  typed_fields: Dict<String, Bool>,
  slots: Dict<Int, SlotInfo>,
  ids: RouteIds,
  fam: ElemFamily,
  copy_map: Dict<Int, Int>,
) Vector<Int> {
  eligible: Dict<Int, Bool> = Dict.new()
  out: Vector<Int> = []
  seen: Dict<Int, Bool> = Dict.new()

  for sid in collect_typed_field_reads(body, typed_fields, slots, fam, []) {
    for a in aliases_for(sid, copy_map).keys() {
      eligible[a] = true
    }
  }

  changed := true
  steps := 0

  for changed and steps < 512 {
    changed = false

    for sid in collect_gather_results(body, eligible, ids.gather, []) {
      if !seen.has(sid) {
        seen[sid] = true
        out = .append(sid)
      }

      for a in aliases_for(sid, copy_map).keys() {
        if !eligible.has(a) {
          eligible[a] = true
          changed = true
        }
      }
    }

    steps = steps + 1
  }

  out
}

fn scan_func_payload_producers(
  pf: PreparedFunc,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  first_user_tid: Int,
  typeable_params: Dict<String, Dict<Int, String>>,
  stats0: Dict<String, FieldStat>,
) Dict<String, FieldStat> {
  // Per-family: a function may hold both Int and Bool payload producers, so
  // classify each family's producers against that family (family-filtered by
  // collect_candidates / classify_v_group). Int-only functions no-op on bool.
  copy_map := build_copy_map(pf.body, Dict.new())
  stats := stats0

  for fam in all_families() {
    cands := collect_candidates(pf.body, pf.slots, ids, fam, [])
    sources := producer_source_slots(pf, cands, typeable_params, fam)

    for v_slot in sources {
      aliases := aliases_for(v_slot, copy_map)
      vuse := classify_v_group(pf.body, aliases, Dict.new(), ids.len, builtins, pf.slots, fam)
      keys := distinct_keys(user_payload_keys(vuse.payload_keys, first_user_tid))

      if keys.len() == 0 {
        // This v-group never flows into a user variant payload — nothing to record.
        stats = stats
      } else if !vuse.escapes and keys.len() == 1 and vuse.field_keys.len() == 0 {
        // Clean single-payload producer: its only escape is the variant store.
        k := keys[0]
        st := stat_of(stats, k)
        st.has_ok_producer = true
        stats[k] = st
      } else {
        // Feeds multiple payload sites, or also escapes / feeds a record field:
        // no single clean typed producer, so demote every site it touches.
        for k in keys {
          st := stat_of(stats, k)
          st.bad_producer = true
          stats[k] = st
        }
      }
    }
  }

  stats
}

// Keep only payload keys whose TypeId is a user-defined type (>= first_user_tid).
// Builtin-sum payload sites are excluded so they never become typed.
fn user_payload_keys(keys: Vector<String>, first_user_tid: Int) Vector<String> {
  out: Vector<String> = []

  for k in keys {
    if payload_key_tid(k) >= first_user_tid {
      out = .append(k)
    }
  }

  out
}

// Parse the leading TypeId out of a "${tid}:${vid}:${idx}" payload key.
fn payload_key_tid(key: String) Int {
  parts := key.split(":")

  if parts.len() == 0 {
    return -1
  }

  case Int.from_string(parts[0]) {
    .Some(n) => n,
    .None => -1,
  }
}

type ScanResult = .{ stats: Dict<String, FieldStat>, ok: OkAliases }

fn scan_func_producers_consumers(
  pf: PreparedFunc,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  typeable_return: Dict<String, String>,
  typed_fields: Dict<String, Bool>,
  stats0: Dict<String, FieldStat>,
) ScanResult {
  // Per-family: a function may hold both Int and Bool typed fields, so classify
  // each family's producers/consumers against that family (family-filtered by
  // collect_candidates / classify_v_group / slot_in_family). Int-only functions
  // no-op on bool.
  copy_map := build_copy_map(pf.body, Dict.new())
  stats := stats0
  ok_map: Dict<String, Dict<Int, Bool>> = Dict.new()

  for fam in all_families() {
    cands := collect_candidates(pf.body, pf.slots, ids, fam, [])

    // Producer v-slots: builder_freeze/make candidates PLUS slots bound from a
    // typed-return call. A typed-return call result is physically the family PVec
    // (route_func retypes it in compute_eligible_v's 2c'' step), so a record field
    // fed directly by such a call — e.g. `Column.{ nulls: no_nulls(n) }` where
    // `no_nulls` returns Vector.make — has a clean typed producer and its store is
    // non-coercing. Requires the mutual typed_fields/typeable_return fixpoint.
    producer_vs: Vector<Int> = collect c in cands {
      c.v
    }

    for s in collect_typed_return_call_results(pf.body, typeable_return, fam, []) {
      producer_vs = .append(s)
    }

    for s in collect_typed_field_derived_producers(
      pf.body,
      typed_fields,
      pf.slots,
      ids,
      fam,
      copy_map,
    ) {
      producer_vs = .append(s)
    }

    // Producers: classify each producer v-group. A group cleanly feeding one field
    // is a clean typed producer; its alias slots are recorded as OK so pass 2
    // won't re-flag the store as boxed.
    for v in producer_vs {
      aliases := aliases_for(v, copy_map)
      vuse := classify_v_group(pf.body, aliases, Dict.new(), ids.len, builtins, pf.slots, fam)
      keys := distinct_keys(vuse.field_keys)

      if !vuse.escapes and keys.len() == 1 {
        // Single typed-field producer that doesn't otherwise escape: OK for key k.
        k := keys[0]
        st := stat_of(stats, k)
        st.has_ok_producer = true
        stats[k] = st

        // Remember this candidate's alias slots as OK for k, so pass 2 won't
        // re-flag the same store as a boxed producer.
        existing := case ok_map[k] {
          .Some(m) => m,
          .None => Dict.new(),
        }

        for sid in aliases.keys() {
          existing[sid] = true
        }

        ok_map[k] = existing
      } else {
        // Either feeds multiple distinct fields, or escapes while also feeding a
        // field: every distinct field key it touches is demoted.
        if keys.len() >= 1 {
          for k in keys {
            st := stat_of(stats, k)
            st.bad_producer = true
            stats[k] = st
          }
        }
      }
    }

    // Consumers: every ARecordGet whose result slot is in the family.
    stats = scan_consumers(pf.body, pf, ids, builtins, fam, stats)
  }

  .{ stats, ok: .{ map: ok_map } }
}

// Walk the body for ARecordGet consumers of Vector<Int> fields. The result slot
// (the Let-bound slot of the ARecordGet) must be consumed only via index/len,
// otherwise the field is demoted (bad_consumer).
fn scan_consumers(
  expr: PreparedExpr,
  pf: PreparedFunc,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  fam: ElemFamily,
  stats0: Dict<String, FieldStat>,
) Dict<String, FieldStat> {
  case expr {
    .Let(slot, op, body) => {
      stats := case op {
        .ARecordGet(_, fid, tid) => {
          // Is the result slot in the active family?
          is_vec := slot_in_family_id(slot.id, pf.slots, fam)

          if is_vec {
            key := "${tid.id}:${fid.id}"

            if result_consumed_typed_only(
              pf.body,
              slot.id,
              Dict.new(),
              ids,
              builtins,
              pf.slots,
              fam,
            ) {
              stats0
            } else {
              st := stat_of(stats0, key)
              st.bad_consumer = true
              stats0[key] = st
              stats0
            }
          } else {
            stats0
          }
        },
        _ => stats0,
      }

      stats2 := scan_consumers_op(op, pf, ids, builtins, fam, stats)
      scan_consumers(body, pf, ids, builtins, fam, stats2)
    },
    _ => stats0,
  }
}

fn scan_consumers_op(
  op: PreparedOp,
  pf: PreparedFunc,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  fam: ElemFamily,
  stats0: Dict<String, FieldStat>,
) Dict<String, FieldStat> {
  case op {
    .AIf(_, then_e, else_e) => {
      s := scan_consumers(then_e, pf, ids, builtins, fam, stats0)
      scan_consumers(else_e, pf, ids, builtins, fam, s)
    },
    .AMatch(_, arms) => {
      cur := stats0

      for arm in arms {
        cur = scan_consumers(arm.body, pf, ids, builtins, fam, cur)
      }

      cur
    },
    .ALoop(inner) => scan_consumers(inner, pf, ids, builtins, fam, stats0),
    .ADefer(inner) => scan_consumers(inner, pf, ids, builtins, fam, stats0),
    _ => stats0,
  }
}

// Pass 2: scan every Vector<Int> field-store site. A store whose value does NOT
// trace to an OK producer alias for that key is a boxed/foreign producer.
fn scan_func_field_stores(
  pf: PreparedFunc,
  ids: RouteIds,
  ok: OkAliases,
  stats0: Dict<String, FieldStat>,
) Dict<String, FieldStat> {
  // Per-family: collect field-store sites in each family (family-filtered by
  // field_store_sites). Int-only functions no-op on bool.
  stats := stats0

  for fam in all_families() {
    sites := field_store_sites(pf.body, pf.slots, fam, [])

    for site in sites {
      is_ok := case site.value {
        .ASlot(s) => case ok.map[site.key] {
          .Some(slotset) => slotset.has(s.id),
          .None => false,
        },
        _ => false,
      }

      if !is_ok {
        st := stat_of(stats, site.key)
        st.bad_producer = true
        stats[site.key] = st
      }
    }
  }

  stats
}

// ── Analysis helpers ────────────────────────────────────────────────
fn distinct_keys(keys: Vector<String>) Vector<String> {
  seen: Dict<String, Bool> = Dict.new()
  out: Vector<String> = []

  for k in keys {
    if !seen.has(k) {
      seen[k] = true
      out = .append(k)
    }
  }

  out
}

// True if `result_sid` is used only by `AIndex .Array` base reads and `len`.
// Reuses the escape-shape logic via a singleton {result_sid} alias set: a
// typed-friendly consumer is exactly one that does NOT escape under that set.
fn result_consumed_typed_only(
  expr: PreparedExpr,
  result_sid: Int,
  relaxed: Dict<Int, Bool>,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  slots: Dict<Int, SlotInfo>,
  fam: ElemFamily,
) Bool {
  singleton: Dict<Int, Bool> = Dict.new()
  singleton[result_sid] = true
  !v_group_escapes(expr, singleton, relaxed, ids, builtins, Dict.new(), slots, fam, true)
}

type FieldStoreSite = .{ key: String, value: PreparedAtom }

// Collect all Vector<Int> field-store sites: ARecord field atoms whose field is
// a Vector<Int> slot, and ARecordUpdate setting a Vector<Int> value.
fn field_store_sites(
  expr: PreparedExpr,
  slots: Dict<Int, SlotInfo>,
  fam: ElemFamily,
  acc: Vector<FieldStoreSite>,
) Vector<FieldStoreSite> {
  case expr {
    .Let(_, op, body) => {
      acc2 := field_store_sites_op(op, slots, fam, acc)
      field_store_sites(body, slots, fam, acc2)
    },
    _ => acc,
  }
}

fn field_store_sites_op(
  op: PreparedOp,
  slots: Dict<Int, SlotInfo>,
  fam: ElemFamily,
  acc: Vector<FieldStoreSite>,
) Vector<FieldStoreSite> {
  case op {
    .ARecord(tid, fields) => {
      cur := acc

      for f in fields {
        if atom_in_family(f.value, slots, fam) {
          key := "${tid.id}:${f.field.id}"
          cur = .append(.{ key, value: f.value })
        }
      }

      cur
    },
    .ARecordUpdate(_, fid, val, _, tid) => if atom_in_family(val, slots, fam) {
      key := "${tid.id}:${fid.id}"
      acc.append(.{ key, value: val })
    } else {
      acc
    },
    .AIf(_, then_e, else_e) => {
      acc2 := field_store_sites(then_e, slots, fam, acc)
      field_store_sites(else_e, slots, fam, acc2)
    },
    .AMatch(_, arms) => {
      cur := acc

      for arm in arms {
        cur = field_store_sites(arm.body, slots, fam, cur)
      }

      cur
    },
    .ALoop(inner) => field_store_sites(inner, slots, fam, acc),
    .ADefer(inner) => field_store_sites(inner, slots, fam, acc),
    _ => acc,
  }
}

// ── Rewrite ─────────────────────────────────────────────────────────
fn rewrite(
  expr: PreparedExpr,
  eligible_v: Dict<Int, Bool>,
  eligible_b: Dict<Int, Bool>,
  ids: RouteIds,
  fi: FamilyIds,
) PreparedExpr {
  case expr {
    .Let(slot, op, body) => .Let(
      slot,
      rewrite_op(slot.id, op, eligible_v, eligible_b, ids, fi),
      rewrite(body, eligible_v, eligible_b, ids, fi),
    ),
    _ => expr,
  }
}

// The `cond` match keys are the BOXED builtin ids (`ids.*`) — the calls as they
// stand before routing — and the swap targets are the active family's typed ids.
fn rewrite_op(
  result_sid: Int,
  op: PreparedOp,
  eligible_v: Dict<Int, Bool>,
  eligible_b: Dict<Int, Bool>,
  ids: RouteIds,
  fi: FamilyIds,
) PreparedOp {
  case op {
    .ACall(.AGlobalFunc(fid), args) => {
      swapped: Int? = cond {
        fid.id == ids.builder_new and eligible_b.has(result_sid) => .Some(fi.builder_new),
        fid.id == ids.builder_push and args.len() >= 1 and arg0_in(args, eligible_b) => .Some(
          fi.builder_push,
        ),
        fid.id == ids.builder_freeze and args.len() == 1 and arg0_in(args, eligible_b) => .Some(
          fi.builder_freeze,
        ),
        fid.id == ids.len and args.len() == 1 and arg0_in(args, eligible_v) => .Some(fi.len),
        fid.id == ids.gather and args.len() == 2 and arg0_in(args, eligible_v) => .Some(fi.gather),
        _ => .None,
      }

      case swapped {
        .Some(new_fid) => .ACall(.AGlobalFunc(.{ id: new_fid }), args),
        .None => op,
      }
    },
    .AIf(cnd, then_e, else_e) => .AIf(
      cnd,
      rewrite(then_e, eligible_v, eligible_b, ids, fi),
      rewrite(else_e, eligible_v, eligible_b, ids, fi),
    ),
    .AMatch(scrut, arms) => .AMatch(
      scrut,
      collect arm in arms {
        .{ pattern: arm.pattern, body: rewrite(arm.body, eligible_v, eligible_b, ids, fi) }
      },
    ),
    .ALoop(inner) => .ALoop(rewrite(inner, eligible_v, eligible_b, ids, fi)),
    .ADefer(inner) => .ADefer(rewrite(inner, eligible_v, eligible_b, ids, fi)),
    _ => op,
  }
}

fn arg0_in(args: Vector<PreparedAtom>, set: Dict<Int, Bool>) Bool {
  case args[0] {
    .ASlot(s) => set.has(s.id),
    _ => false,
  }
}
