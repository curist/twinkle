//! Typed Vector<Int> routing (typed-vector representation, S2.0).
//!
//! Conservative, intra-function rewrite: when a `Vector<Int>` produced by a
//! `collect`/builder is used ONLY by indexed reads (`xs[i]`) and `xs.len()`, it
//! never crosses a representation boundary, so we can store it physically as a
//! typed `PVecI64` (raw i64 leaves, no BoxedInt pointer-chase per read). We swap
//! the builder/len builtin calls to their `_i64` variants and retype the result
//! slot to PVecI64; the index reads are routed in emit by the base wasm type.
//! Return-position escape is allowed: emission inserts the `PVecI64 -> PVec`
//! boxing adapter at the function boundary. Other boundary uses remain
//! disallowed.
//!
//! Runs after assign_repr_for_module (so wasm_type overrides stick and push
//! elements are already boxed — builder_push_i64 takes the boxed element).

use compiler.backend.prepared_ir.{
  PreparedAtom, PreparedExpr, PreparedFunc, PreparedOp, PreparedPattern, ReprKind, SlotId, SlotInfo,
}
use compiler.builtins.{BuiltinRegistry}
use compiler.codegen.wasm_ir.{ValType}
use compiler.core_ir.{FuncId}

fn with_repr_wasm(info: SlotInfo, repr: ReprKind, wasm_type: ValType) SlotInfo {
  info.repr = repr
  info.wasm_type = wasm_type
  info
}

type Cand = .{ v: Int, b: Int }

pub type RouteIds = .{
  builder_new: Int,
  builder_push: Int,
  builder_freeze: Int,
  len: Int,
  builder_new_i64: Int,
  builder_push_i64: Int,
  builder_freeze_i64: Int,
  len_i64: Int,
  gather: Int,
  gather_i64: Int,
}

pub fn route_ids(builtins: BuiltinRegistry) RouteIds {
  .{
    builder_new: builtins.id("vector$builder_new").id,
    builder_push: builtins.id("vector$builder_push").id,
    builder_freeze: builtins.id("vector$builder_freeze").id,
    len: builtins.id("vector$len").id,
    builder_new_i64: builtins.id("vector$builder_new_i64").id,
    builder_push_i64: builtins.id("vector$builder_push_i64").id,
    builder_freeze_i64: builtins.id("vector$builder_freeze_i64").id,
    len_i64: builtins.id("vector$len_i64").id,
    gather: builtins.id("vector$gather").id,
    gather_i64: builtins.id("vector$gather_i64").id,
  }
}

pub fn route_typed_vectors(
  funcs: Vector<PreparedFunc>,
  builtins: BuiltinRegistry,
  typed_fields: Dict<String, Bool>,
  typed_payloads: Dict<String, Bool>,
) Vector<PreparedFunc> {
  ids := route_ids(builtins)

  collect pf in funcs {
    route_func(pf, ids, builtins, typed_fields, typed_payloads)
  }
}

// Every key present in `set`. An empty key list vacuously satisfies this.
fn all_in(keys: Vector<String>, set: Dict<String, Bool>) Bool {
  for k in keys {
    if !set.has(k) {
      return false
    }
  }

  true
}

fn route_func(
  pf: PreparedFunc,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  typed_fields: Dict<String, Bool>,
  typed_payloads: Dict<String, Bool>,
) PreparedFunc {
  if prepared_depth_exceeds(pf.body, 512) {
    return pf
  }

  // 1. Collect (v, b) candidates: v = builder_freeze(b) where v: Vector<Int>.
  cands := collect_candidates(pf.body, pf.slots, ids, [])

  field_read_sids := collect_typed_field_reads(pf.body, typed_fields, [])
  payload_read_sids := collect_typed_payload_reads(pf.body, typed_payloads, pf.slots, [])

  if cands.len() == 0 and field_read_sids.len() == 0 and payload_read_sids.len() == 0 {
    return pf
  }

  // 2. Keep only candidates whose v never escapes except by direct return
  //    (used solely by index/len/return) and any record-field stores it makes go
  //    into fields the whole-program analysis already decided are typed. The
  //    builder is threaded through plain copies (builder_new -> temp, then
  //    temp -> builder_local), so follow the copy chain backward from the freeze
  //    argument to mark every builder slot (incl. the builder_new result).
  copy_map := build_copy_map(pf.body, Dict.new())
  eligible_v: Dict<Int, Bool> = Dict.new()
  eligible_b: Dict<Int, Bool> = Dict.new()

  for c in cands {
    aliases := aliases_for(c.v, copy_map)

    if v_group_typeable(pf.body, aliases, ids, builtins, pf.slots, typed_fields, typed_payloads) {
      for sid in aliases.keys() {
        eligible_v[sid] = true
      }

      cur := c.b
      steps := 0

      for steps < 64 {
        eligible_b[cur] = true

        case copy_map[cur] {
          .Some(src) => {
            cur = src
            steps = steps + 1
          },
          .None => {
            steps = 64
          },
        }
      }
    }
  }

  // 2b. Reads from a typed field are typed sources: each ARecordGet whose key is
  //     in typed_fields makes its RESULT slot a PVecI64 vector. No builder
  //     lineage (the field is already physically typed), so these only join
  //     eligible_v — index/len over the result route to _i64 like any other
  //     eligible_v slot.
  for sid in field_read_sids {
    eligible_v[sid] = true
  }

  // 2c. A payload bound from a physically-typed (PVecI64) variant field is a
  //     typed source too — but only if it doesn't escape. Unlike a typed record
  //     field (whose escaping consumers demote the field in analyze_typed_fields),
  //     an escaping payload binding is coerced back to boxed PVec once at
  //     extraction, so here we keep it boxed (skip retyping) rather than forcing
  //     it typed. Guard with the same consumer-escape check the field consumer
  //     scan uses.
  for sid in payload_read_sids {
    if result_consumed_typed_only(pf.body, sid, ids, builtins) {
      eligible_v[sid] = true
    }
  }

  // 2d. Typed-gather results. `gather(v, idx)` produces a NEW typed vector when
  //     its receiver v is already typed (eligible_v). Marking the result slot
  //     eligible_v retypes it to PVecI64, so the call routes to gather_i64 and
  //     stores/reads typed. A gather result can itself feed another gather, so
  //     iterate to a fixpoint (bounded by slot count). Reaching an erased
  //     boundary from here is coerced (boxed) by emit, preserving the invariant.
  gather_changed := true
  gather_steps := 0

  for gather_changed and gather_steps < 512 {
    gather_changed = false
    new_results := collect_gather_results(pf.body, eligible_v, ids.gather, [])

    for sid in new_results {
      if !eligible_v.has(sid) {
        eligible_v[sid] = true
        gather_changed = true
      }
    }

    gather_steps = gather_steps + 1
  }

  if eligible_v.keys().len() == 0 {
    return pf
  }

  // 3. Swap builder/len calls to _i64 variants and retype the slots.
  //    - Result slots (eligible_v) become PVecI64 (typed reads).
  //    - Builder-lineage slots (eligible_b) hold the erased anyref builder
  //      handle: builder_new_i64 returns Array (like the boxed builder), and the
  //      builder-arg shim casts anyref -> Array at each push/freeze, so the slot
  //      must be OpaqueAnyref/anyref (matching how the boxed builder is erased).
  new_body := rewrite(pf.body, eligible_v, eligible_b, ids)
  new_slots: Dict<Int, SlotInfo> = pf.slots

  for sid_int, info in pf.slots {
    retyped: SlotInfo? = cond {
      eligible_v.has(info.slot.id) => .Some(
        with_repr_wasm(info, info.repr, .Ref(true, .Named("rt_types__PVecI64"))),
      ),
      eligible_b.has(info.slot.id) => .Some(with_repr_wasm(info, .OpaqueAnyref, .Anyref)),
      _ => .None,
    }

    case retyped {
      .Some(ni) => new_slots[sid_int] = ni,
      .None => {},
    }
  }

  pf.slots = new_slots
  pf.body = new_body
  pf
}

// ── Candidate collection ────────────────────────────────────────────
// Recursion depth is bounded by `limit` (returns as soon as depth exceeds it),
// so this stays stack-safe while iterating the Let spine without a worklist.
fn prepared_depth_exceeds(expr: PreparedExpr, limit: Int) Bool {
  prepared_depth_exceeds_at(expr, 1, limit)
}

fn prepared_depth_exceeds_at(expr: PreparedExpr, depth: Int, limit: Int) Bool {
  cur := expr
  d := depth
  done := false

  for !done {
    if d > limit {
      return true
    }

    case cur {
      .Let(_, op, body) => {
        if op_children_depth_exceeds(op, d + 1, limit) {
          return true
        }

        cur = body
        d = d + 1
      },
      _ => done = true,
    }
  }

  false
}

fn op_children_depth_exceeds(op: PreparedOp, depth: Int, limit: Int) Bool {
  case op {
    .AIf(_, then_e, else_e) => prepared_depth_exceeds_at(then_e, depth, limit)
      or prepared_depth_exceeds_at(else_e, depth, limit),
    .AMatch(_, arms) => {
      for arm in arms {
        if prepared_depth_exceeds_at(arm.body, depth, limit) {
          return true
        }
      }

      false
    },
    .ALoop(inner) => prepared_depth_exceeds_at(inner, depth, limit),
    .ADefer(inner) => prepared_depth_exceeds_at(inner, depth, limit),
    _ => false,
  }
}

fn is_int_vector(mono_key: String) Bool {
  mono_key == "vec_i64"
}

fn slot_is(atom: PreparedAtom, sid: Int) Bool {
  case atom {
    .ASlot(s) => s.id == sid,
    _ => false,
  }
}

fn collect_candidates(
  expr: PreparedExpr,
  slots: Dict<Int, SlotInfo>,
  ids: RouteIds,
  acc: Vector<Cand>,
) Vector<Cand> {
  cur := expr
  cur_acc := acc
  done := false

  for !done {
    case cur {
      .Let(slot, op, body) => {
        cur_acc = collect_candidate_from_op(slot, op, slots, ids, cur_acc)
        cur_acc = collect_candidates_op_branches(op, slots, ids, cur_acc)
        cur = body
      },
      _ => done = true,
    }
  }

  cur_acc
}

fn collect_candidates_op_branches(
  op: PreparedOp,
  slots: Dict<Int, SlotInfo>,
  ids: RouteIds,
  acc: Vector<Cand>,
) Vector<Cand> {
  cur := acc

  case op {
    .AIf(_, then_e, else_e) => {
      cur = collect_candidates(then_e, slots, ids, cur)
      cur = collect_candidates(else_e, slots, ids, cur)
    },
    .AMatch(_, arms) => {
      for arm in arms {
        cur = collect_candidates(arm.body, slots, ids, cur)
      }
    },
    .ALoop(inner) => cur = collect_candidates(inner, slots, ids, cur),
    .ADefer(inner) => cur = collect_candidates(inner, slots, ids, cur),
    _ => {},
  }

  cur
}

fn collect_candidate_from_op(
  slot: SlotId,
  op: PreparedOp,
  slots: Dict<Int, SlotInfo>,
  ids: RouteIds,
  acc: Vector<Cand>,
) Vector<Cand> {
  case op {
    .ACall(.AGlobalFunc(fid), args) => if fid.id == ids.builder_freeze and args.len() == 1 {
      case args[0] {
        .ASlot(b) => case slots[slot.id] {
          .Some(info) => if is_int_vector(mono_key_of(info)) {
            acc.append(.{ v: slot.id, b: b.id })
          } else {
            acc
          },
          .None => acc,
        },
        _ => acc,
      }
    } else {
      acc
    },
    _ => acc,
  }
}

// Collect the result sids of `gather(v, idx)` calls whose receiver v (args[0])
// is already a typed slot in `eligible_v`. Each such result is a new PVecI64.
// The op-branch walker recurses into control flow so nested gathers are found;
// route_func iterates this to a fixpoint so a gather feeding another gather
// propagates typedness.
fn collect_gather_results(
  expr: PreparedExpr,
  eligible_v: Dict<Int, Bool>,
  gather_id: Int,
  acc: Vector<Int>,
) Vector<Int> {
  cur := expr
  cur_acc := acc
  done := false

  for !done {
    case cur {
      .Let(slot, op, body) => {
        cur_acc = collect_gather_result_from_op(slot, op, eligible_v, gather_id, cur_acc)
        cur_acc = collect_gather_results_op_branches(op, eligible_v, gather_id, cur_acc)
        cur = body
      },
      _ => done = true,
    }
  }

  cur_acc
}

fn collect_gather_result_from_op(
  slot: SlotId,
  op: PreparedOp,
  eligible_v: Dict<Int, Bool>,
  gather_id: Int,
  acc: Vector<Int>,
) Vector<Int> {
  case op {
    .ACall(.AGlobalFunc(fid), args) => if fid.id == gather_id
      and args.len() == 2 and slot_in(args[0], eligible_v) {
      acc.append(slot.id)
    } else {
      acc
    },
    _ => acc,
  }
}

fn collect_gather_results_op_branches(
  op: PreparedOp,
  eligible_v: Dict<Int, Bool>,
  gather_id: Int,
  acc: Vector<Int>,
) Vector<Int> {
  cur := acc

  case op {
    .AIf(_, then_e, else_e) => {
      cur = collect_gather_results(then_e, eligible_v, gather_id, cur)
      cur = collect_gather_results(else_e, eligible_v, gather_id, cur)
    },
    .AMatch(_, arms) => {
      for arm in arms {
        cur = collect_gather_results(arm.body, eligible_v, gather_id, cur)
      }
    },
    .ALoop(inner) => cur = collect_gather_results(inner, eligible_v, gather_id, cur),
    .ADefer(inner) => cur = collect_gather_results(inner, eligible_v, gather_id, cur),
    _ => {},
  }

  cur
}

// Collect the result sids of `ARecordGet(_, fid, tid)` reads whose field key
// "${tid}:${fid}" is in `typed_fields` — these read from a physically-typed
// field, so the loaded Vector<Int> is already PVecI64 and the result slot is a
// typed source.
fn collect_typed_field_reads(expr: PreparedExpr, typed_fields: Dict<String, Bool>, acc: Vector<Int>) Vector<
  Int,
> {
  cur := expr
  cur_acc := acc
  done := false

  for !done {
    case cur {
      .Let(slot, op, body) => {
        cur_acc = collect_typed_field_read_from_op(slot, op, typed_fields, cur_acc)
        cur_acc = collect_typed_field_reads_op_branches(op, typed_fields, cur_acc)
        cur = body
      },
      _ => done = true,
    }
  }

  cur_acc
}

fn collect_typed_field_reads_op_branches(
  op: PreparedOp,
  typed_fields: Dict<String, Bool>,
  acc: Vector<Int>,
) Vector<Int> {
  cur := acc

  case op {
    .AIf(_, then_e, else_e) => {
      cur = collect_typed_field_reads(then_e, typed_fields, cur)
      cur = collect_typed_field_reads(else_e, typed_fields, cur)
    },
    .AMatch(_, arms) => {
      for arm in arms {
        cur = collect_typed_field_reads(arm.body, typed_fields, cur)
      }
    },
    .ALoop(inner) => cur = collect_typed_field_reads(inner, typed_fields, cur),
    .ADefer(inner) => cur = collect_typed_field_reads(inner, typed_fields, cur),
    _ => {},
  }

  cur
}

fn collect_typed_field_read_from_op(
  slot: SlotId,
  op: PreparedOp,
  typed_fields: Dict<String, Bool>,
  acc: Vector<Int>,
) Vector<Int> {
  case op {
    .ARecordGet(_, fid, tid) => {
      key := "${tid.id}:${fid.id}"

      if typed_fields.has(key) {
        acc.append(slot.id)
      } else {
        acc
      }
    },
    _ => acc,
  }
}

// Variant-payload analogue of collect_typed_field_reads. Walk the body for
// `AMatch` arms whose `Variant(tid, vid, subpats)` pattern binds a payload from
// a physically-typed site: the payload key "${tid}:${vid}:${idx}" is in
// `typed_payloads` and the bound slot is a `Vector<Int>`. Record each such bound
// slot id — reading it directly loads a PVecI64, so the slot is a typed source.
fn collect_typed_payload_reads(
  expr: PreparedExpr,
  typed_payloads: Dict<String, Bool>,
  slots: Dict<Int, SlotInfo>,
  acc: Vector<Int>,
) Vector<Int> {
  cur := expr
  cur_acc := acc
  done := false

  for !done {
    case cur {
      .Let(_, op, body) => {
        cur_acc = collect_typed_payload_reads_op(op, typed_payloads, slots, cur_acc)
        cur = body
      },
      _ => done = true,
    }
  }

  cur_acc
}

fn collect_typed_payload_reads_op(
  op: PreparedOp,
  typed_payloads: Dict<String, Bool>,
  slots: Dict<Int, SlotInfo>,
  acc: Vector<Int>,
) Vector<Int> {
  cur := acc

  case op {
    .AMatch(_, arms) => {
      for arm in arms {
        cur = collect_payload_bindings(arm.pattern, typed_payloads, slots, cur)
        cur = collect_typed_payload_reads(arm.body, typed_payloads, slots, cur)
      }
    },
    .AIf(_, then_e, else_e) => {
      cur = collect_typed_payload_reads(then_e, typed_payloads, slots, cur)
      cur = collect_typed_payload_reads(else_e, typed_payloads, slots, cur)
    },
    .ALoop(inner) => cur = collect_typed_payload_reads(inner, typed_payloads, slots, cur),
    .ADefer(inner) => cur = collect_typed_payload_reads(inner, typed_payloads, slots, cur),
    _ => {},
  }

  cur
}

// Record the bound slot of every `Var` subpattern at a payload index whose site
// key "${tid}:${vid}:${idx}" is typed and whose bound slot is a `Vector<Int>`.
// Nested `Variant` subpatterns are recursed into so payloads destructured at any
// depth are covered.
fn collect_payload_bindings(
  pattern: PreparedPattern,
  typed_payloads: Dict<String, Bool>,
  slots: Dict<Int, SlotInfo>,
  acc: Vector<Int>,
) Vector<Int> {
  case pattern {
    .Variant(tid, vid, subpats) => {
      cur := acc

      for sub, idx in subpats {
        key := "${tid.id}:${vid.id}:${idx}"

        case sub {
          .Var(s) => if typed_payloads.has(key) and slot_is_int_vector(s.id, slots) {
            cur = .append(s.id)
          },
          .Variant(_, _, _) => cur = collect_payload_bindings(sub, typed_payloads, slots, cur),
          _ => {},
        }
      }

      cur
    },
    _ => acc,
  }
}

fn slot_is_int_vector(sid: Int, slots: Dict<Int, SlotInfo>) Bool {
  case slots[sid] {
    .Some(info) => is_int_vector(mono_key_of(info)),
    .None => false,
  }
}

// Map each slot defined by a plain copy `Let(dst, AInit(ASlot(src)), _)` to its
// source, so the builder lineage (builder_new result -> ... -> freeze arg) can
// be traced across the copies introduced by lowering/slot assignment.
pub fn build_copy_map(expr: PreparedExpr, acc: Dict<Int, Int>) Dict<Int, Int> {
  case expr {
    .Let(slot, op, body) => {
      acc2 := case op {
        // A self-copy (`Lx = init Lx`, emitted as a redundant rebind) must not
        // overwrite a real `Lx -> src` mapping: doing so turns the chain into a
        // self-loop, hiding forward aliases from aliases_for() and letting an
        // escaping consumer (e.g. a variant payload store) slip past the escape
        // check — which would route a producer with no boxing boundary.
        .AInit(.ASlot(src)) => if src.id == slot.id {
          acc
        } else {
          acc[slot.id] = src.id
          acc
        },
        _ => acc,
      }
      acc3 := copy_map_op(op, acc2)
      build_copy_map(body, acc3)
    },
    _ => acc,
  }
}

fn copy_map_op(op: PreparedOp, acc: Dict<Int, Int>) Dict<Int, Int> {
  case op {
    .AIf(_, then_e, else_e) => {
      acc2 := build_copy_map(then_e, acc)
      build_copy_map(else_e, acc2)
    },
    .AMatch(_, arms) => {
      cur := acc

      for arm in arms {
        cur = build_copy_map(arm.body, cur)
      }

      cur
    },
    .ALoop(inner) => build_copy_map(inner, acc),
    .ADefer(inner) => build_copy_map(inner, acc),
    _ => acc,
  }
}

fn mono_key_of(info: SlotInfo) String {
  // SlotInfo carries the semantic MonoType; reuse mono_to_key indirectly by
  // matching the layout key. Vector<Int> keys to "vec_i64".
  case info.mono {
    .Vector(.Int) => "vec_i64",
    _ => "other",
  }
}

pub fn aliases_for(root: Int, copy_map: Dict<Int, Int>) Dict<Int, Bool> {
  out: Dict<Int, Bool> = Dict.new()
  out[root] = true

  for dst in copy_map.keys() {
    cur := dst
    steps := 0

    for steps < 64 {
      if cur == root {
        out[dst] = true
        steps = 64
      } else {
        case copy_map[cur] {
          .Some(src) => {
            cur = src
            steps = steps + 1
          },
          .None => {
            steps = 64
          },
        }
      }
    }
  }

  out
}

// ── Escape analysis ─────────────────────────────────────────────────
// True if slot `v` is used anywhere other than an `xs[i]` Array read base,
// the argument of `len(v)`, or direct function return. Return is a real
// representation boundary, but it is handled by the emitter's PVecI64 -> PVec
// adapter; all other boundaries remain conservative opt-outs.
fn v_group_escapes(
  expr: PreparedExpr,
  vs: Dict<Int, Bool>,
  ids: RouteIds,
  builtins: BuiltinRegistry,
) Bool {
  case expr {
    .Let(_, op, body) => op_group_escapes(op, vs, ids, builtins)
      or v_group_escapes(body, vs, ids, builtins),
    .Atom(a) => slot_in(a, vs),
    .Return(.Some(_)) => false,
    .Break(.Some(a)) => slot_in(a, vs),
    _ => false,
  }
}

fn op_group_escapes(op: PreparedOp, vs: Dict<Int, Bool>, ids: RouteIds, builtins: BuiltinRegistry) Bool {
  case op {
    .ACall(callee, args) => case callee {
      // len(v) is the allowed builtin call use.
      .AGlobalFunc(fid) => if fid.id == ids.len and args.len() == 1 and slot_in(args[0], vs) {
        false
      } else if fid.id == ids.gather and args.len() == 2 and slot_in(args[0], vs) {
        // gather(v, idx): reading v is a typed-safe use (like len). The RESULT is
        // a new typed vector handled by result-eligibility below; v itself does
        // not escape through the call.
        false
      } else {
        if user_direct_call_accepts_boxed_arg(fid, args, vs, builtins) {
          false
        } else {
          atoms_contain_any(args, vs) or slot_in(callee, vs)
        }
      },
      _ => atoms_contain_any(args, vs) or slot_in(callee, vs),
    },
    // xs[i] Array read: base may be in the vector alias set, index may not.
    .AIndex(base, index, kind, _) => case kind {
      .Array => slot_in(index, vs),
      _ => slot_in(base, vs) or slot_in(index, vs),
    },
    .AIf(cnd, then_e, else_e) => slot_in(cnd, vs)
      or v_group_escapes(then_e, vs, ids, builtins)
      or v_group_escapes(else_e, vs, ids, builtins),
    .AMatch(scrut, arms) => {
      if slot_in(scrut, vs) {
        return true
      }

      for arm in arms {
        if v_group_escapes(arm.body, vs, ids, builtins) {
          return true
        }
      }

      false
    },
    .ALoop(inner) => v_group_escapes(inner, vs, ids, builtins),
    .ADefer(inner) => v_group_escapes(inner, vs, ids, builtins),
    .ABinOp(_, l, r, _) => slot_in(l, vs) or slot_in(r, vs),
    .AUnOp(_, a, _) => slot_in(a, vs),
    .AMakeClosure(_, free_vars) => {
      for fv in free_vars {
        if vs.has(fv.id) {
          return true
        }
      }

      false
    },
    .ARecord(_, fields) => {
      for f in fields {
        if slot_in(f.value, vs) {
          return true
        }
      }

      false
    },
    .ARecordGet(t, _, _) => slot_in(t, vs),
    .ARecordUpdate(b, _, val, _, _) => slot_in(b, vs) or slot_in(val, vs),
    .AVariant(_, _, args) => atoms_contain_any(args, vs),
    .AArrayLit(items) => atoms_contain_any(items, vs),
    .AInit(a) => false,
    // Reassigning a v-group slot from a value not in the group stores that
    // (boxed) value into a slot the group would retype to PVecI64 — e.g. a loop
    // `acc = acc.take(...)` where take returns the boxed family. Disqualify.
    .AAssign(dst, a) => slot_in(a, vs) or vs.has(dst.id),
    .AGlobalSet(_, a) => slot_in(a, vs),
    .AWrapAnyref(a, _) => slot_in(a, vs),
    .AUnwrapAnyref(a, _) => slot_in(a, vs),
  }
}

fn slot_in(atom: PreparedAtom, vs: Dict<Int, Bool>) Bool {
  case atom {
    .ASlot(s) => vs.has(s.id),
    _ => false,
  }
}

fn atoms_contain_any(atoms: Vector<PreparedAtom>, vs: Dict<Int, Bool>) Bool {
  for a in atoms {
    if slot_in(a, vs) {
      return true
    }
  }

  false
}

fn user_direct_call_accepts_boxed_arg(
  fid: FuncId,
  args: Vector<PreparedAtom>,
  vs: Dict<Int, Bool>,
  builtins: BuiltinRegistry,
) Bool {
  if !atoms_contain_any(args, vs) {
    return false
  }

  case builtins.entry(fid) {
    .Some(_) => false,
    .None => true,
  }
}

// ── V-group classifier ───────────────────────────────────────────────
// Result of classifying how a typed-vector v-group is used.
// - escapes: true if used by anything other than index/len/return/break,
//   record-field stores, and variant-payload stores of the Vector<Int> itself.
// - field_keys: the "${tid}:${fid}" keys this group is stored into via
//   ARecord / ARecordUpdate (Vector<Int> fields only). May contain duplicates
//   (e.g. the same field assigned in both arms of a match); callers that need
//   a set must de-duplicate.
// - payload_keys: the "${tid}:${vid}:${idx}" variant-payload sites this group is
//   stored into via AVariant (Vector<Int> payload slots only). Same duplicate
//   caveat as field_keys.
type VGroupUse = .{ escapes: Bool, field_keys: Vector<String>, payload_keys: Vector<String> }

fn merge_use(a: VGroupUse, b: VGroupUse) VGroupUse {
  .{
    escapes: a.escapes or b.escapes,
    field_keys: a.field_keys.concat(b.field_keys),
    payload_keys: a.payload_keys.concat(b.payload_keys),
  }
}

fn use_esc(escapes: Bool) VGroupUse {
  .{ escapes, field_keys: [], payload_keys: [] }
}

// Under the current callers, vs only ever contains Vector<Int> slots, so the
// non-Vector<Int> branches that depend on this are defensive.
fn atom_is_int_vector_slot(atom: PreparedAtom, slots: Dict<Int, SlotInfo>) Bool {
  case atom {
    .ASlot(s) => case slots[s.id] {
      .Some(info) => is_int_vector(mono_key_of(info)),
      .None => false,
    },
    _ => false,
  }
}

fn classify_v_group(
  expr: PreparedExpr,
  vs: Dict<Int, Bool>,
  len_id: Int,
  builtins: BuiltinRegistry,
  slots: Dict<Int, SlotInfo>,
) VGroupUse {
  classify_expr(expr, vs, len_id, builtins, slots)
}

// Shared eligibility predicate: a typed-vector slot group `aliases` is typeable
// (safe to store physically as PVecI64) iff it never escapes except by
// index/len/return/break and any record-field / variant-payload stores it makes
// go into fields/payloads the whole-program analysis already decided are typed.
// Used for both local producer candidates (route_func) and function params
// (typed_param_abi's cross-call analysis).
pub fn v_group_typeable(
  body: PreparedExpr,
  aliases: Dict<Int, Bool>,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  slots: Dict<Int, SlotInfo>,
  typed_fields: Dict<String, Bool>,
  typed_payloads: Dict<String, Bool>,
) Bool {
  vuse := classify_v_group(body, aliases, ids.len, builtins, slots)
  all_field_keys_typed := vuse.field_keys.len() == 0 or all_in(vuse.field_keys, typed_fields)

  // A producer that flows into a variant payload is only routable if every such
  // site is in the typed-payload set; otherwise construction expects a boxed
  // PVec and the producer must stay boxed. (Builtin-sum payload sites never enter
  // typed_payloads, so a producer feeding e.g. `.Some(v)` stays boxed.)
  all_payload_keys_typed := vuse.payload_keys.len() == 0
    or all_in(vuse.payload_keys, typed_payloads)

  !vuse.escapes and all_field_keys_typed and all_payload_keys_typed
}

fn classify_expr(
  expr: PreparedExpr,
  vs: Dict<Int, Bool>,
  len_id: Int,
  builtins: BuiltinRegistry,
  slots: Dict<Int, SlotInfo>,
) VGroupUse {
  case expr {
    .Let(_, op, body) => {
      op_use := classify_op(op, vs, len_id, builtins, slots)
      body_use := classify_expr(body, vs, len_id, builtins, slots)
      op_use.merge_use(body_use)
    },
    .Atom(a) => use_esc(slot_in(a, vs)),
    .Return(.Some(_)) => use_esc(false),
    .Break(.Some(a)) => use_esc(slot_in(a, vs)),
    _ => use_esc(false),
  }
}

// Mirrors op_group_escapes arm-for-arm; ONLY the ARecord, ARecordUpdate, and
// AVariant arms intentionally differ (they record field-/payload-store keys
// instead of escaping). Keep the two in sync if op_group_escapes changes.
// One deliberate exception: op_group_escapes whitelists `gather(v, idx)` as a
// typed-safe read of v (Stage 1 typed-gather routing), but this producer-side
// classifier does NOT — a builder producer that feeds `gather` stays boxed
// (conservative). The gather RESULT eligibility is handled separately in
// route_func's gather-result fixpoint.
fn classify_op(
  op: PreparedOp,
  vs: Dict<Int, Bool>,
  len_id: Int,
  builtins: BuiltinRegistry,
  slots: Dict<Int, SlotInfo>,
) VGroupUse {
  case op {
    .ACall(callee, args) => case callee {
      // len(v) is the allowed builtin call use.
      .AGlobalFunc(fid) => if fid.id == len_id and args.len() == 1 and slot_in(args[0], vs) {
        use_esc(false)
      } else {
        if user_direct_call_accepts_boxed_arg(fid, args, vs, builtins) {
          use_esc(false)
        } else {
          use_esc(atoms_contain_any(args, vs) or slot_in(callee, vs))
        }
      },
      _ => use_esc(atoms_contain_any(args, vs) or slot_in(callee, vs)),
    },
    // xs[i] Array read: base may be in the vector alias set, index may not.
    .AIndex(base, index, kind, _) => case kind {
      .Array => use_esc(slot_in(index, vs)),
      _ => use_esc(slot_in(base, vs) or slot_in(index, vs)),
    },
    .AIf(cnd, then_e, else_e) => {
      cnd_esc := use_esc(slot_in(cnd, vs))
      then_use := classify_expr(then_e, vs, len_id, builtins, slots)
      else_use := classify_expr(else_e, vs, len_id, builtins, slots)
      cnd_esc.merge_use(then_use.merge_use(else_use))
    },
    .AMatch(scrut, arms) => {
      acc := use_esc(slot_in(scrut, vs))

      for arm in arms {
        arm_use := classify_expr(arm.body, vs, len_id, builtins, slots)
        acc = .merge_use(arm_use)
      }

      acc
    },
    .ALoop(inner) => classify_expr(inner, vs, len_id, builtins, slots),
    .ADefer(inner) => classify_expr(inner, vs, len_id, builtins, slots),
    .ABinOp(_, l, r, _) => use_esc(slot_in(l, vs) or slot_in(r, vs)),
    .AUnOp(_, a, _) => use_esc(slot_in(a, vs)),
    .AMakeClosure(_, free_vars) => {
      esc := false

      for fv in free_vars {
        if vs.has(fv.id) {
          esc = true
        }
      }

      use_esc(esc)
    },
    .ARecord(tid, fields) => {
      // A Vector<Int> field value is a typed store (record the key); a v-group value
      // in a non-Vector<Int> field is a genuine escape.
      acc := use_esc(false)

      for f in fields {
        if slot_in(f.value, vs) {
          if atom_is_int_vector_slot(f.value, slots) {
            key := "${tid.id}:${f.field.id}"
            acc = .merge_use(.{ escapes: false, field_keys: [key], payload_keys: [] })
          } else {
            acc = .merge_use(use_esc(true))
          }
        }
      }

      acc
    },
    .ARecordGet(t, _, _) => use_esc(slot_in(t, vs)),
    .ARecordUpdate(b, fid, val, _, tid) => {
      // If val is a typed-vector value being stored into the field — record it.
      // If base is a typed-vector (shouldn't happen) — genuine escape.
      val_use: VGroupUse = if slot_in(val, vs) {
        if atom_is_int_vector_slot(val, slots) {
          key := "${tid.id}:${fid.id}"
          .{ escapes: false, field_keys: [key], payload_keys: [] }
        } else {
          use_esc(true)
        }
      } else {
        use_esc(false)
      }

      base_esc := use_esc(slot_in(b, vs))
      base_esc.merge_use(val_use)
    },
    // A Vector<Int> payload value is a typed variant-payload store (record the
    // "${tid}:${vid}:${idx}" key); a v-group value in a non-Vector<Int> payload
    // slot is a genuine escape. Mirrors the ARecord arm.
    .AVariant(tid, vid, args) => {
      acc := use_esc(false)

      for a, i in args {
        if slot_in(a, vs) {
          if atom_is_int_vector_slot(a, slots) {
            key := "${tid.id}:${vid.id}:${i}"
            acc = .merge_use(.{ escapes: false, field_keys: [], payload_keys: [key] })
          } else {
            acc = .merge_use(use_esc(true))
          }
        }
      }

      acc
    },
    .AArrayLit(items) => use_esc(atoms_contain_any(items, vs)),
    .AInit(_) => use_esc(false),
    // Reassigning a v-group slot from a value not in the group stores that
    // (boxed) value into a slot the group would retype to PVecI64 — e.g. a loop
    // `acc = acc.take(...)` where take returns the boxed family. Disqualify.
    .AAssign(dst, a) => use_esc(slot_in(a, vs) or vs.has(dst.id)),
    .AGlobalSet(_, a) => use_esc(slot_in(a, vs)),
    .AWrapAnyref(a, _) => use_esc(slot_in(a, vs)),
    .AUnwrapAnyref(a, _) => use_esc(slot_in(a, vs)),
  }
}

// ── Whole-program typed-field analysis (Approach B) ──────────────────
// Decide per (TypeId, FieldId) whether a Vector<Int> record field can be stored
// physically as PVecI64. Conservative single-direction: a field is typed iff it
// has >=1 typed-routable producer AND every producer and consumer is
// typed-friendly. Any boxed producer (a field fed by a parameter or a combinator
// result), escaping consumer, or producer that feeds multiple fields demotes it.
// No coercions are ever inserted, so a field with a boxed and a typed producer
// must stay boxed.
//
// Structure: two passes over `funcs`.
//   Pass 1 (scan_func_producers_consumers): for each function, classify typed
//     v-groups -> has_ok_producer / multi-field+escape bad_producer / consumers;
//     also record the OK candidate alias slot sets per key into `ok_aliases` so
//     pass 2 can recognise an already-accounted producer.
//   Pass 2 (scan_func_field_stores): walk every Vector<Int> field-store site; a
//     store whose value isn't an OK candidate alias for that key is a boxed
//     producer -> bad_producer.
// The split is needed because pass 2 of one function may reference OK aliases
// established by pass 1, and (for correctness under cross-function fields) all
// pass-1 OK aliases must be known before any pass-2 verdict — hence the global
// two-pass loop in analyze_typed_fields rather than a single per-func pass.
type FieldStat = .{ has_ok_producer: Bool, bad_producer: Bool, bad_consumer: Bool }

// Per-function record of which slot ids (alias sets) were accepted as OK
// producers for a given field key. Keyed by "${tid}:${fid}" -> set of slot ids.
type OkAliases = .{ map: Dict<String, Dict<Int, Bool>> }

fn empty_stat() FieldStat {
  .{ has_ok_producer: false, bad_producer: false, bad_consumer: false }
}

fn stat_of(stats: Dict<String, FieldStat>, key: String) FieldStat {
  case stats[key] {
    .Some(s) => s,
    .None => empty_stat(),
  }
}

// Fields insert NO representation coercion (unlike variant payloads), so a field
// is typed only from clean builder_freeze producers — a boxed value stored into a
// typed field slot is invalid wasm. Typeable-param producers are therefore NOT
// admitted here (they may arrive boxed pre-variant); only the payload analysis is
// broadened by the cross-call fixpoint.
pub fn analyze_typed_fields(funcs: Vector<PreparedFunc>, builtins: BuiltinRegistry) Dict<
  String,
  Bool,
> {
  ids := route_ids(builtins)
  stats: Dict<String, FieldStat> = Dict.new()

  // ok_aliases[func_index] -> OkAliases for that function (slot ids are
  // function-local, so the alias sets are scoped per function in pass 2).
  ok_per_func: Vector<OkAliases> = []

  // Pass 1: producers (typed v-groups) + consumers.
  for pf in funcs {
    res := scan_func_producers_consumers(pf, ids, builtins, stats)
    stats = res.stats
    ok_per_func = .append(res.ok)
  }

  // Pass 2: every Vector<Int> field-store site; a store not traceable to an OK
  // producer alias is a boxed producer.
  for pf, i in funcs {
    ok := ok_per_func[i]
    stats = scan_func_field_stores(pf, ids, ok, stats)
  }

  out: Dict<String, Bool> = Dict.new()

  for key, s in stats {
    if s.has_ok_producer and !s.bad_producer and !s.bad_consumer {
      out[key] = true
    }
  }

  out
}

// ── Whole-program typed variant-payload analysis ─────────────────────
// The variant-payload analogue of analyze_typed_fields. Decide per
// (TypeId, VariantId, payloadIdx) whether a Vector<Int> variant payload can be
// stored physically as PVecI64.
//
// Unlike record fields, variant construction AND extraction both insert
// box/unbox coercions (emit_variant_literal / emit_pattern_bindings) and the
// erased anyref bridge boxes/unboxes payloads generically (bridge_funcs). So a
// boxed producer, or a consumer that lets the extracted payload escape to
// anyref/a closure, is a one-time boxed egress — ALLOWED, not a demotion. That
// is the key relaxation vs. the field analysis, which demotes on any boxed
// producer / escaping consumer because fields insert no coercions. A payload
// site is typed iff it has >=1 clean typed producer and no producer that also
// escapes elsewhere or feeds multiple sites; consumers never demote (every
// extraction path is representation-safe for user sums).
//
// SCOPING — user sums only. Builtin sums (Option, Result, Iterator, ...) route
// their Vector<Int> payloads through specialized erased helpers
// (emit_option_from_variant_helper, emit_iterator_next_helper, ...) that do NOT
// box/unbox PVecI64, so typing them would be unsound. `first_user_tid` is the
// TypeId threshold below which every type is a builtin or reserved-stdlib seed.
// `typeable_params` maps func_id.id (as String) -> the Vector<Int> param indices
// that may take a physical PVecI64 (from the cross-call param-ABI fixpoint). A
// typeable param stored into a payload is a *clean typed producer* too, so
// payloads whose only producer is such a param (e.g. `int_col(values)` feeding
// `.IntCol(values)`) can be typed. Pass an empty dict for the builder-only
// (pre-fixpoint) behaviour.
pub fn analyze_typed_payloads(
  funcs: Vector<PreparedFunc>,
  builtins: BuiltinRegistry,
  first_user_tid: Int,
  typeable_params: Dict<String, Vector<Int>>,
) Dict<String, Bool> {
  ids := route_ids(builtins)
  stats: Dict<String, FieldStat> = Dict.new()

  for pf in funcs {
    stats = scan_func_payload_producers(pf, ids, builtins, first_user_tid, typeable_params, stats)
  }

  out: Dict<String, Bool> = Dict.new()

  for key, s in stats {
    if s.has_ok_producer and !s.bad_producer and !s.bad_consumer {
      out[key] = true
    }
  }

  out
}

// The producer-source slot ids for a function: every builder_freeze result
// (`cands`) plus every typeable-param slot. Both are classified identically —
// a source cleanly feeding exactly one payload/field is a clean typed producer.
fn producer_source_slots(
  pf: PreparedFunc,
  cands: Vector<Cand>,
  typeable_params: Dict<String, Vector<Int>>,
) Vector<Int> {
  out: Vector<Int> = collect c in cands {
    c.v
  }

  case typeable_params["${pf.func_id.id}"] {
    .Some(indices) => {
      for i in indices {
        if i >= 0 and i < pf.params.len() {
          out = .append(pf.params[i].id)
        }
      }
    },
    .None => {},
  }

  out
}

fn scan_func_payload_producers(
  pf: PreparedFunc,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  first_user_tid: Int,
  typeable_params: Dict<String, Vector<Int>>,
  stats0: Dict<String, FieldStat>,
) Dict<String, FieldStat> {
  copy_map := build_copy_map(pf.body, Dict.new())
  cands := collect_candidates(pf.body, pf.slots, ids, [])
  sources := producer_source_slots(pf, cands, typeable_params)
  stats := stats0

  for v_slot in sources {
    aliases := aliases_for(v_slot, copy_map)
    vuse := classify_v_group(pf.body, aliases, ids.len, builtins, pf.slots)
    keys := distinct_keys(user_payload_keys(vuse.payload_keys, first_user_tid))

    if keys.len() == 0 {
      // This v-group never flows into a user variant payload — nothing to record.
      stats = stats
    } else if !vuse.escapes and keys.len() == 1 and vuse.field_keys.len() == 0 {
      // Clean single-payload producer: its only escape is the variant store.
      k := keys[0]
      st := stat_of(stats, k)
      st.has_ok_producer = true
      stats[k] = st
    } else {
      // Feeds multiple payload sites, or also escapes / feeds a record field:
      // no single clean typed producer, so demote every site it touches.
      for k in keys {
        st := stat_of(stats, k)
        st.bad_producer = true
        stats[k] = st
      }
    }
  }

  stats
}

// Keep only payload keys whose TypeId is a user-defined type (>= first_user_tid).
// Builtin-sum payload sites are excluded so they never become typed.
fn user_payload_keys(keys: Vector<String>, first_user_tid: Int) Vector<String> {
  out: Vector<String> = []

  for k in keys {
    if payload_key_tid(k) >= first_user_tid {
      out = .append(k)
    }
  }

  out
}

// Parse the leading TypeId out of a "${tid}:${vid}:${idx}" payload key.
fn payload_key_tid(key: String) Int {
  parts := key.split(":")

  if parts.len() == 0 {
    return -1
  }

  case Int.from_string(parts[0]) {
    .Some(n) => n,
    .None => -1,
  }
}

type ScanResult = .{ stats: Dict<String, FieldStat>, ok: OkAliases }

fn scan_func_producers_consumers(
  pf: PreparedFunc,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  stats0: Dict<String, FieldStat>,
) ScanResult {
  copy_map := build_copy_map(pf.body, Dict.new())
  cands := collect_candidates(pf.body, pf.slots, ids, [])
  stats := stats0
  ok_map: Dict<String, Dict<Int, Bool>> = Dict.new()

  // Producers: classify each typed v-group candidate (builder_freeze result). A
  // candidate cleanly feeding one field is a clean typed producer; its alias
  // slots are recorded as OK so pass 2 won't re-flag the store as boxed.
  for c in cands {
    aliases := aliases_for(c.v, copy_map)
    vuse := classify_v_group(pf.body, aliases, ids.len, builtins, pf.slots)
    keys := distinct_keys(vuse.field_keys)

    if !vuse.escapes and keys.len() == 1 {
      // Single typed-field producer that doesn't otherwise escape: OK for key k.
      k := keys[0]
      st := stat_of(stats, k)
      st.has_ok_producer = true
      stats[k] = st

      // Remember this candidate's alias slots as OK for k, so pass 2 won't
      // re-flag the same store as a boxed producer.
      existing := case ok_map[k] {
        .Some(m) => m,
        .None => Dict.new(),
      }

      for sid in aliases.keys() {
        existing[sid] = true
      }

      ok_map[k] = existing
    } else {
      // Either feeds multiple distinct fields, or escapes while also feeding a
      // field: every distinct field key it touches is demoted.
      if keys.len() >= 1 {
        for k in keys {
          st := stat_of(stats, k)
          st.bad_producer = true
          stats[k] = st
        }
      }
    }
  }

  // Consumers: every ARecordGet whose result slot is Vector<Int>.
  stats = scan_consumers(pf.body, pf, ids, builtins, stats)
  .{ stats, ok: .{ map: ok_map } }
}

// Walk the body for ARecordGet consumers of Vector<Int> fields. The result slot
// (the Let-bound slot of the ARecordGet) must be consumed only via index/len,
// otherwise the field is demoted (bad_consumer).
fn scan_consumers(
  expr: PreparedExpr,
  pf: PreparedFunc,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  stats0: Dict<String, FieldStat>,
) Dict<String, FieldStat> {
  case expr {
    .Let(slot, op, body) => {
      stats := case op {
        .ARecordGet(_, fid, tid) => {
          // Is the result slot a Vector<Int>?
          is_vec := case pf.slots[slot.id] {
            .Some(info) => is_int_vector(mono_key_of(info)),
            .None => false,
          }

          if is_vec {
            key := "${tid.id}:${fid.id}"

            if result_consumed_typed_only(pf.body, slot.id, ids, builtins) {
              stats0
            } else {
              st := stat_of(stats0, key)
              st.bad_consumer = true
              stats0[key] = st
              stats0
            }
          } else {
            stats0
          }
        },
        _ => stats0,
      }

      stats2 := scan_consumers_op(op, pf, ids, builtins, stats)
      scan_consumers(body, pf, ids, builtins, stats2)
    },
    _ => stats0,
  }
}

fn scan_consumers_op(
  op: PreparedOp,
  pf: PreparedFunc,
  ids: RouteIds,
  builtins: BuiltinRegistry,
  stats0: Dict<String, FieldStat>,
) Dict<String, FieldStat> {
  case op {
    .AIf(_, then_e, else_e) => {
      s := scan_consumers(then_e, pf, ids, builtins, stats0)
      scan_consumers(else_e, pf, ids, builtins, s)
    },
    .AMatch(_, arms) => {
      cur := stats0

      for arm in arms {
        cur = scan_consumers(arm.body, pf, ids, builtins, cur)
      }

      cur
    },
    .ALoop(inner) => scan_consumers(inner, pf, ids, builtins, stats0),
    .ADefer(inner) => scan_consumers(inner, pf, ids, builtins, stats0),
    _ => stats0,
  }
}

// Pass 2: scan every Vector<Int> field-store site. A store whose value does NOT
// trace to an OK producer alias for that key is a boxed/foreign producer.
fn scan_func_field_stores(
  pf: PreparedFunc,
  ids: RouteIds,
  ok: OkAliases,
  stats0: Dict<String, FieldStat>,
) Dict<String, FieldStat> {
  sites := field_store_sites(pf.body, pf.slots, [])
  stats := stats0

  for site in sites {
    is_ok := case site.value {
      .ASlot(s) => case ok.map[site.key] {
        .Some(slotset) => slotset.has(s.id),
        .None => false,
      },
      _ => false,
    }

    if !is_ok {
      st := stat_of(stats, site.key)
      st.bad_producer = true
      stats[site.key] = st
    }
  }

  stats
}

// ── Analysis helpers ────────────────────────────────────────────────
fn distinct_keys(keys: Vector<String>) Vector<String> {
  seen: Dict<String, Bool> = Dict.new()
  out: Vector<String> = []

  for k in keys {
    if !seen.has(k) {
      seen[k] = true
      out = .append(k)
    }
  }

  out
}

// True if `result_sid` is used only by `AIndex .Array` base reads and `len`.
// Reuses the escape-shape logic via a singleton {result_sid} alias set: a
// typed-friendly consumer is exactly one that does NOT escape under that set.
fn result_consumed_typed_only(
  expr: PreparedExpr,
  result_sid: Int,
  ids: RouteIds,
  builtins: BuiltinRegistry,
) Bool {
  singleton: Dict<Int, Bool> = Dict.new()
  singleton[result_sid] = true
  !v_group_escapes(expr, singleton, ids, builtins)
}

type FieldStoreSite = .{ key: String, value: PreparedAtom }

// Collect all Vector<Int> field-store sites: ARecord field atoms whose field is
// a Vector<Int> slot, and ARecordUpdate setting a Vector<Int> value.
fn field_store_sites(expr: PreparedExpr, slots: Dict<Int, SlotInfo>, acc: Vector<FieldStoreSite>) Vector<
  FieldStoreSite,
> {
  case expr {
    .Let(_, op, body) => {
      acc2 := field_store_sites_op(op, slots, acc)
      field_store_sites(body, slots, acc2)
    },
    _ => acc,
  }
}

fn field_store_sites_op(op: PreparedOp, slots: Dict<Int, SlotInfo>, acc: Vector<FieldStoreSite>) Vector<
  FieldStoreSite,
> {
  case op {
    .ARecord(tid, fields) => {
      cur := acc

      for f in fields {
        if atom_is_int_vector_slot(f.value, slots) {
          key := "${tid.id}:${f.field.id}"
          cur = .append(.{ key, value: f.value })
        }
      }

      cur
    },
    .ARecordUpdate(_, fid, val, _, tid) => if atom_is_int_vector_slot(val, slots) {
      key := "${tid.id}:${fid.id}"
      acc.append(.{ key, value: val })
    } else {
      acc
    },
    .AIf(_, then_e, else_e) => {
      acc2 := field_store_sites(then_e, slots, acc)
      field_store_sites(else_e, slots, acc2)
    },
    .AMatch(_, arms) => {
      cur := acc

      for arm in arms {
        cur = field_store_sites(arm.body, slots, cur)
      }

      cur
    },
    .ALoop(inner) => field_store_sites(inner, slots, acc),
    .ADefer(inner) => field_store_sites(inner, slots, acc),
    _ => acc,
  }
}

// ── Rewrite ─────────────────────────────────────────────────────────
fn rewrite(
  expr: PreparedExpr,
  eligible_v: Dict<Int, Bool>,
  eligible_b: Dict<Int, Bool>,
  ids: RouteIds,
) PreparedExpr {
  case expr {
    .Let(slot, op, body) => .Let(
      slot,
      rewrite_op(slot.id, op, eligible_v, eligible_b, ids),
      rewrite(body, eligible_v, eligible_b, ids),
    ),
    _ => expr,
  }
}

fn rewrite_op(
  result_sid: Int,
  op: PreparedOp,
  eligible_v: Dict<Int, Bool>,
  eligible_b: Dict<Int, Bool>,
  ids: RouteIds,
) PreparedOp {
  case op {
    .ACall(.AGlobalFunc(fid), args) => {
      swapped: Int? = cond {
        fid.id == ids.builder_new and eligible_b.has(result_sid) => .Some(ids.builder_new_i64),
        fid.id == ids.builder_push and args.len() >= 1 and arg0_in(args, eligible_b) => .Some(
          ids.builder_push_i64,
        ),
        fid.id == ids.builder_freeze and args.len() == 1 and arg0_in(args, eligible_b) => .Some(
          ids.builder_freeze_i64,
        ),
        fid.id == ids.len and args.len() == 1 and arg0_in(args, eligible_v) => .Some(ids.len_i64),
        fid.id == ids.gather and args.len() == 2 and arg0_in(args, eligible_v) => .Some(
          ids.gather_i64,
        ),
        _ => .None,
      }

      case swapped {
        .Some(new_fid) => .ACall(.AGlobalFunc(.{ id: new_fid }), args),
        .None => op,
      }
    },
    .AIf(cnd, then_e, else_e) => .AIf(
      cnd,
      rewrite(then_e, eligible_v, eligible_b, ids),
      rewrite(else_e, eligible_v, eligible_b, ids),
    ),
    .AMatch(scrut, arms) => .AMatch(
      scrut,
      collect arm in arms {
        .{ pattern: arm.pattern, body: rewrite(arm.body, eligible_v, eligible_b, ids) }
      },
    ),
    .ALoop(inner) => .ALoop(rewrite(inner, eligible_v, eligible_b, ids)),
    .ADefer(inner) => .ADefer(rewrite(inner, eligible_v, eligible_b, ids)),
    _ => op,
  }
}

fn arg0_in(args: Vector<PreparedAtom>, set: Dict<Int, Bool>) Bool {
  case args[0] {
    .ASlot(s) => set.has(s.id),
    _ => false,
  }
}
