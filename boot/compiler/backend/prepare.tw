//! Backend preparation boundary.
//!
//! prepare_backend() is the explicit entry point into backend preparation.
//! It inserts representation boundaries, assigns slots, and assigns runtime
//! representation metadata.
//!
//! Planner and emitter code must consume PreparedModule rather than rediscover
//! backend facts from optimized ANF.
//!
//! PreparedModule retains the post-boundary ANF body alongside explicit
//! prepared metadata. Backend passes must treat the prepared metadata as the
//! source of truth and use `.anf` only as the expression tree being lowered.
//!
//! INVARIANT: Do not add new inference logic in wasm_plan.tw or emit.tw.
//!            New backend facts belong in PreparedModule or its sub-records.

use @std.date
use @std.proc

use compiler.anf.{AnfModule}
use compiler.backend.context.{BackendContext}
use compiler.backend.prepared_ir.{CaptureParam, PreparedExpr, PreparedFunc, PreparedOp}
use compiler.backend.repr_assign.{assign_repr_for_module}
use compiler.backend.route_typed_vec.{SwappedSetSite, route_typed_vectors}
use compiler.backend.slot_assign.{assign_slots_for_module}
use compiler.backend.tailify.{never_returning_funcs, tailify_funcs}
use compiler.backend.typed_param_abi.{analyze_typed_repr}
use compiler.base_env.{first_user_type_id}
use compiler.builtins.{BuiltinRegistry}
use compiler.codegen.insert_boundaries.{insert_boundaries}
use compiler.codegen.mutable_select
use compiler.codegen.wasm_plan_types.{WasmTypeRegistry}
use compiler.core_ir.{FuncId}
use compiler.resolver.{ResolvedEnv}

// PreparedModule is the codegen contract between optimized ANF and emission.
//
// `.anf` holds the post-boundary ANF body. Slot metadata in `.funcs` covers all
// post-boundary locals, including wrap/unwrap temporaries. Backend logic must
// read explicit facts from `.funcs` and `.closure_captures`; `.anf` is the
// source syntax tree those prepared facts describe.
pub type PreparedModule = .{
  anf: AnfModule,
  closure_captures: Dict<Int, Vector<CaptureParam>>,
  funcs: Vector<PreparedFunc>,
  typed_vector_fields: Dict<String, Bool>,
  typed_vector_payloads: Dict<String, Bool>,
  mutable_decisions: mutable_select.MutableDecisionTable,
  mutable_emit_policy: mutable_select.MutableEmitPolicy,
}

// Boundary-inserted ANF plus the prepared funcs *before* typed-vector routing.
// This is the exact input analyze_typed_fields runs on; exposed so tests and
// tooling can inspect the routing decision on un-routed slots (routing mutates
// producer slots to PVecI64, which would hide them from a second analysis pass).
pub type PreRouteModule = .{ anf: AnfModule, funcs: Vector<PreparedFunc> }

pub fn backend_context(env: ResolvedEnv, prepared: PreparedModule) BackendContext {
  .{
    env,
    typed_vector_fields: prepared.typed_vector_fields,
    typed_vector_payloads: prepared.typed_vector_payloads,
  }
}

// Run the backend preparation steps up to (but not including) typed-vector
// routing. prepare_backend builds on this and then routes; tests use it to get
// the analysis input directly.
fn prepare_timings_enabled() Bool {
  case proc.env("TWINKLE_TIMINGS") {
    .Some(_) => true,
    .None => false,
  }
}

pub fn prepare_backend_preroute(
  anf: AnfModule,
  env: ResolvedEnv,
  builtins: BuiltinRegistry,
  closure_captures: Dict<Int, Vector<CaptureParam>>,
) PreRouteModule {
  timed := prepare_timings_enabled()
  t0 := date.now()

  // Insert explicit wrap/unwrap nodes at every representation-crossing point.
  anf2 := insert_boundaries(anf, empty_registry(), builtins, env)
  t1 := date.now()

  // Assign slots after boundary insertion so wrap/unwrap temporaries are
  // included in the slot maps.
  funcs := assign_slots_for_module(anf2.functions, closure_captures, env)
  t2 := date.now()

  // Refine SlotInfo.repr and SlotInfo.wasm_type from the slot-assignment
  // defaults using MonoType and boundary-op overrides.
  funcs2 := assign_repr_for_module(funcs, env, builtins)
  t3 := date.now()

  if timed {
    eprintln(
      "[time:prepare] insert_boundaries=${(t1 - t0).to_string()}ms  assign_slots=${(t2 - t1).to_string()}ms  assign_repr=${(t3
        - t2).to_string()}ms",
    )
  }

  .{ anf: anf2, funcs: funcs2 }
}

// prepare_backend converts optimized semantic ANF into prepared backend IR.
//
// This is the only sanctioned entry into the backend pipeline. Call this after
// compute_closure_captures() and before planning/emission.
//
// closure_captures must be computed by the caller via compute_closure_captures()
// so preparation and later planning share the same authoritative capture map.
pub fn prepare_backend(
  anf: AnfModule,
  env: ResolvedEnv,
  builtins: BuiltinRegistry,
  closure_captures: Dict<Int, Vector<CaptureParam>>,
) PreparedModule {
  prepare_backend_with_mutable_decisions(
    anf,
    env,
    builtins,
    closure_captures,
    mutable_select.empty_decision_table(),
  )
}

// Retarget one decision's persistent/mutable funcs from the boxed set family to
// the typed i64 family. A no-op for any decision not recorded against set_unsafe
// / set_in_place (so a site's non-VectorSet decisions pass through unchanged).
fn remap_set_decision(
  d: mutable_select.MutableDecision,
  set_unsafe_id: Int,
  set_i64_id: Int,
  set_in_place_id: Int,
  set_in_place_i64_id: Int,
) mutable_select.MutableDecision {
  case d.persistent_func {
    .Some(f) => if f.id == set_unsafe_id {
      d.persistent_func = .Some(FuncId.{ id: set_i64_id })
    },
    .None => {},
  }
  case d.mutable_func {
    .Some(f) => if f.id == set_in_place_id {
      d.mutable_func = .Some(FuncId.{ id: set_in_place_i64_id })
    },
    .None => {},
  }
  d
}

// Remap every swapped set site's decision(s) to the typed i64 targets. Keyed by
// the set result's source local (site.result_source_local — what the emit
// selector keys on, stable across the callee swap); other decision fields
// (site, source/result local, base_arg_index, arg_count, family) are unchanged.
fn remap_swapped_set_decisions(
  table: mutable_select.MutableDecisionTable,
  sites: Vector<SwappedSetSite>,
  builtins: BuiltinRegistry,
) mutable_select.MutableDecisionTable {
  set_unsafe_id := builtins.id("vector$set_unsafe").id
  set_i64_id := builtins.id("vector$set_i64").id
  set_in_place_id := builtins.id("vector$set_in_place").id
  set_in_place_i64_id := builtins.id("vector$set_in_place_i64").id
  t := table

  for site in sites {
    key := mutable_select.site_key(mutable_select.Site.{
      func: FuncId.{ id: site.func_id },
      local: .{ id: site.result_source_local },
    })

    case t.by_site.get(key) {
      .Some(ds) => t.by_site[key] = collect d in ds {
        remap_set_decision(d, set_unsafe_id, set_i64_id, set_in_place_id, set_in_place_i64_id)
      },
      .None => {},
    }
  }

  t
}

// Same as prepare_backend, but threads a persistent-only mutable decision
// table through to the resulting PreparedModule. The table is opaque to
// preparation itself (no inference logic here reads or acts on it); it is
// carried so later codegen phases can reach the decisions made upstream.
// This entry point does not change emitted code.
pub fn prepare_backend_with_mutable_decisions(
  anf: AnfModule,
  env: ResolvedEnv,
  builtins: BuiltinRegistry,
  closure_captures: Dict<Int, Vector<CaptureParam>>,
  mutable_decisions: mutable_select.MutableDecisionTable,
) PreparedModule {
  pre := prepare_backend_preroute(anf, env, builtins, closure_captures)

  if prepared_funcs_depth_exceeds(pre.funcs, 512) {
    return .{
      anf: pre.anf,
      closure_captures,
      funcs: pre.funcs,
      typed_vector_fields: Dict.new(),
      typed_vector_payloads: Dict.new(),
      mutable_decisions,
      mutable_emit_policy: mutable_select.persistent_only_policy(),
    }
  }

  // Joint greatest-fixpoint over typed fields, typed payloads, and cross-call
  // param typeability. A typeable param stored into a payload/field is a clean
  // typed producer, so real dataframe columns built via helpers like
  // `int_col(values: Vector<Int>)` can type even without a direct `collect`
  // producer. BackendContext construction from PreparedModule and routing MUST
  // see the same dicts so struct field types and read/producer routing agree.
  // Tailify tail-position control-flow results (Vector<Int> returns) BEFORE both
  // analysis and routing so a store-form accessor's live arm becomes a Return and
  // types via the payload+Return path. Both must see the same transformed funcs.
  timed := prepare_timings_enabled()
  r0 := date.now()

  // Computed once from the full pre-tailify funcs and shared with both passes;
  // tailify does not change any function's return type, so the same set is valid
  // for the tailified funcs analyzed just below.
  never := never_returning_funcs(pre.funcs)
  funcs_t := tailify_funcs(pre.funcs, builtins, never)
  r1 := date.now()
  repr := analyze_typed_repr(funcs_t, builtins, first_user_type_id(), never)
  r2 := date.now()
  typed_fields := repr.typed_fields
  typed_payloads := repr.typed_payloads
  routed := route_typed_vectors(
    funcs_t,
    builtins,
    typed_fields,
    typed_payloads,
    repr.capture_abi,
    repr.param_abi.typeable_return,
  )
  funcs3 := routed.funcs

  // Remap the mutable-codegen decision for every site routing swapped
  // set_unsafe -> set_i64: retarget persistent_func -> set_i64 and mutable_func
  // -> set_in_place_i64. The decision was recorded pre-route against set_unsafe;
  // without this the emit selector's persistent_matches gate rejects it (the
  // owned site would fall back to the functional set_i64) and its boxed
  // set_in_place target is type-unsound on a PVecI64 base (fact 4-b). Site keys
  // and shapes are stable across the callee swap.
  decisions := remap_swapped_set_decisions(mutable_decisions, routed.swapped_sites, builtins)
  r3 := date.now()

  if timed {
    eprintln(
      "[time:prepare] tailify=${(r1 - r0).to_string()}ms  analyze_typed_repr=${(r2 - r1).to_string()}ms  route_typed_vectors=${(r3
        - r2).to_string()}ms",
    )
  }

  .{
    anf: pre.anf,
    closure_captures,
    funcs: funcs3,
    typed_vector_fields: typed_fields,
    typed_vector_payloads: typed_payloads,
    mutable_decisions: decisions,
    mutable_emit_policy: mutable_select.persistent_only_policy(),
  }
}

// Same as prepare_backend_with_mutable_decisions, but also threads an
// explicit mutable emission policy through to the resulting PreparedModule,
// so a caller can opt selected call sites into mutable/in-place emission
// (e.g. Phase 8A's vector-set-only policy) instead of the persistent-only
// default.
pub fn prepare_backend_with_mutable_config(
  anf: AnfModule,
  env: ResolvedEnv,
  builtins: BuiltinRegistry,
  closure_captures: Dict<Int, Vector<CaptureParam>>,
  mutable_decisions: mutable_select.MutableDecisionTable,
  mutable_emit_policy: mutable_select.MutableEmitPolicy,
) PreparedModule {
  prepared := prepare_backend_with_mutable_decisions(
    anf,
    env,
    builtins,
    closure_captures,
    mutable_decisions,
  )
  prepared.mutable_emit_policy = mutable_emit_policy
  prepared
}

fn prepared_funcs_depth_exceeds(funcs: Vector<PreparedFunc>, limit: Int) Bool {
  for func in funcs {
    if prepared_depth_exceeds(func.body, limit) {
      return true
    }
  }

  false
}

// Recursion is bounded by `limit` (returns as soon as depth exceeds it), so
// this walks the Let spine iteratively without a worklist and stays stack-safe.
fn prepared_depth_exceeds(expr: PreparedExpr, limit: Int) Bool {
  prepared_depth_exceeds_at(expr, 1, limit)
}

fn prepared_depth_exceeds_at(expr: PreparedExpr, depth: Int, limit: Int) Bool {
  cur := expr
  d := depth
  done := false

  for !done {
    if d > limit {
      return true
    }

    case cur {
      .Let(_, op, body) => {
        if op_children_depth_exceeds(op, d + 1, limit) {
          return true
        }

        cur = body
        d = d + 1
      },
      _ => done = true,
    }
  }

  false
}

fn op_children_depth_exceeds(op: PreparedOp, depth: Int, limit: Int) Bool {
  case op {
    .AIf(_, then_e, else_e) => prepared_depth_exceeds_at(then_e, depth, limit)
      or prepared_depth_exceeds_at(else_e, depth, limit),
    .AMatch(_, arms) => {
      for arm in arms {
        if prepared_depth_exceeds_at(arm.body, depth, limit) {
          return true
        }
      }

      false
    },
    .ALoop(inner) => prepared_depth_exceeds_at(inner, depth, limit),
    .ADefer(inner) => prepared_depth_exceeds_at(inner, depth, limit),
    _ => false,
  }
}

fn empty_registry() WasmTypeRegistry {
  .{
    type_defs: [],
    layout_cache: Dict.new(),
    in_progress: Dict.new(),
    type_index: Dict.new(),
    concrete_func_sigs: Dict.new(),
    closure_materialized_funcs: Dict.new(),
    typed_closure_funcs: Dict.new(),
    direct_builtin_calls: Dict.new(),
    capture_layouts: Dict.new(),
    module_globals: Dict.new(),
    module_globals_order: [],
    string_pool: Dict.new(),
    string_pool_order: [],
    string_pool_next_offset: 0,
    runtime_imports: [],
    variant_singletons: Dict.new(),
    dense_tables: Dict.new(),
    dense_tables_order: [],
  }
}
