//! MutVec physical-repr assignment (storage slice 1).
//!
//! After `mutvec_region.rewrite_module` lowers a claimed region to `mutvec_*`
//! runtime ops, the live handle slots still carry the default boxed `Vector<Int>`
//! repr (`TypedRef`) because `repr_assign` derives reprs from MonoType, which
//! stays `Vector<Int>`. This pass is the site-aware override that marks those
//! handle slots as `MutVec(I64)` — the role `route_typed_vec` plays for PVecI64
//! slots. It reads the already-rewritten prepared IR (it does NOT re-prove
//! ownership or exits — the region rewrite already committed to those): a slot
//! that flows through a `mutvec_*` op is a `MutVec(I64)` handle.
//!
//! The `mutvec_freeze_i64` *result* slot (the materialized PVecI64) is NOT owned
//! here — `route_typed_vec` recognizes `mutvec_freeze_i64` as a typed producer
//! and types it explicitly to the PVecI64 wasm type (and sets phys_return + types
//! caller result slots). Marking it here with `TypedVec(I64)` would duplicate and
//! conflict with that ownership, so this pass leaves frozen slots to route.
//!
//! ── HP-4 (interprocedural S4) ABI-upgrade consumption (Task 7) ──
//!
//! `mutvec_call_phase.run_mutvec_call` computes `MutVecCallDecision.abi_upgrades: Vector<MutVecCallAbiUpgrade>` —
//! for every owned clone whose EVERY routed call site is an accepted
//! interprocedural region, a record naming the clone's receiver param(s) +
//! return as safe to type `MutVec<fam>` instead of the persistent PVec ABI —
//! AND rewrites the ANF so the upgraded clone body and its accepted caller
//! regions use `mutvec_*` ops (see `mutvec_call_phase`'s header). Only after that ANF
//! rewrite is consuming `abi_upgrades` sound: typing the receiver SLOT
//! `MutVec(fam)` while the body still called the boxed PVec ops would fall
//! through `emit_coerce_stack`'s fully-generic `.RefCast` fallback (it bridges
//! only a family's boxed PVec <-> that family's typed PVec via
//! `fam.box_call`/`fam.unbox_call`; MutVec has no boxed counterpart, only the
//! one-way `mutvec_freeze`), a `ref.cast` between unrelated GC structs that
//! fails validation / traps.
//!
//! Post-rewrite, `assign_mutvec_reprs` (above) already types the local handle
//! slots that flow through those `mutvec_*` ops — including the clone's receiver
//! PARAM (arg0 of `mutvec_set`/`get`/`len`) via the seed. The two remaining
//! function-ABI facts no slot flow implies — the clone's MutVec `phys_return`
//! and each routed caller's call-RESULT slot — are supplied by
//! `apply_mutvec_call_abi_upgrades` (below), the consumer wired at `codegen.prepare_codegen`
//! after `prepare_backend`. `route_typed_vec` still owns the escape-path
//! `mutvec_freeze` RESULT slot (a materialized PVec), so the two never collide.

use compiler.backend.prepared_ir.{
  PreparedAtom, PreparedExpr, PreparedFunc, PreparedOp, ReprKind, SlotInfo,
}
use compiler.backend.repr_assign.{wasm_type_of_repr}
use compiler.backend.repr_policy.{ElemRepr, candidate_typed_vec_family}
use compiler.builtins
use compiler.builtins.{BuiltinRegistry}
use compiler.codegen.mutvec_call_phase.{MutVecCallAbiUpgrade}
use compiler.codegen.wasm_layout.{mutvec_wasm_type}
use compiler.elem_family.{mutvec_families}
use compiler.resolver.{ResolvedEnv}

// The mutvec op FuncIds keyed by the role they play in the seed, aggregated
// across every registered mutvec family (Int today). Membership sets rather than
// per-family fields so the seed stays family-agnostic: a slot flowing through any
// family's mutvec op is a handle, and the family-specific physical repr is chosen
// per slot from its MonoType (see `override_slot`).
type MutVecIds = .{
  // `new`/`make`/`push`/`set` results are MutVec handles.
  handle_results: Dict<Int, Bool>,
  // `freeze` results are the materialized (persistent) PVec slot.
  frozen_results: Dict<Int, Bool>,
  // `set`/`get`/`len`/`push`/`freeze` take the handle as arg0.
  arg0_handles: Dict<Int, Bool>,
}

fn resolve_ids(b: BuiltinRegistry) MutVecIds {
  handle: Dict<Int, Bool> = Dict.new()
  frozen: Dict<Int, Bool> = Dict.new()
  arg0: Dict<Int, Bool> = Dict.new()
  for f in mutvec_families() {
    s := f.suffix
    new_id := builtins.id(b, "vector$__mutvec_new${s}").id
    make_id := builtins.id(b, "vector$__mutvec_make${s}").id
    push_id := builtins.id(b, "vector$__mutvec_push${s}").id
    set_id := builtins.id(b, "vector$__mutvec_set${s}").id
    get_id := builtins.id(b, "vector$__mutvec_get${s}").id
    len_id := builtins.id(b, "vector$__mutvec_len${s}").id
    freeze_id := builtins.id(b, "vector$__mutvec_freeze${s}").id
    handle[new_id] = true
    handle[make_id] = true
    handle[push_id] = true
    handle[set_id] = true
    frozen[freeze_id] = true
    arg0[set_id] = true
    arg0[get_id] = true
    arg0[len_id] = true
    arg0[push_id] = true
    arg0[freeze_id] = true
  }
  .{ handle_results: handle, frozen_results: frozen, arg0_handles: arg0 }
}

fn slot_id(a: PreparedAtom) Int? {
  case a {
    .ASlot(s) => .Some(s.id),
    _ => .None,
  }
}

// Seed/propagation state threaded through returns (Twinkle dicts are immutable —
// mutating a dict arg does not reach the caller, so we accumulate functionally).
type SeedAcc = .{ handle: Dict<Int, Bool>, frozen: Dict<Int, Bool> }

fn mark_handle(acc: SeedAcc, sid: Int) SeedAcc {
  acc.handle[sid] = true
  acc
}

fn mark_frozen(acc: SeedAcc, sid: Int) SeedAcc {
  acc.frozen[sid] = true
  acc
}

fn mark_arg0(acc: SeedAcc, args: Vector<PreparedAtom>) SeedAcc {
  if args.len() >= 1 {
    case slot_id(args[0]) {
      .Some(sid) => acc.mark_handle(sid),
      .None => acc,
    }
  } else {
    acc
  }
}

// Seed: any slot that is the result or arg0 of a mutvec op is a handle; the
// freeze result is the persistent frozen slot. `acc` is first so the walk reads
// as inherent-method chains (acc.seed_op(...).seed_expr(...)).
fn seed_expr(acc: SeedAcc, e: PreparedExpr, ids: MutVecIds) SeedAcc {
  case e {
    .Let(slot, op, _, body) => acc.seed_op(slot.id, op, ids).seed_expr(body, ids),
    _ => acc,
  }
}

fn seed_op(acc: SeedAcc, rid: Int, op: PreparedOp, ids: MutVecIds) SeedAcc {
  case op {
    .ACall(.AGlobalFunc(f), args) => {
      a1 := if ids.handle_results.has(f.id) {
        acc.mark_handle(rid)
      } else {
        acc
      }
      a2 := if ids.frozen_results.has(f.id) {
        a1.mark_frozen(rid)
      } else {
        a1
      }
      if ids.arg0_handles.has(f.id) {
        a2.mark_arg0(args)
      } else {
        a2
      }
    },
    .AIf(_, t, e) => acc.seed_expr(t, ids).seed_expr(e, ids),
    .AMatch(_, arms) => {
      for arm in arms {
        acc = .seed_expr(arm.body, ids)
      }
      acc
    },
    .ALoop(inner) => acc.seed_expr(inner, ids),
    .ADefer(inner) => acc.seed_expr(inner, ids),
    _ => acc,
  }
}

// Propagate handle-ness through `dst = init src` / `dst = assign src` copies of
// the producer chain (e.g. the collect builder alias inits). Threads the handle
// set through returns; the driver re-runs to a fixpoint via the changed flag.
type PropAcc = .{ handle: Dict<Int, Bool>, changed: Bool }

fn propagate_expr(acc: PropAcc, e: PreparedExpr) PropAcc {
  case e {
    .Let(slot, op, _, body) => acc.propagate_op(slot.id, op).propagate_expr(body),
    _ => acc,
  }
}

fn prop_copy(acc: PropAcc, dst: Int, src_atom: PreparedAtom) PropAcc {
  case slot_id(src_atom) {
    .Some(src) => if acc.handle.has(src) and !acc.handle.has(dst) {
      acc.handle[dst] = true
      acc.changed = true
      acc
    } else {
      acc
    },
    .None => acc,
  }
}

fn propagate_op(acc: PropAcc, rid: Int, op: PreparedOp) PropAcc {
  case op {
    .AInit(a) => acc.prop_copy(rid, a),
    .AAssign(target, a) => acc.prop_copy(target.id, a),
    .AIf(_, t, e) => acc.propagate_expr(t).propagate_expr(e),
    .AMatch(_, arms) => {
      for arm in arms {
        acc = .propagate_expr(arm.body)
      }
      acc
    },
    .ALoop(inner) => acc.propagate_expr(inner),
    .ADefer(inner) => acc.propagate_expr(inner),
    _ => acc,
  }
}

// Run init/assign propagation to a fixpoint.
fn propagate_fixpoint(body: PreparedExpr, handle: Dict<Int, Bool>) Dict<Int, Bool> {
  cur := handle
  changed := true
  for changed {
    r: PropAcc = .{ handle: cur, changed: false }
    r2 := r.propagate_expr(body)
    cur = r2.handle
    changed = r2.changed
  }
  cur
}

fn override_slot(info: SlotInfo, repr: ReprKind, env: ResolvedEnv) SlotInfo {
  .{
    slot: info.slot,
    source_local: info.source_local,
    role: info.role,
    mono: info.mono,
    repr,
    wasm_type: wasm_type_of_repr(repr, info.mono, env),
  }
}

fn assign_in_func(pf: PreparedFunc, ids: MutVecIds, env: ResolvedEnv) PreparedFunc {
  init: SeedAcc = .{ handle: Dict.new(), frozen: Dict.new() }
  seeded := init.seed_expr(pf.body, ids)
  frozen := seeded.frozen

  // No mutvec op in this function -> untouched (byte-identical).
  if seeded.handle.keys().len() == 0 and frozen.keys().len() == 0 {
    return pf
  }

  // Fixpoint the init/assign propagation of the producer chain.
  handle := propagate_fixpoint(pf.body, seeded.handle)

  // Only handle slots are overridden here. The freeze-result (materialized
  // PVecI64) slot is left to route_typed_vec, which recognizes mutvec_freeze_i64
  // as a typed producer and types it explicitly to the PVecI64 wasm type (and in
  // turn sets phys_return + types caller result slots). Overriding it here with
  // `.TypedVec(.I64)` would duplicate and conflict with that ownership. Handles
  // have no such producer, so they still need MutVec.
  new_slots: Dict<Int, SlotInfo> = Dict.new()
  for sid, info in pf.slots {
    route_typed := case info.repr {
      .TypedVec(_) => true,
      _ => false,
    }
    if route_typed and handle.has(info.slot.id) {
      error(
        "mutvec_repr: slot S${info.slot.id.to_string()} is both route-owned Typed and MutVec handle in ${pf.name}",
      )
    }
    new_slots[sid] = if handle.has(info.slot.id) {
      // The ElemRepr follows the handle slot's element family (its mono is the
      // claimed `Vector<T>`); `.I64` for the i64 family. Physical wasm type is
      // still the shared MutVec layout downstream, so the tag is classificatory.
      elem := case candidate_typed_vec_family(info.mono) {
        .Some(e) => e,
        .None => .I64,
      }
      override_slot(info, .MutVec(elem), env)
    } else {
      info
    }
  }

  pf.slots = new_slots
  pf
}

// Override the physical repr of every MutVec handle slot across the module (the
// freeze *result* slot is route-owned, not touched here — see the module doc and
// assign_in_func). A no-op for functions with no mutvec op (the common case), so
// the flag-off pipeline is unaffected.
pub fn assign_mutvec_reprs(funcs: Vector<PreparedFunc>, env: ResolvedEnv, builtins: BuiltinRegistry) Vector<
  PreparedFunc,
> {
  ids := resolve_ids(builtins)
  collect pf in funcs {
    assign_in_func(pf, ids, env)
  }
}

// ── HP-4: interprocedural S4 ABI-upgrade consumption ──────────────────────
//
// `mutvec_call_phase.run_mutvec_call` already rewrote the ANF so an upgraded clone body writes/reads
// its receiver via `mutvec_*` ops and the accepted caller region flattened its
// producer chain (see `mutvec_call_phase.apply_mutvec_call_rewrite`). After that rewrite,
// `assign_mutvec_reprs` (above) has already typed the *local* handle slots that
// flow through those `mutvec_*` ops — including the clone's receiver PARAM (arg0
// of `mutvec_set`/`get`/`len`) via the seed. What the seed cannot type are the
// two FUNCTION-ABI facts, because they are not tied to any `mutvec_*` op result
// or arg0 in the reader's own body:
//   - the upgraded clone's MutVec RETURN ABI (`phys_return`) — it returns its
//     receiver, but `phys_return` is a function-level fact no slot flow implies;
//   - each routed caller's call-RESULT slot (`flags = clone(flags, i, v)`), whose
//     defining op is the clone call, not a `mutvec_*` op, so the seed leaves it
//     boxed — a boxed-PVec slot fed a MutVec-returning callee traps at emit.
// This pass supplies exactly those two (plus, defensively, the receiver param
// slot itself, so a degenerate clone that never reads/writes its receiver still
// gets a MutVec param that agrees with its callers). `route_typed_vec` owns the
// escape-path `mutvec_freeze` RESULT slot (a materialized PVec) as before, so the
// two never collide. Empty `upgrades` (boot's own source — no qualifying S4
// shape) returns `funcs` byte-identical, so self-host stays at the fixed point.
pub fn apply_mutvec_call_abi_upgrades(
  funcs: Vector<PreparedFunc>,
  upgrades: Vector<MutVecCallAbiUpgrade>,
  env: ResolvedEnv,
  builtins: BuiltinRegistry,
) Vector<PreparedFunc> {
  if upgrades.len() == 0 {
    return funcs
  }
  collect pf in funcs {
    upgrade_func(pf, upgrades, env)
  }
}

fn find_clone_upgrade(upgrades: Vector<MutVecCallAbiUpgrade>, fid: Int) MutVecCallAbiUpgrade? {
  for u in upgrades {
    if u.clone_func == fid {
      return .Some(u)
    }
  }
  .None
}

fn recv_local_of(u: MutVecCallAbiUpgrade, local_id: Int) Bool {
  for l in u.param_slots {
    if l == local_id {
      return true
    }
  }
  false
}

fn upgrade_func(pf: PreparedFunc, upgrades: Vector<MutVecCallAbiUpgrade>, env: ResolvedEnv) PreparedFunc {
  // (a) An upgraded clone: type its receiver param slot(s) MutVec(fam) and expose
  //     the MutVec return ABI. The receiver param's SlotInfo.source_local is the
  //     ANF receiver local `param_slots` records.
  cur := case find_clone_upgrade(upgrades, pf.func_id.id) {
    .Some(u) => {
      wt := mutvec_wasm_type(u.fam)
      new_slots: Dict<Int, SlotInfo> = pf.slots
      for sid, info in pf.slots {
        if recv_local_of(u, info.source_local.id) {
          new_slots[sid] = override_slot(info, .MutVec(u.fam), env)
        }
      }
      pf.slots = new_slots
      pf.phys_return = .Some(wt)
      pf
    },
    .None => pf,
  }

  // (b) Every routed caller call-result slot: `flags = <upgraded-clone call>` —
  //     type it MutVec(fam) so the boundary is MutVec→MutVec (no coercion).
  targets := collect_call_result_fams(cur.body, upgrades, Dict.new())
  if targets.keys().len() == 0 {
    cur
  } else {
    new_slots: Dict<Int, SlotInfo> = cur.slots
    for sid, info in cur.slots {
      case targets.get(info.slot.id) {
        .Some(fam) => new_slots[sid] = override_slot(info, .MutVec(fam), env),
        .None => {},
      }
    }
    cur.slots = new_slots
    cur
  }
}

// Map each call-result slot id whose op is a call to an upgraded clone to that
// clone's element family. Walks control flow so a threaded call nested in a loop
// or branch is covered.
fn collect_call_result_fams(
  e: PreparedExpr,
  upgrades: Vector<MutVecCallAbiUpgrade>,
  acc: Dict<Int, ElemRepr>,
) Dict<Int, ElemRepr> {
  case e {
    .Let(slot, op, _, body) => collect_call_result_fams(
      body,
      upgrades,
      call_result_fams_op(slot.id, op, upgrades, acc),
    ),
    _ => acc,
  }
}

fn call_result_fams_op(
  rid: Int,
  op: PreparedOp,
  upgrades: Vector<MutVecCallAbiUpgrade>,
  acc: Dict<Int, ElemRepr>,
) Dict<Int, ElemRepr> {
  case op {
    .ACall(.AGlobalFunc(f), _) => case find_clone_upgrade(upgrades, f.id) {
      .Some(u) => {
        acc[rid] = u.fam
        acc
      },
      .None => acc,
    },
    .AIf(_, t, e) => collect_call_result_fams(
      e,
      upgrades,
      collect_call_result_fams(t, upgrades, acc),
    ),
    .AMatch(_, arms) => {
      for arm in arms {
        acc = collect_call_result_fams(arm.body, upgrades, acc)
      }
      acc
    },
    .ALoop(inner) => collect_call_result_fams(inner, upgrades, acc),
    .ADefer(inner) => collect_call_result_fams(inner, upgrades, acc),
    _ => acc,
  }
}
