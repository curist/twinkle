//! Tail-match result typing: a noreturn-aware divergence predicate and (Task 2)
//! the tailify canonicalization.

use compiler.backend.prepared_ir.{PreparedExpr, PreparedFunc, PreparedMatchArm, PreparedOp}
use compiler.builtins.{BuiltinRegistry, is_noreturn}
use compiler.elem_family.{elem_family_of}

// Func ids whose declared return type is `Never`. A call to such a function
// diverges just like a call to an is_noreturn builtin. This is how the generic
// `error`/`eprint` prelude wrappers (and user `Never` functions like proc.exit)
// are recognized: after they became ordinary functions, `is_noreturn` (builtins
// only) no longer catches them, so the tail-match typed-return rewrite would
// otherwise revert accessor functions to the boxed store form.
pub fn never_returning_funcs(funcs: Vector<PreparedFunc>) Dict<Int, Bool> {
  out: Dict<Int, Bool> = Dict.new()

  for pf in funcs {
    case pf.return_mono {
      .Never => out[pf.func_id.id] = true,
      _ => {},
    }
  }

  out
}

// PreparedExpr mirror of expr_always_diverges, but noreturn-aware: a call to an
// is_noreturn builtin or a `Never`-returning function diverges, and (unlike
// emit/helpers.tw's version) it recurses into if/match ops. Both are required —
// adding only the error-call case misses `Let(r, AMatch[all arms diverge], ...)`.
pub fn prep_diverges(expr: PreparedExpr, reg: BuiltinRegistry, never: Dict<Int, Bool>) Bool {
  case expr {
    .Return(_) => true,
    .Break(_) => true,
    .Continue => true,
    .Atom(_) => false,
    .Let(_, op, _, body) => prep_op_diverges(op, reg, never) or prep_diverges(body, reg, never),
  }
}

pub fn prep_op_diverges(op: PreparedOp, reg: BuiltinRegistry, never: Dict<Int, Bool>) Bool {
  case op {
    .ACall(.AGlobalFunc(fid), _) => is_noreturn(reg, fid) or never.has(fid.id),
    .AIf(_, then_e, else_e) => prep_diverges(then_e, reg, never)
      and prep_diverges(else_e, reg, never),
    .AMatch(_, arms) => {
      if arms.len() == 0 {
        return true
      }

      for arm in arms {
        if !prep_diverges(arm.body, reg, never) {
          return false
        }
      }

      true
    },
    _ => false,
  }
}

// Rewrite a tail-position control-flow result's value-producing arms to Return, so
// the returned payload flows through the escape analysis's `.Return => false` rule
// (consumed-typed-only) with no store-escape relaxation. Gated to typed-vector
// families (Vector<Int>/Vector<Bool>, see elem_family_of) to keep the IR-shape
// change confined to accessor-shaped functions.
pub fn tailify_funcs(funcs: Vector<PreparedFunc>, reg: BuiltinRegistry, never: Dict<Int, Bool>) Vector<
  PreparedFunc,
> {
  collect pf in funcs {
    tailify_func(pf, reg, never)
  }
}

fn tailify_func(pf: PreparedFunc, reg: BuiltinRegistry, never: Dict<Int, Bool>) PreparedFunc {
  is_typed_vec := case elem_family_of(pf.return_mono) {
    .Some(_) => true,
    .None => false,
  }

  if !is_typed_vec {
    return pf
  }

  pf.body = tailify_spine(pf.body, reg, never)
  pf
}

// Walk the top-level Let-spine to the terminal `Let(r, AMatch|AIf, Atom(ASlot r))`
// and rewrite that op's arms. Other tail shapes are left unchanged. The structural
// shape (r's sole use is the immediately-following trailing atom) guarantees r is
// used exactly once, so per-arm Return is semantics-preserving.
//
// Guard: only commit the rewrite if at least one arm still structurally falls
// through (stores r), so the dead trailing `Atom(ASlot r)` still references an
// assigned slot. If rewriting every arm to Return would leave r unassigned (all
// value arms, or an explicit-return diverging arm), revert to the store form —
// which keeps r assigned and stays correct (just boxed). The dataframe accessors
// keep their `error(...)` value arm as a fall-through store, so they still type.
fn tailify_spine(expr: PreparedExpr, reg: BuiltinRegistry, never: Dict<Int, Bool>) PreparedExpr {
  case expr {
    .Let(s, op, sp, rest) => case rest {
      .Atom(.ASlot(s2)) => if s2.id == s.id {
        rewritten := tailify_result_op(op, reg, never)

        if op_has_fallthrough_arm(rewritten) {
          .Let(s, rewritten, sp, rest)
        } else {
          .Let(s, op, sp, rest)
        }
      } else {
        .Let(s, op, sp, tailify_spine(rest, reg, never))
      },
      _ => .Let(s, op, sp, tailify_spine(rest, reg, never)),
    },
    _ => expr,
  }
}

// True if the expression's tail structurally falls through (ends in an Atom that
// stores the enclosing result slot) rather than a structural terminal
// (Return/Break/Continue). A value-producing noreturn call like `error(...)` still
// falls through structurally (its tail is an Atom), so it keeps the result slot
// assigned even though it traps at runtime.
fn expr_falls_through(expr: PreparedExpr) Bool {
  case expr {
    .Atom(_) => true,
    .Return(_) => false,
    .Break(_) => false,
    .Continue => false,
    .Let(_, _, _, body) => expr_falls_through(body),
  }
}

fn op_has_fallthrough_arm(op: PreparedOp) Bool {
  case op {
    .AMatch(_, arms) => {
      for arm in arms {
        if expr_falls_through(arm.body) {
          return true
        }
      }

      false
    },
    .AIf(_, then_e, else_e) => expr_falls_through(then_e) or expr_falls_through(else_e),
    _ => true,
  }
}

fn tailify_result_op(op: PreparedOp, reg: BuiltinRegistry, never: Dict<Int, Bool>) PreparedOp {
  case op {
    .AMatch(scrut, arms) => .AMatch(scrut, tailify_arms(arms, reg, never)),
    .AIf(c, t, e) => .AIf(c, tailify_arm(t, reg, never), tailify_arm(e, reg, never)),
    _ => op,
  }
}

fn tailify_arms(arms: Vector<PreparedMatchArm>, reg: BuiltinRegistry, never: Dict<Int, Bool>) Vector<
  PreparedMatchArm,
> {
  collect arm in arms {
    PreparedMatchArm.{ pattern: arm.pattern, body: tailify_arm(arm.body, reg, never) }
  }
}

// A non-diverging arm's tail value becomes a Return; diverging arms (Return / error
// spine) are left untouched (prep_diverges already treats a Return-terminated arm as
// diverging, so this is idempotent). Nested control-flow in the arm tail is returned
// as-is (conservative: its result may be boxed — correct, just not typed).
fn tailify_arm(body: PreparedExpr, reg: BuiltinRegistry, never: Dict<Int, Bool>) PreparedExpr {
  if prep_diverges(body, reg, never) {
    return body
  }

  case body {
    .Atom(a) => .Return(.Some(a)),
    .Let(s, op, sp, rest) => .Let(s, op, sp, tailify_arm(rest, reg, never)),
    _ => body,
  }
}
