//! Whole-program interprocedural summary driver.
//!
//! Computes a `SummaryTable` bottom-up over call-graph SCCs, using the
//! per-function `ownership.summarize_function` transfer. Edges run from a
//! function to the user functions it directly calls (its dependencies), so
//! `graph_scc.strongly_connected` (dependency-before-dependent order) yields the
//! components in callee-first order: a callee's SCC is fixed before its callers'
//! SCC, making callee summaries available when callers are analyzed.
//!
//! Module graph stays acyclic: summary.tw depends on ownership.tw/cfg.tw, never
//! the reverse.

use @std.date
use @std.proc

use compiler.anf.{AnfOp, Atom}
use compiler.builtins.{BuiltinRegistry}
use compiler.cfg.{CfgFunction, CfgView, Terminator}
use compiler.graph_scc
use compiler.opt.semantics.{OptimizerSemantics}
use compiler.ownership.{
  FixCache, ParamRole, ParamSummary, RetVia, ReturnEffect, ReturnOwn, ReturnPathOwn, Summary,
  SummaryTable, VariantRequirementResolver, VariantResolver, analyze_function_with_seed_resolved,
  call_uniques_sited, empty_fix_cache, empty_summary_table, fix_cache_put, summarize_function_cached,
  summarize_variant_resolved, summary_get, with_dedupe_helpers,
}
use compiler.variant_id as vid

fn timings_enabled() Bool {
  case proc.env("TWINKLE_TIMINGS") {
    .Some(_) => true,
    .None => false,
  }
}

// ── Determinism helpers ─────────────────────────────────────────────
fn insert_sorted(v: Vector<Int>, id: Int) Vector<Int> {
  out: Vector<Int> = []
  inserted := false
  for x in v {
    if x == id {
      return v
    }
    if !inserted and id < x {
      out = .append(id)
      inserted = true
    }
    out = .append(x)
  }
  if !inserted {
    out = .append(id)
  }
  out
}

fn same_ints(a: Vector<Int>, b: Vector<Int>) Bool {
  if a.len() != b.len() {
    return false
  }
  for x, i in a {
    if x != b[i] {
      return false
    }
  }
  true
}

// ── Conservative seed ───────────────────────────────────────────────
// Sound starting point before any callee is known: every param Published (the
// role lattice top), return Shared. Monotone transfer only moves these down.
pub fn conservative_summary(f: CfgFunction) Summary {
  params: Vector<ParamSummary> = collect _p in f.params {
    ParamSummary.{ base_role: .Published, in_place_paths: vid.empty_set(), flows_to_return: false }
  }
  Summary.{ params, ret: .Shared, ret_paths: [] }
}

// ── Summary equality (fixpoint stop condition) ──────────────────────
fn role_eq(a: ParamRole, b: ParamRole) Bool {
  case a {
    .Borrowed => case b {
      .Borrowed => true,
      _ => false,
    },
    .Consumed => case b {
      .Consumed => true,
      _ => false,
    },
    .Published => case b {
      .Published => true,
      _ => false,
    },
  }
}

fn param_summary_eq(a: ParamSummary, b: ParamSummary) Bool {
  role_eq(a.base_role, b.base_role)
    and a.flows_to_return == b.flows_to_return and a.in_place_paths.same(b.in_place_paths)
}

fn return_eq(a: ReturnEffect, b: ReturnEffect) Bool {
  case a {
    .OwnedFresh => case b {
      .OwnedFresh => true,
      _ => false,
    },
    .Shared => case b {
      .Shared => true,
      _ => false,
    },
    .MayAliasParams(sa) => case b {
      .MayAliasParams(sb) => same_ints(sa, sb),
      _ => false,
    },
  }
}

fn ret_own_eq(a: ReturnOwn, b: ReturnOwn) Bool {
  case a {
    .OwnedFresh => case b {
      .OwnedFresh => true,
      _ => false,
    },
    .OwnedFromParam(ka) => case b {
      .OwnedFromParam(kb) => ka == kb,
      _ => false,
    },
  }
}

fn via_kind(v: RetVia) Int {
  case v {
    .Direct => 0,
    .Variant(_, _) => 1,
  }
}

fn via_tag(v: RetVia) Int {
  case v {
    .Direct => 0 - 1,
    .Variant(t, _) => t,
  }
}

fn via_idx(v: RetVia) Int {
  case v {
    .Direct => 0 - 1,
    .Variant(_, i) => i,
  }
}

fn field_key(f: Int?) Int {
  case f {
    .Some(x) => x,
    .None => 0 - 1,
  }
}

fn own_key(o: ReturnOwn) Int {
  case o {
    .OwnedFresh => 0 - 1,
    .OwnedFromParam(k) => k,
  }
}

fn cmp_ret_path(a: ReturnPathOwn, b: ReturnPathOwn) Order {
  c1 := via_kind(a.via).compare(via_kind(b.via))
  case c1 {
    .Eq => {},
    _ => return c1,
  }
  c2 := via_tag(a.via).compare(via_tag(b.via))
  case c2 {
    .Eq => {},
    _ => return c2,
  }
  c3 := via_idx(a.via).compare(via_idx(b.via))
  case c3 {
    .Eq => {},
    _ => return c3,
  }
  c4 := field_key(a.field).compare(field_key(b.field))
  case c4 {
    .Eq => {},
    _ => return c4,
  }
  own_key(a.own).compare(own_key(b.own))
}

fn sort_ret_paths(v: Vector<ReturnPathOwn>) Vector<ReturnPathOwn> {
  v.sort_by(cmp_ret_path)
}

fn ret_paths_eq(a: Vector<ReturnPathOwn>, b: Vector<ReturnPathOwn>) Bool {
  if a.len() != b.len() {
    return false
  }
  sa := sort_ret_paths(a)
  sb := sort_ret_paths(b)
  for r, i in sa {
    o := sb[i]
    same := via_kind(r.via) == via_kind(o.via)
      and via_tag(r.via) == via_tag(o.via) and via_idx(r.via) == via_idx(o.via)
      and field_key(r.field) == field_key(o.field) and ret_own_eq(r.own, o.own)
    if !same {
      return false
    }
  }
  true
}

pub fn same_summary(a: Summary, b: Summary) Bool {
  if a.params.len() != b.params.len() {
    return false
  }
  for pa, i in a.params {
    if !param_summary_eq(pa, b.params[i]) {
      return false
    }
  }
  return_eq(a.ret, b.ret) and ret_paths_eq(a.ret_paths, b.ret_paths)
}

// ── Call graph ──────────────────────────────────────────────────────
fn user_id_set(view: CfgView) Dict<Int, Bool> {
  set: Dict<Int, Bool> = Dict.new()
  for f in view.functions {
    set[f.func_id] = true
  }
  set
}

fn is_user(user_ids: Dict<Int, Bool>, id: Int) Bool {
  case user_ids.get(id) {
    .Some(v) => v,
    .None => false,
  }
}

// Direct-call user callees named in an op (dedup+sorted via insert_sorted).
fn collect_op_callees(acc: Vector<Int>, op: AnfOp, user_ids: Dict<Int, Bool>) Vector<Int> {
  case op {
    .ACall(callee, _) => case callee {
      .AGlobalFunc(fid) => if is_user(user_ids, fid.id) {
        insert_sorted(acc, fid.id)
      } else {
        acc
      },
      _ => acc,
    },
    _ => acc,
  }
}

// Every direct user-callee of `f`, deduped and sorted for a byte-stable graph.
pub fn callee_ids(f: CfgFunction, user_ids: Dict<Int, Bool>) Vector<Int> {
  acc: Vector<Int> = []
  for blk in f.blocks {
    for inst in blk.instructions {
      acc = collect_op_callees(acc, inst.op, user_ids)
    }
  }
  acc
}

// O(1) function lookup by id, built once per compute(). The whole-program driver
// looks functions up O(functions) times (once per SCC edge + once per worklist
// recompute), so a per-call linear scan of view.functions made the driver
// O(functions^2) -- the blowup that made `twk ir --cfg` on a whole program
// intractable.
fn build_func_index(view: CfgView) Dict<Int, CfgFunction> {
  idx: Dict<Int, CfgFunction> = Dict.new()
  for f in view.functions {
    idx[f.func_id] = f
  }
  idx
}

fn int_set(v: Vector<Int>) Dict<Int, Bool> {
  s: Dict<Int, Bool> = Dict.new()
  for x in v {
    s[x] = true
  }
  s
}

fn in_set(s: Dict<Int, Bool>, id: Int) Bool {
  case s.get(id) {
    .Some(v) => v,
    .None => false,
  }
}

// ── SCC ordering ────────────────────────────────────────────────────
// Nodes are enumerated in ascending func_id order and edges point from each
// function to its (sorted) callees, marshalled through decimal String labels.
// strongly_connected returns dependency-before-dependent components, i.e. in
// callee-first order. Decode each component's labels back to ints.
pub fn order_sccs(view: CfgView, index: Dict<Int, CfgFunction>, user_ids: Dict<Int, Bool>) Vector<
  Vector<Int>,
> {
  ids: Vector<Int> = collect f in view.functions {
    f.func_id
  }
  ids = .sort() // ascending func_id order for a byte-stable graph

  nodes: Vector<String> = collect id in ids {
    id.to_string()
  }
  edges: Dict<String, Vector<String>> = Dict.new()
  for id in ids {
    callees := case index.get(id) {
      .Some(f) => callee_ids(f, user_ids),
      .None => [],
    }
    labels: Vector<String> = collect c in callees {
      c.to_string()
    }
    edges[id.to_string()] = labels
  }

  comps := graph_scc.strongly_connected(nodes, edges)
  collect comp in comps {
    collect label in comp {
      case Int.from_string(label) {
        .Some(n) => n,
        .None => error("summary: bad scc label '${label}'"),
      }
    }
  }
}

// ── Per-SCC fixpoint ────────────────────────────────────────────────
fn table_put(t: SummaryTable, id: Int, s: Summary) SummaryTable {
  t.by_func[id] = s
  t
}

fn table_get(t: SummaryTable, id: Int) Summary {
  case summary_get(t, id) {
    .Some(s) => s,
    .None => error("summary: no seeded summary for ${id}"),
  }
}

// callee-in-SCC -> its in-SCC callers. Lets the worklist re-summarize a member
// only when a dependency changed. Restricted to the SCC: callees in earlier SCCs
// are already final (callee-first order), and non-recursive members have no
// in-SCC callee, so they are computed exactly once.
fn scc_callers(
  members: Vector<Int>,
  scc_set: Dict<Int, Bool>,
  index: Dict<Int, CfgFunction>,
  user_ids: Dict<Int, Bool>,
) Dict<Int, Vector<Int>> {
  callers: Dict<Int, Vector<Int>> = Dict.new()
  for m in members {
    case index.get(m) {
      .Some(f) => {
        for c in callee_ids(f, user_ids) {
          if in_set(scc_set, c) {
            prev := case callers.get(c) {
              .Some(v) => v,
              .None => [],
            }
            callers[c] = insert_sorted(prev, m)
          }
        }
      },
      .None => {},
    }
  }
  callers
}

// Monotone dataflow worklist over one SCC. Round 1 summarizes every member once
// from the conservative seed; thereafter only members whose in-SCC callees
// changed are recomputed. The role/return lattices only move down
// (Published->Consumed->Borrowed, Shared->alias->fresh, plus the alias set only grows), so
// this reaches the exact same least fixed point as recomputing every member every
// pass -- but in O(edges * lattice-height) analyses instead of O(members^2).
// Hitting the safety cap leaves each member at its current (still-sound, only
// more conservative) summary. Determinism: members and each round's dirty set are
// processed in ascending id order.
// run_scc threads a FixCache accumulator so the caller can collect reusable
// members' FixResults captured during the summary fixpoint.
type SccResult = .{ table: SummaryTable, cache: FixCache }

// compute_for_roots_cached returns the summary table plus the reuse cache built
// for the candidate roots. See docs/plans/performance/fixresult-reuse-design.md.
pub type SummaryCacheResult = .{ table: SummaryTable, fix_cache: FixCache }

fn run_scc(
  scc: Vector<Int>,
  index: Dict<Int, CfgFunction>,
  user_ids: Dict<Int, Bool>,
  table: SummaryTable,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
  cache_ids: Dict<Int, Bool>,
  cache_in: FixCache,
) SccResult {
  timed := timings_enabled()
  t0 := if timed {
    date.now()
  } else {
    0.0
  }
  members := scc.sort()
  scc_set := int_set(members)
  cache := cache_in
  callers := scc_callers(members, scc_set, index, user_ids)
  t_callers := if timed {
    date.now()
  } else {
    0.0
  }

  worklist := members // round 1: compute every member once
  cap := members.len() * 4 + 8 // safety net; the monotone fixpoint converges well within
  rounds := 0
  visits := 0
  changed_summaries := 0
  for worklist.len() > 0 and rounds < cap {
    next_dirty: Dict<Int, Bool> = Dict.new()
    for id in worklist {
      if timed {
        visits = visits + 1
      }
      f := case index.get(id) {
        .Some(fn0) => fn0,
        .None => error("summary: scc id ${id} not in index"),
      }
      res := summarize_function_cached(f, table, b, sem, scc_set)
      next := res.summary
      if res.reusable {
        case cache_ids.get(id) {
          .Some(true) => cache = fix_cache_put(cache, id, res.fx),
          _ => {},
        }
      }
      if !same_summary(table_get(table, id), next) {
        if timed {
          changed_summaries = changed_summaries + 1
        }
        table = table_put(table, id, next)
        case callers.get(id) {
          .Some(cs) => {
            for c in cs {
              next_dirty[c] = true
            }
          },
          .None => {},
        }
      }
    }
    nd: Vector<Int> = collect k in next_dirty.keys() {
      k
    }
    worklist = nd.sort()
    rounds = rounds + 1
  }

  // Non-convergence: the worklist still holds dirty members at the cap. ret_paths
  // are non-monotone, so a cap-time snapshot may be an over-claim; expose empty
  // ret_paths for every member (fully conservative). params/ret stay monotone and
  // remain sound at their current value.
  if worklist.len() > 0 {
    for id in members {
      case summary_get(table, id) {
        .Some(s) => table = table_put(
          table,
          id,
          Summary.{ params: s.params, ret: s.ret, ret_paths: [] },
        ),
        .None => {},
      }
    }
  }
  if timed {
    t_done := date.now()
    if t_done - t0 > 50.0 or rounds > 3 or worklist.len() > 0 {
      first := if members.len() > 0 {
        members[0]
      } else {
        0 - 1
      }
      eprintln(
        "[time:summary:scc] first=${first} members=${members.len()} total=${t_done - t0}ms callers=${t_callers
          - t0}ms solve=${t_done - t_callers}ms rounds=${rounds} visits=${visits} changed=${changed_summaries} remaining=${worklist.len()}",
      )
    }
  }
  SccResult.{ table, cache }
}

// ── Variant (ownership-specialized) summaries ───────────────────────
// A second, VariantId-keyed fixpoint layered over the generic one. It recovers
// the owned decision for a record threaded through a self/mutual-recursive call:
// the generic least-fixed-point pins such a parameter Published (the self-call
// publishes the not-yet-unique argument), so we seed a candidate owned variant
// OPTIMISTICALLY (param Consumed, return aliasing it), run the seeded analysis to
// a fixed point reading the same optimistic iterate at the recursive call, then
// VALIDATE and RETRACT any candidate that does not converge. Render-only: nothing
// in the build/codegen path calls compute_variants.
pub type VariantEntry = .{ variant: vid.VariantId, summary: Summary }

pub type VariantSummaryTable = .{
  by_key: Dict<String, VariantEntry>, // canonical key -> { variant, summary }
  by_func: Dict<Int, Vector<String>>, // func_id -> its canonical keys, sorted
}

pub fn empty_variant_table() VariantSummaryTable {
  VariantSummaryTable.{ by_key: Dict.new(), by_func: Dict.new() }
}

// Canonical identity of a variant (NOT site_key, which is a call-site pairing).
fn variant_memo_key(v: vid.VariantId) String {
  v.canonicalize_variant().variant_canonical_string()
}

// String analogue of insert_sorted: dedup + ascending.
fn insert_sorted_str(v: Vector<String>, s: String) Vector<String> {
  out: Vector<String> = []
  inserted := false
  for x in v {
    if x == s {
      return v
    }
    if !inserted and s < x {
      out = .append(s)
      inserted = true
    }
    out = .append(x)
  }
  if !inserted {
    out = .append(s)
  }
  out
}

fn vtable_put(t: VariantSummaryTable, v: vid.VariantId, s: Summary) VariantSummaryTable {
  key := variant_memo_key(v)
  t.by_key[key] = VariantEntry.{ variant: v.canonicalize_variant(), summary: s }
  prev := case t.by_func.get(v.func) {
    .Some(ks) => ks,
    .None => [],
  }
  t.by_func[v.func] = insert_sorted_str(prev, key)
  t
}

pub fn variant_get(t: VariantSummaryTable, v: vid.VariantId) VariantEntry? {
  t.by_key.get(variant_memo_key(v))
}

// EXACTLY k: the alias set is the single element [k]. `contains k` would be
// unsound -- the optimistic hypothesis rewrites the return to alias([k]), and
// Stage 4a only moves a return that aliases exactly one param.
fn ret_aliases_exactly_param(ret: ReturnEffect, k: Int) Bool {
  case ret {
    .MayAliasParams(idxs) => idxs.len() == 1 and idxs[0] == k,
    _ => false,
  }
}

fn atom_local_id(a: Atom) Int? {
  case a {
    .ALocal(l) => .Some(l.id),
    _ => .None,
  }
}

// Tracks which locals carry a param-derived value (whole-value `derived`) and,
// for transport-wrapper returns, which return FIELDS of a call result carry the
// param-derived value (`derived_fields`: result local -> set of field ids).
type InplaceScan = .{
  derived: Dict<Int, Bool>,
  derived_fields: Dict<Int, Dict<Int, Bool>>,
  found: Bool,
  changed: Bool,
}

fn derived_has(derived: Dict<Int, Bool>, id: Int) Bool {
  case derived.get(id) {
    .Some(v) => v,
    .None => false,
  }
}

fn atom_is_derived(derived: Dict<Int, Bool>, a: Atom) Bool {
  case atom_local_id(a) {
    .Some(id) => derived_has(derived, id),
    .None => false,
  }
}

fn mark_derived(st: InplaceScan, id: Int) InplaceScan {
  if !derived_has(st.derived, id) {
    st.derived[id] = true
    st.changed = true
  }
  st
}

fn mark_derived_field(st: InplaceScan, id: Int, field: Int) InplaceScan {
  inner := case st.derived_fields.get(id) {
    .Some(m) => m,
    .None => Dict.new(),
  }
  if !derived_has(inner, field) {
    inner[field] = true
    st.derived_fields[id] = inner
    st.changed = true
  }
  st
}

fn atom_has_derived_field(st: InplaceScan, a: Atom, field: Int) Bool {
  case atom_local_id(a) {
    .Some(id) => case st.derived_fields.get(id) {
      .Some(m) => derived_has(m, field),
      .None => false,
    },
    .None => false,
  }
}

// Carry any return-field facts of `a` onto `to_id` when a wrapper temporary is
// rebound before it is projected, so simple `t2 := t1` chains stay stable.
fn copy_derived_fields(st: InplaceScan, a: Atom, to_id: Int) InplaceScan {
  case atom_local_id(a) {
    .Some(from_id) => case st.derived_fields.get(from_id) {
      .Some(m) => {
        for field, v in m {
          if v {
            st = .mark_derived_field(to_id, field)
          }
        }
        st
      },
      .None => st,
    },
    .None => st,
  }
}

fn block_param_ids(f: CfgFunction, target_id: Int) Vector<Int> {
  for blk in f.blocks {
    if blk.id.id == target_id {
      return collect p in blk.params {
        p.id
      }
    }
  }
  []
}

fn propagate_edge_args(f: CfgFunction, target_id: Int, args: Vector<Atom>, st: InplaceScan) InplaceScan {
  params := block_param_ids(f, target_id)
  for a, i in args {
    if i < params.len() and atom_is_derived(st.derived, a) {
      st = .mark_derived(params[i])
    }
  }
  st
}

fn propagate_terminator(f: CfgFunction, term: Terminator, st: InplaceScan) InplaceScan {
  case term {
    .Branch(target, args) => propagate_edge_args(f, target.id, args, st),
    .CondBranch(_, then_target, then_args, else_target, else_args) => {
      st = propagate_edge_args(f, then_target.id, then_args, st)
      propagate_edge_args(f, else_target.id, else_args, st)
    },
    .Match(_, edges) => {
      for edge in edges {
        st = propagate_edge_args(f, edge.target.id, edge.args, st)
      }
      st
    },
    .LoopBackEdge(target, args) => propagate_edge_args(f, target.id, args, st),
    _ => st,
  }
}

// Transport-wrapper marking: a callee return path `ret_paths=.fN=from(pK)` says a
// fresh wrapper result carries the derived param pK in field N. Mark that field on
// the call result so a later `record_get result.fN` can thread it. Does NOT set
// `found` alone: the opportunity only matters once the field is actually projected.
fn mark_ret_path_field(
  st: InplaceScan,
  rp: ReturnPathOwn,
  args: Vector<Atom>,
  dst: Int,
  callee_params: Vector<ParamSummary>,
) InplaceScan {
  case rp.via {
    .Direct => case rp.field {
      .Some(fid) => case rp.own {
        .OwnedFromParam(k) => if k >= 0
          and k < args.len() and k < callee_params.len() and atom_is_derived(st.derived, args[k])
          and param_is_consumed(callee_params[k]) {
          st.mark_derived_field(dst, fid)
        } else {
          st
        },
        _ => st,
      },
      .None => st,
    },
    _ => st,
  }
}

fn param_is_consumed(ps: ParamSummary) Bool {
  case ps.base_role {
    .Consumed => true,
    _ => false,
  }
}

fn scan_inplace_op(op: AnfOp, dst: Int, st: InplaceScan, generic: SummaryTable) InplaceScan {
  case op {
    .AAssign(target, a) => {
      st = if atom_is_derived(st.derived, a) {
        st = .mark_derived(target.id)
        st.mark_derived(dst)
      } else {
        st
      }
      st = .copy_derived_fields(a, target.id)
      st.copy_derived_fields(a, dst)
    },
    .ARecordUpdate(base, _, _, _, _) => if atom_is_derived(st.derived, base) {
      st.found = true
      st.mark_derived(dst)
    } else {
      st
    },
    // A param-derived owned value arrived through a wrapper field (marked below by
    // ret_paths) and is now projected as a local value, so this function threads it.
    .ARecordGet(base, field, _) => if st.atom_has_derived_field(base, field.id) {
      st.found = true
      st.mark_derived(dst)
    } else {
      st
    },
    .ACall(callee, args) => case callee {
      .AGlobalFunc(fid) => case summary_get(generic, fid.id) {
        .Some(cs) => {
          // Delegated consume: the callee returns exactly the derived argument as
          // its sole alias (ret=alias(pK)), so threading the derived value through
          // this call is itself an in-place update site once the callee's owned
          // variant is selected. summary_get (never table_get): a global without a
          // user summary is ignored.
          hit := false
          for a, j in args {
            if atom_is_derived(st.derived, a) and ret_aliases_exactly_param(cs.ret, j) {
              hit = true
            }
          }
          st = if hit {
            st.found = true
            st.mark_derived(dst)
          } else {
            st
          }

          // Transport wrapper: mark a return field only when the callee CONSUMES the
          // ret-path source param (so the linkage is a consuming recovery, not a bare
          // field projection).
          for rp in cs.ret_paths {
            st = .mark_ret_path_field(rp, args, dst, cs.params)
          }
          st
        },
        .None => st,
      },
      _ => st,
    },
    .AInit(a) => {
      st = if atom_is_derived(st.derived, a) {
        st.mark_derived(dst)
      } else {
        st
      }
      st.copy_derived_fields(a, dst)
    },
    _ => st,
  }
}

type ThreadScan = .{ found: Bool, ret_derived: Bool }

// Scan param k's derived-value flow to a fixed point: does it reach an in-place
// update opportunity (`found` -- local update, delegated consume, or a projected
// wrapper field), and does the function RETURN a value derived from k
// (`ret_derived`)? Deliberately avoids ownership-gated dirty-path collection:
// recursive publishing can hide exactly the sites this pre-filter bootstraps.
fn scan_param_threading(f: CfgFunction, k: Int, generic: SummaryTable) ThreadScan {
  if k < 0 or k >= f.params.len() {
    return ThreadScan.{ found: false, ret_derived: false }
  }
  st := InplaceScan.{ derived: Dict.new(), derived_fields: Dict.new(), found: false, changed: true }
  st.derived[f.params[k].id] = true
  rounds := 0
  cap := f.blocks.len() * 16 + 128
  for st.changed and rounds < cap {
    st.changed = false
    for blk in f.blocks {
      for inst in blk.instructions {
        st = scan_inplace_op(inst.op, inst.anf_local.id, st, generic)
      }
      case blk.terminator {
        .Some(term) => st = propagate_terminator(f, term, st),
        .None => {},
      }
    }
    rounds = rounds + 1
  }
  ret_derived := false
  for blk in f.blocks {
    case blk.terminator {
      .Some(.Return(.Some(a))) => if atom_is_derived(st.derived, a) {
        ret_derived = true
      },
      _ => {},
    }
  }
  ThreadScan.{ found: st.found, ret_derived }
}

// A param that both threads to the return (either the generic summary aliases it,
// or the derived-flow scan reaches a return atom -- the transport-wrapper case
// where the generic ret is `shared`) AND has an in-place update opportunity is a
// candidate owned variant {(k, [])}. The seed is a hypothesis; run_scc_variants
// proves or retracts it. Determinism: functions ascending, params by index.
fn candidate_variants(view: CfgView, generic: SummaryTable) Vector<vid.VariantId> {
  cands: Vector<vid.VariantId> = []
  for f in view.functions {
    s := table_get(generic, f.func_id)
    for _ps, k in s.params {
      scan := scan_param_threading(f, k, generic)
      threads_to_return := ret_aliases_exactly_param(s.ret, k) or scan.ret_derived
      if scan.found and threads_to_return {
        v := vid.VariantId.{
          func: f.func_id,
          unique: [vid.UniqueReq.{ param: k, path: vid.shell() }],
        }
        cands = .append(v.canonicalize_variant())
      }
    }
  }
  cands
}

fn candidates_by_func(view: CfgView, generic: SummaryTable) Dict<Int, Vector<vid.VariantId>> {
  by_func: Dict<Int, Vector<vid.VariantId>> = Dict.new()
  for v in candidate_variants(view, generic) {
    prev := case by_func.get(v.func) {
      .Some(vs) => vs,
      .None => [],
    }
    by_func[v.func] = prev.append(v)
  }
  by_func
}

// The optimistic hypothesis summary for candidate key {(k, [])}: param k Consumed
// with a shell in-place path, return aliasing exactly k. Section 1 of a call then
// leaves the arg alone (.Consumed) and section 2 takes the Stage 4a move.
fn optimistic_hypothesis(gs: Summary, k: Int) Summary {
  params: Vector<ParamSummary> = collect ps, i in gs.params {
    if i == k {
      ParamSummary.{ base_role: .Consumed, in_place_paths: vid.shell_set(), flows_to_return: true }
    } else {
      ps
    }
  }
  Summary.{ params, ret: .MayAliasParams([k]), ret_paths: [] }
}

fn seed_param_of(v: vid.VariantId) Int {
  if v.unique.len() > 0 {
    v.unique[0].param
  } else {
    0 - 1
  }
}

// Build the published VariantId for member `func_id`, param `param`, from a set
// of in-place paths. The shell tier passes `shell_set()`; the full tier passes the
// converged summary's exact field paths (e.g. `{[], [f]}`).
fn variant_for_paths(func_id: Int, param: Int, paths: vid.PathSet) vid.VariantId {
  reqs: vid.UniqueKey = []
  for p in paths.paths {
    reqs = .append(vid.UniqueReq.{ param, path: p })
  }
  vid.canonicalize_variant(vid.VariantId.{ func: func_id, unique: reqs })
}

// Whether `ps` owns any path beyond the shell — i.e. a genuine (reference-typed)
// field-backing path that warrants a full-tier variant.
fn has_non_shell_path(ps: vid.PathSet) Bool {
  for p in ps.paths {
    if !p.is_shell() {
      return true
    }
  }
  false
}

// Shell-tier summary: identical to the converged summary except param `k`'s
// in-place paths collapse to the shell {[]}. A shell-tier caller proving only
// whole-record uniqueness must NOT inherit field-backing requirements, so the full
// `in_place_paths` are never attached to the shell key.
fn project_summary_to_shell(s: Summary, k: Int) Summary {
  params: Vector<ParamSummary> = collect ps, i in s.params {
    if i == k {
      ParamSummary.{
        base_role: ps.base_role,
        in_place_paths: vid.shell_set(),
        flows_to_return: ps.flows_to_return,
      }
    } else {
      ps
    }
  }
  s.params = params
  s
}

// A converged variant survives only if it still consumes param k in place AND
// still returns exactly alias([k]) -- an alias-forced publish fails the first,
// a widened return fails the second.
fn variant_valid(s: Summary, k: Int) Bool {
  param_ok := if k >= 0 and k < s.params.len() {
    !s.params[k].in_place_paths.is_empty()
  } else {
    false
  }
  param_ok and ret_aliases_exactly_param(s.ret, k)
}

// generic table with each in-SCC member's current variant iterate overlaid, so a
// recursive call resolves to the owned key. (One iterate per member -- exact for
// single-candidate functions like graph_scc.visit and the fixtures.)
fn build_overlay(generic: SummaryTable, member_iter: Dict<Int, Summary>) SummaryTable {
  overlay := generic
  for m, s in member_iter {
    overlay = table_put(overlay, m, s)
  }
  overlay
}

// One SCC's variant fixpoint with assume/validate/retract. Seeds each candidate
// member optimistically, runs a monotone worklist reading the overlay at recursive
// calls, then drops members whose converged summary failed validation and re-runs
// until the surviving set is stable (each pass only removes members -> terminates).
fn run_scc_variants(
  scc: Vector<Int>,
  index: Dict<Int, CfgFunction>,
  generic: SummaryTable,
  candidates: Dict<Int, Vector<vid.VariantId>>,
  vtable: VariantSummaryTable,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
) VariantSummaryTable {
  members := scc.sort()
  scc_set := int_set(members)

  // active member -> (candidate variant, seeded param k). MVP: one key per member.
  member_key: Dict<Int, vid.VariantId> = Dict.new()
  member_pidx: Dict<Int, Int> = Dict.new()
  for m in members {
    case candidates.get(m) {
      .Some(keys) => if keys.len() > 0 {
        v := keys[0]
        k := seed_param_of(v)
        if k >= 0 {
          member_key[m] = v
          member_pidx[m] = k
        }
      },
      .None => {},
    }
  }

  member_iter: Dict<Int, Summary> = Dict.new()
  stable := false
  cap_outer := members.len() + 2
  outer := 0
  for !stable and outer < cap_outer {
    if member_pidx.keys().len() == 0 {
      stable = true
    } else {
      // seed active members optimistically
      member_iter = Dict.new()
      for m, k in member_pidx {
        member_iter[m] = optimistic_hypothesis(table_get(generic, m), k)
      }

      // monotone worklist fixpoint (Gauss-Seidel: overlay reads live iterates)
      cap_inner := member_pidx.keys().len() * 8 + 8
      changed := true
      rounds := 0
      for changed and rounds < cap_inner {
        changed = false
        for m, k in member_pidx {
          f := case index.get(m) {
            .Some(fn0) => fn0,
            .None => error("variant: scc id ${m} not in index"),
          }
          key := case member_key.get(m) {
            .Some(v) => v.unique,
            .None => [],
          }
          overlay := build_overlay(generic, member_iter)
          resolve := vtable.make_outscc_resolver(scc_set)
          require := vtable.make_outscc_requirement_resolver(scc_set)
          next := summarize_variant_resolved(f, key, overlay, b, sem, scc_set, resolve, require)
          prev := case member_iter.get(m) {
            .Some(s) => s,
            .None => optimistic_hypothesis(table_get(generic, m), k),
          }
          if !same_summary(next, prev) {
            member_iter[m] = next
            changed = true
          }
        }
        rounds = rounds + 1
      }

      if changed {
        // The iterate started optimistic; a cap-time snapshot is not conservative.
        member_pidx = Dict.new()
        member_key = Dict.new()
        stable = true
      } else {
        // validate; retract failures and re-run, else stable
        failed: Vector<Int> = []
        for m, k in member_pidx {
          conv := case member_iter.get(m) {
            .Some(s) => s,
            .None => optimistic_hypothesis(table_get(generic, m), k),
          }
          if !variant_valid(conv, k) {
            failed = .append(m)
          }
        }
        if failed.len() == 0 {
          stable = true
        } else {
          for m in failed {
            member_pidx = .remove(m)
            member_key = .remove(m)
          }
        }
      }
    }
    outer = outer + 1
  }

  // publish survivors: shell tier always (projected to shell-only paths, preserves
  // 8G record-shell reuse that composes through delegation), plus a full tier when a
  // reference-typed field path survived the converged summary.
  for m, v in member_key {
    case member_iter.get(m) {
      .Some(s) => {
        k := seed_param_of(v)
        if variant_valid(s, k) {
          shell_v := variant_for_paths(m, k, vid.shell_set())
          vtable = .vtable_put(shell_v, project_summary_to_shell(s, k))
          full_paths := s.params[k].in_place_paths
          if has_non_shell_path(full_paths) {
            vtable = .vtable_put(variant_for_paths(m, k, full_paths), s)
          }
        }
      },
      .None => {},
    }
  }
  vtable
}

// Whole-program variant summaries: candidates from the generic table, fixed-pointed
// per SCC in the same callee-first order. Leaves the generic table untouched.
pub fn compute_variants(
  view: CfgView,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
  generic: SummaryTable,
) VariantSummaryTable {
  index := build_func_index(view)
  user_ids := user_id_set(view)
  candidates := candidates_by_func(view, generic)
  vtable := empty_variant_table()
  for scc in order_sccs(view, index, user_ids) {
    vtable = run_scc_variants(scc, index, generic, candidates, vtable, b, sem)
  }
  vtable
}

fn func_scc_ids(sccs: Vector<Vector<Int>>) Dict<Int, Int> {
  ids: Dict<Int, Int> = Dict.new()
  for scc, sid in sccs {
    for f in scc {
      ids[f] = sid
    }
  }
  ids
}

fn scc_id_of(ids: Dict<Int, Int>, func_id: Int) Int {
  case ids.get(func_id) {
    .Some(id) => id,
    .None => 0 - 1,
  }
}

fn scc_set_for(sccs: Vector<Vector<Int>>, ids: Dict<Int, Int>, func_id: Int) Dict<Int, Bool> {
  sid := scc_id_of(ids, func_id)
  if sid >= 0 and sid < sccs.len() {
    int_set(sccs[sid])
  } else {
    Dict.new()
  }
}

// Convert a shell-only `arg_unique` vector to path sets: a Unique+last-use arg
// proves the shell path {[]}; a non-unique arg proves nothing {}.
fn arg_unique_to_paths(arg_unique: Vector<Bool>) Vector<vid.PathSet> {
  collect u in arg_unique {
    if u {
      vid.shell_set()
    } else {
      vid.empty_set()
    }
  }
}

// Whether every unique requirement of `v` is proven by `arg_paths`: the required
// param is in range and its proven path set contains the required path.
fn variant_paths_satisfied(v: vid.VariantId, arg_paths: Vector<vid.PathSet>) Bool {
  if v.unique.len() == 0 {
    return false
  }
  for req in v.unique {
    if req.param < 0 or req.param >= arg_paths.len() {
      return false
    }
    if !arg_paths[req.param].contains(req.path) {
      return false
    }
  }
  true
}

// Shell-only compatibility wrapper: `true` proves {[]}, `false` proves {}.
fn variant_args_satisfied(v: vid.VariantId, arg_unique: Vector<Bool>) Bool {
  variant_paths_satisfied(v, arg_unique_to_paths(arg_unique))
}

// A variant's specificity: more/deeper unique requirements outrank fewer/shallower
// ones, so at a call site whose args satisfy several variants we select the most
// demanding one it earns.
fn variant_specificity(v: vid.VariantId) Int {
  score := 0
  for req in v.unique {
    score = score + 1 + req.path.segs.len()
  }
  score
}

// The best owned variant summary for `callee_id` whose unique requirements are all
// satisfied by this call site's proven argument paths, or `.None` to fall back to
// generic. Ties break on higher specificity, then lexicographically smallest key
// for determinism.
fn variant_summary_for(vtable: VariantSummaryTable, callee_id: Int, arg_paths: Vector<vid.PathSet>) Summary? {
  best_key := ""
  best_score := 0 - 1
  best: Summary? = .None
  case vtable.by_func.get(callee_id) {
    .Some(keys) => {
      for key in keys {
        case vtable.by_key.get(key) {
          .Some(entry) => if variant_paths_satisfied(entry.variant, arg_paths) {
            score := variant_specificity(entry.variant)
            if score > best_score or score == best_score and (best_key.len() == 0 or key < best_key) {
              best_key = key
              best_score = score
              best = .Some(entry.summary)
            }
          },
          .None => {},
        }
      }
      best
    },
    .None => .None,
  }
}

// Phase 8G public façade: codegen selects/enumerates published variants and
// builds owned entry seeds through these wrappers, so `variant_specialize.tw`
// never depends on the private selection internals below.
// Every published (validated) VariantId in the table, in by_func iteration order.
pub fn variant_ids_of(vt: VariantSummaryTable) Vector<vid.VariantId> {
  out: Vector<vid.VariantId> = []
  for _fid, keys in vt.by_func {
    for k in keys {
      case vt.by_key.get(k) {
        .Some(e) => out = .append(e.variant),
        .None => {},
      }
    }
  }
  out
}

// The most-specific published variant of `callee_id` whose exact field-path
// requirements are all proven by `arg_paths`, or `.None`. Ties break on higher
// specificity, then lexicographically smallest key for determinism.
pub fn select_variant_for_arg_paths(
  vt: VariantSummaryTable,
  callee_id: Int,
  arg_paths: Vector<vid.PathSet>,
) vid.VariantId? {
  best: vid.VariantId? = .None
  best_spec := 0 - 1
  best_key := ""
  case vt.by_func.get(callee_id) {
    .Some(keys) => {
      for k in keys {
        case vt.by_key.get(k) {
          .Some(e) => if variant_paths_satisfied(e.variant, arg_paths) {
            sp := variant_specificity(e.variant)
            if sp > best_spec or sp == best_spec and (best_key.len() == 0 or k < best_key) {
              best_spec = sp
              best_key = k
              best = .Some(e.variant)
            }
          },
          .None => {},
        }
      }
    },
    .None => {},
  }
  best
}

// Shell-only compatibility wrapper over `select_variant_for_arg_paths`: `true`
// proves {[]}, `false` proves {}.
pub fn select_variant_for_args(vt: VariantSummaryTable, callee_id: Int, arg_unique: Vector<Bool>) vid.VariantId? {
  vt.select_variant_for_arg_paths(callee_id, arg_unique_to_paths(arg_unique))
}

// The param-local -> seed-Unique map that certifies variant `v`'s owned params at
// entry of function `f`.
pub fn seed_for_variant(f: CfgFunction, v: vid.VariantId) Dict<Int, Bool> {
  unique_seed_for_variant(f, v)
}

// Resolver selecting any satisfied validated variant from `vtable`.
fn make_variant_resolver(vtable: VariantSummaryTable) VariantResolver {
  fn(callee_id: Int, arg_paths: Vector<vid.PathSet>) Summary? { vtable.variant_summary_for(
    callee_id,
    arg_paths,
  ) }
}

fn variant_only_requires_carrier(v: vid.VariantId, carrier: Int) Bool {
  if v.unique.len() == 0 {
    return false
  }
  has_shell := false
  for req in v.unique {
    if req.param != carrier {
      return false
    }
    if req.path.is_shell() {
      has_shell = true
    }
  }
  has_shell
}

// Requirement resolver: field-requirement discovery is asking what a delegating
// wrapper must itself require, not what a concrete call site has already proven.
// Therefore it may read the strongest single-carrier published variant without
// treating that as a real selection decision.
fn variant_requirement_summary_for(vtable: VariantSummaryTable, callee_id: Int, carrier: Int) Summary? {
  best_key := ""
  best_score := 0 - 1
  best: Summary? = .None
  case vtable.by_func.get(callee_id) {
    .Some(keys) => {
      for key in keys {
        case vtable.by_key.get(key) {
          .Some(entry) => if variant_only_requires_carrier(entry.variant, carrier) {
            score := variant_specificity(entry.variant)
            if score > best_score or score == best_score and (best_key.len() == 0 or key < best_key) {
              best_key = key
              best_score = score
              best = .Some(entry.summary)
            }
          },
          .None => {},
        }
      }
      best
    },
    .None => .None,
  }
}

fn make_variant_requirement_resolver(vtable: VariantSummaryTable) VariantRequirementResolver {
  fn(callee_id: Int, carrier: Int) Summary? { vtable.variant_requirement_summary_for(
    callee_id,
    carrier,
  ) }
}

// Validation-time resolver: in-SCC callees fall back to generic (their iterate is
// read from the member-iterate overlay, not from `vtable`); out-of-SCC callees may
// select already-validated variants from earlier SCCs, which is what lets owned
// threading compose past one delegation hop.
fn make_outscc_resolver(vtable: VariantSummaryTable, scc_set: Dict<Int, Bool>) VariantResolver {
  fn(callee_id: Int, arg_paths: Vector<vid.PathSet>) Summary? {
    if in_set(scc_set, callee_id) {
      .None
    } else {
      vtable.variant_summary_for(callee_id, arg_paths)
    }
  }
}

fn make_outscc_requirement_resolver(vtable: VariantSummaryTable, scc_set: Dict<Int, Bool>) VariantRequirementResolver {
  fn(callee_id: Int, carrier: Int) Summary? {
    if in_set(scc_set, callee_id) {
      .None
    } else {
      vtable.variant_requirement_summary_for(callee_id, carrier)
    }
  }
}

// Render/analysis-time resolver over the whole converged variant table.
pub fn make_variant_resolver_for_render(vtable: VariantSummaryTable) VariantResolver {
  vtable.make_variant_resolver()
}

pub fn make_variant_requirement_resolver_for_render(vtable: VariantSummaryTable) VariantRequirementResolver {
  vtable.make_variant_requirement_resolver()
}

type ReachState = .{ reachable: Dict<String, Bool>, changed: Bool }

fn reach_has(reachable: Dict<String, Bool>, key: String) Bool {
  case reachable.get(key) {
    .Some(v) => v,
    .None => false,
  }
}

fn mark_reachable(st: ReachState, key: String) ReachState {
  if !reach_has(st.reachable, key) {
    st.reachable[key] = true
    st.changed = true
  }
  st
}

fn mark_site_variants(
  variants: VariantSummaryTable,
  callee: Int,
  arg_paths: Vector<vid.PathSet>,
  st: ReachState,
) ReachState {
  case variants.by_func.get(callee) {
    .Some(keys) => {
      for key in keys {
        case variants.by_key.get(key) {
          .Some(entry) => if variant_paths_satisfied(entry.variant, arg_paths) {
            st = .mark_reachable(key)
          },
          .None => {},
        }
      }
      st
    },
    .None => st,
  }
}

fn unique_seed_for_variant(f: CfgFunction, v: vid.VariantId) Dict<Int, Bool> {
  seed: Dict<Int, Bool> = Dict.new()
  for req in v.unique {
    if req.path.is_shell() and req.param >= 0 and req.param < f.params.len() {
      seed[f.params[req.param].id] = true
    }
  }
  seed
}

fn render_variant_key(v: vid.VariantId) String {
  reqs: Vector<String> = collect r in v.unique {
    if r.path.is_shell() {
      "p${r.param}"
    } else if r.path.segs.len() > 0 {
      "p${r.param}.f${r.path.segs[0]}"
    } else {
      "p${r.param}"
    }
  }
  "unique:${reqs.join(",")}"
}

fn canonical_reachable_key(
  variants: VariantSummaryTable,
  reachable: Dict<String, Bool>,
  func_id: Int,
) String? {
  case variants.by_func.get(func_id) {
    .Some(keys) => {
      for key in keys {
        if reach_has(reachable, key) {
          return .Some(key)
        }
      }
      .None
    },
    .None => .None,
  }
}

fn reachable_overlay(
  generic: SummaryTable,
  variants: VariantSummaryTable,
  reachable: Dict<String, Bool>,
) SummaryTable {
  overlay := generic
  for func_id, _keys in variants.by_func {
    case variants.canonical_reachable_key(reachable, func_id) {
      .Some(key) => case variants.by_key.get(key) {
        .Some(entry) => overlay = table_put(overlay, func_id, entry.summary),
        .None => {},
      },
      .None => {},
    }
  }
  overlay
}

fn all_variant_overlay(generic: SummaryTable, variants: VariantSummaryTable) SummaryTable {
  overlay := generic
  for func_id, keys in variants.by_func {
    if keys.len() > 0 {
      case variants.by_key.get(keys[0]) {
        .Some(entry) => overlay = table_put(overlay, func_id, entry.summary),
        .None => {},
      }
    }
  }
  overlay
}

fn reachable_variants(
  view: CfgView,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
  generic: SummaryTable,
  variants: VariantSummaryTable,
) Dict<String, Bool> {
  index := build_func_index(view)
  user_ids := user_id_set(view)
  sccs := order_sccs(view, index, user_ids)
  scc_ids := func_scc_ids(sccs)
  st := ReachState.{ reachable: Dict.new(), changed: false }

  // Roots: only out-of-SCC callers can discharge a callee's variant. Scan them
  // against the converged variant overlay so loop-carried fresh state in an
  // external caller can remain unique across a call that the generic summary pins.
  root_overlay := all_variant_overlay(generic, variants)
  for f in view.functions {
    caller_scc := scc_id_of(scc_ids, f.func_id)
    suppress := scc_set_for(sccs, scc_ids, f.func_id)
    sites := call_uniques_sited(f, root_overlay, b, sem, suppress, Dict.new())
    for site in sites {
      callee_scc := scc_id_of(scc_ids, site.callee)
      if caller_scc != callee_scc {
        st = variants.mark_site_variants(site.callee, site.arg_paths, st)
      }
    }
  }

  // Variant graph fixed point: rebuild overlay from the growing reachable set and
  // rescan currently reachable canonical variants until no new keys appear.
  again := true
  passes := 0
  cap := variants.by_key.keys().len() + 2
  for again and passes < cap {
    st.changed = false
    overlay := reachable_overlay(generic, variants, st.reachable)
    for f in view.functions {
      case variants.canonical_reachable_key(st.reachable, f.func_id) {
        .Some(key) => case variants.by_key.get(key) {
          .Some(entry) => {
            seed := unique_seed_for_variant(f, entry.variant)
            suppress := scc_set_for(sccs, scc_ids, f.func_id)
            sites := call_uniques_sited(f, overlay, b, sem, suppress, seed)
            for site in sites {
              st = variants.mark_site_variants(site.callee, site.arg_paths, st)
            }
          },
          .None => {},
        },
        .None => {},
      }
    }
    again = st.changed
    passes = passes + 1
  }
  st.reachable
}

// Test hook: the canonical variant keys `reachable_variants` marks reachable, so
// tests can assert field-path variants stay visible to cfg rendering inputs.
pub fn reachable_variant_keys_for_test(
  view: CfgView,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
  generic: SummaryTable,
  variants: VariantSummaryTable,
) Vector<String> {
  reachable_variants(view, b, sem, generic, variants).keys()
}

fn function_by_id(view: CfgView, func_id: Int) CfgFunction? {
  for f in view.functions {
    if f.func_id == func_id {
      return .Some(f)
    }
  }
  .None
}

// ── Rendering ───────────────────────────────────────────────────────
// One-line, human-readable form of a Summary for the `twk ir --cfg` header.
fn render_ret_paths(rps: Vector<ReturnPathOwn>) String {
  parts: Vector<String> = []
  for r in sort_ret_paths(rps) {
    via := case r.via {
      .Direct => "",
      .Variant(t, i) => "V${t}[${i}]",
    }
    fld := case r.field {
      .Some(f) => ".f${f}",
      .None => "",
    }
    own := case r.own {
      .OwnedFresh => "fresh",
      .OwnedFromParam(k) => "from(p${k})",
    }
    parts = .append("${via}${fld}=${own}")
  }
  if parts.len() == 0 {
    ""
  } else {
    "  ret_paths=${parts.join(" ")}"
  }
}

// Renders a parameter in-place path: [] (shell) or [.f0,.f1] (field chain). The
// field-chain arm is only reached once Phase 6 Part 2 populates in_place_paths;
// in Part 1 every path is the shell [].
fn render_param_path(p: vid.ParamPath) String {
  if p.is_shell() {
    "[]"
  } else {
    segs: Vector<String> = collect s in p.segs {
      ".f${s}"
    }
    "[${segs.join(",")}]"
  }
}

fn render_role(r: ParamRole) String {
  case r {
    .Borrowed => "Borrowed",
    .Consumed => "Consumed",
    .Published => "Published",
  }
}

fn render_summary_body(s: Summary) String {
  parts: Vector<String> = []
  for ps, i in s.params {
    paths := if !ps.in_place_paths.is_empty() {
      rendered: Vector<String> = collect p in ps.in_place_paths.paths {
        render_param_path(p)
      }
      " paths{${rendered.join(",")}}"
    } else {
      ""
    }
    parts = .append("p${i}=${render_role(ps.base_role)}${paths}")
  }
  ret := case s.ret {
    .OwnedFresh => "fresh",
    .Shared => "shared",
    .MayAliasParams(idxs) => {
      ps := collect k in idxs {
        "p${k}"
      }
      "alias(${ps.join(",")})"
    },
  }
  "${parts.join(" ")} ret=${ret}${render_ret_paths(s.ret_paths)}"
}

pub fn render_summary(s: Summary) String {
  "summary: ${render_summary_body(s)}"
}

fn variant_sections(
  source: CfgView,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
  generic: SummaryTable,
  variants: VariantSummaryTable,
  reachable: Dict<String, Bool>,
) String {
  overlay := reachable_overlay(generic, variants, reachable)
  resolve := variants.make_variant_resolver_for_render()
  out := ""
  for f in source.functions {
    case variants.canonical_reachable_key(reachable, f.func_id) {
      .Some(key) => case variants.by_key.get(key) {
        .Some(entry) => {
          seed := unique_seed_for_variant(f, entry.variant)
          analyzed := analyze_function_with_seed_resolved(f, overlay, b, sem, seed, resolve)
          title := "variant fn ${f.name} [${render_variant_key(entry.variant)}]"
          header := "variant: ${render_summary_body(entry.summary)}"
          out = "${out}${analyzed.render_function_with_header(title, header)}"
        },
        .None => {},
      },
      .None => {},
    }
  }
  out
}

// Render the generic `--cfg` view with generic summaries, then append reachable
// variant-qualified diagnostic bodies. Generic function bodies are never re-
// analyzed under a variant seed.
pub fn render_cfg(
  source: CfgView,
  generic_analyzed: CfgView,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
  table: SummaryTable,
  variants: VariantSummaryTable,
) String {
  headers: Dict<Int, String> = Dict.new()
  for f in generic_analyzed.functions {
    case summary_get(table, f.func_id) {
      .Some(s) => headers[f.func_id] = render_summary(s),
      .None => {},
    }
  }
  generic_out := generic_analyzed.render_view_with_headers(headers)
  reachable := reachable_variants(source, b, sem, table, variants)
  "${generic_out}${variant_sections(source, b, sem, table, variants, reachable)}"
}

// ── Driver ──────────────────────────────────────────────────────────
pub fn compute(view: CfgView, b: BuiltinRegistry, sem: OptimizerSemantics) SummaryTable {
  index := build_func_index(view)
  user_ids := user_id_set(view)

  // Seed every function conservatively so the first pass is sound before callees
  // are known.
  table := empty_summary_table()
  for f in view.functions {
    table = table_put(table, f.func_id, conservative_summary(f))
  }

  no_cache_ids: Dict<Int, Bool> = Dict.new()
  cache := empty_fix_cache()
  for scc in order_sccs(view, index, user_ids) {
    r := run_scc(scc, index, user_ids, table, b, sem, no_cache_ids, cache)
    table = r.table
    cache = r.cache
  }
  table = with_dedupe_helpers(table, view, b, sem)
  table
}

// Transitive user-callee closure of `roots` (root ids included). Used to scope
// summary/ownership work to the functions a mutable candidate could actually
// depend on. Deterministic: the worklist is kept sorted so closure order does
// not vary run to run.
pub fn dependency_closure(view: CfgView, roots: Dict<Int, Bool>) Dict<Int, Bool> {
  index := build_func_index(view)
  user_ids := user_id_set(view)
  closed: Dict<Int, Bool> = Dict.new()
  work: Vector<Int> = collect id in roots.keys() {
    id
  }
  work = .sort()

  for work.len() > 0 {
    id := work[0]
    next_work: Vector<Int> = []
    for item, i in work {
      if i > 0 {
        next_work = .append(item)
      }
    }
    work = next_work

    already := case closed.get(id) {
      .Some(v) => v,
      .None => false,
    }
    if !already {
      closed[id] = true
      case index.get(id) {
        .Some(f) => {
          for callee in callee_ids(f, user_ids) {
            seen := case closed.get(callee) {
              .Some(v) => v,
              .None => false,
            }
            if !seen {
              work = .append(callee)
            }
          }
          work = .sort()
        },
        .None => {},
      }
    }
  }

  closed
}

// Summaries scoped to the dependency closure of `roots`. Functions outside the
// closure keep their conservative seed summary — that can only make a caller's
// verdicts less precise (forcing persistent fallback), never fabricate a
// mutable decision. SCCs that touch the closure are analyzed exactly as
// `compute` would; SCCs entirely outside it are skipped.
pub fn compute_for_roots(
  view: CfgView,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
  roots: Dict<Int, Bool>,
) SummaryTable {
  compute_for_roots_cached(view, b, sem, roots).table
}

pub fn compute_for_roots_cached(
  view: CfgView,
  b: BuiltinRegistry,
  sem: OptimizerSemantics,
  roots: Dict<Int, Bool>,
) SummaryCacheResult {
  timed := timings_enabled()
  t0 := if timed {
    date.now()
  } else {
    0.0
  }
  index := build_func_index(view)
  user_ids := user_id_set(view)
  t_index := if timed {
    date.now()
  } else {
    0.0
  }
  wanted := dependency_closure(view, roots)
  t_closure := if timed {
    date.now()
  } else {
    0.0
  }

  table := empty_summary_table()
  wanted_blocks := 0
  wanted_insts := 0
  wanted_edges := 0
  for f in view.functions {
    case wanted.get(f.func_id) {
      .Some(true) => {
        wanted_blocks = wanted_blocks + f.blocks.len()
        for blk in f.blocks {
          wanted_insts = wanted_insts + blk.instructions.len()
          wanted_edges = wanted_edges + blk.succs.len()
        }
      },
      _ => {},
    }
    table = table_put(table, f.func_id, conservative_summary(f))
  }
  t_seed := if timed {
    date.now()
  } else {
    0.0
  }

  cache := empty_fix_cache()
  sccs := order_sccs(view, index, user_ids)
  t_order := if timed {
    date.now()
  } else {
    0.0
  }
  run_sccs := 0
  skipped_sccs := 0
  run_members := 0
  skipped_members := 0
  for scc in sccs {
    run := false
    for id in scc {
      case wanted.get(id) {
        .Some(true) => run = true,
        _ => {},
      }
    }
    if run {
      run_sccs = run_sccs + 1
      run_members = run_members + scc.len()
      r := run_scc(scc, index, user_ids, table, b, sem, roots, cache)
      table = r.table
      cache = r.cache
    } else {
      skipped_sccs = skipped_sccs + 1
      skipped_members = skipped_members + scc.len()
    }
  }
  if timed {
    t_done := date.now()
    eprintln(
      "[time:summary:roots] total=${t_done - t0}ms index=${t_index - t0}ms closure=${t_closure
        - t_index}ms seed=${t_seed - t_closure}ms order=${t_order - t_seed}ms run=${t_done - t_order}ms funcs=${view.functions.len()} roots=${roots
        .keys()
        .len()} wanted=${wanted.keys().len()} wanted_blocks=${wanted_blocks} wanted_insts=${wanted_insts} wanted_edges=${wanted_edges} sccs=${sccs.len()} run_sccs=${run_sccs} skipped_sccs=${skipped_sccs} run_members=${run_members} skipped_members=${skipped_members}",
    )
  }
  table = with_dedupe_helpers(table, view, b, sem)
  SummaryCacheResult.{ table, fix_cache: cache }
}
