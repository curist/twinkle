use compiler.codegen.wasm_ir.{ValType}
use compiler.mono_type.{MonoType}

// Physically-typed vector element family. Pure: no BuiltinRegistry. `*_call` are
// runtime function symbols the emitter calls directly (index fast path, box/unbox
// coercions, bridge, equality). Builtin ids for the router live in FamilyIds
// (route_typed_vec.tw), which the emitter does not need.
pub type ElemFamily = .{
  mono_key: String, // "vec_i64" / "vec_bool" — FamilyTag
  suffix: String, // builtin-name suffix, e.g. "_i64"
  pvec_type: String, // "rt_types__PVecI64"
  elem_wasm: ValType, // .I64 / .I32
  get_call: String, // "rt_arr__get_i64"
  make_call: String, // "rt_arr__make_i64"
  box_call: String, // "rt_arr__box_i64"
  unbox_call: String, // "rt_arr__unbox_i64"
}

pub fn all_families() Vector<ElemFamily> {
  [family_i64(), family_bool(), family_float(), family_byte()]
}

fn family_i64() ElemFamily {
  .{
    mono_key: "vec_i64",
    suffix: "_i64",
    pvec_type: "rt_types__PVecI64",
    elem_wasm: .I64,
    get_call: "rt_arr__get_i64",
    make_call: "rt_arr__make_i64",
    box_call: "rt_arr__box_i64",
    unbox_call: "rt_arr__unbox_i64",
  }
}

fn family_bool() ElemFamily {
  .{
    mono_key: "vec_bool",
    suffix: "_bool",
    pvec_type: "rt_types__PVecBool",
    elem_wasm: .I32,
    get_call: "rt_arr__get_bool",
    make_call: "rt_arr__make_bool",
    box_call: "rt_arr__box_bool",
    unbox_call: "rt_arr__unbox_bool",
  }
}

fn family_float() ElemFamily {
  .{
    mono_key: "vec_f64",
    suffix: "_f64",
    pvec_type: "rt_types__PVecF64",
    elem_wasm: .F64,
    get_call: "rt_arr__get_f64",
    make_call: "rt_arr__make_f64",
    box_call: "rt_arr__box_f64",
    unbox_call: "rt_arr__unbox_f64",
  }
}

// Byte reads into an i32 (packed array.get_u), same elem_wasm as bool; the two
// are told apart downstream via mono_key ("vec_byte"), see candidate_typed_vec_family.
fn family_byte() ElemFamily {
  .{
    mono_key: "vec_byte",
    suffix: "_byte",
    pvec_type: "rt_types__PVecByte",
    elem_wasm: .I32,
    get_call: "rt_arr__get_byte",
    make_call: "rt_arr__make_byte",
    box_call: "rt_arr__box_byte",
    unbox_call: "rt_arr__unbox_byte",
  }
}

pub fn family_by_pvec_name(name: String) ElemFamily? {
  for f in all_families() {
    if f.pvec_type == name {
      return .Some(f)
    }
  }

  .None
}

pub fn pvec_family_of(vt: ValType) ElemFamily? {
  case vt {
    .Ref(_, .Named(name)) => family_by_pvec_name(name),
    _ => .None,
  }
}

// The single family selector. Replaces the scattered is_int_vector / mono_key_of.
pub fn elem_family_of(mono: MonoType) ElemFamily? {
  key := case mono {
    .Vector(.Int) => "vec_i64",
    .Vector(.Bool) => "vec_bool",
    .Vector(.Float) => "vec_f64",
    .Vector(.Byte) => "vec_byte",
    _ => "other",
  }

  for f in all_families() {
    if f.mono_key == key {
      return .Some(f)
    }
  }

  .None
}

// Families with MutVec runtime ops registered — the single source of truth for
// which owned vectors the region pass can claim into flat mutable storage. A
// strict subset of all_families (typed reads exist for more families than have
// mutvec write ops). Widen as each family's mutvec_* ops land.
pub fn mutvec_families() Vector<ElemFamily> {
  [family_i64(), family_bool(), family_float(), family_byte()]
}

// The mutvec-claimable builtin-name suffix for a vector element MonoType, or
// `.None` when no MutVec ops are registered for it. This is the ONE decision
// point the region detector and the repr handoff share: given a handle's element
// MonoType it yields the family suffix (`"_i64"`) used to resolve `mutvec_*`
// builtin ids per region. Phase 3/4 widen the claim set purely by extending
// `mutvec_families`.
pub fn elem_family_suffix(mono: MonoType) String? {
  case elem_family_of(mono) {
    .Some(f) => {
      for m in mutvec_families() {
        if m.mono_key == f.mono_key {
          return .Some(f.suffix)
        }
      }

      .None
    },
    .None => .None,
  }
}
