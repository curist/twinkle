//! Math constants and the pseudorandom generator.
//!
//! The number-theory helpers (`sign`, `gcd`, `lcm`, `pow`, `sqrt`) now live on
//! `Int` in the prelude, and the trigonometric / exponential / logarithmic
//! helpers live on `Float`; call them as inherent methods (`n.gcd(m)`,
//! `x.sin()`). The native `f64` operations (`abs`, `sqrt`, `floor`, `ceil`,
//! `trunc`, `round`, `min`, `max`) are prelude methods on `Float` too. This
//! module keeps only the pieces that have no natural receiver: the constants
//! and `random`. Constants are exported as lowercase Twinkle values because
//! value identifiers are snake_case.

/// Host `Math` object (globalThis.Math under the JS/Deno runner).
extern Math fn random() Float

pub e := 2.718281828459045
pub pi := 3.141592653589793

/// Pseudorandom number in [0, 1) (host `Math.random`).
pub fn random() Float {
  Math.random()
}
