//! IR command: compile and print IR stages.

use @std.proc

use commands.common.{exit_usage_error, format_compile_error, get_positional, print_warnings}
use compiler.artifacts.{PipelineArtifacts}
use compiler.backend.closure_convert.{convert_closures}
use compiler.backend.prepare.{prepare_backend_with_mutable_config}
use compiler.builder_region_detect as detect
use compiler.builder_region_fact as region_fact
use compiler.census
use compiler.codegen.builder_region
use compiler.codegen.builder_region_produce
use compiler.codegen.dry_run
use compiler.codegen.mutable_audit
use compiler.codegen.mutable_produce
use compiler.codegen.mutable_select
use compiler.codegen.ownership_verdicts
use compiler.ir_print
use compiler.opt.semantics as semantics
use compiler.pipeline
use compiler.summary
use lib.argparse.app.{ParseResult}

fn has_any_ir_flag(parsed: ParseResult) Bool {
  parsed.has_flag("core")
    or parsed.has_flag("mono")
    or parsed.has_flag("anf")
    or parsed.has_flag("opt")
    or parsed.has_flag("wat")
    or parsed.has_flag("all")
}

fn should_show_ir(parsed: ParseResult, name: String) Bool {
  if parsed.has_flag("all") {
    return true
  }

  if has_any_ir_flag(parsed) {
    return parsed.has_flag(name)
  }

  name == "opt"
}

fn print_ir_stage(title: String, body: String, first: Bool) Bool {
  if !first {
    println("")
  }

  println(
    "// ── ${title} ─────────────────────────────────────────────────────────",
  )
  print(body)
  false
}

fn render_cfg_artifacts(artifacts: PipelineArtifacts) String {
  b := artifacts.builtins
  s := semantics.make_prelude_optimizer_semantics(b)
  owned := ownership_verdicts.compute_artifacts(artifacts.opt, b, s)
  variants := summary.compute_variants(owned.view, b, s, owned.table)
  summary.render_cfg(owned.view, owned.analyzed, b, s, owned.table, variants)
}

/// The certified-candidate keys still present in a (post-rewrite) module — i.e.
/// regions whose fold was NOT replaced. Used to tell "actually rewritten" from
/// "merely produced": a consumed region disappears from detection after the
/// rewrite, an abandoned one still detects its concat/append fold.
fn collect_certified_keys(cands: Vector<detect.RegionCandidate>) Vector<detect.BuilderRegionKey> {
  out: Vector<detect.BuilderRegionKey> = []
  for c in cands {
    if c.structural_ok {
      out = .append(c.region_key())
    }
  }
  out
}

fn key_in(keys: Vector<detect.BuilderRegionKey>, key: detect.BuilderRegionKey) Bool {
  for k in keys {
    case builder_region_produce.key_cmp(k, key) {
      .Eq => return true,
      _ => {},
    }
  }
  false
}

/// Render the builder-region candidate table: one row per certified or
/// rejected candidate, with its full key, helper sequence, and proof id. The
/// `consumed` column reports whether the rewrite ACTUALLY applied — a certified
/// region is consumed iff it no longer detects as a candidate after
/// `rewrite_module` (its fold was replaced by a builder call). A produced-but-
/// splice-abandoned region still detects its fold, so it reads "no"; rejected
/// candidates read "-".
fn render_region_rows(
  vs: Vector<region_fact.RegionVerdict>,
  post_keys: Vector<detect.BuilderRegionKey>,
) String {
  out := "\nbuilder regions:\nfunc\tfamily\tlinearly_folded\tconsumed\tkey\thelpers\tproof\treason\n"
  for v in vs {
    fs := "["
    for id, i in v.key.fold_sites {
      fs = .concat(
        if i > 0 {
          ",${id}"
        } else {
          "${id}"
        },
      )
    }
    fs = .concat("]")
    key := "fn${v.key.func_id} seed L${v.key.seed_site} loop L${v.key.loop_site} folds ${fs} freeze L${v.key.freeze_site} ${v.key.family}"
    consumed := if v.linearly_folded {
      if key_in(post_keys, v.key) {
        "no"
      } else {
        "yes"
      }
    } else {
      "-"
    }
    out = .concat(
      "${v.func}\t${v.family}\t${v.linearly_folded}\t${consumed}\t${key}\t${v.helper_sequence}\t${v.proof_id}\t${v.reason}\n",
    )
  }
  out
}

/// Render `--census` output: the family tally, plus (when `include_sites`) the
/// update-site dry-run table joining candidates with ownership verdicts.
/// Replaces the old per-site `census.render_sites` listing.
pub fn render_census_report(artifacts: PipelineArtifacts, include_sites: Bool) String {
  sites := census.census_sites(artifacts.opt, artifacts.builtins)
  out := census.tally_from_sites(sites).render_census()
  if include_sites {
    // One full artifact computation, shared by the dry-run table and the
    // post-prepare audit below, so the report does not re-run ownership twice.
    s := semantics.make_prelude_optimizer_semantics(artifacts.builtins)
    owned := ownership_verdicts.compute_artifacts(artifacts.opt, artifacts.builtins, s)

    dry := dry_run.dry_run_sites_with_artifacts(artifacts.opt, artifacts.builtins, owned)
    out = .concat(dry_run.render_dry_run(dry))

    // Post-prepare audit: re-run the same selector emission consults over the
    // prepared call sites, so the report shows which decisions were actually
    // selected/policy-disabled/stale-ignored/absent at emission time, not just
    // which pre-closure candidates the dry-run table joined with verdicts.
    cc := convert_closures(artifacts.opt, artifacts.env)
    produced := mutable_produce.produce_update_call_decisions_with_artifacts(
      artifacts.opt,
      artifacts.builtins,
      owned,
    )
    prepared := prepare_backend_with_mutable_config(
      cc.anf,
      artifacts.env,
      artifacts.builtins,
      cc.captures,
      produced.table,
      mutable_select.enabled_emit_policy(),
    )
    audit_rows := mutable_audit.audit_prepared_calls(prepared, artifacts.env, artifacts.builtins)
    out = .concat("\nmutable decisions\n")
    out = .concat(mutable_audit.render_audit_rows(audit_rows))

    region_vs := region_fact.region_verdicts(artifacts.opt, artifacts.builtins)

    // "consumed" reflects ACTUAL rewrite application, not mere production: a
    // certified region is consumed iff it no longer detects as a candidate after
    // rewrite_module (its fold was replaced). Produced-but-splice-abandoned
    // regions still detect their fold, so they read "no".
    rewritten := builder_region.rewrite_module(artifacts.opt, artifacts.builtins)
    post_keys := collect_certified_keys(detect.detect_candidates(rewritten, artifacts.builtins))
    out = .concat(render_region_rows(region_vs, post_keys))
  }
  out
}

pub fn render_cfg_for_entry(file: String) String {
  artifacts := case pipeline.compile_entry_path(file) {
    .Ok(result) => result,
    .Err(err) => error(format_compile_error(err)),
  }
  render_cfg_artifacts(artifacts)
}

pub fn run_ir_command(parsed: ParseResult) {
  file := case get_positional(parsed, 0, "file") {
    .Ok(path) => path,
    .Err(msg) => exit_usage_error(msg),
  }
  artifacts := case pipeline.compile_entry_path(file) {
    .Ok(result) => result,
    .Err(err) => {
      eprintln(format_compile_error(err))
      proc.exit(1)
    },
  }
  print_warnings(artifacts.warnings)

  if parsed.has_flag("census") {
    print(render_census_report(artifacts, parsed.has_flag("sites")))
    return
  }

  if parsed.has_flag("cfg") {
    print(render_cfg_artifacts(artifacts))
    return
  }

  first := true

  if should_show_ir(parsed, "core") {
    first = print_ir_stage("Core IR", ir_print.render_core_module(artifacts.core), first)
  }

  if should_show_ir(parsed, "mono") {
    first = print_ir_stage(
      "Monomorphized Core IR",
      ir_print.render_core_module(artifacts.mono),
      first,
    )
  }

  if should_show_ir(parsed, "anf") {
    first = print_ir_stage(
      "ANF IR",
      ir_print.render_anf_module(artifacts.env, artifacts.anf),
      first,
    )
  }

  if should_show_ir(parsed, "opt") {
    first = print_ir_stage(
      "Optimized ANF IR",
      ir_print.render_anf_module(artifacts.env, artifacts.opt),
      first,
    )
  }

  if should_show_ir(parsed, "wat") {
    first = print_ir_stage("Linked WAT", pipeline.emit_wat(artifacts), first)
  }
}
