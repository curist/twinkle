//! MutVec slice 1 — end-to-end speedup of a claimed region vs the current baseline.
//!
//! `build_and_mutate` is the exact shape the MutVec region pass claims: an owned
//! `Vector<Int>` born from a `collect`, updated k times by index, then RETURNED
//! (the single freeze boundary). Run it two ways to compare:
//!
//!   target/twk run boot/bench/mutvec_slice1_bench.tw   # MutVec (always on)
//!
//! IMPORTANT baseline note: the baseline here is NOT boxed PVec. Sub-project A's
//! typed indexed-write (`set_in_place_i64`) already makes this shape a flat i64
//! in-place trie write. So this measures MutVec (direct flat-array write, no trie
//! navigation) vs typed persistent in-place — expect a modest win, not the 15-35x
//! the Tier-0 spike showed against boxed `set_in_place`.
//!
//! Measured (this machine, min-of-6). MutVec's per-write is O(1) (a direct flat
//! store) vs the baseline's O(log n) trie walk; the boundary freeze is now a bulk
//! `builder_append_leaf_range_i64` (n/32 ArrayCopies + radix promotes), cheap
//! enough that MutVec wins at EVERY mutation density — including zero writes,
//! where the earlier per-element-push freeze made it ~1.2-1.5x SLOWER:
//!
//!   n=1048576  k=0    baseline 17ms  MutVec 14ms   (1.23x faster)
//!   n=1048576  k=500k baseline 14ms  MutVec 9ms    (1.60x faster)
//!   n=1048576  k=2M   baseline 28ms  MutVec 12ms   (2.35x faster)
//!   n=1048576  k=8M   baseline 87ms  MutVec 30ms   (2.87x faster)
//!   n=65536    k=2M   baseline 14ms  MutVec 6ms    (2.35x faster)
//!
//! The bulk-freeze optimization removed the low-density crossover that had kept
//! MutVec opt-in; the win now grows with mutation density but is present even at
//! k=0, so the pass is safe to run unconditionally.

use @std.date

// Reproducible index stream (glibc LCG), so both runs touch identical indices.
fn next_lcg(s: Int) Int {
  s * 1103515245 + 12345 & 0x7fffffff
}

// collect-born owned Vector<Int> + k indexed updates + return. Claimed by the
// MutVec pass under the flag; the typed `set_in_place_i64` path otherwise.
fn build_and_mutate(n: Int, k: Int) Vector<Int> {
  xs := collect i in range(n) {
    i
  }
  s := 1
  j := 0
  for j < k {
    s = next_lcg(s)
    idx := s % n
    xs[idx] = j
    j = j + 1
  }
  xs
}

fn run(n: Int, k: Int) Void {
  // warm one iteration so codegen/JIT effects do not skew the timed run
  warm := build_and_mutate(1024, 1024)
  warm_guard := warm[0]

  t0 := date.now()
  xs := build_and_mutate(n, k)
  t1 := date.now()

  guard := xs[0] + xs[n - 1] + xs[n / 2] + warm_guard - warm_guard
  println("  n=${n}  k=${k}  build+mutate=${t1 - t0}ms  guard=${guard}")
}

println("MutVec slice 1 bench — collect + indexed-update + return")
run(65536, 2000000)
run(1048576, 2000000)
