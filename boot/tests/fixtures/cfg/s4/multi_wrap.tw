// One caller-born handle threaded through TWO distinct owned wrapper clones
// (`set_at` and `bump`) in a single region — a multi-clone accepted region.
pub fn bump(xs: Vector<Bool>, i: Int) Vector<Bool> {
  xs[i] = true
  xs
}

pub fn run(size: Int) Int {
  flags: Vector<Bool> = collect i in range(size + 1) {
    true
  }
  count := 0
  i := 0
  for i <= size {
    flags = .set_at(i, false)
    flags = bump(flags, i)
    if flags[i] {
      count = count + 1
    }
    i = i + 1
  }
  count
}

println(run(20).to_string())
