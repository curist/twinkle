// Negative: the wrapper's single (tail-position) exit does not always return
// the threaded handle — one branch returns a freshly-collected vector instead.
// Violates HP-3 continuation identity (NonContinuationReturn).
pub fn run(size: Int) Vector<Bool> {
  flags: Vector<Bool> = collect i in range(size + 1) {
    true
  }
  i := 2
  for i <= size {
    if flags[i] {
      k := i + i
      for k <= size {
        flags = .set_at(k, false)
        k = k + i
      }
    }
    i = i + 1
  }
  if size > 1000000 {
    collect j in range(1) {
      true
    }
  } else {
    flags
  }
}

println(run(30).len().to_string())
