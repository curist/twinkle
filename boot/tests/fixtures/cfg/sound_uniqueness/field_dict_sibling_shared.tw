pub type Env = .{ types: Dict<Int, Int>, values: Dict<Int, Int> }

pub fn go() Int {
  shared := Dict.new().set(9, 90)
  owned_types: Dict<Int, Int> = Dict.new()
  env := Env.{ types: owned_types, values: shared }
  env.types[1] = 20
  case env.types.get(1) {
    .Some(v) => v,
    .None => 0,
  }
}

println(go().to_string())
