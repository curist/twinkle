pub fn nested_loop_set(n: Int) Int {
  flags: Vector<Bool> = collect _ in range(n) {
    true
  }
  i := 0
  for i < n {
    if flags[i] {
      step := i + 1
      k := step
      for k < n {
        if flags[k] {
          flags = .set_at(k, false)
        }
        k = k + step
      }
    }
    i = i + 1
  }
  i
}
