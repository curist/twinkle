pub type Ctx = .{ types: Dict<Int, Int>, values: Dict<Int, Int> }

pub type Out = .{ ctx: Ctx, tag: Int }

pub fn pass(ctx: Ctx) Out {
  Out.{ ctx, tag: 1 }
}

pub fn go(flag: Bool) Int {
  ctx := Ctx.{ types: Dict.new(), values: Dict.new() }
  out := pass(ctx)
  if flag {
    next := out.ctx
    next.types[2] = 40
  } else {
    {}
  }

  // out.ctx.types is read in the JOIN, after the branch's update: an in-place
  // update in the branch would leak here (must read .None -> out.tag).
  case out.ctx.types.get(2) {
    .Some(v) => v + out.tag,
    .None => out.tag,
  }
}

println(go(true).to_string())
