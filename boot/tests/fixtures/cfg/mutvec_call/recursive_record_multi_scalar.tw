type State = .{ values: Vector<Int>, count: Int, depth: Int }

fn permute(state: State, n: Int) State {
  next := State.{
    values: state.values.set_at(0, n),
    count: state.count + 1,
    depth: state.depth + n,
  }
  if n == 0 {
    next
  } else {
    next.permute(n - 1)
  }
}

pub fn run() Int {
  permute(State.{ values: [1, 2], count: 0, depth: 0 }, 2).count
}

println(run())
