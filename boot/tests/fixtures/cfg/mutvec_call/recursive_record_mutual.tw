pub type State = .{ values: Vector<Int>, count: Int }

pub fn even(cur: State, n: Int) State {
  cur.values[0] = cur.count + 1
  cur.count = cur.count + 1
  if n <= 0 {
    cur
  } else {
    odd(cur, n - 1)
  }
}

pub fn odd(cur: State, n: Int) State {
  cur.values[0] = cur.count + 1
  cur.count = cur.count + 1
  if n <= 0 {
    cur
  } else {
    even(cur, n - 1)
  }
}

pub fn go() Int {
  values: Vector<Int> = collect _ in range(1) {
    0
  }
  end := even(State.{ values, count: 0 }, 3)
  end.values.at(0)
}

println(go().to_string())
