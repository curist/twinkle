type State = .{ values: Vector<Int>, count: Int }

fn replace(values: Vector<Int>, n: Int) Vector<Int> {
  if n == 0 { [0] } else { values.set_at(0, n) }
}

fn permute(state: State, n: Int) State {
  next := State.{ values: replace(state.values, n), count: state.count + 1 }
  if n == 0 { next } else { next.permute(n - 1) }
}

pub fn run() Int {
  permute(State.{ values: [1, 2], count: 0 }, 2).count
}

println(run())
