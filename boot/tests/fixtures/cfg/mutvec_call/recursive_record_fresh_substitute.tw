type State = .{ values: Vector<Int>, count: Int }

fn permute(state: State, n: Int) State {
  values := state.values
  next := State.{
    values: if n == 0 {
      [0]
    } else {
      values
    },
    count: state.count + 1,
  }
  if n == 0 {
    next
  } else {
    next.permute(n - 1)
  }
}

pub fn run() Int {
  permute(State.{ values: [1, 2], count: 0 }, 2).count
}

println(run())
