type State = .{ values: Vector<Int>, count: Int }

fn permute(state: State, n: Int) State {
  saved := state.values
  next := State.{ values: state.values.set_at(0, n), count: state.count + saved[0] }
  if n == 0 {
    next
  } else {
    next.permute(n - 1)
  }
}

pub fn run() Int {
  permute(State.{ values: [1, 2], count: 0 }, 2).count
}

println(run())
