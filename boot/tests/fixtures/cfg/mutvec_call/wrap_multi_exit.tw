// Negative: two syntactically distinct exits, one carrying the threaded
// handle (early `return flags`) and the other a different vector (the
// fallthrough tail) — branch-carried handle, HP-3/Task 3 condition 4
// (materializable exits). Rejected at discovery, same rule as the existing
// "multiple exits carrying the handle" S2 case.
pub fn run(size: Int) Vector<Bool> {
  flags: Vector<Bool> = collect i in range(size + 1) {
    true
  }
  i := 2
  for i <= size {
    if flags[i] {
      k := i + i
      for k <= size {
        flags = .set_at(k, false)
        k = k + i
      }
    }
    i = i + 1
  }
  if size > 1000000 {
    return flags
  }
  collect j in range(1) {
    true
  }
}

println(run(30).len().to_string())
