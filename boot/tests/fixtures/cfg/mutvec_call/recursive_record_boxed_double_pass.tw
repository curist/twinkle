type Person = .{ id: Int, score: Int }

type State = .{ people: Vector<Person>, count: Int }

leaked: Cell<Vector<Person>> = Cell.new([])

// Passes the same projected field to two parameter positions: position 0 is
// consumed (COW mutate + return), position 1 is LEAKED into a module-global Cell.
// Licensing the projection move off position 0 alone would be unsound here — the
// leaked alias would observe the in-place mutation. The caller-side arg-uniqueness
// check must reject the owned route (`next.people` in two arg positions is not
// unique), so this carrier stays persistent.
fn helper(a: Vector<Person>, b: Vector<Person>) Vector<Person> {
  leaked.set(b)
  a.set_at(0, Person.{ id: 99, score: 99 })
}

fn permute(state: State, n: Int) State {
  next := State.{ people: state.people, count: state.count + 1 }
  if n == 0 {
    next
  } else {
    next = .permute(n - 1)
    i := n - 1
    for i >= 0 {
      next.people = helper(next.people, next.people)
      i = .dec()
    }
    next
  }
}

pub fn run() Int {
  people: Vector<Person> = collect i in range(4) {
    Person.{ id: i, score: i + 1 }
  }
  permute(State.{ people, count: 0 }, 3).people[0].id
}

println(run())
