// Positive A': same run_wrap shape as sieve_scratch, but the mutated vector is
// the function's return value — a single escaping (materializing) exit.
pub fn run(size: Int) Vector<Bool> {
  flags: Vector<Bool> = collect i in range(size + 1) {
    true
  }
  i := 2
  for i <= size {
    if flags[i] {
      k := i + i
      for k <= size {
        flags = .set_at(k, false)
        k = k + i
      }
    }
    i = i + 1
  }
  flags
}

println(run(30).len().to_string())
