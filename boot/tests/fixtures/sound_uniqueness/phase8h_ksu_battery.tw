// Key-stream uniqueness certification battery (design §7).
// Positives must certify as dedupe helpers; every negative must be rejected.
// Kept in one compilation unit so the compositional combinators can share the
// `insert_sorted` / `merge_two` primitives they build on.
// ── Positives ───────────────────────────────────────────────────────────
// Sort-insert primitive (equality early-return dedupe), Int elements.
fn insert_sorted(v: Vector<Int>, id: Int) Vector<Int> {
  out: Vector<Int> = []
  inserted := false
  for x in v {
    if x == id {
      return v
    }
    if !inserted and id < x {
      out = .append(id)
      inserted = true
    }
    out = .append(x)
  }
  if !inserted {
    out = .append(id)
  }
  out
}

// Same primitive over String elements: `==`/`<` lower to ABinOp(.Eq/.Lt, .., .Str)
// and O1's equality evidence wildcards the OpKind field, so this certifies too.
fn insert_sorted_str(v: Vector<String>, s: String) Vector<String> {
  out: Vector<String> = []
  inserted := false
  for x in v {
    if x == s {
      return v
    }
    if !inserted and s < x {
      out = .append(s)
      inserted = true
    }
    out = .append(x)
  }
  if !inserted {
    out = .append(s)
  }
  out
}

// Compositional combinator over the certified primitive (accumulator at arg 0).
fn union_via_insert(a: Vector<Int>, b: Vector<Int>) Vector<Int> {
  out := a
  for k in b {
    out = insert_sorted(out, k)
  }
  out
}

// Certified combinator callee taking two vector params; its dedupe-preserving
// param is arg 0 (`base`). Referenced by `union_keys` and `wrong_arg_position`.
fn merge_two(base: Vector<Int>, extra: Vector<Int>) Vector<Int> {
  out := base
  for k in extra {
    out = insert_sorted(out, k)
  }
  out
}

// Combinator over `merge_two` passing the accumulator at the certified position
// (arg 0) — the arg-uniqueness gate's positive case.
fn union_keys(a: Vector<Int>, b: Vector<Int>) Vector<Int> {
  out := a
  for k in b {
    out = merge_two(out, [k])
  }
  out
}

// ── Negatives ───────────────────────────────────────────────────────────
// O3: id appended unconditionally every iteration (block merely sets the flag).
fn bad(v: Vector<Int>, id: Int) Vector<Int> {
  out: Vector<Int> = []
  flag := false
  for x in v {
    if x == id {
      return v
    }
    out = .append(x)
    out = .append(id)
    flag = true
  }
  out
}

// O3 instruction-sensitivity: two id-appends in one !inserted block; the second
// runs after the flag is set.
fn two_id_one_block(v: Vector<Int>, id: Int) Vector<Int> {
  out: Vector<Int> = []
  inserted := false
  for x in v {
    if x == id {
      return v
    }
    if !inserted {
      out = .append(id)
      inserted = true
      out = .append(id)
    }
    out = .append(x)
  }
  if !inserted {
    out = .append(id)
  }
  out
}

// O2: fixed-index append re-appends the same element every iteration.
fn bad2(v: Vector<Int>, id: Int) Vector<Int> {
  out: Vector<Int> = []
  for x in v {
    if x == id {
      return v
    }
    out = .append(v[0])
  }
  out
}

// O2 dynamic multiplicity: one static append site, but inside a nested loop.
fn nested_loop_append(v: Vector<Int>, id: Int) Vector<Int> {
  out: Vector<Int> = []
  for x in v {
    if x == id {
      return v
    }
    for j in range(2) {
      out = .append(x)
    }
  }
  out
}

// O1 full-traversal: equality guard indexes a fixed slot, not the induction element.
fn fixed_index_eq_guard(v: Vector<Int>, id: Int) Vector<Int> {
  out: Vector<Int> = []
  inserted := false
  for x in v {
    if v[0] == id {
      return v
    }
    if !inserted and id < x {
      out = .append(id)
      inserted = true
    }
    out = .append(x)
  }
  if !inserted {
    out = .append(id)
  }
  out
}

// O1: a second in-loop exit besides the equality early-return.
fn second_in_loop_exit(v: Vector<Int>, id: Int) Vector<Int> {
  out: Vector<Int> = []
  inserted := false
  for x in v {
    if x == id {
      return v
    }
    if x < 0 {
      return out
    }
    if !inserted and id < x {
      out = .append(id)
      inserted = true
    }
    out = .append(x)
  }
  if !inserted {
    out = .append(id)
  }
  out
}

// O1 false-edge domination: a continue before the equality guard skips the check.
fn continue_before_eq(v: Vector<Int>, id: Int) Vector<Int> {
  out: Vector<Int> = []
  inserted := false
  for x in v {
    if x < 0 {
      continue
    }
    if x == id {
      return v
    }
    if !inserted and id < x {
      out = .append(id)
      inserted = true
    }
    out = .append(x)
  }
  if !inserted {
    out = .append(id)
  }
  out
}

// O2/§5.3: a condition loop whose continue forwards the counter unchanged,
// re-appending the same element with one static site and no inner SCC.
fn unchanged_counter_backedge(v: Vector<Int>, id: Int) Vector<Int> {
  out: Vector<Int> = []
  i := 0
  for i < v.len() {
    if v[i] == id {
      return v
    }
    out = .append(v[i])
    if v[i] < 0 {
      continue
    }
    i = i + 1
  }
  out
}

// §5.0: a reconverging diamond whose join block carries a side effect
// (inserted = true) before its branch — threading must NOT collapse it.
fn join_side_effect(v: Vector<Int>, id: Int) Vector<Int> {
  out: Vector<Int> = []
  inserted := false
  for x in v {
    if x == id {
      return v
    }
    do_ins := if !inserted and id < x {
      inserted = true
      true
    } else {
      false
    }
    if do_ins {
      out = .append(id)
    }
    out = .append(x)
  }
  if !inserted {
    out = .append(id)
  }
  out
}

// O0: the vector param is rebound to a duplicate vector and returned.
fn rebound_vparam(v: Vector<Int>, id: Int) Vector<Int> {
  out: Vector<Int> = []
  inserted := false
  for x in v {
    if x == id {
      return v
    }
    if !inserted and id < x {
      out = .append(id)
      inserted = true
    }
    out = .append(x)
  }
  v = [id, id]
  v
}

// O0: the element proof local is rebound before its append.
fn rebound_proof_local(v: Vector<Int>, id: Int) Vector<Int> {
  out: Vector<Int> = []
  inserted := false
  for x in v {
    if x == id {
      return v
    }
    x = id
    if !inserted and id < x {
      out = .append(id)
      inserted = true
    }
    out = .append(x)
  }
  if !inserted {
    out = .append(id)
  }
  out
}

// §5.7: the !flag guard is computed, then the flag is set, then branched on stale.
fn stale_notflag(v: Vector<Int>, id: Int) Vector<Int> {
  out: Vector<Int> = []
  inserted := false
  for x in v {
    if x == id {
      return v
    }
    c := !inserted
    out = .append(id)
    inserted = true
    if c {
      out = .append(id)
    }
    out = .append(x)
  }
  out
}

// O4: passes the accumulator to a certified helper at the wrong arg position.
fn wrong_arg_position(a: Vector<Int>, b: Vector<Int>) Vector<Int> {
  out := a
  for k in b {
    out = merge_two([k], out)
  }
  out
}

// §5.7: the set-once flag is reset inside the loop, re-arming id every iteration.
fn flag_reset_in_loop(v: Vector<Int>, id: Int) Vector<Int> {
  out: Vector<Int> = []
  inserted := false
  for x in v {
    inserted = false
    if x == id {
      return v
    }
    if !inserted {
      out = .append(id)
      inserted = true
    }
    out = .append(x)
  }
  out
}

// O0/O4: the combinator rebinds a vector param.
fn param_rebind_combinator(a: Vector<Int>, b: Vector<Int>) Vector<Int> {
  out := a
  for k in b {
    out = insert_sorted(out, k)
    a = out
  }
  out
}

// O0: returns a non-accumulator local.
fn wrong_return(a: Vector<Int>, b: Vector<Int>) Vector<Int> {
  out := a
  junk: Vector<Int> = []
  for k in b {
    junk = .append(k)
  }
  junk
}

// O0/O4: an accumulator write that is neither a certified-helper call nor an
// approved append.
fn extra_acc_mutation(a: Vector<Int>, b: Vector<Int>) Vector<Int> {
  out := a
  for k in b {
    out = insert_sorted(out, k)
    out = .append(k)
  }
  out
}

// O4: bare append on the accumulator (no dedupe).
fn bare_append_union(a: Vector<Int>, b: Vector<Int>) Vector<Int> {
  out := a
  for k in b {
    out = .append(k)
  }
  out
}

// O4: pure passthrough, no dedupe extension.
fn passthrough(a: Vector<Int>) Vector<Int> {
  out := a
  out
}

fn main() {
  n := 0
  n = n + insert_sorted([3, 1], 2).len()
  n = n + insert_sorted_str(["b", "a"], "c").len()
  n = n + union_via_insert([1], [1, 2]).len()
  n = n + union_keys([1], [2, 3]).len()
  n = n + merge_two([1], [2]).len()
  n = n + bad([1, 2], 9).len()
  n = n + two_id_one_block([1, 2], 9).len()
  n = n + bad2([1, 2], 9).len()
  n = n + nested_loop_append([1, 2], 9).len()
  n = n + fixed_index_eq_guard([1, 2], 9).len()
  n = n + second_in_loop_exit([1, 2], 9).len()
  n = n + continue_before_eq([1, 2], 9).len()
  n = n + unchanged_counter_backedge([1, 2], 9).len()
  n = n + join_side_effect([1, 2], 9).len()
  n = n + rebound_vparam([1, 2], 9).len()
  n = n + rebound_proof_local([1, 2], 9).len()
  n = n + stale_notflag([1, 2], 9).len()
  n = n + wrong_arg_position([1], [2]).len()
  n = n + flag_reset_in_loop([1, 2], 9).len()
  n = n + param_rebind_combinator([1], [2]).len()
  n = n + wrong_return([1], [2]).len()
  n = n + extra_acc_mutation([1], [2]).len()
  n = n + bare_append_union([1], [2]).len()
  n = n + passthrough([1]).len()
  println(n.to_string())
}

main()
