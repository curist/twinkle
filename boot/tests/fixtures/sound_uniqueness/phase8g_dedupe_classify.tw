// Certified: sort-insert primitive (equality early-return dedupe).
fn insert_sorted(v: Vector<Int>, id: Int) Vector<Int> {
  out: Vector<Int> = []
  inserted := false
  for x in v {
    if x == id {
      return v
    }
    if !inserted and id < x {
      out = .append(id)
      inserted = true
    }
    out = .append(x)
  }
  if !inserted {
    out = .append(id)
  }
  out
}

// Certified: compositional combinator over the certified primitive.
fn union_via_insert(a: Vector<Int>, b: Vector<Int>) Vector<Int> {
  out := a
  for k in b {
    out = insert_sorted(out, k)
  }
  out
}

// Rejected: bare append on the accumulator (no dedupe).
fn plain_union(a: Vector<Int>, b: Vector<Int>) Vector<Int> {
  out := a
  for k in b {
    out = .append(k)
  }
  out
}

// Rejected: sort-insert shape but appends each element twice (multiplicity check).
fn bad_insert(v: Vector<Int>, id: Int) Vector<Int> {
  out: Vector<Int> = []
  inserted := false
  for x in v {
    if x == id {
      return v
    }
    if !inserted and id < x {
      out = .append(id)
      inserted = true
    }
    out = .append(x)
    out = .append(x)
  }
  if !inserted {
    out = .append(id)
  }
  out
}

// Rejected: pure passthrough, no dedupe extension.
fn passthrough(a: Vector<Int>) Vector<Int> {
  out := a
  out
}

// Rejected: returns a non-accumulator local.
fn wrong_return(a: Vector<Int>, b: Vector<Int>) Vector<Int> {
  out := a
  junk: Vector<Int> = []
  for k in b {
    junk = .append(k)
  }
  junk
}

fn main() {
  n := 0
  n = n + insert_sorted([3, 1], 2).len()
  n = n + union_via_insert([1], [1, 2]).len()
  n = n + plain_union([1], [2]).len()
  n = n + bad_insert([1], 2).len()
  n = n + passthrough([1]).len()
  n = n + wrong_return([1], [2]).len()
  println(n.to_string())
}

main()
