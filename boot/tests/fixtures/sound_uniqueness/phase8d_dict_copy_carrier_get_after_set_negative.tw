type Out = .{ map: Dict<Int, Int>, observed: Int }

fn get_after_set_negative(next: Dict<Int, Int>) Out {
  out := next
  observed := 0
  keys := next.keys()
  for k in keys {
    out[k] = k + 1
    before := case next.get(k) {
      .Some(v) => v,
      .None => 0,
    }
    observed = observed + before
  }
  Out.{ map: out, observed }
}

fn caller(n: Int) Int {
  state: Dict<Int, Int> = Dict.new()
  observed := 0
  i := 0
  for i < n {
    state[i] = i
    o := get_after_set_negative(state)
    state = o.map
    observed = observed + o.observed
    i = i + 1
  }
  observed + state.len()
}

println(caller(3).to_string())
