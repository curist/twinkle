use @std.testing.assert as assert
use @std.testing as runner

use compiler.anf.{AnfExpr, AnfFunctionDef, AnfModule, AnfOp}
use compiler.builtins
use compiler.cfg
use compiler.core_ir.{FieldId, FuncId, GlobalId, LocalId, Param}
use compiler.mono_type.{MonoType, TypeId}
use compiler.opt.semantics as semantics
use compiler.opt.semantics.{make_prelude_optimizer_semantics}
use compiler.ownership
use compiler.summary

fn lid(id: Int) LocalId {
  LocalId.{ id }
}

fn b_reg() builtins.BuiltinRegistry {
  builtins.make_builtin_registry()
}

fn sem() semantics.OptimizerSemantics {
  make_prelude_optimizer_semantics(b_reg())
}

fn fdef(id: Int, name: String, nparams: Int, body: AnfExpr) AnfFunctionDef {
  params: Vector<Param> = collect i in range(nparams) {
    Param.{ local: lid(i), ty: MonoType.Int }
  }
  AnfFunctionDef.{
    func_id: FuncId.{ id },
    name,
    is_init: false,
    params,
    op_result_mono: Dict.new(),
    body,
    return_ty: MonoType.Int,
  }
}

fn module_of(funcs: Vector<AnfFunctionDef>) AnfModule {
  AnfModule.{
    functions: funcs,
    init_func_id: .None,
    extern_imports: Dict.new(),
    global_monos: Dict.new(),
    lib_exports: [],
  }
}

fn compute_of(funcs: Vector<AnfFunctionDef>) ownership.SummaryTable {
  b := b_reg()
  v := cfg.build_view(module_of(funcs), b)
  summary.compute(v, b, sem())
}

fn analyzed_caller(funcs: Vector<AnfFunctionDef>, caller: String) cfg.CfgFunction {
  b := b_reg()
  v := cfg.build_view(module_of(funcs), b)
  t := summary.compute(v, b, sem())
  a := ownership.analyze_with_summaries(v, b, sem(), t)
  case cfg.function_named(a, caller) {
    .Some(f) => f,
    .None => error("no ${caller}"),
  }
}

// exit ownership of a local in the caller's entry block (block 0).
fn caller_own(f: cfg.CfgFunction, local_id: Int) Int {
  case f.blocks[0].exit.ownership.get(local_id) {
    .Some(tag) => tag,
    .None => 2,
  }
}

// exit ownership of a local in a GIVEN block (caller_own hardcodes block 0).
fn own_in_block(f: cfg.CfgFunction, block_id: Int, local_id: Int) Int {
  for blk in f.blocks {
    if blk.id.id == block_id {
      return case blk.exit.ownership.get(local_id) {
        .Some(tag) => tag,
        .None => 2,
      }
    }
  }
  2
}

fn own_unique() Int {
  ownership.own_tag(.Unique)
}

fn own_shared() Int {
  ownership.own_tag(.Shared)
}

fn dict_new_call(b: builtins.BuiltinRegistry) AnfOp {
  .ACall(.AGlobalFunc(b.method_id("Dict", "new")), [])
}

fn wrapper_record(field_val: LocalId) AnfOp {
  .ARecord(TypeId.{ id: 0 }, [.{ field: FieldId.{ id: 0 }, value: .ALocal(field_val) }])
}

// Record{f0: field_val, f1: fresh}: two fields so the caller has a SIBLING to
// read. Summary ret=OwnedFresh, ret_paths [.f0]=from(p0), [.f1]=fresh.
fn wrapper_record2(field_val: LocalId, fresh_val: LocalId) AnfOp {
  .ARecord(
    TypeId.{ id: 0 },
    [
      .{ field: FieldId.{ id: 0 }, value: .ALocal(field_val) },
      .{ field: FieldId.{ id: 1 }, value: .ALocal(fresh_val) },
    ],
  )
}

// helper(x) returns Record{f0:x, f1:<fresh Dict.new()>}. Body:
//   f1v := Dict.new(); rec := Record{f0:x, f1:f1v}; return rec
fn wrapper2_helper(b: builtins.BuiltinRegistry) AnfFunctionDef {
  fdef(
    1,
    "helper",
    1,
    .Let(
      lid(1),
      dict_new_call(b), // f1v := Dict.new() (fresh)
      .Let(lid(2), wrapper_record2(lid(0), lid(1)), .Atom(.ALocal(lid(2)))),
    ),
  )
}

// g's local id in the sibling-read caller (the projected `g := out.f0`).
fn gsib_local() Int {
  2
}

// g's local id in the caller (the projected `g := out.f0`).
fn grec_local() Int {
  2
}

// helper(x) returns Record{f0:x}: summary ret=OwnedFresh with a Direct .f0
// ret_path owned-from-param(0). caller() threads a fresh unique ctx through it.
fn case_w_fixture() Vector<AnfFunctionDef> {
  b := b_reg()
  helper := fdef(1, "helper", 1, .Let(lid(1), wrapper_record(lid(0)), .Atom(.ALocal(lid(1)))))
  caller_body: AnfExpr = .Let(
    lid(0),
    dict_new_call(b), // ctx := Dict.new() (fresh Unique)
    .Let(
      lid(1),
      .ACall(.AGlobalFunc(FuncId.{ id: 1 }), [.ALocal(lid(0))]), // out := helper(ctx)
      .Let(
        lid(2),
        .ARecordGet(.ALocal(lid(1)), FieldId.{ id: 0 }, TypeId.{ id: 0 }), // g := out.f0
        .Atom(.ALocal(lid(2))),
      ),
    ),
  )
  [helper, fdef(2, "caller", 0, caller_body)]
}

// Same as case_w_fixture but reads ctx (lid0) AFTER the call, so ctx is not a
// last-use at the call -> the recovery gate fails on last-use and publishes ctx.
fn case_w_gatefail_fixture() Vector<AnfFunctionDef> {
  b := b_reg()
  helper := fdef(1, "helper", 1, .Let(lid(1), wrapper_record(lid(0)), .Atom(.ALocal(lid(1)))))
  caller_body: AnfExpr = .Let(
    lid(0),
    dict_new_call(b), // ctx := Dict.new() (fresh Unique)
    .Let(
      lid(1),
      .ACall(.AGlobalFunc(FuncId.{ id: 1 }), [.ALocal(lid(0))]), // out := helper(ctx)
      .Let(
        lid(2),
        .ARecordGet(.ALocal(lid(1)), FieldId.{ id: 0 }, TypeId.{ id: 0 }), // g := out.f0
        .Let(
          lid(3),
          .AInit(.ALocal(lid(0))), // keep := ctx (reads ctx AFTER the call)
          .Atom(.ALocal(lid(2))),
        ),
      ),
    ),
  )
  [helper, fdef(2, "caller", 0, caller_body)]
}

// caller(): ctx := Dict.new(); out := helper(ctx);
//   g := record_get out.f0; ty := record_get out.f1; return g
// out stays live for the sibling read out.f1, but out.f0 is dead-through-out ->
// the transport recognizer licenses the move -> g Unique.
fn case_w_sibling_fixture() Vector<AnfFunctionDef> {
  b := b_reg()
  helper := wrapper2_helper(b)
  caller_body: AnfExpr = .Let(
    lid(0),
    dict_new_call(b), // ctx := Dict.new() (fresh Unique)
    .Let(
      lid(1),
      .ACall(.AGlobalFunc(FuncId.{ id: 1 }), [.ALocal(lid(0))]), // out := helper(ctx)
      .Let(
        lid(2),
        .ARecordGet(.ALocal(lid(1)), FieldId.{ id: 0 }, TypeId.{ id: 0 }), // g := out.f0
        .Let(
          lid(3),
          .ARecordGet(.ALocal(lid(1)), FieldId.{ id: 1 }, TypeId.{ id: 0 }), // ty := out.f1 (sibling)
          .Atom(.ALocal(lid(2))), // return g
        ),
      ),
    ),
  )
  [helper, fdef(2, "caller", 0, caller_body)]
}

// caller(): ctx := Dict.new(); out := helper(ctx); g := record_get out.f0;
//   global_set G0 = out; return g
// out is PUBLISHED -> transport_ok fails on the non-sibling mention -> borrow.
fn case_w_published_out_fixture() Vector<AnfFunctionDef> {
  b := b_reg()
  helper := wrapper2_helper(b)
  caller_body: AnfExpr = .Let(
    lid(0),
    dict_new_call(b), // ctx := Dict.new()
    .Let(
      lid(1),
      .ACall(.AGlobalFunc(FuncId.{ id: 1 }), [.ALocal(lid(0))]), // out := helper(ctx)
      .Let(
        lid(2),
        .ARecordGet(.ALocal(lid(1)), FieldId.{ id: 0 }, TypeId.{ id: 0 }), // g := out.f0
        .Let(
          lid(3),
          .AGlobalSet(GlobalId.{ id: 0 }, .ALocal(lid(1))), // publish out
          .Atom(.ALocal(lid(2))), // return g
        ),
      ),
    ),
  )
  [helper, fdef(2, "caller", 0, caller_body)]
}

// caller(): ctx := Dict.new(); out := helper(ctx); g := record_get out.f0;
//   if cond { ty := record_get out.f1 }; return g
// out is read in a SUCCESSOR block (the if-then), so it is LIVE-OUT of the
// projection block. exit_mentions_local alone would miss this; the live-out
// check catches it -> borrow.
fn case_w_out_liveout_fixture() Vector<AnfFunctionDef> {
  b := b_reg()
  helper := wrapper2_helper(b)
  then_branch: AnfExpr = .Let(
    lid(4),
    .ARecordGet(.ALocal(lid(1)), FieldId.{ id: 1 }, TypeId.{ id: 0 }), // ty := out.f1 (in successor)
    .Atom(.ALitInt(0)),
  )
  else_branch: AnfExpr = .Atom(.ALitInt(0))
  caller_body: AnfExpr = .Let(
    lid(0),
    dict_new_call(b), // ctx := Dict.new()
    .Let(
      lid(1),
      .ACall(.AGlobalFunc(FuncId.{ id: 1 }), [.ALocal(lid(0))]), // out := helper(ctx)
      .Let(
        lid(2),
        .ARecordGet(.ALocal(lid(1)), FieldId.{ id: 0 }, TypeId.{ id: 0 }), // g := out.f0
        .Let(
          lid(3),
          .AIf(.ALitBool(true), then_branch, else_branch), // out live into then-branch
          .Atom(.ALocal(lid(2))), // return g
        ),
      ),
    ),
  )
  [helper, fdef(2, "caller", 0, caller_body)]
}

pub fn suite() runner.Suite {
  runner
    .suite("cfg return paths")
    .test(
      "Case W: ctx := fresh; out := helper(ctx); g := out.f0 recovers g Unique",
      fn() {
        // helper(x) returns Record{f0:x}  => summary ret=OwnedFresh, ret_paths [.f0]=from(p0).
        // caller(): ctx := Dict.new() (fresh Unique); out := helper(ctx);
        //           g := record_get out.f0; return g
        funcs := case_w_fixture()
        f := analyzed_caller(funcs, "caller")
        try assert.equal(caller_own(f, grec_local()), own_unique()) // g is Unique after the projection move
        .Ok({})
      },
    )
    .test(
      "gate fail: fresh ctx used after the call is published (gate fails on last-use)",
      fn() {
        // caller(): ctx := Dict.new(); out := helper(ctx); g := out.f0;
        //           keep := ctx (reads ctx AFTER the call -> ctx not last-use at call);
        //           return g.  Gate fails -> ctx published -> Shared.
        funcs := case_w_gatefail_fixture()
        f := analyzed_caller(funcs, "caller")
        try assert.equal(caller_own(f, 0), own_shared()) // ctx (lid0) published by gate-fail
        .Ok({})
      },
    )
    .test(
      "transport move: out.f0 moves even though out.f1 is read after",
      fn() {
        // caller(): ctx := Dict.new(); out := helper(ctx);  // helper -> Record{f0:x, f1:fresh}
        //   g := record_get out.f0; ty := record_get out.f1; return g   (ty read keeps out live)
        // out is live for out.f1, but out.f0 is dead-through-out -> transport move licensed -> g Unique.
        funcs := case_w_sibling_fixture()
        f := analyzed_caller(funcs, "caller")
        try assert.equal(caller_own(f, gsib_local()), own_unique()) // g is Unique
        .Ok({})
      },
    )
    .test(
      "transport borrow: publishing out forces borrow (g not cleanly Unique)",
      fn() {
        // caller(): ctx := Dict.new(); out := helper(ctx); g := record_get out.f0;
        //   global_set G0 = out; return g
        // out is published -> transport_ok fails (non-sibling mention) -> borrow.
        funcs := case_w_published_out_fixture()
        f := analyzed_caller(funcs, "caller")
        try assert.equal(caller_own(f, gsib_local()), own_shared())
        .Ok({})
      },
    )
    .test(
      "transport borrow: out live into a later block forces borrow (live-out check)",
      fn() {
        // caller(): ctx := Dict.new(); out := helper(ctx); g := record_get out.f0;
        //   if cond { ty := record_get out.f1 }   // out is LIVE-OUT of the projection block
        // exit_mentions_local alone would miss this; blk.exit.live catches it -> borrow.
        funcs := case_w_out_liveout_fixture()
        f := analyzed_caller(funcs, "caller")
        try assert.equal(caller_own(f, gsib_local()), own_shared())
        .Ok({})
      },
    )
}
