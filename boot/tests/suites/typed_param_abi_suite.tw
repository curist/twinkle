//! Tests for the cross-call typed-vector param ABI analysis (Stage 2) in
//! boot/compiler/backend/typed_param_abi.tw.
//!
//! End-to-end fixtures: each test compiles a tiny .tw source through the real
//! pipeline (compile_source -> closure_convert -> prepare_backend_preroute), then
//! runs the param-typeability classifier on the prepared funcs.

use @std.testing.assert as assert
use @std.testing as runner

use compiler.backend.closure_convert.{convert_closures}
use compiler.backend.prepare.{prepare_backend_preroute}
use compiler.backend.prepared_ir.{PreparedFunc}
use compiler.backend.route_typed_vec.{analyze_typed_payloads}
use compiler.backend.typed_param_abi.{analyze_typed_repr, param_uses_typed_only}
use compiler.base_env.{first_user_type_id}
use compiler.builtins.{BuiltinRegistry}
use compiler.mono_type.{MonoType}
use compiler.pipeline

type PrepInputs = .{ funcs: Vector<PreparedFunc>, builtins: BuiltinRegistry }

fn prepare_src(src: String) Result<PrepInputs, String> {
  artifacts := try pipeline.compile_source(src)
  cc := convert_closures(artifacts.opt, artifacts.env)
  prepared := prepare_backend_preroute(cc.anf, artifacts.env, artifacts.builtins, cc.captures)
  .Ok(.{ funcs: prepared.funcs, builtins: artifacts.builtins })
}

fn is_vector_int(mono: MonoType) Bool {
  case mono {
    .Vector(.Int) => true,
    _ => false,
  }
}

type VecParam = .{ func_index: Int, slot: Int }

// Find the first regular param (not a capture) whose type is Vector<Int>,
// returning which function it belongs to and its slot id.
fn find_vec_param(funcs: Vector<PreparedFunc>) Result<VecParam, String> {
  for pf, fi in funcs {
    for p in pf.params {
      case pf.slots[p.id] {
        .Some(info) => if is_vector_int(info.mono) {
          return .Ok(.{ func_index: fi, slot: p.id })
        },
        .None => {},
      }
    }
  }

  .Err("no Vector<Int> param found")
}

// A Vector<Int> param used only via index + len -> typeable.
fn indexed_src() String {
  "fn use_indexed(xs: Vector<Int>, n: Int) Int {\n"
    .concat("  t := 0\n")
    .concat("  for k in range(n) { t = t + xs[k] }\n")
    .concat("  t + xs.len()\n")
    .concat("}\n")
    .concat("use_indexed([1, 2, 3], 3)\n")
}

// A Vector<Int> param captured into a closure -> not typeable (the anyref env
// would make typed reads unsound; the group escapes through AMakeClosure).
fn captured_src() String {
  "fn make_reader(xs: Vector<Int>) fn() Int {\n"
    .concat("  fn() { xs.len() }\n")
    .concat("}\n")
    .concat("f := make_reader([1, 2, 3])\n")
    .concat("f()\n")
}

fn typed_count(d: Dict<String, Bool>) Int {
  n := 0

  for k in d.keys() {
    case d[k] {
      .Some(v) => if v {
        n = n + 1
      },
      .None => {},
    }
  }

  n
}

// The dataframe shape: a payload whose ONLY producer is a helper's param
// (`int_col(values)` -> `.IntCol(values)`), with no direct collect->payload
// producer. Builder-only payload analysis can't type it; the joint fixpoint can,
// because `values` is a typeable param and thus a clean typed producer.
fn int_col_src() String {
  "type Col = { IntCol(Vector<Int>) }\n"
    .concat("fn int_col(values: Vector<Int>) Col {\n")
    .concat("  .IntCol(values)\n")
    .concat("}\n")
    .concat("fn firstv(c: Col) Int {\n")
    .concat("  case c {\n")
    .concat("    .IntCol(v) => v[0],\n")
    .concat("  }\n")
    .concat("}\n")
    .concat("fn build(n: Int) Col {\n")
    .concat("  int_col(collect i in range(n) { i })\n")
    .concat("}\n")
    .concat("firstv(build(8))\n")
}

// A local `collect` captured into a sort comparator and read via index: the
// capture is typeable (its free var is a typed local producer).
fn typed_capture_src() String {
  "fn run(n: Int) Int {\n"
    .concat("  keys := collect i in range(n) { i * 2 }\n")
    .concat("  idx := collect i in range(n) { i }\n")
    .concat("  sorted := idx.sort_by(fn(a, b) { Int.compare(keys[a], keys[b]) })\n")
    .concat("  sorted[0]\n")
    .concat("}\n")
    .concat("run(8)\n")
}

// The same shape but `keys` comes from a function return (a boxed PVec): the
// capture MUST NOT be typed (the trampoline downcast to PVecI64 would trap).
fn boxed_capture_src() String {
  "fn mkkeys(n: Int) Vector<Int> {\n"
    .concat("  out: Vector<Int> = []\n")
    .concat("  for i in range(n) { out = out.append(i * 2) }\n")
    .concat("  out\n")
    .concat("}\n")
    .concat("fn run(n: Int) Int {\n")
    .concat("  keys := mkkeys(n)\n")
    .concat("  idx := collect i in range(n) { i }\n")
    .concat("  sorted := idx.sort_by(fn(a, b) { Int.compare(keys[a], keys[b]) })\n")
    .concat("  sorted[0]\n")
    .concat("}\n")
    .concat("run(8)\n")
}

pub fn suite() runner.Suite {
  runner
    .suite("typed param abi")
    .test(
      "param used only via index + len is typeable",
      fn() {
        p := try prepare_src(indexed_src())
        vp := try find_vec_param(p.funcs)
        pf := p.funcs[vp.func_index]

        typeable := case param_uses_typed_only(pf, vp.slot, p.builtins, Dict.new(), Dict.new()) {
          .Some(_) => true,
          .None => false,
        }

        try assert.ok(typeable, "index+len param should be typeable")
        .Ok({})
      },
    )
    .test(
      "param captured into a closure is not typeable",
      fn() {
        p := try prepare_src(captured_src())
        vp := try find_vec_param(p.funcs)
        pf := p.funcs[vp.func_index]

        typeable := case param_uses_typed_only(pf, vp.slot, p.builtins, Dict.new(), Dict.new()) {
          .Some(_) => true,
          .None => false,
        }

        try assert.ok(!typeable, "captured param must not be typeable")
        .Ok({})
      },
    )
    .test(
      "joint fixpoint types a payload whose only producer is a typeable param",
      fn() {
        p := try prepare_src(int_col_src())

        // Builder-only payload analysis: no direct collect->.IntCol producer, so
        // ColData.IntCol stays untyped.
        tp0 := analyze_typed_payloads(p.funcs, p.builtins, first_user_type_id(), Dict.new())
        try assert.equal(typed_count(tp0), 0)

        // Joint fixpoint: `int_col`'s `values` param is typeable and thus a clean
        // typed producer, so the payload types.
        repr := analyze_typed_repr(p.funcs, p.builtins, first_user_type_id())
        try assert.ok(
          typed_count(repr.typed_payloads) >= 1,
          "joint fixpoint should type the param-fed payload",
        )
        try assert.ok(
          repr.param_abi.typeable_params.keys().len() >= 1,
          "int_col's values param should be typeable",
        )
        .Ok({})
      },
    )
    .test(
      "a captured typed-local vector is a typeable capture (M1b)",
      fn() {
        p := try prepare_src(typed_capture_src())
        repr := analyze_typed_repr(p.funcs, p.builtins, first_user_type_id())
        try assert.ok(
          repr.capture_abi.keys().len() >= 1,
          "comparator capturing a local collect should be a typeable capture",
        )
        .Ok({})
      },
    )
    .test(
      "a captured boxed-return vector is NOT a typeable capture (support gate)",
      fn() {
        p := try prepare_src(boxed_capture_src())
        repr := analyze_typed_repr(p.funcs, p.builtins, first_user_type_id())
        try assert.equal(repr.capture_abi.keys().len(), 0)
        .Ok({})
      },
    )
}
