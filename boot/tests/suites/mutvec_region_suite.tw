use @std.testing.assert as assert
use @std.testing as runner

use commands.ir
use compiler.anf.{AnfExpr, AnfOp}
use compiler.backend.prepared_ir.{PreparedFunc, SlotInfo}
use compiler.builtins
use compiler.codegen.codegen.{prepare_codegen}
use compiler.codegen.mutvec_region
use compiler.pipeline

// Debug harness: lower a source snippet through the real pipeline and return the
// proof ids of every claimed MutVec region. Lives here (not in mutvec_region.tw)
// so the codegen module never imports the pipeline (avoids an import cycle).
fn region_ids(src: String) Vector<String> {
  case pipeline.compile_source(src) {
    .Ok(a) => collect r in mutvec_region.detect_regions(a.opt, a.builtins) {
      r.proof_id
    },
    .Err(e) => error("compile failed: ${e}"),
  }
}

fn region_count(src: String) Int {
  region_ids(src).len()
}

// Content inspection: pull the sole detected region so tests can assert on the
// recorded producer class and op-site kinds, not just the region count.
fn sole_region(src: String) mutvec_region.MutVecRegion {
  case pipeline.compile_source(src) {
    .Ok(a) => {
      rs := mutvec_region.detect_regions(a.opt, a.builtins)
      if rs.len() != 1 {
        error("expected exactly one region, got ${rs.len().to_string()}")
      }
      rs[0]
    },
    .Err(e) => error("compile failed: ${e}"),
  }
}

fn producer_name(p: mutvec_region.MutVecProducer) String {
  case p {
    .CollectSeed => "collect",
    .MakeSeed => "make",
    .ArrayLitSeed => "arraylit",
  }
}

fn op_kind_name(k: mutvec_region.MutVecOpKind) String {
  case k {
    .Set => "set",
    .Push => "push",
    .Get => "get",
    .Len => "len",
  }
}

// Count in-region op sites of the named kind (set / push / get / len).
fn kind_count(r: mutvec_region.MutVecRegion, name: String) Int {
  c := 0
  for s in r.op_sites {
    if op_kind_name(s.kind) == name {
      c = c + 1
    }
  }
  c
}

// ── Rewrite-level inspection (Phase 4) ──
// The suite compiles mutvec_region.tw from disk, so rewrite_module is exercised
// directly here. End-to-end WAT/emit behavior is covered by the standalone
// fixtures under fixtures/. This checks the ANF->ANF rewrite fires (or doesn't)
// by counting mutvec op calls.
fn count_calls_expr(e: AnfExpr, fid: Int) Int {
  case e {
    .Let(_, op, body) => count_calls_op(op, fid) + count_calls_expr(body, fid),
    _ => 0,
  }
}

fn count_calls_op(op: AnfOp, fid: Int) Int {
  case op {
    .ACall(callee, _) => case callee {
      .AGlobalFunc(f) => if f.id == fid {
        1
      } else {
        0
      },
      _ => 0,
    },
    .AIf(_, t, e) => count_calls_expr(t, fid) + count_calls_expr(e, fid),
    .AMatch(_, arms) => {
      n := 0
      for arm in arms {
        n = n + count_calls_expr(arm.body, fid)
      }
      n
    },
    .ALoop(b) => count_calls_expr(b, fid),
    .ADefer(b) => count_calls_expr(b, fid),
    _ => 0,
  }
}

// Count calls to the named builtin across the whole rewritten module.
fn rewritten_calls(src: String, name: String) Int {
  case pipeline.compile_source(src) {
    .Ok(a) => {
      m := mutvec_region.rewrite_module(a.opt, a.builtins)
      fid := builtins.id(a.builtins, name)
      c := 0
      for f in m.functions {
        c = c + count_calls_expr(f.body, fid.id)
      }
      c
    },
    .Err(e) => error("compile failed: ${e}"),
  }
}

// Render the additive MutVec region-audit rows for a snippet (flag-independent:
// `render_mutvec_rows` sources from records directly, so the fixed process env
// does not suppress it — the flag gating of the full census report is checked
// separately below).
fn mutvec_census(src: String) String {
  case pipeline.compile_source(src) {
    .Ok(a) => ir.render_mutvec_rows(a),
    .Err(e) => error("compile failed: ${e}"),
  }
}

// ── Task 6: mutvec repr respects route-owned typed slots ──
// Run a source snippet through the REAL codegen pipeline (mutvec_region rewrite
// -> route_typed_vec -> mutvec_repr, exactly as prepare_codegen wires it) and
// return the prepared functions, so this inspects the same PreparedModule the
// emitter consumes rather than a hand-assembled fixture.
fn prepared_funcs(src: String) Vector<PreparedFunc> {
  case pipeline.compile_source(src) {
    .Ok(a) => prepare_codegen(a.opt, a.env, a.builtins).prepared.funcs,
    .Err(e) => error("compile failed: ${e}"),
  }
}

fn is_named_wasm_type(info: SlotInfo, want: String) Bool {
  case info.wasm_type {
    .Ref(_, ht) => case ht {
      .Named(n) => n == want,
      _ => false,
    },
    _ => false,
  }
}

fn find_prepared_func(funcs: Vector<PreparedFunc>, name: String) PreparedFunc? {
  for pf in funcs {
    if pf.name == name {
      return .Some(pf)
    }
  }
  .None
}

pub fn suite() runner.Suite {
  runner
    .suite("mutvec region")
    .test(
      "collect-born indexed-update region is claimed",
      fn() {
        try assert.equal(
          region_count(
            "fn f(n: Int) Vector<Int> {\n  xs := collect i in range(n) { i }\n  xs[0] = 42\n  xs\n}\nprintln(f(5).len().to_string())\n",
          ),
          1,
        )
        .Ok({})
      },
    )
    .test(
      "Vector.make-born indexed-update region is claimed",
      fn() {
        try assert.equal(
          region_count(
            "fn f() Vector<Int> {\n  xs := Vector.make(3, 0)\n  xs[1] = 9\n  xs\n}\nprintln(f().len().to_string())\n",
          ),
          1,
        )
        .Ok({})
      },
    )
    .test(
      "indexed-update plus in-region append is claimed",
      fn() {
        try assert.equal(
          region_count(
            "fn f(n: Int) Vector<Int> {\n  xs := collect i in range(n) { i }\n  xs[0] = 7\n  xs = xs.append(99)\n  xs\n}\nprintln(f(4).len().to_string())\n",
          ),
          1,
        )
        .Ok({})
      },
    )
    .test(
      "append-only region is NOT claimed (no indexed update)",
      fn() {
        try assert.equal(
          region_count(
            "fn f(n: Int) Vector<Int> {\n  acc: Vector<Int> = []\n  for i in range(n) { acc = acc.append(i) }\n  acc\n}\nprintln(f(5).len().to_string())\n",
          ),
          0,
        )
        .Ok({})
      },
    )
    .test(
      "handle passed to a call is NOT claimed (escape)",
      fn() {
        try assert.equal(
          region_count(
            "fn sink(v: Vector<Int>) Int { v.len() }\nfn f(n: Int) Int {\n  xs := collect i in range(n) { i }\n  xs[0] = 1\n  sink(xs)\n}\nprintln(f(5).to_string())\n",
          ),
          0,
        )
        .Ok({})
      },
    )
    .test(
      "handle stored in a record is NOT claimed (escape)",
      fn() {
        try assert.equal(
          region_count(
            "type Box = .{ v: Vector<Int> }\nfn f(n: Int) Box {\n  xs := collect i in range(n) { i }\n  xs[0] = 1\n  Box.{ v: xs }\n}\nprintln(f(5).v.len().to_string())\n",
          ),
          0,
        )
        .Ok({})
      },
    )
    .test(
      "in-region get and len are supported (claimed)",
      fn() {
        try assert.equal(
          region_count(
            "fn f(n: Int) Vector<Int> {\n  xs := collect i in range(n) { i }\n  xs[0] = xs[1]\n  m := xs.len()\n  xs\n}\nprintln(f(5).len().to_string())\n",
          ),
          1,
        )
        .Ok({})
      },
    )
    .test(
      "unclaimable element type (String) is NOT claimed",
      fn() {
        // Int/Bool/Float are mutvec families; a reference element type (String) has
        // no typed mutvec family, so the region stays persistent.
        try assert.equal(
          region_count(
            "fn f(n: Int) Vector<String> {\n  xs := collect i in range(n) { \"a\" }\n  xs[0] = \"b\"\n  xs\n}\nprintln(f(5).len().to_string())\n",
          ),
          0,
        )
        .Ok({})
      },
    )
    .test(
      "unsupported in-region op (slice) is NOT claimed",
      fn() {
        try assert.equal(
          region_count(
            "fn f(n: Int) Vector<Int> {\n  xs := collect i in range(n) { i }\n  xs[0] = 1\n  xs = xs.slice(0, 1)\n  xs\n}\nprintln(f(5).len().to_string())\n",
          ),
          0,
        )
        .Ok({})
      },
    )
    .test(
      "multiple exits carrying the handle are NOT claimed",
      fn() {
        try assert.equal(
          region_count(
            "fn f(n: Int) Vector<Int> {\n  xs := collect i in range(n) { i }\n  xs[0] = 1\n  if n > 3 { return xs }\n  xs\n}\nprintln(f(5).len().to_string())\n",
          ),
          0,
        )
        .Ok({})
      },
    )
    .test(
      "sole early return carrying the handle is NOT claimed",
      fn() {
        try assert.equal(
          region_count(
            "fn f(n: Int) Vector<Int> {\n  xs := collect i in range(n) { i }\n  xs[0] = 1\n  if n > 3 { return xs }\n  []\n}\nprintln(f(5).len().to_string())\n",
          ),
          0,
        )
        .Ok({})
      },
    )
    .test(
      "parameter-sourced handle is NOT claimed (not locally born)",
      fn() {
        try assert.equal(
          region_count(
            "fn f(xs: Vector<Int>) Vector<Int> {\n  xs[0] = 1\n  xs\n}\nprintln(f([1, 2]).len().to_string())\n",
          ),
          0,
        )
        .Ok({})
      },
    )
    .test(
      "handle captured by a closure is NOT claimed (escape)",
      fn() {
        try assert.equal(
          region_count(
            "fn f(n: Int) fn() Int {\n  xs := collect i in range(n) { i }\n  xs[0] = 1\n  fn() { xs.len() }\n}\nprintln(f(5)().to_string())\n",
          ),
          0,
        )
        .Ok({})
      },
    )
    .test(
      "handle stored in a variant is NOT claimed (escape)",
      fn() {
        try assert.equal(
          region_count(
            "fn f(n: Int) Vector<Int>? {\n  xs := collect i in range(n) { i }\n  xs[0] = 1\n  .Some(xs)\n}\ncase f(5) {\n  .Some(v) => println(v.len().to_string()),\n  .None => println(\"none\"),\n}\n",
          ),
          0,
        )
        .Ok({})
      },
    )
    .test(
      "handle stored in a dict is NOT claimed (escape)",
      fn() {
        try assert.equal(
          region_count(
            "fn f(n: Int) Dict<Int, Vector<Int>> {\n  xs := collect i in range(n) { i }\n  xs[0] = 1\n  m: Dict<Int, Vector<Int>> = Dict.new()\n  m[0] = xs\n  m\n}\nprintln(f(5).len().to_string())\n",
          ),
          0,
        )
        .Ok({})
      },
    )
    .test(
      "handle stored in an outer vector is NOT claimed (escape)",
      fn() {
        try assert.equal(
          region_count(
            "fn f(n: Int) Vector<Vector<Int>> {\n  xs := collect i in range(n) { i }\n  xs[0] = 1\n  outer: Vector<Vector<Int>> = []\n  outer = outer.append(xs)\n  outer\n}\nprintln(f(5).len().to_string())\n",
          ),
          0,
        )
        .Ok({})
      },
    )
    .test(
      "unsupported in-region op (concat) is NOT claimed",
      fn() {
        try assert.equal(
          region_count(
            "fn f(n: Int) Vector<Int> {\n  xs := collect i in range(n) { i }\n  xs[0] = 1\n  xs = xs.concat([9])\n  xs\n}\nprintln(f(5).len().to_string())\n",
          ),
          0,
        )
        .Ok({})
      },
    )
    .test(
      "aliased handle (second live name) is NOT claimed (escape)",
      fn() {
        try assert.equal(
          region_count(
            "fn f(n: Int) Int {\n  xs := collect i in range(n) { i }\n  xs[0] = 1\n  ys := xs\n  xs.len() + ys.len()\n}\nprintln(f(5).to_string())\n",
          ),
          0,
        )
        .Ok({})
      },
    )
    .test(
      "record: collect producer with a single set op site",
      fn() {
        r := sole_region(
          "fn f(n: Int) Vector<Int> {\n  xs := collect i in range(n) { i }\n  xs[0] = 42\n  xs\n}\nprintln(f(5).len().to_string())\n",
        )
        try assert.equal(producer_name(r.producer), "collect")
        try assert.equal(kind_count(r, "set"), 1)
        try assert.equal(kind_count(r, "push"), 0)
        .Ok({})
      },
    )
    .test(
      "record: Vector.make producer is classified as make",
      fn() {
        r := sole_region(
          "fn f() Vector<Int> {\n  xs := Vector.make(3, 0)\n  xs[1] = 9\n  xs\n}\nprintln(f().len().to_string())\n",
        )
        try assert.equal(producer_name(r.producer), "make")
        try assert.equal(kind_count(r, "set"), 1)
        .Ok({})
      },
    )
    .test(
      "record: set + append records both a set and a push op site",
      fn() {
        r := sole_region(
          "fn f(n: Int) Vector<Int> {\n  xs := collect i in range(n) { i }\n  xs[0] = 7\n  xs = xs.append(99)\n  xs\n}\nprintln(f(4).len().to_string())\n",
        )
        try assert.equal(kind_count(r, "set"), 1)
        try assert.equal(kind_count(r, "push"), 1)
        .Ok({})
      },
    )
    .test(
      "record: in-region get and len are recorded as op sites",
      fn() {
        r := sole_region(
          "fn f(n: Int) Vector<Int> {\n  xs := collect i in range(n) { i }\n  xs[0] = xs[1]\n  m := xs.len()\n  xs\n}\nprintln(f(5).len().to_string())\n",
        )
        try assert.equal(kind_count(r, "set"), 1)
        try assert.equal(kind_count(r, "get"), 1)
        try assert.equal(kind_count(r, "len"), 1)
        .Ok({})
      },
    )
    .test(
      "rewrite: Vector.make region lowers producer + set + single boundary freeze",
      fn() {
        src := "fn f() Vector<Int> {\n  xs := Vector.make(3, 0)\n  xs[1] = 9\n  xs\n}\nprintln(f().len().to_string())\n"
        try assert.equal(rewritten_calls(src, "vector$__mutvec_make_i64"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_set_i64"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_freeze_i64"), 1)

        // The boxed producer + set are fully replaced on the claimed handle.
        try assert.equal(rewritten_calls(src, "vector$set_unsafe"), 0)
        .Ok({})
      },
    )
    .test(
      "rewrite: Vector.make region lowers in-region get and len",
      fn() {
        src := "fn f() Vector<Int> {\n  xs := Vector.make(3, 0)\n  xs[0] = xs[1]\n  m := xs.len()\n  xs\n}\nprintln(f().len().to_string())\n"
        try assert.equal(rewritten_calls(src, "vector$__mutvec_make_i64"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_get_i64"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_len_i64"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_freeze_i64"), 1)
        .Ok({})
      },
    )
    .test(
      "rewrite: collect region lowers builder chain + set + single boundary freeze",
      fn() {
        src := "fn f(n: Int) Vector<Int> {\n  xs := collect i in range(n) { i }\n  xs[0] = 42\n  xs\n}\nprintln(f(5).len().to_string())\n"

        // builder_new -> mutvec_new_i64, loop builder_push -> mutvec_push_i64
        try assert.equal(rewritten_calls(src, "vector$__mutvec_new_i64"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_push_i64"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_set_i64"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_freeze_i64"), 1)

        // the boxed builder chain + set are fully replaced on the claimed handle
        try assert.equal(rewritten_calls(src, "vector$builder_freeze"), 0)
        try assert.equal(rewritten_calls(src, "vector$set_unsafe"), 0)
        .Ok({})
      },
    )
    .test(
      "rewrite: collect Vector<Bool> region lowers to bool mutvec ops + single freeze",
      fn() {
        src := "fn f(n: Int) Vector<Bool> {\n  xs := collect i in range(n) { i > 2 }\n  xs[0] = true\n  xs\n}\nprintln(f(5).len().to_string())\n"
        try assert.equal(region_count(src), 1)

        // builder_new -> mutvec_new_bool, loop builder_push -> mutvec_push_bool,
        // indexed set -> mutvec_set_bool, single boundary freeze -> mutvec_freeze_bool.
        try assert.equal(rewritten_calls(src, "vector$__mutvec_new_bool"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_push_bool"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_set_bool"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_freeze_bool"), 1)

        // No i64 mutvec ops, and the boxed builder + set are fully replaced.
        try assert.equal(rewritten_calls(src, "vector$__mutvec_set_i64"), 0)
        try assert.equal(rewritten_calls(src, "vector$builder_freeze"), 0)
        try assert.equal(rewritten_calls(src, "vector$set_unsafe"), 0)
        .Ok({})
      },
    )
    .test(
      "rewrite: collect Vector<Float> region lowers to f64 mutvec ops + single freeze",
      fn() {
        src := "fn f(n: Int) Vector<Float> {\n  xs := collect i in range(n) { i.to_float() }\n  xs[0] = 1.5\n  xs\n}\nprintln(f(5).len().to_string())\n"
        try assert.equal(region_count(src), 1)

        try assert.equal(rewritten_calls(src, "vector$__mutvec_new_f64"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_push_f64"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_set_f64"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_freeze_f64"), 1)

        try assert.equal(rewritten_calls(src, "vector$__mutvec_set_i64"), 0)
        try assert.equal(rewritten_calls(src, "vector$builder_freeze"), 0)
        try assert.equal(rewritten_calls(src, "vector$set_unsafe"), 0)
        .Ok({})
      },
    )
    .test(
      "rewrite: collect Vector<Byte> region lowers to byte mutvec ops + single freeze",
      fn() {
        src := "fn f() Vector<Byte> {\n  src := \"abc\".utf8_bytes()\n  xs := collect i in range(src.len()) { src[i] }\n  xs[0] = src[1]\n  xs\n}\nprintln(f().len().to_string())\n"
        try assert.equal(region_count(src), 1)

        try assert.equal(rewritten_calls(src, "vector$__mutvec_new_byte"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_push_byte"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_set_byte"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_freeze_byte"), 1)

        try assert.equal(rewritten_calls(src, "vector$__mutvec_set_i64"), 0)
        try assert.equal(rewritten_calls(src, "vector$builder_freeze"), 0)
        try assert.equal(rewritten_calls(src, "vector$set_unsafe"), 0)
        .Ok({})
      },
    )
    .test(
      "rewrite: unclaimed (append-only) region emits no mutvec ops",
      fn() {
        src := "fn f(n: Int) Vector<Int> {\n  acc: Vector<Int> = []\n  for i in range(n) { acc = acc.append(i) }\n  acc\n}\nprintln(f(5).len().to_string())\n"
        try assert.equal(rewritten_calls(src, "vector$__mutvec_new_i64"), 0)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_push_i64"), 0)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_freeze_i64"), 0)
        .Ok({})
      },
    )
    .test(
      "no-escape scratch buffer is claimed with escapes=false",
      fn() {
        // xs is built, mutated by index, read-reduced to a scalar, and never
        // returned as a vector — a pure local scratch buffer.
        src := "fn f(n: Int) Int {\n  xs := collect i in range(n) { i }\n  xs[0] = 42\n  t := 0\n  for i in range(xs.len()) { t = t + xs[i] }\n  t\n}\nprintln(f(5).to_string())\n"
        try assert.equal(region_count(src), 1)
        r := sole_region(src)
        try assert.equal(r.escapes, false)
        .Ok({})
      },
    )
    .test(
      "rewrite: no-escape region lowers ops but emits NO freeze",
      fn() {
        src := "fn f(n: Int) Int {\n  xs := collect i in range(n) { i }\n  xs[0] = 42\n  t := 0\n  for i in range(xs.len()) { t = t + xs[i] }\n  t\n}\nprintln(f(5).to_string())\n"
        try assert.equal(rewritten_calls(src, "vector$__mutvec_new_i64"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_set_i64"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_get_i64"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_len_i64"), 1)

        // The distinguishing property: a non-escaping handle is never materialized.
        try assert.equal(rewritten_calls(src, "vector$__mutvec_freeze_i64"), 0)
        .Ok({})
      },
    )
    .test(
      "Vector.make no-escape scratch buffer is claimed with escapes=false",
      fn() {
        src := "fn f(n: Int) Int {\n  xs := Vector.make(n, 0)\n  xs[0] = 9\n  s := 0\n  j := 0\n  for j < xs.len() { s = s + xs[j]\n    j = j + 1 }\n  s\n}\nprintln(f(4).to_string())\n"
        try assert.equal(region_count(src), 1)
        r := sole_region(src)
        try assert.equal(r.escapes, false)
        try assert.equal(producer_name(r.producer), "make")
        .Ok({})
      },
    )
    .test(
      "two indexed writes to one handle detect a single region (no dup)",
      fn() {
        // A handle written at >=2 distinct index sites must be collected once,
        // not once per write — else it is rewritten twice (double boundary freeze).
        src := "fn f(n: Int) Vector<Int> {\n  xs := collect i in range(n) { i }\n  xs[0] = 1\n  xs[1] = 2\n  xs\n}\nprintln(f(5).len().to_string())\n"
        try assert.equal(region_count(src), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_freeze_i64"), 1)
        try assert.equal(rewritten_calls(src, "vector$__mutvec_set_i64"), 2)
        .Ok({})
      },
    )
    .test(
      "census: mutvec row records id, family, op sites, freeze exit, consumed",
      fn() {
        txt := mutvec_census(
          "fn f(n: Int) Vector<Int> {\n  xs := collect i in range(n) { i }\n  xs[0] = xs[1]\n  m := xs.len()\n  xs\n}\nprintln(f(5).len().to_string())\n",
        )
        try assert.str_contains(txt, "mutvec regions:")
        try assert.str_contains(
          txt,
          "region_id\tbegin_site\tfamily\top_sites\texit\twould_use\tconsumed",
        )
        try assert.str_contains(txt, "mv:")
        try assert.str_contains(txt, "MutVecI64")
        try assert.str_contains(txt, "collect@L")
        try assert.str_contains(txt, "set@L")
        try assert.str_contains(txt, "get@L")
        try assert.str_contains(txt, "len@L")

        // escaping region materializes at the boundary; consumed by the rewrite.
        try assert.str_contains(txt, "\tfreeze\tyes\tyes\n")
        .Ok({})
      },
    )
    .test(
      "census: no-escape scratch region reports a scratch exit",
      fn() {
        txt := mutvec_census(
          "fn f(n: Int) Int {\n  xs := collect i in range(n) { i }\n  xs[0] = 42\n  t := 0\n  for i in range(xs.len()) { t = t + xs[i] }\n  t\n}\nprintln(f(5).to_string())\n",
        )
        try assert.str_contains(txt, "mutvec regions:")
        try assert.str_contains(txt, "\tscratch\tyes\tyes\n")
        .Ok({})
      },
    )
    .test(
      "census: an unclaimed module emits no mutvec rows",
      fn() {
        txt := mutvec_census(
          "fn f(n: Int) Vector<Int> {\n  acc: Vector<Int> = []\n  for i in range(n) { acc = acc.append(i) }\n  acc\n}\nprintln(f(5).len().to_string())\n",
        )
        try assert.equal(txt, "")
        .Ok({})
      },
    )
    .test(
      "census: full --sites report carries the mutvec section for a claimed module",
      fn() {
        // The pass runs unconditionally, so the full census report surfaces the
        // region rows whenever a module claims one.
        case pipeline.compile_source(
          "fn f(n: Int) Vector<Int> {\n  xs := collect i in range(n) { i }\n  xs[0] = 42\n  xs\n}\nprintln(f(5).len().to_string())\n",
        ) {
          .Ok(a) => {
            full := ir.render_census_report(a, true)
            try assert.is_true(full.contains("mutvec regions:"))
            .Ok({})
          },
          .Err(e) => error("compile failed: ${e}"),
        }
      },
    )
    .test(
      "census: a module claiming no regions carries no mutvec section",
      fn() {
        case pipeline.compile_source(
          "fn f(n: Int) Vector<Int> {\n  acc: Vector<Int> = []\n  for i in range(n) { acc = acc.append(i) }\n  acc\n}\nprintln(f(5).len().to_string())\n",
        ) {
          .Ok(a) => {
            full := ir.render_census_report(a, true)
            try assert.is_false(full.contains("mutvec regions:"))
            .Ok({})
          },
          .Err(e) => error("compile failed: ${e}"),
        }
      },
    )
    .test(
      "prepared IR: mutvec_repr never rewrites route's typed freeze slot",
      fn() {
        // Same escaping-region fixture as the census tests above, run through the
        // real prepare_codegen pipeline: mutvec_region rewrite claims the region
        // (live handle for xs, freeze at the return boundary), then route_typed_vec
        // recognizes the freeze result as a typed PVecI64 producer and records it
        // in the routed plan, then mutvec_repr assigns the handle slots. This
        // checks all three passes agree on the boundary between them.
        funcs := prepared_funcs(
          "fn esc(n: Int) Vector<Int> {\n  xs := collect i in range(n) { i }\n  xs[0] = 42\n  xs\n}\nprintln(esc(5).len().to_string())\n",
        )
        pf := try find_prepared_func(funcs, "esc").ok_or("esc not found in prepared funcs")

        mutvec_slots := 0
        pvec_slots := 0

        for sid in pf.slots.keys() {
          case pf.slots[sid] {
            .Some(info) => case info.repr {
              .MutVec(_) => {
                mutvec_slots = mutvec_slots + 1

                // A live handle slot must be physically MutVecI64, never the
                // route-owned frozen PVecI64 wasm type.
                try assert.ok(
                  is_named_wasm_type(info, "rt_types__MutVecI64"),
                  "MutVec-repr slot S${sid.to_string()} must be wasm type rt_types__MutVecI64",
                )
              },
              .TypedVec(_) => {
                pvec_slots = pvec_slots + 1

                // The freeze-result / return slot is route-owned: it must stay
                // PVecI64 and must never be rewritten to the MutVec wasm type.
                try assert.ok(
                  is_named_wasm_type(info, "rt_types__PVecI64"),
                  "TypedVec-repr slot S${sid.to_string()} must be wasm type rt_types__PVecI64",
                )
                try assert.ok(
                  !is_named_wasm_type(info, "rt_types__MutVecI64"),
                  "route-owned TypedVec slot S${sid.to_string()} must not be MutVecI64",
                )
              },
              _ => {},
            },
            .None => {},
          }
        }

        try assert.ok(mutvec_slots >= 1, "expected at least one live MutVec handle slot")
        try assert.ok(pvec_slots >= 1, "expected the freeze-result slot to be route-owned PVecI64")
        .Ok({})
      },
    )
}
