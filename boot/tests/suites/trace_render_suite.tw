use @std.fs
use @std.testing.assert as assert
use @std.testing as runner

use lib.debug.section.{DebugSection, FileEntry, FuncDebug}
use lib.debug.stack.{Frame}
use lib.debug.trace
use lib.source.report.{RenderConfig}

fn write_fixture(path: String, content: String) Result<Void, String> {
  case fs.write_text(path, content) {
    .Ok(_) => .Ok({}),
    .Err(_) => .Err("failed to write fixture: ${path}"),
  }
}

// Stable `/tmp` root (not the session scratchpad) so the fixture works on any
// machine/session, matching lsp_definition_suite.tw's precedent. `rel_path`
// mirrors a real project-relative path (as Task 3's producer now emits),
// joined under `root` by `render_trace`/`build_disk_registry`.
root: String = "/tmp/twk_m2_trace_render_root"

rel_path: String = "src/a.tw"

// A relative path never written under `root` — proves the file-not-present
// degradation without needing a filesystem delete API (none exists in
// `@std.fs`).
missing_rel_path: String = "src/missing.tw"

fn ensure_root() Result<Void, String> {
  case fs.mkdirp("${root}/src") {
    .Ok(_) => .Ok({}),
    .Err(_) => .Err("failed to create fixture root"),
  }
}

fn sample_at(path: String) DebugSection {
  files: Vector<FileEntry> = [.{ file_id: 0, path }]
  funcs: Vector<FuncDebug> = [
    .{
      func_idx: 6,
      body_start: 100,
      lines: [
        .{
          offset: 0,
          span: .{ file_id: 0, start: 0, end: 6 },
          start_line: 1,
          start_col: 1,
          end_line: 1,
          end_col: 7,
        },
        .{
          offset: 8,
          span: .{ file_id: 0, start: 7, end: 17 },
          start_line: 2,
          start_col: 1,
          end_line: 2,
          end_col: 11,
        },
      ],
    },
  ]
  .{ files, funcs }
}

fn sample() DebugSection {
  sample_at(rel_path)
}

// A section with a user file (id 0) and an @-logical stdlib file (id 1), each
// owning its own function body, so different frames resolve to different files.
// frame_at(200,_) -> @std/io.tw:19:3 ; frame_at(110,_) -> src/a.tw:2:1 ;
// frame_at(100,_) -> src/a.tw:1:1.
fn sample_mixed() DebugSection {
  files: Vector<FileEntry> = [.{ file_id: 0, path: rel_path }, .{ file_id: 1, path: "@std/io.tw" }]
  funcs: Vector<FuncDebug> = [
    .{
      func_idx: 6,
      body_start: 100,
      lines: [
        .{
          offset: 0,
          span: .{ file_id: 0, start: 0, end: 6 },
          start_line: 1,
          start_col: 1,
          end_line: 1,
          end_col: 7,
        },
        .{
          offset: 8,
          span: .{ file_id: 0, start: 7, end: 17 },
          start_line: 2,
          start_col: 1,
          end_line: 2,
          end_col: 11,
        },
      ],
    },
    .{
      func_idx: 7,
      body_start: 200,
      lines: [
        .{
          offset: 0,
          span: .{ file_id: 1, start: 0, end: 5 },
          start_line: 19,
          start_col: 3,
          end_line: 19,
          end_col: 8,
        },
      ],
    },
  ]
  .{ files, funcs }
}

fn frame_at(offset: Int, name: String) Frame {
  .{
    module_token: .Some("wasm://wasm/abcd"),
    code_offset: offset,
    func_index: .Some(0),
    name: .Some(name),
  }
}

fn plain() RenderConfig {
  .{ color: false }
}

pub fn suite() runner.Suite {
  runner
    .suite("trace render")
    .test(
      "renders the innermost frame with a snippet and caret when the file is present under source_root",
      fn() {
        try ensure_root()
        try write_fixture("${root}/${rel_path}", "a := 1\nb := a + 2\n")

        // frame_at(110) -> body-rel 10 -> `b := a + 2` on line 2.
        out := trace.render_trace(sample(), [frame_at(110, "deeper")], "boom", plain(), root)
        try assert.str_contains(out, "error: boom")
        try assert.str_contains(out, "--> ${rel_path}:2:1")
        try assert.str_contains(out, "b := a + 2")
        try assert.str_contains(out, "^^^^^^^^^^")
        .Ok({})
      },
    )
    .test(
      "appends an ordered backtrace of resolved frames",
      fn() {
        try ensure_root()
        try write_fixture("${root}/${rel_path}", "a := 1\nb := a + 2\n")

        frames: Vector<Frame> = [frame_at(110, "deeper"), frame_at(100, "main")]
        out := trace.render_trace(sample(), frames, "boom", plain(), root)
        try assert.str_contains(out, "at deeper (${rel_path}:2:1)")
        try assert.str_contains(out, "at main (${rel_path}:1:1)")

        // deeper (innermost) must appear before main (its caller).
        deeper_at := try out.index_of("at deeper").ok_or("deeper missing")
        main_at := try out.index_of("at main").ok_or("main missing")
        try assert.is_true(deeper_at < main_at)
        .Ok({})
      },
    )
    .test(
      "drops unresolved (prelude/import) frames from the backtrace and caret",
      fn() {
        try ensure_root()
        try write_fixture("${root}/${rel_path}", "a := 1\nb := a + 2\n")

        // frame_at(50) is below every body_start -> unresolved; it must not
        // become the primary caret nor appear in the backtrace.
        frames: Vector<Frame> = [frame_at(50, "rt_core__trap"), frame_at(110, "deeper")]
        out := trace.render_trace(sample(), frames, "boom", plain(), root)
        try assert.str_contains(out, "--> ${rel_path}:2:1")
        try assert.str_contains(out, "at deeper (${rel_path}:2:1)")
        try assert.is_false(out.contains("rt_core__trap"))
        .Ok({})
      },
    )
    .test(
      "falls back to a note when no frame resolves to Twinkle source",
      fn() {
        out := trace.render_trace(sample(), [frame_at(50, "rt_core__trap")], "boom", plain(), root)
        try assert.str_contains(out, "error: boom")
        try assert.str_contains(out, "no Twinkle stack trace available")
        try assert.is_false(out.contains(" at "))
        .Ok({})
      },
    )
    .test(
      "an empty frame list falls back to the note",
      fn() {
        empty: Vector<Frame> = []
        out := trace.render_trace(sample(), empty, "boom", plain(), root)
        try assert.str_contains(out, "error: boom")
        try assert.str_contains(out, "no Twinkle stack trace available")
        .Ok({})
      },
    )
    .test(
      "degrades to location-only when the referenced file is not present under source_root",
      fn() {
        out := trace.render_trace(
          sample_at(missing_rel_path),
          [frame_at(100, "deeper")],
          "boom",
          plain(),
          root,
        )
        try assert.str_contains(out, "error: boom")
        try assert.is_false(out.contains("-->"))
        try assert.str_contains(out, "at deeper (${missing_rel_path}:1:1)")
        try assert.str_contains(out, "source unavailable")
        .Ok({})
      },
    )
    .test(
      "degrades to location-only when source_root is empty even though the file exists on disk",
      fn() {
        try ensure_root()
        try write_fixture("${root}/${rel_path}", "a := 1\nb := a + 2\n")

        out := trace.render_trace(sample(), [frame_at(110, "deeper")], "boom", plain(), "")
        try assert.str_contains(out, "error: boom")
        try assert.is_false(out.contains("-->"))
        try assert.str_contains(out, "at deeper (${rel_path}:2:1)")
        try assert.str_contains(out, "source unavailable")
        .Ok({})
      },
    )
    .test(
      "degrades to location-only for an @-logical FileEntry.path regardless of source_root",
      fn() {
        out := trace.render_trace(
          sample_at("@std/vector.tw"),
          [frame_at(100, "deeper")],
          "boom",
          plain(),
          root,
        )
        try assert.str_contains(out, "error: boom")
        try assert.is_false(out.contains("-->"))
        try assert.str_contains(out, "at deeper (@std/vector.tw:1:1)")
        try assert.str_contains(out, "source unavailable")
        .Ok({})
      },
    )
    .test(
      "points the primary caret at the first user frame when the innermost frame is @-logical stdlib",
      fn() {
        try ensure_root()
        try write_fixture("${root}/${rel_path}", "a := 1\nb := a + 2\n")

        // Innermost frame resolves to @std/io.tw; the next resolves to the user
        // file. Primary + backtrace must prefer the user frame.
        frames: Vector<Frame> = [frame_at(200, "error"), frame_at(110, "deeper")]
        out := trace.render_trace(sample_mixed(), frames, "boom", plain(), root)
        try assert.str_contains(out, "--> ${rel_path}:2:1")
        try assert.str_contains(out, "b := a + 2")
        try assert.str_contains(out, "^^^^^^^^^^")
        try assert.str_contains(out, "at deeper (${rel_path}:2:1)")
        try assert.is_false(out.contains("@std/io.tw"))
        try assert.is_false(out.contains("at error"))
        .Ok({})
      },
    )
    .test(
      "keeps both user frames and drops an interior @-logical frame from the backtrace",
      fn() {
        try ensure_root()
        try write_fixture("${root}/${rel_path}", "a := 1\nb := a + 2\n")

        // user(deeper) -> @std(error) -> user(main): both user frames stay, the
        // interior stdlib frame is dropped.
        frames: Vector<Frame> = [
          frame_at(110, "deeper"),
          frame_at(200, "error"),
          frame_at(100, "main"),
        ]
        out := trace.render_trace(sample_mixed(), frames, "boom", plain(), root)
        try assert.str_contains(out, "--> ${rel_path}:2:1")
        try assert.str_contains(out, "at deeper (${rel_path}:2:1)")
        try assert.str_contains(out, "at main (${rel_path}:1:1)")
        try assert.is_false(out.contains("@std/io.tw"))
        .Ok({})
      },
    )
    .test(
      "falls back to all resolved frames when every frame is @-logical, never empty",
      fn() {
        // An all-stdlib trap (no user frame): must still show the @ location(s),
        // not the empty "(no Twinkle stack trace available)" note.
        frames: Vector<Frame> = [frame_at(200, "error"), frame_at(200, "inner")]
        out := trace.render_trace(sample_mixed(), frames, "boom", plain(), root)
        try assert.str_contains(out, "error: boom")
        try assert.is_false(out.contains("no Twinkle stack trace available"))
        try assert.is_false(out.contains("-->"))
        try assert.str_contains(out, "at error (@std/io.tw:19:3)")
        try assert.str_contains(out, "source unavailable")
        .Ok({})
      },
    )
}
