//! Typed Vector<Int> indexed-write promotion (sub-project A).
//!
//! Two harness styles:
//!  - Routing assertions: compile a snippet, run prepare_backend_preroute +
//!    route_typed_vectors, and inspect the routed IR by builtin FuncId (exact,
//!    no WAT-substring trap). A promoted indexed set swaps set_unsafe -> set_i64
//!    and the vector slots retype to PVecI64; negatives keep neither.
//!  - Execution assertions: ordinary Twinkle that runs as part of the suite (the
//!    current promoting compiler builds it), proving the in-place vs functional
//!    (COW) semantics of a promoted write end to end. The emit-time in-place
//!    op selection (set_in_place_i64) is exercised here, since route_typed_vectors
//!    alone emits the functional set_i64 (in-place is chosen later at emit).

use @std.testing.assert as assert
use @std.testing as runner

use compiler.backend.closure_convert.{convert_closures}
use compiler.backend.phys_plan
use compiler.backend.prepare.{prepare_backend_preroute}
use compiler.backend.prepared_ir.{PreparedExpr, PreparedFunc, PreparedOp, SlotInfo}
use compiler.backend.route_typed_vec.{route_typed_vectors}
use compiler.builtins.{BuiltinRegistry}
use compiler.pipeline

type RouteInputs = .{ funcs: Vector<PreparedFunc>, builtins: BuiltinRegistry }

// Prepare + route a snippet with empty whole-program facts: a local
// collect/make producer promotes on its own (candidate path), which is all these
// fixtures exercise.
fn route_src(src: String) Result<RouteInputs, String> {
  artifacts := try pipeline.compile_source(src)
  cc := convert_closures(artifacts.opt, artifacts.env)
  pre := prepare_backend_preroute(cc.anf, artifacts.env, artifacts.builtins, cc.captures)
  routed := route_typed_vectors(
    pre.funcs,
    artifacts.builtins,
    phys_plan.empty(),
    Dict.new(),
    Dict.new(),
  ).funcs
  .Ok(.{ funcs: routed, builtins: artifacts.builtins })
}

fn is_pvec_i64(info: SlotInfo) Bool {
  case info.wasm_type {
    .Ref(_, ht) => case ht {
      .Named(n) => n == "rt_types__PVecI64",
      _ => false,
    },
    _ => false,
  }
}

fn pvec_i64_slot_count(funcs: Vector<PreparedFunc>) Int {
  n := 0

  for pf in funcs {
    for sid in pf.slots.keys() {
      case pf.slots[sid] {
        .Some(info) => if is_pvec_i64(info) {
          n = n + 1
        },
        .None => {},
      }
    }
  }

  n
}

// True if any function body calls the builtin whose FuncId is `fid_id`.
fn funcs_call_fid(funcs: Vector<PreparedFunc>, fid_id: Int) Bool {
  for pf in funcs {
    if expr_calls_fid(pf.body, fid_id) {
      return true
    }
  }

  false
}

fn expr_calls_fid(expr: PreparedExpr, fid_id: Int) Bool {
  case expr {
    .Let(_, op, body) => op_calls_fid(op, fid_id) or expr_calls_fid(body, fid_id),
    _ => false,
  }
}

fn op_calls_fid(op: PreparedOp, fid_id: Int) Bool {
  case op {
    .ACall(callee, _) => case callee {
      .AGlobalFunc(fid) => fid.id == fid_id,
      _ => false,
    },
    .AIf(_, then_e, else_e) => expr_calls_fid(then_e, fid_id) or expr_calls_fid(else_e, fid_id),
    .AMatch(_, arms) => {
      for arm in arms {
        if expr_calls_fid(arm.body, fid_id) {
          return true
        }
      }

      false
    },
    .ALoop(inner) => expr_calls_fid(inner, fid_id),
    .ADefer(inner) => expr_calls_fid(inner, fid_id),
    _ => false,
  }
}

// collect-born producer with an indexed set + a read + return.
collect_set_source :=
  \\fn f(n: Int) Vector<Int> {
  \\  xs := collect i in range(n) { i }
  \\  xs[0] = 42
  \\  y := xs[1]
  \\  println(y.to_string())
  \\  xs
  \\}
  \\println(f(5).len().to_string())
  \\

// Vector.make-born producer with an indexed set.
make_set_source :=
  \\fn f() Vector<Int> {
  \\  xs := Vector.make(3, 0)
  \\  xs[1] = 9
  \\  xs
  \\}
  \\println(f().len().to_string())
  \\

// Negative: Vector<Float> indexed set (no typed float family, so no promotion).
float_set_source :=
  \\fn f(n: Int) Vector<Float> {
  \\  xs := collect i in range(n) { 1.0 }
  \\  xs[0] = 1.5
  \\  xs
  \\}
  \\println(f(4).len().to_string())
  \\

// Negative: a Vector<Int> with an indexed set that escapes into a dict value —
// the dict store disqualifies the group, so it stays boxed.
dict_escape_source :=
  \\fn f(n: Int) Dict<Int, Vector<Int>> {
  \\  m := Dict.new()
  \\  xs := collect i in range(n) { i }
  \\  xs[0] = 1
  \\  m[0] = xs
  \\  m
  \\}
  \\println(f(4).len().to_string())
  \\

set_append_source :=
  \\fn typed_set_append(n: Int) Int {
  \\  xs := collect i in range(n) { i }
  \\  xs[0] = 42
  \\  xs = xs.append(99)
  \\  xs[1] + xs[n]
  \\}
  \\println(typed_set_append(5).to_string())
  \\

append_only_source :=
  \\fn append_only_acc(n: Int) Int {
  \\  acc: Vector<Int> = []
  \\  i := 0
  \\  for i < n {
  \\    acc = acc.append(i)
  \\    i = i + 1
  \\  }
  \\  acc[n - 1]
  \\}
  \\println(append_only_acc(5).to_string())
  \\

float_set_append_source :=
  \\fn float_set_append(n: Int) Float {
  \\  xs := collect i in range(n) { 1.0 }
  \\  xs[0] = 1.5
  \\  xs = xs.append(2.5)
  \\  xs[n]
  \\}
  \\println(float_set_append(4).to_string())
  \\

record_escape_set_append_source :=
  \\type Holder = .{ xs: Vector<Int> }
  \\fn record_escape_set_append(n: Int) Int {
  \\  xs := collect i in range(n) { i }
  \\  xs[0] = 1
  \\  xs = xs.append(9)
  \\  h := Holder.{ xs: xs }
  \\  h.xs[0] + h.xs[n]
  \\}
  \\println(record_escape_set_append(4).to_string())
  \\

collect_return_set_append_source :=
  \\fn f(n: Int) Vector<Int> {
  \\  xs := collect i in range(n) { i }
  \\  xs[0] = 42
  \\  xs = xs.append(99)
  \\  xs
  \\}
  \\println(f(5).len().to_string())
  \\

fn linked_wat_for_src(src: String) Result<String, String> {
  artifacts := try pipeline.compile_source(src)
  .Ok(pipeline.emit_wat(artifacts))
}

fn user_func_wat(src: String, name: String) Result<String, String> {
  wat := try linked_wat_for_src(src)
  out := ""
  found := false
  in_func := false

  for line in wat.lines() {
    if in_func {
      if line.starts_with("  (func ") {
        return .Ok(out)
      }
      out = .concat(line).concat("\n")
    } else if line.contains("(func $user__$") and line.contains("_".concat(name).concat(" ")) {
      found = true
      in_func = true
      out = .concat(line).concat("\n")
    }
  }

  if found {
    .Ok(out)
  } else {
    .Err("missing user WAT function for ${name}")
  }
}

fn assert_call_present(fn_wat: String, wasm_name: String) Result<Void, String> {
  assert.str_contains(fn_wat, "call $".concat(wasm_name))
}

fn assert_call_absent_exact(fn_wat: String, wasm_name: String) Result<Void, String> {
  token := "call $".concat(wasm_name)
  try assert.is_false(fn_wat.contains(token.concat("\n")))
  try assert.is_false(fn_wat.contains(token.concat(")")))
  .Ok({})
}

fn assert_boxed_pvec_absent(fn_wat: String) Result<Void, String> {
  try assert.is_false(fn_wat.contains("$rt_types__PVec)"))
  try assert.is_false(fn_wat.contains("$rt_types__PVec "))
  try assert.is_false(fn_wat.contains("$rt_types__PVec\n"))
  .Ok({})
}

// ── Multi-family execution guard (physical-repr-planner-refactor, Task 12) ──
//
// Self-host output is i64-dominated, so a wrong bool/f64/byte family tag or a
// pvec_wasm_type mismatch would NOT perturb the stage3==stage4 fixed point. This
// is a standing execution guard for the Float family, run by every `make
// boot-test` (this suite compiles and runs as ordinary Twinkle, so route_typed_vec
// physically routes these functions the same way it would any user program): a
// typed RETURN threaded through a caller, and a typed CAPTURE (a sort_by
// comparator closure reading a captured local Vector<Float> typed-only). A wrong
// family tag traps (struct-type mismatch) or reads garbage bits into a wrong
// numeric result, not just a differently-shaped WAT — matching WAT evidence for
// this same computation lives in fixtures/typed_vec_family_return_capture.tw.
// Typed RETURN: a collect-born Vector<Float>, returned and consumed typed-only
// (index + len) by its single caller.
fn family_build_scores(n: Int) Vector<Float> {
  collect i in range(n) {
    i.to_float() * 1.5
  }
}

fn family_sum_typed(n: Int) Float {
  scores := family_build_scores(n)
  t := 0.0
  for i in range(scores.len()) {
    t = t + scores[i]
  }
  t
}

// Typed CAPTURE: a local collect-born Vector<Float> captured by a sort
// comparator closure and read typed-only via index inside the closure body.
fn family_sorted_first(n: Int) Float {
  keys := collect i in range(n) {
    (n - i).to_float() * 0.25
  }
  idx := collect i in range(n) {
    i
  }
  sorted := idx.sort_by(fn(a, b) { Float.compare(keys[a], keys[b]) })
  keys[sorted[0]]
}

pub fn suite() runner.Suite {
  runner
    .suite("typed vector write")
    .test(
      "collect-born indexed set swaps set_unsafe -> set_i64 and retypes to PVecI64",
      fn() {
        p := try route_src(collect_set_source)
        set_i64 := p.builtins.id("vector$set_i64").id
        try assert.ok(funcs_call_fid(p.funcs, set_i64), "expected the set to route to set_i64")
        try assert.ok(pvec_i64_slot_count(p.funcs) > 0, "expected PVecI64 vector slots")
        .Ok({})
      },
    )
    .test(
      "Vector.make-born indexed set promotes to set_i64 + PVecI64",
      fn() {
        p := try route_src(make_set_source)
        set_i64 := p.builtins.id("vector$set_i64").id
        try assert.ok(funcs_call_fid(p.funcs, set_i64), "expected the set to route to set_i64")
        try assert.ok(pvec_i64_slot_count(p.funcs) > 0, "expected PVecI64 vector slots")
        .Ok({})
      },
    )
    .test(
      "Vector<Float> indexed set stays boxed (only vec_i64 promotes)",
      fn() {
        p := try route_src(float_set_source)
        set_i64 := p.builtins.id("vector$set_i64").id
        try assert.is_false(funcs_call_fid(p.funcs, set_i64))
        try assert.equal(pvec_i64_slot_count(p.funcs), 0)
        .Ok({})
      },
    )
    .test(
      "indexed-set vector stored into a dict stays boxed",
      fn() {
        p := try route_src(dict_escape_source)
        set_i64 := p.builtins.id("vector$set_i64").id
        set_unsafe := p.builtins.id("vector$set_unsafe").id
        try assert.is_false(funcs_call_fid(p.funcs, set_i64))

        // The boxed set path is retained.
        try assert.ok(
          funcs_call_fid(p.funcs, set_unsafe),
          "expected the boxed set_unsafe to remain",
        )
        .Ok({})
      },
    )
    .test(
      "collect indexed set plus append lowers through the mutvec scratch path",
      fn() {
        // An owned collect + indexed set (+ append) that is read locally and never
        // published is a MutVec scratch region: it lowers to mutvec_* ops with no
        // boundary freeze (nothing escapes), replacing the boxed set path.
        fn_wat := try user_func_wat(set_append_source, "typed_set_append")
        try assert_call_present(fn_wat, "rt_arr__mutvec_new_i64")
        try assert_call_present(fn_wat, "rt_arr__mutvec_set_i64")
        try assert_call_present(fn_wat, "rt_arr__mutvec_push_i64")
        try assert_call_present(fn_wat, "rt_arr__mutvec_get_i64")

        // scratch: never materialized
        try assert_call_absent_exact(fn_wat, "rt_arr__mutvec_freeze_i64")

        // the boxed set path is fully replaced on the claimed handle
        try assert_call_absent_exact(fn_wat, "rt_arr__set_unsafe")
        .Ok({})
      },
    )
    .test(
      "append-only accumulator stays boxed",
      fn() {
        fn_wat := try user_func_wat(append_only_source, "append_only_acc")
        try assert_call_absent_exact(fn_wat, "rt_arr__push_i64")
        try assert.is_false(fn_wat.contains("$rt_types__PVecI64"))
        .Ok({})
      },
    )
    .test(
      "Vector<Float> set plus append stays boxed",
      fn() {
        fn_wat := try user_func_wat(float_set_append_source, "float_set_append")
        try assert_call_absent_exact(fn_wat, "rt_arr__push_i64")
        try assert.is_false(fn_wat.contains("$rt_types__PVecI64"))
        .Ok({})
      },
    )
    .test(
      "set plus append vector stored in a record stays boxed",
      fn() {
        fn_wat := try user_func_wat(record_escape_set_append_source, "record_escape_set_append")
        try assert_call_absent_exact(fn_wat, "rt_arr__push_i64")
        try assert.is_false(fn_wat.contains("$rt_types__PVecI64"))
        .Ok({})
      },
    )
    .test(
      "collect set plus append return lowers to mutvec + single freeze, PVecI64 ABI",
      fn() {
        // An owned collect + indexed set (+ append) that is RETURNED is a MutVec
        // escaping region: it lowers to mutvec_* ops with exactly one boundary
        // freeze, and route keeps the frozen PVecI64 as the return without a rebox.
        fn_wat := try user_func_wat(collect_return_set_append_source, "f")
        try assert.str_contains(fn_wat, "(result (ref null $rt_types__PVecI64))")
        try assert_call_present(fn_wat, "rt_arr__mutvec_new_i64")
        try assert_call_present(fn_wat, "rt_arr__mutvec_set_i64")
        try assert_call_present(fn_wat, "rt_arr__mutvec_push_i64")
        try assert_call_present(fn_wat, "rt_arr__mutvec_freeze_i64")

        // returned frozen PVecI64 is not reboxed
        try assert_call_absent_exact(fn_wat, "rt_arr__box_i64")
        .Ok({})
      },
    )
    .test(
      "owned indexed set (in-place) reads back; untouched slots unchanged",
      fn() {
        xs := collect i in range(5) {
          i
        }
        xs[2] = 99
        try assert.equal(xs[2], 99)
        try assert.equal(xs[3], 3)
        try assert.equal(xs[0], 0)
        .Ok({})
      },
    )
    .test(
      "functional set through a kept alias leaves the original unchanged (COW)",
      fn() {
        xs := collect i in range(5) {
          i
        }
        ys := xs
        xs[0] = 42
        try assert.equal(ys[0], 0) // alias observes the original
        try assert.equal(xs[0], 42) // rebound name observes the new value
        .Ok({})
      },
    )
    .test(
      "deep-trie set (> 1024 elements) reads back correctly",
      fn() {
        n := 2000
        xs := collect i in range(n) {
          i
        }
        ys := xs
        xs[1500] = 777
        try assert.equal(xs[1500], 777)
        try assert.equal(xs[1499], 1499)
        try assert.equal(ys[1500], 1500) // functional set: alias unchanged
        .Ok({})
      },
    )
    .test(
      "set plus append crosses the tail boundary",
      fn() {
        xs := collect i in range(32) {
          i
        }
        xs[0] = 7
        xs = .append(1234)
        try assert.equal(xs[32], 1234)
        try assert.equal(xs.len(), 33)
        try assert.equal(xs[0], 7)
        .Ok({})
      },
    )
    .test(
      "set plus append crosses the new-root boundary",
      fn() {
        xs := collect i in range(1056) {
          i
        }
        xs[0] = 7
        xs = .append(4321)
        try assert.equal(xs[1056], 4321)
        try assert.equal(xs.len(), 1057)
        try assert.equal(xs[0], 7)
        .Ok({})
      },
    )
    .test(
      "Float family: typed return + typed capture compute correct results",
      fn() {
        // typed RETURN path: build_scores -> sum_typed, i in 0..11, Σ i*1.5 = 99.0
        try assert.equal(family_sum_typed(12), 99.0)

        // typed CAPTURE path: keys[i] = (12-i)*0.25 for i in 0..11 -> min is 0.25
        try assert.equal(family_sorted_first(12), 0.25)
        .Ok({})
      },
    )
}
