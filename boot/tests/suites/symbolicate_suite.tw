use @std.fs
use @std.testing.assert as assert
use @std.testing as runner

use lib.debug.section.{DebugSection, FileEntry, FuncDebug}
use lib.debug.stack.{Frame}
use lib.debug.symbolicate

// A debug section with two files (sparse ids 0 and 3) and two functions whose
// line programs map body-relative offsets to source spans (with precomputed
// line/col, as the producer now embeds them). body_start values are absolute
// module PCs, matching what the encoder records — so a frame's parsed
// code_offset can be looked up directly with no translation.
fn sample() DebugSection {
  files: Vector<FileEntry> = [.{ file_id: 0, path: "main.tw" }, .{ file_id: 3, path: "util.tw" }]
  funcs: Vector<FuncDebug> = [
    .{
      func_idx: 6,
      body_start: 100,
      lines: [
        .{
          offset: 0,
          span: .{ file_id: 0, start: 0, end: 6 },
          start_line: 1,
          start_col: 1,
          end_line: 1,
          end_col: 7,
        },
        .{
          offset: 8,
          span: .{ file_id: 0, start: 7, end: 17 },
          start_line: 2,
          start_col: 1,
          end_line: 2,
          end_col: 11,
        },
      ],
    },
    .{
      func_idx: 9,
      body_start: 200,
      lines: [
        .{
          offset: 0,
          span: .{ file_id: 3, start: 19, end: 20 },
          start_line: 2,
          start_col: 3,
          end_line: 2,
          end_col: 4,
        },
      ],
    },
  ]
  .{ files, funcs }
}

fn write_fixture(path: String, content: String) Result<Void, String> {
  case fs.write_text(path, content) {
    .Ok(_) => .Ok({}),
    .Err(_) => .Err("failed to write fixture: ${path}"),
  }
}

fn frame_at(offset: Int) Frame {
  .{
    module_token: .Some("wasm://wasm/abcd"),
    code_offset: offset,
    func_index: .Some(0),
    name: .Some("frame"),
  }
}

// Stable `/tmp` root (not the session scratchpad) so the fixture works on
// any machine/session, matching lsp_definition_suite.tw's precedent.
disk_registry_root: String = "/tmp/twk_m2_symbolicate_root"

pub fn suite() runner.Suite {
  runner
    .suite("symbolicate")
    .test(
      "safe_join keeps relative paths under source_root, rejects escapes/logical/absolute/empty-root",
      fn() {
        joined := try symbolicate.safe_join("/p", "src/a.tw").ok_or("expected Some")
        try assert.equal(joined, "/p/src/a.tw")
        try assert.is_none(symbolicate.safe_join("/p", "../etc/passwd"))
        try assert.is_none(symbolicate.safe_join("/p", "@std/x.tw"))
        try assert.is_none(symbolicate.safe_join("", "src/a.tw"))
        try assert.is_none(symbolicate.safe_join("/p", "/abs/x"))
        .Ok({})
      },
    )
    .test(
      "build_disk_registry reads referenced files under source_root by sparse id, skipping unreadable ones",
      fn() {
        case fs.mkdirp(disk_registry_root) {
          .Ok(_) => {},
          .Err(_) => return .Err("failed to create fixture root"),
        }
        try write_fixture("${disk_registry_root}/util.tw", "pub fn f() Int {\n  0\n}\n")

        sec: DebugSection = .{
          files: [.{ file_id: 0, path: "missing.tw" }, .{ file_id: 3, path: "util.tw" }],
          funcs: [],
        }
        reg := symbolicate.build_disk_registry(sec, disk_registry_root)

        // util.tw's "0" body is at byte 19 (line 2, col 3).
        lc := try reg.line_col(.{ file_id: 3, start: 19, end: 20 }).ok_or("no line_col")
        try assert.equal(lc.line, 2)
        try assert.equal(lc.column, 3)

        // The registry displays the relative path as-is (not the joined
        // absolute path the disk read used).
        name := try reg.file_name(3).ok_or("no file name")
        try assert.equal(name, "util.tw")

        // The missing file (sparse id 0) never made it into the registry.
        try assert.is_none(reg.file_name(0))
        .Ok({})
      },
    )
    .test(
      "maps a frame PC to its enclosing span and source location",
      fn() {
        // body_start 100 + body-rel 10 selects the second line entry (offset 8),
        // whose span is `b := a + 2` on line 2.
        resolved := symbolicate.symbolicate(sample(), [frame_at(110)])
        try assert.equal(resolved.len(), 1)

        loc := try resolved[0].location.ok_or("expected a resolved location")
        try assert.equal(loc.file, "main.tw")
        try assert.equal(loc.line, 2)
        try assert.equal(loc.column, 1)

        sp := try resolved[0].span.ok_or("expected a span")
        try assert.equal(sp.start, 7)
        try assert.equal(sp.end, 17)
        .Ok({})
      },
    )
    .test(
      "selects the first line entry at the exact body start",
      fn() {
        resolved := symbolicate.symbolicate(sample(), [frame_at(100)])
        loc := try resolved[0].location.ok_or("expected a resolved location")
        try assert.equal(loc.line, 1)
        try assert.equal(loc.column, 1)
        .Ok({})
      },
    )
    .test(
      "resolves frames that map into a different file",
      fn() {
        resolved := symbolicate.symbolicate(sample(), [frame_at(200)])
        loc := try resolved[0].location.ok_or("expected a resolved location")
        try assert.equal(loc.file, "util.tw")
        try assert.equal(loc.line, 2)
        try assert.equal(loc.column, 3)
        .Ok({})
      },
    )
    .test(
      "leaves a below-range (prelude/import) frame unresolved",
      fn() {
        // No function has body_start <= 50, so there is no enclosing span.
        resolved := symbolicate.symbolicate(sample(), [frame_at(50)])
        try assert.equal(resolved.len(), 1)
        try assert.is_none(resolved[0].span)
        try assert.is_none(resolved[0].location)
        .Ok({})
      },
    )
    .test(
      "preserves frame order and carries the original frame through",
      fn() {
        resolved := symbolicate.symbolicate(sample(), [frame_at(50), frame_at(110), frame_at(200)])
        try assert.equal(resolved.len(), 3)
        try assert.is_none(resolved[0].location)
        try assert.equal((try resolved[1].location.ok_or("loc")).line, 2)
        try assert.equal((try resolved[2].location.ok_or("loc")).file, "util.tw")

        // The parsed frame is carried through unchanged.
        try assert.equal(resolved[1].frame.code_offset, 110)
        .Ok({})
      },
    )
}
