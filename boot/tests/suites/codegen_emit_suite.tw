// ── mutable_sites: pre-prepare → prepared survival (real source) ───────────
// These prove the decision table threaded through prepare_backend_with_mutable_decisions
// survives boundary insertion/slot assignment intact, by deriving everything
// select_call_for_emit needs (base source local, prepared arg count) through
// mutable_sites itself rather than calling mutable_select.select_call directly.
type MutableAnfCallSite = .{ func: FuncId, result: LocalId, base: LocalId, arg_count: Int }

fn find_mutable_anf_call_site_expr(func_id: FuncId, expr: AnfExpr, target_id: FuncId) MutableAnfCallSite? {
  case expr {
    .Let(result, .ACall(.AGlobalFunc(callee_fid), args), body) => {
      if callee_fid.id == target_id.id and args.len() > 0 {
        case args[0] {
          .ALocal(base) => return .Some(
            MutableAnfCallSite.{ func: func_id, result, base, arg_count: args.len() },
          ),
          _ => {},
        }
      }
      find_mutable_anf_call_site_expr(func_id, body, target_id)
    },
    .Let(_, _, body) => find_mutable_anf_call_site_expr(func_id, body, target_id),
    _ => .None,
  }
}

fn find_mutable_anf_call_site(anf: AnfModule, fn_name: String, target_id: FuncId) MutableAnfCallSite {
  for f in anf.functions {
    if f.name == fn_name {
      case find_mutable_anf_call_site_expr(f.func_id, f.body, target_id) {
        .Some(site) => return site,
        .None => {},
      }
    }
  }
  error("missing pre-prepare call site for ${fn_name}")
}

type MutablePreparedCallHit = .{ result: SlotId, args: Vector<PreparedAtom> }

fn find_mutable_prepared_call_hit_expr(expr: PreparedExpr, target_id: FuncId) MutablePreparedCallHit? {
  case expr {
    .Let(result, .ACall(.AGlobalFunc(callee_fid), args), body) => {
      if callee_fid.id == target_id.id {
        return .Some(MutablePreparedCallHit.{ result, args })
      }
      find_mutable_prepared_call_hit_expr(body, target_id)
    },
    .Let(_, _, body) => find_mutable_prepared_call_hit_expr(body, target_id),
    _ => .None,
  }
}

type MutablePreparedCallSite = .{ func: PreparedFunc, result: SlotId, args: Vector<PreparedAtom> }

fn find_mutable_prepared_call_site(prepared: PreparedModule, fn_name: String, target_id: FuncId) MutablePreparedCallSite {
  for pf in prepared.funcs {
    if pf.name == fn_name {
      case find_mutable_prepared_call_hit_expr(pf.body, target_id) {
        .Some(hit) => return MutablePreparedCallSite.{
          func: pf,
          result: hit.result,
          args: hit.args,
        },
        .None => {},
      }
    }
  }
  error("missing prepared call site for ${fn_name}")
}

fn test_select_call_for_emit_survives_prepared_vector_set() Result<Void, String> {
  src := "fn set_one(xs: Vector<Int>) Vector<Int> {\n  xs[0] = 9\n  xs\n}\n"
  artifacts := try pipeline.compile_source(src)
  closure_conversion := convert_closures(artifacts.opt, artifacts.env)
  set_id := artifacts.builtins.id("vector$set_unsafe")
  in_place_id := artifacts.builtins.id("vector$set_in_place")
  pre := find_mutable_anf_call_site(closure_conversion.anf, "set_one", set_id)

  site := mutable_select.Site.{ func: pre.func, local: pre.result }
  decisions := mutable_select
    .empty_decision_table()
    .with_decision(mutable_select.MutableDecision.{
      site,
      family: mutable_select.OperationFamily.VectorSet,
      source_local: pre.base,
      result_local: pre.result,
      arg_count: pre.arg_count,
      base_arg_index: .Some(0),
      persistent_func: .Some(set_id),
      mutable_func: .Some(in_place_id),
      variant_key: .None,
      field_path_key: "",
      proof_debug_id: "emit-survival-vector-set",
    })

  prepared := prepare_backend_with_mutable_decisions(
    closure_conversion.anf,
    artifacts.env,
    artifacts.builtins,
    closure_conversion.captures,
    decisions,
  )
  hit := find_mutable_prepared_call_site(prepared, "set_one", set_id)
  pf := hit.func
  local_map := local_map_from_slots(pf.slots)
  result_entry := case local_map[hit.result.id] {
    .Some(e) => e,
    .None => return .Err("missing prepared vector-set result entry"),
  }
  ctx := mk_emit_ctx(artifacts.builtins, artifacts.env, local_map, .Some(pf.func_id))

  selected := mutable_sites.select_call_for_emit(
    prepared.mutable_decisions,
    set_id,
    hit.args,
    result_entry,
    ctx,
  )
  case selected {
    .Some(sel) => {
      try assert.equal(mutable_select.selection_reason_tag(sel.reason), 1)
      try assert.equal(sel.emit_func.id, set_id.id)
      try assert.equal(sel.would_func.id, in_place_id.id)
    },
    .None => return .Err("expected Some CallSelection for prepared vector set survival"),
  }
  .Ok({})
}

