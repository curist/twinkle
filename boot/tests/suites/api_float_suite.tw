use @std.testing.assert as assert
use @std.testing as runner

pub fn suite() runner.Suite {
  runner
    .suite("api Float")
    .test(
      "trigonometric methods bridge to the host",
      fn() {
        try assert.equal(0.0.sin(), 0.0)
        try assert.equal(0.0.cos(), 1.0)
        try assert.equal(0.0.tan(), 0.0)
        try assert.equal(0.0.asin(), 0.0)
        try assert.equal(1.0.acos(), 0.0)
        try assert.equal(0.0.atan(), 0.0)
        try assert.equal(0.0.atan2(1.0), 0.0)
        .Ok({})
      },
    )
    .test(
      "hyperbolic methods bridge to the host",
      fn() {
        try assert.equal(0.0.sinh(), 0.0)
        try assert.equal(0.0.cosh(), 1.0)
        try assert.equal(0.0.tanh(), 0.0)
        try assert.equal(0.0.asinh(), 0.0)
        try assert.equal(1.0.acosh(), 0.0)
        try assert.equal(0.0.atanh(), 0.0)
        .Ok({})
      },
    )
    .test(
      "exponential and logarithmic methods",
      fn() {
        try assert.equal(0.0.exp(), 1.0)
        try assert.equal(0.0.expm1(), 0.0)
        try assert.equal(1.0.log(), 0.0)
        try assert.equal(0.0.log1p(), 0.0)
        try assert.equal(8.0.log2(), 3.0)
        try assert.equal(100.0.log10(), 2.0)
        .Ok({})
      },
    )
    .test(
      "misc float methods",
      fn() {
        try assert.equal(27.0.cbrt(), 3.0)
        try assert.equal(3.0.hypot(4.0), 5.0)
        try assert.equal(2.0.pow(8.0), 256.0)
        try assert.equal((-2.5).sign(), -1.0)
        try assert.equal(1.0.fround(), 1.0)
        .Ok({})
      },
    )
    .test(
      "to_fixed formats with a fixed number of decimals",
      fn() {
        try assert.equal(3.14159.to_fixed(2), "3.14")
        try assert.equal(3.1.to_fixed(2), "3.10")
        try assert.equal(2.0.to_fixed(0), "2")
        try assert.equal(123.456.to_fixed(0), "123")
        try assert.equal(1234.5.to_fixed(1), "1234.5")
        try assert.equal(3.7.to_fixed(-2), "4")
        .Ok({})
      },
    )
    .test(
      "to_fixed rounds halves toward +∞, matching Float.round",
      fn() {
        try assert.equal(2.5.to_fixed(0), "3")
        try assert.equal(1.5.to_fixed(0), "2")
        try assert.equal(0.005.to_fixed(2), "0.01")
        try assert.equal((-2.5).to_fixed(0), "-2")
        try assert.equal((-2.6).to_fixed(0), "-3")
        try assert.equal((-0.005).to_fixed(2), "0.00")
        .Ok({})
      },
    )
    .test(
      "to_fixed carries and avoids negative zero",
      fn() {
        try assert.equal(9.999.to_fixed(2), "10.00")
        try assert.equal((-9.999).to_fixed(2), "-10.00")
        try assert.equal(0.0.to_fixed(2), "0.00")
        try assert.equal((-0.001).to_fixed(2), "0.00")
        .Ok({})
      },
    )
    .test(
      "is_nan and is_finite classify floats",
      fn() {
        try assert.ok(!1.5.is_nan(), "1.5 is not NaN")
        try assert.ok((0.0 / 0.0).is_nan(), "0/0 is NaN")
        try assert.ok(1.5.is_finite(), "1.5 is finite")
        try assert.ok(!(1.0 / 0.0).is_finite(), "inf is not finite")
        try assert.ok(!(0.0 / 0.0).is_finite(), "NaN is not finite")
        .Ok({})
      },
    )
}
