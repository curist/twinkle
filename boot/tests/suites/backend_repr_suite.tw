//! Tests for boot/compiler/backend/repr_assign.tw — Phase 4b.
//!
//! Verifies that repr_of_mono() and assign_repr_for_module() produce the
//! correct ReprKind and wasm_type for each slot category:
//!
//!   - Primitive scalars: Int→I64, Float→F64, Bool/Byte→I32
//!   - Typed refs: String, Vector, Dict → TypedRef
//!   - Typed sums: Optional, Result, user sums → TypedSum
//!   - Closures/functions → ClosureRef
//!   - Opaque anyref: Void, Anyref_ → OpaqueAnyref
//!   - Dead: Never → DeadValue (via DeadPlaceholder role)
//!   - Boundary overrides: AWrapAnyref result → OpaqueAnyref;
//!                         AUnwrapAnyref result → typed repr from target mono

use @std.testing.assert as assert
use @std.testing as runner

use compiler.anf.{AnfExpr, AnfFunctionDef, AnfModule}
use compiler.backend.closure_convert.{convert_closures}
use compiler.backend.phys_plan
use compiler.backend.prepare.{prepare_backend, prepare_backend_preroute}
use compiler.backend.prepared_ir.{CaptureParam, PreparedExpr, PreparedFunc, ReprKind, SlotInfo}
use compiler.backend.repr_assign.{repr_of_mono}
use compiler.backend.repr_policy.{ElemRepr}
use compiler.backend.route_typed_vec.{route_typed_vectors}
use compiler.builtins.{BuiltinRegistry, make_builtin_registry}
use compiler.codegen.wasm_ir.{AbiContract, ValType}
use compiler.codegen.wasm_plan_types.{WasmTypeRegistry}
use compiler.core_ir.{FuncId, LocalId, Param}
use compiler.elem_family.{pvec_family_of}
use compiler.mono_type.{MonoType}
use compiler.pipeline
use compiler.resolver
use compiler.resolver.{ResolvedEnv}

// ── Helpers ──────────────────────────────────────────────────────────
fn lid(n: Int) LocalId {
  LocalId.{ id: n }
}

fn fid(n: Int) FuncId {
  FuncId.{ id: n }
}

fn empty_env() ResolvedEnv {
  resolver.empty_env()
}

fn empty_registry() WasmTypeRegistry {
  WasmTypeRegistry.{
    type_defs: [],
    layout_cache: Dict.new(),
    in_progress: Dict.new(),
    type_index: Dict.new(),
    concrete_func_sigs: Dict.new(),
    closure_materialized_funcs: Dict.new(),
    typed_closure_funcs: Dict.new(),
    direct_builtin_calls: Dict.new(),
    capture_layouts: Dict.new(),
    module_globals: Dict.new(),
    module_globals_order: [],
    string_pool: Dict.new(),
    string_pool_order: [],
    string_pool_next_offset: 0,
    runtime_imports: [],
    variant_singletons: Dict.new(),
    dense_tables: Dict.new(),
    dense_tables_order: [],
  }
}

fn empty_builtins() BuiltinRegistry {
  make_builtin_registry()
}

fn no_captures() Dict<Int, Vector<CaptureParam>> {
  Dict.new()
}

fn mk_abi(params: Vector<ValType>, results: Vector<ValType>) AbiContract {
  AbiContract.{ param_types: params, result_types: results }
}

// assert_repr: check ReprKind for a given MonoType
fn assert_repr(mono: MonoType, expected: ReprKind) Result<Void, String> {
  got := repr_of_mono(mono, empty_env())
  repr_ok := case expected {
    .I64 => case got {
      .I64 => true,
      _ => false,
    },
    .F64 => case got {
      .F64 => true,
      _ => false,
    },
    .I32 => case got {
      .I32 => true,
      _ => false,
    },
    .TypedRef(_) => case got {
      .TypedRef(_) => true,
      _ => false,
    },
    .TypedSum(_) => case got {
      .TypedSum(_) => true,
      _ => false,
    },
    .TypedVec(_) => case got {
      .TypedVec(_) => true,
      _ => false,
    },
    .ClosureRef => case got {
      .ClosureRef => true,
      _ => false,
    },
    .OpaqueAnyref => case got {
      .OpaqueAnyref => true,
      _ => false,
    },
    .DeadValue => case got {
      .DeadValue => true,
      _ => false,
    },
    .ErasedSum => case got {
      .ErasedSum => true,
      _ => false,
    },
    .MutVec(_) => case got {
      .MutVec(_) => true,
      _ => false,
    },
  }

  if repr_ok {
    .Ok({})
  } else {
    assert.fail("wrong repr for mono")
  }
}

fn slot_for_local(pf: PreparedFunc, lid_id: Int) SlotInfo? {
  for sid in pf.slots.keys() {
    case pf.slots[sid] {
      .Some(info) => if info.source_local.id == lid_id {
        return .Some(info)
      },
      .None => {},
    }
  }

  .None
}

// assert_slot_repr: check ReprKind for a given LocalId's slot in a PreparedFunc
fn assert_slot_repr(pf: PreparedFunc, lid_id: Int, expected: ReprKind) Result<Void, String> {
  case slot_for_local(pf, lid_id) {
    .None => return .Err("L${lid_id} has no slot"),
    .Some(info) => {
      repr_ok := case expected {
        .I64 => case info.repr {
          .I64 => true,
          _ => false,
        },
        .F64 => case info.repr {
          .F64 => true,
          _ => false,
        },
        .I32 => case info.repr {
          .I32 => true,
          _ => false,
        },
        .TypedRef(_) => case info.repr {
          .TypedRef(_) => true,
          _ => false,
        },
        .TypedSum(_) => case info.repr {
          .TypedSum(_) => true,
          _ => false,
        },
        .TypedVec(_) => case info.repr {
          .TypedVec(_) => true,
          _ => false,
        },
        .ClosureRef => case info.repr {
          .ClosureRef => true,
          _ => false,
        },
        .OpaqueAnyref => case info.repr {
          .OpaqueAnyref => true,
          _ => false,
        },
        .DeadValue => case info.repr {
          .DeadValue => true,
          _ => false,
        },
        .ErasedSum => case info.repr {
          .ErasedSum => true,
          _ => false,
        },
        .MutVec(_) => case info.repr {
          .MutVec(_) => true,
          _ => false,
        },
      }

      if repr_ok {
        .Ok({})
      } else {
        assert.fail("L${lid_id}: wrong repr")
      }
    },
  }
}

// assert_wasm_type: check wasm_type for a given LocalId's slot
fn assert_wasm_type(pf: PreparedFunc, lid_id: Int, expected: ValType) Result<Void, String> {
  case slot_for_local(pf, lid_id) {
    .None => return .Err("L${lid_id} has no slot"),
    .Some(info) => {
      wt_ok := case expected {
        .I64 => case info.wasm_type {
          .I64 => true,
          _ => false,
        },
        .F64 => case info.wasm_type {
          .F64 => true,
          _ => false,
        },
        .I32 => case info.wasm_type {
          .I32 => true,
          _ => false,
        },
        .Anyref => case info.wasm_type {
          .Anyref => true,
          _ => false,
        },
        _ => false,
      }

      if wt_ok {
        .Ok({})
      } else {
        assert.fail("L${lid_id}: wrong wasm_type")
      }
    },
  }
}

fn mk_func_def(
  id: Int,
  name: String,
  params: Vector<Param>,
  ret: MonoType,
  body: AnfExpr,
  mono_map: Dict<Int, MonoType>,
) AnfFunctionDef {
  AnfFunctionDef.{
    func_id: fid(id),
    name,
    is_init: false,
    params,
    op_result_mono: mono_map,
    body,
    return_ty: ret,
  }
}

fn mk_module(funcs: Vector<AnfFunctionDef>) AnfModule {
  AnfModule.{
    functions: funcs,
    init_func_id: .None,
    extern_imports: Dict.new(),
    global_monos: Dict.new(),
    lib_exports: [],
  }
}

fn mk_mono_map(entries: Vector<Int>, types: Vector<MonoType>) Dict<Int, MonoType> {
  d: Dict<Int, MonoType> = Dict.new()

  for k, i in entries {
    d[k] = types[i]
  }

  d
}

fn mk_param(id: Int, ty: MonoType) Param {
  Param.{ local: lid(id), ty }
}

fn prepared_pf(params: Vector<Param>, body: AnfExpr, mono_map: Dict<Int, MonoType>, ret: MonoType) PreparedFunc {
  func := mk_func_def(1, "f", params, ret, body, mono_map)
  anf := mk_module([func])
  prepared := prepare_backend(anf, empty_env(), empty_builtins(), no_captures())
  prepared.funcs[0]
}

// ── Emit-decision fixture: typed op chosen purely from prepared physical type ──
// A typed producer flows to a consumer. emit_intrinsic_vector_append picks the
// typed op via `pvec_family_of(atom_val_type(base))` — i.e. purely from the base
// slot's prepared `wasm_type`, never from its `mono`. This fixture holds the mono
// constant (Vector<Int>) and flips only the prepared physical type, then asserts
// the exact emit selector (`pvec_family_of`) follows the physical type.
type RouteInputs = .{ funcs: Vector<PreparedFunc>, builtins: BuiltinRegistry }

// `g` returns Vector<Int>; `caller` binds `v := g()`. With no PhysPlan the
// call-result slot stays boxed; with `plan.returns[g]=I64` it becomes PVecI64 —
// same source, same slot mono, different prepared physical type.
route_source :=
  \\fn g() Vector<Int> {
  \\  collect i in range(4) { i }
  \\}
  \\fn caller() Int {
  \\  v := g()
  \\  v[0]
  \\}
  \\caller()
  \\

fn preroute_inputs(src: String) Result<RouteInputs, String> {
  artifacts := try pipeline.compile_source(src)
  cc := convert_closures(artifacts.opt, artifacts.env)
  prepared := prepare_backend_preroute(cc.anf, artifacts.env, artifacts.builtins, cc.captures)
  .Ok(.{ funcs: prepared.funcs, builtins: artifacts.builtins })
}

fn is_vector_int(m: MonoType) Bool {
  case m {
    .Vector(e) => case e {
      .Int => true,
      _ => false,
    },
    _ => false,
  }
}

fn find_func_id(funcs: Vector<PreparedFunc>, name: String) Int? {
  for pf in funcs {
    if pf.name == name {
      return .Some(pf.func_id.id)
    }
  }

  .None
}

type CallSite = .{ func_index: Int, slot: Int }

// Locate the (func_index, slot) of the first `let slot = call(fid_id)` binding.
fn find_call_result_slot(expr: PreparedExpr, fid_id: Int) Int? {
  case expr {
    .Let(slot, op, body) => case op {
      .ACall(.AGlobalFunc(fid), _) => if fid.id == fid_id {
        .Some(slot.id)
      } else {
        find_call_result_slot(body, fid_id)
      },
      _ => find_call_result_slot(body, fid_id),
    },
    _ => .None,
  }
}

fn find_call_site(funcs: Vector<PreparedFunc>, fid_id: Int) CallSite? {
  for pf, fi in funcs {
    case find_call_result_slot(pf.body, fid_id) {
      .Some(sid) => return .Some(.{ func_index: fi, slot: sid }),
      .None => {},
    }
  }

  .None
}

// The emit selector: `pvec_family_of(base_vt).mono_key == "vec_i64"` is exactly
// how emit_intrinsic_vector_append decides `rt_arr__push_i64` vs `rt_arr__push`.
fn emit_picks_i64_op(info: SlotInfo) Bool {
  case pvec_family_of(info.wasm_type) {
    .Some(fam) => fam.mono_key == "vec_i64",
    .None => false,
  }
}

// ── repr_of_mono tests ────────────────────────────────────────────────
pub fn suite() runner.Suite {
  runner
    .suite("backend repr assign (Phase 4b)")
    .test("Int → I64", fn() { assert_repr(.Int, .I64) })
    .test("Float → F64", fn() { assert_repr(.Float, .F64) })
    .test("Bool → I32", fn() { assert_repr(.Bool, .I32) })
    .test("Byte → I32", fn() { assert_repr(.Byte, .I32) })
    .test(
      "String → TypedRef",
      fn() {
        assert_repr(.String, .TypedRef(.String))
      },
    )
    .test(
      "Vector<Int> → TypedRef",
      fn() {
        assert_repr(.Vector(.Int), .TypedRef(.Vector(.Int)))
      },
    )
    .test(
      "Dict<String,Int> → TypedRef",
      fn() {
        assert_repr(.Dict(.String, .Int), .TypedRef(.Dict(.String, .Int)))
      },
    )
    .test(
      "Optional<Int> → TypedSum",
      fn() {
        assert_repr(.Optional(.Int), .TypedSum(.Optional(.Int)))
      },
    )
    .test(
      "Result<Int,String> → TypedSum",
      fn() {
        assert_repr(.Result(.Int, .String), .TypedSum(.Result(.Int, .String)))
      },
    )
    .test(
      "Function → ClosureRef",
      fn() {
        assert_repr(.Function([.Int], .Bool), .ClosureRef)
      },
    )
    .test("Void → OpaqueAnyref", fn() { assert_repr(.Void, .OpaqueAnyref) })
    .test("Anyref_ → OpaqueAnyref", fn() { assert_repr(.Anyref_, .OpaqueAnyref) })
    .test("Never → DeadValue", fn() { assert_repr(.Never, .DeadValue) })
    .test(
      "Int param slot gets I64 repr and I64 wasm_type",
      fn() {
        // fn f(x: Int) Int { x }
        body: AnfExpr = .Atom(.ALocal(lid(0)))
        pf := prepared_pf([mk_param(0, .Int)], body, Dict.new(), .Int)
        try assert_slot_repr(pf, 0, .I64)
        try assert_wasm_type(pf, 0, .I64)
        .Ok({})
      },
    )
    .test(
      "String param slot gets TypedRef repr",
      fn() {
        body: AnfExpr = .Atom(.ALocal(lid(0)))
        pf := prepared_pf([mk_param(0, .String)], body, Dict.new(), .String)
        assert_slot_repr(pf, 0, .TypedRef(.String))
      },
    )
    .test(
      "Bool param slot gets I32 repr",
      fn() {
        body: AnfExpr = .Atom(.ALitBool(true))
        pf := prepared_pf([mk_param(0, .Bool)], body, Dict.new(), .Bool)
        assert_slot_repr(pf, 0, .I32)
      },
    )
    .test(
      "Optional<Int> let-local gets TypedSum repr",
      fn() {
        // fn f(x: Int) Optional<Int> { let t0 = call(fn#99, [x]); t0 }
        body: AnfExpr = .Let(
          lid(10),
          .ACall(.AGlobalFunc(fid(99)), [.ALocal(lid(0))]),
          .Atom(.ALocal(lid(10))),
        )
        pf := prepared_pf(
          [mk_param(0, .Int)],
          body,
          mk_mono_map([10], [MonoType.Optional(.Int)]),
          .Optional(.Int),
        )
        assert_slot_repr(pf, 10, .TypedSum(.Optional(.Int)))
      },
    )
    .test(
      "Never-typed local gets DeadValue repr",
      fn() {
        body: AnfExpr = .Let(lid(10), .ACall(.AGlobalFunc(fid(99)), []), .Atom(.ALitVoid))
        pf := prepared_pf([], body, mk_mono_map([10], [MonoType.Never]), .Void)
        assert_slot_repr(pf, 10, .DeadValue)
      },
    )
    .test(
      "AWrapAnyref result local gets OpaqueAnyref repr",
      fn() {
        // insert_boundaries wraps Int args to anyref builtins.
        // The wrap temp local should get OpaqueAnyref repr even though its
        // op_result_mono says Anyref_.
        builtins := empty_builtins().runtime_with_abi(
          "store",
          "rt.test",
          "store",
          mk_abi([.Anyref], [.Anyref]),
        )
        store_fid := builtins.id("store")
        body: AnfExpr = .Let(
          lid(10),
          .ACall(.AGlobalFunc(store_fid), [.ALocal(lid(0))]),
          .Atom(.ALitVoid),
        )
        func := mk_func_def(
          1,
          "f",
          [mk_param(0, .Int)],
          .Void,
          body,
          mk_mono_map([10], [MonoType.Void]),
        )
        anf := mk_module([func])
        prepared := prepare_backend(anf, empty_env(), builtins, no_captures())
        pf := prepared.funcs[0]

        // The wrap temp (allocated after L10) must be OpaqueAnyref
        // Scan all let locals for AWrapAnyref
        has_opaque_wrap := false

        for sid_int in pf.slots.keys() {
          case pf.slots[sid_int] {
            .None => {},
            .Some(info) => case info.repr {
              .OpaqueAnyref => {
                has_opaque_wrap = true
              },
              _ => {},
            },
          }
        }

        if has_opaque_wrap {
          .Ok({})
        } else {
          assert.fail("no OpaqueAnyref slot found for wrap temp")
        }
      },
    )
    .test(
      "AUnwrapAnyref result local gets typed repr from target mono",
      fn() {
        // Unwrapping from anyref to Int → result slot gets I64 repr
        // This happens when a runtime fn returns anyref but result mono is Int.
        builtins := empty_builtins().runtime_with_abi(
          "get_int",
          "rt.test",
          "get_int",
          mk_abi([.Anyref], [.Anyref]),
        )
        get_fid := builtins.id("get_int")
        body: AnfExpr = .Let(
          lid(10),
          .ACall(.AGlobalFunc(get_fid), [.ALocal(lid(0))]),
          .Atom(.ALocal(lid(10))),
        )
        func := mk_func_def(
          1,
          "f",
          [mk_param(0, .String)],
          .Int,
          body,
          mk_mono_map([10], [MonoType.Int]),
        )
        anf := mk_module([func])
        prepared := prepare_backend(anf, empty_env(), builtins, no_captures())
        pf := prepared.funcs[0]

        // L10 was the call result (now replaced by unwrap chain):
        // insert_boundaries produces: raw = call(...); L10 = AUnwrapAnyref(raw, Int)
        // So L10 should get I64 repr (from AUnwrapAnyref target mono = Int)
        try assert_slot_repr(pf, 10, .I64)
        try assert_wasm_type(pf, 10, .I64)
        .Ok({})
      },
    )
    .test(
      "emit selects typed vector op purely from prepared physical type, not mono",
      fn() {
        inputs := try preroute_inputs(route_source)
        gid := try find_func_id(inputs.funcs, "g").ok_or("g not found")
        site := try find_call_site(inputs.funcs, gid).ok_or("no call to g in caller")

        // Boxed route (empty PhysPlan): the call-result slot stays a boxed PVec.
        boxed := route_typed_vectors(
          inputs.funcs,
          inputs.builtins,
          phys_plan.empty(),
          Dict.new(),
          Dict.new(),
        ).funcs
        boxed_slot := try boxed[site.func_index].slots[site.slot].ok_or("boxed slot missing")

        // Typed route: PhysPlan carries g's typed return, so the SAME slot's
        // prepared wasm_type becomes PVecI64 — the mono is unchanged.
        plan := phys_plan.empty()
        plan.returns["${gid}"] = ElemRepr.I64
        routed := route_typed_vectors(inputs.funcs, inputs.builtins, plan, Dict.new(), Dict.new()).funcs
        typed_slot := try routed[site.func_index].slots[site.slot].ok_or("typed slot missing")

        // The semantic type is identical in both routings; only the prepared
        // physical type differs. A mono-driven decision could not tell them apart.
        try assert.ok(
          is_vector_int(boxed_slot.mono) and is_vector_int(typed_slot.mono),
          "both slots must carry the same Vector<Int> mono",
        )

        // emit's exact selector follows the prepared physical type: boxed → the
        // generic op, PVecI64 → the typed op.
        try assert.ok(
          !emit_picks_i64_op(boxed_slot),
          "boxed physical type must select the generic rt_arr__push",
        )
        try assert.ok(
          emit_picks_i64_op(typed_slot),
          "PVecI64 physical type must select the typed rt_arr__push_i64",
        )
        .Ok({})
      },
    )
}
