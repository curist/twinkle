//! Tests for boot/compiler/backend/repr_policy.tw — the pure vector
//! element-representation classification shared by repr_assign and wasm_layout.
//!
//! M1a supports only Vector<Int> -> .Some(.I64); every other vector (and any
//! non-vector) classifies as .None and stays boxed.

use @std.testing.assert as assert
use @std.testing as runner

use compiler.backend.repr_policy.{boxed_mutvec_family_of, candidate_typed_vec_family}
use compiler.mono_type.{MonoType}

pub fn suite() runner.Suite {
  runner
    .suite("backend repr policy")
    .test(
      "Vector<Int> → Some(I64)",
      fn() {
        try assert.is_true(candidate_typed_vec_family(.Vector(.Int)) == .Some(.I64))
        .Ok({})
      },
    )
    .test(
      "Vector<Float> → Some(F64)",
      fn() {
        try assert.is_true(candidate_typed_vec_family(.Vector(.Float)) == .Some(.F64))
        .Ok({})
      },
    )
    .test(
      "Vector<Byte> → Some(Byte)",
      fn() {
        // Byte reads into i32 like Bool, but keys a distinct ElemRepr so its
        // mutvec handle resolves to MutVecByte rather than MutVecBool.
        try assert.is_true(candidate_typed_vec_family(.Vector(.Byte)) == .Some(.Byte))
        .Ok({})
      },
    )
    .test(
      "Vector<String> stays boxed → None",
      fn() {
        try assert.is_true(candidate_typed_vec_family(.Vector(.String)) == .None)
        .Ok({})
      },
    )
    .test(
      "non-vector → None",
      fn() {
        try assert.is_true(candidate_typed_vec_family(.Int) == .None)
        .Ok({})
      },
    )
    .test(
      "boxed family accepts concrete GC-reference vector elements",
      fn() {
        try assert.is_true(boxed_mutvec_family_of(.Vector(.String)).is_some())
        try assert.is_true(boxed_mutvec_family_of(.Vector(.Named(.{ id: 7 }, []))).is_some())
        try assert.is_true(boxed_mutvec_family_of(.Vector(.Vector(.String))).is_some())
        try assert.is_true(boxed_mutvec_family_of(.Vector(.Function([.Int], .String))).is_some())
        try assert.is_true(boxed_mutvec_family_of(.Vector(.Optional(.String))).is_some())
        .Ok({})
      },
    )
    .test(
      "boxed family rejects primitives externrefs and unresolved sentinels",
      fn() {
        rejected: Vector<MonoType> = [
          .Vector(.Int),
          .Vector(.Float),
          .Vector(.Bool),
          .Vector(.Byte),
          .Vector(.ExternRef(.{ id: 9 })),
          .Vector(.Optional(.ExternRef(.{ id: 9 }))),
          .Vector(.Void),
          .Vector(.Never),
          .Vector(.Anyref_),
          .Vector(.Var("T")),
          .Vector(.MetaVar(3)),
          .Vector(.ErrorType),
        ]
        for mono in rejected {
          try assert.is_true(boxed_mutvec_family_of(mono) == .None)
        }
        .Ok({})
      },
    )
}
