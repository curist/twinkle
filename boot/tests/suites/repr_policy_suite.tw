//! Tests for boot/compiler/backend/repr_policy.tw — the pure vector
//! element-representation classification shared by repr_assign and wasm_layout.
//!
//! M1a supports only Vector<Int> -> .Some(.I64); every other vector (and any
//! non-vector) classifies as .None and stays boxed.

use @std.testing.assert as assert
use @std.testing as runner

use compiler.backend.repr_policy.{candidate_typed_vec_family}

pub fn suite() runner.Suite {
  runner
    .suite("backend repr policy")
    .test(
      "Vector<Int> → Some(I64)",
      fn() {
        try assert.is_true(candidate_typed_vec_family(.Vector(.Int)) == .Some(.I64))
        .Ok({})
      },
    )
    .test(
      "Vector<Float> → Some(F64)",
      fn() {
        try assert.is_true(candidate_typed_vec_family(.Vector(.Float)) == .Some(.F64))
        .Ok({})
      },
    )
    .test(
      "Vector<Byte> → Some(Byte)",
      fn() {
        // Byte reads into i32 like Bool, but keys a distinct ElemRepr so its
        // mutvec handle resolves to MutVecByte rather than MutVecBool.
        try assert.is_true(candidate_typed_vec_family(.Vector(.Byte)) == .Some(.Byte))
        .Ok({})
      },
    )
    .test(
      "Vector<String> stays boxed → None",
      fn() {
        try assert.is_true(candidate_typed_vec_family(.Vector(.String)) == .None)
        .Ok({})
      },
    )
    .test(
      "non-vector → None",
      fn() {
        try assert.is_true(candidate_typed_vec_family(.Int) == .None)
        .Ok({})
      },
    )
}
