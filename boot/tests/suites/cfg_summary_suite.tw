          FieldId.{ id: 0 },
          .ALocal(lid(1)),
          false,
          TypeId.{ id: 0 },
        )
        body: AnfExpr = .Let(lid(1), dict_new_call(b), .Let(lid(2), u0, .Atom(.ALocal(lid(0)))))
        s := summ1("f", 1, body)
        try assert.equal(p_role(s, 0), role_tag(.Borrowed))
        try assert.equal(s.params[0].in_place_paths.paths.len(), 0)
        .Ok({})
      },
    )
