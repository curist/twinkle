        try assert.equal(gs.params[0].in_place_paths.paths.len(), 0)
        try assert.equal(p_escape(gs, 0), escape_tag(.Borrowed))
        g := fdef(2, "g", 1, g_body)
        f_body: AnfExpr = .Let(
          lid(0),
          dict_new_call(b),
          .Let(
            lid(1),
            .ACall(.AGlobalFunc(FuncId.{ id: 2 }), [.ALocal(lid(0))]),
            .Atom(.ALocal(lid(0))),
          ),
        )
        f := analyzed_caller([fdef(1, "f", 0, f_body), g], "f")
        case f.blocks[0].exit.binding_valid.get(0) {
          .Some(v) => try assert.is_true(v),
          .None => {}, // absent => valid
        }
        .Ok({})
      },
    )
