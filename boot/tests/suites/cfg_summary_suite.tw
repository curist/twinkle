        vop := AnfOp.AVariant(TypeId.{ id: 0 }, VariantId.{ id: 7 }, [.ALocal(lid(1))])
        body: AnfExpr = .Let(lid(1), inner, .Let(lid(2), vop, .Atom(.ALocal(lid(2)))))
        s := summ1("f", 1, body)
        try assert.equal(s.ret_paths.len(), 2)
        try assert.equal(has_variant_shell_fresh(s.ret_paths, 7, 0), true)
        try assert.equal(has_variant_field_from(s.ret_paths, 7, 0, 0, 0), true)
        .Ok({})
      },
    )
    .test(
      "two-tag Result: tag-aware meet keeps both arms (Ok[0].f0=from(p0), not erased)",
      fn() {
        // load(s): if c { return .Ok(Record{f0:s}) }  return .Err(Record{f0:fresh}).
        // The Ok and Err returns carry DIFFERENT variant tags; a plain-intersection
        // meet drops both (empty ret_paths). The tag-aware meet meets each tag's
        // paths only across sites that can return that tag, so both arms survive.
        b := b_reg()
        ok_rec := AnfOp.ARecord(
          TypeId.{ id: 0 },
          [.{ field: FieldId.{ id: 0 }, value: .ALocal(lid(0)) }],
        )
        ok_var := AnfOp.AVariant(TypeId.{ id: 0 }, VariantId.{ id: 0 }, [.ALocal(lid(1))])
        then_b: AnfExpr = .Let(
          lid(1),
          ok_rec,
          .Let(lid(2), ok_var, .Return(.Some(.ALocal(lid(2))))),
        )
        err_rec := AnfOp.ARecord(
          TypeId.{ id: 0 },
          [.{ field: FieldId.{ id: 0 }, value: .ALocal(lid(3)) }],
        )
        err_var := AnfOp.AVariant(TypeId.{ id: 0 }, VariantId.{ id: 1 }, [.ALocal(lid(4))])
        else_b: AnfExpr = .Let(
          lid(3),
          dict_new_call(b),
          .Let(lid(4), err_rec, .Let(lid(5), err_var, .Return(.Some(.ALocal(lid(5)))))),
        )
        body: AnfExpr = .Let(lid(6), .AIf(.ALitBool(true), then_b, else_b), .Return(.None))
        s := summ1("load", 1, body)
        try assert.equal(has_variant_field_from(s.ret_paths, 0, 0, 0, 0), true) // Ok[0].f0=from(p0) survives
        try assert.equal(s.ret_paths.len(), 4) // V(Ok)[0]=fresh, V(Ok)[0].f0=from(p0), V(Err)[0]=fresh, V(Err)[0].f0=fresh
        .Ok({})
      },
    )
    .test(
      "Option transport: Some[0].f0=from(p0) survives a payload-less None return",
      fn() {
        // maybe_load(s): if c { return .Some(Record{f0:s}) }  return .None.
        // .None is a PAYLOAD-LESS variant (different tag, no payload paths). A plain
        // intersection would treat "absent on None" as contradiction and drop the
        // Some payload path. The tag-aware meet gives the None site a WVariant(None)
        // witness (via the constructor op-scan), so it can't produce Some paths and is
        // irrelevant to them -> Some[0].f0 survives.
        some_rec := AnfOp.ARecord(
          TypeId.{ id: 0 },
          [.{ field: FieldId.{ id: 0 }, value: .ALocal(lid(0)) }],
        )
        some_var := AnfOp.AVariant(TypeId.{ id: 0 }, VariantId.{ id: 0 }, [.ALocal(lid(1))])
        then_b: AnfExpr = .Let(
          lid(1),
          some_rec,
          .Let(lid(2), some_var, .Return(.Some(.ALocal(lid(2))))),
        )
        none_var := AnfOp.AVariant(TypeId.{ id: 0 }, VariantId.{ id: 1 }, []) // payload-less .None
        else_b: AnfExpr = .Let(lid(3), none_var, .Return(.Some(.ALocal(lid(3)))))
        body: AnfExpr = .Let(lid(4), .AIf(.ALitBool(true), then_b, else_b), .Return(.None))
        s := summ1("maybe_load", 1, body)
        try assert.equal(has_variant_field_from(s.ret_paths, 0, 0, 0, 0), true) // Some[0].f0=from(p0) survives
        try assert.equal(s.ret_paths.len(), 2) // V(Some)[0]=fresh, V(Some)[0].f0=from(p0); None contributes nothing
        .Ok({})
      },
    )
