fn synthetic_threading_target_args_view() cfg.CfgView {
  b0 := cfg_empty_block(0, "entry", [])
  b0.terminator = .Some(.Branch(cfg.BlockId.{ id: 1 }, [.ALitBool(false)]))
  b0.succs = [cfg.CfgEdge.{ target: cfg.BlockId.{ id: 1 }, args: [.ALitBool(false)] }]

  b1 := cfg_empty_block(1, "arg.join", [lid(0)])
  b1.instructions = [
    cfg.CfgInstruction.{ anf_local: lid(10), op: .AInit(.ALocal(lid(0))), text: "init L0" },
  ]
  b1.terminator = .Some(
    .CondBranch(
      .ALocal(lid(10)),
      cfg.BlockId.{ id: 2 },
      [.ALitInt(1)],
      cfg.BlockId.{ id: 3 },
      [.ALitInt(2)],
    ),
  )
  b1.preds = [cfg.CfgEdge.{ target: cfg.BlockId.{ id: 0 }, args: [.ALitBool(false)] }]
  b1.succs = [
    cfg.CfgEdge.{ target: cfg.BlockId.{ id: 2 }, args: [.ALitInt(1)] },
    cfg.CfgEdge.{ target: cfg.BlockId.{ id: 3 }, args: [.ALitInt(2)] },
  ]

  b2 := cfg_empty_block(2, "then", [lid(20)])
  b2.preds = [cfg.CfgEdge.{ target: cfg.BlockId.{ id: 1 }, args: [.ALitInt(1)] }]
  b2.terminator = .Some(.Return(.None))

  b3 := cfg_empty_block(3, "else", [lid(30)])
  b3.preds = [cfg.CfgEdge.{ target: cfg.BlockId.{ id: 1 }, args: [.ALitInt(2)] }]
  b3.terminator = .Some(.Return(.None))

  cfg.CfgView.{
    functions: [
      cfg.CfgFunction.{ func_id: 9003, name: "target_args", params: [], blocks: [b0, b1, b2, b3] },
    ],
  }
}

fn dict_new_call(b: builtins.BuiltinRegistry) AnfOp {
  .ACall(.AGlobalFunc(b.method_id("Dict", "new")), [])
}

fn vector_make_call(b: builtins.BuiltinRegistry) AnfOp {
  .ACall(.AGlobalFunc(b.method_id("Vector", "make")), [])
}

fn wrapper_record(field_val: LocalId) AnfOp {
  // TypeId/FieldId are structural placeholders; build_view/summary do not need a
  // real type table. FieldAtom.{ field, value }.
  .ARecord(TypeId.{ id: 0 }, [.{ field: FieldId.{ id: 0 }, value: .ALocal(field_val) }])
}

fn fdef(id: Int, name: String, nparams: Int, body: AnfExpr) AnfFunctionDef {
  params: Vector<Param> = collect i in range(nparams) {
    Param.{ local: lid(i), ty: MonoType.Int }
  }
  AnfFunctionDef.{
    func_id: FuncId.{ id },
    name,
    is_init: false,
    params,
    op_result_mono: Dict.new(),
    body,
    return_ty: MonoType.Int,
  }
}

fn module_of(funcs: Vector<AnfFunctionDef>) AnfModule {
  AnfModule.{
    functions: funcs,
    init_func_id: .None,
    extern_imports: Dict.new(),
    global_monos: Dict.new(),
    lib_exports: [],
  }
}

fn summ1(name: String, nparams: Int, body: AnfExpr) ownership.Summary {
  b := b_reg()
  m := module_of([fdef(1, name, nparams, body)])
  v := cfg.build_view(m, b)
  case cfg.function_named(v, name) {
    .Some(f) => ownership.summarize_function(
      f,
      ownership.empty_summary_table(),
      b,
      sem(),
      Dict.new(),
    ),
    .None => error("missing ${name}"),
  }
}

// Build a CfgFunction from a body (mirrors summ1 but returns the CFG function so
// the dirty-path dataflow can be unit-tested directly).
fn cfg_func_of(name: String, nparams: Int, body: AnfExpr) cfg.CfgFunction {
  b := b_reg()
  v := cfg.build_view(module_of([fdef(1, name, nparams, body)]), b)
  case cfg.function_named(v, name) {
    .Some(f) => f,
    .None => error("missing ${name}"),
  }
}

// Param `k`'s dirty [.f] paths as sorted field ids. collect_field_reqs does NOT add
// the shell — that is build_in_place_paths — so every path here is a single field.
fn dirty_fields(reqs: Dict<Int, variant_id.PathSet>, k: Int) Vector<Int> {
  case reqs.get(k) {
    .Some(ps) => {
      out: Vector<Int> = []
      for p in ps.paths {
        if p.segs.len() == 1 {
          out = .append(p.segs[0])
        }
      }
      out
    },
    .None => [],
  }
}

fn escape_tag(e: ownership.EscapeEffect) Int {
  case e {
    .Borrowed => 0,
    .Retained => 1,
  }
}

fn p_escape(s: ownership.Summary, i: Int) Int {
  // compat: old escape tag is 1 (Retained) iff the reconciled role is Published.
  case s.params[i].base_role {
    .Published => 1,
    _ => 0,
  }
}

fn role_tag(r: ownership.ParamRole) Int {
  case r {
    .Borrowed => 0,
    .Consumed => 1,
    .Published => 2,
  }
}

fn p_role(s: ownership.Summary, i: Int) Int {
  role_tag(s.params[i].base_role)
}

fn ret_tag(r: ownership.ReturnEffect) Int {
  case r {
    .OwnedFresh => 0,
    .MayAliasParams(_) => 1,
    .Shared => 2,
  }
}

// Exact alias set, or [] for non-alias returns.
fn ret_alias_set(r: ownership.ReturnEffect) Vector<Int> {
  case r {
    .MayAliasParams(s) => s,
    _ => [],
  }
}

fn same_ints(a: Vector<Int>, b: Vector<Int>) Bool {
  if a.len() != b.len() {
    return false
  }
  for x, i in a {
    if x != b[i] {
      return false
    }
  }
  true
}

// A one-param callee summary with the given role + in_place_paths, for select_variant tests.
fn one_param_summary(role: ownership.ParamRole, ipp: variant_id.PathSet) ownership.Summary {
  ownership.Summary.{
    params: [ownership.ParamSummary.{ base_role: role, in_place_paths: ipp, flows_to_return: true }],
    ret: .MayAliasParams([0]),
    ret_paths: [],
  }
}

// The field ids of a VariantId's [.f] reqs on param k, sorted (shell reqs excluded).
fn variant_fields(v: variant_id.VariantId, k: Int) Vector<Int> {
  out: Vector<Int> = []
  for r in v.unique {
    if r.param == k and r.path.segs.len() == 1 {
      out = .append(r.path.segs[0])
    }
  }
  out
}

fn compute_of(funcs: Vector<AnfFunctionDef>) ownership.SummaryTable {
  b := b_reg()
  v := cfg.build_view(module_of(funcs), b)
  summary.compute(v, b, sem())
}

fn summ_of(t: ownership.SummaryTable, func_id: Int) ownership.Summary {
  case ownership.summary_get(t, func_id) {
    .Some(s) => s,
    .None => error("no summary ${func_id}"),
  }
}

fn analyzed_caller(funcs: Vector<AnfFunctionDef>, caller: String) cfg.CfgFunction {
  b := b_reg()
  v := cfg.build_view(module_of(funcs), b)
  t := summary.compute(v, b, sem())
  a := ownership.analyze_with_summaries(v, b, sem(), t)
  case cfg.function_named(a, caller) {
    .Some(f) => f,
    .None => error("no ${caller}"),
  }
}

// exit ownership of a local in the caller's entry block (block 0).
fn caller_own(f: cfg.CfgFunction, local_id: Int) Int {
  case f.blocks[0].exit.ownership.get(local_id) {
    .Some(tag) => tag,
    .None => 2,
  }
}

fn own_unique() Int {
  ownership.own_tag(.Unique)
}

fn own_shared() Int {
  ownership.own_tag(.Shared)
}

// Flatten Direct ret_paths to [field, param, field, param, ...] sorted by field.
fn ret_path_pairs(rps: Vector<ownership.ReturnPathOwn>) Vector<Int> {
  pairs: Vector<Int> = []
  for r in rps {
    case r.via {
      .Direct => case r.field {
        .Some(f) => case r.own {
          .OwnedFromParam(k) => {
            pairs = .append(f)
            pairs = .append(k)
          },
          .OwnedFresh => {
            pairs = .append(f)
            pairs = .append(0 - 1)
          },
        },
        .None => {},
      },
      .Variant(_, _) => {},
    }
  }
  pairs
}

fn has_variant_shell_fresh(rps: Vector<ownership.ReturnPathOwn>, tag: Int, idx: Int) Bool {
  for r in rps {
    match := case r.via {
      .Variant(t, i) => t == tag and i == idx,
      .Direct => false,
    }
    is_shell_fresh := case r.field {
      .None => case r.own {
        .OwnedFresh => true,
        .OwnedFromParam(_) => false,
      },
      .Some(_) => false,
    }
    if match and is_shell_fresh {
      return true
    }
  }
  false
}

fn has_variant_field_from(
  rps: Vector<ownership.ReturnPathOwn>,
  tag: Int,
  idx: Int,
  field: Int,
  param: Int,
) Bool {
  for r in rps {
    via_ok := case r.via {
      .Variant(t, i) => t == tag and i == idx,
      .Direct => false,
    }
    fld_ok := case r.field {
      .Some(f) => f == field,
      .None => false,
    }
    own_ok := case r.own {
      .OwnedFromParam(k) => k == param,
      .OwnedFresh => false,
    }
    if via_ok and fld_ok and own_ok {
      return true
    }
  }
  false
}

// Some ret_path is a Direct .field=k backed by OwnedFromParam(k).
fn has_from_param_path(rps: Vector<ownership.ReturnPathOwn>, k: Int) Bool {
  for r in rps {
    via_ok := case r.via {
      .Direct => true,
      .Variant(_, _) => false,
    }
    fld_ok := case r.field {
      .Some(f) => f == k,
      .None => false,
    }
    own_ok := case r.own {
      .OwnedFromParam(p) => p == k,
      .OwnedFresh => false,
    }
    if via_ok and fld_ok and own_ok {
      return true
    }
  }
  false
}

// Some Direct .field=f ret_path is OwnedFresh.
fn has_direct_field_fresh(rps: Vector<ownership.ReturnPathOwn>, f: Int) Bool {
  for r in rps {
    via_ok := case r.via {
      .Direct => true,
      .Variant(_, _) => false,
    }
    fld_ok := case r.field {
      .Some(x) => x == f,
      .None => false,
    }
    own_ok := case r.own {
      .OwnedFresh => true,
      .OwnedFromParam(_) => false,
    }
    if via_ok and fld_ok and own_ok {
      return true
    }
  }
  false
}

fn same_summary_pub(a: ownership.Summary, b: ownership.Summary) Bool {
  summary.same_summary(a, b)
}

// fn g(x, y) {
//   if y {
//     r := g(x, y)                          // recursive return site
//     return Record{ f0: r.f0, f1: <fresh> }
//   }
//   Record{ f0: x, f1: <fresh> }            // base site: f0 from p0
// }
// g is func_id 1; x=lid(0), y=lid(1).
fn recursive_transport_fixture() Vector<AnfFunctionDef> {
  b := b_reg()
  rec_record := AnfOp.ARecord(
    TypeId.{ id: 0 },
    [
      .{ field: FieldId.{ id: 0 }, value: .ALocal(lid(3)) },
      .{ field: FieldId.{ id: 1 }, value: .ALocal(lid(4)) },
    ],
  )
  then_branch: AnfExpr = .Let(
    lid(2),
    .ACall(.AGlobalFunc(FuncId.{ id: 1 }), [.ALocal(lid(0)), .ALocal(lid(1))]),
    .Let(
      lid(3),
      .ARecordGet(.ALocal(lid(2)), FieldId.{ id: 0 }, TypeId.{ id: 0 }),
      .Let(lid(4), dict_new_call(b), .Let(lid(5), rec_record, .Return(.Some(.ALocal(lid(5)))))),
    ),
  )
  base_record := AnfOp.ARecord(
    TypeId.{ id: 0 },
    [
      .{ field: FieldId.{ id: 0 }, value: .ALocal(lid(0)) },
      .{ field: FieldId.{ id: 1 }, value: .ALocal(lid(6)) },
    ],
  )
  else_branch: AnfExpr = .Let(
    lid(6),
    dict_new_call(b),
    .Let(lid(7), base_record, .Return(.Some(.ALocal(lid(7))))),
  )
  body: AnfExpr = .Let(lid(8), .AIf(.ALocal(lid(1)), then_branch, else_branch), .Return(.None))
  [fdef(1, "g", 2, body)]
}

pub fn suite() runner.Suite {
  runner
    .suite("cfg summary")
    .test(
      "t1 borrow: fn f(x) { Dict.new() } -> p0 borrow",
      fn() {
        b := b_reg()
        s := summ1("f", 1, .Let(lid(1), dict_new_call(b), .Atom(.ALocal(lid(1)))))
        try assert.equal(p_escape(s, 0), escape_tag(.Borrowed))
        .Ok({})
      },
    )
    .test(
      "t1 retain: fn f(x) { global_set G0 = x; 0 } -> p0 retain",
      fn() {
        body: AnfExpr = .Let(
          lid(1),
          .AGlobalSet(GlobalId.{ id: 0 }, .ALocal(lid(0))),
          .Atom(.ALitInt(0)),
        )
        s := summ1("f", 1, body)
        try assert.equal(p_escape(s, 0), escape_tag(.Retained))
        .Ok({})
      },
    )
    .test(
      "returned wrapper param is Borrowed (return is a hand-off, not retention)",
      fn() {
        body: AnfExpr = .Let(lid(1), wrapper_record(lid(0)), .Atom(.ALocal(lid(1))))
        s := summ1("f", 1, body)
        try assert.equal(p_escape(s, 0), escape_tag(.Borrowed))
        .Ok({})
      },
    )
    .test(
      "t1 dead-branch publish: fn f(x){ if c { global_set G=x }; 0 } -> p0 retain (blocker 2)",
      fn() {
        // then-arm publishes x; x is dead at the return. Escape must still be Retained.
        then_e: AnfExpr = .Let(
          lid(2),
          .AGlobalSet(GlobalId.{ id: 0 }, .ALocal(lid(0))),
          .Atom(.ALitInt(0)),
        )
        else_e: AnfExpr = .Atom(.ALitInt(0))
        body: AnfExpr = .Let(lid(1), .AIf(.ALitBool(true), then_e, else_e), .Atom(.ALitInt(0)))
        s := summ1("f", 1, body)
        try assert.equal(p_escape(s, 0), escape_tag(.Retained))
        .Ok({})
      },
    )
    .test(
      "t1 cross-block aggregate-escape: fn f(x){ w:=Wrapper.{x}; if c { global_set G=w }; 0 } -> p0 retain",
      fn() {
        // w is built in the entry block and published in a LATER block. Its field
        // origins must survive the CFG edge (path_prov join) so x stays Retained.
        then_e: AnfExpr = .Let(
          lid(3),
          .AGlobalSet(GlobalId.{ id: 0 }, .ALocal(lid(1))),
          .Atom(.ALitInt(0)),
        )
        else_e: AnfExpr = .Atom(.ALitInt(0))
        body: AnfExpr = .Let(
          lid(1),
          wrapper_record(lid(0)),
          .Let(lid(2), .AIf(.ALitBool(true), then_e, else_e), .Atom(.ALitInt(0))),
        )
        s := summ1("f", 1, body)
        try assert.equal(p_escape(s, 0), escape_tag(.Retained))
        .Ok({})
      },
    )
    .test(
      "t1 cross-block variant-escape: fn f(x){ v:=Some(x); if c { global_set G=v }; 0 } -> p0 retain",
      fn() {
        // v (an AVariant wrapping x) is built in the entry block and published in a
        // LATER block. Payload origins must survive the CFG edge (path_prov join)
        // so x stays Retained. Guards adaptation-1: emptying shell prov + recording
        // path_prov[Payload(tag,i)] for every payload, not only single-retention ones.
        then_e: AnfExpr = .Let(
          lid(3),
          .AGlobalSet(GlobalId.{ id: 0 }, .ALocal(lid(1))),
          .Atom(.ALitInt(0)),
        )
        else_e: AnfExpr = .Atom(.ALitInt(0))
        variant_op: AnfOp = .AVariant(TypeId.{ id: 0 }, VariantId.{ id: 0 }, [.ALocal(lid(0))])
        body: AnfExpr = .Let(
          lid(1),
          variant_op,
          .Let(lid(2), .AIf(.ALitBool(true), then_e, else_e), .Atom(.ALitInt(0))),
        )
        s := summ1("f", 1, body)
        try assert.equal(p_escape(s, 0), escape_tag(.Retained))
        .Ok({})
      },
    )
    .test(
      "t1 nested record-in-record escape: fn f(p){ r:={f0:p}; w:={f0:r}; global_set G=w } -> p0 retain",
      fn() {
        // DEPTH soundness: p is two levels deep (w.f0.f0). The depth-2 path_prov
        // can't represent [Field,Field], so graft_path_prov folds the dropped inner
        // origins up into [f0]; publishing w then still leaks p (Retained).
        body: AnfExpr = .Let(
          lid(1),
          wrapper_record(lid(0)),
          .Let(
            lid(2),
            wrapper_record(lid(1)),
            .Let(lid(3), .AGlobalSet(GlobalId.{ id: 0 }, .ALocal(lid(2))), .Atom(.ALitInt(0))),
          ),
        )
        s := summ1("f", 1, body)
        try assert.equal(p_escape(s, 0), escape_tag(.Retained))
        .Ok({})
      },
    )
    .test(
      "t1 nested variant-in-record escape: fn f(p){ v:=Some(p); w:={f0:v}; global_set G=w } -> p0 retain",
      fn() {
        // [Field, Payload] is not representable; origins fold up into [f0].
        v_op: AnfOp = .AVariant(TypeId.{ id: 0 }, VariantId.{ id: 0 }, [.ALocal(lid(0))])
        body: AnfExpr = .Let(
          lid(1),
          v_op,
          .Let(
            lid(2),
            wrapper_record(lid(1)),
            .Let(lid(3), .AGlobalSet(GlobalId.{ id: 0 }, .ALocal(lid(2))), .Atom(.ALitInt(0))),
          ),
        )
        s := summ1("f", 1, body)
        try assert.equal(p_escape(s, 0), escape_tag(.Retained))
        .Ok({})
      },
    )
    .test(
      "t1 nested variant-in-variant escape: fn f(p){ v:=Some(p); w:=Some(v); global_set G=w } -> p0 retain",
      fn() {
        // [Payload, Payload] is not representable; origins fold up into [Payload].
        inner_v: AnfOp = .AVariant(TypeId.{ id: 0 }, VariantId.{ id: 0 }, [.ALocal(lid(0))])
        outer_v: AnfOp = .AVariant(TypeId.{ id: 0 }, VariantId.{ id: 0 }, [.ALocal(lid(1))])
        body: AnfExpr = .Let(
          lid(1),
          inner_v,
          .Let(
            lid(2),
            outer_v,
            .Let(lid(3), .AGlobalSet(GlobalId.{ id: 0 }, .ALocal(lid(2))), .Atom(.ALitInt(0))),
          ),
        )
        s := summ1("f", 1, body)
        try assert.equal(p_escape(s, 0), escape_tag(.Retained))
        .Ok({})
      },
    )
    .test(
      "t1 nested record-in-array escape: fn f(p){ r:={f0:p}; xs:=[r]; global_set G=xs } -> p0 retain",
      fn() {
        // [Elem, Field] is not representable; the AArrayLit fold routes the record's
        // field origins onto [Elem] so publishing xs leaks p.
        body: AnfExpr = .Let(
          lid(1),
          wrapper_record(lid(0)),
          .Let(
            lid(2),
            .AArrayLit([.ALocal(lid(1))]),
            .Let(lid(3), .AGlobalSet(GlobalId.{ id: 0 }, .ALocal(lid(2))), .Atom(.ALitInt(0))),
          ),
        )
        s := summ1("f", 1, body)
        try assert.equal(p_escape(s, 0), escape_tag(.Retained))
        .Ok({})
      },
    )
    .test(
      "t1 cow-escape: fn f(x){ ys := Dict.set(x,0,1); global_set G=ys } -> p0 retain",
      fn() {
        // ys structurally shares x's HAMT and escapes globally; provenance must
        // follow COW aliasing so x is Retained, not Borrowed.
        b := b_reg()
        set_call: AnfOp = .ACall(
          .AGlobalFunc(b.method_id("Dict", "set")),
          [.ALocal(lid(0)), .ALitInt(0), .ALitInt(1)],
        )
        body: AnfExpr = .Let(
          lid(1),
          set_call,
          .Let(lid(2), .AGlobalSet(GlobalId.{ id: 0 }, .ALocal(lid(1))), .Atom(.ALitInt(0))),
        )
        s := summ1("f", 1, body)
        try assert.equal(p_escape(s, 0), escape_tag(.Retained))
        .Ok({})
      },
    )
    .test(
      "t1 cow value-escape: fn f(v){ d:=Dict.new(); d2:=Dict.set(d,0,v); global_set G=d2 } -> p0 retain",
      fn() {
        // v is inserted as a Dict.set VALUE arg (non-base). The dict escapes
        // globally, so v is retained into the escaping container: p0 Retained.
        b := b_reg()
        set_call: AnfOp = .ACall(
          .AGlobalFunc(b.method_id("Dict", "set")),
          [.ALocal(lid(1)), .ALitInt(0), .ALocal(lid(0))],
        )
        body: AnfExpr = .Let(
          lid(1),
          dict_new_call(b),
          .Let(
            lid(2),
            set_call,
            .Let(lid(3), .AGlobalSet(GlobalId.{ id: 0 }, .ALocal(lid(2))), .Atom(.ALitInt(0))),
          ),
        )
        s := summ1("f", 1, body)
        try assert.equal(p_escape(s, 0), escape_tag(.Retained))
        .Ok({})
      },
    )
    .test(
      "t1 allocate value-escape: fn f(v){ c := Cell.new(v); global_set G=c } -> p0 retain",
      fn() {
        // v is the sole VALUE arg of an Allocate builtin (Cell.new). The cell
        // escapes globally, so v is retained: p0 Retained.
        b := b_reg()
        new_call: AnfOp = .ACall(.AGlobalFunc(b.method_id("Cell", "new")), [.ALocal(lid(0))])
        body: AnfExpr = .Let(
          lid(1),
          new_call,
          .Let(lid(2), .AGlobalSet(GlobalId.{ id: 0 }, .ALocal(lid(1))), .Atom(.ALitInt(0))),
        )
        s := summ1("f", 1, body)
        try assert.equal(p_escape(s, 0), escape_tag(.Retained))
        .Ok({})
      },
    )
    .test(
      "t1 append value-escape: fn f(v){ xs:=Vector.make(); ys:=Vector.append(xs,v); global_set G=ys } -> p0 retain",
      fn() {
        // v is inserted as a Vector.append VALUE arg (non-base). The vector
        // escapes globally, so v is retained: p0 Retained.
        b := b_reg()
        append_call: AnfOp = .ACall(
          .AGlobalFunc(b.method_id("Vector", "append")),
          [.ALocal(lid(1)), .ALocal(lid(0))],
        )
        body: AnfExpr = .Let(
          lid(1),
          vector_make_call(b),
          .Let(
            lid(2),
            append_call,
            .Let(lid(3), .AGlobalSet(GlobalId.{ id: 0 }, .ALocal(lid(2))), .Atom(.ALitInt(0))),
          ),
        )
        s := summ1("f", 1, body)
        try assert.equal(p_escape(s, 0), escape_tag(.Retained))
        .Ok({})
      },
    )
    .test(
      "t4 consumed-but-not-flowing -> Borrowed, no in_place_paths",
      fn() {
        // x moved into w on last use (AInit), then w threaded through Dict.set but
        // never published: consumed but NOT returned/leaked -> flows_to_return=false -> Borrowed.
        b := b_reg()
        set_call: AnfOp = .ACall(
          .AGlobalFunc(b.method_id("Dict", "set")),
          [.ALocal(lid(2)), .ALitInt(1), .ALitInt(2)],
        )
        body: AnfExpr = .Let(
          lid(2),
          .AInit(.ALocal(lid(0))),
          .Let(lid(3), set_call, .Atom(.ALitInt(0))),
        )
        s := summ1("g", 1, body)

        // the param is consumed but NOT returned/leaked -> flows_to_return=false -> Borrowed
        try assert.equal(p_role(s, 0), role_tag(.Borrowed))
        try assert.equal(s.params[0].in_place_paths.paths.len(), 0)
        try assert.equal(p_escape(s, 0), escape_tag(.Borrowed))
        .Ok({})
      },
    )
    .test(
      "t2 fresh: fn f(x) { Dict.new() } -> ret fresh",
      fn() {
        b := b_reg()
        s := summ1("f", 1, .Let(lid(1), dict_new_call(b), .Atom(.ALocal(lid(1)))))
        try assert.equal(ret_tag(s.ret), ret_tag(.OwnedFresh))
        .Ok({})
      },
    )
    .test(
      "t2 alias payload: fn f(x) { x } -> ret alias([0])",
      fn() {
        s := summ1("f", 1, .Atom(.ALocal(lid(0))))
        try assert.equal(ret_tag(s.ret), ret_tag(.MayAliasParams([])))
        try assert.is_true(same_ints(ret_alias_set(s.ret), [0]))
        .Ok({})
      },
    )
    .test(
      "t2 multi-origin: fn f(x,y) { if c { x } else { y } } -> ret alias([0,1])",
      fn() {
        then_e: AnfExpr = .Atom(.ALocal(lid(0)))
        else_e: AnfExpr = .Atom(.ALocal(lid(1)))
        body: AnfExpr = .Let(lid(2), .AIf(.ALitBool(true), then_e, else_e), .Atom(.ALocal(lid(2))))
        s := summ1("f", 2, body)
        try assert.is_true(same_ints(ret_alias_set(s.ret), [0, 1]))
        .Ok({})
      },
    )
    .test(
      "t2 wrap return: fn f(x) { Wrapper.{x} } -> ret OwnedFresh (shell handoff)",
      fn() {
        s := summ1("f", 1, .Let(lid(1), wrapper_record(lid(0)), .Atom(.ALocal(lid(1)))))
        try assert.equal(ret_tag(s.ret), ret_tag(.OwnedFresh))
        .Ok({})
      },
    )
    .test(
      "fresh two-field record: ret = OwnedFresh (shell), not MayAliasParams",
      fn() {
        two := AnfOp.ARecord(
          TypeId.{ id: 0 },
          [
            .{ field: FieldId.{ id: 0 }, value: .ALocal(lid(0)) },
            .{ field: FieldId.{ id: 1 }, value: .ALocal(lid(1)) },
          ],
        )
        s := summ1("f", 2, .Let(lid(2), two, .Atom(.ALocal(lid(2)))))
        try assert.equal(ret_tag(s.ret), 0) // OwnedFresh shell
        .Ok({})
      },
    )
    .test(
      "returned variant with single-retention payload: ret = OwnedFresh shell",
      fn() {
        vop := AnfOp.AVariant(TypeId.{ id: 0 }, VariantId.{ id: 5 }, [.ALocal(lid(0))])
        s := summ1("f", 1, .Let(lid(1), vop, .Atom(.ALocal(lid(1)))))
        try assert.equal(ret_tag(s.ret), 0)
        .Ok({})
      },
    )
    .test(
      "t3 leaf summaries computed for every function",
      fn() {
        b := b_reg()
        f := fdef(1, "f", 1, .Let(lid(1), dict_new_call(b), .Atom(.ALocal(lid(1)))))
        g := fdef(2, "g", 1, .Atom(.ALocal(lid(0))))
        t := compute_of([f, g])
        try assert.equal(p_escape(summ_of(t, 1), 0), escape_tag(.Borrowed))
        try assert.equal(ret_tag(summ_of(t, 1).ret), ret_tag(.OwnedFresh))
        try assert.is_true(same_ints(ret_alias_set(summ_of(t, 2).ret), [0]))
        .Ok({})
      },
    )
    .test(
      "t3 self-recursion terminates (minimal gate): fn f(x){ f(x) }",
      fn() {
        call_self: AnfExpr = .Let(
          lid(1),
          .ACall(.AGlobalFunc(FuncId.{ id: 1 }), [.ALocal(lid(0))]),
          .Atom(.ALocal(lid(1))),
        )
        t := compute_of([fdef(1, "f", 1, call_self)])
        try assert.equal(t.by_func.keys().len(), 1)
        .Ok({})
      },
    )
    .test(
      "t3 mutual recursion: SCC fixpoint is stable + sound",
      fn() {
        f_body: AnfExpr = .Let(
          lid(1),
          .ACall(.AGlobalFunc(FuncId.{ id: 2 }), [.ALocal(lid(0))]),
          .Atom(.ALocal(lid(1))),
        )
        g_body: AnfExpr = .Let(
          lid(1),
          .ACall(.AGlobalFunc(FuncId.{ id: 1 }), [.ALocal(lid(0))]),
          .Atom(.ALocal(lid(1))),
        )
        t := compute_of([fdef(1, "f", 1, f_body), fdef(2, "g", 1, g_body)])
        try assert.equal(t.by_func.keys().len(), 2)
        try assert.equal(p_escape(summ_of(t, 1), 0), escape_tag(.Retained))
        try assert.equal(ret_tag(summ_of(t, 1).ret), ret_tag(.Shared))
        try assert.equal(p_escape(summ_of(t, 2), 0), escape_tag(.Retained))
        try assert.equal(ret_tag(summ_of(t, 2).ret), ret_tag(.Shared))
        .Ok({})
      },
    )
    .test(
      "recursive helper: ret_paths deterministic + self-thread under-approximated",
      fn() {
        funcs := recursive_transport_fixture()
        t := compute_of(funcs)
        s := summ_of(t, 1)

        // [.f0] is dropped by the meet (base=from(p0), recursive site doesn't recover
        // it); [.f1]=fresh survives on both sites.
        try assert.equal(has_from_param_path(s.ret_paths, 0), false)
        try assert.equal(has_direct_field_fresh(s.ret_paths, 1), true)

        // determinism: recompute and compare
        t2 := compute_of(funcs)
        try assert.equal(same_summary_pub(s, summ_of(t2, 1)), true)
        .Ok({})
      },
    )
    .test(
      "t4 borrow: borrowing callee leaves caller arg Unique",
      fn() {
        b := b_reg()
        g := fdef(2, "g", 1, .Let(lid(1), dict_new_call(b), .Atom(.ALocal(lid(1)))))
        f_body: AnfExpr = .Let(
          lid(0),
          dict_new_call(b),
          .Let(
            lid(1),
            .ACall(.AGlobalFunc(FuncId.{ id: 2 }), [.ALocal(lid(0))]),
            .Atom(.ALitInt(0)),
          ),
        )
        f := analyzed_caller([fdef(1, "f", 0, f_body), g], "f")
        try assert.equal(caller_own(f, 0), own_unique())
        .Ok({})
      },
    )
    .test(
      "t4 retain: retaining callee demotes caller arg to Shared",
      fn() {
        b := b_reg()
        g := fdef(
          2,
          "g",
          1,
          .Let(lid(1), .AGlobalSet(GlobalId.{ id: 0 }, .ALocal(lid(0))), .Atom(.ALitInt(0))),
        )
        f_body: AnfExpr = .Let(
          lid(0),
          dict_new_call(b),
          .Let(
            lid(1),
            .ACall(.AGlobalFunc(FuncId.{ id: 2 }), [.ALocal(lid(0))]),
            .Atom(.ALitInt(0)),
          ),
        )
        f := analyzed_caller([fdef(1, "f", 0, f_body), g], "f")
        try assert.equal(caller_own(f, 0), own_shared())
        .Ok({})
      },
    )
    .test(
      "t4 return-alias: a unique last-use arg is MOVED into the aliasing callee (Stage 4a)",
      fn() {
        b := b_reg()
        g := fdef(2, "g", 1, .Atom(.ALocal(lid(0))))
        f_body: AnfExpr = .Let(
          lid(0),
          dict_new_call(b),
          .Let(
            lid(1),
            .ACall(.AGlobalFunc(FuncId.{ id: 2 }), [.ALocal(lid(0))]),
            .Atom(.ALitInt(0)),
          ),
        )
        f := analyzed_caller([fdef(1, "f", 0, f_body), g], "f")

        // ctx (lid0) is fresh Unique + last-use; g returns an alias of it and the result is
        // discarded, so Stage 4a MOVES ctx (consumed) rather than demoting it to Shared.
        try assert.equal(caller_own(f, 0), own_unique())
        .Ok({})
      },
    )
    .test(
      "t4 aggregate wrapper: wrap(xs) does NOT demote the arg (return is a hand-off)",
      fn() {
        // g(xs){ Wrapper.{xs} } wraps its arg and returns it. Under Decision 3 the
        // return hands the wrapper to the caller: g's param is Borrowed and its ret
        // is OwnedFresh (shell), so passing a fresh xs into g(xs) leaves xs Unique --
        // there is no callee-retention forcing it to Shared.
        b := b_reg()
        g := fdef(2, "g", 1, .Let(lid(1), wrapper_record(lid(0)), .Atom(.ALocal(lid(1)))))
        f_body: AnfExpr = .Let(
          lid(0),
          dict_new_call(b),
          .Let(
            lid(1),
            .ACall(.AGlobalFunc(FuncId.{ id: 2 }), [.ALocal(lid(0))]),
            .Atom(.ALitInt(0)),
          ),
        )
        f := analyzed_caller([fdef(1, "f", 0, f_body), g], "f")
        try assert.equal(caller_own(f, 0), own_unique())
        .Ok({})
      },
    )
    .test(
      "t4 multi-origin: both origin args demoted",
      fn() {
        b := b_reg()
        then_e: AnfExpr = .Atom(.ALocal(lid(0)))
        else_e: AnfExpr = .Atom(.ALocal(lid(1)))
        g := fdef(
          2,
          "g",
          2,
          .Let(lid(2), .AIf(.ALitBool(true), then_e, else_e), .Atom(.ALocal(lid(2)))),
        )
        f_body: AnfExpr = .Let(
          lid(0),
          dict_new_call(b),
          .Let(
            lid(1),
            dict_new_call(b),
            .Let(
              lid(2),
              .ACall(.AGlobalFunc(FuncId.{ id: 2 }), [.ALocal(lid(0)), .ALocal(lid(1))]),
              .Atom(.ALitInt(0)),
            ),
          ),
        )
        f := analyzed_caller([fdef(1, "f", 0, f_body), g], "f")
        try assert.equal(caller_own(f, 0), own_shared())
        try assert.equal(caller_own(f, 1), own_shared())
        .Ok({})
      },
    )
    .test(
      "t4 fresh result is Unique at the call",
      fn() {
        b := b_reg()
        g := fdef(2, "g", 1, .Let(lid(1), dict_new_call(b), .Atom(.ALocal(lid(1)))))
        f_body: AnfExpr = .Let(
          lid(0),
          dict_new_call(b),
          .Let(
            lid(1),
            .ACall(.AGlobalFunc(FuncId.{ id: 2 }), [.ALocal(lid(0))]),
            .Atom(.ALitInt(0)),
          ),
        )
        f := analyzed_caller([fdef(1, "f", 0, f_body), g], "f")
        try assert.equal(caller_own(f, 1), own_unique())
        .Ok({})
      },
    )
    .test(
      "t4 conservative: unknown callee publishes the arg",
      fn() {
        b := b_reg()
        f_body: AnfExpr = .Let(
          lid(0),
          dict_new_call(b),
          .Let(
            lid(1),
            .ACall(.AGlobalFunc(FuncId.{ id: 99 }), [.ALocal(lid(0))]),
            .Atom(.ALitInt(0)),
          ),
        )
        f := analyzed_caller([fdef(1, "f", 0, f_body)], "f")
        try assert.equal(caller_own(f, 0), own_shared())
        .Ok({})
      },
    )
    .test(
      "t4 consumed-but-not-flowing: caller arg stays valid (Borrowed role)",
