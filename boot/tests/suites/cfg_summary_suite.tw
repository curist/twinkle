    .test(
      "variant_id: VariantId and UniqueReq construct",
      fn() {
        v := variant_id.VariantId.{
          func: 7,
          unique: [variant_id.UniqueReq.{ param: 0, path: variant_id.shell() }],
        }
        try assert.equal(v.func, 7)
        try assert.equal(v.unique.len(), 1)
        try assert.equal(v.unique[0].param, 0)
        try assert.equal(v.unique[0].path.segs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "variant_id: canonicalize sorts by (param, path) and dedups",
      fn() {
        // unsorted + duplicate reqs
        raw: variant_id.UniqueKey = [
          variant_id.UniqueReq.{ param: 1, path: variant_id.shell() },
          variant_id.UniqueReq.{ param: 0, path: variant_id.field(3) },
          variant_id.UniqueReq.{ param: 0, path: variant_id.shell() },
          variant_id.UniqueReq.{ param: 0, path: variant_id.field(3) }, // dup
        ]
        got := variant_id.canonicalize_key(raw)

        // expected order: (0,[]), (0,[3]), (1,[])   — dup collapsed
        try assert.equal(got.len(), 3)
        try assert.equal(got[0].param, 0)
        try assert.equal(got[0].path.segs.len(), 0)
        try assert.equal(got[1].param, 0)
        try assert.equal(got[1].path.segs[0], 3)
        try assert.equal(got[2].param, 1)
        .Ok({})
      },
    )
    .test(
      "variant_id: downward_close adds the shell for every field req (D3)",
      fn() {
        // (0,[3]) with no (0,[]) present must gain (0,[])
        raw: variant_id.UniqueKey = [variant_id.UniqueReq.{ param: 0, path: variant_id.field(3) }]
        got := variant_id.downward_close(raw)
        try assert.equal(got.len(), 2)
        try assert.equal(got[0].param, 0)
        try assert.equal(got[0].path.segs.len(), 0) // shell added, sorts first
        try assert.equal(got[1].param, 0)
        try assert.equal(got[1].path.segs[0], 3)
        .Ok({})
      },
    )
    .test(
      "variant_id: intern gives one id per canonical key, in creation order",
      fn() {
        vi := variant_id.new_interner()
        va := variant_id.VariantId.{
          func: 7,
          unique: [variant_id.UniqueReq.{ param: 0, path: variant_id.shell() }],
        }
        vb := variant_id.VariantId.{
          func: 7,
          unique: [variant_id.UniqueReq.{ param: 1, path: variant_id.shell() }],
        }

        // va2: va's key written with a redundant DUPLICATE shell req; canonicalize_key
        // collapses it to va's canonical key, so it must intern to va's id (dedup path).
        va2 := variant_id.VariantId.{
          func: 7,
          unique: [
            variant_id.UniqueReq.{ param: 0, path: variant_id.shell() },
            variant_id.UniqueReq.{ param: 0, path: variant_id.shell() },
          ],
        }

        r1 := variant_id.intern(vi, va)
        r2 := variant_id.intern(r1.interner, vb)
        r3 := variant_id.intern(r2.interner, va2) // canonically equal to va

        try assert.equal(r1.id, 0) // creation order
        try assert.equal(r2.id, 1)
        try assert.equal(r3.id, 0) // deduped back to va's id
        .Ok({})
      },
    )
    .test(
      "variant_id: intern is order-insensitive within a key and round-trips by id",
      fn() {
        vi := variant_id.new_interner()

        // same key, reqs supplied in two different orders
        k1: variant_id.UniqueKey = [
          variant_id.UniqueReq.{ param: 0, path: variant_id.field(3) },
          variant_id.UniqueReq.{ param: 0, path: variant_id.shell() },
        ]
        k2: variant_id.UniqueKey = [
          variant_id.UniqueReq.{ param: 0, path: variant_id.shell() },
          variant_id.UniqueReq.{ param: 0, path: variant_id.field(3) },
        ]
        r1 := variant_id.intern(vi, variant_id.VariantId.{ func: 9, unique: k1 })
        r2 := variant_id.intern(r1.interner, variant_id.VariantId.{ func: 9, unique: k2 })
        try assert.equal(r1.id, r2.id) // canonicalization makes them one variant

        got := variant_id.variant_of_id(r2.interner, r1.id)
        case got {
          .Some(v) => {
            try assert.equal(v.func, 9)
            try assert.equal(v.unique.len(), 2)
            try assert.equal(v.unique[0].path.segs.len(), 0) // canonical: shell first
          },
          .None => return .Err("expected a variant for id"),
        }
        .Ok({})
      },
    )
    .test(
      "variant_id: canonical string is stable and injective for distinct keys",
      fn() {
        va := variant_id.VariantId.{
          func: 7,
          unique: [
            variant_id.UniqueReq.{ param: 0, path: variant_id.shell() },
            variant_id.UniqueReq.{ param: 0, path: variant_id.field(3) },
          ],
        }
        vb := variant_id.VariantId.{
          func: 7,
          unique: [
            variant_id.UniqueReq.{ param: 0, path: variant_id.shell() },
            variant_id.UniqueReq.{ param: 0, path: variant_id.field(4) },
          ],
        }
        sa := variant_id.variant_canonical_string(variant_id.canonicalize_variant(va))
        sb := variant_id.variant_canonical_string(variant_id.canonicalize_variant(vb))
        try assert.equal(sa, "f7|0:;0:3") // exact, human-checkable form
        try assert.is_true(sa != sb) // distinct keys => distinct strings

        // the generic (empty-key) variant — the most common case — serializes to "f{n}|"
        generic := variant_id.VariantId.{ func: 7, unique: [] }
        sg := variant_id.variant_canonical_string(variant_id.canonicalize_variant(generic))
        try assert.equal(sg, "f7|")
        .Ok({})
      },
    )
    .test(
      "variant_id: site_key is injective across both Szudzik branches",
      fn() {
        // ordered pair, so (func,local) and (local,func) must not collide, and
        // varying either component must change the key.
        try assert.is_true(variant_id.site_key(3, 5) != variant_id.site_key(5, 3))
        try assert.is_true(variant_id.site_key(3, 5) != variant_id.site_key(3, 6))
        try assert.is_true(variant_id.site_key(3, 5) != variant_id.site_key(4, 5))

        // a repeated key is stable
        try assert.equal(variant_id.site_key(3, 5), variant_id.site_key(3, 5))
        .Ok({})
      },
    )
    .test(
      "dependency closure includes candidate callees and excludes unrelated functions",
      fn() {
        artifacts := case pipeline.compile_entry_path(
          "${sound_uniqueness_fixtures_dir()}/phase8a_summary_closure.tw",
        ) {
          .Ok(result) => result,
          .Err(err) => return .Err(format_compile_error(err)),
        }
        b := artifacts.builtins
        view := ownership.prune_dead_merge(cfg.build_view(artifacts.opt, b))
        root_id := try func_id_by_name(view, "candidate_root")
        helper_a_id := try func_id_by_name(view, "helper_a")
        helper_b_id := try func_id_by_name(view, "helper_b")
        unrelated_id := try func_id_by_name(view, "unrelated")

        roots: Dict<Int, Bool> = Dict.new()
        roots[root_id] = true
        closure := summary.dependency_closure(view, roots)

        try assert.equal(dict_bool(closure, root_id), true)
        try assert.equal(dict_bool(closure, helper_a_id), true)
        try assert.equal(dict_bool(closure, helper_b_id), true)
        try assert.equal(dict_bool(closure, unrelated_id), false)
        .Ok({})
      },
    )
    .test(
      "key-stream CFG threading rethreads constant false join edge only",
      fn() {
        artifacts := case pipeline.compile_entry_path(
          "${sound_uniqueness_fixtures_dir()}/phase8h_ksu_battery.tw",
        ) {
          .Ok(result) => result,
          .Err(err) => return .Err(format_compile_error(err)),
        }
        b := artifacts.builtins
        raw_view := cfg.build_view(artifacts.opt, b)
        threaded_view := ownership.thread_const_branches(raw_view)

        raw_f := try cfg_func_id_by_name(raw_view, "insert_sorted")
        raw_b10 := try cfg_block_by_id(raw_f, 10)
        raw_b11 := try cfg_block_by_id(raw_f, 11)
        raw_b13 := try cfg_block_by_id(raw_f, 13)
        try assert.equal(block_has_succ_to(raw_b10, 11), true)
        try assert.equal(block_has_pred_from(raw_b11, 10), true)
        try assert.equal(block_has_pred_from(raw_b13, 10), false)

        threaded_f := try cfg_func_id_by_name(threaded_view, "insert_sorted")
        threaded_b9 := try cfg_block_by_id(threaded_f, 9)
        threaded_b10 := try cfg_block_by_id(threaded_f, 10)
        threaded_b11 := try cfg_block_by_id(threaded_f, 11)
        threaded_b13 := try cfg_block_by_id(threaded_f, 13)
        try assert.equal(block_has_succ_to(threaded_b10, 11), false)
        try assert.equal(block_has_succ_to(threaded_b10, 13), true)
        try assert.equal(block_has_pred_from(threaded_b11, 10), false)
        try assert.equal(block_has_pred_from(threaded_b13, 10), true)
        try assert.equal(block_has_succ_to(threaded_b9, 11), true)
        try assert.equal(block_has_pred_from(threaded_b11, 9), true)
        .Ok({})
      },
    )
    .test(
      "key-stream CFG threading does not skip effectful branch blocks",
