        try assert.equal(block_has_succ_to(b0, 3), false)
        try assert.equal(block_has_pred_from(b1, 0), true)
        try assert.equal(block_has_pred_from(b3, 0), false)
        .Ok({})
      },
    )
    .test(
      "key-stream induction finds full traversal counter and rejects non-induction loops",
      fn() {
        artifacts := case pipeline.compile_entry_path(
          "${sound_uniqueness_fixtures_dir()}/phase8h_ksu_battery.tw",
        ) {
          .Ok(result) => result,
          .Err(err) => return .Err(format_compile_error(err)),
        }
        b := artifacts.builtins
        view := ownership.thread_const_branches(cfg.build_view(artifacts.opt, b))

        insert_f := try cfg_func_id_by_name(view, "insert_sorted")
        case ownership.find_induction(insert_f, 0, b) {
          .Some(ind) => {
            try assert.equal(ind.counter, 6)
            try assert.equal(ind.element, 7)
          },
          .None => return .Err("insert_sorted: expected induction evidence"),
        }

        try assert_no_induction(view, b, "bad2")
        try assert_no_induction(view, b, "unchanged_counter_backedge")
        try assert_no_induction(view, b, "wrong_bound")
        .Ok({})
      },
    )
    .test(
      "key-stream classifier exposes an unthreaded mode",
      fn() {
        artifacts := case pipeline.compile_entry_path(
          "${sound_uniqueness_fixtures_dir()}/phase8h_ksu_battery.tw",
        ) {
          .Ok(result) => result,
          .Err(err) => return .Err(format_compile_error(err)),
        }
        b := artifacts.builtins
        view := cfg.build_view(artifacts.opt, b)
        dh := ownership.classify_dedupe_helpers_unthreaded(
          view,
          b,
          make_prelude_optimizer_semantics(b),
        )
        try assert_not_certified(dh, view, "insert_sorted")
        .Ok({})
      },
    )
    .test(
      "key-stream threading leaves ordinary ownership verdicts unchanged",
      fn() {
        artifacts := case pipeline.compile_entry_path(
          "${sound_uniqueness_fixtures_dir()}/phase8h_ksu_battery.tw",
        ) {
          .Ok(result) => result,
          .Err(err) => return .Err(format_compile_error(err)),
        }
        b := artifacts.builtins
        s := make_prelude_optimizer_semantics(b)
        view := ownership.prune_dead_merge(cfg.build_view(artifacts.opt, b))
        threaded_table := summary.compute(view, b, s)
        unthreaded_table := threaded_table
        unthreaded_table.dedupe_helpers = ownership.classify_dedupe_helpers_unthreaded(view, b, s)
        threaded := ownership.analyze_with_summaries(view, b, s, threaded_table)
        unthreaded := ownership.analyze_with_summaries(view, b, s, unthreaded_table)
        try assert_same_verdict_texts(verdict_texts(threaded), verdict_texts(unthreaded))
        .Ok({})
      },
    )
    .test(
      "key-stream battery: every adversarial negative is rejected (default-deny safe)",
      fn() {
        artifacts := case pipeline.compile_entry_path(
          "${sound_uniqueness_fixtures_dir()}/phase8h_ksu_battery.tw",
        ) {
          .Ok(result) => result,
          .Err(err) => return .Err(format_compile_error(err)),
        }
        b := artifacts.builtins
        view := cfg.build_view(artifacts.opt, b)
        dh := ownership.classify_dedupe_helpers(view, b, make_prelude_optimizer_semantics(b))

        negatives: Vector<String> = [
          "bad",
          "guarded_repeat_no_set",
          "guarded_repeat_no_set_live_flag",
          "bad_second_loop",
          "bad_double_tail",
          "two_id_one_block",
          "bad2",
          "nested_loop_append",
          "fixed_index_eq_guard",
          "second_in_loop_exit",
          "break_skips_eq",
          "break_skips_eq_live_flag",
          "evil_skip_eq",
          "continue_before_eq",
          "unchanged_counter_backedge",
          "wrong_bound",
          "join_side_effect",
          "stale_acc_source",
          "rebound_vparam",
          "rebound_proof_local",
          "stale_notflag",
          "rebound_alias_base",
          "cross_block_stale_notflag",
          "short_circuit_reconvergence_trap",
          "wrong_arg_position",
          "flag_reset_in_loop",
          "param_rebind_combinator",
          "wrong_return",
          "extra_acc_mutation",
          "bare_append_union",
          "passthrough",
        ]
        for name in negatives {
          try assert_not_certified(dh, view, name)
        }
        .Ok({})
      },
    )
    .test(
      "key-stream battery: positives certify with the right kind",
      fn() {
        artifacts := case pipeline.compile_entry_path(
          "${sound_uniqueness_fixtures_dir()}/phase8h_ksu_battery.tw",
        ) {
          .Ok(result) => result,
          .Err(err) => return .Err(format_compile_error(err)),
        }
        b := artifacts.builtins
        view := cfg.build_view(artifacts.opt, b)
        dh := ownership.classify_dedupe_helpers(view, b, make_prelude_optimizer_semantics(b))

        primitives: Vector<String> = ["insert_sorted", "insert_sorted_str"]
        for name in primitives {
          try assert_cert_primitive(dh, view, name)
        }
        combinators: Vector<String> = ["union_via_insert", "union_keys", "int_keys_union"]
        for name in combinators {
          try assert_cert_combinator(dh, view, name)
        }
        .Ok({})
      },
    )
    .test(
      "key-stream boot compiler helpers certify",
      fn() {
        root := loader.find_project_root("boot")
        artifacts := case pipeline.compile_entry_path("${root}/main.tw") {
          .Ok(result) => result,
          .Err(err) => return .Err(format_compile_error(err)),
        }
        b := artifacts.builtins
        view := cfg.build_view(artifacts.opt, b)
        dh := ownership.classify_dedupe_helpers(view, b, make_prelude_optimizer_semantics(b))
        try assert_cert_primitive(dh, view, "insert_sorted")
        try assert_cert_primitive(dh, view, "insert_sorted_str")
        try assert_cert_combinator(dh, view, "int_keys_union")
        .Ok({})
      },
    )
    .test(
      "key-stream certificates populate root-scoped summary tables",
      fn() {
        artifacts := case pipeline.compile_entry_path(
          "${sound_uniqueness_fixtures_dir()}/phase8h_ksu_battery.tw",
        ) {
          .Ok(result) => result,
          .Err(err) => return .Err(format_compile_error(err)),
        }
        b := artifacts.builtins
        view := cfg.build_view(artifacts.opt, b)
        root_id := try func_id_by_name(view, "int_keys_union")
        roots: Dict<Int, Bool> = Dict.new()
        roots[root_id] = true
        scoped := summary.compute_for_roots_cached(
          view,
          b,
          make_prelude_optimizer_semantics(b),
          roots,
        )
        try assert_cert_combinator(scoped.table.dedupe_helpers, view, "int_keys_union")
        try assert_cert_combinator(scoped.table.dedupe_helpers, view, "union_keys")
        try assert_cert_primitive(scoped.table.dedupe_helpers, view, "insert_sorted")
        .Ok({})
      },
    )
    .test(
      "root-scoped summaries match full summaries for candidate roots",
      fn() {
        artifacts := case pipeline.compile_entry_path(
          "${sound_uniqueness_fixtures_dir()}/phase8a_summary_closure.tw",
        ) {
          .Ok(result) => result,
          .Err(err) => return .Err(format_compile_error(err)),
        }
        b := artifacts.builtins
        s := semantics.make_prelude_optimizer_semantics(b)
        view := ownership.prune_dead_merge(cfg.build_view(artifacts.opt, b))
        root_id := try func_id_by_name(view, "candidate_root")
        roots: Dict<Int, Bool> = Dict.new()
        roots[root_id] = true

        full := summary.compute(view, b, s)
        scoped := summary.compute_for_roots(view, b, s, roots)
        full_s := case ownership.summary_get(full, root_id) {
          .Some(sm) => summary.render_summary(sm),
          .None => return .Err("missing full summary for candidate_root"),
        }
        scoped_s := case ownership.summary_get(scoped, root_id) {
          .Some(sm) => summary.render_summary(sm),
          .None => return .Err("missing scoped summary for candidate_root"),
        }
        try assert.equal(scoped_s, full_s)
        .Ok({})
      },
    )
}
