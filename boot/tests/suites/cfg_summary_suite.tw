    )
    .test(
      "t4 aggregate wrapper: wrap(xs) does NOT demote the arg (return is a hand-off)",
      fn() {
        // g(xs){ Wrapper.{xs} } wraps its arg and returns it. Under Decision 3 the
        // return hands the wrapper to the caller: g's param is Borrowed and its ret
        // is OwnedFresh (shell), so passing a fresh xs into g(xs) leaves xs Unique --
        // there is no callee-retention forcing it to Shared.
        b := b_reg()
        g := fdef(2, "g", 1, .Let(lid(1), wrapper_record(lid(0)), .Atom(.ALocal(lid(1)))))
        f_body: AnfExpr = .Let(
          lid(0),
          dict_new_call(b),
          .Let(
            lid(1),
            .ACall(.AGlobalFunc(FuncId.{ id: 2 }), [.ALocal(lid(0))]),
            .Atom(.ALitInt(0)),
          ),
        )
        f := analyzed_caller([fdef(1, "f", 0, f_body), g], "f")
        try assert.equal(caller_own(f, 0), own_unique())
        .Ok({})
      },
    )
    .test(
      "t4 multi-origin: both origin args demoted",
      fn() {
        b := b_reg()
        then_e: AnfExpr = .Atom(.ALocal(lid(0)))
        else_e: AnfExpr = .Atom(.ALocal(lid(1)))
        g := fdef(
          2,
          "g",
          2,
          .Let(lid(2), .AIf(.ALitBool(true), then_e, else_e), .Atom(.ALocal(lid(2)))),
        )
        f_body: AnfExpr = .Let(
          lid(0),
          dict_new_call(b),
          .Let(
            lid(1),
            dict_new_call(b),
            .Let(
              lid(2),
              .ACall(.AGlobalFunc(FuncId.{ id: 2 }), [.ALocal(lid(0)), .ALocal(lid(1))]),
              .Atom(.ALitInt(0)),
            ),
          ),
        )
        f := analyzed_caller([fdef(1, "f", 0, f_body), g], "f")
        try assert.equal(caller_own(f, 0), own_shared())
        try assert.equal(caller_own(f, 1), own_shared())
        .Ok({})
      },
    )
    .test(
      "t4 fresh result is Unique at the call",
      fn() {
        b := b_reg()
        g := fdef(2, "g", 1, .Let(lid(1), dict_new_call(b), .Atom(.ALocal(lid(1)))))
        f_body: AnfExpr = .Let(
          lid(0),
          dict_new_call(b),
          .Let(
            lid(1),
            .ACall(.AGlobalFunc(FuncId.{ id: 2 }), [.ALocal(lid(0))]),
            .Atom(.ALitInt(0)),
          ),
        )
        f := analyzed_caller([fdef(1, "f", 0, f_body), g], "f")
        try assert.equal(caller_own(f, 1), own_unique())
        .Ok({})
      },
    )
    .test(
      "t4 conservative: unknown callee publishes the arg",
      fn() {
        b := b_reg()
        f_body: AnfExpr = .Let(
          lid(0),
          dict_new_call(b),
          .Let(
            lid(1),
            .ACall(.AGlobalFunc(FuncId.{ id: 99 }), [.ALocal(lid(0))]),
            .Atom(.ALitInt(0)),
          ),
        )
        f := analyzed_caller([fdef(1, "f", 0, f_body)], "f")
        try assert.equal(caller_own(f, 0), own_shared())
        .Ok({})
      },
    )
    .test(
      "t4 capability recorded (consumed), not acted on: caller arg stays valid",
      fn() {
        b := b_reg()
        g_body: AnfExpr = .Let(
          lid(1),
          .AInit(.ALocal(lid(0))),
          .Let(
            lid(2),
            .ACall(
              .AGlobalFunc(b.method_id("Dict", "set")),
              [.ALocal(lid(1)), .ALitInt(1), .ALitInt(2)],
            ),
            .Atom(.ALitInt(0)),
          ),
        )
        gs := summ1("g", 1, g_body)
        try assert.equal(cap_tag(gs.params[0].capability), cap_tag(.Consumed))
        try assert.equal(p_escape(gs, 0), escape_tag(.Borrowed))
        g := fdef(2, "g", 1, g_body)
        f_body: AnfExpr = .Let(
          lid(0),
          dict_new_call(b),
          .Let(
            lid(1),
            .ACall(.AGlobalFunc(FuncId.{ id: 2 }), [.ALocal(lid(0))]),
            .Atom(.ALocal(lid(0))),
          ),
        )
        f := analyzed_caller([fdef(1, "f", 0, f_body), g], "f")
        case f.blocks[0].exit.binding_valid.get(0) {
          .Some(v) => try assert.is_true(v),
          .None => {}, // absent => valid
        }
        .Ok({})
      },
    )
    .test(
      "t5 render: --cfg header shows the summary (incl consumed) + determinism",
      fn() {
        b := b_reg()

        // g consumes its param via a move, so its header exercises the `(consumed)` tag.
        g_body: AnfExpr = .Let(
          lid(1),
          .AInit(.ALocal(lid(0))),
          .Let(
            lid(2),
            .ACall(
              .AGlobalFunc(b.method_id("Dict", "set")),
              [.ALocal(lid(1)), .ALitInt(1), .ALitInt(2)],
            ),
            .Atom(.ALitInt(0)),
          ),
        )
        g := fdef(2, "g", 1, g_body)
        v := cfg.build_view(module_of([fdef(1, "f", 0, .Atom(.ALitInt(0))), g]), b)
        t := summary.compute(v, b, sem())
        out1 := summary.render_cfg(v, t)
        out2 := summary.render_cfg(v, t)
        try assert.is_true(out1.contains("summary:"))
        try assert.is_true(out1.contains("consumed"))
        try assert.is_true(out1 == out2)
        .Ok({})
      },
    )
    .test(
      "review: Dict.remove retains base but borrows removed key",
      fn() {
        b := b_reg()
        body: AnfExpr = .Let(
          lid(2),
          .ACall(.AGlobalFunc(b.method_id("Dict", "remove")), [.ALocal(lid(0)), .ALocal(lid(1))]),
          .Let(lid(3), .AGlobalSet(GlobalId.{ id: 0 }, .ALocal(lid(2))), .Atom(.ALitInt(0))),
        )
        s := summ1("f", 2, body)
        try assert.equal(p_escape(s, 0), escape_tag(.Retained))
        try assert.equal(p_escape(s, 1), escape_tag(.Borrowed))
        .Ok({})
      },
    )
    .test(
      "review: Vector.make retains the stored fill but borrows the size",
      fn() {
        b := b_reg()

        // Vector.make(size, fill): the fill (arg 1) is stored in every slot, so a
        // param passed as the fill escapes when the vector escapes. size (arg 0)
        // is a scalar count and stays borrowed.
        body: AnfExpr = .Let(
          lid(2),
          .ACall(.AGlobalFunc(b.method_id("Vector", "make")), [.ALocal(lid(0)), .ALocal(lid(1))]),
          .Let(lid(3), .AGlobalSet(GlobalId.{ id: 0 }, .ALocal(lid(2))), .Atom(.ALitInt(0))),
        )
        s := summ1("f", 2, body)
        try assert.equal(p_escape(s, 0), escape_tag(.Borrowed))
        try assert.equal(p_escape(s, 1), escape_tag(.Retained))
        .Ok({})
      },
    )
    .test(
      "review: vector set retains value but borrows index",
      fn() {
        b := b_reg()
        body: AnfExpr = .Let(
          lid(3),
          .ACall(
            .AGlobalFunc(b.id("vector$set_unsafe")),
            [.ALocal(lid(0)), .ALocal(lid(1)), .ALocal(lid(2))],
          ),
          .Let(lid(4), .AGlobalSet(GlobalId.{ id: 0 }, .ALocal(lid(3))), .Atom(.ALitInt(0))),
        )
        s := summ1("f", 3, body)
        try assert.equal(p_escape(s, 0), escape_tag(.Retained))
        try assert.equal(p_escape(s, 1), escape_tag(.Borrowed))
        try assert.equal(p_escape(s, 2), escape_tag(.Retained))
        .Ok({})
      },
    )
    .test(
      "review: indirect callee conservatively publishes the arg",
      fn() {
        b := b_reg()
        f_body: AnfExpr = .Let(
          lid(0),
          dict_new_call(b),
          .Let(lid(1), .ACall(.ALocal(lid(99)), [.ALocal(lid(0))]), .Atom(.ALitInt(0))),
        )
        f := analyzed_caller([fdef(1, "f", 0, f_body)], "f")
        try assert.equal(caller_own(f, 0), own_shared())
        .Ok({})
      },
    )
    .test(
      "review: CowConfig fresh producer fallback retains args conservatively",
      fn() {
        fid := FuncId.{ id: 7777 }
        fresh: Dict<Int, Bool> = Dict.new()
        fresh[fid.id] = true
        legacy := semantics.optimizer_semantics_from_cow_config(semantics.CowConfig.{
          cow_ops: Dict.new(),
          fresh_producer_ids: fresh,
          read_only_ids: Dict.new(),
          builder: empty_builder_config(),
          string_builder: empty_builder_config(),
        })
        body: AnfExpr = .Let(
          lid(1),
          .ACall(.AGlobalFunc(fid), [.ALocal(lid(0))]),
          .Let(lid(2), .AGlobalSet(GlobalId.{ id: 0 }, .ALocal(lid(1))), .Atom(.ALitInt(0))),
        )
        b := b_reg()
        v := cfg.build_view(module_of([fdef(1, "f", 1, body)]), b)
        f := case cfg.function_named(v, "f") {
          .Some(found) => found,
          .None => error("missing f"),
        }
        s := ownership.summarize_function(f, ownership.empty_summary_table(), b, legacy)
        try assert.equal(p_escape(s, 0), escape_tag(.Retained))
        .Ok({})
      },
    )
    .test(
      "review: render_summary public format is exact",
      fn() {
        consumed := ownership.Summary.{
          params: [
            ownership.ParamSummary.{ escape: .Borrowed, capability: .NoCap },
            ownership.ParamSummary.{ escape: .Retained, capability: .Consumed },
          ],
          ret: .MayAliasParams([0, 1]),
          ret_paths: [],
        }
        fresh := ownership.Summary.{ params: [], ret: .OwnedFresh, ret_paths: [] }
        try assert.equal(
          summary.render_summary(consumed),
          "summary: p0=borrow p1=retain(consumed) ret=alias(p0,p1)",
        )
        try assert.equal(summary.render_summary(fresh), "summary:  ret=fresh")
        .Ok({})
      },
    )
    .test(
      "review: ir command cfg helper renders pruned analyzed summaries",
      fn() {
        file := "${fixtures_dir()}/ir_cfg_summary.tw"
        out: String = render_cfg_for_entry(file)
        try assert.str_contains(out, "summary:")
        try assert.str_contains(out, "facts.in=")
        try assert.is_true(out == render_cfg_for_entry(file))
        .Ok({})
      },
    )
    .test(
      "fn f(x,y){ Record{f0:x, f1:y} } -> ret_paths [.f0]=from(p0) [.f1]=from(p1)",
      fn() {
        two := AnfOp.ARecord(
          TypeId.{ id: 0 },
          [
            .{ field: FieldId.{ id: 0 }, value: .ALocal(lid(0)) },
            .{ field: FieldId.{ id: 1 }, value: .ALocal(lid(1)) },
          ],
        )
        s := summ1("f", 2, .Let(lid(2), two, .Atom(.ALocal(lid(2)))))
        try assert.equal(ret_tag(s.ret), 0) // OwnedFresh shell
        try assert.equal(s.ret_paths.len(), 2)
        got := ret_path_pairs(s.ret_paths)
        try assert.equal(same_ints(got, [0, 0, 1, 1]), true) // [f0->p0, f1->p1] flattened
        .Ok({})
      },
    )
    .test(
      "fn f(x){ Record{f0:x, f1:x} } -> no ret_paths (same origin twice = alias)",
      fn() {
        two := AnfOp.ARecord(
          TypeId.{ id: 0 },
          [
            .{ field: FieldId.{ id: 0 }, value: .ALocal(lid(0)) },
            .{ field: FieldId.{ id: 1 }, value: .ALocal(lid(0)) },
          ],
        )
        s := summ1("f", 1, .Let(lid(1), two, .Atom(.ALocal(lid(1)))))
        try assert.equal(s.ret_paths.len(), 0)
        .Ok({})
      },
    )
    .test(
      "fn f(x,y){ r := Rec{f0:x,f1:y}; r.f1 = fresh; r } -> [.f0]=from(p0) [.f1]=fresh (overwrite drops p1)",
      fn() {
        rec := AnfOp.ARecord(
          TypeId.{ id: 0 },
          [
            .{ field: FieldId.{ id: 0 }, value: .ALocal(lid(0)) },
            .{ field: FieldId.{ id: 1 }, value: .ALocal(lid(1)) },
          ],
        )
        fresh := AnfOp.ARecord(TypeId.{ id: 1 }, [])

        // ARecordUpdate(base, field, value, in_place: Bool, tid: TypeId)
        upd := AnfOp.ARecordUpdate(
          .ALocal(lid(2)),
          FieldId.{ id: 1 },
          .ALocal(lid(3)),
          false,
          TypeId.{ id: 0 },
        )
        body: AnfExpr = .Let(
          lid(2),
          rec,
          .Let(lid(3), fresh, .Let(lid(4), upd, .Atom(.ALocal(lid(4))))),
        )
        s := summ1("f", 2, body)
        try assert.equal(ret_tag(s.ret), 0)
        got := ret_path_pairs(s.ret_paths)
        try assert.equal(same_ints(got, [0, 0, 1, 0 - 1]), true) // f0->p0, f1->fresh(-1); p1 dropped
        .Ok({})
      },
    )
    .test(
      "interior-aliasing field is NOT OwnedFresh: fn f(x){ inner:={g:x}; o:={f0:inner,f1:inner}; o }",
      fn() {
        // inner holds x; it goes into TWO fields of o, so inner is not single-
        // retention -> path_prov[.f0]=[.f1]=[] (shell-only; interior [.g]=x not
        // folded on the non-retention branch). A path_prov-only [] must NOT classify
        // OwnedFresh (both fields alias x through inner) -> field_own gate drops them.
        inner := AnfOp.ARecord(
          TypeId.{ id: 1 },
          [.{ field: FieldId.{ id: 0 }, value: .ALocal(lid(0)) }],
        )
        o := AnfOp.ARecord(
          TypeId.{ id: 0 },
          [
            .{ field: FieldId.{ id: 0 }, value: .ALocal(lid(1)) },
            .{ field: FieldId.{ id: 1 }, value: .ALocal(lid(1)) },
          ],
        )
        body: AnfExpr = .Let(lid(1), inner, .Let(lid(2), o, .Atom(.ALocal(lid(2)))))
        s := summ1("f", 1, body)
        try assert.equal(s.ret_paths.len(), 0) // no false OwnedFresh for interior-aliasing fields
        .Ok({})
      },
    )
    .test(
      "fn f(x){ Variant#7(Record{f0:x}) } -> ret_paths V7[0]=fresh AND V7[0].f0=from(p0)",
      fn() {
        inner := AnfOp.ARecord(
          TypeId.{ id: 0 },
          [.{ field: FieldId.{ id: 0 }, value: .ALocal(lid(0)) }],
        )
        vop := AnfOp.AVariant(TypeId.{ id: 0 }, VariantId.{ id: 7 }, [.ALocal(lid(1))])
        body: AnfExpr = .Let(lid(1), inner, .Let(lid(2), vop, .Atom(.ALocal(lid(2)))))
        s := summ1("f", 1, body)
        try assert.equal(s.ret_paths.len(), 2)
        try assert.equal(has_variant_shell_fresh(s.ret_paths, 7, 0), true)
        try assert.equal(has_variant_field_from(s.ret_paths, 7, 0, 0, 0), true)
        .Ok({})
      },
    )
}
