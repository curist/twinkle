        // fn f(env, c) { if c { env.f0 = d ; ret } else { env.f1 = d ; ret } }
        // each arm updates a different field on env and returns it; the merge unions.
        d0: AnfOp = dict_new_call(b)
        thenb: AnfExpr = .Let(
