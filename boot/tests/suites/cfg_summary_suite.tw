    .test(
      "fn f(x,y){ r := Rec{f0:x,f1:y}; r.f1 = fresh; r } -> [.f0]=from(p0) [.f1]=fresh (overwrite drops p1)",
      fn() {
        rec := AnfOp.ARecord(
          TypeId.{ id: 0 },
          [
            .{ field: FieldId.{ id: 0 }, value: .ALocal(lid(0)) },
            .{ field: FieldId.{ id: 1 }, value: .ALocal(lid(1)) },
          ],
        )
        fresh := AnfOp.ARecord(TypeId.{ id: 1 }, [])

        // ARecordUpdate(base, field, value, in_place: Bool, tid: TypeId)
        upd := AnfOp.ARecordUpdate(
          .ALocal(lid(2)),
          FieldId.{ id: 1 },
          .ALocal(lid(3)),
          false,
          TypeId.{ id: 0 },
        )
        body: AnfExpr = .Let(
          lid(2),
          rec,
          .Let(lid(3), fresh, .Let(lid(4), upd, .Atom(.ALocal(lid(4))))),
        )
        s := summ1("f", 2, body)
        try assert.equal(ret_tag(s.ret), 0)
        got := ret_path_pairs(s.ret_paths)
        try assert.equal(same_ints(got, [0, 0, 1, 0 - 1]), true) // f0->p0, f1->fresh(-1); p1 dropped
        .Ok({})
      },
    )
    .test(
      "interior-aliasing field is NOT OwnedFresh: fn f(x){ inner:={g:x}; o:={f0:inner,f1:inner}; o }",
      fn() {
        // inner holds x; it goes into TWO fields of o, so inner is not single-
        // retention -> path_prov[.f0]=[.f1]=[] (shell-only; interior [.g]=x not
        // folded on the non-retention branch). A path_prov-only [] must NOT classify
        // OwnedFresh (both fields alias x through inner) -> field_own gate drops them.
        inner := AnfOp.ARecord(
          TypeId.{ id: 1 },
          [.{ field: FieldId.{ id: 0 }, value: .ALocal(lid(0)) }],
        )
        o := AnfOp.ARecord(
          TypeId.{ id: 0 },
          [
            .{ field: FieldId.{ id: 0 }, value: .ALocal(lid(1)) },
            .{ field: FieldId.{ id: 1 }, value: .ALocal(lid(1)) },
          ],
        )
        body: AnfExpr = .Let(lid(1), inner, .Let(lid(2), o, .Atom(.ALocal(lid(2)))))
        s := summ1("f", 1, body)
        try assert.equal(s.ret_paths.len(), 0) // no false OwnedFresh for interior-aliasing fields
        .Ok({})
      },
    )
    .test(
      "fn f(x){ Variant#7(Record{f0:x}) } -> ret_paths V7[0]=fresh AND V7[0].f0=from(p0)",
      fn() {
