fn lid(id: Int) LocalId {
  LocalId.{ id }
}

fn b_reg() builtins.BuiltinRegistry {
  builtins.make_builtin_registry()
}

fn sem() semantics.OptimizerSemantics {
  make_prelude_optimizer_semantics(b_reg())
}

fn fixtures_dir() String {
  root := loader.find_project_root("boot")
  "${root}/tests/fixtures/cfg"
}

fn sound_uniqueness_fixtures_dir() String {
  root := loader.find_project_root("boot")
  "${root}/tests/fixtures/sound_uniqueness"
}

fn func_id_by_name(view: cfg.CfgView, name: String) Result<Int, String> {
  for f in view.functions {
    if f.name == name {
      return .Ok(f.func_id)
    }
  }
  .Err("missing function ${name}")
}

fn dict_bool(d: Dict<Int, Bool>, key: Int) Bool {
  case d.get(key) {
    .Some(v) => v,
    .None => false,
  }
}

fn verdict_texts(view: cfg.CfgView) Dict<String, String> {
  out: Dict<String, String> = Dict.new()
  for f in view.functions {
    for blk in f.blocks {
      for local_id, text in blk.exit.verdicts {
        out["${f.func_id}#${local_id}"] = text
      }
    }
  }
  out
}

fn assert_same_verdict_texts(a: Dict<String, String>, b: Dict<String, String>) Result<Void, String> {
  try assert.equal(a.keys().len(), b.keys().len())
  for k in a.keys() {
    av := case a.get(k) {
      .Some(v) => v,
      .None => return .Err("missing left verdict ${k}"),
    }
    bv := case b.get(k) {
      .Some(v) => v,
      .None => return .Err("missing right verdict ${k}"),
    }
    try assert.equal(av, bv)
  }
  .Ok({})
}

// A certified primitive under `name`, or an error naming the miss.
fn assert_cert_primitive(
  dh: Dict<Int, ownership.DedupeCertificate>,
  view: cfg.CfgView,
  name: String,
) Result<Void, String> {
  id := try func_id_by_name(view, name)
  case dh.get(id) {
    .Some(c) => case c.kind {
      .SortInsertPrimitive => .Ok({}),
      .Combinator => .Err("${name}: expected SortInsertPrimitive, got Combinator"),
    },
    .None => .Err("${name}: expected certified as SortInsertPrimitive, not certified"),
  }
}

// A certified combinator under `name`, or an error naming the miss.
fn assert_cert_combinator(
  dh: Dict<Int, ownership.DedupeCertificate>,
  view: cfg.CfgView,
  name: String,
) Result<Void, String> {
  id := try func_id_by_name(view, name)
  case dh.get(id) {
    .Some(c) => case c.kind {
      .Combinator => .Ok({}),
      .SortInsertPrimitive => .Err("${name}: expected Combinator, got SortInsertPrimitive"),
    },
    .None => .Err("${name}: expected certified as Combinator, not certified"),
  }
}

// `name` must carry no certificate (rejected).
fn assert_not_certified(dh: Dict<Int, ownership.DedupeCertificate>, view: cfg.CfgView, name: String) Result<
  Void,
  String,
> {
  id := try func_id_by_name(view, name)
  case dh.get(id) {
    .Some(_) => .Err("${name}: wrongly certified (should be rejected)"),
    .None => .Ok({}),
  }
}

fn assert_no_induction(view: cfg.CfgView, b: builtins.BuiltinRegistry, name: String) Result<
  Void,
  String,
> {
  f := try cfg_func_id_by_name(view, name)
  case ownership.find_induction(f, 0, b) {
    .Some(_) => .Err("${name}: unexpectedly found induction evidence"),
    .None => .Ok({}),
  }
}

fn cfg_func_id_by_name(view: cfg.CfgView, name: String) Result<cfg.CfgFunction, String> {
  for f in view.functions {
    if f.name == name {
      return .Ok(f)
    }
  }
  .Err("missing function ${name}")
}

fn cfg_block_by_id(f: cfg.CfgFunction, id: Int) Result<cfg.CfgBlock, String> {
  for blk in f.blocks {
    if blk.id.id == id {
      return .Ok(blk)
    }
  }
  .Err("${f.name}: missing block B${id}")
}

fn block_has_pred_from(blk: cfg.CfgBlock, pred_id: Int) Bool {
  for edge in blk.preds {
    if edge.target.id == pred_id {
      return true
    }
  }
  false
}

fn block_pred_count_from(blk: cfg.CfgBlock, pred_id: Int) Int {
  n := 0
  for edge in blk.preds {
    if edge.target.id == pred_id {
      n = n + 1
    }
  }
  n
}

fn block_has_succ_to(blk: cfg.CfgBlock, target_id: Int) Bool {
  for edge in blk.succs {
    if edge.target.id == target_id {
      return true
    }
  }
  false
}

fn cfg_empty_block(id: Int, name: String, params: Vector<LocalId>) cfg.CfgBlock {
  cfg.CfgBlock.{
    id: cfg.BlockId.{ id },
    name,
    params,
    bound: [],
    payload_src: .None,
    instructions: [],
    terminator: .None,
    preds: [],
    succs: [],
    entry: cfg.empty_block_facts(),
    exit: cfg.empty_block_facts(),
  }
}

fn synthetic_threading_side_effect_view() cfg.CfgView {
  b0 := cfg_empty_block(0, "entry", [])
  b0.terminator = .Some(.Branch(cfg.BlockId.{ id: 1 }, [.ALitBool(false)]))
  b0.succs = [cfg.CfgEdge.{ target: cfg.BlockId.{ id: 1 }, args: [.ALitBool(false)] }]

  b1 := cfg_empty_block(1, "effectful.join", [lid(0)])
  b1.instructions = [
    cfg.CfgInstruction.{
      anf_local: lid(10),
      op: .AAssign(lid(10), .ALitBool(true)),
      text: "assign L10 = true",
    },
  ]
  b1.terminator = .Some(
    .CondBranch(.ALocal(lid(0)), cfg.BlockId.{ id: 2 }, [], cfg.BlockId.{ id: 3 }, []),
  )
  b1.preds = [cfg.CfgEdge.{ target: cfg.BlockId.{ id: 0 }, args: [.ALitBool(false)] }]
  b1.succs = [
    cfg.CfgEdge.{ target: cfg.BlockId.{ id: 2 }, args: [] },
    cfg.CfgEdge.{ target: cfg.BlockId.{ id: 3 }, args: [] },
  ]

  b2 := cfg_empty_block(2, "then", [])
  b2.preds = [cfg.CfgEdge.{ target: cfg.BlockId.{ id: 1 }, args: [] }]
  b2.terminator = .Some(.Return(.None))

  b3 := cfg_empty_block(3, "else", [])
  b3.preds = [cfg.CfgEdge.{ target: cfg.BlockId.{ id: 1 }, args: [] }]
  b3.terminator = .Some(.Return(.None))

  cfg.CfgView.{
    functions: [
      cfg.CfgFunction.{ func_id: 9000, name: "effectful", params: [], blocks: [b0, b1, b2, b3] },
    ],
  }
}

fn synthetic_threading_duplicate_pred_view() cfg.CfgView {
  b0 := cfg_empty_block(0, "entry", [])
  b0.terminator = .Some(
    .CondBranch(
      .ALitBool(true),
      cfg.BlockId.{ id: 1 },
      [.ALitBool(false)],
      cfg.BlockId.{ id: 3 },
      [],
    ),
  )
  b0.succs = [
    cfg.CfgEdge.{ target: cfg.BlockId.{ id: 1 }, args: [.ALitBool(false)] },
    cfg.CfgEdge.{ target: cfg.BlockId.{ id: 3 }, args: [] },
  ]

  b1 := cfg_empty_block(1, "const.join", [lid(0)])
  b1.instructions = [
    cfg.CfgInstruction.{ anf_local: lid(10), op: .AInit(.ALocal(lid(0))), text: "init L0" },
  ]
  b1.terminator = .Some(
    .CondBranch(.ALocal(lid(10)), cfg.BlockId.{ id: 2 }, [], cfg.BlockId.{ id: 3 }, []),
  )
  b1.preds = [cfg.CfgEdge.{ target: cfg.BlockId.{ id: 0 }, args: [.ALitBool(false)] }]
  b1.succs = [
    cfg.CfgEdge.{ target: cfg.BlockId.{ id: 2 }, args: [] },
    cfg.CfgEdge.{ target: cfg.BlockId.{ id: 3 }, args: [] },
  ]

  b2 := cfg_empty_block(2, "then", [])
  b2.preds = [cfg.CfgEdge.{ target: cfg.BlockId.{ id: 1 }, args: [] }]
  b2.terminator = .Some(.Return(.None))

  b3 := cfg_empty_block(3, "else", [])
  b3.preds = [
    cfg.CfgEdge.{ target: cfg.BlockId.{ id: 0 }, args: [] },
    cfg.CfgEdge.{ target: cfg.BlockId.{ id: 1 }, args: [] },
  ]
  b3.terminator = .Some(.Return(.None))

  cfg.CfgView.{
    functions: [
      cfg.CfgFunction.{
        func_id: 9001,
        name: "duplicate_pred",
        params: [],
        blocks: [b0, b1, b2, b3],
      },
    ],
  }
}

