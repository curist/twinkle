use @std.testing.assert as assert
use @std.testing as runner

use commands.common.{format_compile_error}
use compiler.artifacts.{PipelineArtifacts}
use compiler.cfg
use compiler.codegen.mutable_produce
use compiler.codegen.variant_route
use compiler.opt.semantics as semantics
use compiler.ownership
use compiler.pipeline
use compiler.summary
use lib.module.loader

fn fixtures_dir() String {
  "${loader.find_project_root("boot")}/tests/fixtures/cfg/sound_uniqueness"
}

fn compile_fixture(name: String) Result<PipelineArtifacts, String> {
  case pipeline.compile_entry_path("${fixtures_dir()}/${name}.tw") {
    .Ok(a) => .Ok(a),
    .Err(e) => .Err(format_compile_error(e)),
  }
}

fn variants_of(art: PipelineArtifacts) summary.VariantSummaryTable {
  b := art.builtins
  view := ownership.prune_dead_merge(cfg.build_view(art.opt, b))
  sem := semantics.make_prelude_optimizer_semantics(b)
  table := summary.compute(view, b, sem)
  summary.compute_variants(view, b, sem, table)
}

fn sited_calls_in(art: PipelineArtifacts, fn_name: String) Result<
  Vector<ownership.SitedCallUniq>,
  String,
> {
  b := art.builtins
  view := ownership.prune_dead_merge(cfg.build_view(art.opt, b))
  sem := semantics.make_prelude_optimizer_semantics(b)
  table := summary.compute(view, b, sem)
  case view.functions.find(fn(f) { f.name == fn_name }) {
    .Some(f) => .Ok(ownership.call_uniques_sited(f, table, b, sem, Dict.new(), Dict.new())),
    .None => .Err("no function named ${fn_name}"),
  }
}

fn cfg_func_of(art: PipelineArtifacts, func_id: Int) Result<cfg.CfgFunction, String> {
  view := ownership.prune_dead_merge(cfg.build_view(art.opt, art.builtins))
  case view.functions.find(fn(f) { f.func_id == func_id }) {
    .Some(f) => .Ok(f),
    .None => .Err("no cfg function with id ${func_id}"),
  }
}

fn decision_count(produced: mutable_produce.ProducedDecisions) Int {
  n := 0
  for _key, ds in produced.table.by_site {
    n = n + ds.len()
  }
  n
}

pub fn suite() runner.Suite {
  runner
    .suite("variant_specialize")
    .test(
      "setb publishes a variant selectable when the record arg is unique",
      fn() Result<Void, String> {
        art := try compile_fixture("setb")
        vt := variants_of(art)
        ids := summary.variant_ids_of(vt)
        try assert.ok(ids.len() >= 1, "setb must publish at least one variant")
        setb_id := ids[0].func
        v := summary.select_variant_for_args(vt, setb_id, [true, true])
        try assert.ok(v != .None, "unique record arg must select the owned variant")
        .Ok({})
      },
    )
    .test(
      "call_uniques_sited reports setb's unique-base call site",
      fn() Result<Void, String> {
        art := try compile_fixture("setb")
        sited := try sited_calls_in(art, "caller")
        hit := sited.find(fn(s) { s.arg_unique.len() > 0 and s.arg_unique[0] })
        case hit {
          .Some(s) => {
            try assert.ok(s.site_key >= 0, "site_key present")
            .Ok({})
          },
          .None => .Err("expected a unique-base call site in caller"),
        }
      },
    )
    .test(
      "seeding recursive visit's owned param adds a vector in-place decision",
      fn() Result<Void, String> {
        // The generic `visit` body stays p0=Published (recursion), so uniform
        // entry seeds give no in-place decision; the owned variant seed must.
        art := try compile_fixture("visit_rec")
        vt := variants_of(art)
        variant := summary.variant_ids_of(vt)[0]
        visit_cfg := try cfg_func_of(art, variant.func)
        seed := summary.seed_for_variant(visit_cfg, variant)
        spec := variant_route.CloneSpec.{ seed_locals: seed, variant }
        seeds := variant_route.empty_seed_table().set_clone(variant.func, spec)
        generic := mutable_produce.produce_mutable_decisions(art.opt, art.builtins)
        seeded := mutable_produce.produce_mutable_decisions_seeded(art.opt, art.builtins, seeds)
        try assert.ok(
          decision_count(seeded) > decision_count(generic),
          "owned seed must add a decision: generic=${decision_count(generic)} seeded=${decision_count(
            seeded,
          )}",
        )
        .Ok({})
      },
    )
}
