//! Tail-match result typing: a tail-position control-flow result whose live arm
//! returns a typed vector (and whose other arms diverge) carries a physical
//! PVecI64 return ABI end-to-end.
//!
//! Two kinds of coverage:
//!   1. A differential pipeline test — a store-form accessor `=> v` types only
//!      once tailify runs (proving Task 2 + the group-aware caller routing).
//!   2. End-to-end value checks over the tricky arm shapes (store/multi-arm/
//!      non-typed-arm/nested/diverging), compiled through the real pipeline so a
//!      mis-route would trap or miscompile rather than return the right value.

use @std.testing.assert as assert
use @std.testing as runner

use compiler.backend.closure_convert.{convert_closures}
use compiler.backend.prepare.{prepare_backend_preroute}
use compiler.backend.prepared_ir.{PreparedFunc, SlotInfo}
use compiler.backend.route_typed_vec.{route_typed_vectors}
use compiler.backend.tailify.{never_returning_funcs, tailify_funcs}
use compiler.backend.typed_param_abi.{analyze_typed_repr}
use compiler.base_env.{first_user_type_id}
use compiler.builtins.{BuiltinRegistry}
use compiler.pipeline

// ── Value-correctness fixtures (compiled through the full pipeline) ──
type Col = { IntCol(Vector<Int>), FloatCol(Vector<Float>), Other }

fn mk_ints(n: Int) Col {
  .IntCol(
    collect i in range(n) {
      i
    },
  )
}

// Idiomatic store form + diverging arm — the primary target shape.
fn as_ints(c: Col) Vector<Int> {
  case c {
    .IntCol(v) => v,
    _ => error("not int"),
  }
}

// Multiple value arms (all Vector<Int> params) + diverging arm. Stays boxed
// (returned params are not typeable), but must stay correct.
fn pick(tag: Int, a: Vector<Int>, b: Vector<Int>) Vector<Int> {
  case tag {
    0 => a,
    1 => b,
    _ => error("bad"),
  }
}

// A non-typed value arm present (param `d`): the result is not uniformly a typed
// source, so the function stays boxed — but correct.
fn with_default(c: Col, d: Vector<Int>) Vector<Int> {
  case c {
    .IntCol(v) => v,
    _ => d,
  }
}

// let-spine in the live arm + diverging arm.
fn first_or_die(c: Col) Vector<Int> {
  case c {
    .IntCol(v) => {
      w := v
      w
    },
    _ => error("no"),
  }
}

// Nested if in the live arm + diverging arm.
fn nested(c: Col, tag: Int) Vector<Int> {
  case c {
    .IntCol(v) => if tag > 0 {
      v
    } else {
      v
    },
    _ => error("x"),
  }
}

// ── Differential pipeline test helpers (mirror route_typed_vec_suite) ──
type PreparedInputs = .{ funcs: Vector<PreparedFunc>, builtins: BuiltinRegistry }

fn prepare_src(src: String) Result<PreparedInputs, String> {
  artifacts := try pipeline.compile_source(src)
  cc := convert_closures(artifacts.opt, artifacts.env)
  prepared := prepare_backend_preroute(cc.anf, artifacts.env, artifacts.builtins, cc.captures)
  .Ok(.{ funcs: prepared.funcs, builtins: artifacts.builtins })
}

fn is_pvec_i64(info: SlotInfo) Bool {
  case info.wasm_type {
    .Ref(_, ht) => case ht {
      .Named(n) => n == "rt_types__PVecI64",
      _ => false,
    },
    _ => false,
  }
}

fn pvec_i64_slot_count(funcs: Vector<PreparedFunc>) Int {
  n := 0

  for pf in funcs {
    for sid in pf.slots.keys() {
      case pf.slots[sid] {
        .Some(info) => if is_pvec_i64(info) {
          n = n + 1
        },
        .None => {},
      }
    }
  }

  n
}

// A store-form accessor with a clean `collect` producer and a caller that reads
// the result via index/len — the exact dataframe accessor shape.
fn accessor_src() String {
  "type Col = { IntCol(Vector<Int>), Other }\n"
    .concat("fn as_ints(c: Col) Vector<Int> { case c { .IntCol(v) => v, _ => error(\"x\") } }\n")
    .concat("fn mk() Col { .IntCol(collect i in range(5) { i }) }\n")
    .concat("fn go() Int {\n")
    .concat("  keys := as_ints(mk())\n")
    .concat("  total := 0\n")
    .concat("  for i in range(keys.len()) { total = total + keys[i] }\n")
    .concat("  total\n")
    .concat("}\n")
    .concat("go()\n")
}

pub fn suite() runner.Suite {
  runner
    .suite("tail-match result typing")
    .test(
      "store-form accessor types (return ABI + caller slots) only after tailify",
      fn() {
        p := try prepare_src(accessor_src())
        never := never_returning_funcs(p.funcs)

        // Without tailify: the store-form live arm stores into the result slot
        // (not a Return), so return_is_typed cannot fire — no typed return, and
        // the caller's `keys` stays boxed.
        repr0 := analyze_typed_repr(p.funcs, p.builtins, first_user_type_id(), never)
        routed0 := route_typed_vectors(
          p.funcs,
          p.builtins,
          repr0.typed_fields,
          repr0.typed_payloads,
          repr0.capture_abi,
          repr0.param_abi.typeable_return,
        ).funcs
        try assert.equal(repr0.param_abi.typeable_return.keys().len(), 0)

        // With tailify: the live arm becomes a Return, as_ints gets a PVecI64
        // return ABI, and the group-aware caller routing types `keys` too.
        funcs_t := tailify_funcs(p.funcs, p.builtins, never)
        repr1 := analyze_typed_repr(funcs_t, p.builtins, first_user_type_id(), never)
        routed1 := route_typed_vectors(
          funcs_t,
          p.builtins,
          repr1.typed_fields,
          repr1.typed_payloads,
          repr1.capture_abi,
          repr1.param_abi.typeable_return,
        ).funcs

        try assert.ok(
          repr1.param_abi.typeable_return.keys().len() >= 1,
          "expected as_ints to gain a typed return after tailify",
        )
        try assert.ok(
          pvec_i64_slot_count(routed1) > pvec_i64_slot_count(routed0),
          "tailify must retype the accessor return + caller keys slots",
        )
        .Ok({})
      },
    )
    .test(
      "store-form accessor returns correct values",
      fn() {
        xs := mk_ints(4).as_ints()
        try assert.equal(xs.len(), 4)
        try assert.equal(xs[2], 2)
        .Ok({})
      },
    )
    .test(
      "multi value-arm accessor (returned params) stays correct",
      fn() {
        a := mk_ints(3)
        b := mk_ints(5)
        case a {
          .IntCol(av) => case b {
            .FloatCol(_) => .Ok({}),
            .IntCol(bv) => {
              try assert.equal(pick(0, av, bv)[1], av[1])
              try assert.equal(pick(1, av, bv)[4], bv[4])
              .Ok({})
            },
            .Other => .Ok({}),
          },
          _ => .Ok({}),
        }
      },
    )
    .test(
      "non-typed arm (default) stays correct",
      fn() {
        d := mk_ints(3)
        case d {
          .IntCol(dv) => {
            try assert.equal(with_default(.Other, dv)[1], dv[1])
            try assert.equal(mk_ints(2).with_default(dv)[0], 0)
            .Ok({})
          },
          _ => .Ok({}),
        }
      },
    )
    .test(
      "let-spine live arm returns correct values",
      fn() {
        try assert.equal(mk_ints(5).first_or_die()[3], 3)
        .Ok({})
      },
    )
    .test(
      "nested-if live arm + returning diverging arm are correct",
      fn() {
        try assert.equal(mk_ints(3).nested(1)[0], 0)
        try assert.equal(mk_ints(3).nested(0)[2], 2)
        .Ok({})
      },
    )
}
