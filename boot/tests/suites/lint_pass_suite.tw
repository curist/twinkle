    .test(
      "redundant-rebinding: loop seed declines a body read of the old base",
      fn() {
        fs := rr_findings(
          "fn f(items: Vector<Int>) Int {\n  acc := 0\n  cur := acc\n  for item in items {\n    cur = combine(cur, acc)\n  }\n  cur\n}\n",
