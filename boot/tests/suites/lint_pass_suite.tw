        .Ok({})
      },
    )
    .test(
      "redundant-rebinding: reports the narrow loop-seed shape without edits",
      fn() {
        fs := rr_findings(
          "fn f(items: Vector<Int>) Int {\n  acc := 0\n  cur := acc\n  for item in items {\n    cur = step(item, cur)\n  }\n  cur\n}\n",
