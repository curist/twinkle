        try assert.equal(fs[0].edits[0].replacement, "x + 1")
        .Ok({})
      },
    )
    .test(
      "redundant-print-stringify: fixes direct to_string argument",
      fn() {
        src := "fn demo(foo: String) Void {\n  print(foo.to_string())\n}\n"
        fs := findings(src)
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].rule, "redundant-print-stringify")
        try assert.equal(
          apply_first_edit(src, fs[0]),
          "fn demo(foo: String) Void {\n  print(foo)\n}\n",
        )
        .Ok({})
      },
    )
    .test(
      "redundant-print-stringify: fixes error to_string while preserving trap call",
      fn() {
        src := "fn demo(err: String) Int {\n  error(err.to_string())\n}\n"
        fs := findings(src)
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].rule, "redundant-print-stringify")
        try assert.equal(
          apply_first_edit(src, fs[0]),
          "fn demo(err: String) Int {\n  error(err)\n}\n",
        )
        .Ok({})
      },
    )
    .test(
      "redundant-print-stringify: does not fix interpolation with surrounding text",
      fn() {
        fs := findings("fn demo(foo: String) Void {\n  println(\"foo=\${foo}\")\n}\n")
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-print-stringify: does not fix multiple interpolations",
      fn() {
        fs := findings("fn demo(a: String, b: String) Void {\n  println(\"\${a}\${b}\")\n}\n")
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-print-stringify: does not fix non-sink calls",
      fn() {
        fs := findings(
          "fn consume(s: String) Void {}\nfn demo(foo: String) Void {\n  consume(foo.to_string())\n}\n",
        )
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-print-stringify: does not fix method calls named println",
      fn() {
        fs := findings(
          "fn demo(logger: Logger, foo: String) Void {\n  logger.println(foo.to_string())\n}\n",
        )
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-print-stringify: does not fix locally shadowed sink name",
      fn() {
        fs := findings(
          "fn demo(println: fn(String) Void, foo: String) Void {\n  println(foo.to_string())\n}\n",
        )
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "prefer-multiline-string: >=2-link \\n chain is flagged and fixable",
      fn() {
        fs := ml_findings("fn f() String {\n  \"a\\n\".concat(\"b\\n\").concat(\"c\\n\")\n}\n")
        try assert.equal(fs.len(), 1)
        try assert.ok(fs[0].edits.len() == 1, "expected an auto-fix edit")
        .Ok({})
      },
    )
    .test(
      "prefer-multiline-string: single literal is not flagged",
      fn() {
        try assert.equal(ml_findings("fn f() String {\n  \"a\\nb\\n\"\n}\n").len(), 0)
        .Ok({})
      },
    )
    .test(
      "prefer-multiline-string: one concat link is below threshold",
      fn() {
        try assert.equal(ml_findings("fn f() String {\n  \"a\\n\".concat(\"b\\n\")\n}\n").len(), 0)
        .Ok({})
      },
    )
    .test(
      "prefer-multiline-string: no newline in value is not flagged",
      fn() {
        try assert.equal(
          ml_findings("fn f() String {\n  \"a\".concat(\"b\").concat(\"c\")\n}\n").len(),
          0,
        )
        .Ok({})
      },
    )
    .test(
      "prefer-multiline-string: value containing an interpolation is not flagged",
      fn() {
        // A `\\` line still interpolates `${...}`, so a >=2-link chain whose value
        // carries `${` must NOT be rewritten. `${` is spelled via a split so this
        // test's own source has no interpolation.
        db := "$".concat("{x}")
        src := "fn f() String {\n  \"a"
          .concat(db)
          .concat("\\n\".concat(\"b\\n\").concat(\"c\\n\")\n}\n")
        try assert.equal(ml_findings(src).len(), 0)
        .Ok({})
      },
    )
    .test(
      "prefer-multiline-string: runtime concat (computed receiver) is not flagged",
      fn() {
        try assert.equal(
          ml_findings("fn f(x: String) String {\n  x.concat(\"b\\n\").concat(\"c\\n\")\n}\n").len(),
          0,
        )
        .Ok({})
      },
    )
    .test(
      "prefer-multiline-string: fix splits on value newlines, not concat boundaries",
      fn() {
        // Value "al\npha\nbe\nta!\n" — the "be"/"ta!" split falls INSIDE the
        // concat pieces ("...\n".concat("be\nta").concat("!\n")), so the fix must
        // re-split on the VALUE's newlines, not the concat boundaries.
        src := "fn f() String {\n  \"al\\npha\\n\".concat(\"be\\nta\").concat(\"!\\n\")\n}\n"
        fs := ml_findings(src)
        try assert.equal(fs.len(), 1)
        fixed := apply_first_edit(src, fs[0])
        try assert.ok(fixed.contains("\\\\al\n"), "expected \\\\al line")
        try assert.ok(fixed.contains("\\\\pha\n"), "expected \\\\pha line")
        try assert.ok(fixed.contains("\\\\be\n"), "expected \\\\be line")
        try assert.ok(fixed.contains("\\\\ta!\n"), "expected \\\\ta! line")
        try assert.is_false(fixed.contains(".concat("))
        .Ok({})
      },
    )
    .test(
      "constant-fn: private fn with call sites after def is auto-fixed to a constant",
      fn() {
        src := "fn n() Int {\n  42\n}\nfn use_it() Int {\n  n() + n()\n}\n"
        fs := cf_findings(src)
        try assert.equal(fs.len(), 1)
        try assert.ok(fs[0].edits.len() == 3, "expected def + 2 call-site edits")
        fixed := lintcmd.apply_edits(src, fs[0].edits)
        try assert.ok(fixed.contains("n: Int = 42"), "def -> module constant")
        try assert.ok(fixed.contains("n + n"), "call sites drop ()")
        try assert.is_false(fixed.contains("n()"))

        // The rewrite resolves the finding.
        try assert.equal(cf_findings(fixed).len(), 0)
        .Ok({})
      },
    )
    .test(
      "constant-fn: pub fn stays report-only (external callers unseen)",
      fn() {
        fs := cf_findings("pub fn n() Int {\n  42\n}\n")
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].edits.len(), 0)
        .Ok({})
      },
    )
    .test(
      "constant-fn: call site before the definition stays report-only",
      fn() {
        fs := cf_findings("x := n()\nfn n() Int {\n  42\n}\n")
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].edits.len(), 0)
        .Ok({})
      },
    )
    .test(
      "constant-fn: name used as a value (not called) stays report-only",
      fn() {
        fs := cf_findings("fn n() Int {\n  42\n}\nfn f() Int {\n  apply(n)\n}\n")
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].edits.len(), 0)
        .Ok({})
      },
    )
    .test(
      "constant-fn: name in a punned record field stays report-only",
      fn() {
        // `.{ n }` is a bare reference to `n`, not a call, so converting is unsafe.
        fs := cf_findings("fn n() Int {\n  42\n}\nfn f() P {\n  .{ n }\n}\n")
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].edits.len(), 0)
        .Ok({})
      },
    )
    .test(
      "constant-fn: name called with arguments stays report-only",
      fn() {
        fs := cf_findings("fn n() Int {\n  42\n}\nfn f() Int {\n  n(1)\n}\n")
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].edits.len(), 0)
        .Ok({})
      },
    )
    .test(
      "constant-fn: private String-returning builder is auto-fixed",
      fn() {
        src := "fn label() String {\n  \"hi\"\n}\nfn shout() String {\n  label().concat(\"!\")\n}\n"
        fs := cf_findings(src)
        try assert.equal(fs.len(), 1)
        fixed := lintcmd.apply_edits(src, fs[0].edits)
        try assert.ok(fixed.contains("label: String = \"hi\""), "def -> String constant")
        try assert.ok(fixed.contains("label.concat(\"!\")"), "call site drops ()")
        try assert.equal(cf_findings(fixed).len(), 0)
        .Ok({})
      },
    )
    .test(
      "fixpoint: a concat-chain builder becomes a \\\\ module constant in one pass",
      fn() {
        // prefer-multiline-string turns the chain into a `\\` body, which then
        // makes constant-fn fire and hoist it to a module constant + repoint the
        // call site — the interference the run_lint_command fixpoint resolves.
        src := "fn tmpl() String {\n  \"a\\n\".concat(\"b\\n\").concat(\"c\\n\")\n}\nfn caller() Int {\n  tmpl().len()\n}\n"
        fixed := fix_to_fixpoint(src)
        try assert.ok(fixed.contains("tmpl: String ="), "hoisted to a module constant")
        try assert.ok(fixed.contains("\\\\a"), "body is a \\\\ multi-line literal")
        try assert.ok(fixed.contains("tmpl.len()"), "call site dropped ()")
        try assert.is_false(fixed.contains(".concat("))
        try assert.is_false(fixed.contains("tmpl()"))

        // Fully converged: no findings remain.
        try assert.equal(findings(fixed).len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-record-prefix: annotated top-level let fires and strips the prefix",
      fn() {
        src := "c: Config = Config.{ a: 1, b: 2 }\n"
        fs := rp_findings(src)
        try assert.equal(fs.len(), 1)
        try assert.equal(apply_first_edit(src, fs[0]), "c: Config = .{ a: 1, b: 2 }\n")
        .Ok({})
      },
    )
    .test(
      "redundant-record-prefix: annotated let inside a function fires",
      fn() {
        fs := rp_findings("fn f() {\n  c: Config = Config.{ a: 1 }\n  print(1)\n}\n")
        try assert.equal(fs.len(), 1)
        .Ok({})
      },
    )
    .test(
      "redundant-record-prefix: inferred := binding does not fire",
      fn() {
        try assert.equal(rp_findings("d := Config.{ a: 1 }\n").len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-record-prefix: an already-anonymous literal does not fire",
      fn() {
        try assert.equal(rp_findings("c: Config = .{ a: 1 }\n").len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-record-prefix: a declared-return tail fires and strips",
      fn() {
        src := "fn f() Config {\n  Config.{ a: 1 }\n}\n"
        fs := rp_findings(src)
        try assert.equal(fs.len(), 1)
        try assert.equal(apply_first_edit(src, fs[0]), "fn f() Config {\n  .{ a: 1 }\n}\n")
        .Ok({})
      },
    )
    .test(
      "redundant-record-prefix: an explicit return of a named literal fires",
      fn() {
        fs := rp_findings("fn f() Config {\n  return Config.{ a: 1 }\n}\n")
        try assert.equal(fs.len(), 1)
        .Ok({})
      },
    )
    .test(
      "redundant-record-prefix: both if-arm tails in a declared-return body fire",
      fn() {
        fs := rp_findings(
          "fn f() Config {\n  if c {\n    Config.{ a: 1 }\n  } else {\n    Config.{ a: 2 }\n  }\n}\n",
        )
        try assert.equal(fs.len(), 2)
        .Ok({})
      },
    )
    .test(
      "redundant-record-prefix: a tail with no declared return type does not fire",
      fn() {
        try assert.equal(rp_findings("fn f() {\n  Config.{ a: 1 }\n}\n").len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-record-prefix: a named literal as a record field value fires",
      fn() {
        src := "c: Wrap = .{ inner: Inner.{ a: 1 } }\n"
        fs := rp_findings(src)
        try assert.equal(fs.len(), 1)
        try assert.equal(apply_first_edit(src, fs[0]), "c: Wrap = .{ inner: .{ a: 1 } }\n")
        .Ok({})
      },
    )
    .test(
      "redundant-record-prefix: nested named literals each fire",
      fn() {
        fs := rp_findings("c: Wrap = Wrap.{ inner: Inner.{ a: 1 } }\n")
        try assert.equal(fs.len(), 2)
        .Ok({})
      },
    )
    .test(
      "redundant-record-prefix: a call argument is not anchored in v1 (does not fire)",
      fn() {
        // Call args can be generic (type-variable) positions where a bare .{ } would
        // not typecheck, so v1 does not anchor them.
        try assert.equal(rp_findings("d := process(Config.{ a: 1 })\n").len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-record-prefix: a qualified constructor path is declined by the spelling gate",
      fn() {
        fs := rp_findings("c: Config = mod.Config.{ a: 1 }\n")

        // The NamedRecord name is the folded dotted path `mod.Config`, so the
        // `name.contains(".")` guard declines up front — no edit.
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-record-prefix: return inside an unannotated closure does not fire",
      fn() {
        src := "fn outer() Config {\n  ys := xs.map(fn(x) {\n    if x > 0 { return Config.{ a: 1 } }\n    Config.{ a: 0 }\n  })\n  ys[0]\n}\n"
        try assert.equal(rp_findings(src).len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-record-prefix: an annotated closure anchors its tail and return",
      fn() {
        src := "fn outer() Void {\n  f := fn(x) Config {\n    if x > 0 { return Config.{ a: 1 } }\n    Config.{ a: 0 }\n  }\n  g(f)\n}\n"
        try assert.equal(rp_findings(src).len(), 2)
        .Ok({})
      },
    )
    .test(
      "redundant-rebinding: describe returns a rationale",
      fn() {
        case lint_rules.describe("redundant-rebinding") {
          .Some(info) => {
            try assert.is_true(info.brief.len() > 0)
            .Ok({})
          },
          .None => .Err("expected a rationale for redundant-rebinding"),
        }
      },
    )
    .test(
      "redundant-record-prefix: describe returns a rationale",
      fn() {
        case lint_rules.describe("redundant-record-prefix") {
          .Some(info) => {
            try assert.is_true(info.brief.len() > 0)
            .Ok({})
          },
          .None => .Err("expected a rationale for redundant-record-prefix"),
        }
      },
    )
}
