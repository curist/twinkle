    .test(
      "redundant-rebinding: ignores a public temporary binding in the AST",
      fn() {
        // Public lets are valid only at module scope, so combine parser-produced
        // nodes to exercise the lint gate without an invalid in-function fixture.
        src := "fn f() Int {\n  acc := 0\n  acc2 := step(acc)\n  consume(acc2)\n}\n"
        module := parser.parse(src, 0).value
        public_module := parser.parse("pub acc2 := step(acc)\n", 0).value

        case module.items[0] {
          .Function(decl) => case public_module.items[0] {
            .Stmt(public_stmt) => {
              body := decl.body
              body.stmts[1] = public_stmt
              decl.body = body
              module.items[0] = .Function(decl)
              fs := lint.lint_module(module, base_env.builtin_env(), src)
              numbered := collect f in fs {
                if f.rule == "redundant-rebinding" {
                  f
                } else {
                  continue
                }
              }
              try assert.equal(numbered.len(), 0)
              .Ok({})
            },
            _ => .Err("expected a parser-produced public let"),
          },
          _ => .Err("expected a parser-produced function"),
        }
      },
    )
    .test(
      "redundant-rebinding: same-block declaration gate rejects a parameter base",
      fn() {
        fs := rr_findings("fn f(acc: Int) Int {\n  acc2 := step(acc)\n  consume(acc2)\n}\n")
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-rebinding: nested candidate cannot rebind an outer local",
