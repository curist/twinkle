use @std.testing.assert as assert
use @std.testing as runner

use commands.lint as lintcmd
use compiler.base_env
use compiler.lint
use compiler.lint_rules
use compiler.parser
use lib.source.report.{FixEdit}

fn findings(src: String) Vector<lint.LintFinding> {
  parsed := parser.parse(src, 0)
  lint.lint_module(parsed.value, base_env.builtin_env(), src)
}

// Findings for a single rule — the suite runs the whole rule set, so other
// rules (e.g. constant-fn on a one-expression body) would otherwise inflate a
// bare count.
fn ml_findings(src: String) Vector<lint.LintFinding> {
  collect f in findings(src) {
    if f.rule == "prefer-multiline-string" {
      f
    } else {
      continue
    }
  }
}

fn cf_findings(src: String) Vector<lint.LintFinding> {
  collect f in findings(src) {
    if f.rule == "constant-fn" {
      f
    } else {
      continue
    }
  }
}

// record-copy-helper now legitimately coexists with redundant-record-prefix on
// the same `T.{ … }` node in a declared-return tail position (one flags the
// syntactic prefix, the other the semantic self-copy) — filter to the rule
// under test rather than asserting a bare `findings()` count.
fn rc_findings(src: String) Vector<lint.LintFinding> {
  collect f in findings(src) {
    if f.rule == "record-copy-helper" {
      f
    } else {
      continue
    }
  }
}

fn rp_findings(src: String) Vector<lint.LintFinding> {
  collect f in findings(src) {
    if f.rule == "redundant-record-prefix" {
      f
    } else {
      continue
    }
  }
}

fn pc_findings(src: String) Vector<lint.LintFinding> {
  collect f in findings(src) {
    if f.rule == "prefer-cond" {
      f
    } else {
      continue
    }
  }
}

fn pid_findings(src: String) Vector<lint.LintFinding> {
  collect f in findings(src) {
    if f.rule == "prefer-inc-dec" {
      f
    } else {
      continue
    }
  }
}

fn rr_findings(src: String) Vector<lint.LintFinding> {
  collect f in findings(src) {
    if f.rule == "redundant-rebinding" {
      f
    } else {
      continue
    }
  }
}

fn apply_first_edit(src: String, finding: lint.LintFinding) String {
  edit := finding.edits[0]
  src.slice(0, edit.start).concat(edit.replacement).concat(src.slice(edit.end, src.len()))
}

// Re-analyze and apply every rule's edits until nothing changes — the same
// fixpoint `run_lint_command` runs, so one rewrite enabling another (a
// `.concat` chain -> `\\` body -> module constant) converges in one pass.
fn fix_to_fixpoint(src: String) String {
  cur := src
  i := 0

  for i < 10 {
    edits: Vector<FixEdit> = []

    for f in findings(cur) {
      edits = .concat(f.edits)
    }

    if edits.len() == 0 {
      return cur
    }

    cur = lintcmd.apply_edits(cur, edits)
    i = .inc()
  }

  cur
}

pub fn suite() runner.Suite {
  runner
    .suite("lint_pass")
    .test(
      "L4: unreachable statement after return",
      fn() {
        fs := findings("fn f() Int {\n  return 1\n  2\n}\n")
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].rule, "unreachable-code")
        .Ok({})
      },
    )
    .test(
      "L4: no finding when return is last",
      fn() {
        fs := findings("fn f() Int {\n  x := 1\n  return x\n}\n")
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "L4: unreachable after error() trap",
      fn() {
        fs := findings("fn f() Int {\n  error(\"boom\")\n  1\n}\n")
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].rule, "unreachable-code")
        .Ok({})
      },
    )
    .test(
      "L4: plain reachable code is not flagged",
      fn() {
        fs := findings("fn f() Int {\n  x := 1\n  x + 1\n}\n")
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "L4: unreachable after continue inside a loop body",
      fn() {
        fs := findings(
          "fn f() Int {\n  for true {\n    continue\n    println(\"x\")\n  }\n  0\n}\n",
        )
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].rule, "unreachable-code")
        .Ok({})
      },
    )
    .test(
      "L4: one finding per block (first unreachable only)",
      fn() {
        fs := findings("fn f() Int {\n  return 1\n  2\n  3\n}\n")
        try assert.equal(fs.len(), 1)
        .Ok({})
      },
    )
    .test(
      "L3: flags a with_* field-copy helper (anonymous record)",
      fn() {
        fs := findings(
          "fn with_docs(state: State, docs: Int) State {\n  .{ initialized: state.initialized, docs }\n}\n",
        )
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].rule, "record-copy-helper")
        .Ok({})
      },
    )
    .test(
      "L3: flags a named-record copy",
      fn() {
        fs := rc_findings(
          "fn dup(state: State) State {\n  State.{ initialized: state.initialized }\n}\n",
        )
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].rule, "record-copy-helper")
        .Ok({})
      },
    )
    .test(
      "L3: flags an arithmetic field update from the same field",
      fn() {
        fs := findings("fn bump(state: State) State {\n  .{ count: state.count + 1 }\n}\n")
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].rule, "record-copy-helper")
        .Ok({})
      },
    )
    .test(
      "L3: does not flag a fresh constructor with a same-type param",
      fn() {
        fs := findings("fn reset(state: State) State {\n  .{ count: 0 }\n}\n")
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "L3: does not flag a field derived from a different field",
      fn() {
        fs := findings("fn f(p: State) State {\n  .{ x: p.x, y: p.x.wrap() }\n}\n")
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "L3: autofixes a single-field wrapper update to direct rebinding",
      fn() {
        src := "fn set(m: BlockMap, k: Int, v: Int) BlockMap {\n  BlockMap.{ inner: m.inner.set(k, v) }\n}\n"
        fs := rc_findings(src)
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].edits.len(), 1)
        try assert.equal(
          apply_first_edit(src, fs[0]),
          "fn set(m: BlockMap, k: Int, v: Int) BlockMap {\n  m.inner = .set(k, v)\n  m\n}\n",
        )
        .Ok({})
      },
    )
    .test(
      "L3: autofixes a multi-field record with one updated field",
      fn() {
        src := "fn f(p: State) State {\n  State.{ x: p.x, y: p.y, z: p.z + 1 }\n}\n"
        fs := rc_findings(src)
        try assert.equal(fs.len(), 1)
        try assert.equal(
          apply_first_edit(src, fs[0]),
          "fn f(p: State) State {\n  p.z = p.z + 1\n  p\n}\n",
        )
        .Ok({})
      },
    )
    .test(
      "L3: autofixes multiple field updates when a field is also preserved",
      fn() {
        src := "fn f(p: State) State {\n  State.{ a: p.a, x: p.x + 1, y: p.y + 1 }\n}\n"
        fs := rc_findings(src)
        try assert.equal(fs.len(), 1)
        try assert.equal(
          apply_first_edit(src, fs[0]),
          "fn f(p: State) State {\n  p.x = p.x + 1\n  p.y = p.y + 1\n  p\n}\n",
        )
        .Ok({})
      },
    )
    .test(
      "L3: does not flag a multi-field record that recomputes every field",
      fn() {
        fs := rc_findings("fn f(p: State) State {\n  State.{ x: p.x + 1, y: p.y + 1 }\n}\n")
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "L3: does not autofix when an update reads another updated field (order hazard)",
      fn() {
        fs := rc_findings(
          "fn f(c: Ctx) Ctx {\n  Ctx.{ tag: c.tag, depth: c.depth + 1, levels: c.levels.set(k, c.depth) }\n}\n",
        )
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].edits.len(), 0)
        .Ok({})
      },
    )
    .test(
      "L3: does not autofix a multi-line update RHS (keeps rebinds single-line)",
      fn() {
        fs := rc_findings("fn f(p: State) State {\n  State.{ n: p.n\n    + 1 }\n}\n")
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].edits.len(), 0)
        .Ok({})
      },
    )
    .test(
      "L3: flags but does not autofix when a sibling field is a pass-through",
      fn() {
        fs := rc_findings(
          "fn f(p: State, docs: Int) State {\n  State.{ a: p.a, docs, z: p.z + 1 }\n}\n",
        )
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].edits.len(), 0)
        .Ok({})
      },
    )
    .test(
      "L3: does not flag when no parameter shares the record type",
      fn() {
        fs := findings("fn make(n: Int) State {\n  .{ initialized: n }\n}\n")
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "L3: flags a single-field wrapper updating its field from the same field",
      fn() {
        fs := rc_findings(
          "fn set(m: BlockMap, k: Int, v: Int) BlockMap {\n  BlockMap.{ inner: m.inner.set(k, v) }\n}\n",
        )
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].rule, "record-copy-helper")
        .Ok({})
      },
    )
    .test(
      "L5: flags index temporary copied back to the same path",
      fn() {
        fs := findings(
          "fn f(pf: PF) PF {\n  slots := pf.slots\n  slots[id] = info\n  pf.slots = slots\n  pf\n}\n",
        )
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].rule, "direct-rebinding")
        .Ok({})
      },
    )
    .test(
      "prefer-inc-dec: rewrites an incrementing local rebind",
      fn() {
        src := "fn f() Int {\n  i := 0\n  i = i + 1\n  i\n}\n"
        fs := pid_findings(src)
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].edits.len(), 1)
        try assert.equal(
          apply_first_edit(src, fs[0]),
          "fn f() Int {\n  i := 0\n  i = .inc()\n  i\n}\n",
        )
        .Ok({})
      },
    )
    .test(
      "prefer-inc-dec: rewrites incrementing and decrementing field rebinds",
      fn() {
        src := "fn f(c: Counter) Counter {\n  c.up = c.up + 1\n  c.down = c.down - 1\n  c\n}\n"
        fs := pid_findings(src)
        try assert.equal(fs.len(), 2)
        try assert.equal(
          apply_first_edit(src, fs[0]),
          "fn f(c: Counter) Counter {\n  c.up = .inc()\n  c.down = c.down - 1\n  c\n}\n",
        )
        try assert.equal(
          apply_first_edit(src, fs[1]),
          "fn f(c: Counter) Counter {\n  c.up = c.up + 1\n  c.down = .dec()\n  c\n}\n",
        )
        .Ok({})
      },
    )
    .test(
      "prefer-inc-dec: rewrites a nested field path",
      fn() {
        src := "fn f(s: State) State {\n  s.inner.count = s.inner.count - 1\n  s\n}\n"
        fs := pid_findings(src)
        try assert.equal(fs.len(), 1)
        try assert.equal(
          apply_first_edit(src, fs[0]),
          "fn f(s: State) State {\n  s.inner.count = .dec()\n  s\n}\n",
        )
        .Ok({})
      },
    )
    .test(
      "prefer-inc-dec: ignores non-self, compound, and indexed updates",
      fn() {
        src := "fn f(a: Counter, b: Counter, xs: Vector<Int>, i: Int) Counter {\n  a.count = b.count + 1\n  a.count = a.count + 1 + i\n  xs[i] = xs[i] + 1\n  a\n}\n"
        try assert.equal(pid_findings(src).len(), 0)
        .Ok({})
      },
    )
    .test(
      "L5: flags whole-record temporary returned at tail",
      fn() {
        fs := findings(
          "fn f(info: Info) Info {\n  updated := info\n  updated.repr = repr\n  updated\n}\n",
        )
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].rule, "direct-rebinding")
        .Ok({})
      },
    )
    .test(
      "L5: does not flag when temporary escapes to a call",
      fn() {
        fs := findings(
          "fn f(pf: PF) PF {\n  slots := pf.slots\n  slots[id] = info\n  other(slots)\n  pf.slots = slots\n  pf\n}\n",
        )
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "L5: flags pure-alias accumulator over a loop",
      fn() {
        fs := findings(
          "fn f(reg: Reg, specs: Specs) Reg {\n  cur := reg\n  for spec in specs {\n    cur = cur.add(spec)\n  }\n  cur\n}\n",
        )
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].rule, "direct-rebinding")
        .Ok({})
      },
    )
    .test(
      "L5: flags whole-record temporary assigned back to the source",
      fn() {
        fs := findings(
          "fn f(state: State) State {\n  updated := state\n  updated.cache = cache\n  state = updated\n  state\n}\n",
        )
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].rule, "direct-rebinding")
        .Ok({})
      },
    )
    .test(
      "L5: does not flag when the alias mixes in the old source value",
      fn() {
        fs := findings(
          "fn f(reg: Reg) Reg {\n  cur := reg\n  cur = cur.add(a)\n  cur = cur.merge(reg)\n  cur\n}\n",
        )
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "L5: does not flag when the source path is read between update and copy-back",
      fn() {
        fs := findings(
          "fn f(reg: Reg) Reg {\n  tmp := reg.by_name\n  tmp[k] = v\n  log(reg.by_name.len())\n  reg.by_name = tmp\n  reg\n}\n",
        )
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "L5: flags a deep field path copied back",
      fn() {
        fs := findings(
          "fn f(state: State) State {\n  tmp := state.registry.by_name\n  tmp[name] = entry\n  state.registry.by_name = tmp\n  state\n}\n",
        )
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].rule, "direct-rebinding")
        .Ok({})
      },
    )
    .test(
      "L5: does not flag an indexed source path",
      fn() {
        fs := findings(
          "fn f(reg: Reg) Reg {\n  tmp := reg.by_name[key()]\n  tmp.value = v\n  reg.by_name[key()] = tmp\n  reg\n}\n",
        )
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "L5: does not flag an extracted (unwrapped) value",
      fn() {
        fs := findings(
          "fn f(reg: Reg) Reg {\n  entry := reg.by_name[name].unwrap()\n  entry.canonical = c\n  reg.by_name[name] = entry\n  reg\n}\n",
        )
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "L5: does not flag a conditionally-updated temporary (not straight-line)",
      fn() {
        fs := findings(
          "fn f(state: State) State {\n  tmp := state.config\n  if enabled {\n    tmp.debug = true\n  }\n  state.config = tmp\n  state\n}\n",
        )
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "L5: does not flag when a prefix of the source path is read",
      fn() {
        fs := findings(
          "fn f(state: State) State {\n  tmp := state.registry.by_name\n  tmp[k] = v\n  log(state.registry)\n  state.registry.by_name = tmp\n  state\n}\n",
        )
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-rebinding: reports a straight-line forward thread without edits",
      fn() {
        fs := rr_findings("fn f() Int {\n  acc := 0\n  acc2 := step(acc)\n  consume(acc2)\n}\n")
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].edits.len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-rebinding: rewrites a pure alias by deleting the seed and renaming",
      fn() {
        src := "fn f() Int {\n  acc := 0\n  acc2 := acc\n  consume(acc2)\n}\n"
        fs := rr_findings(src)
        try assert.equal(fs.len(), 1)

        // Whole-statement delete plus one forward rename; no type gate needed.
        try assert.equal(fs[0].edits.len(), 2)
        fixed := lintcmd.apply_edits(src, fs[0].edits)
        try assert.is_false(fixed.contains("acc2"))
        try assert.is_true(fixed.contains("consume(acc)"))
        .Ok({})
      },
    )
    .test(
      "redundant-rebinding: a pure alias fires regardless of naming",
      fn() {
        // `foo := bar` is unnecessary even though `foo` is not a numbered or
        // suffixed sibling of `bar` — a pure alias adds no information.
        src := "fn f() Int {\n  bar := 0\n  foo := bar\n  consume(foo)\n}\n"
        fs := rr_findings(src)
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].edits.len(), 2)
        fixed := lintcmd.apply_edits(src, fs[0].edits)
        try assert.is_false(fixed.contains("foo"))
        try assert.is_true(fixed.contains("consume(bar)"))
        .Ok({})
      },
    )
    .test(
      "redundant-rebinding: a computed advance with an unrelated name is left alone",
      fn() {
        // `sorted := sort(items)` is a meaningful rename, not ceremony — the
        // sibling-name heuristic still gates the computed shape.
        src := "fn f() Int {\n  items := gather()\n  sorted := sort(items)\n  consume(sorted)\n}\n"
        fs := rr_findings(src)
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-rebinding: rewrites a computed candidate with matching annotations",
      fn() {
        src := "fn f() Int {\n  acc: Int = 0\n  acc2: Int = step(acc)\n  consume(acc2)\n}\n"
        fs := rr_findings(src)
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].edits.len(), 2)
        fixed := lintcmd.apply_edits(src, fs[0].edits)
        try assert.is_false(fixed.contains("acc2"))
        try assert.is_true(fixed.contains("acc = step(acc)"))
        try assert.is_true(fixed.contains("consume(acc)"))
        .Ok({})
      },
    )
    .test(
      "redundant-rebinding: renames every forward occurrence",
      fn() {
        src := "fn f() Int {\n  state: Int = initial()\n  state_next: Int = step(state)\n  combine(state_next, state_next)\n}\n"
        fs := rr_findings(src)
        try assert.equal(fs.len(), 1)

        // Binding rewrite plus one edit per forward read.
        try assert.equal(fs[0].edits.len(), 3)
        fixed := lintcmd.apply_edits(src, fs[0].edits)
        try assert.is_false(fixed.contains("state_next"))
        try assert.is_true(fixed.contains("combine(state, state)"))
        .Ok({})
      },
    )
    .test(
      "redundant-rebinding: pure-alias deletion preserves an intervening comment",
      fn() {
        src := "fn f() Int {\n  acc := 0\n  acc2 := acc\n  // keep me\n  consume(acc2)\n}\n"
        fs := rr_findings(src)
        try assert.equal(fs.len(), 1)
        fixed := lintcmd.apply_edits(src, fs[0].edits)
        try assert.is_true(fixed.contains("// keep me"))
        try assert.is_false(fixed.contains("acc2"))
        .Ok({})
      },
    )
    .test(
      "redundant-rebinding: enumerates multiple forward reads",
      fn() {
        fs := rr_findings(
          "fn f() Int {\n  state := initial()\n  state_next := step(state)\n  combine(state_next, state_next)\n}\n",
        )
        try assert.equal(fs.len(), 1)
        .Ok({})
      },
    )
    .test(
      "redundant-rebinding: reports a leading-marker sibling",
      fn() {
        fs := rr_findings(
          "fn f() Int {\n  slots := initial()\n  new_slots := step(slots)\n  consume(new_slots)\n}\n",
        )
        try assert.equal(fs.len(), 1)
        .Ok({})
      },
    )
    .test(
      "redundant-rebinding: computed unannotated candidates stay report-only",
      fn() {
        fs := rr_findings(
          "fn f() Int {\n  cache := initial()\n  cache2 := step(cache)\n  consume(cache2)\n}\n",
        )
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].edits.len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-rebinding: differing annotations stay report-only",
      fn() {
        fs := rr_findings(
          "fn f() Int {\n  cache: Int = initial()\n  cache2: Other = step(cache)\n  consume(cache2)\n}\n",
        )
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].edits.len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-rebinding: a comment in the binding prefix stays report-only",
      fn() {
        fs := rr_findings(
          "fn f() Int {\n  cache: Int = initial()\n  cache2: Int // preserve this\n    = step(cache)\n  consume(cache2)\n}\n",
        )
        try assert.equal(fs.len(), 1)
        try assert.equal(fs[0].edits.len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-rebinding: requires an exact base read in the candidate RHS",
      fn() {
        fs := rr_findings("fn f() Int {\n  acc := 0\n  acc2 := unrelated()\n  consume(acc2)\n}\n")
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-rebinding: declines when the old base remains live",
      fn() {
        fs := rr_findings(
          "fn f() Int {\n  acc := 0\n  acc2 := step(acc)\n  consume(acc2)\n  consume(acc)\n}\n",
        )
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-rebinding: leaves an unused numbered binding to unused-bindings",
      fn() {
        fs := rr_findings("fn f() Int {\n  acc := 0\n  acc2 := step(acc)\n  1\n}\n")
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-rebinding: declines a forward read captured by a closure",
      fn() {
        fs := rr_findings(
          "fn f() fn() Int {\n  acc := 0\n  acc2 := step(acc)\n  callback := fn() { consume(acc2) }\n  callback\n}\n",
        )
        try assert.equal(fs.len(), 0)
        .Ok({})
      },
    )
    .test(
      "redundant-rebinding: declines a record shorthand forward read",
