        try assert.equal(fs[0].rule, "prefer-case-dispatch")
        try assert.equal(
          apply_first_edit(src, fs[0]),
          "fn f(kind: Kind) Int {\n  case kind {\n    .A => 1,\n    .B(2) => 2,\n    _ => 0,\n  }\n}\n",
        )
        .Ok({})
