use @std.testing.assert as assert
use @std.testing as runner

use compiler.local_map
use compiler.local_map.{LocalMap}
use compiler.ownership

fn ints_eq(a: Int, b: Int) Bool {
  a == b
}

// Bool (valid) and Vector<Int> (prov) operations are self-contained so the suite
// exercises the generic across all three instantiated T without depending on
// ownership.tw internals (union_sorted/same_live are private there).
fn and_b(a: Bool, b: Bool) Bool {
  a and b
}

fn eq_b(a: Bool, b: Bool) Bool {
  a == b
}

fn contains_i(v: Vector<Int>, x: Int) Bool {
  for e in v {
    if e == x {
      return true
    }
  }
  false
}

fn union_i(a: Vector<Int>, b: Vector<Int>) Vector<Int> {
  out := a
  for x in b {
    if !contains_i(out, x) {
      out = .append(x)
    }
  }
  out
}

fn same_i(a: Vector<Int>, b: Vector<Int>) Bool {
  if a.len() != b.len() {
    return false
  }
  for x, i in a {
    if x != b[i] {
      return false
    }
  }
  true
}

// Plumbing-only operation: union_i is order-sensitive and consistent with same_i only when the merged-in elements are fresh — sufficient for exercising the generic, not a general set lattice.
fn get_or_neg(m: LocalMap<Int>, k: Int) Int {
  case m.get(k) {
    .Some(v) => v,
    .None => 0 - 1,
  }
}

fn get_or_true(m: LocalMap<Bool>, k: Int) Bool {
  case m.get(k) {
    .Some(v) => v,
    .None => true,
  }
}

fn get_or_empty(m: LocalMap<Vector<Int>>, k: Int) Vector<Int> {
  case m.get(k) {
    .Some(v) => v,
    .None => [],
  }
}

pub fn suite() runner.Suite {
  runner
    .suite("cfg lattice")
    .test(
      "merge_targeted own: force-lock joins Unique+Shared to Shared",
      fn() {
        old: LocalMap<Int> = local_map.local_map()
        old = .set(5, 0) // Unique
        next: LocalMap<Int> = local_map.local_map()
        next = .set(5, 1) // Shared
        res := ownership.merge_targeted(
          old,
          next,
          local_map.local_map(),
          [],
          false,
          true,
          2,
          ownership.join_own_tag,
          ints_eq,
        )
        try assert.equal(res.locked.len(), 1)
        try assert.equal(res.locked[0], 5)
        try assert.equal(get_or_neg(res.map, 5), 1)
        .Ok({})
      },
    )
    .test(
      "merge_targeted own: unchanged, unlocked key takes next exactly",
      fn() {
        old: LocalMap<Int> = local_map.local_map()
        old = .set(3, 0)
        next: LocalMap<Int> = local_map.local_map()
        next = .set(3, 0)
        res := ownership.merge_targeted(
          old,
          next,
          local_map.local_map(),
          [],
          false,
          false,
          2,
          ownership.join_own_tag,
          ints_eq,
        )
        try assert.equal(res.locked.len(), 0)
        try assert.equal(get_or_neg(res.map, 3), 0)
        .Ok({})
      },
    )
    .test(
      "merge_targeted own: oscillation back to prev locks + meets",
      fn() {
        old: LocalMap<Int> = local_map.local_map()
        old = .set(7, 0) // Unique
        next: LocalMap<Int> = local_map.local_map()
        next = .set(7, 1) // Shared
        prev: LocalMap<Int> = local_map.local_map()
        prev = .set(7, 1) // next == prev => oscillates
        res := ownership.merge_targeted(
          old,
          next,
          prev,
          [],
          true,
          false,
          2,
          ownership.join_own_tag,
          ints_eq,
        )
        try assert.equal(res.locked.len(), 1)
        try assert.equal(get_or_neg(res.map, 7), 1) // join_own(Unique,Shared)=Shared
        .Ok({})
      },
    )
    .test(
      "merge_targeted own: already-locked key always joins",
      fn() {
        old: LocalMap<Int> = local_map.local_map()
        old = .set(1, 0)
        next: LocalMap<Int> = local_map.local_map()
        next = .set(1, 0) // unchanged: would not normally trigger a lock/join
        res := ownership.merge_targeted(
          old,
          next,
          local_map.local_map(),
          [1],
          false,
          false,
          2,
          ownership.join_own_tag,
          ints_eq,
        )
        try assert.equal(res.locked.len(), 1)
        try assert.equal(get_or_neg(res.map, 1), 0) // join(Unique,Unique)=Unique
        .Ok({})
      },
    )
    .test(
      "merge_targeted valid: force-lock meets true & false to false",
      fn() {
        old: LocalMap<Bool> = local_map.local_map()
        old = .set(2, true)
        next: LocalMap<Bool> = local_map.local_map()
        next = .set(2, false)
        res := ownership.merge_targeted(
          old,
          next,
          local_map.local_map(),
          [],
          false,
          true,
          true,
          and_b,
          eq_b,
        )
        try assert.equal(res.locked.len(), 1)
        try assert.is_false(get_or_true(res.map, 2))
        .Ok({})
      },
    )
    .test(
      "merge_targeted prov: force-lock unions param-origin sets",
      fn() {
        old: LocalMap<Vector<Int>> = local_map.local_map()
        old = .set(4, [1])
        next: LocalMap<Vector<Int>> = local_map.local_map()
        next = .set(4, [2])
        res := ownership.merge_targeted(
          old,
          next,
          local_map.local_map(),
          [],
          false,
          true,
          [],
          union_i,
          same_i,
        )
        try assert.equal(res.locked.len(), 1)
        try assert.equal(get_or_empty(res.map, 4).len(), 2) // union([1],[2])
        .Ok({})
      },
    )
    .test(
      "same_map: equal compare true, differing compare false",
      fn() {
        a: LocalMap<Int> = local_map.local_map()
        a = .set(1, 0)
        b: LocalMap<Int> = local_map.local_map()
        b = .set(1, 0)
        c: LocalMap<Int> = local_map.local_map()
        c = .set(1, 1)
        try assert.is_true(ownership.same_map(a, b, ints_eq))
        try assert.is_false(ownership.same_map(a, c, ints_eq))
        .Ok({})
      },
    )
    .test(
      "nested_get: absent id yields empty inner map",
      fn() {
        outer: Dict<Int, LocalMap<Int>> = Dict.new()
        inner: LocalMap<Int> = local_map.local_map()
        inner = .set(2, 9)
        outer[10] = inner
        try assert.equal(ownership.nested_get(outer, 10).len(), 1)
        try assert.equal(ownership.nested_get(outer, 99).len(), 0)
        .Ok({})
      },
    )
}
