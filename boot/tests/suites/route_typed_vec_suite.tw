//! End-to-end tests for typed-gather routing (Stage 1) in
//! boot/compiler/backend/route_typed_vec.tw.
//!
//! `gather(v, idx)` over a receiver `v` that is already a typed PVecI64 (e.g. a
//! payload bound from a typed variant field) must route to the typed
//! `vector$gather_i64`: `v` stays a typed-safe read (like `len`), and the gather
//! RESULT is retyped to PVecI64 so the call selects the typed op and the typed
//! result stores back into the typed payload with no re-box.
//!
//! These fixtures compile a tiny .tw source through the real pipeline, run the
//! whole-program typed-payload analysis, then exercise route_typed_vectors and
//! inspect the routed slots + call targets.

use @std.testing.assert as assert
use @std.testing as runner

use compiler.backend.closure_convert.{convert_closures}
use compiler.backend.phys_plan
use compiler.backend.prepare.{prepare_backend_preroute}
use compiler.backend.prepared_ir.{PreparedExpr, PreparedFunc, PreparedOp, SlotInfo}
use compiler.backend.repr_policy.{ElemRepr}
use compiler.backend.route_typed_vec.{
  analyze_typed_fields, analyze_typed_payloads, route_typed_vectors,
}
use compiler.base_env.{first_user_type_id}
use compiler.builtins.{BuiltinRegistry}
use compiler.codegen.wasm_layout.{pvec_wasm_type}
use compiler.codegen.wasm_type_util.{val_type_eq}
use compiler.pipeline

type RouteInputs = .{ funcs: Vector<PreparedFunc>, builtins: BuiltinRegistry }

fn prepare_src(src: String) Result<RouteInputs, String> {
  artifacts := try pipeline.compile_source(src)
  cc := convert_closures(artifacts.opt, artifacts.env)
  prepared := prepare_backend_preroute(cc.anf, artifacts.env, artifacts.builtins, cc.captures)
  .Ok(.{ funcs: prepared.funcs, builtins: artifacts.builtins })
}

fn is_pvec_i64(info: SlotInfo) Bool {
  case info.wasm_type {
    .Ref(_, ht) => case ht {
      .Named(n) => n == "rt_types__PVecI64",
      _ => false,
    },
    _ => false,
  }
}

fn pvec_i64_slot_count(funcs: Vector<PreparedFunc>) Int {
  n := 0

  for pf in funcs {
    for sid in pf.slots.keys() {
      case pf.slots[sid] {
        .Some(info) => if is_pvec_i64(info) {
          n = n + 1
        },
        .None => {},
      }
    }
  }

  n
}

fn typed_count(d: Dict<String, Bool>) Int {
  n := 0

  for k in d.keys() {
    case d[k] {
      .Some(v) => if v {
        n = n + 1
      },
      .None => {},
    }
  }

  n
}

// True if any function body calls the builtin whose FuncId is `fid_id`.
fn funcs_call_fid(funcs: Vector<PreparedFunc>, fid_id: Int) Bool {
  for pf in funcs {
    if expr_calls_fid(pf.body, fid_id) {
      return true
    }
  }

  false
}

fn expr_calls_fid(expr: PreparedExpr, fid_id: Int) Bool {
  case expr {
    .Let(_, op, body) => op_calls_fid(op, fid_id) or expr_calls_fid(body, fid_id),
    _ => false,
  }
}

fn op_calls_fid(op: PreparedOp, fid_id: Int) Bool {
  case op {
    .ACall(callee, _) => case callee {
      .AGlobalFunc(fid) => fid.id == fid_id,
      _ => false,
    },
    .AIf(_, then_e, else_e) => expr_calls_fid(then_e, fid_id) or expr_calls_fid(else_e, fid_id),
    .AMatch(_, arms) => {
      for arm in arms {
        if expr_calls_fid(arm.body, fid_id) {
          return true
        }
      }

      false
    },
    .ALoop(inner) => expr_calls_fid(inner, fid_id),
    .ADefer(inner) => expr_calls_fid(inner, fid_id),
    _ => false,
  }
}

// Find the func_id.id of the (only) function named `name`.
fn find_func_id(funcs: Vector<PreparedFunc>, name: String) Int? {
  for pf in funcs {
    if pf.name == name {
      return .Some(pf.func_id.id)
    }
  }

  .None
}

// Find the (only) function named `name`, so its phys_return override can be
// inspected directly.
fn find_func(funcs: Vector<PreparedFunc>, name: String) PreparedFunc? {
  for pf in funcs {
    if pf.name == name {
      return .Some(pf)
    }
  }

  .None
}

// Find the SlotId.id a call to `fid_id` binds its result to inside `expr`
// (the first `let slot = call(...)` site found), or .None.
fn find_call_result_slot(expr: PreparedExpr, fid_id: Int) Int? {
  case expr {
    .Let(slot, op, body) => case op {
      .ACall(callee, _) => case callee {
        .AGlobalFunc(fid) => if fid.id == fid_id {
          .Some(slot.id)
        } else {
          find_call_result_slot(body, fid_id)
        },
        _ => find_call_result_slot(body, fid_id),
      },
      _ => find_call_result_slot(body, fid_id),
    },
    _ => .None,
  }
}

type CallSite = .{ func_index: Int, slot: Int }

// Find the (func_index, slot) of the first call-result binding to `fid_id`
// across every function's body.
fn find_call_result_slot_in_funcs(funcs: Vector<PreparedFunc>, fid_id: Int) CallSite? {
  for pf, fi in funcs {
    case find_call_result_slot(pf.body, fid_id) {
      .Some(sid) => return .Some(.{ func_index: fi, slot: sid }),
      .None => {},
    }
  }

  .None
}

fn find_slot_info(funcs: Vector<PreparedFunc>, func_index: Int, slot_id: Int) SlotInfo? {
  funcs[func_index].slots[slot_id]
}

// A function `g` returning Vector<Int> and a caller reading `g()` by index
// only. `g`'s own body has no typed producer visible to route in isolation
// (its collect result is consumed by len/return only within `g`, but the
// point of this fixture is `caller`'s call-result slot: is it retyped to
// PVecI64 purely because `plan.returns` says so, with the legacy
// `typeable_return` map passed empty).
return_source :=
  \\fn g() Vector<Int> {
  \\  collect i in range(4) { i }
  \\}
  \\fn caller() Int {
  \\  v := g()
  \\  v[0]
  \\}
  \\caller()
  \\

// Bool-family analogue of return_source: `g` returns Vector<Bool>, consumed by
// `caller` via indexed read only. Exercises the non-i64 branch of the
// PhysPlan-derived phys_return: pvec_wasm_type(elem) must select PVecBool, not
// the i64 default a hand-written `.Ref(true, .Named(fi.fam.pvec_type))` would
// also produce (so this fixture is the one that actually distinguishes
// "derived from the plan's elem" from "hand-written from the active family").
bool_return_source :=
  \\fn g() Vector<Bool> {
  \\  collect i in range(4) { i % 2 == 0 }
  \\}
  \\fn caller() Bool {
  \\  v := g()
  \\  v[0]
  \\}
  \\caller()
  \\

// A Vector<Int> in a typed variant payload (IntCol), gathered inside a function
// and stored back into the same typed payload. data is a clean collect producer
// so analyze_typed_payloads types the IntCol payload.
gather_source :=
  \\type Col = { IntCol(Vector<Int>) }
  \\fn make_col(n: Int) Col {
  \\  xs := collect i in range(n) { i * 2 }
  \\  .IntCol(xs)
  \\}
  \\fn gather_col(c: Col, idx: Vector<Int>) Col {
  \\  case c {
  \\    .IntCol(v) => .IntCol(v.gather(idx)),
  \\  }
  \\}
  \\fn first(c: Col) Int {
  \\  case c {
  \\    .IntCol(v) => v[0],
  \\  }
  \\}
  \\n := 8
  \\col := make_col(n)
  \\idx := collect i in range(n) { n - 1 - i }
  \\out := gather_col(col, idx)
  \\first(out)
  \\

pub fn suite() runner.Suite {
  runner
    .suite("typed gather routing")
    .test(
      "typed payload gather routes to gather_i64 and retypes the receiver+result",
      fn() {
        p := try prepare_src(gather_source)
        tf := analyze_typed_fields(p.funcs, p.builtins, Dict.new())
        tp := analyze_typed_payloads(p.funcs, p.builtins, first_user_type_id(), Dict.new())

        // Sanity: the IntCol payload was decided typed.
        try assert.ok(typed_count(tp) >= 1, "expected the IntCol payload to be typed")

        gid := p.builtins.id("vector$gather_i64").id

        // Empty payload set: the payload binding stays boxed, so the gather
        // receiver is not typed, the swap must not fire, and no slot retypes.
        empty: Dict<String, Bool> = Dict.new()
        routed_empty := route_typed_vectors(p.funcs, p.builtins, phys_plan.empty(), empty, empty).funcs
        try assert.ok(
          !funcs_call_fid(routed_empty, gid),
          "gather_i64 must not fire without the typed payload set",
        )

        // Real set: the payload read `v` and the gather RESULT retype to PVecI64,
        // and the gather call routes to gather_i64.
        routed := route_typed_vectors(p.funcs, p.builtins, phys_plan.empty(), tf, tp).funcs
        try assert.ok(funcs_call_fid(routed, gid), "expected gather to route to gather_i64")
        try assert.ok(
          pvec_i64_slot_count(routed) > pvec_i64_slot_count(routed_empty),
          "typed payload set must retype the gather receiver + result slots",
        )
        .Ok({})
      },
    )
    .test(
      "route reads return typing from PhysPlan, not the legacy typeable_return map",
      fn() {
        p := try prepare_src(return_source)
        gid := try find_func_id(p.funcs, "g").ok_or("g not found")
        caller := try find_call_result_slot_in_funcs(p.funcs, gid).ok_or(
          "no call to g found in caller",
        )

        // Baseline: empty plan AND empty legacy typeable_return -> boxed, the
        // call-result slot must NOT be PVecI64.
        boxed := route_typed_vectors(p.funcs, p.builtins, phys_plan.empty(), Dict.new(), Dict.new()).funcs
        boxed_slot := try find_slot_info(boxed, caller.func_index, caller.slot).ok_or(
          "call-result slot missing after boxed route",
        )
        try assert.ok(
          !is_pvec_i64(boxed_slot),
          "call-result slot must stay boxed with no plan and no legacy map",
        )

        // Plan carries the typed return; legacy typeable_return/capture_abi are
        // BOTH still empty, so a pass here proves the typing came from the plan.
        plan := phys_plan.empty()
        plan.returns["${gid}"] = ElemRepr.I64

        routed := route_typed_vectors(p.funcs, p.builtins, plan, Dict.new(), Dict.new()).funcs
        routed_slot := try find_slot_info(routed, caller.func_index, caller.slot).ok_or(
          "call-result slot missing after plan-driven route",
        )
        try assert.ok(
          is_pvec_i64(routed_slot),
          "call-result slot should be PVecI64 when the PLAN carries the typed return",
        )
        .Ok({})
      },
    )
    .test(
      "route sets repr = TypedVec and derives wasm_type",
      fn() {
        p := try prepare_src(gather_source)
        tf := analyze_typed_fields(p.funcs, p.builtins, Dict.new())
        tp := analyze_typed_payloads(p.funcs, p.builtins, first_user_type_id(), Dict.new())

        routed := route_typed_vectors(p.funcs, p.builtins, phys_plan.empty(), tf, tp)

        typed_slots := 0

        for pf in routed.funcs {
          for sid in pf.slots.keys() {
            case pf.slots[sid] {
              .Some(info) => case info.repr {
                // Every routed typed-vector slot carries TypedVec(elem) (not the
                // boxed TypedRef default) and a wasm_type derived from that repr.
                .TypedVec(elem) => {
                  typed_slots = typed_slots + 1

                  try assert.ok(
                    val_type_eq(info.wasm_type, pvec_wasm_type(elem)),
                    "TypedVec slot wasm_type must equal pvec_wasm_type(elem)",
                  )
                  try assert.ok(
                    is_pvec_i64(info),
                    "i64 producer TypedVec slot must be physically PVecI64",
                  )
                },
                _ => {},
              },
              .None => {},
            }
          }
        }

        try assert.ok(typed_slots > 0, "expected at least one TypedVec slot after route")
        .Ok({})
      },
    )
    .test(
      "phys_return is derived from PhysPlan.return_repr, not hand-written from the active family",
      fn() {
        p := try prepare_src(bool_return_source)
        gid := try find_func_id(p.funcs, "g").ok_or("g not found")

        plan := phys_plan.empty()
        plan.returns["${gid}"] = ElemRepr.I32

        routed := route_typed_vectors(p.funcs, p.builtins, plan, Dict.new(), Dict.new())

        g_routed := try find_func(routed.funcs, "g").ok_or("g missing after route")
        phys_ret := try g_routed.phys_return.ok_or("g must expose a typed phys_return")

        ret_elem := try plan.return_repr(gid).ok_or("plan must carry g's typed return entry")

        try assert.ok(
          val_type_eq(phys_ret, pvec_wasm_type(ret_elem)),
          "phys_return must equal pvec_wasm_type(plan's return elem)",
        )
        try assert.ok(
          val_type_eq(phys_ret, pvec_wasm_type(ElemRepr.I32)),
          "expected the Bool family's own PVecBool, not an i64-family default",
        )
        .Ok({})
      },
    )
}
