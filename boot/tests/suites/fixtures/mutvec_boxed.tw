// Runtime execution matrix for the compiler-private boxed MutVec family
// (docs/plans/2026-09-28-boxed-reference-mutvec.md, Task 4). Each `run_*` builds
// a producer-rooted `Vector<T>` for a concrete GC-reference element type, carries
// it through a recursive record (`Box<T>`), and permutes it with a helper-based
// read-before-write swap — the exact shape that activates the boxed aggregate
// route. Swaps only permute elements, so every element weight is preserved; each
// `run_*` publishes its vector, reads the elements back, and sums their weights.
// A correct boxed get/set/freeze round-trip therefore reproduces the pre-permute
// sum for every element kind. This is a `target/twk run` gate:
//
//   target/twk run <this file>   # -> prints 84 (21 + 21 + 21 + 21)
//   (flag-off / persistent path prints 84 identically; boxed must not diverge)
type Box<T> = .{ items: Vector<T>, count: Int }

fn swap<T>(xs: Vector<T>, i: Int, j: Int) Vector<T> {
  a := xs[i]
  b := xs[j]
  xs.set_at(i, b).set_at(j, a)
}

fn permute<T>(state: Box<T>, n: Int) Box<T> {
  next := Box.{ items: state.items, count: state.count + 1 }
  if n == 0 {
    next
  } else {
    next = .permute(n - 1)
    i := n - 1
    for i >= 0 {
      next = Box.{ items: swap(next.items, n - 1, i), count: next.count }
      next = .permute(n - 1)
      next = Box.{ items: swap(next.items, n - 1, i), count: next.count }
      i = .dec()
    }
    next
  }
}

type Person = .{ id: Int, score: Int }

// Records: weight = score (1..6), sum 21, preserved across swaps.
fn run_records() Int {
  people: Vector<Person> = collect i in range(6) {
    Person.{ id: i, score: i + 1 }
  }
  out := permute(Box.{ items: people, count: 0 }, 4).items
  total := 0
  for p in out {
    total = total + p.score
  }
  total
}

// Strings: weight = length (1..6), sum 21, preserved across swaps.
fn run_strings() Int {
  words: Vector<String> = ["a", "bb", "ccc", "dddd", "eeeee", "ffffff"]
  out := permute(Box.{ items: words, count: 0 }, 4).items
  total := 0
  for w in out {
    total = total + w.len()
  }
  total
}

// Nested vectors: weight = sum of the inner vector; inner j = [j+1] for j in
// 0..5, so the inner sums are 1..6, total 21, preserved across swaps.
fn run_nested() Int {
  rows: Vector<Vector<Int>> = collect j in range(6) {
    single: Vector<Int> = [j + 1]
    single
  }
  out := permute(Box.{ items: rows, count: 0 }, 4).items
  total := 0
  for row in out {
    for v in row {
      total = total + v
    }
  }
  total
}

// Closures: weight = f(0) where f adds a captured k (1..6), sum 21, preserved.
fn run_closures() Int {
  fns: Vector<fn(Int) Int> = collect k in range(6) {
    fn(x: Int) Int { x + k + 1 }
  }
  out := permute(Box.{ items: fns, count: 0 }, 4).items
  total := 0
  for f in out {
    total = total + f(0)
  }
  total
}

fn main() Int {
  run_records() + run_strings() + run_nested() + run_closures()
}

println(main())
