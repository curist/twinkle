//! Tests for analyze_typed_fields in boot/compiler/backend/route_typed_vec.tw.
//!
//! analyze_typed_fields decides, per (TypeId, FieldId), whether a Vector<Int>
//! record field can be physically stored as PVecI64. The conservative policy
//! (Approach B): a field is typed iff it has at least one typed-routable producer
//! (a collect/builder whose only other uses are index/len) and every producer and
//! consumer is typed-friendly. Any boxed producer (param/combinator result),
//! escaping consumer, or a value feeding multiple fields demotes the field.
//!
//! These are end-to-end fixtures: each test compiles a tiny .tw source through
//! the real pipeline (compile_source -> closure_convert -> prepare_backend), then
//! runs analyze_typed_fields on the prepared funcs and inspects the decision dict.

use @std.testing.assert as assert
use @std.testing as runner

use compiler.backend.closure_convert.{convert_closures}
use compiler.backend.phys_plan
use compiler.backend.prepare.{
  PreparedModule, backend_context, prepare_backend, prepare_backend_preroute,
}
use compiler.backend.prepared_ir.{PreparedFunc, SlotId, SlotInfo}
use compiler.backend.route_typed_vec.{analyze_typed_fields, route_typed_vectors}
use compiler.backend.verify.{verify_prepared_module_with_level}
use compiler.builtins.{BuiltinRegistry}
use compiler.codegen.wasm_layout.{pvec_wasm_type, val_type_of_mono}
use compiler.core_ir.{FuncId, LocalId}
use compiler.pipeline
use compiler.resolver.{ResolvedEnv}

// Compile source to the prepared backend funcs + builtin registry, then run the
// whole-program typed-field analysis on them.
fn analyze_src(src: String) Result<Dict<String, Bool>, String> {
  artifacts := try pipeline.compile_source(src)
  cc := convert_closures(artifacts.opt, artifacts.env)

  // Analyze the pre-routing prepared funcs: routing retypes producer slots to
  // PVecI64, which would hide them from this analysis pass.
  prepared := prepare_backend_preroute(cc.anf, artifacts.env, artifacts.builtins, cc.captures)
  .Ok(analyze_typed_fields(prepared.funcs, artifacts.builtins, Dict.new()))
}

type RouteInputs = .{ funcs: Vector<PreparedFunc>, builtins: BuiltinRegistry }

// Compile source to prepared backend funcs + registry (the raw inputs to both
// analyze_typed_fields and route_typed_vectors).
fn prepare_src(src: String) Result<RouteInputs, String> {
  artifacts := try pipeline.compile_source(src)
  cc := convert_closures(artifacts.opt, artifacts.env)

  // Use the pre-routing funcs so route_typed_vectors can be exercised on
  // un-routed slots (prepare_backend already routes its final funcs).
  prepared := prepare_backend_preroute(cc.anf, artifacts.env, artifacts.builtins, cc.captures)
  .Ok(.{ funcs: prepared.funcs, builtins: artifacts.builtins })
}

type VerifyInputs = .{ prepared: PreparedModule, env: ResolvedEnv, builtins: BuiltinRegistry }

// Compile source through the full backend preparation (including typed-vector
// routing), returning the routed PreparedModule plus the env/builtins the
// verifier consumes. The routed module's producer/field-read slots are already
// PVecI64 where the field set says the field is typed.
fn verify_inputs(src: String) Result<VerifyInputs, String> {
  artifacts := try pipeline.compile_source(src)
  cc := convert_closures(artifacts.opt, artifacts.env)
  prepared := prepare_backend(cc.anf, artifacts.env, artifacts.builtins, cc.captures)
  .Ok(.{ prepared, env: artifacts.env, builtins: artifacts.builtins })
}

// True if a slot's physical wasm storage is the typed PVecI64 ref.
fn is_pvec_i64(info: SlotInfo) Bool {
  case info.wasm_type {
    .Ref(_, ht) => case ht {
      .Named(n) => n == "rt_types__PVecI64",
      _ => false,
    },
    _ => false,
  }
}

// Count slots across all funcs whose physical wasm type is PVecI64.
fn pvec_i64_slot_count(funcs: Vector<PreparedFunc>) Int {
  n := 0

  for pf in funcs {
    for sid in pf.slots.keys() {
      case pf.slots[sid] {
        .Some(info) => if is_pvec_i64(info) {
          n = n + 1
        },
        .None => {},
      }
    }
  }

  n
}

// Count the (TypeId, FieldId) keys the analysis decided are typed (true).
fn typed_count(d: Dict<String, Bool>) Int {
  n := 0

  for k in d.keys() {
    case d[k] {
      .Some(v) => if v {
        n = n + 1
      },
      .None => {},
    }
  }

  n
}

// Source fixtures (escaped newlines — Twinkle string literals don't span lines).
positive_source :=
  \\type Box = .{ xs: Vector<Int> }
  \\fn make(n: Int) Int {
  \\  ys := collect i in range(n) { i * 2 }
  \\  b := Box.{ xs: ys }
  \\  zs := b.xs
  \\  zs[0] + zs.len()
  \\}
  \\make(5)
  \\

// B5 regression: a typed field read copied through an extra local before use.
// `zs := b.xs` (field read) then `ws := zs` (plain copy) — the field-read result
// is physically PVecI64, so every copy in the alias group must retype too or the
// copy store is an un-coerced PVecI64 -> PVec mismatch (invalid wasm). Field-read
// routing was single-slot before the group-aware fix, leaving copies boxed.
field_read_copy_source :=
  \\type Box = .{ xs: Vector<Int> }
  \\fn make(n: Int) Int {
  \\  ys := collect i in range(n) { i * 2 }
  \\  b := Box.{ xs: ys }
  \\  zs := b.xs
  \\  ws := zs
  \\  ws[0] + ws.len()
  \\}
  \\make(5)
  \\

boxed_source :=
  \\type Box = .{ xs: Vector<Int> }
  \\fn wrap(ys: Vector<Int>) Int {
  \\  b := Box.{ xs: ys }
  \\  zs := b.xs
  \\  zs[0] + zs.len()
  \\}
  \\wrap([1, 2, 3])
  \\

bad_consumer_source :=
  \\type Box = .{ xs: Vector<Int> }
  \\fn use_box(n: Int) Vector<Int> {
  \\  ys := collect i in range(n) { i * 2 }
  \\  b := Box.{ xs: ys }
  \\  zs := b.xs
  \\  zs.concat([0])
  \\}
  \\use_box(5)

multi_field_source :=
  \\type Pair = .{ a: Vector<Int>, b: Vector<Int> }
  \\fn dup(n: Int) Int {
  \\  ys := collect i in range(n) { i * 2 }
  \\  p := Pair.{ a: ys, b: ys }
  \\  ra := p.a
  \\  rb := p.b
  \\  ra[0] + ra.len() + rb[0] + rb.len()
  \\}
  \\dup(5)
  \\

// A collect whose result is a variant payload escapes: the payload slot stays a
// boxed PVec, so routing the producer to PVecI64 would create an unboxed store
// the boundary pass never covered (an invalid-wasm slot mismatch). The self-copy
// `Lx = init Lx` that lowering emits before the variant must not break the alias
// chain that makes this escape visible.
variant_payload_source :=
  \\type CD = { IntCol(Vector<Int>), Other(Int) }
  \\fn build(n: Int) CD {
  \\  ys := collect i in range(n) { i * 2 }
  \\  CD.IntCol(ys)
  \\}
  \\build(5)
  \\

// A typed Vector<Int> field set via ARecordUpdate rebinding (`c.data = <typed
// collect>`). The original Col literal also seeds the field with a typed collect,
// and the only field consumer is `c.data[k]` (index read). Both producers are
// typed-routable and no consumer escapes, so the field stays typed and the
// PVecI64-into-PVecI64 copy-through is sound.
record_update_source :=
  \\type Col = .{ data: Vector<Int>, n: Int }
  \\fn build(n: Int) Col {
  \\  c := Col.{ data: collect i in range(n) { i }, n }
  \\  c.data = collect i in range(n) { i * 2 }
  \\  c
  \\}
  \\fn sum(c: Col) Int {
  \\  t := 0
  \\  for k in range(c.n) { t = t + c.data[k] }
  \\  t
  \\}
  \\sum(build(5))
  \\

// A record with two independently-typed Vector<Int> fields: `a` and `b` each get
// their OWN collect producer (distinct vectors), and each is read via index.
// Contrast multi_field_src, which stores the SAME vector into both fields (and so
// demotes both). Two distinct typed producers => both fields typed.
two_typed_fields_source :=
  \\type Pair = .{ a: Vector<Int>, b: Vector<Int>, n: Int }
  \\fn mk(n: Int) Pair {
  \\  Pair.{ a: collect i in range(n) { i }, b: collect i in range(n) { i * 3 }, n }
  \\}
  \\fn use_pair(p: Pair) Int {
  \\  t := 0
  \\  for k in range(p.n) { t = t + p.a[k] + p.b[k] }
  \\  t
  \\}
  \\use_pair(mk(5))
  \\

// A field fed by a typed-return call result must retype the call-result slot to
// the same physical field family. Otherwise the field analysis can decide the
// field is PVecBool while routing stores the boxed PVec call slot into it.
bool_call_result_field_source :=
  \\type BoolCol = .{ mask: Vector<Bool> }
  \\fn no_nulls(n: Int) Vector<Bool> { Vector.make(n, false) }
  \\fn mk(n: Int) BoolCol { BoolCol.{ mask: no_nulls(n) } }
  \\fn read(c: BoolCol, n: Int) Int {
  \\  s := 0
  \\  for i in range(n) { if c.mask[i] { s = s + 1 } }
  \\  s
  \\}
  \\read(mk(8), 8)
  \\

// A typed field read can feed a typed gather result, which can then be stored
// back into the same typed field. This is the dataframe `Column.nulls` shape:
// `Column.{ nulls: c.nulls.gather(idx) }`.
bool_field_gather_result_source :=
  \\type BoolCol = .{ mask: Vector<Bool> }
  \\fn no_nulls(n: Int) Vector<Bool> { Vector.make(n, false) }
  \\fn mk(n: Int) BoolCol { BoolCol.{ mask: no_nulls(n) } }
  \\fn gather_col(c: BoolCol, idx: Vector<Int>) BoolCol {
  \\  BoolCol.{ mask: c.mask.gather(idx) }
  \\}
  \\fn read(c: BoolCol, n: Int) Int {
  \\  s := 0
  \\  for i in range(n) { if c.mask[i] { s = s + 1 } }
  \\  s
  \\}
  \\idx := collect i in range(8) { i }
  \\read(gather_col(mk(8), idx), 8)
  \\

// A hand-built prepared func: a PVecI64 producer slot (ys) copied straight into a
// destination slot (ws) via AInit — a non-coercing local-copy edge the emitter
// inserts no conversion for. `typed_dest` picks the destination physical repr:
//   false → boxed rt_types__PVec (a real defect: Task 8's edge check must reject),
//   true  → matching PVecI64 (sound: the invariant holds and the edge accepts).
// Both slots keep the wasm_type == f(repr, mono) invariant so the failure surfaces
// at the edge check, not the slot-metadata check.
fn copy_func(env: ResolvedEnv, typed_dest: Bool) PreparedFunc {
  ys := SlotInfo.{
    slot: SlotId.{ id: 0 },
    source_local: LocalId.{ id: 0 },
    role: .Param,
    mono: .Vector(.Int),
    repr: .TypedVec(.I64),
    wasm_type: pvec_wasm_type(.I64),
  }
  ws := if typed_dest {
    SlotInfo.{
      slot: SlotId.{ id: 1 },
      source_local: LocalId.{ id: 1 },
      role: .Local,
      mono: .Vector(.Int),
      repr: .TypedVec(.I64),
      wasm_type: pvec_wasm_type(.I64),
    }
  } else {
    SlotInfo.{
      slot: SlotId.{ id: 1 },
      source_local: LocalId.{ id: 1 },
      role: .Local,
      mono: .Vector(.Int),
      repr: .TypedRef(.Vector(.Int)),
      wasm_type: val_type_of_mono(.Vector(.Int), env),
    }
  }
  slots: Dict<Int, SlotInfo> = Dict.new()
  slots[0] = ys
  slots[1] = ws
  PreparedFunc.{
    func_id: FuncId.{ id: 900 },
    name: "copy_probe",
    is_init: false,
    captures: [],
    params: [SlotId.{ id: 0 }],
    locals: [SlotId.{ id: 1 }],
    slots,
    body: .Let(SlotId.{ id: 1 }, .AInit(.ASlot(SlotId.{ id: 0 })), .Return(.None)),
    return_mono: .Void,
    phys_return: .None,
  }
}

// Swap a hand-built func into a compiled scaffold module so verify runs on it with
// real env/builtins and the module's default sub-records.
fn verify_copy_probe(typed_dest: Bool) Result<Void, String> {
  vi := try verify_inputs(positive_source)
  m := vi.prepared
  m.funcs = [copy_func(vi.env, typed_dest)]
  m.closure_captures = Dict.new()
  m.typed_vector_fields = Dict.new()

  case verify_prepared_module_with_level(m, backend_context(vi.env, m), vi.builtins, .Full) {
    .Ok(_) => if typed_dest {
      .Ok({})
    } else {
      .Err("expected verify to reject the boxed-copy mismatch")
    },
    .Err(msg) => if typed_dest {
      .Err("expected verify to accept the matching typed copy, got: ${msg}")
    } else if msg.contains("physical vector repr mismatch") {
      .Ok({})
    } else {
      .Err("wrong rejection message: ${msg}")
    },
  }
}

pub fn suite() runner.Suite {
  runner
    .suite("typed record fields")
    .test(
      "positive: collect into field, read via index, is typed",
      fn() {
        d := try analyze_src(positive_source)
        try assert.equal(typed_count(d), 1)
        .Ok({})
      },
    )
    .test(
      "boxed producer: field fed by a parameter stays boxed",
      fn() {
        d := try analyze_src(boxed_source)
        try assert.equal(typed_count(d), 0)
        .Ok({})
      },
    )
    .test(
      "bad consumer: field read that escapes stays boxed",
      fn() {
        d := try analyze_src(bad_consumer_source)
        try assert.equal(typed_count(d), 0)
        .Ok({})
      },
    )
    .test(
      "multi-field producer: one vector into two fields demotes both",
      fn() {
        d := try analyze_src(multi_field_source)
        try assert.equal(typed_count(d), 0)
        .Ok({})
      },
    )
    .test(
      "positive case decides exactly one true key, no spurious entries",
      fn() {
        d := try analyze_src(positive_source)
        only_true := true

        for k in d.keys() {
          case d[k] {
            .Some(v) => if !v {
              only_true = false
            },
            .None => {},
          }
        }

        try assert.ok(only_true, "all decided keys should be true")
        try assert.equal(typed_count(d), 1)
        .Ok({})
      },
    )
    .test(
      "routing with the typed-field set retypes producer + field-read slots to PVecI64",
      fn() {
        p := try prepare_src(positive_source)
        tf := analyze_typed_fields(p.funcs, p.builtins, Dict.new())

        // Sanity: the analysis flagged the column field as typed.
        try assert.equal(typed_count(tf), 1)

        // Empty set: stores into the field escape and no field reads are typed,
        // so nothing retypes — proves the empty-set path preserves old behavior.
        empty: Dict<String, Bool> = Dict.new()
        routed_empty := route_typed_vectors(
          p.funcs,
          p.builtins,
          phys_plan.empty(),
          empty,
          Dict.new(),
        ).funcs
        try assert.equal(pvec_i64_slot_count(routed_empty), 0)

        // Real set: the producer (collect/builder_freeze result) AND the
        // field-read (b.xs) result slot retype to PVecI64. Both the freeze result
        // and its plain-copy aliases plus the read result get retyped, so expect
        // at least two typed slots and strictly more than the empty-set run.
        routed := route_typed_vectors(p.funcs, p.builtins, phys_plan.empty(), tf, Dict.new()).funcs
        n := pvec_i64_slot_count(routed)
        try assert.ok(n >= 2, "expected producer + field-read slots typed")
        try assert.ok(
          n > pvec_i64_slot_count(routed_empty),
          "non-empty set must type strictly more slots",
        )
        .Ok({})
      },
    )
    .test(
      "routing the boxed-producer source with a set never retypes (field stays boxed)",
      fn() {
        // The boxed source has no typed-routable producer, so analyze yields an
        // empty set and routing must leave everything boxed regardless.
        p := try prepare_src(boxed_source)
        tf := analyze_typed_fields(p.funcs, p.builtins, Dict.new())
        try assert.equal(typed_count(tf), 0)

        routed := route_typed_vectors(p.funcs, p.builtins, phys_plan.empty(), tf, Dict.new()).funcs
        try assert.equal(pvec_i64_slot_count(routed), 0)
        .Ok({})
      },
    )
    .test(
      "variant payload producer never retypes (would be an unboxed store)",
      fn() {
        // A collect feeding a variant payload escapes; routing must leave the
        // producer boxed. Routing it to PVecI64 once produced invalid wasm (a
        // PVecI64 stored straight into the PVec payload slot). Pass the analyzed
        // field set (empty here) just like the live pipeline does.
        p := try prepare_src(variant_payload_source)
        tf := analyze_typed_fields(p.funcs, p.builtins, Dict.new())
        routed := route_typed_vectors(p.funcs, p.builtins, phys_plan.empty(), tf, Dict.new()).funcs
        try assert.equal(pvec_i64_slot_count(routed), 0)
        .Ok({})
      },
    )
    .test(
      "ARecordUpdate setting a typed field with a typed value stays typed (copy-through)",
      fn() {
        // `c.data = collect ...` rebinds the typed field via ARecordUpdate. Both
        // the original literal and the update value are typed-routable collects and
        // the only consumer is an index read, so the field is decided typed and
        // routing yields PVecI64 slots — the PVecI64-into-PVecI64 copy is sound.
        d := try analyze_src(record_update_source)
        try assert.equal(typed_count(d), 1)

        p := try prepare_src(record_update_source)
        tf := analyze_typed_fields(p.funcs, p.builtins, Dict.new())
        try assert.equal(typed_count(tf), 1)
        routed := route_typed_vectors(p.funcs, p.builtins, phys_plan.empty(), tf, Dict.new()).funcs
        try assert.ok(
          pvec_i64_slot_count(routed) > 0,
          "expected PVecI64 slots for the updated field",
        )
        .Ok({})
      },
    )
    .test(
      "two independently-typed Vector<Int> fields are both typed",
      fn() {
        // Each field has its OWN collect producer (distinct vectors), unlike
        // multi_field_src which stores one vector into both. Both fields typed.
        d := try analyze_src(two_typed_fields_source)
        try assert.equal(typed_count(d), 2)
        .Ok({})
      },
    )
    .test(
      "typed-return call result stored into a typed Bool field verifies",
      fn() {
        vi := try verify_inputs(bool_call_result_field_source)
        try assert.equal(typed_count(vi.prepared.typed_vector_fields), 1)

        case verify_prepared_module_with_level(
          vi.prepared,
          backend_context(vi.env, vi.prepared),
          vi.builtins,
          .Full,
        ) {
          .Ok(_) => .Ok({}),
          .Err(msg) => .Err("typed-return Bool field store must verify, got: ${msg}"),
        }
      },
    )
    .test(
      "typed field gather result stored back into the Bool field verifies",
      fn() {
        vi := try verify_inputs(bool_field_gather_result_source)
        try assert.equal(typed_count(vi.prepared.typed_vector_fields), 1)

        case verify_prepared_module_with_level(
          vi.prepared,
          backend_context(vi.env, vi.prepared),
          vi.builtins,
          .Full,
        ) {
          .Ok(_) => .Ok({}),
          .Err(msg) => .Err("typed field gather result must verify, got: ${msg}"),
        }
      },
    )
    .test(
      "verify accepts PVecI64 producer into a typed field under the matching env",
      fn() {
        vi := try verify_inputs(positive_source)

        // The backend context mirrors the live pipeline: prepared facts carry the
        // routed module's decisions, so layout yields PVecI64 for the typed field
        // and the routed producer slot (also PVecI64) matches.
        case verify_prepared_module_with_level(
          vi.prepared,
          backend_context(vi.env, vi.prepared),
          vi.builtins,
          .Full,
        ) {
          .Ok(_) => .Ok({}),
          .Err(msg) => .Err("expected verify to accept matching env, got: ${msg}"),
        }
      },
    )
    .test(
      "field-read copy group verifies under the strict local-store check (B5 regression)",
      fn() {
        // Before the group-aware field-read fix, `zs := b.xs; ws := zs` left the
        // copy slots boxed while the struct.get result was PVecI64, so the copy
        // store was an un-coerced PVecI64 -> PVec mismatch (invalid wasm, caught
        // only by V8). Routing must now type the whole alias group, and the strict
        // non-coercing local-store check in the verifier must accept the result.
        vi := try verify_inputs(field_read_copy_source)
        case verify_prepared_module_with_level(
          vi.prepared,
          backend_context(vi.env, vi.prepared),
          vi.builtins,
          .Full,
        ) {
          .Ok(_) => .Ok({}),
          .Err(msg) => .Err("B5 field-read copy must verify, got: ${msg}"),
        }
      },
    )
    .test(
      "verify rejects a PVecI64 producer stored into a boxed-PVec field slot",
      fn() {
        vi := try verify_inputs(positive_source)

        // Sanity: the routed module actually typed the field, so its producer
        // slot is PVecI64. Without that the mismatch below would be vacuous.
        try assert.ok(typed_count(vi.prepared.typed_vector_fields) >= 1, "expected a typed field")

        // Drop the prepared typed_vector_fields: layout now reports the field as
        // a boxed PVec, but the routed producer atom is still PVecI64 — exactly
        // the representation mismatch an over-eager routing pass would emit. The
        // field-store check must reject it (the generic Ref->Ref coercibility
        // rule would otherwise let it through, which is how the original routing
        // bug reached V8 instead of being caught here).
        prepared_boxed := vi.prepared
        prepared_boxed.typed_vector_fields = Dict.new()

        case verify_prepared_module_with_level(
          prepared_boxed,
          backend_context(vi.env, prepared_boxed),
          vi.builtins,
          .Full,
        ) {
          .Ok(_) => .Err("expected verify to reject PVecI64-into-boxed-field mismatch"),
          .Err(_) => .Ok({}),
        }
      },
    )
    .test(
      "verify rejects a PVecI64 producer copied into a boxed slot (physical repr edge)",
      fn() { verify_copy_probe(false) },
    )
    .test(
      "verify accepts a PVecI64 producer copied into a matching typed slot (invariant holds)",
      fn() { verify_copy_probe(true) },
    )
}
