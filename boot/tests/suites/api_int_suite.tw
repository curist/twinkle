use @std.testing.assert as assert
use @std.testing as runner

pub fn suite() runner.Suite {
  runner
    .suite("api Int")
    .test(
      "min returns the smaller argument",
      fn() {
        try assert.equal(3.min(7), 3)
        try assert.equal(7.min(3), 3)
        try assert.equal(Int.min(-2, 5), -2)
        try assert.equal(4.min(4), 4)
        .Ok({})
      },
    )
    .test(
      "max returns the larger argument",
      fn() {
        try assert.equal(3.max(7), 7)
        try assert.equal(7.max(3), 7)
        try assert.equal(Int.max(-2, 5), 5)
        try assert.equal(4.max(4), 4)
        .Ok({})
      },
    )
    .test(
      "clamp pins a value into [lo, hi]",
      fn() {
        try assert.equal(5.clamp(0, 10), 5)
        try assert.equal((-3).clamp(0, 10), 0)
        try assert.equal(42.clamp(0, 10), 10)
        try assert.equal(0.clamp(0, 10), 0)
        try assert.equal(10.clamp(0, 10), 10)
        .Ok({})
      },
    )
    .test(
      "inc adds one",
      fn() {
        try assert.equal(0.inc(), 1)
        try assert.equal((-2).inc(), -1)
        increment := Int.inc
        try assert.equal(increment(41), 42)
        .Ok({})
      },
    )
    .test(
      "dec subtracts one",
      fn() {
        try assert.equal(0.dec(), -1)
        try assert.equal((-2).dec(), -3)
        decrement := Int.dec
        try assert.equal(decrement(43), 42)
        .Ok({})
      },
    )
    .test(
      "abs returns magnitude",
      fn() {
        try assert.equal((-7).abs(), 7)
        try assert.equal(7.abs(), 7)
        try assert.equal(0.abs(), 0)
        magnitude := Int.abs
        try assert.equal(magnitude(-3), 3)
        .Ok({})
      },
    )
    .test(
      "is_even and is_odd classify parity",
      fn() {
        try assert.equal(4.is_even(), true)
        try assert.equal(3.is_even(), false)
        try assert.equal((-4).is_even(), true)
        try assert.equal(3.is_odd(), true)
        try assert.equal((-3).is_odd(), true)
        try assert.equal(4.is_odd(), false)
        .Ok({})
      },
    )
    .test(
      "is_zero, is_positive, and is_negative classify sign",
      fn() {
        try assert.equal(0.is_zero(), true)
        try assert.equal(1.is_zero(), false)
        try assert.equal(1.is_positive(), true)
        try assert.equal(0.is_positive(), false)
        try assert.equal((-1).is_positive(), false)
        try assert.equal((-1).is_negative(), true)
        try assert.equal(0.is_negative(), false)
        .Ok({})
      },
    )
    .test(
      "sign reports direction",
      fn() {
        try assert.equal((-3).sign(), -1)
        try assert.equal(0.sign(), 0)
        try assert.equal(9.sign(), 1)
        .Ok({})
      },
    )
    .test(
      "gcd and lcm",
      fn() {
        try assert.equal(48.gcd(36), 12)
        try assert.equal((-48).gcd(36), 12)
        try assert.equal(0.gcd(0), 0)
        try assert.equal(13.gcd(0), 13)
        try assert.equal(4.lcm(6), 12)
        try assert.equal(0.lcm(5), 0)
        .Ok({})
      },
    )
    .test(
      "pow by squaring",
      fn() {
        try assert.equal(2.pow(10), 1024)
        try assert.equal(3.pow(0), 1)
        try assert.equal(0.pow(0), 1)
        try assert.equal(5.pow(3), 125)
        .Ok({})
      },
    )
    .test(
      "isqrt floors the integer root",
      fn() {
        try assert.equal(0.isqrt(), 0)
        try assert.equal(1.isqrt(), 1)
        try assert.equal(99.isqrt(), 9)
        try assert.equal(100.isqrt(), 10)
        try assert.equal(101.isqrt(), 10)
        .Ok({})
      },
    )
}
