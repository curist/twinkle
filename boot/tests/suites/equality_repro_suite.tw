use @std.testing.assert as assert
use @std.testing as runner

type Point = .{ x: Int, y: Int }

// A user sum with a Vector<Int> payload; the storage-site analysis types the
// payload as PVecI64 (built by a clean collect directly into the construction),
// which must still compare by contents (regression: PVecI64 payloads used to
// fall through to reference equality in generated sum/record equality).
type Col = { IntCol(Vector<Int>) }

type Row = .{ c: Col }

fn make_typed_col(n: Int) Col {
  xs := collect i in range(n) {
    i + 1
  }
  .IntCol(xs)
}

pub fn suite() runner.Suite {
  runner
    .suite("equality repros")
    .test(
      "user-sum typed Vector<Int> payload compares by contents",
      fn() {
        a := Row.{ c: make_typed_col(3) }
        b := Row.{ c: make_typed_col(3) }
        c := Row.{ c: make_typed_col(4) }
        try assert.is_true(a == b)
        try assert.is_false(a == c)

        // direct sum equality (not nested in a record) too
        try assert.is_true(make_typed_col(3) == make_typed_col(3))
        try assert.is_false(make_typed_col(3) == make_typed_col(4))
        .Ok({})
      },
    )
    .test(
      "vector structural equality repro",
      fn() {
        a: Vector<Int> = [1, 2, 3]
        b: Vector<Int> = [1, 2, 3]
        c: Vector<Int> = [1, 2, 4]
        try assert.is_true(a == b)
        try assert.is_false(a == c)
        .Ok({})
      },
    )
    .test(
      "dict order-insensitive equality repro",
      fn() {
        a: Dict<String, Int> = Dict.new()
        a["left"] = 1
        a["right"] = 2
        b: Dict<String, Int> = Dict.new()
        b["right"] = 2
        b["left"] = 1
        c: Dict<String, Int> = Dict.new()
        c["left"] = 1
        c["right"] = 3
        try assert.is_true(a == b)
        try assert.is_false(a == c)
        .Ok({})
      },
    )
    .test(
      "typed-sum nested collection repro",
      fn() {
        a: Vector<Option<Vector<Int>>> = [.Some([1, 2]), .None, .Some([3])]
        b: Vector<Option<Vector<Int>>> = [.Some([1, 2]), .None, .Some([3])]
        c: Vector<Option<Vector<Int>>> = [.Some([1, 2]), .None, .Some([4])]
        try assert.is_true(a == b)
        try assert.is_false(a == c)
        .Ok({})
      },
    )
    .test(
      "record structural equality repro",
      fn() {
        same := Point.{ x: 1, y: 2 }
        other := Point.{ x: 1, y: 2 }
        same_opt_a: Option<Point> = .Some(same)
        same_opt_b: Option<Point> = .Some(same)
        other_opt: Option<Point> = .Some(other)
        try assert.is_true([same] == [same])
        try assert.is_true([same] == [other])
        try assert.is_true(same_opt_a == same_opt_b)
        try assert.is_true(same_opt_a == other_opt)
        .Ok({})
      },
    )
}
