use @std.fs
use @std.testing.assert as assert
use @std.testing as runner

use lib.debug.section
use lib.debug.section.{DebugSection, FileEntry, FuncDebug}
use lib.source.report
use runtime_trace_renderer as renderer

// ── Fixture helpers ─────────────────────────────────────────────────
fn b(n: Int) Byte {
  case Byte.from_int(n & 0xff) {
    .Some(x) => x,
    .None => error("runtime_trace_renderer_suite: byte out of range"),
  }
}

fn append_all(dst: Vector<Byte>, src: Vector<Byte>) Vector<Byte> {
  for x in src {
    dst = .append(x)
  }

  dst
}

fn uleb(n: Int) Vector<Byte> {
  out: Vector<Byte> = []
  v := n

  for true {
    low := v & 0x7f
    v = v >> 7

    if v == 0 {
      out = .append(b(low))
      break
    }

    out = .append(b(low | 0x80))
  }

  out
}

// Wrap an encoded debug payload in a minimal wasm module: the 8-byte header
// then a single custom section (id 0) named "twinkle.debug", exactly as the
// codegen emits it — so `decode_module` has to walk the section framing.
fn wrap_module(dbg_bytes: Vector<Byte>) Vector<Byte> {
  name := section.section_name().utf8_bytes()

  content: Vector<Byte> = []
  content = append_all(content, uleb(name.len()))
  content = append_all(content, name)
  content = append_all(content, dbg_bytes)

  out: Vector<Byte> = [b(0x00), b(0x61), b(0x73), b(0x6d), b(0x01), b(0x00), b(0x00), b(0x00)]
  out = .append(b(0x00)) // custom section id
  out = append_all(out, uleb(content.len()))
  out = append_all(out, content)
  out
}

// A stable `/tmp` root (not the session scratchpad) so the fixture works on
// any machine/session, matching lsp_definition_suite.tw's precedent. The
// debug section stores the project-relative path `rel_path`; the renderer
// safe-joins it under `root` to read the on-disk fixture.
root: String = "/tmp/twk_m2_rttrace_suite_root"

rel_path: String = "src/main.tw"

// A relative path never written under `root`, for the source-unavailable case
// (no filesystem delete API exists in `@std.fs` to remove a written fixture).
missing_rel_path: String = "src/no_such_file.tw"

// Write the fixture source `root/rel_path` points at and return the relative
// path stored in the debug section.
fn write_main_tw() String {
  case fs.mkdirp("${root}/src") {
    .Ok(_) => {},
    .Err(_) => error("runtime_trace_renderer_suite: failed to create fixture root"),
  }

  case fs.write_text("${root}/${rel_path}", "a := 1\nb := a + 2\n") {
    .Ok(_) => rel_path,
    .Err(_) => error("runtime_trace_renderer_suite: failed to write fixture"),
  }
}

// A one-file, one-function section: body_start 100 (0x64), body-rel 10 (PC
// 0x6e) is `b := a + 2` on line 2. `path` selects between the real on-disk
// fixture's relative path and a known-missing relative path so the same shape
// drives both the snippet-present and source-unavailable cases.
fn sample_at(path: String) DebugSection {
  files: Vector<FileEntry> = [.{ file_id: 0, path }]
  funcs: Vector<FuncDebug> = [
    .{
      func_idx: 6,
      body_start: 100,
      lines: [
        .{
          offset: 0,
          span: .{ file_id: 0, start: 0, end: 6 },
          start_line: 1,
          start_col: 1,
          end_line: 1,
          end_col: 7,
        },
        .{
          offset: 8,
          span: .{ file_id: 0, start: 7, end: 17 },
          start_line: 2,
          start_col: 1,
          end_line: 2,
          end_col: 11,
        },
      ],
    },
  ]
  .{ files, funcs }
}

fn sample() DebugSection {
  sample_at(write_main_tw())
}

fn module_bytes() Vector<Byte> {
  wrap_module(sample().encode())
}

fn missing_module_bytes() Vector<Byte> {
  wrap_module(sample_at(missing_rel_path).encode())
}

// A Deno-shaped stack: a leading host frame (the `error` shim), the two child
// Wasm frames, then a trailing host frame — the exact skip/keep/stop shape the
// parser handles.
fn deno_stack() String {
  lines: Vector<String> = [
    "Error: boom",
    "    at Object.error (file:///host.js:10:5)",
    "    at user__deeper (wasm://wasm/abcd:wasm-function[0]:0x6e)",
    "    at user__main (wasm://wasm/abcd:wasm-function[0]:0x64)",
    "    at run (file:///host.js:20:3)",
  ]
  lines.join("\n")
}

// Remove ANSI SGR escape sequences (`\e[...m`) so content assertions hold
// whether or not color is enabled. Fixtures are ASCII, so per-byte reassembly
// is exact. Assumes m-terminated SGR sequences (the only escapes render.tw
// emits); a non-SGR escape would swallow the rest of the string.
fn strip_ansi(s: String) String {
  out := ""
  in_escape := false

  for ch in s {
    c := ch.to_int()

    if in_escape {
      if c == 109 {
        in_escape = false
      }
    } else if c == 27 {
      in_escape = true
    } else {
      case String.from_char_code(c) {
        .Some(x) => out = .concat(x),
        .None => {},
      }
    }
  }

  out
}

// ── Tests ───────────────────────────────────────────────────────────
pub fn suite() runner.Suite {
  runner
    .suite("runtime trace renderer")
    .test(
      "renders a source-mapped trace from full module bytes and a captured stack",
      fn() {
        out := renderer.render_runtime_trace(module_bytes(), deno_stack(), "boom", root)
        stripped := strip_ansi(out)
        try assert.str_contains(stripped, "error: boom")
        try assert.str_contains(stripped, "--> ${rel_path}:2:1")
        try assert.str_contains(stripped, "b := a + 2")
        try assert.str_contains(stripped, "^^^^^^^^^^")

        // Both child frames appear in the backtrace, innermost first.
        try assert.str_contains(stripped, "at user__deeper (${rel_path}:2:1)")
        try assert.str_contains(stripped, "at user__main (${rel_path}:1:1)")
        deeper_at := try stripped.index_of("user__deeper").ok_or("deeper missing")
        main_at := try stripped.index_of("user__main").ok_or("main missing")
        try assert.is_true(deeper_at < main_at)
        .Ok({})
      },
    )
    .test(
      "degrades to location-only with a source-unavailable note when the file is not on disk",
      fn() {
        // Same span/line-col shape as `sample()`, but the file table points at
        // a relative path never written under `root` — the backtrace must
        // still resolve file:line:col from the embedded line/col (no disk
        // read needed for locations), while the snippet block is dropped.
        out := renderer.render_runtime_trace(missing_module_bytes(), deno_stack(), "boom", root)
        stripped := strip_ansi(out)
        try assert.str_contains(stripped, "error: boom")
        try assert.is_false(stripped.contains("-->"))
        try assert.is_false(stripped.contains("b := a + 2"))
        try assert.str_contains(stripped, "at user__deeper (${missing_rel_path}:2:1)")
        try assert.str_contains(stripped, "at user__main (${missing_rel_path}:1:1)")
        try assert.str_contains(stripped, "source unavailable")
        .Ok({})
      },
    )
    .test(
      "degrades to location-only when source_root is empty even though the file exists on disk",
      fn() {
        // Proves the empty-root case never disk-reads, even for a path that
        // does exist under `root`.
        out := renderer.render_runtime_trace(module_bytes(), deno_stack(), "boom", "")
        stripped := strip_ansi(out)
        try assert.str_contains(stripped, "error: boom")
        try assert.is_false(stripped.contains("-->"))
        try assert.str_contains(stripped, "at user__deeper (${rel_path}:2:1)")
        try assert.str_contains(stripped, "source unavailable")
        .Ok({})
      },
    )
    .test(
      "extracts the debug section past other content in the module",
      fn() {
        // decode_module must find the section by name, not by position; a
        // round-trip through wrap_module proves the framing walk.
        sec := try section.decode_module(module_bytes()).ok_or("expected a section")
        try assert.equal(sec.files.len(), 1)
        try assert.equal(sec.funcs.len(), 1)
        try assert.equal(sec.funcs[0].body_start, 100)
        .Ok({})
      },
    )
    .test(
      "falls back to a note when the module carries no debug section",
      fn() {
        // Bytes that are not a wasm module at all.
        garbage: Vector<Byte> = [b(1), b(2), b(3)]
        out := renderer.render_runtime_trace(garbage, deno_stack(), "boom", root)
        stripped := strip_ansi(out)
        try assert.str_contains(stripped, "error: boom")
        try assert.str_contains(stripped, "no Twinkle stack trace available")
        .Ok({})
      },
    )
    .test(
      "falls back to a note when the stack carries no Twinkle frames",
      fn() {
        host_only := "Error: boom\n    at run (file:///host.js:20:3)"
        out := renderer.render_runtime_trace(module_bytes(), host_only, "boom", root)
        stripped := strip_ansi(out)
        try assert.str_contains(stripped, "error: boom")
        try assert.str_contains(stripped, "no Twinkle stack trace available")
        .Ok({})
      },
    )
    .test(
      "colors output per default_config (NO_COLOR parity)",
      fn() {
        out := renderer.render_runtime_trace(module_bytes(), deno_stack(), "boom", root)

        if report.default_config().color {
          try assert.is_true(out.contains("\e["))
        } else {
          try assert.is_false(out.contains("\e["))
        }
        .Ok({})
      },
    )
}
