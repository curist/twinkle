use @std.testing.assert as assert
use @std.testing as runner

use compiler.anf.{AnfExpr, AnfFunctionDef, AnfModule, AnfOp, Atom}
use compiler.artifacts.{PipelineArtifacts}
use compiler.builder_region_detect as detect
use compiler.builder_region_fact as region_fact
use compiler.codegen.builder_region
use compiler.codegen.builder_region_produce
use compiler.codegen.codegen.{link_program}
use compiler.core_ir.{FuncId, LocalId}
use compiler.mono_type.{MonoType}
use compiler.pipeline

fn candidates_for(src: String) Vector<detect.RegionCandidate> {
  case pipeline.compile_source(src) {
    .Ok(a) => detect.detect_candidates(a.opt, a.builtins),
    .Err(e) => error("compile failed: ${e}"),
  }
}

fn links_ok(src: String) Bool {
  case pipeline.compile_source(src) {
    .Ok(a) => {
      link_program(a.opt, a.env, a.builtins)
      true
    },
    .Err(e) => error("compile failed: ${e}"),
  }
}

fn verdicts_for(src: String) Vector<region_fact.RegionVerdict> {
  case pipeline.compile_source(src) {
    .Ok(a) => region_fact.region_verdicts(a.opt, a.builtins),
    .Err(e) => error("compile failed: ${e}"),
  }
}

fn compile_or_fail(src: String) PipelineArtifacts {
  case pipeline.compile_source(src) {
    .Ok(a) => a,
    .Err(e) => error(e),
  }
}

fn decisions_for(src: String) builder_region_produce.BuilderRegionDecisionTable {
  a := compile_or_fail(src)
  builder_region_produce.produce_builder_region_decisions(a.opt, a.builtins)
}

fn total_decisions(t: builder_region_produce.BuilderRegionDecisionTable) Int {
  n := 0
  for _, v in t.by_func {
    n = n + v.len()
  }
  n
}

// Hand-built ANF for the FU-1 gate. Source-level `nxt := acc.concat(c); acc =
// nxt; println(nxt)` does not reach FU-1 (the optimizer copy-propagates `nxt`
// back to `acc`, so the detector rejects it as an interior read before
// certification — clean_count is 0). To drive `fold_results_dead` to reject due
// to a LIVE fold result (not non-certification), we synthesize a function whose
// fold-result temp (local 1) is consume-reassigned into the accumulator (local
// 0) and, when `extra_read` is set, ALSO read by a trailing call.
fn fu1_function(extra_read: Bool) AnfFunctionDef {
  acc := LocalId.{ id: 0 }
  r := LocalId.{ id: 1 }
  tail: AnfExpr = if extra_read {
    AnfExpr.Let(
      LocalId.{ id: 3 },
      AnfOp.ACall(Atom.AGlobalFunc(FuncId.{ id: 99 }), [Atom.ALocal(r)]),
      AnfExpr.Atom(Atom.ALitVoid),
    )
  } else {
    AnfExpr.Atom(Atom.ALitVoid)
  }
  body := AnfExpr.Let(
    r,
    AnfOp.AInit(Atom.ALitInt(1)),
    AnfExpr.Let(LocalId.{ id: 2 }, AnfOp.AAssign(acc, Atom.ALocal(r)), tail),
  )
  AnfFunctionDef.{
    func_id: FuncId.{ id: 7 },
    name: "m",
    is_init: false,
    params: [],
    op_result_mono: Dict.new(),
    body,
    return_ty: MonoType.Void,
  }
}

fn fu1_candidate() detect.RegionCandidate {
  detect.RegionCandidate.{
    func_id: FuncId.{ id: 7 },
    func: "m",
    family: "string",
    push_id: FuncId.{ id: 0 },
    accumulator: LocalId.{ id: 0 },
    seed_site: LocalId.{ id: 0 },
    loop_site: LocalId.{ id: 0 },
    fold_sites: [LocalId.{ id: 1 }],
    structural_ok: true,
    reason: "",
  }
}

// Hand-built certified candidate for the overlap/lowest-key resolution tests.
// Overlap keys on shared accumulator / loop_site / fold_site; the total order
// keys on seed_site (after func_id), so varying seed_site sets the key rank.
fn mk_candidate(seed: Int, loop_id: Int, fold: Int, acc: Int) detect.RegionCandidate {
  detect.RegionCandidate.{
    func_id: FuncId.{ id: 7 },
    func: "m",
    family: "string",
    push_id: FuncId.{ id: 0 },
    accumulator: LocalId.{ id: acc },
    seed_site: LocalId.{ id: seed },
    loop_site: LocalId.{ id: loop_id },
    fold_sites: [LocalId.{ id: fold }],
    structural_ok: true,
    reason: "",
  }
}

fn find_func(anf: AnfModule, name: String) AnfFunctionDef {
  for f in anf.functions {
    if f.name == name {
      return f
    }
  }
  error("function not found: ${name}")
}

fn count_calls_to(expr: AnfExpr, target: FuncId) Int {
  case expr {
    .Let(_, op, body) => count_calls_op(op, target) + count_calls_to(body, target),
    _ => 0,
  }
}

fn count_calls_op(op: AnfOp, target: FuncId) Int {
  case op {
    .ACall(.AGlobalFunc(f), _) => if f.id == target.id {
      1
    } else {
      0
    },
    .AIf(_, t, e) => count_calls_to(t, target) + count_calls_to(e, target),
    .AMatch(_, arms) => {
      n := 0
      for arm in arms {
        n = n + count_calls_to(arm.body, target)
      }
      n
    },
    .ALoop(b) => count_calls_to(b, target),
    .ADefer(b) => count_calls_to(b, target),
    _ => 0,
  }
}

fn certified_count(src: String) Int {
  n := 0
  for v in verdicts_for(src) {
    if v.linearly_folded {
      n = n + 1
    }
  }
  n
}

// count only structurally-clean candidates
fn clean_count(src: String) Int {
  n := 0
  for c in candidates_for(src) {
    if c.structural_ok {
      n = n + 1
    }
  }
  n
}

pub fn suite() runner.Suite {
  runner
    .suite("builder_region")
    .test(
      "clean string fold is detected",
      fn() Result<Void, String> { assert.equal(
        clean_count(
          "fn m() Void {\n  acc := \"\"\n  for c in [\"a\", \"b\"] { acc = acc.concat(c) }\n  println(acc)\n}\nm()\n",
        ),
        1,
      ) },
    )
    .test(
      "clean vector fold is detected",
      fn() Result<Void, String> { assert.equal(
        clean_count(
          "fn m() Void {\n  acc: Vector<Int> = []\n  for x in [1, 2] { acc = acc.append(x) }\n  println(acc.len().to_string())\n}\nm()\n",
        ),
        1,
      ) },
    )
    .test(
      "interior read rejects",
      fn() Result<Void, String> { assert.equal(
        clean_count(
          "fn m() Void {\n  acc := \"\"\n  for c in [\"a\"] { acc = acc.concat(c)\n  println(acc) }\n  println(acc)\n}\nm()\n",
        ),
        0,
      ) },
    )
    .test(
      "conditional fold rejects (deferred to plan 5)",
      fn() Result<Void, String> { assert.equal(
        clean_count(
          "fn m() Void {\n  acc := \"\"\n  for c in [\"a\"] { if c == \"a\" { acc = acc.concat(c) } }\n  println(acc)\n}\nm()\n",
        ),
        0,
      ) },
    )
    .test(
      "early return of accumulator rejects",
      fn() Result<Void, String> { assert.equal(
        clean_count(
          "fn m() String {\n  acc := \"\"\n  for c in [\"a\"] { acc = acc.concat(c)\n  return acc }\n  acc\n}\nprintln(m())\n",
        ),
        0,
      ) },
    )
    .test(
      "self concat rejects and renders as a near-miss",
      fn() Result<Void, String> {
        src := "fn m() Void {\n  acc := \"\"\n  for c in [\"a\"] { acc = acc.concat(acc) }\n  println(acc)\n}\nm()\n"
        try assert.equal(clean_count(src), 0)
        cands := candidates_for(src)
        try assert.equal(cands.len(), 1)
        try assert.is_false(cands[0].structural_ok)
        try assert.str_contains(cands[0].reason, "self-concat")
        .Ok({})
      },
    )
    .test(
      "continue-guarded fold rejects (deferred to plan 5)",
      fn() Result<Void, String> { assert.equal(
        clean_count(
          "fn m() Void {\n  acc := \"\"\n  for c in [\"a\", \"b\"] { if c == \"b\" { continue }\n  acc = acc.concat(c) }\n  println(acc)\n}\nm()\n",
        ),
        0,
      ) },
    )
    .test(
      "Cell publication of accumulator rejects",
      fn() Result<Void, String> { assert.equal(
        clean_count(
          "fn m() Void {\n  cell := Cell.new(\"\")\n  acc := \"\"\n  for c in [\"a\"] { acc = acc.concat(c)\n  cell.set(acc) }\n  println(cell.get())\n}\nm()\n",
        ),
        0,
      ) },
    )
    .test(
      "chunk aliasing the accumulator rejects",
      fn() Result<Void, String> { assert.equal(
        clean_count(
          "fn m() Void {\n  acc := \"\"\n  for c in [\"a\"] { d := acc\n  acc = acc.concat(d) }\n  println(acc)\n}\nm()\n",
        ),
        0,
      ) },
    )
    .test(
      "nested loop over the accumulator rejects",
      fn() Result<Void, String> { assert.equal(
        clean_count(
          "fn m() Void {\n  acc := \"\"\n  for c in [\"a\"] { for d in [\"x\"] { acc = acc.concat(d) } }\n  println(acc)\n}\nm()\n",
        ),
        0,
      ) },
    )
    .test(
      "closure capture of accumulator rejects",
      fn() Result<Void, String> { assert.equal(
        clean_count(
          "fn m() Void {\n  acc := \"\"\n  for c in [\"a\"] { acc = acc.concat(c)\n  f := fn() String { acc }\n  println(f()) }\n  println(acc)\n}\nm()\n",
        ),
        0,
      ) },
    )
    .test(
      "call publication of accumulator rejects",
      fn() Result<Void, String> { assert.equal(
        clean_count(
          "fn use_it(s: String) Void { println(s) }\nfn m() Void {\n  acc := \"\"\n  for c in [\"a\"] { acc = acc.concat(c)\n  use_it(acc) }\n  println(acc)\n}\nm()\n",
        ),
        0,
      ) },
    )
    .test(
      "non-empty seed is not detected",
      fn() Result<Void, String> { assert.equal(
        clean_count(
          "fn m() Void {\n  acc := \"x\"\n  for c in [\"a\"] { acc = acc.concat(c) }\n  println(acc)\n}\nm()\n",
        ),
        0,
      ) },
    )
    .test(
      "two independent regions in one function both detected",
      fn() Result<Void, String> { assert.equal(
        clean_count(
          "fn m() Void {\n  a := \"\"\n  for c in [\"x\"] { a = a.concat(c) }\n  b := \"\"\n  for c in [\"y\"] { b = b.concat(c) }\n  println(a)\n  println(b)\n}\nm()\n",
        ),
        2,
      ) },
    )
    .test(
      "clean string fold over a range loop is detected",
      fn() Result<Void, String> { assert.equal(
        clean_count(
          "fn m() Void {\n  acc := \"\"\n  for i in range(3) { acc = acc.concat(\"x\") }\n  println(acc)\n}\nm()\n",
        ),
        1,
      ) },
    )
    .test(
      "clean vector fold over a range loop is detected",
      fn() Result<Void, String> { assert.equal(
        clean_count(
          "fn m() Void {\n  acc: Vector<Int> = []\n  for i in range(3) { acc = acc.append(i) }\n  println(acc.len().to_string())\n}\nm()\n",
        ),
        1,
      ) },
    )
    .test(
      "interior read on a range loop rejects",
      fn() Result<Void, String> { assert.equal(
        clean_count(
          "fn m() Void {\n  acc := \"\"\n  for i in range(3) { acc = acc.concat(\"x\")\n  println(acc) }\n  println(acc)\n}\nm()\n",
        ),
        0,
      ) },
    )
    .test(
      "conditional fold on a range loop rejects",
      fn() Result<Void, String> { assert.equal(
        clean_count(
          "fn m() Void {\n  acc := \"\"\n  for i in range(3) { if i > 0 { acc = acc.concat(\"x\") } }\n  println(acc)\n}\nm()\n",
        ),
        0,
      ) },
    )
    .test(
      "clean string fold certifies",
      fn() Result<Void, String> { assert.equal(
        certified_count(
          "fn m() Void {\n  acc := \"\"\n  for c in [\"a\", \"b\"] { acc = acc.concat(c) }\n  println(acc)\n}\nm()\n",
        ),
        1,
      ) },
    )
    .test(
      "clean vector fold certifies",
      fn() Result<Void, String> { assert.equal(
        certified_count(
          "fn m() Void {\n  acc: Vector<Int> = []\n  for x in [1, 2] { acc = acc.append(x) }\n  println(acc.len().to_string())\n}\nm()\n",
        ),
        1,
      ) },
    )
    .test(
      "conditional fold renders as a rejected candidate",
      fn() Result<Void, String> {
        vs := verdicts_for(
          "fn m() Void {\n  acc := \"\"\n  for c in [\"a\"] { if c == \"a\" { acc = acc.concat(c) } }\n  println(acc)\n}\nm()\n",
        )
        try assert.equal(vs.len(), 1)
        try assert.is_false(vs[0].linearly_folded)
        try assert.str_contains(vs[0].reason, "structural")
        .Ok({})
      },
    )
    .test(
      "re-folded accumulator surfaces as a rejected candidate (FU-2)",
      fn() Result<Void, String> {
        vs := verdicts_for(
          "fn m() Void {\n  acc := \"\"\n  for c in [\"a\"] { acc = acc.concat(c) }\n  println(acc)\n  for c in [\"b\"] { acc = acc.concat(c) }\n  println(acc)\n}\nm()\n",
        )
        try assert.equal(vs.len(), 2)
        certified := 0
        reused := 0
        for v in vs {
          if v.linearly_folded {
            certified = certified + 1
          }
          if v.reason.contains("re-used accumulator") {
            reused = reused + 1
          }
        }
        try assert.equal(certified, 1)
        try assert.equal(reused, 1)
        try assert.is_false(vs[0].key.loop_site == vs[1].key.loop_site)
        .Ok({})
      },
    )
    .test(
      "single clean fold still surfaces exactly one certified candidate (FU-2 no false positive)",
      fn() Result<Void, String> { assert.equal(
        certified_count(
          "fn m() Void {\n  acc := \"\"\n  for c in [\"a\", \"b\"] { acc = acc.concat(c) }\n  println(acc)\n}\nm()\n",
        ),
        1,
      ) },
    )
    .test(
      "string accumulator loop links through the backend",
      fn() Result<Void, String> {
        // Forward-looking smoke/link check: nothing emits string$builder_from
        // yet, so this exercises today's persistent path. It starts guarding
        // the repr_assign string-seed erasure once the loop->builder rewrite
        // lands (a later Plan 2 task).
        assert.is_true(
          links_ok(
            "fn m() Void {\n  acc := \"\"\n  for c in [\"a\", \"b\"] { acc = acc.concat(c) }\n  println(acc)\n}\nm()\n",
          ),
        )
      },
    )
    .test(
      "rewrite emits string builder calls and drops the concat fold",
      fn() Result<Void, String> {
        a := compile_or_fail(
          "fn m() Void {\n  acc := \"\"\n  for c in [\"a\", \"b\"] { acc = acc.concat(c) }\n  println(acc)\n}\nm()\n",
        )
        anf2 := builder_region.rewrite_module(a.opt, a.builtins)
        concat_id := a.builtins.method_id("String", "concat")
        extend_id := a.builtins.id("string$builder_extend")
        from_id := a.builtins.id("string$builder_from")
        freeze_id := a.builtins.id("string$builder_freeze")
        fn_m := find_func(anf2, "m")
        try assert.equal(count_calls_to(fn_m.body, concat_id), 0)
        try assert.equal(count_calls_to(fn_m.body, extend_id), 1)
        try assert.equal(count_calls_to(fn_m.body, from_id), 1)
        try assert.equal(count_calls_to(fn_m.body, freeze_id), 1)
        .Ok({})
      },
    )
    .test(
      "rewrite emits vector builder_new/push/freeze and drops append",
      fn() Result<Void, String> {
        a := compile_or_fail(
          "fn m() Void {\n  acc: Vector<Int> = []\n  for x in [1, 2] { acc = acc.append(x) }\n  println(acc.len().to_string())\n}\nm()\n",
        )
        anf2 := builder_region.rewrite_module(a.opt, a.builtins)
        fn_m := find_func(anf2, "m")
        try assert.equal(count_calls_to(fn_m.body, a.builtins.method_id("Vector", "append")), 0)
        try assert.equal(count_calls_to(fn_m.body, a.builtins.id("vector$builder_new")), 1)
        try assert.equal(count_calls_to(fn_m.body, a.builtins.id("vector$builder_push")), 1)
        try assert.equal(count_calls_to(fn_m.body, a.builtins.id("vector$builder_freeze")), 1)
        .Ok({})
      },
    )
    .test(
      "two independent builder regions in one function both rewrite",
      fn() Result<Void, String> {
        a := compile_or_fail(
          "fn m() Void {\n  x := \"\"\n  for c in [\"a\"] { x = x.concat(c) }\n  println(x)\n  y := \"\"\n  for c in [\"b\"] { y = y.concat(c) }\n  println(y)\n}\nm()\n",
        )
        anf2 := builder_region.rewrite_module(a.opt, a.builtins)
        fn_m := find_func(anf2, "m")
        try assert.equal(count_calls_to(fn_m.body, a.builtins.method_id("String", "concat")), 0)
        try assert.equal(count_calls_to(fn_m.body, a.builtins.id("string$builder_extend")), 2)
        try assert.equal(count_calls_to(fn_m.body, a.builtins.id("string$builder_from")), 2)
        try assert.equal(count_calls_to(fn_m.body, a.builtins.id("string$builder_freeze")), 2)
        .Ok({})
      },
    )
    .test(
      "interior-read loop is left persistent by the rewrite",
      fn() Result<Void, String> {
        a := compile_or_fail(
          "fn m() Void {\n  acc := \"\"\n  for c in [\"a\"] { acc = acc.concat(c)\n  println(acc) }\n  println(acc)\n}\nm()\n",
        )
        anf2 := builder_region.rewrite_module(a.opt, a.builtins)
        fn_m := find_func(anf2, "m")
        try assert.is_true(count_calls_to(fn_m.body, a.builtins.method_id("String", "concat")) >= 1)
        try assert.equal(count_calls_to(fn_m.body, a.builtins.id("string$builder_extend")), 0)
        .Ok({})
      },
    )
    .test(
      "producer emits one decision for a clean string loop",
      fn() Result<Void, String> { assert.equal(
        total_decisions(
          decisions_for(
            "fn m() Void {\n  acc := \"\"\n  for c in [\"a\"] { acc = acc.concat(c) }\n  println(acc)\n}\nm()\n",
          ),
        ),
        1,
      ) },
    )
    .test(
      "producer emits no decision for an interior-read loop",
      fn() Result<Void, String> { assert.equal(
        total_decisions(
          decisions_for(
            "fn m() Void {\n  acc := \"\"\n  for c in [\"a\"] { acc = acc.concat(c)\n  println(acc) }\n  println(acc)\n}\nm()\n",
          ),
        ),
        0,
      ) },
    )
    .test(
      "two independent clean loops in one function both get decisions",
      fn() Result<Void, String> { assert.equal(
        total_decisions(
          decisions_for(
            "fn m() Void {\n  a := \"\"\n  for c in [\"x\"] { a = a.concat(c) }\n  println(a)\n  b := \"\"\n  for c in [\"y\"] { b = b.concat(c) }\n  println(b)\n}\nm()\n",
          ),
        ),
        2,
      ) },
    )
    .test(
      "fold_results_dead rejects a live fold result, accepts a dead one (FU-1)",
      fn() Result<Void, String> {
        cand := fu1_candidate()

        // Live: the fold-result temp is read a second time -> reject.
        try assert.is_false(builder_region_produce.fold_results_dead(fu1_function(true), cand))

        // Dead: the fold-result temp's only use is the consume-reassign -> accept.
        try assert.is_true(builder_region_produce.fold_results_dead(fu1_function(false), cand))
        .Ok({})
      },
    )
    .test(
      "resolve_overlaps keeps only the lowest-key overlapping candidate",
      fn() Result<Void, String> {
        // Both share loop_site 5 -> overlap; lower seed_site -> lower key.
        lo := mk_candidate(1, 5, 10, 1)
        hi := mk_candidate(2, 5, 11, 2)
        kept := builder_region_produce.resolve_overlaps([hi, lo])
        try assert.equal(kept.len(), 1)
        try assert.equal(kept[0].seed_site.id, 1)
        .Ok({})
      },
    )
    .test(
      "resolve_overlaps keeps both disjoint candidates",
      fn() Result<Void, String> {
        // Distinct accumulator/loop/fold -> no overlap -> both survive.
        a := mk_candidate(1, 5, 10, 1)
        b := mk_candidate(2, 6, 11, 2)
        try assert.equal(builder_region_produce.resolve_overlaps([a, b]).len(), 2)
        .Ok({})
      },
    )
    .test(
      "string builder region round-trips to the persistent result",
      fn() Result<Void, String> {
        acc := ""
        for c in ["a", "b", "c"] {
          acc = .concat(c)
        }
        assert.equal(acc, "abc")
      },
    )
    .test(
      "vector builder region round-trips to the persistent result",
      fn() Result<Void, String> {
        v: Vector<Int> = []
        for x in [1, 2, 3] {
          v = .append(x)
        }
        try assert.equal(v.len(), 3)
        try assert.equal(v[0] + v[1] + v[2], 6)
        .Ok({})
      },
    )
    .test(
      "a rewritten region no longer detects as a candidate (consumed invariant)",
      fn() Result<Void, String> {
        // The census `consumed` column relies on this: a region actually replaced
        // by the rewrite disappears from detection, so certified-before /
        // gone-after distinguishes consumed from produced-but-abandoned.
        a := compile_or_fail(
          "fn m() Void {\n  acc := \"\"\n  for c in [\"a\", \"b\"] { acc = acc.concat(c) }\n  println(acc)\n}\nm()\n",
        )
        before := 0
        for c in detect.detect_candidates(a.opt, a.builtins) {
          if c.structural_ok {
            before = before + 1
          }
        }
        rewritten := builder_region.rewrite_module(a.opt, a.builtins)
        after := 0
        for c in detect.detect_candidates(rewritten, a.builtins) {
          if c.structural_ok {
            after = after + 1
          }
        }
        try assert.equal(before, 1)
        try assert.equal(after, 0)
        .Ok({})
      },
    )
    .test(
      "typed Vector<Int> accumulator loop stays boxed (typed routing deferred to Plan 4)",
      fn() Result<Void, String> {
        // First slice keeps vector builder regions boxed: the AAssign-rebound
        // accumulator escapes route_typed_vec, so `vector$builder_*` (not `*_i64`)
        // is emitted. Typed routing is a deferred follow-up (Plan 4).
        a := compile_or_fail(
          "fn m() Void {\n  acc: Vector<Int> = []\n  for x in [1, 2, 3] { acc = acc.append(x) }\n  println(acc.len().to_string())\n}\nm()\n",
        )
        anf2 := builder_region.rewrite_module(a.opt, a.builtins)
        fn_m := find_func(anf2, "m")
        try assert.equal(count_calls_to(fn_m.body, a.builtins.id("vector$builder_new")), 1)
        try assert.equal(count_calls_to(fn_m.body, a.builtins.id("vector$builder_push")), 1)
        .Ok({})
      },
    )
    .test(
      "nested regions currently stay persistent (spine-only splice limitation, Plan 8)",
      fn() Result<Void, String> {
        // A region nested inside another loop's body is NOT on the function's
        // top-level spine, so the spine-only splice abandons it; and the outer
        // loop is separately rejected ("control flow on the main arm" — the inner
        // loop). So today NEITHER region rewrites: the emitted code stays fully
        // persistent (`concat`, no `builder_extend`). Genuine two-region rewrite
        // and fresh-local-collision freedom are covered by the sequential
        // "two independent builder regions" test above. Flip this assertion when
        // Plan 8 (non-spine / branch-and-nested splice) lands.
        a := compile_or_fail(
          "fn m() Void {\n  acc := \"\"\n  for c in [\"a\", \"b\"] {\n    inner := \"\"\n    for d in [\"1\", \"2\"] { inner = inner.concat(d) }\n    acc = acc.concat(inner)\n  }\n  println(acc)\n}\nm()\n",
        )
        anf2 := builder_region.rewrite_module(a.opt, a.builtins)
        fn_m := find_func(anf2, "m")
        try assert.equal(count_calls_to(fn_m.body, a.builtins.id("string$builder_extend")), 0)
        try assert.is_true(count_calls_to(fn_m.body, a.builtins.method_id("String", "concat")) >= 1)
        .Ok({})
      },
    )
    .test(
      "two accumulators in one loop: mixed builder + persistent stays correct",
      fn() Result<Void, String> {
        // Non-overlap keeps only the lowest-key region when two regions share a
        // loop site, so one accumulator becomes a builder and the other stays
        // persistent (a sound, tracked missed-optimization — co-resident regions,
        // Plan 9). Both results must remain correct through the mixed rewrite.
        a := ""
        b := ""
        for c in ["x", "y"] {
          a = .concat(c)
          b = .concat(c)
        }
        try assert.equal(a, "xy")
        try assert.equal(b, "xy")
        .Ok({})
      },
    )
    .test(
      "stale region decision falls back to persistent",
      fn() Result<Void, String> {
        a := compile_or_fail(
          "fn m() Void {\n  acc := \"\"\n  for c in [\"a\"] { acc = acc.concat(c) }\n  println(acc)\n}\nm()\n",
        )
        fn_m := find_func(a.opt, "m")
        table := builder_region_produce.produce_builder_region_decisions(a.opt, a.builtins)
        ds := builder_region.decisions_for_func(table, fn_m.func_id)
        try assert.equal(ds.len(), 1)
        d := ds[0]

        // Corrupt the recorded loop_site so splice_loop never finds the loop.
        stale := builder_region_produce.BuilderRegionDecision.{
          key: d.key,
          func_id: d.func_id,
          family: d.family,
          accumulator: d.accumulator,
          seed_site: d.seed_site,
          loop_site: LocalId.{ id: 999999 },
          fold_sites: d.fold_sites,
          builder_local: d.builder_local,
          freeze_local: d.freeze_local,
          assign_local: d.assign_local,
        }
        out := builder_region.rewrite_func_with_decisions(fn_m, [stale], a.builtins)

        // Unchanged: concat remains, no builder_extend spliced.
        try assert.equal(count_calls_to(out.body, a.builtins.id("string$builder_extend")), 0)
        try assert.is_true(count_calls_to(out.body, a.builtins.method_id("String", "concat")) >= 1)
        .Ok({})
      },
    )
    .test(
      "collect comprehension is untouched by builder-region decisions",
      fn() Result<Void, String> {
        // collect's semantic builder lowering must not surface as an accumulator
        // fold candidate — it produces zero decisions.
        assert.equal(
          total_decisions(
            decisions_for(
              "fn m() Void {\n  xs := collect x in range(3) { x * x }\n  println(xs.len().to_string())\n}\nm()\n",
            ),
          ),
          0,
        )
      },
    )
}
