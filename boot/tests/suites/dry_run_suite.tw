use @std.testing.assert as assert
use @std.testing as runner

use commands.common.{format_compile_error}
use compiler.builtins.{make_builtin_registry}
use compiler.codegen.dry_run
use compiler.codegen.mutable_catalog
use compiler.codegen.mutable_select
use compiler.codegen.ownership_verdicts
use compiler.core_ir.{FuncId}
use compiler.opt.semantics as semantics
use compiler.opt.semantics.{make_prelude_optimizer_semantics}
use compiler.pipeline
use lib.module.loader

fn sound_uniqueness_fixtures_dir() String {
  root := loader.find_project_root("boot")
  "${root}/tests/fixtures/sound_uniqueness"
}

// Compile a snippet and return its dry-run sites.
fn sites_for(src: String) Result<Vector<dry_run.DryRunSite>, String> {
  artifacts := try pipeline.compile_source(src)
  .Ok(dry_run.dry_run_sites(artifacts.opt, artifacts.builtins))
}

fn find_site(sites: Vector<dry_run.DryRunSite>, family: String) dry_run.DryRunSite {
  for s in sites {
    if s.family == family {
      return s
    }
  }
  error("missing dry-run site for family ${family}")
}

fn expect_decision_family(
  entry: mutable_catalog.UpdateEntry,
  expected: mutable_select.OperationFamily,
) Result<Void, String> {
  case entry.decision_family {
    .Some(actual) => if actual == expected {
      .Ok({})
    } else {
      .Err("wrong decision family")
    },
    .None => .Err("missing decision family"),
  }
}

fn expect_base_arg(entry: mutable_catalog.UpdateEntry, expected: Int) Result<Void, String> {
  case entry.base_arg_index {
    .Some(actual) => assert.equal(actual, expected),
    .None => .Err("missing base arg index"),
  }
}

fn expect_mutable(entry: mutable_catalog.UpdateEntry, expected: FuncId) Result<Void, String> {
  case entry.mutable_func {
    .Some(actual) => assert.equal(actual.id, expected.id),
    .None => .Err("missing mutable func"),
  }
}

pub fn suite() runner.Suite {
  runner
    .suite("dry-run sites")
    .test(
      "owned vector set: mutable target exists and would_use is true",
      fn() {
        sites := try sites_for(
          "fn set_fresh() Vector<Int> {\n  xs := [1, 2]\n  xs[0] = 9\n  xs\n}\n",
        )
        s := find_site(sites, "vector_set")
        try assert.equal(s.persistent, "vector$set_unsafe")
        try assert.equal(s.mutable, "vector$set_in_place")
        try assert.is_true(s.reusable_shell)
        try assert.is_true(s.would_use)
        try assert.str_contains(s.verdict, "base=reuse(")
        .Ok({})
      },
    )
    .test(
      "owned vector set: would_use survives shared ownership-verdict extraction",
      fn() {
        // Regression guard for the ownership_verdicts extraction: dry_run_sites
        // must still report would_use == true for a local owned vector set once
        // verdict collection moves into a module shared with mutable decision
        // production.
        sites := try sites_for(
          "fn set_fresh() Vector<Int> {\n  xs := [1, 2]\n  xs[0] = 9\n  xs\n}\n",
        )
        s := find_site(sites, "vector_set")
        assert.is_true(s.would_use)
      },
    )
    .test(
      "aliased vector set: base still live, would_use is false",
      fn() {
        sites := try sites_for(
          "fn set_aliased() Int {\n  xs := [1, 2]\n  ys := xs\n  xs[0] = 9\n  ys.len() + xs.len()\n}\n",
        )
        s := find_site(sites, "vector_set")
        try assert.is_false(s.reusable_shell)
        try assert.is_false(s.would_use)
        try assert.str_contains(s.verdict, "persistent(")
        .Ok({})
      },
    )
    .test(
      "dict set and remove: persistent/mutable pairing and owned would_use",
      fn() {
        sites := try sites_for(
          "fn dict_ops() Dict<String, Int> {\n  d: Dict<String, Int> = Dict.new()\n  d[\"a\"] = 1\n  d = d.remove(\"a\")\n  d\n}\n",
        )
        set_site := find_site(sites, "dict_set")
        try assert.equal(set_site.persistent, "dict$set")
        try assert.equal(set_site.mutable, "dict$set_in_place")
        try assert.is_true(set_site.reusable_shell)
        try assert.is_true(set_site.would_use)
        try assert.str_contains(set_site.verdict, "base=reuse(")

        remove_site := find_site(sites, "dict_remove")
        try assert.equal(remove_site.persistent, "dict$remove")
        try assert.equal(remove_site.mutable, "dict$remove_in_place")
        try assert.is_true(remove_site.reusable_shell)
        try assert.is_true(remove_site.would_use)
        try assert.str_contains(remove_site.verdict, "base=reuse(")
        .Ok({})
      },
    )
    .test(
      "record update: struct copy/reuse pairing and owned would_use",
      fn() {
        sites := try sites_for(
          "type P = .{ x: Int, y: Int }\nfn r() P {\n  p := P.{ x: 1, y: 2 }\n  p.x = 9\n  p\n}\n",
        )
        s := find_site(sites, "record_update")
        try assert.equal(s.persistent, "struct.new(copy)")
        try assert.equal(s.mutable, "struct.set(reuse)")
        try assert.is_true(s.reusable_shell)
        try assert.is_true(s.would_use)
        try assert.str_contains(s.verdict, "shell=reuse(")
        .Ok({})
      },
    )
    .test(
      "update family with no mutable target never reports would_use",
      fn() {
        // `Vector.append` is an `.Update` candidate with a COW base but no
        // `in_place_equivalent` — there is no mutable target, so `would_use`
        // must be false even when the base is otherwise owned/reusable.
        sites := try sites_for(
          "fn append_fresh() Vector<Int> {\n  xs := [1]\n  xs = xs.append(2)\n  xs\n}\n",
        )
        s := find_site(sites, "vector_append")
        try assert.is_true(s.reusable_shell)
        try assert.str_contains(s.verdict, "reuse(")
        try assert.equal(s.mutable, "-")
        try assert.is_false(s.would_use)
        .Ok({})
      },
    )
    .test(
      "mutable catalog centralizes update family, base arg, and target lookup",
      fn() {
        b := make_builtin_registry()
        sem := make_prelude_optimizer_semantics(b)
        cat := mutable_catalog.build(b, sem)

        persistent := b.id("vector$set_unsafe")
        mutable := b.id("vector$set_in_place")
        entry := case cat.entry_for_persistent(persistent) {
          .Some(e) => e,
          .None => return .Err("missing vector set catalog entry"),
        }
        try assert.equal(entry.family, "vector_set")
        try expect_decision_family(entry, mutable_select.OperationFamily.VectorSet)
        try expect_base_arg(entry, 0)
        try expect_mutable(entry, mutable)

        classified := case cat.classify_call(mutable) {
          .Some(c) => c,
          .None => return .Err("missing in-place classification"),
        }
        try assert.equal(classified.family, "vector_set")
        try assert.is_true(classified.in_place)

        targets := cat.targets_for_actual(b, mutable.id)
        try assert.equal(targets.persistent, "vector$set_unsafe")
        try assert.equal(targets.mutable, "vector$set_in_place")
        try assert.is_true(targets.has_mutable)

        builder_new := case cat.entry_for_persistent(sem.builder.builder_new_id) {
          .Some(e) => e,
          .None => return .Err("missing vector builder new catalog entry"),
        }
        try assert.equal(builder_new.family, "vector_builder")

        record := mutable_catalog.record_targets()
        try assert.equal(record.persistent, "struct.new(copy)")
        try assert.equal(record.mutable, "struct.set(reuse)")
        assert.is_true(record.has_mutable)
      },
    )
    .test(
      "dry run with validated artifacts matches wrapper output",
      fn() {
        artifacts := case pipeline.compile_entry_path(
          "${sound_uniqueness_fixtures_dir()}/phase8a_vector_set_fresh.tw",
        ) {
          .Ok(result) => result,
          .Err(err) => return .Err(format_compile_error(err)),
        }
        sem := semantics.make_prelude_optimizer_semantics(artifacts.builtins)
        owned := ownership_verdicts.compute_artifacts(artifacts.opt, artifacts.builtins, sem)
        wrapped := dry_run.dry_run_sites(artifacts.opt, artifacts.builtins)
        supplied := dry_run.dry_run_sites_with_artifacts(artifacts.opt, artifacts.builtins, owned)
        try assert.equal(dry_run.render_dry_run(supplied), dry_run.render_dry_run(wrapped))
        .Ok({})
      },
    )
    .test(
      "dry run with stale artifacts falls back to absent verdicts",
      fn() {
        fresh := case pipeline.compile_entry_path(
          "${sound_uniqueness_fixtures_dir()}/phase8a_vector_set_fresh.tw",
        ) {
          .Ok(result) => result,
          .Err(err) => return .Err(format_compile_error(err)),
        }
        alias := case pipeline.compile_entry_path(
          "${sound_uniqueness_fixtures_dir()}/phase8a_vector_set_alias.tw",
        ) {
          .Ok(result) => result,
          .Err(err) => return .Err(format_compile_error(err)),
        }
        sem_alias := semantics.make_prelude_optimizer_semantics(alias.builtins)
        stale := ownership_verdicts.compute_artifacts(alias.opt, alias.builtins, sem_alias)
        supplied := dry_run.dry_run_sites_with_artifacts(fresh.opt, fresh.builtins, stale)
        rendered := dry_run.render_dry_run(supplied)
        try assert.str_contains(rendered, "false")
        try assert.str_contains(rendered, "-")
        .Ok({})
      },
    )
}
