use @std.testing.assert as assert
use @std.testing as runner

use compiler.field_facts as ff
use compiler.projected_borrow as pb

pub fn suite() runner.Suite {
  runner
    .suite("projected borrow")
    .test(
      "canonical roots and identical paths survive meet",
      fn() {
        a := pb.make([3, 1, 3, 2], ff.elem_path())
        b := pb.make([2, 3, 1], ff.elem_path())
        try assert.is_true(a.roots == [1, 2, 3])
        try assert.is_true(a.same(b))
        case pb.meet(.Some(a), .Some(b)) {
          .Some(got) => try assert.is_true(got.same(a)),
          .None => return .Err("identical projected borrows must survive meet"),
        }
        .Ok({})
      },
    )
    .test(
      "different roots or paths do not survive meet",
      fn() {
        a := pb.make([1], ff.elem_path())
        other_root := pb.make([2], ff.elem_path())
        other_path := pb.make([1], ff.field_path(0))
        try assert.is_true(pb.meet(.Some(a), .Some(other_root)) == .None)
        try assert.is_true(pb.meet(.Some(a), .Some(other_path)) == .None)
        .Ok({})
      },
    )
    .test(
      "prefix composes representable paths and rejects overflow",
      fn() {
        elem := pb.make([1], ff.elem_path())
        case pb.prefix(.Field(2), elem) {
          .Some(got) => try assert.is_true(got.path.path_eq(ff.field_elem(2))),
          .None => return .Err("[Field, Elem] must be representable"),
        }
        try assert.is_true(pb.prefix(.Field(3), pb.make([1], ff.field_elem(2))) == .None)
        try assert.is_true(pb.prefix(.Payload(0, 0), elem) == .None)
        try assert.is_true(pb.prefix(.Elem, elem) == .None)
        try assert.is_true(pb.meet(.None, .Some(elem)) == .None)
        .Ok({})
      },
    )
    .test(
      "appending an element path preserves only representable projections",
      fn() {
        field := pb.make([4], ff.field_path(2))
        case field.append(ff.elem_path()) {
          .Some(got) => try assert.is_true(got.path.path_eq(ff.field_elem(2))),
          .None => return .Err("[Field, Elem] must remain representable"),
        }
        try assert.is_true(pb.make([4], ff.elem_path()).append(ff.elem_path()) == .None)
        .Ok({})
      },
    )
}
