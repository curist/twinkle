use @std.testing.assert as assert
use @std.testing as runner

use compiler.anf.{AnfExpr, AnfFunctionDef, AnfModule, Atom}
use compiler.builtins
use compiler.cfg
use compiler.core_ir.{FuncId, LocalId}
use compiler.mono_type.{MonoType}
use compiler.opt.semantics as semantics
use compiler.opt.semantics.{make_prelude_optimizer_semantics}
use compiler.ownership
use compiler.pipeline

fn sem_for() semantics.OptimizerSemantics {
  make_prelude_optimizer_semantics(builtins.make_builtin_registry())
}

fn view(src: String) Result<cfg.CfgView, String> {
  artifacts := try pipeline.compile_source(src)
  .Ok(cfg.build_view(artifacts.opt, artifacts.builtins))
}

fn rendered(src: String) Result<String, String> {
  v := try view(src)
  .Ok(v.render_view())
}

fn function(src: String, name: String) Result<cfg.CfgFunction, String> {
  v := try view(src)
  case v.function_named(name) {
    .Some(f) => .Ok(f),
    .None => .Err("missing CFG function ${name}"),
  }
}

fn local(id: Int) LocalId {
  .{ id }
}

fn func_id(id: Int) FuncId {
  .{ id }
}

fn direct_value_break_module() AnfModule {
  payload := local(0)
  loop_result := local(1)
  body: AnfExpr = .Let(
    loop_result,
    .ALoop(.Break(.Some(.ALocal(payload)))),
    .Atom(.ALocal(loop_result)),
  )
  func: AnfFunctionDef = .{
    func_id: func_id(1),
    name: "value_break_direct",
    is_init: false,
    params: [],
    op_result_mono: Dict.new(),
    body,
    return_ty: MonoType.Int,
  }
  .{
    functions: [func],
    init_func_id: .None,
    extern_imports: Dict.new(),
    global_monos: Dict.new(),
    lib_exports: [],
  }
}

fn same_args(left: Vector<Atom>, right: Vector<Atom>) Bool {
  if left.len() != right.len() {
    return false
  }

  for a, i in left {
    if cfg.atom_text_pub(a) != cfg.atom_text_pub(right[i]) {
      return false
    }
  }

  true
}

fn block_by_id(func: cfg.CfgFunction, id: cfg.BlockId) cfg.CfgBlock? {
  for block in func.blocks {
    if block.id.id == id.id {
      return .Some(block)
    }
  }

  .None
}

fn has_pred_from(block: cfg.CfgBlock, from: cfg.BlockId, args: Vector<Atom>) Bool {
  for edge in block.preds {
    if edge.target.id == from.id and same_args(edge.args, args) {
      return true
    }
  }

  false
}

fn has_succ_to(block: cfg.CfgBlock, target: cfg.BlockId, args: Vector<Atom>) Bool {
  for edge in block.succs {
    if edge.target.id == target.id and same_args(edge.args, args) {
      return true
    }
  }

  false
}

fn reciprocal_edge_mismatches(func: cfg.CfgFunction) Int {
  n := 0
  for block in func.blocks {
    for succ in block.succs {
      case block_by_id(func, succ.target) {
        .Some(target_block) => if !has_pred_from(target_block, block.id, succ.args) {
          n = n + 1
        },
        .None => n = n + 1,
      }
    }

    for pred in block.preds {
      case block_by_id(func, pred.target) {
        .Some(pred_block) => if !has_succ_to(pred_block, block.id, pred.args) {
          n = n + 1
        },
        .None => n = n + 1,
      }
    }
  }

  n
}

fn predless_non_entry_blocks(func: cfg.CfgFunction) Int {
  n := 0
  for block in func.blocks {
    if block.id.id != 0 and block.preds.len() == 0 {
      n = n + 1
    }
  }
  n
}

fn block_named(func: cfg.CfgFunction, name: String) cfg.CfgBlock? {
  for block in func.blocks {
    if block.name == name {
      return .Some(block)
    }
  }
  .None
}

pub fn suite() runner.Suite {
  runner
    .suite("cfg ownership view")
    .test(
      "straight-line function has entry block, return terminator, and empty facts",
      fn() {
        f := try function("fn id(x: Int) Int {\n  y := x + 1\n  y\n}\n", "id")
        try assert.equal(f.count_blocks(), 1)
        try assert.equal(f.count_terminator("return"), 1)
        try assert.equal(f.empty_fact_blocks(), f.count_blocks())
        try assert.equal(f.count_edge_arity_mismatches(), 0)
        out := try rendered("fn id(x: Int) Int {\n  y := x + 1\n  y\n}\n")
        try assert.is_true(out.contains("// CFG ownership view"))
        try assert.is_true(out.contains("facts.in={} facts.out={}"))
        try assert.is_true(out.contains("terminator: return"))
        .Ok({})
      },
    )
    .test(
      "if expression creates then else and join blocks",
      fn() {
        f := try function(
          "fn choose(b: Bool, a: Int, c: Int) Int {\n  x := 0\n  if b {\n    x = a\n  } else {\n    x = c\n  }\n  x\n}\n",
          "choose",
        )
        try assert.equal(f.count_terminator("condbranch"), 1)

        // Both arms must fall through and branch into the join (not return),
        // otherwise the join block is orphaned.
        try assert.equal(f.count_terminator("branch"), 2)
        try assert.is_true(f.max_param_count() >= 1)
        try assert.equal(f.empty_fact_blocks(), f.count_blocks())
        try assert.equal(f.count_edge_arity_mismatches(), 0)
        .Ok({})
      },
    )
    .test(
      "partial branch rebind has join params and valid edge arity",
      fn() {
        out := try rendered(
          "fn partial(b: Bool) Int {\n  x := 0\n  if b {\n    x = 1\n  } else {\n  }\n  x\n}\n",
        )
        try assert.is_true(out.contains("terminator: condbranch"))
        try assert.is_true(out.contains("join"))
        try assert.is_true(out.contains("succs=[B"))
        try assert.is_true(out.contains("preds=[B"))
        try assert.is_true(out.contains("facts.in={} facts.out={}"))
        f := try function(
          "fn partial(b: Bool) Int {\n  x := 0\n  if b {\n    x = 1\n  } else {\n  }\n  x\n}\n",
          "partial",
        )
        try assert.equal(f.count_edge_arity_mismatches(), 0)

        // The empty else arm still falls through to the join, so both arms
        // branch into it and the join is reachable.
        try assert.equal(f.count_terminator("branch"), 2)
        .Ok({})
      },
    )
    .test(
      "match creates arm blocks and a join with carried params",
      fn() {
        f := try function(
          "fn pick(o: Int?, seed: Int) Int {\n  acc := seed\n  case o {\n    .Some(v) => {\n      acc = v\n    },\n    .None => {\n      acc = seed + 1\n    },\n  }\n  acc\n}\n",
          "pick",
        )
        try assert.equal(f.count_terminator("match"), 1)

        // Both arms must fall through and branch into the join (not return),
        // otherwise the join block is orphaned.
        try assert.equal(f.count_terminator("branch"), 2)
        try assert.is_true(f.max_param_count() >= 1)
        try assert.equal(f.empty_fact_blocks(), f.count_blocks())
        try assert.equal(f.count_edge_arity_mismatches(), 0)
        .Ok({})
      },
    )
    .test(
      "loop carries assign targets, breaks to exit, and loops back",
      fn() {
        f := try function(
          "fn sum_to(n: Int) Int {\n  acc := 0\n  for i in range(n) {\n    acc = acc + i\n  }\n  acc\n}\n",
          "sum_to",
        )

        // The run-to-completion path (and any continue) takes a back-edge to
        // the header; the range guard's break exits the loop.
        try assert.is_true(f.count_terminator("loop-back-edge") >= 1)
        try assert.is_true(f.count_terminator("void-break") >= 1)
        try assert.is_true(f.max_param_count() >= 1)
        try assert.equal(f.empty_fact_blocks(), f.count_blocks())
        try assert.equal(f.count_edge_arity_mismatches(), 0)
        .Ok({})
      },
    )
    .test(
      "nested loop inner break preserves reciprocal predecessor successor edges",
      fn() {
        f := try function(
          "fn nested(n: Int, m: Int) Int {\n  acc := 0\n  for i in range(n) {\n    for j in range(m) {\n      if j == 1 {\n        break\n      }\n      acc = acc + j\n    }\n    acc = acc + i\n  }\n  acc\n}\n",
          "nested",
        )
        try assert.equal(reciprocal_edge_mismatches(f), 0)
        .Ok({})
      },
    )
    .test(
      "all terminating branch arms do not emit a predless continuation join",
      fn() {
        f := try function(
          "fn both_return(b: Bool) Int {\n  if b {\n    return 1\n  } else {\n    return 2\n  }\n  3\n}\n",
          "both_return",
        )
        try assert.equal(predless_non_entry_blocks(f), 0)
        .Ok({})
      },
    )
    .test(
      "direct ANF value break is rendered as a value-break terminator",
      fn() {
        v := cfg.build_view(direct_value_break_module(), builtins.make_builtin_registry())
        out := v.render_view()
        try assert.is_true(out.contains("terminator: value-break L0"))

        // The value-break exit edge feeds the loop-result param the break payload:
        // carried params are [L0, L1] with result L1, so the exit edge args are
        // [ALocal(L0), ALocal(L0)] (the carried L0 forwards itself; the result L1
        // takes the payload L0). Assert those exact atoms, not just the rendered text.
        vf := case v.function_named("value_break_direct") {
          .Some(f) => f,
          .None => return assert.fail("no value_break_direct function"),
        }
        vb_edge_ok := false
        for block in vf.blocks {
          case block.terminator {
            .Some(.ValueBreak(_)) => {
              for e in block.succs {
                if e.args.len() == 2
                  and cfg.atom_text_pub(e.args[0]) == "L0" and cfg.atom_text_pub(e.args[1]) == "L0" {
                  vb_edge_ok = true
                }
              }
            },
            _ => {},
          }
        }
        try assert.is_true(vb_edge_ok)
        .Ok({})
      },
    )
    .test(
      "optimized defer-free input means cfg output never contains ADefer",
      fn() {
        out := try rendered(
          "fn cleanup_scope() Int {\n  x := 1\n  defer {\n    y := x + 1\n  }\n  x\n}\n",
        )
        try assert.is_true(!out.contains("ADefer"))
        try assert.is_true(!out.contains("defer"))
        try assert.is_true(out.contains("// CFG ownership view"))
        .Ok({})
      },
    )
    .test(
      "rendering is byte-identical across two builds",
      fn() {
        src := "fn choose(b: Bool, n: Int) Int {\n  acc := 0\n  for i in range(n) {\n    if b {\n      acc = acc + i\n    } else {\n      acc = acc + 1\n    }\n  }\n  acc\n}\n"
        first := try rendered(src)
        second := try rendered(src)
        try assert.equal(first, second)
        try assert.is_true(first.contains("terminator: condbranch"))
        try assert.is_true(first.contains("terminator: loop-back-edge"))
        .Ok({})
      },
    )
    .test(
      "phase2 t3: analyze returns a view; empty-facts query still works",
      fn() {
        v := try view("fn f(x: Int) Int {\n  x\n}\n")
        analyzed := ownership.analyze(v, builtins.make_builtin_registry(), sem_for())
        case analyzed.function_named("f") {
          .Some(func) => assert.is_true(func.blocks.len() >= 1),
          .None => assert.fail("f missing after analyze"),
        }
      },
    )
    .test(
      "phase2 t2: branch join edge args carry each arm's tail atom positionally",
      fn() {
        f := try function("fn f(c: Bool) Int {\n  r := if c { 1 } else { 2 }\n  r\n}\n", "f")
        jb := case block_named(f, "if.join") {
          .Some(b) => b,
          .None => return assert.fail("no if.join block"),
        }
        then_blk := case block_named(f, "if.then") {
          .Some(b) => b,
          .None => return assert.fail("no if.then block"),
        }
        else_blk := case block_named(f, "if.else") {
          .Some(b) => b,
          .None => return assert.fail("no if.else block"),
        }

        // The join carries exactly one param (the result local r); each predecessor
        // feeds it, positionally at [0], the atom from its own arm — then feeds the
        // literal 1, else feeds the literal 2. (A pred edge's `target` holds the
        // predecessor block id; see cfg.add_pred.)
        try assert.equal(jb.params.len(), 1)
        then_fed := ""
        else_fed := ""
        for pe in jb.preds {
          if pe.target.id == then_blk.id.id {
            then_fed = cfg.atom_text_pub(pe.args[0])
          }
          if pe.target.id == else_blk.id.id {
            else_fed = cfg.atom_text_pub(pe.args[0])
          }
        }
        try assert.equal(then_fed, "1")
        try assert.equal(else_fed, "2")
        .Ok({})
      },
    )
    .test(
      "phase2 t1: instructions carry raw op and functions carry params",
      fn() {
        f := try function("fn f(x: Int) Int {\n  y := x + 1\n  y\n}\n", "f")
        try assert.is_true(f.params.len() >= 1)
        has_binop := false
        for block in f.blocks {
          for inst in block.instructions {
            case inst.op {
              .ABinOp(_, _, _, _) => has_binop = true,
              _ => {},
            }
          }
        }
        try assert.is_true(has_binop)
        .Ok({})
      },
    )
}
