// Cooperative concurrency: Task and Channel.
//
// Tasks share one thread and switch only at task points — yield, await, and
// channel send/recv. Between those points a task runs uninterrupted, so
// immutable values are never observed half-updated.
// Task.yield() hands control back to the scheduler, letting spawned tasks
// interleave. The mixed output below shows both making progress together.
fn count_up(id: Int, n: Int) Int {
  for i in 1..n + 1 {
    println("task ${id}: step ${i}")
    Task.yield()
  }
  n
}

// Task.spawn starts a task; Task.await suspends until it finishes and returns
// its result.
a := Task.spawn(fn() { count_up(1, 3) })
b := Task.spawn(fn() { count_up(2, 4) })
println("tasks finished ${a.await()} and ${b.await()} steps")

// Channels connect tasks. Here a pool of workers pulls jobs from one channel
// and pushes results into another — fan-out the work, fan-in the results.
fn is_prime(n: Int) Bool {
  if n < 2 {
    return false
  }
  i := 2
  for i * i <= n {
    if n % i == 0 {
      return false
    }
    i = .inc()
  }
  true
}

jobs: Channel<Int> = Channel.bounded(4)
results: Channel<Int> = Channel.new()

// Several workers receive from `jobs` concurrently. A channel hands each value
// to exactly one receiver, so the workers naturally share the work between them.
workers := collect id in 1..4 {
  Task.spawn(fn() {
    for n in jobs {
      if is_prime(n) {
        println("worker ${id}: ${n} is prime")
        results.send(n)
      }
    }
  })
}

// Feed the jobs, then close so each worker's `for` loop ends.
feeder := Task.spawn(fn() {
  defer jobs.close()
  for n in 2..30 {
    jobs.send(n)
  }
})

// Once every worker has finished, close `results` so the drain below ends.
closer := Task.spawn(fn() {
  for w in workers {
    w.await()
  }
  results.close()
})

// Results arrive as workers find them, interleaved across the pool.
found: Vector<Int> = []
for p in results {
  found = .append(p)
}
feeder.await()
closer.await()

println("found ${found.len()} primes")
